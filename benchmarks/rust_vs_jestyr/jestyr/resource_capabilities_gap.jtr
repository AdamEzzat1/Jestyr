// SEMANTICS PROBE — this COMPILES BY DESIGN (it was a KNOWN-GAP probe;
// the gap is now closed where it mattered). Device here is DROP-FREE,
// and a drop-free non-Copy value given to `take` is an MVS implicit
// copy: nothing observable is left behind in the caller, so the read
// below returns a well-defined copy — deliberately unlike Rust, which
// refuses any non-Copy use-after-move (E0382). The line Jestyr draws
// instead: add a `Drop` impl to Device and the same program is REFUSED
// ("cannot use `d` after it was given to a `take` parameter") — that
// twin is resource_capabilities_rejected.jtr, and the callee now drops
// its take parameter, closing the leak this suite's first pass found.
// Residue: a wrapper that is only TRANSITIVELY droppable does not yet
// poison (the checker's v1 gate is a direct `impl Drop`).

struct Device { id: i64, energy: i64 }

fn consume(take d: Device) -> i64 {
    return d.energy + d.id
}

fn main() -> i32 {
    let d: Device = Device { id: 1, energy: 10 }
    let e: i64 = consume(d)
    print_int(d.energy)   // accepted today; a linear story would refuse
    print_int(e)
    return 0
}
