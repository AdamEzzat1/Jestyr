// structured_concurrency — twin of rust/std/structured_concurrency
// (thread::scope, hand chunking) and rust/idiomatic (rayon).
//
// The whole parallel side is ONE LINE: `par for … reduce`. What the
// line buys over both Rust twins: the reduction must come from the
// declared-deterministic set — an f64 sum here would be a COMPILE
// error, where both Rust versions silently become schedule-dependent.
// And @span(log) makes the parallel depth part of the signature: a
// refactor that serializes this body is a compile error, not a
// regression. Chunking (n/4, remainder to the last worker, in-order
// merge) matches the std twin's hand-rolled split exactly, and the
// fused-worker lowering measured in examples/cpp_compare/heavy_parsum
// applies. Reuses that machinery on purpose — nothing rebuilt.
//
// Output must be byte-identical to both Rust twins.

import "../../../examples/std/core"

const N: usize = 20000000
const MOD: i64 = 1000000007

fn b2i(read b: bool) -> i32 {
    if b { return 1 }
    return 0
}

@span(log) fn par_sum_sq(read s: []i64) -> i64 {
    par for x in s reduce(core.sum_reduction()) { x * x }
}

@span(linear) fn serial_sum_sq(read s: []i64) -> i64 {
    var acc: i64 = 0
    for x in s {
        acc = acc + x * x
    }
    return acc
}

fn main() -> i32 {
    var a: *mut i64 = alloc(i64, N)
    var xs: []i64 = slice(i64, a, N)
    for i in 0..xs.len {
        xs[i] = (i as i64) % 1000
    }

    let p: i64 = par_sum_sq(xs)
    print_int(p % MOD)
    print_int(b2i(p == serial_sum_sq(xs)) as i64)

    free_ptr(a)
    return 0
}
