// observer_registry_std — the jestyr-std track: same case as
// jestyr/observer_registry.jtr — genrefs still carry the whole
// stale-handle story (`gen_new` / `gen_free` / `with alive`), because
// that story is the case and no library replaces it. What the stdlib
// changes is only the handle VECTOR: a growable `List(Handle)` with
// `push` instead of a hand-sized `alloc(Handle, CAP)` buffer and a
// manually advanced count (the no-std twin must guess CAP = 400000 up
// front; this one doesn't).
//
// Output must be byte-identical to all three existing tracks.

import "../../../examples/std/list"
import "../../../examples/std/mem"

const INITIAL: i64 = 100000
const ROUNDS: i64 = 20
const DELETES: i64 = 30000
const SPAWNS: i64 = 15000
const MOD: i64 = 1000000007

struct Obj { id: i64, hp: i64 }
@copy struct Handle { r: &Obj }

fn lcg(state: i64) -> i64 {
    return (state * 48271) % 2147483647
}

fn main() -> i32 {
    let al: Allocator = mem.system_allocator()
    var hs: list.List(Handle) = list.make(Handle, al)
    var s: i64 = 20260813
    var next_id: i64 = 0

    var i: i64 = 0
    for i < INITIAL {
        s = lcg(s)
        list.push(Handle, hs, Handle { r: gen_new(Obj, Obj { id: next_id, hp: s % 100 + 1 }) })
        next_id = next_id + 1
        i = i + 1
    }

    var chk: i64 = 0
    var dead_deletes: i64 = 0
    var r: i64 = 0
    for r < ROUNDS {
        // Delete phase: victims drawn from every handle ever issued, so
        // some draws hit handles that are already stale.
        var d: i64 = 0
        for d < DELETES {
            s = lcg(s)
            let hcount: i64 = list.len(Handle, hs) as i64
            let j: usize = (s % hcount) as usize
            let h: Handle = list.get(Handle, hs, j)
            var ok: i64 = 0
            with alive h.r as read o {
                ok = 1
            } else {
                ok = 0
            }
            if ok == 1 {
                gen_free(h.r)
            } else {
                dead_deletes = dead_deletes + 1
            }
            d = d + 1
        }
        // Spawn phase: fresh objects, fresh generations.
        var b: i64 = 0
        for b < SPAWNS {
            s = lcg(s)
            list.push(Handle, hs, Handle { r: gen_new(Obj, Obj { id: next_id, hp: s % 100 + 1 }) })
            next_id = next_id + 1
            b = b + 1
        }
        // Sweep phase: dereference EVERY handle ever issued.
        var live_sum: i64 = 0
        var live_count: i64 = 0
        var stale_count: i64 = 0
        for i2 in 0..list.len(Handle, hs) {
            let h2: Handle = list.get(Handle, hs, i2)
            with alive h2.r as read o {
                live_sum = live_sum + o.hp + o.id % 7
                live_count = live_count + 1
            } else {
                stale_count = stale_count + 1
            }
        }
        chk = (chk * 31 + live_sum + live_count * 13 + stale_count * 17) % MOD
        r = r + 1
    }

    print_int(chk)
    print_int(list.len(Handle, hs) as i64)
    print_int(dead_deletes)
    return 0
}
