// b16 — POSITIVE CONTROL for b01/b07/b10: every boundary spelled with `as`.
distinct Id = i64
fn takes_id(x: Id) -> i64 { return x as i64 }
fn ret_id() -> Id { return 5 as Id }
fn main() -> i32 {
    var x: Id = 5 as Id
    x = 7 as Id
    print_int(takes_id(x) as i32)
    print_int(ret_id() as i32)
    return 0
}
