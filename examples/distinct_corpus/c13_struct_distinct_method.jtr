// c13 — calling a trait method of the base through a distinct-over-struct.
trait Sum { fn total(self) -> i32 }
struct Pt { x: i32, y: i32 }
impl Sum for Pt { fn total(self) -> i32 { return self.x + self.y } }
distinct W = Pt
fn main() -> i32 {
    let w: W = Pt { x: 3, y: 4 } as W
    print_int(w.total())
    return 0
}
