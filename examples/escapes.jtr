// examples/escapes.jtr — exercises the ownership / escape checker (stage ⑤).
// Run:  jestyrc check examples/escapes.jtr
// Expect exactly THREE escape errors (leak, capture, stash) and the two
// `ok_*` functions to pass — second-class borrows may flow down, but not out.

struct Node   { value: i32 }
struct Holder { inner: i32 }

// ✗ ESCAPE: returns the borrowed `p` by value — it would outlive the call.
fn leak(read p: Node) -> Node {
    p
}

// ✗ ESCAPE: stores the borrow `p` inside a struct value.
fn capture(read p: Node) -> Holder {
    Holder{ inner: p }
}

// ✗ ESCAPE: writes the borrow `p` into caller-owned storage via `h`.
fn stash(read p: Node, mut h: Holder) {
    h.inner = p
}

// ✓ OK: passing a borrow *further down* the call stack is exactly what
//       second-class borrows are for.
fn ok_forward(read p: Node) {
    consume(p)
}

// ✓ OK: the signature opts into handing a borrow back out (`-> read Node`),
//       so this is a borrow re-export, not an escape.
fn ok_borrow_out(read p: Node) -> read Node {
    p
}
