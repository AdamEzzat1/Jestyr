// examples/region_escape.jtr — the region-safety PROOF (strings step 10, the
// marquee provability win). A region-allocated value is owned by its arena, which
// is freed at the end of the `region` block — so the escape checker statically
// REJECTS returning it (it would dangle). This is what makes zero-alloc region
// text *provably* safe, not merely safe-by-construction — something no surveyed
// string design (Swift/Zig/Rust/Erlang) can do.
//
// Run:  jestyrc check examples/region_escape.jtr   →  3 errors (every escape below)

// Escape route 1 — RETURN: a region value can't outlive its arena.
fn build_in_region() -> str {
    region r {
        let g: str = region_concat(r, "Hello, ", "region!")
        return g            // ERROR: `g` is region-allocated; it can't outlive `r`
    }
    return ""
}

// Escape route 2 — ASSIGN-TO-OUTER: storing a region value into a binding declared
// outside the `region` block would let it dangle after the arena is freed.
fn leak_via_outer() -> i32 {
    var saved: str = ""
    region r {
        saved = region_concat(r, "a", "b")   // ERROR: `saved` outlives the arena
    }
    print_str(saved)        // would be a use-after-free
    return 0
}

// Escape route 3 — STORE-THROUGH-OUTER: writing an inner-region value through a
// place chain whose ROOT lives in an outer region reaches storage that outlives
// the inner arena — the same dangle as route 2, one deref deeper. This shape
// compiled clean (a demonstrated use-after-free) before the rule covered place
// chains, not just bare bindings.
struct Holder { p: &[r]str }
fn leak_via_outer_structure() -> i32 {
    region outer {
        var h: &[outer]Holder = region_alloc(outer, Holder, Holder { p: region_alloc(outer, str, "ok") })
        region inner {
            h.*.p = region_alloc(inner, str, "gone")   // ERROR: `h`'s storage outlives `inner`
        }
        print_str(h.*.p.*)  // would read the freed inner arena
    }
    return 0
}

fn main() -> i32 { return 0 }
