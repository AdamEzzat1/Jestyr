// life.jtr — Conway's Game of Life on a fixed 8x8 board.
//
// What it shows: fixed-size arrays as stack VALUES (no heap at all), bounds-checked
// indexing, value-semantics copies (`next` starts as a copy of nothing — arrays are
// plain values), owned Strings for rendering, and RAII (`string_free`).
//
// Run:  jestyrc run examples/life.jtr

const W: i32 = 8
const H: i32 = 8

fn idx(x: i32, y: i32) -> usize {
    // Torus wrap: coordinates fold around the edges.
    let xw: i32 = (x + W) % W
    let yw: i32 = (y + H) % H
    return (yw * W + xw) as usize
}

fn neighbors(read b: [64]i32, x: i32, y: i32) -> i32 {
    var n: i32 = 0
    var dy: i32 = 0 - 1
    for dy <= 1 {
        var dx: i32 = 0 - 1
        for dx <= 1 {
            if dx != 0 or dy != 0 {
                n = n + b[idx(x + dx, y + dy)]
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    return n
}

fn step(read b: [64]i32) -> [64]i32 {
    var next: [64]i32 = [0; 64]
    var y: i32 = 0
    for y < H {
        var x: i32 = 0
        for x < W {
            let n: i32 = neighbors(b, x, y)
            let alive: i32 = b[idx(x, y)]
            if alive == 1 {
                if n == 2 or n == 3 { next[idx(x, y)] = 1 }
            } else {
                if n == 3 { next[idx(x, y)] = 1 }
            }
            x = x + 1
        }
        y = y + 1
    }
    return next
}

fn show(read b: [64]i32) {
    var y: i32 = 0
    for y < H {
        var row: String = string_from("")
        var x: i32 = 0
        for x < W {
            if b[idx(x, y)] == 1 { string_push(row, "#") } else { string_push(row, ".") }
            x = x + 1
        }
        print_str(string_view(row))
        string_free(row)
        y = y + 1
    }
    print_str("")
}

fn main() -> i32 {
    var board: [64]i32 = [0; 64]
    // A glider.
    board[idx(1, 0)] = 1
    board[idx(2, 1)] = 1
    board[idx(0, 2)] = 1
    board[idx(1, 2)] = 1
    board[idx(2, 2)] = 1

    var gen: i32 = 0
    for gen < 4 {
        show(board)
        board = step(board)
        gen = gen + 1
    }
    show(board)
    return 0
}
