// examples/slice_range.jtr — range-slicing a `[]T`.
//
// `xs[lo .. hi]` narrows a slice to a view of the SAME buffer: `{ ptr, len }` in,
// `{ ptr + lo, hi - lo }` out. Pointer arithmetic and a subtraction, no copy and no
// allocation — the `[]T` twin of `str`'s `s[lo .. hi]` sub-view.
//
// All four forms work: closed `a .. b`, open-ended `a ..`, inclusive `a ..= b`, and
// the empty `a .. a`. Bounds are asserted (`lo <= hi <= len`), so a bad range is a
// deterministic fault rather than a view past the end of the buffer. Unlike `str`
// there is no UTF-8 boundary check — a `[]T` has no encoding.
//
// This is what lets a function hand back part of a caller's buffer without
// threading the raw pointer alongside it, which is why `std/test_report.finish`
// no longer needs one.
//
//   jestyrc run examples/slice_range.jtr
//   →  4  DEFG  ABC  NOP  0  BCD  16

fn main() -> i32 {
    var raw: *mut u8 = alloc(u8, 16)
    var b: []u8 = slice(u8, raw, 16)
    for i in 0..16 { b[i] = (65 + i) as u8 }   // 'A'..'P'

    let mid: []u8 = b[3 .. 7]
    print_int(mid.len as i64)                  // 4
    print_str(from_utf8(mid))                  // DEFG
    print_str(from_utf8(b[0 .. 3]))            // ABC   (a prefix)
    print_str(from_utf8(b[13 ..]))             // NOP   (open end)
    print_int(b[2 .. 2].len as i64)            // 0     (empty is legal)
    print_str(from_utf8(b[1 ..= 3]))           // BCD   (inclusive)

    // A sub-view of a sub-view still points into the one original buffer.
    let all: []u8 = b[0 ..]
    print_int(all.len as i64)                  // 16

    free_ptr(raw)
    return 0
}
