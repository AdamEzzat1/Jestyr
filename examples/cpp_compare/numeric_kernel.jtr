// Numeric kernel in Jestyr: heap slice + predictable integer work.
//
// Closest C++ pair: numeric_kernel.cpp
// Run:
//   cargo run --release -- run examples/cpp_compare/numeric_kernel.jtr
//
// What to compare:
//   - Syntax: explicit slices (`[]i64`) and safe indexing instead of pointer pairs.
//   - Performance: lowers to optimized C; time the built native executable.
//   - Memory: two contiguous i64 buffers, no hidden per-element allocation.

fn fill(mut xs: []i64) {
    for i in 0..xs.len {
        let x: i64 = i as i64
        xs[i] = ((x * 1664525) + 1013904223) % 1000003
    }
}

fn stencil(read xs: []i64, mut ys: []i64) {
    ys[0] = xs[0]
    ys[xs.len - 1] = xs[xs.len - 1]
    for i in 1..(xs.len - 1) {
        ys[i] = (xs[i - 1] * 3) + (xs[i] * 5) - (xs[i + 1] * 2)
    }
}

fn checksum(read xs: []i64) -> i64 {
    var total: i64 = 0
    for i in 0..xs.len {
        total = (total + xs[i]) % 2147483647
    }
    return total
}

fn main() -> i32 {
    let n: usize = 200000
    var a: *mut i64 = alloc(i64, n)
    var b: *mut i64 = alloc(i64, n)
    var xs: []i64 = slice(i64, a, n)
    var ys: []i64 = slice(i64, b, n)

    fill(xs)
    stencil(xs, ys)
    print_int(checksum(ys) as i32)

    free_ptr(b)
    free_ptr(a)
    return 0
}
