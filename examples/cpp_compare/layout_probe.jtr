// Byte layout probe in Jestyr.
//
// Closest C++ pair: layout_probe.cpp
// Run:
//   cargo run --release -- run examples/cpp_compare/layout_probe.jtr
//
// What to compare:
//   - Jestyr makes layout controls part of the source with `@packed` / `@align`.
//   - `size_of`, `align_of`, and `offset_of` make the memory result visible.

struct Natural {
    tag: u8,
    value: i32,
    flags: u8,
}

@packed struct Packed {
    tag: u8,
    value: i32,
    flags: u8,
}

@align(16) struct CacheLineHint {
    value: i32,
}

fn main() -> i32 {
    print_int(size_of(Natural))             // usually 12
    print_int(size_of(Packed))              // 6
    print_int(align_of(CacheLineHint))      // 16
    print_int(offset_of(Natural, value))    // usually 4
    print_int(offset_of(Packed, value))     // 1
    return 0
}
