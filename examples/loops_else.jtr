// examples/loops_else.jtr — loop-`else` (the search-or-default idiom).
//
//   jestyrc run examples/loops_else.jtr
//   →   4   (found the first even element → `break`, so `else` is skipped)
//      -1   (no even element → the loop completed → `else` ran: the default)
//       7   (while-form: drained to 0 with no `break` → `else` ran)
//
// `for … { … } else { … }` runs the `else` block exactly once *iff the loop
// finishes without a `break`* (Python's loop-`else`). A `break` skips it; running
// off the end of a range/slice — or a conditional going false — runs it. This is
// the "search, else default" pattern with no sentinel value and no found-flag.
//
// An infinite `for { … }` only ever exits via `break`, so attaching an `else` to
// one is a compile error (the `else` would be dead code) — see the note at the
// bottom of this file.

// Search a slice for the first even value. On a hit we `break` (skipping the
// `else`); if the loop runs off the end of the slice with no hit, the `else`
// supplies the not-found default.
fn first_even(xs: []i32) -> i32 {
    var ans: i32 = 0
    for x in xs {
        if x % 2 == 0 {
            ans = x
            break
        }
    } else {
        ans = 0 - 1   // reached only when the slice held no even element
    }
    return ans
}

// While-form `else`: it runs when the condition goes false without a `break` —
// i.e. the loop drained cleanly to `k == 0`.
fn drain(n: i32) -> i32 {
    var k: i32 = n
    var result: i32 = 0
    for k > 0 {
        k = k - 1
    } else {
        result = 7
    }
    return result
}

fn main() -> i32 {
    var p: *mut i32 = alloc_i32(3)
    var xs: []i32 = slice(i32, p, 3)
    unsafe { (p + 0).* = 1; (p + 1).* = 3; (p + 2).* = 4 }
    print_int(first_even(xs))   // 4  — break path, `else` skipped
    free_ptr(p)

    var q: *mut i32 = alloc_i32(2)
    var ys: []i32 = slice(i32, q, 2)
    unsafe { (q + 0).* = 1; (q + 1).* = 3 }
    print_int(first_even(ys))   // -1 — completion path, `else` ran
    free_ptr(q)

    print_int(drain(4))         // 7  — while-form completion, `else` ran

    return 0
}

// Rejected (a compile error, by design) — an infinite loop's `else` is dead code:
//
//     for {
//         if done() { break }
//     } else {            // error: an infinite `for { … }` only exits via `break`,
//         cleanup()       //        so its `else` can never run
//     }
