// examples/vec.jtr — a realistic snippet to exercise the lexer end to end.
// (Not yet parsed — stage ① only tokenizes. It must lex with zero errors.)

fn Vec(comptime T: type) -> type {
    return struct {
        ptr: *mut T,
        len: usize,
        cap: usize,

        fn empty() -> Self {
            Self{ ptr: null, len: 0, cap: 0 }
        }

        fn push(mut self, alloc: Allocator, take value: T) !{ OutOfMemory } {
            if self.len == self.cap {
                self.grow(alloc)?
            }
            unsafe { (self.ptr + self.len).* = value }   /* explicit raw store */
            self.len += 1
        }

        // A refinement on `i` (0..self.len) lets the bounds check be elided.
        fn get(read self, i: usize in 0..self.len) -> read T {
            unsafe { (self.ptr + i).* }
        }

        fn drop(take self, alloc: Allocator) {
            alloc.free(self.ptr, self.cap)
        }
    }
}

enum Shape {
    circle(r: f64),
    rect(w: f64, h: f64),
    none,
}

fn area(read s: Shape) -> f64 {
    match s {
        circle(r)  => 3.14159 * r * r,
        rect(w, h) => w * h,
        none       => 0.0,
    }
}

// Hex MMIO address and a bitmask test, from the bare-metal example.
const UART0: *mut u32 = @address(0x4000_C000)
const TX_FULL: u32 = 0b0010_0000
