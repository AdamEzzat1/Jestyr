// examples/array_lit.jtr — array *list* literals `[e0, e1, …]`, both as a top-level
// `const` lookup table (emitted as a C static brace initializer) and as a local
// value. The element type is adopted from the annotation (so the `u64` table holds
// u64, not i32-by-default).
//
//   jestyrc run examples/array_lit.jtr   →   28, 11, 60, 1

const PRIMES: [5]i64 = [2, 3, 5, 7, 11]

fn sum5(read a: [5]i64) -> i64 {
    var s: i64 = 0
    for x in a { s = s + x }
    return s
}

fn main() -> i32 {
    // const table: index and iterate
    print_int(sum5(PRIMES) as i32)                 // 28
    print_int(PRIMES[4] as i32)                    // 11

    // local list literal
    let local: [3]i64 = [10, 20, 30]
    print_int((local[0] + local[1] + local[2]) as i32)   // 60

    // element-type adoption: a u64 table (top bit set → would warn as a signed
    // decimal, but these are hex so they stay unsigned)
    let bits: [2]u64 = [0x8000000000000000, 0x7FFFFFFFFFFFFFFF]
    print_int(b2i(bits[0] > bits[1]))              // 1
    return 0
}

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }
