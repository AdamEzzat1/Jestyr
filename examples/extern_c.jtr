// examples/extern_c.jtr — real C interop (backlog item H).
//
// `extern "c" fn` declares a foreign function with no body, bound to the C ABI.
// It is called by its *bare* C name (no `jestyr_` mangling) and resolved by the
// linker — so these call straight into libc, with no Jestyr intrinsic in between.
//
// Run:  jestyrc run examples/extern_c.jtr
//       →  Hello from C, called via extern c
//          42

extern "c" fn puts(s: str) -> i32
extern "c" fn abs(x: i32) -> i32

fn main() -> i32 {
    puts("Hello from C, called via extern c")
    print_int(abs(0 - 42))   // 42, computed by libc's abs()
    return 0
}
