// std/ctfe.jtr — the compile-time interpreter, in Jestyr. The port mirror of
// `src/comptime.rs` (roadmap workstream G, tiers 1–2).
//
// ─── Why `ctfe` and not `comptime` ──────────────────────────────────────────────
// The reference module is `comptime.rs`, and the obvious mirror name is taken — by
// Jestyr itself. Once `comptime { … }` became an expression form, a module named
// `comptime` could not be USED: `comptime.run()` parses as a comptime block whose body
// is missing its `{`. The reference gets away with the name only because `comptime` is
// not a Rust keyword. This is the same hazard the `@` reflection sigil exists for (a
// bare-name intrinsic would have hijacked the compiler's own `fn field_type`), in a new
// place: a module PATH competes for tokens with the language's keywords.
//
// A small, TOTAL interpreter over the parser's arenas: it folds integer/bool/string
// expressions at check time, including calls of pure functions. It is what makes
// `comptime { … }` a value rather than a block the backend has to compile, and what
// lets a `[N]T` length be an expression rather than only a literal.
//
// ─── Totality ───────────────────────────────────────────────────────────────────
// A comptime interpreter is a place a compiler can hang on perfectly ordinary-looking
// input (`const A = B` / `const B = A`, or an unbounded recursion). Three bounds keep
// evaluation total, so a bad program gets a diagnostic rather than a hung build:
//   * a step budget (`FUEL`) spent on every expression,
//   * a call-depth cap (`MAX_DEPTH`),
//   * cycle detection across `const` references.
// Anything outside the value domain — a float, a struct, an intrinsic, an effectful
// call — fails cleanly rather than being guessed at. The effect policy is STRUCTURAL:
// there is simply no arm for an effect, so there is no allowlist to keep in sync and
// no way to bypass it.
//
// ─── Scope ──────────────────────────────────────────────────────────────────────
// The whole ladder the reference has: scalars (Int, Bool, Str), **aggregates** —
// `[a, b, c]`, `[v; n]`, indexing, `.len` (tier 6) — and the comptime **`for` with
// mutation** (tier 7). Tier 6 turns comptime from "compute a number" into "compute a
// *table*"; tier 7 computes the table's SHAPE rather than spelling it out, which is
// what makes `var t = [0; n]  for i in 0..n { t[i] = f(i) }  t` the way to build one.
// Everything here is refusal-compatible with the reference: this evaluator never
// accepts something the reference rejects, so a file that folds under one folds
// identically under the other.
//
// ─── Representation ─────────────────────────────────────────────────────────────
// A `Value` is a tag plus one `i64`, so it is Copy and needs no allocator. A string
// value's payload is an INDEX into `sidx`, a list of (start, len) pairs into the
// single growable `sbuf` — so string values are cheap to copy and are never aliased,
// because comptime strings are immutable.
//
// A LIST value works the same way one level up: its payload is a pair index into
// `lidx`, whose (start, len) names a contiguous run of CELLS in the parallel `ltag` /
// `lval` arenas. A cell is itself a tag+payload, so a cell tagged 4 names another run
// — a tree living in flat arenas. The reference's `Vec<Value>` is an owned tree it
// `.clone()`s on the way out of the environment; this is the same tree with the
// ownership expressed as an index.
//
// Two consequences worth stating, because the next tier turns on them:
//
//   * **Elements are staged before they are stored.** Evaluating `[[1, 2], 3]` builds
//     the inner list *while* the outer one is mid-construction, so appending each
//     element to the arena as it is evaluated would interleave the two runs. Elements
//     therefore land on a stack (`stag`/`sval`) and are moved into the arena as one
//     contiguous run when the literal closes. Nested literals complete first, so the
//     stack discipline falls out for free.
//   * **A handle copies for free, so the copies the reference gets from ownership have
//     to be written down.** `deep_copy` runs at exactly three points, each marked in
//     place: reading a value out of a binding, reading an element out of a list, and
//     producing each element of `[v; n]`. The third is the one that is invisible while
//     nothing can write — `[v; n]` evaluates `v` once, so without it `[[0; 2]; 3]` is
//     three cells naming ONE run and `m[0][1] = 5` writes through all three rows. Tier
//     6 could not observe that; tier 7 can, immediately.
//
//     The flat arena pays for itself on the other side of the same trade: an
//     assignment target is a `Place` — an env row or a cell index — so walking an
//     index path is an address computation, where the reference needs `find_binding`
//     to hand out a `&mut Value` and `walk_path` to re-borrow through each index, a
//     chain the `.jtr` subset cannot express at all. Assignment resolution therefore
//     reads through `place_read_raw`, which deliberately does NOT copy: copying there
//     would resolve `t[0]` against a duplicate and drop the write on the floor.

import "mem"
import "fs"
import "env"
import "list"
import "intern"
import "tokens"
import "parser"

// The total number of expression evaluations one top-level `eval` may perform.
// Generous for real constant folding, small enough that a pathological input fails in
// microseconds.
fn fuel_budget() -> i32 { return 100000 }

// The maximum nesting of comptime function calls.
fn max_depth() -> i32 { return 64 }

// A comptime value. `tag`: 0=Int 1=Bool 2=Str 3=Unit 4=List.
// `i` carries the payload: the integer, 0/1 for a bool, a slot index into `sidx` for a
// string, or a pair index into `lidx` for a list. A `Unit` value is a real value (a
// block ending in a binding produces one), so the CONSUMER decides whether a missing
// value is a problem.
pub struct Value { pub tag: i32, pub i: i64 }

pub fn is_int(read v: Value) -> bool { return v.tag == 0 }
pub fn is_bool(read v: Value) -> bool { return v.tag == 1 }
pub fn is_str(read v: Value) -> bool { return v.tag == 2 }
pub fn is_unit(read v: Value) -> bool { return v.tag == 3 }
pub fn is_list(read v: Value) -> bool { return v.tag == 4 }

// The name used in diagnostics ("expected an integer, found a bool").
pub fn type_name(read v: Value) -> str {
    if v.tag == 0 { return "an integer" }
    if v.tag == 1 { return "a bool" }
    if v.tag == 2 { return "a string" }
    if v.tag == 4 { return "a list" }
    return "no value"
}

// The interpreter's state for one program.
//
// `envn` holds (name_start, name_end, tag) triples and `envv` the parallel `i64`
// payloads — two lists rather than one list of a Binding struct, because the port's
// generic `List` is instantiated per element type and `i32`/`i64` lists already exist
// everywhere else in the compiler. `marks` records where each scope began, so leaving
// a scope is a truncate.
pub struct Interp {
    sbuf: String,        // every comptime-produced string byte, concatenated
    sidx: List(i32),     // (start, len) pairs into `sbuf`; a Str value's `i` is the PAIR index
    ltag: List(i32),     // list CELLS: the tag of each element, in run order
    lval: List(i64),     // parallel element payloads
    lidx: List(i32),     // (start, len) pairs into the cells; a List value's `i` is the PAIR index
    stag: List(i32),     // the staging stack an in-progress literal pushes onto
    sval: List(i64),
    envn: List(i32),     // (name_start, name_end, tag) triples
    envv: List(i64),     // parallel payloads
    marks: List(i32),    // scope starts, counted in triples
    prog: List(i32),     // (ns, ne) of consts being evaluated — the cycle guard
    fuel: i32,
    depth: i32,
    pub failed: bool,    // set by the first failure; every caller then unwinds
    pub es: usize,       // the failing sub-expression's span, for the diagnostic
    pub ee: usize,
    pub emsg: String,
    returning: bool,     // a `return` is in flight, consumed by the owning call
    rtag: i32,
    ri: i64,
    lctl: i32,           // a loop transfer in flight: 0 none, 1 break, 2 continue
    lls: i32,            // its label's name span, or -1 for an unlabelled transfer
    lle: i32,
    a: Allocator,        // kept so a call frame can build its argument buffers
}

// The result of reading an integer literal: the value, and whether the text was
// well-formed. A struct rather than a `mut` out-parameter, because a scalar `mut`
// parameter is not the port's idiom.
struct IntLit { ok: bool, v: i64 }

// A fresh interpreter bound to allocator `a`. Cheap: it allocates nothing until the
// first evaluation.
pub fn make(read a: Allocator) -> Interp {
    return Interp{
        sbuf: string_new(),
        sidx: list.make(i32, a),
        ltag: list.make(i32, a),
        lval: list.make(i64, a),
        lidx: list.make(i32, a),
        stag: list.make(i32, a),
        sval: list.make(i64, a),
        envn: list.make(i32, a),
        envv: list.make(i64, a),
        marks: list.make(i32, a),
        prog: list.make(i32, a),
        fuel: 100000,
        depth: 0,
        failed: false,
        es: 0,
        ee: 0,
        emsg: string_new(),
        returning: false,
        rtag: 3,
        ri: 0,
        lctl: 0,
        lls: 0 - 1,
        lle: 0 - 1,
        a: a,
    }
}

// ---- value constructors ----

fn v_int(n: i64) -> Value { return Value{ tag: 0, i: n } }
fn v_bool(b: bool) -> Value { var n: i64 = 0  if b { n = 1 }  return Value{ tag: 1, i: n } }
fn v_unit() -> Value { return Value{ tag: 3, i: 0 } }

// Intern `s` into the string arena and return a Str value naming it.
fn v_str(mut it: Interp, s: str) -> Value {
    let before: str = string_view(it.sbuf)
    let start: i32 = before.len as i32
    string_push(it.sbuf, s)
    let slot: i32 = (list.len(i32, it.sidx) / 2) as i32
    list.push(i32, it.sidx, start)
    list.push(i32, it.sidx, s.len as i32)
    return Value{ tag: 2, i: slot as i64 }
}

// ---- lists (tier 6) ----

// Push one evaluated element onto the staging stack. The stack, rather than the arena
// itself, is what keeps a nested literal's cells from interleaving with the run being
// built around it.
fn stage(mut it: Interp, read v: Value) {
    list.push(i32, it.stag, v.tag)
    list.push(i64, it.sval, v.i)
}

// Close a literal: move every staged element from `base` upward into the cell arenas as
// one contiguous run, and return the List value naming it.
fn list_close(mut it: Interp, base: usize) -> Value {
    let start: i32 = list.len(i32, it.ltag) as i32
    let n: usize = list.len(i32, it.stag)
    var k: usize = base
    for k < n {
        list.push(i32, it.ltag, list.get(i32, it.stag, k))
        list.push(i64, it.lval, list.get(i64, it.sval, k))
        k = k + 1
    }
    list.truncate(i32, it.stag, base)
    list.truncate(i64, it.sval, base)
    let slot: i32 = (list.len(i32, it.lidx) / 2) as i32
    list.push(i32, it.lidx, start)
    list.push(i32, it.lidx, (n - base) as i32)
    return Value{ tag: 4, i: slot as i64 }
}

// The element count of a List value.
pub fn list_len(read it: Interp, read v: Value) -> i64 {
    return list.get(i32, it.lidx, (v.i * 2 + 1) as usize) as i64
}

// An INDEPENDENT copy of `v` — the obligation tier 6 was allowed to defer.
//
// The reference's `Vec<Value>` is owned, so `.clone()` on the way out of the
// environment is what stops two bindings sharing one table. A handle copies for free,
// so the port has to do the copy explicitly, at exactly the points the reference
// clones: reading a value out of a binding, reading an element out of a list, and
// producing each element of `[v; n]`. Miss the last one and `[[0; 2]; 3]` is three
// cells naming ONE run, so `m[0][1] = 5` writes through all three rows.
//
// Scalars are already independent (the payload is the value, and a string's arena is
// immutable), so this is a no-op for everything but a list.
fn deep_copy(mut it: Interp, read v: Value) -> Value {
    // Rebuilt rather than returned: `v` is a second-class `read` borrow, which the
    // escape checker will not let outlive the call.
    if v.tag != 4 { return Value{ tag: v.tag, i: v.i } }
    let n: i64 = list_len(it, v)
    let base: usize = list.len(i32, it.stag)
    var k: i64 = 0
    for k < n {
        let e: Value = list_at(it, v, k)
        // Recursion goes through the same staging stack. It closes its own run before
        // returning, so the stack is back where it started and the outer run stays
        // contiguous — the same discipline nested literals rely on.
        let c: Value = deep_copy(it, e)
        stage(it, c)
        k = k + 1
    }
    return list_close(it, base)
}

// Where an assignment writes. Either an environment ROW (`x = …`) or a list CELL
// (`t[i] = …`, at any depth).
//
// This is the flat arena paying off: the reference needs `find_binding` to hand out a
// `&mut Value` and `walk_path` to re-borrow through each index, a chain the `.jtr`
// subset cannot express at all. Here a place is an integer, and walking a path is an
// address computation.
struct Place { ok: bool, row: i32, cell: i32 }

// The env row bound to `src[ns..ne]`, newest first, or -1.
fn env_row(read it: Interp, read src: str, ns: usize, ne: usize) -> i32 {
    var i: i32 = (list.len(i32, it.envn) / 3) as i32
    for i > 0 {
        i = i - 1
        let base: usize = (i * 3) as usize
        let bns: i32 = list.get(i32, it.envn, base)
        let bne: i32 = list.get(i32, it.envn, base + 1)
        if str_eq(src[ns .. ne], src[bns as usize .. bne as usize]) { return i }
    }
    return 0 - 1
}

// Read a place WITHOUT copying — the stored value itself, handle and all. Assignment
// resolution must use this: copying here would resolve `t[0]` against a duplicate and
// the write would land in the duplicate.
fn place_read_raw(read it: Interp, read pl: Place) -> Value {
    if pl.cell >= 0 {
        return Value{ tag: list.get(i32, it.ltag, pl.cell as usize), i: list.get(i64, it.lval, pl.cell as usize) }
    }
    let tag: i32 = list.get(i32, it.envn, (pl.row * 3 + 2) as usize)
    return Value{ tag: tag, i: list.get(i64, it.envv, pl.row as usize) }
}

fn place_write(mut it: Interp, read pl: Place, read v: Value) {
    if pl.cell >= 0 {
        list.set(i32, it.ltag, pl.cell as usize, v.tag)
        list.set(i64, it.lval, pl.cell as usize, v.i)
        return
    }
    list.set(i32, it.envn, (pl.row * 3 + 2) as usize, v.tag)
    list.set(i64, it.envv, pl.row as usize, v.i)
}

// The first element of a non-empty List value — what decides an unannotated table's
// element type. Public because typeck needs it and has no business walking the arenas.
pub fn list_first(read it: Interp, read v: Value) -> Value {
    return list_at(it, v, 0)
}

// Element `ix`, for cgen's benefit. Range-checked by the caller, which in cgen's case is a
// loop over `list_len` — the arenas stay private so the emitter cannot grow its own opinion
// about the representation.
pub fn list_get(read it: Interp, read v: Value, ix: i64) -> Value {
    return list_at(it, v, ix)
}

// Element `ix` of a List value. The caller has already range-checked it.
fn list_at(read it: Interp, read v: Value, ix: i64) -> Value {
    let start: i32 = list.get(i32, it.lidx, (v.i * 2) as usize)
    let cell: usize = (start as i64 + ix) as usize
    return Value{ tag: list.get(i32, it.ltag, cell), i: list.get(i64, it.lval, cell) }
}

// Structural equality. Lists compare element-wise and recursively; the reference offers
// equality only, because an ORDERING on aggregates would have to invent a rule
// (lexicographic? by length?) and inventing rules is the one thing this evaluator does
// not do.
fn val_eq(read it: Interp, read a: Value, read b: Value) -> bool {
    if a.tag != b.tag { return false }
    if a.tag == 2 { return str_eq(str_of(it, a), str_of(it, b)) }
    if a.tag == 4 {
        let n: i64 = list_len(it, a)
        if n != list_len(it, b) { return false }
        var k: i64 = 0
        for k < n {
            let x: Value = list_at(it, a, k)
            let y: Value = list_at(it, b, k)
            if val_eq(it, x, y) == false { return false }
            k = k + 1
        }
        return true
    }
    return a.i == b.i
}

// The bytes of a Str value. (Bind the view first — chaining `string_view(x).len` is a
// recorded `.jtr` subset trap.)
pub fn str_of(read it: Interp, read v: Value) -> str {
    let all: str = string_view(it.sbuf)
    let base: usize = (v.i * 2) as usize
    let start: i32 = list.get(i32, it.sidx, base)
    let n: i32 = list.get(i32, it.sidx, base + 1)
    return all[start as usize .. (start + n) as usize]
}

// ---- failure ----

// Record the first failure and return a placeholder. Later failures do not overwrite
// it, so the diagnostic names the ORIGINAL cause rather than whatever unwound last.
fn fail(mut it: Interp, msg: str, s: usize, e: usize) -> Value {
    if it.failed == false {
        it.failed = true
        it.es = s
        it.ee = e
        string_push(it.emsg, msg)
    }
    return v_unit()
}

// Spend one step. Running out is a diagnostic, never a hang.
fn spend(mut it: Interp, s: usize, e: usize) -> bool {
    if it.fuel <= 0 {
        let ignored: Value = fail(it, "compile-time evaluation exceeded its step budget (is it non-terminating?)", s, e)
        return false
    }
    it.fuel = it.fuel - 1
    return true
}

// ---- scopes ----

fn scope_push(mut it: Interp) {
    let n: i32 = (list.len(i32, it.envn) / 3) as i32
    list.push(i32, it.marks, n)
}

fn scope_pop(mut it: Interp) {
    let m: usize = list.len(i32, it.marks)
    if m == 0 { return }
    let n: i32 = list.get(i32, it.marks, m - 1)
    list.truncate(i32, it.marks, m - 1)
    list.truncate(i32, it.envn, (n * 3) as usize)
    list.truncate(i64, it.envv, n as usize)
}

fn bind(mut it: Interp, ns: i32, ne: i32, read v: Value) {
    list.push(i32, it.envn, ns)
    list.push(i32, it.envn, ne)
    list.push(i32, it.envn, v.tag)
    list.push(i64, it.envv, v.i)
}

// Look up `src[ns..ne]`, newest binding first so shadowing works.
// Returns tag -1 when unbound.
fn lookup(read it: Interp, read src: str, ns: usize, ne: usize) -> Value {
    var i: i32 = (list.len(i32, it.envn) / 3) as i32
    for i > 0 {
        i = i - 1
        let base: usize = (i * 3) as usize
        let bns: i32 = list.get(i32, it.envn, base)
        let bne: i32 = list.get(i32, it.envn, base + 1)
        if str_eq(src[ns .. ne], src[bns as usize .. bne as usize]) {
            let tag: i32 = list.get(i32, it.envn, base + 2)
            let payload: i64 = list.get(i64, it.envv, i as usize)
            return Value{ tag: tag, i: payload }
        }
    }
    return Value{ tag: 0 - 1, i: 0 }
}

// ---- top-level item lookup ----

// The value `ExprId` of `const <src[ns..ne]>`, or -1.
fn const_init(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    let n: usize = list.len(parser.ItemData, p.it)
    var i: usize = 0
    for i < n {
        let d: parser.ItemData = list.get(parser.ItemData, p.it, i)
        if d.kind == 2 {
            if str_eq(src[ns .. ne], src[d.x as usize .. d.y as usize]) { return d.b }
        }
        i = i + 1
    }
    return 0 - 1
}

// The `ItemId` of `fn <src[ns..ne]>`, or -1.
fn fn_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    let n: usize = list.len(parser.ItemData, p.it)
    var i: usize = 0
    for i < n {
        let d: parser.ItemData = list.get(parser.ItemData, p.it, i)
        if d.kind == 3 {
            if str_eq(src[ns .. ne], src[d.x as usize .. d.y as usize]) { return i as i32 }
        }
        i = i + 1
    }
    return 0 - 1
}

// ---- literals ----

// Parse an integer literal's source text: decimal, `0x`/`0X` hex, `0b`/`0B` binary,
// with `_` separators ignored. Returns false on malformed text.
fn parse_int_lit(read src: str, s: usize, e: usize) -> IntLit {
    var i: usize = s
    var base: i64 = 10
    if e - s > 2 {
        if (src[i] as i32) == 48 {
            let d: i32 = src[i + 1] as i32
            if d == 120 { base = 16  i = i + 2 }
            else if d == 88 { base = 16  i = i + 2 }
            else if d == 98 { base = 2  i = i + 2 }
            else if d == 66 { base = 2  i = i + 2 }
        }
    }
    var v: i64 = 0
    for i < e {
        let ch: i32 = src[i] as i32
        if ch == 95 { i = i + 1 }
        else {
            var d: i64 = 0 - 1
            if ch >= 48 { if ch <= 57 { d = (ch - 48) as i64 } }
            if ch >= 97 { if ch <= 102 { d = (ch - 87) as i64 } }
            if ch >= 65 { if ch <= 70 { d = (ch - 55) as i64 } }
            if d < 0 { return IntLit{ ok: false, v: 0 } }
            if d >= base { return IntLit{ ok: false, v: 0 } }
            v = v * base + d
            i = i + 1
        }
    }
    return IntLit{ ok: true, v: v }
}

// Decode the escapes the lexer accepts, appending to `dst`. An unknown escape keeps
// its character, matching the lexer's own tolerance.
fn push_unescaped(mut dst: String, read src: str, s: usize, e: usize) {
    var i: usize = s
    for i < e {
        let c: i32 = src[i] as i32
        if c == 92 {
            if i + 1 < e {
                let n: i32 = src[i + 1] as i32
                if n == 110 { string_push(dst, "\n") }
                else if n == 116 { string_push(dst, "\t") }
                else if n == 114 { string_push(dst, "\r") }
                else if n == 48 { string_push(dst, "\0") }
                else { string_push(dst, src[i + 1 .. i + 2]) }
                i = i + 2
            } else {
                string_push(dst, "\\")
                i = i + 1
            }
        } else {
            string_push(dst, src[i .. i + 1])
            i = i + 1
        }
    }
}

// ---- evaluation ----

// Evaluate one expression to a comptime value. Each call gets a fresh step budget, so
// evaluating many constants cannot exhaust a shared one. Check `it.failed` afterwards.
pub fn eval(mut it: Interp, read p: parser.Parser, read src: str, eid: i32) -> Value {
    it.fuel = 100000
    it.depth = 0
    it.failed = false
    it.returning = false
    it.lctl = 0
    it.lls = 0 - 1
    it.lle = 0 - 1
    // The message buffer is reset with everything else. It was not, before tier 7 gave
    // the dump enough refusal fixtures to notice: `failed` cleared but `emsg` did not,
    // so a second failing `const` reported the CONCATENATION of every message so far.
    string_free(it.emsg)
    it.emsg = string_new()
    list.truncate(i32, it.envn, 0)
    list.truncate(i64, it.envv, 0)
    list.truncate(i32, it.marks, 0)
    list.truncate(i32, it.prog, 0)
    scope_push(it)
    return ev(it, p, src, eid)
}

// Evaluate to a non-negative integer — the array-length / repeat-count shape.
// Returns -1 on any failure (the caller decides whether that is an error).
pub fn eval_usize(mut it: Interp, read p: parser.Parser, read src: str, eid: i32) -> i64 {
    let v: Value = eval(it, p, src, eid)
    if it.failed { return 0 - 1 }
    if v.tag != 0 { return 0 - 1 }
    if v.i < 0 { return 0 - 1 }
    return v.i
}

fn ev(mut it: Interp, read p: parser.Parser, read src: str, eid: i32) -> Value {
    if it.failed { return v_unit() }
    if eid < 0 { return v_unit() }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if spend(it, d.start, d.end) == false { return v_unit() }

    if d.kind == 0 {                                  // Int
        let lit: IntLit = parse_int_lit(src, d.start, d.end)
        if lit.ok == false { return fail(it, "integer literal is out of range", d.start, d.end) }
        return v_int(lit.v)
    }
    if d.kind == 27 {                                 // Bool
        return v_bool(str_eq(src[d.start .. d.end], "true"))
    }
    if d.kind == 29 {                                 // Str — strip the quotes, unescape
        var tmp: String = string_new()
        push_unescaped(tmp, src, d.start + 1, d.end - 1)
        let view: str = string_view(tmp)
        return v_str(it, view)
    }
    if d.kind == 26 {                                 // Char — its code point
        var tmp: String = string_new()
        push_unescaped(tmp, src, d.start + 1, d.end - 1)
        let view: str = string_view(tmp)
        if view.len == 0 { return fail(it, "malformed character literal", d.start, d.end) }
        return v_int(view[0] as i64)
    }
    if d.kind == 2 { return ev_name(it, p, src, d) }  // Name
    if d.kind == 3 {                                  // Unary
        let v: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        return ev_unary(it, d.op, v, d.start, d.end)
    }
    if d.kind == 4 { return ev_binary(it, p, src, d) } // Binary
    if d.kind == 11 {                                 // Cast — int-to-int passes through
        let v: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        if v.tag == 0 {
            if is_int_type(p, src, d.x) { return v }
        }
        return fail(it, "this cast is not supported at compile time", d.start, d.end)
    }
    if d.kind == 24 {                                 // If
        let c: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        if c.tag != 1 { return fail(it, "`if` condition must be a bool", d.start, d.end) }
        if c.i == 1 {
            let v: Value = ev_block(it, p, src, d.b)
            // An `if` with no `else` is a statement: it runs its block for effect and
            // yields no value of its own.
            if d.op < 0 { return v_unit() }
            return v
        }
        if d.op < 0 { return v_unit() }
        return ev(it, p, src, d.op)
    }
    // A `comptime { … }` block is ALREADY being evaluated at compile time, so it is
    // simply its block — which is what makes a nested one work for free.
    if d.kind == 23 { return ev_block(it, p, src, eid) }   // Block
    if d.kind == 44 { return ev_block(it, p, src, d.a) }   // Comptime
    if d.kind == 10 { return ev_call(it, p, src, d) }      // Call

    // --- aggregates (tier 6) ---
    if d.kind == 14 {                                 // ArrayLit — `(x, y)` into `p.ar`
        let base: usize = list.len(i32, it.stag)
        var k: i32 = 0
        for k < d.y {
            let elem: i32 = list.get(i32, p.ar, (d.x + k) as usize)
            let v: Value = ev(it, p, src, elem)
            if it.failed { list.truncate(i32, it.stag, base)  list.truncate(i64, it.sval, base)  return v_unit() }
            stage(it, v)
            k = k + 1
        }
        return list_close(it, base)
    }
    if d.kind == 15 {                                 // ArrayRepeat — `[value; count]`
        let n: i64 = ev_len(it, p, src, d.b)
        if it.failed { return v_unit() }
        let v: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        let base: usize = list.len(i32, it.stag)
        var k: i64 = 0
        for k < n {
            // A step per ELEMENT: the fuel budget is what stops a repeat count the
            // author did not mean from becoming an allocation. Spending it per
            // expression instead would let `[0; 10_000_000_000]` through.
            if spend(it, d.start, d.end) == false {
                list.truncate(i32, it.stag, base)
                list.truncate(i64, it.sval, base)
                return v_unit()
            }
            // COPY POINT 3 of 3: each repeated element, matching the reference's
            // `out.push(v.clone())`. This is the one that is invisible until tier 7 and
            // then instantly wrong: without it `[[0; 2]; 3]` is three cells naming ONE
            // run, so `m[0][1] = 5` writes through all three rows.
            let ec: Value = deep_copy(it, v)
            stage(it, ec)
            k = k + 1
        }
        return list_close(it, base)
    }
    if d.kind == 6 {                                  // Index
        let b: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        let ie: parser.ExprData = list.get(parser.ExprData, p.ex, d.b as usize)
        let i: Value = ev(it, p, src, d.b)
        if it.failed { return v_unit() }
        if b.tag != 4 {
            return fail(it, "cannot index this at compile time", d.start, d.end)
        }
        if i.tag != 0 {
            return fail(it, "an index must be a non-negative integer", ie.start, ie.end)
        }
        // Out of range is an error, never a clamp or a zero — the same rule as every
        // other comptime query.
        if i.i < 0 { return fail(it, "an index must be a non-negative integer", ie.start, ie.end) }
        if i.i >= list_len(it, b) { return fail(it, "this index is out of range for the list", ie.start, ie.end) }
        // COPY POINT 2 of 3: reading an element out of a list (`items.get(ix).cloned()`).
        let e: Value = list_at(it, b, i.i)
        return deep_copy(it, e)
    }
    // --- loops and mutation (tier 7) ---
    if d.kind == 31 { return ev_for(it, p, src, d) }       // For
    if d.kind == 12 { return ev_assign(it, p, src, d) }    // Assign
    if d.kind == 32 {                                      // Break — `(x, y)` = label span
        it.lctl = 1
        it.lls = d.x
        it.lle = d.y
        return v_unit()
    }
    if d.kind == 33 {                                      // Continue
        it.lctl = 2
        it.lls = d.x
        it.lle = d.y
        return v_unit()
    }
    if d.kind == 5 {                                  // Field — `.len` is the only one
        if str_eq(src[d.x as usize .. d.y as usize], "len") {
            let b: Value = ev(it, p, src, d.a)
            if it.failed { return v_unit() }
            if b.tag == 4 { return v_int(list_len(it, b)) }
            if b.tag == 2 {
                let s: str = str_of(it, b)
                return v_int(s.len as i64)
            }
            return fail(it, "this has no `.len` at compile time", d.start, d.end)
        }
        return fail(it, "this expression is not a compile-time constant", d.start, d.end)
    }

    return fail(it, "this expression is not a compile-time constant", d.start, d.end)
}

// ---- assignment and loops (tier 7) ----

// Resolve an assignment target to the place it names. A name is an env row; an index
// walks one level further into the run its base names, at any depth.
fn place_of(mut it: Interp, read p: parser.Parser, read src: str, target: i32) -> Place {
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, target as usize)
    if d.kind == 2 {                                  // Name
        let row: i32 = env_row(it, src, d.start, d.end)
        if row < 0 {
            let ignored: Value = fail(it, "this is not a compile-time binding", d.start, d.end)
            return Place{ ok: false, row: 0 - 1, cell: 0 - 1 }
        }
        return Place{ ok: true, row: row, cell: 0 - 1 }
    }
    if d.kind == 6 {                                  // Index
        let base: Place = place_of(it, p, src, d.a)
        if base.ok == false { return base }
        let bv: Value = place_read_raw(it, base)
        let ie: parser.ExprData = list.get(parser.ExprData, p.ex, d.b as usize)
        let iv: Value = ev(it, p, src, d.b)
        if it.failed { return Place{ ok: false, row: 0 - 1, cell: 0 - 1 } }
        if bv.tag != 4 {
            let ignored: Value = fail(it, "cannot index this at compile time", d.start, d.end)
            return Place{ ok: false, row: 0 - 1, cell: 0 - 1 }
        }
        if iv.tag != 0 or iv.i < 0 {
            let ignored2: Value = fail(it, "an index must be a non-negative integer", ie.start, ie.end)
            return Place{ ok: false, row: 0 - 1, cell: 0 - 1 }
        }
        if iv.i >= list_len(it, bv) {
            let ignored3: Value = fail(it, "this index is out of range for the list", ie.start, ie.end)
            return Place{ ok: false, row: 0 - 1, cell: 0 - 1 }
        }
        let start: i32 = list.get(i32, it.lidx, (bv.i * 2) as usize)
        return Place{ ok: true, row: 0 - 1, cell: (start as i64 + iv.i) as i32 }
    }
    let ignored4: Value = fail(it, "this is not something a compile-time assignment can write", d.start, d.end)
    return Place{ ok: false, row: 0 - 1, cell: 0 - 1 }
}

// `target op= value`. A compound assignment is the binary operator applied to the
// current value, through the SAME checked arithmetic as everywhere else — so `x += 1`
// overflows into a diagnostic rather than wrapping.
fn ev_assign(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData) -> Value {
    let v: Value = ev(it, p, src, d.b)
    if it.failed { return v_unit() }
    let pl: Place = place_of(it, p, src, d.a)
    if pl.ok == false { return v_unit() }
    if d.op == 1 {                                    // `=`
        place_write(it, pl, v)
        return v_unit()
    }
    let cur: Value = place_read_raw(it, pl)
    // AssignOp 2..9 map onto BinOp add/sub/mul/div/rem/bitand/bitor/bitxor.
    var bin: i32 = 0
    if d.op == 2 { bin = 1 }
    if d.op == 3 { bin = 2 }
    if d.op == 4 { bin = 3 }
    if d.op == 5 { bin = 4 }
    if d.op == 6 { bin = 5 }
    if d.op == 7 { bin = 14 }
    if d.op == 8 { bin = 15 }
    if d.op == 9 { bin = 16 }
    if cur.tag == 0 {
        if v.tag == 0 {
            let nv: Value = int_binop(it, bin, cur.i, v.i, d.start, d.end)
            if it.failed { return v_unit() }
            place_write(it, pl, nv)
            return v_unit()
        }
    }
    if cur.tag == 2 {
        if v.tag == 2 {
            if bin == 1 {
                let nv2: Value = str_binop(it, bin, cur, v, d.start, d.end)
                if it.failed { return v_unit() }
                place_write(it, pl, nv2)
                return v_unit()
            }
        }
    }
    return fail(it, "this compound assignment does not apply at compile time", d.start, d.end)
}

// Does the transfer in flight belong to a loop labelled `src[ls..le]`? An unlabelled
// `break`/`continue` belongs to the innermost loop, so it always matches.
fn ctl_targets(read it: Interp, read src: str, ls: i32, le: i32) -> bool {
    if it.lls < 0 { return true }
    if ls < 0 { return false }
    return str_eq(src[it.lls as usize .. it.lle as usize], src[ls as usize .. le as usize])
}

// Run one loop-body iteration. Returns true when the loop should stop — because it
// broke, returned, or a LABELLED transfer is still travelling outward.
fn run_loop_body(mut it: Interp, read p: parser.Parser, read src: str, body: i32, ls: i32, le: i32, mut broke: List(i32)) -> bool {
    let ignored: Value = ev_block(it, p, src, body)
    if it.failed { return true }
    if it.returning { return true }
    if it.lctl == 0 { return false }
    if ctl_targets(it, src, ls, le) == false { return true }   // aimed further out: keep propagating
    let was: i32 = it.lctl
    it.lctl = 0
    it.lls = 0 - 1
    it.lle = 0 - 1
    if was == 1 {
        list.set(i32, broke, 0, 1)
        return true
    }
    return false
}

// The values a `for … in …` head iterates, built as a comptime LIST — the same
// representation everything else uses, so iteration needs no second container.
fn iter_items(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData, nbind: i32, nsrc: i32, stepe: i32) -> Value {
    if nbind < 1 or nbind > 2 or nsrc != 1 {
        return fail(it, "this `for` shape is not supported at compile time (one or two bindings over one source)", d.start, d.end)
    }
    var stride: i64 = 1
    if stepe >= 0 {
        let sv: Value = ev(it, p, src, stepe)
        if it.failed { return v_unit() }
        if sv.tag != 0 { return fail(it, "a `step` must be an integer", d.start, d.end) }
        if sv.i == 0 { return fail(it, "a `step` of 0 never advances", d.start, d.end) }
        stride = sv.i
    }
    let srce: i32 = list.get(i32, p.lar, (d.a + 7 + nbind * 3) as usize)
    let sd: parser.ExprData = list.get(parser.ExprData, p.ex, srce as usize)
    if sd.kind == 13 {                                // Range — a HEADER form, not a value
        // There is no range value in the comptime domain, so the bounds are read from
        // the AST rather than evaluated as one thing.
        if sd.a < 0 or sd.b < 0 {
            return fail(it, "an open-ended range cannot be iterated at compile time", d.start, d.end)
        }
        let lo: Value = ev(it, p, src, sd.a)
        if it.failed { return v_unit() }
        let hi: Value = ev(it, p, src, sd.b)
        if it.failed { return v_unit() }
        if lo.tag != 0 or hi.tag != 0 { return fail(it, "a range bound must be an integer", d.start, d.end) }
        let inclusive: bool = sd.op == 1
        let base: usize = list.len(i32, it.stag)
        var i: i64 = lo.i
        var go: bool = true
        for go {
            if stride > 0 {
                if inclusive { go = i <= hi.i } else { go = i < hi.i }
            } else {
                if inclusive { go = i >= hi.i } else { go = i > hi.i }
            }
            if go == false { break }
            // Each produced element costs a step, so a range nobody meant to write is a
            // diagnostic rather than an allocation — the `[v; n]` rule again.
            if spend(it, d.start, d.end) == false {
                list.truncate(i32, it.stag, base)
                list.truncate(i64, it.sval, base)
                return v_unit()
            }
            stage(it, v_int(i))
            let next: i64 = i + stride
            if stride > 0 { if next < i { return fail(it, "this range overflowed at compile time", d.start, d.end) } }
            else { if next > i { return fail(it, "this range overflowed at compile time", d.start, d.end) } }
            i = next
        }
        return list_close(it, base)
    }
    let sv2: Value = ev(it, p, src, srce)
    if it.failed { return v_unit() }
    if sv2.tag != 4 { return fail(it, "cannot iterate this at compile time", d.start, d.end) }
    return sv2
}

// A comptime `for` (tier 7). Loops are STATEMENTS in Jestyr, so this yields no value; a
// loop earns its keep by mutating a `var`, which is what makes
// `var t = [0; n]  for i in 0..n { t[i] = f(i) }  t` the way to build a table.
//
// Fuel is spent per ITERATION. Nothing else would: `for i in 0..1000000000 { }` has an
// empty body, so no sub-expression is evaluated and no step is charged. That one
// `spend` is the difference between a bounded evaluator and a hung build.
fn ev_for(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData) -> Value {
    let ls: i32 = list.get(i32, p.lar, d.a as usize)
    let le: i32 = list.get(i32, p.lar, (d.a + 1) as usize)
    var broke: List(i32) = list.make(i32, it.a)
    list.push(i32, broke, 0)
    if d.op == 0 {                                    // infinite
        var go: bool = true
        for go {
            if spend(it, d.start, d.end) == false { return v_unit() }
            if run_loop_body(it, p, src, d.b, ls, le, broke) { go = false }
            if it.failed { return v_unit() }
        }
    } else if d.op == 1 {                             // conditional
        let cond: i32 = list.get(i32, p.lar, (d.a + 4) as usize)
        var go2: bool = true
        for go2 {
            if spend(it, d.start, d.end) == false { return v_unit() }
            let c: Value = ev(it, p, src, cond)
            if it.failed { return v_unit() }
            if c.tag != 1 { return fail(it, "a `for` condition must be a bool", d.start, d.end) }
            if c.i == 0 { go2 = false }
            else {
                if run_loop_body(it, p, src, d.b, ls, le, broke) { go2 = false }
                if it.failed { return v_unit() }
            }
        }
    } else {                                          // iterating
        let nbind: i32 = list.get(i32, p.lar, (d.a + 4) as usize)
        let nsrc: i32 = list.get(i32, p.lar, (d.a + 5) as usize)
        let stepe: i32 = list.get(i32, p.lar, (d.a + 6) as usize)
        let items: Value = iter_items(it, p, src, d, nbind, nsrc, stepe)
        if it.failed { return v_unit() }
        let n: i64 = list_len(it, items)
        var k: i64 = 0
        for k < n {
            if spend(it, d.start, d.end) == false { return v_unit() }
            // Each iteration's binding lives in its own scope, so a `for` body cannot
            // leak its loop variable — exactly as at runtime.
            scope_push(it)
            let e: Value = list_at(it, items, k)
            let ec: Value = deep_copy(it, e)
            let b0s: i32 = list.get(i32, p.lar, (d.a + 7 + 1) as usize)
            let b0e: i32 = list.get(i32, p.lar, (d.a + 7 + 2) as usize)
            bind(it, b0s, b0e, ec)
            if nbind == 2 {
                let b1s: i32 = list.get(i32, p.lar, (d.a + 7 + 4) as usize)
                let b1e: i32 = list.get(i32, p.lar, (d.a + 7 + 5) as usize)
                bind(it, b1s, b1e, v_int(k))
            }
            let stop: bool = run_loop_body(it, p, src, d.b, ls, le, broke)
            scope_pop(it)
            if it.failed { return v_unit() }
            if stop { break }
            k = k + 1
        }
    }
    // `for … else { … }` runs exactly once iff the loop completed WITHOUT a break — the
    // search-or-default idiom. A `break` is precisely what suppresses it.
    if list.get(i32, broke, 0) == 0 {
        if d.x >= 0 {
            let ignored: Value = ev_block(it, p, src, d.x)
            if it.failed { return v_unit() }
        }
    }
    return v_unit()
}

// Evaluate a repeat count: a non-negative integer, in the interpreter's own failure
// channel (unlike `eval_usize`, which is the public entry point and resets state).
fn ev_len(mut it: Interp, read p: parser.Parser, read src: str, eid: i32) -> i64 {
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let v: Value = ev(it, p, src, eid)
    if it.failed { return 0 }
    if v.tag != 0 {
        let ignored: Value = fail(it, "a repeat count must be a non-negative integer", d.start, d.end)
        return 0
    }
    if v.i < 0 {
        let ignored2: Value = fail(it, "a repeat count must be a non-negative integer", d.start, d.end)
        return 0
    }
    return v.i
}

// Is `tyid` an integer primitive? (The set a comptime cast may pass through.)
fn is_int_type(read p: parser.Parser, read src: str, tyid: i32) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 0 { return false }
    let n: str = src[t.start .. t.end]
    if str_eq(n, "i8") { return true }
    if str_eq(n, "i16") { return true }
    if str_eq(n, "i32") { return true }
    if str_eq(n, "i64") { return true }
    if str_eq(n, "isize") { return true }
    if str_eq(n, "u8") { return true }
    if str_eq(n, "u16") { return true }
    if str_eq(n, "u32") { return true }
    if str_eq(n, "u64") { return true }
    if str_eq(n, "usize") { return true }
    return false
}

// A name: a local binding first, then a top-level `const`.
fn ev_name(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData) -> Value {
    let local: Value = lookup(it, src, d.start, d.end)
    // COPY POINT 1 of 3 (see `deep_copy`): reading a value out of a binding. The
    // reference clones here; a handle would let `let a = t` alias `t`'s run.
    if local.tag >= 0 { return deep_copy(it, local) }

    let init: i32 = const_init(p, src, d.start, d.end)
    if init < 0 { return fail(it, "this is not a compile-time constant", d.start, d.end) }

    // Cycle detection: a const already being evaluated is defined in terms of itself.
    let np: usize = list.len(i32, it.prog)
    var k: usize = 0
    for k < np {
        let ns: i32 = list.get(i32, it.prog, k)
        let ne: i32 = list.get(i32, it.prog, k + 1)
        if str_eq(src[d.start .. d.end], src[ns as usize .. ne as usize]) {
            return fail(it, "this constant is defined in terms of itself", d.start, d.end)
        }
        k = k + 2
    }
    list.push(i32, it.prog, d.start as i32)
    list.push(i32, it.prog, d.end as i32)

    // A const initializer is evaluated in its own scope: it cannot see the locals of
    // whatever expression referred to it.
    let saved: usize = list.len(i32, it.envn)
    let savedv: usize = list.len(i64, it.envv)
    scope_push(it)
    let res: Value = ev(it, p, src, init)
    scope_pop(it)
    list.truncate(i32, it.envn, saved)
    list.truncate(i64, it.envv, savedv)
    list.truncate(i32, it.prog, np)
    return res
}

fn ev_unary(mut it: Interp, op: i32, read v: Value, s: usize, e: usize) -> Value {
    if op == 1 {                                      // neg
        if v.tag != 0 { return fail(it, "this operator does not apply here at compile time", s, e) }
        if v.i == 0 - 9223372036854775807 - 1 { return fail(it, "negation overflowed at compile time", s, e) }
        return v_int(0 - v.i)
    }
    if op == 2 {                                      // not
        if v.tag != 1 { return fail(it, "this operator does not apply here at compile time", s, e) }
        return v_bool(v.i == 0)
    }
    if op == 3 {                                      // bitnot
        if v.tag != 0 { return fail(it, "this operator does not apply here at compile time", s, e) }
        return v_int(0 - v.i - 1)
    }
    return fail(it, "this operator does not apply here at compile time", s, e)
}

fn ev_binary(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData) -> Value {
    // `and`/`or` short-circuit, so the right side is evaluated only if needed — which
    // also means `false and <not-constant>` is still a constant.
    if d.op == 12 {                                   // and
        let l: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        if l.tag != 1 { return fail(it, "`and` needs a bool", d.start, d.end) }
        if l.i == 0 { return v_bool(false) }
        let r: Value = ev(it, p, src, d.b)
        if it.failed { return v_unit() }
        if r.tag != 1 { return fail(it, "`and` needs a bool", d.start, d.end) }
        return v_bool(r.i == 1)
    }
    if d.op == 13 {                                   // or
        let l: Value = ev(it, p, src, d.a)
        if it.failed { return v_unit() }
        if l.tag != 1 { return fail(it, "`or` needs a bool", d.start, d.end) }
        if l.i == 1 { return v_bool(true) }
        let r: Value = ev(it, p, src, d.b)
        if it.failed { return v_unit() }
        if r.tag != 1 { return fail(it, "`or` needs a bool", d.start, d.end) }
        return v_bool(r.i == 1)
    }

    let l: Value = ev(it, p, src, d.a)
    if it.failed { return v_unit() }
    let r: Value = ev(it, p, src, d.b)
    if it.failed { return v_unit() }

    if l.tag == 0 { if r.tag == 0 { return int_binop(it, d.op, l.i, r.i, d.start, d.end) } }
    if l.tag == 2 { if r.tag == 2 { return str_binop(it, d.op, l, r, d.start, d.end) } }
    if l.tag == 4 {
        if r.tag == 4 {
            // Equality only — see `val_eq`. An ordering on aggregates would be invented.
            if d.op == 6 { return v_bool(val_eq(it, l, r)) }
            if d.op == 7 { return v_bool(val_eq(it, l, r) == false) }
            return fail(it, "this operator does not apply to lists", d.start, d.end)
        }
    }
    if l.tag == 1 {
        if r.tag == 1 {
            if d.op == 6 { return v_bool(l.i == r.i) }
            if d.op == 7 { return v_bool(l.i != r.i) }
            return fail(it, "this operator does not apply to bools", d.start, d.end)
        }
    }
    return fail(it, "these operands do not combine at compile time", d.start, d.end)
}

// Integer arithmetic. Every operation is CHECKED: a comptime overflow is a compile
// error, never a silent wrap. (Runtime overflow semantics are a separate workstream's;
// a constant the compiler folds must simply be right.)
fn int_binop(mut it: Interp, op: i32, a: i64, b: i64, s: usize, e: usize) -> Value {
    if op == 1 {
        if b > 0 { if a > 9223372036854775807 - b { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        if b < 0 { if a < (0 - 9223372036854775807 - 1) - b { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        return v_int(a + b)
    }
    if op == 2 {
        if b < 0 { if a > 9223372036854775807 + b { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        if b > 0 { if a < (0 - 9223372036854775807 - 1) + b { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        return v_int(a - b)
    }
    if op == 3 {
        if a != 0 {
            let r: i64 = a * b
            if r / a != b { return fail(it, "this arithmetic overflowed at compile time", s, e) }
            return v_int(r)
        }
        return v_int(0)
    }
    if op == 4 {
        if b == 0 { return fail(it, "division by zero at compile time", s, e) }
        if b == 0 - 1 { if a == 0 - 9223372036854775807 - 1 { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        return v_int(a / b)
    }
    if op == 5 {
        if b == 0 { return fail(it, "remainder by zero at compile time", s, e) }
        if b == 0 - 1 { if a == 0 - 9223372036854775807 - 1 { return fail(it, "this arithmetic overflowed at compile time", s, e) } }
        return v_int(a % b)
    }
    if op == 6 { return v_bool(a == b) }
    if op == 7 { return v_bool(a != b) }
    if op == 8 { return v_bool(a < b) }
    if op == 9 { return v_bool(a <= b) }
    if op == 10 { return v_bool(a > b) }
    if op == 11 { return v_bool(a >= b) }
    if op == 14 { return v_int(a & b) }
    if op == 15 { return v_int(a | b) }
    if op == 16 { return v_int(a ^ b) }
    if op == 17 {
        if b < 0 { return fail(it, "shift amount is negative", s, e) }
        if b > 63 { return fail(it, "shift amount is too large", s, e) }
        return v_int(a << b)
    }
    if op == 18 {
        if b < 0 { return fail(it, "shift amount is negative", s, e) }
        if b > 63 { return fail(it, "shift amount is too large", s, e) }
        return v_int(a >> b)
    }
    return fail(it, "this operator does not apply to integers", s, e)
}

fn str_binop(mut it: Interp, op: i32, read l: Value, read r: Value, s: usize, e: usize) -> Value {
    if op == 1 {                                      // concatenation
        var tmp: String = string_new()
        let a: str = str_of(it, l)
        string_push(tmp, a)
        let b: str = str_of(it, r)
        string_push(tmp, b)
        let view: str = string_view(tmp)
        return v_str(it, view)
    }
    let a: str = str_of(it, l)
    let b: str = str_of(it, r)
    if op == 6 { return v_bool(str_eq(a, b)) }
    if op == 7 { return v_bool(str_eq(a, b) == false) }
    let c: i32 = str_cmp(a, b)
    if op == 8 { return v_bool(c < 0) }
    if op == 9 { return v_bool(c <= 0) }
    if op == 10 { return v_bool(c > 0) }
    if op == 11 { return v_bool(c >= 0) }
    return fail(it, "this operator does not apply to strings", s, e)
}

// Lexicographic byte comparison, mirroring Rust's `str` ordering (which is byte-wise
// on UTF-8, so this agrees for every input the lexer can produce).
fn str_cmp(a: str, b: str) -> i32 {
    var i: usize = 0
    for i < a.len {
        if i >= b.len { return 1 }
        let x: i32 = a[i] as i32
        let y: i32 = b[i] as i32
        if x < y { return 0 - 1 }
        if x > y { return 1 }
        i = i + 1
    }
    if b.len > a.len { return 0 - 1 }
    return 0
}

// A block's value is its tail expression (otherwise Unit); `let` bindings scope to the
// block. A `return` anywhere inside sets `returning`, which stops evaluation here and
// propagates to the enclosing call.
fn ev_block(mut it: Interp, read p: parser.Parser, read src: str, eid: i32) -> Value {
    if eid < 0 { return v_unit() }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind != 23 { return ev(it, p, src, eid) }
    scope_push(it)
    let res: Value = ev_stmts(it, p, src, d.x, d.y)
    scope_pop(it)
    return res
}

fn ev_stmts(mut it: Interp, read p: parser.Parser, read src: str, start: i32, count: i32) -> Value {
    var tail: Value = v_unit()
    var k: i32 = 0
    for k < count {
        if it.failed { return v_unit() }
        let sid: i32 = list.get(i32, p.sar, (start + k) as usize)
        let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        if s.kind == 0 {                              // Let
            if s.a < 0 { return fail(it, "a compile-time `let` needs an initializer", s.start, s.end) }
            let v: Value = ev(it, p, src, s.a)
            if it.failed { return v_unit() }
            bind(it, s.x, s.y, v)
            tail = v_unit()
        } else if s.kind == 1 {                       // Return
            var v: Value = v_unit()
            if s.a >= 0 { v = ev(it, p, src, s.a) }
            if it.failed { return v_unit() }
            if it.returning == false {
                it.returning = true
                it.rtag = v.tag
                it.ri = v.i
            }
            return v
        } else {                                      // Expr
            let v: Value = ev(it, p, src, s.a)
            if it.failed { return v_unit() }
            // Only a trailing expression is the block's value.
            if k + 1 == count { tail = v } else { tail = v_unit() }
        }
        if it.returning {
            // A nested `return` already fixed this call's result.
            return Value{ tag: it.rtag, i: it.ri }
        }
        // A pending `break`/`continue` stops this block too, and keeps travelling until
        // the loop that owns it consumes it (tier 7).
        if it.lctl != 0 { return v_unit() }
        k = k + 1
    }
    return tail
}

fn ev_call(mut it: Interp, read p: parser.Parser, read src: str, read d: parser.ExprData) -> Value {
    let ce: parser.ExprData = list.get(parser.ExprData, p.ex, d.a as usize)
    // `@name(…)` (Attr, kind 21) is a compiler QUERY, not a call. Reflection lives in
    // this `@`-prefixed space rather than beside `size_of`/`align_of`/`offset_of`
    // precisely because those are ordinary identifiers and can be shadowed by a user
    // function of the same name — this very compiler declares `fn field_type(…)` in
    // typeck.jtr, which a bare-name intrinsic would silently have hijacked.
    if ce.kind == 21 {
        // The Attr node keeps its NAME span in `(x, y)` separately from the whole
        // `@name` span, so the sigil never has to be sliced off by hand.
        let nm: str = src[ce.x as usize .. ce.y as usize]
        if is_reflect(nm) { return ev_reflect(it, p, src, nm, d) }
        return fail(it, "this is not a compile-time query", d.start, d.end)
    }
    if ce.kind != 2 {
        return fail(it, "only a named function can be called at compile time", d.start, d.end)
    }
    let fid: i32 = fn_item(p, src, ce.start, ce.end)
    if fid < 0 {
        return fail(it, "this is not a function that can run at compile time", d.start, d.end)
    }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
    if f.w < 0 { return fail(it, "this function has no body to evaluate", d.start, d.end) }
    if f.b != d.y {
        return fail(it, "this call has the wrong number of arguments", d.start, d.end)
    }
    if it.depth >= 64 {
        return fail(it, "compile-time call nesting is too deep (is the recursion unbounded?)", d.start, d.end)
    }

    // Evaluate the arguments in the CALLER's scope, then bind them in a fresh one: a
    // call body sees only its parameters, never the caller's locals.
    var argn: List(i32) = list.make(i32, it.a)
    var argv: List(i64) = list.make(i64, it.a)
    var k: i32 = 0
    for k < d.y {
        let base: usize = (f.a + k * 7) as usize
        let comp: i32 = list.get(i32, p.iar, base)
        let is_self: i32 = list.get(i32, p.iar, base + 4)
        if comp != 0 { return fail(it, "this function cannot be called at compile time", d.start, d.end) }
        if is_self != 0 { return fail(it, "this function cannot be called at compile time", d.start, d.end) }
        let aid: i32 = list.get(i32, p.ar, (d.x + k) as usize)
        let v: Value = ev(it, p, src, aid)
        if it.failed { return v_unit() }
        list.push(i32, argn, list.get(i32, p.iar, base + 2))
        list.push(i32, argn, list.get(i32, p.iar, base + 3))
        list.push(i32, argn, v.tag)
        list.push(i64, argv, v.i)
        k = k + 1
    }

    // The callee's frame: a fresh scope holding only the parameters. `returning` is
    // saved across the call so a callee's `return` can never escape into its caller.
    let outer_ret: bool = it.returning
    let outer_tag: i32 = it.rtag
    let outer_i: i64 = it.ri
    it.returning = false

    scope_push(it)
    var j: i32 = 0
    for j < d.y {
        let b2: usize = (j * 3) as usize
        let ns: i32 = list.get(i32, argn, b2)
        let ne: i32 = list.get(i32, argn, b2 + 1)
        let tg: i32 = list.get(i32, argn, b2 + 2)
        let pv: i64 = list.get(i64, argv, j as usize)
        bind(it, ns, ne, Value{ tag: tg, i: pv })
        j = j + 1
    }
    it.depth = it.depth + 1
    var res: Value = ev_block(it, p, src, f.w)
    it.depth = it.depth - 1
    scope_pop(it)

    if it.returning { res = Value{ tag: it.rtag, i: it.ri } }
    it.returning = outer_ret
    it.rtag = outer_tag
    it.ri = outer_i
    return res
}

// Re-escape a string value for the dump. The dump is line-oriented, so a value
// containing a newline would otherwise split into two records and read as a
// divergence when the two implementations actually agree.
fn push_escaped(mut dst: String, s: str) {
    var i: usize = 0
    for i < s.len {
        let c: i32 = s[i] as i32
        if c == 92 { string_push(dst, "\\\\") }
        else if c == 10 { string_push(dst, "\\n") }
        else if c == 9 { string_push(dst, "\\t") }
        else if c == 13 { string_push(dst, "\\r") }
        else { string_push(dst, s[i .. i + 1]) }
        i = i + 1
    }
}

// ---- tier 3: reflection over the declared shape ----

// Is `n` one of the four compile-time reflection queries? Mirrors
// `is_reflect_intrinsic`.
pub fn is_reflect(n: str) -> bool {
    if str_eq(n, "type_name") { return true }
    if str_eq(n, "field_count") { return true }
    if str_eq(n, "field_name") { return true }
    if str_eq(n, "field_type") { return true }
    return false
}

// The `ItemId` of the struct/record/union named `src[ns..ne]`, or -1. All three share
// the struct item and the field grammar, so all three reflect identically.
fn struct_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    let n: usize = list.len(parser.ItemData, p.it)
    var i: usize = 0
    for i < n {
        let d: parser.ItemData = list.get(parser.ItemData, p.it, i)
        if d.kind == 4 {
            if str_eq(src[ns .. ne], src[d.x as usize .. d.y as usize]) { return i as i32 }
        }
        i = i + 1
    }
    return 0 - 1
}

// The `mar` base index of the struct's `i`-th FIELD, skipping methods (tag 1), or -1.
// Methods are not fields: only the declared data shape is reflected.
fn nth_field(read p: parser.Parser, read d: parser.ItemData, want: i32) -> i32 {
    var seen: i32 = 0
    var k: i32 = 0
    for k < d.b {
        let base: i32 = d.a + k * 10
        if list.get(i32, p.mar, base as usize) != 1 {
            if seen == want { return base }
            seen = seen + 1
        }
        k = k + 1
    }
    return 0 - 1
}

fn field_total(read p: parser.Parser, read d: parser.ItemData) -> i32 {
    var seen: i32 = 0
    var k: i32 = 0
    for k < d.b {
        if list.get(i32, p.mar, (d.a + k * 10) as usize) != 1 { seen = seen + 1 }
        k = k + 1
    }
    return seen
}

// Evaluate a reflection query. Field order is DECLARATION order — what the author
// wrote — which is what makes repeated queries and generated output stable. (A future
// `@layout(auto)` may reorder *storage*; it will not reorder this.)
fn ev_reflect(mut it: Interp, read p: parser.Parser, read src: str, nm: str, read d: parser.ExprData) -> Value {
    // The first argument is a TYPE, named directly — it is not evaluated as a value,
    // exactly as `offset_of(Point, y)`'s second argument is a bare field name.
    if d.y < 1 { return fail(it, "this query needs a type as its first argument", d.start, d.end) }
    let aid: i32 = list.get(i32, p.ar, d.x as usize)
    let a0: parser.ExprData = list.get(parser.ExprData, p.ex, aid as usize)
    if a0.kind != 2 {
        return fail(it, "this query's first argument must be a named type", a0.start, a0.end)
    }

    // Answerable for any named type, including a primitive: it reports what the author
    // wrote, and needs no declaration to do so.
    if str_eq(nm, "type_name") { return v_str(it, src[a0.start .. a0.end]) }

    let sid: i32 = struct_item(p, src, a0.start, a0.end)
    if sid < 0 {
        return fail(it, "this is not a struct this compiler can reflect over", a0.start, a0.end)
    }
    let sd: parser.ItemData = list.get(parser.ItemData, p.it, sid as usize)
    if str_eq(nm, "field_count") { return v_int(field_total(p, sd) as i64) }

    // The remaining two are indexed. The index is an ordinary comptime expression, so
    // `@field_name(P, I)` for a `const I` works — but it must EVALUATE, and an
    // out-of-range one is an error rather than a clamp or an empty string.
    if d.y < 2 { return fail(it, "this query needs a field index as its second argument", d.start, d.end) }
    let iid: i32 = list.get(i32, p.ar, (d.x + 1) as usize)
    let iv: Value = ev(it, p, src, iid)
    if it.failed { return v_unit() }
    let ie: parser.ExprData = list.get(parser.ExprData, p.ex, iid as usize)
    if iv.tag != 0 { return fail(it, "a field index must be a non-negative integer", ie.start, ie.end) }
    if iv.i < 0 { return fail(it, "a field index must be a non-negative integer", ie.start, ie.end) }
    let base: i32 = nth_field(p, sd, iv.i as i32)
    if base < 0 { return fail(it, "there is no field at this index", ie.start, ie.end) }

    if str_eq(nm, "field_name") {
        let fns: i32 = list.get(i32, p.mar, (base + 2) as usize)
        let fne: i32 = list.get(i32, p.mar, (base + 3) as usize)
        return v_str(it, src[fns as usize .. fne as usize])
    }
    // Rendered by the same `at_ty` the documentation page and the attestation manifest
    // use, so a reflected type name cannot disagree with the documented one.
    var tmp: String = string_new()
    at_ty(tmp, p, src, list.get(i32, p.mar, (base + 4) as usize))
    let view: str = string_view(tmp)
    return v_str(it, view)
}

// A passing convention's surface keyword (`doc`'s `conv_label`).
pub fn at_conv_label(conv: i32) -> str {
    if conv == 1 { return "read" }
    if conv == 2 { return "mut" }
    if conv == 3 { return "take" }
    if conv == 4 { return "out" }
    return ""
}

// ---- the shared type renderer (tier 3 needs it, doc/attest already did) ----
//
// Render a type in Jestyr surface syntax (`doc::ty_str`), recursing through the AST
// type arena. Kinds: 0 Name 1 TypeKw 2 Ptr 3 Slice 4 Array 5 GenRef 6 RegionRef
// 7 App 8 Path 9 Fn 10 Dyn 11 Error.
//
// It lives HERE rather than in cgen.jtr (which is where it was written, for the
// attestation manifest and the documentation page) because `@field_type` needs the very
// same rendering and this module sits below that one. cgen.jtr keeps a thin wrapper, so
// there is exactly ONE renderer: a reflected type name cannot disagree with the
// documented or attested one, which is the same invariant `at_guarantee_phrases` gives
// the guarantee text.
pub fn at_ty(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    let d: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if d.kind == 0 { string_push(sb, src[d.start .. d.end]) return }
    if d.kind == 1 { string_push(sb, "type") return }
    if d.kind == 2 {
        if d.op == 1 { string_push(sb, "*mut ") } else if d.op == 2 { string_push(sb, "*const ") } else { string_push(sb, "*") }
        at_ty(sb, p, src, d.a)
        return
    }
    if d.kind == 3 { string_push(sb, "[]") at_ty(sb, p, src, d.a) return }
    if d.kind == 4 {
        string_push(sb, "[")
        let le: parser.ExprData = list.get(parser.ExprData, p.ex, d.b as usize)
        if le.kind == 0 { string_push(sb, src[le.start .. le.end]) } else { string_push(sb, "_") }
        string_push(sb, "]")
        at_ty(sb, p, src, d.a)
        return
    }
    if d.kind == 5 { string_push(sb, "&") at_ty(sb, p, src, d.a) return }
    if d.kind == 6 {
        string_push(sb, "&[")
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "]")
        at_ty(sb, p, src, d.a)
        return
    }
    if d.kind == 7 or d.kind == 8 {
        string_push(sb, src[d.x as usize .. d.y as usize])
        if d.kind == 8 {
            string_push(sb, ".")
            string_push(sb, src[d.z as usize .. d.w as usize])
        }
        // App always parenthesizes; a Path only when it has args.
        if d.kind == 7 or d.a > 0 {
            string_push(sb, "(")
            var i: i32 = 0
            for i < d.a {
                if i > 0 { string_push(sb, ", ") }
                at_ty(sb, p, src, list.get(i32, p.tar, (d.op + i) as usize))
                i = i + 1
            }
            string_push(sb, ")")
        }
        return
    }
    if d.kind == 9 {
        string_push(sb, "fn(")
        var i: i32 = 0
        for i < d.a {
            if i > 0 { string_push(sb, ", ") }
            let pc: i32 = list.get(i32, p.tar, (d.op + i * 2) as usize)
            if pc != 0 { string_push(sb, at_conv_label(pc)) string_push(sb, " ") }
            at_ty(sb, p, src, list.get(i32, p.tar, (d.op + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, ")")
        if d.x >= 0 {
            string_push(sb, " -> ")
            if d.b != 0 { string_push(sb, at_conv_label(d.b)) string_push(sb, " ") }
            at_ty(sb, p, src, d.x)
        }
        return
    }
    if d.kind == 10 {
        string_push(sb, "dyn ")
        string_push(sb, src[d.x as usize .. d.y as usize])
        return
    }
    string_push(sb, "<error-type>")
}

// ---- the dump driver (mirrors `typeck.run`'s shape) ----

// Evaluate the initializer of every top-level `const` in the file named by argv[1], in
// declaration order, printing one record each:
//
//     <name> int <value>            <name> str <text>
//     <name> bool true|false        <name> unit
//     <name> error <message>
//
// The error TEXT is printed, not merely the fact of failure: refusal quality is part
// of what the two implementations have to agree on, so a golden that only compared
// success/failure would let the diagnostics drift apart.
// Plain decimal into a String. Built digit-by-digit from the ABSOLUTE value accumulated
// as a NEGATIVE number, because `0 - i64::MIN` does not exist — the one integer that
// makes the obvious version wrong.
fn push_dec(mut sb: String, v: i64) {
    if v == 0 { string_push(sb, "0")  return }
    var neg: bool = false
    var n: i64 = v
    if n > 0 { n = 0 - n } else { neg = true }
    var digits: String = string_new()
    for n < 0 {
        let d: i64 = 0 - (n % 10)
        n = n / 10
        if d == 0 { string_push(digits, "0") }
        if d == 1 { string_push(digits, "1") }
        if d == 2 { string_push(digits, "2") }
        if d == 3 { string_push(digits, "3") }
        if d == 4 { string_push(digits, "4") }
        if d == 5 { string_push(digits, "5") }
        if d == 6 { string_push(digits, "6") }
        if d == 7 { string_push(digits, "7") }
        if d == 8 { string_push(digits, "8") }
        if d == 9 { string_push(digits, "9") }
    }
    if neg { string_push(sb, "-") }
    let rev: str = string_view(digits)
    var k: usize = rev.len
    for k > 0 {
        k = k - 1
        string_push(sb, rev[k .. k + 1])
    }
    string_free(digits)
}

// Render a value for the dump, one line, nesting included: `[1, 2, [3]]`. Strings are
// escaped exactly as the scalar `str` record is, so a value containing a newline stays
// on one line and cannot read as two records.
fn render_value(read it: Interp, mut sb: String, read v: Value) {
    if v.tag == 0 { push_dec(sb, v.i)  return }
    if v.tag == 1 {
        if v.i == 1 { string_push(sb, "true") } else { string_push(sb, "false") }
        return
    }
    if v.tag == 2 {
        string_push(sb, "\"")
        push_escaped(sb, str_of(it, v))
        string_push(sb, "\"")
        return
    }
    if v.tag == 4 {
        string_push(sb, "[")
        let n: i64 = list_len(it, v)
        var k: i64 = 0
        for k < n {
            if k > 0 { string_push(sb, ", ") }
            let e: Value = list_at(it, v, k)
            render_value(it, sb, e)
            k = k + 1
        }
        string_push(sb, "]")
        return
    }
    string_push(sb, "()")
}

pub fn run() -> i32 {
    var a: Allocator = mem.system_allocator()
    var itn: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(itn)
    if env.argc() > 1 {
        var srcs: String = fs.read_text(env.argv(1))
        var p: parser.Parser = parser.parse_source(string_view(srcs), itn, kwcount, a)
        let src: str = string_view(srcs)
        var ci: Interp = make(a)
        let n: usize = list.len(parser.ItemData, p.it)
        var i: usize = 0
        for i < n {
            let d: parser.ItemData = list.get(parser.ItemData, p.it, i)
            if d.kind == 2 {
                print_str(src[d.x as usize .. d.y as usize])
                let v: Value = eval(ci, p, src, d.b)
                if ci.failed {
                    print_str("error")
                    print_str(string_view(ci.emsg))
                } else if v.tag == 0 {
                    print_str("int")
                    print_int(v.i)
                } else if v.tag == 1 {
                    print_str("bool")
                    if v.i == 1 { print_str("true") } else { print_str("false") }
                } else if v.tag == 2 {
                    print_str("str")
                    var esc: String = string_new()
                    push_escaped(esc, str_of(ci, v))
                    print_str(string_view(esc))
                    string_free(esc)
                } else if v.tag == 4 {
                    print_str("list")
                    var rend: String = string_new()
                    render_value(ci, rend, v)
                    print_str(string_view(rend))
                    string_free(rend)
                } else {
                    print_str("unit")
                }
            }
            i = i + 1
        }
        string_free(srcs)
    }
    return 0
}
