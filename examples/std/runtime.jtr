// std/runtime.jtr — an event loop you can name, hold, and step by hand.
//
// TIER: `std`. It allocates through the `Allocator` you give it and reaches the OS only
// through the `time.Clock` you give it — so a `Runtime` over `time.manual()` touches
// nothing at all and runs in a test.
//
// ─── The rule this module exists to obey ──────────────────────────────────────
//
// **No hidden runtime.** If timers, cancellation, or later work-stealing and IO polling
// exist, the caller must be able to NAME the runtime and drive it. That is the difference
// between an async story you can test and one you can only observe: a global executor
// started on first use is a hidden global with a thread pool attached, and this tree has
// spent a lot of effort not having hidden globals.
//
// So there is no `spawn()` free function, no ambient executor, and no `block_on` that
// conjures one. You construct a `Runtime`, you hand it to whoever schedules work, and you
// step it. `fire_due(rt)` runs what is due and returns; `run_until_idle(rt)` runs until
// nothing is left. Neither ever blocks, and neither ever sleeps — see below.
//
// ─── IO is here now, and this module still never touches the OS ───────────────
//
// This header used to say there was no IO and that adding a `Pollable` which could not poll
// would be worse than having none. `Pollable` has landed, and the way it landed keeps the
// promise that made the deferral worth making: **the runtime holds the registry and does
// not perform the wait.** Readiness arrives through a `Poller` — a `ctx` + fn-pointer pair,
// the `mem.Allocator` shape — so `std/syspoll` supplies the kernel's answer, a test
// supplies a scripted one, and this module reaches the operating system through exactly the
// two handles it is given: a `Clock` and a `Poller`.
//
// That is why `epoll`/`kqueue`/IOCP being three different models does not infect the loop.
// They are three different `Poller` implementations behind one signature, and the loop
// cannot tell them apart — which is the property that makes the deterministic test runtime
// possible at all.
//
// **Nothing here sleeps.** A loop with no IO cannot wait for anything but time, and a real
// sleep would make every test take as long as its longest timer. `fire_due` asks the clock,
// fires what is due, and returns; `next_deadline` tells a caller how long it could sleep
// if it had something to sleep on. Under `time.host()` a caller drives that itself; under
// `time.manual()` a test calls `time.advance` and gets the same behaviour instantly.
//
// ─── Order is deterministic, and ties break by insertion ──────────────────────
//
// Timers fire in deadline order. Two timers with the SAME deadline fire in the order they
// were registered — not in an arbitrary order, and not by callback address, which would
// vary between builds. That is what lets a test assert a sequence rather than a set, and
// it is the same reasoning `std/walk` sorts for.
//
// ─── Cancellation is a token, not a callback ──────────────────────────────────
//
// `cancel(rt, id)` marks a timer dead; the loop drops it when it comes due. It does NOT
// remove it eagerly, because eager removal in the middle of a fire loop is where
// use-after-free lives in every event loop that has one. A cancelled timer costs one
// comparison at its deadline and nothing else.
//
// Run the tests:  jestyrc test examples/std/runtime_test.jtr

import "list"
import "time"
import "sink"

// A scheduled callback. `on_fire(ctx, id, now)` — the `ctx` + fn-pointer shape
// `mem.Allocator` established and the only one a fn pointer can carry state through.
@copy pub struct Task {
    ctx: *mut u8,
    on_fire: fn(*mut u8, i64, i64),
}

@no_alloc @no_os pub fn task(ctx: *mut u8, f: fn(*mut u8, i64, i64)) -> Task {
    return Task{ ctx: ctx, on_fire: f }
}

// The loop. `clock` is the only thing here that can touch the OS, and only when it is
// `time.host()`.
pub struct Runtime {
    clock: time.Clock,
    tasks: List(Task),
    // Five parallel columns, one entry per timer: a struct-of-arrays rather than a
    // `List(Timer)`, for the same reason `std/hashmap` is one — a generic type cannot hold
    // a pointer to another generic type, and the columns index identically anyway.
    deadlines: List(i64),
    ids: List(i64),
    alive: List(bool),
    groups: List(i64),          // the CancelToken each timer was registered under
    dead_groups: List(i64),     // tokens that have been cancelled, so work can ask
    next_id: i64,
    next_group: i64,
    fired: i64,
    cancelled: i64,
    // ---- pollables: the same struct-of-arrays shape, one entry per watch ----
    fds: List(i64),             // the handle the poller asks about
    pids: List(i64),
    palive: List(bool),
    pgroups: List(i64),
    ptasks: List(Task),
    poller: Poller,
    ready: i64,                 // how many watches have fired, the pollable half of `fired`
}

// **How readiness reaches the loop, without the loop knowing what a socket is.**
//
// `wait_fn(ctx, fds, ready, n, timeout_nanos)` blocks up to `timeout_nanos`, writes 1 into
// `ready[i]` for each of the `n` handles in `fds` that can be read without blocking, and
// returns the count — or -1 if the platform refused.
//
// A `ctx` + fn-pointer pair rather than a trait, for the reason `mem.Allocator` is one:
// Jestyr has no closures that cross a module boundary, and this shape makes the poller's
// state EXPLICIT. `std/syspoll.host()` is the kernel's answer; a test writes its own in
// four lines and drives the whole loop deterministically.
//
// `@copy`: a pointer and a function pointer, exactly like an `Allocator`.
@copy pub struct Poller {
    ctx: *mut u8,
    wait_fn: fn(*mut u8, *mut i64, *mut u8, usize, i64) -> i64,
}

@no_alloc @no_os pub fn poller(ctx: *mut u8, f: fn(*mut u8, *mut i64, *mut u8, usize, i64) -> i64) -> Poller {
    return Poller{ ctx: ctx, wait_fn: f }
}

// The poller a `Runtime` starts with: it is never CALLED, because a runtime with no watches
// never asks. It exists so `Runtime` has a total value for the field rather than an
// optional one — an `Option(Poller)` would put a branch on every step to express a state
// that is already observable as `watching(rt) == 0`.
fn never_ready(ctx: *mut u8, fds: *mut i64, ready: *mut u8, n: usize, timeout_nanos: i64) -> i64 {
    return 0
}

@no_alloc @no_os pub fn no_poller() -> Poller {
    return Poller{ ctx: null, wait_fn: &never_ready }
}

// ---- cancellation ------------------------------------------------------------
//
// **A token, not a flag, and not an id.** `cancel(rt, id)` already existed and cancels one
// timer; it is the right tool when you hold exactly the thing you scheduled. It is the
// wrong tool for the case that actually arises in a long-running program — "stop
// everything this request/connection/build started" — because the caller would have to
// keep every id it ever handed out.
//
// A `CancelToken` is a GROUP handle. Every registration names one, `cancel_all` kills the
// group, and `is_cancelled` lets work already in flight ask whether it should stop. That
// last part is why this is a token and not a counter: cancellation has to be observable by
// the thing being cancelled, and an ambient flag would make it invisible in signatures.
//
// `@copy`: one integer, freely stored and passed. A token that had to be moved would be a
// token you could only hand to one task.
@copy pub struct CancelToken {
    pub grp: i64,
}

// The token that groups nothing. **`cancel_all` on it cancels NOTHING**, deliberately — a
// detached token is "this work is not part of any group", and if it were a wildcard then
// one careless `cancel_all(rt, detached())` would stop every unrelated timer in the loop.
@no_alloc @no_os pub fn detached() -> CancelToken {
    return CancelToken{ grp: 0 }
}

// A fresh group token from this runtime. Ids are per-runtime, so a token from one loop
// means nothing to another — which is correct: a group is a set of THIS loop's timers.
pub fn token(mut rt: Runtime) -> CancelToken {
    rt.next_group = rt.next_group + 1
    return CancelToken{ grp: rt.next_group }
}

// Has this token been cancelled? The question long-running work asks between steps.
pub fn is_cancelled(read rt: Runtime, read tok: CancelToken) -> bool {
    if tok.grp == 0 { return false }
    var i: usize = 0
    for i < list.len(i64, rt.dead_groups) {
        if list.get(i64, rt.dead_groups, i) == tok.grp { return true }
        i = i + 1
    }
    return false
}

// Cancel every live timer registered under `tok`, and mark the token cancelled so work
// already running can see it. Returns how many timers this call killed.
//
// Marking the token is separate from killing the timers on purpose: a task that is
// mid-flight has no timer left to cancel, and the only way it can learn to stop is to ask.
pub fn cancel_all(mut rt: Runtime, read tok: CancelToken) -> i64 {
    if tok.grp == 0 { return 0 }
    if is_cancelled(rt, tok) == false {
        list.push(i64, rt.dead_groups, tok.grp)
    }
    var n: i64 = 0
    var i: usize = 0
    for i < list.len(i64, rt.groups) {
        if list.get(i64, rt.groups, i) == tok.grp and list.get(bool, rt.alive, i) {
            list.set(bool, rt.alive, i, false)
            rt.cancelled = rt.cancelled + 1
            n = n + 1
        }
        i = i + 1
    }
    // **Watches are cancelled by the same token as timers**, and that is the whole reason
    // cancellation is a GROUP rather than an id: "stop everything this connection started"
    // has to reach its socket watch and its timeout timer in one call, or a caller ends up
    // keeping a list of both.
    var j: usize = 0
    for j < list.len(i64, rt.pgroups) {
        if list.get(i64, rt.pgroups, j) == tok.grp and list.get(bool, rt.palive, j) {
            list.set(bool, rt.palive, j, false)
            rt.cancelled = rt.cancelled + 1
            n = n + 1
        }
        j = j + 1
    }
    return n
}

// `take c` because the runtime STORES the clock: a `read` borrow is second-class and may
// not outlive the call, and a runtime that borrowed its clock could not outlive the frame
// that made it. Taking ownership is the honest signature -- the clock belongs to the loop.
pub fn make(read a: Allocator, take c: time.Clock) -> Runtime {
    return Runtime{ clock: c, tasks: list.make(Task, a), deadlines: list.make(i64, a), ids: list.make(i64, a), alive: list.make(bool, a), groups: list.make(i64, a), dead_groups: list.make(i64, a), next_id: 1, next_group: 0, fired: 0, cancelled: 0, fds: list.make(i64, a), pids: list.make(i64, a), palive: list.make(bool, a), pgroups: list.make(i64, a), ptasks: list.make(Task, a), poller: no_poller(), ready: 0 }
}

pub fn free(mut rt: Runtime) {
    list.free(Task, rt.tasks)
    list.free(i64, rt.deadlines)
    list.free(i64, rt.ids)
    list.free(bool, rt.alive)
    list.free(i64, rt.groups)
    list.free(i64, rt.dead_groups)
    list.free(i64, rt.fds)
    list.free(i64, rt.pids)
    list.free(bool, rt.palive)
    list.free(i64, rt.pgroups)
    list.free(Task, rt.ptasks)
}

// Schedule `t` to fire `after` nanoseconds from now. Returns the timer's id, which is what
// `cancel` takes.
//
// The deadline is computed from the clock ONCE, at registration. A timer whose deadline
// were recomputed on every poll would drift, and under a manual clock it would never fire
// at all — the bug that makes hand-rolled loops untestable.
// The token is REQUIRED rather than optional, and `detached()` is the explicit spelling
// for "no group". An optional token would make the common case default to ungrouped
// silently, which is exactly the ambient-cancellation shape this design is avoiding — the
// choice should be visible at the call site either way.
//
// Registering under an ALREADY-CANCELLED token refuses: the timer is not scheduled and -1
// comes back. Accepting it would let a task outlive the cancellation that was supposed to
// stop it, which is the subtle version of a cancellation bug — everything looks cancelled
// and one straggler still runs.
pub fn after(mut rt: Runtime, after_nanos: i64, read tok: CancelToken, read t: Task) -> i64 {
    if is_cancelled(rt, tok) { return 0 - 1 }
    let now: i64 = time.read_nanos(rt.clock)
    let id: i64 = rt.next_id
    rt.next_id = rt.next_id + 1
    list.push(Task, rt.tasks, t)
    list.push(i64, rt.deadlines, now + after_nanos)
    list.push(i64, rt.ids, id)
    list.push(bool, rt.alive, true)
    list.push(i64, rt.groups, tok.grp)
    return id
}

// Schedule `t` for the next poll, whenever that is. `after(rt, 0, t)` with the intent
// spelled out.
pub fn soon(mut rt: Runtime, read tok: CancelToken, read t: Task) -> i64 {
    return after(rt, 0, tok, t)
}

// Mark `id` dead. Returns whether it was alive.
//
// The entry is NOT removed here — see the header. Cancelling from inside a callback is
// therefore safe, which is the case that matters and the one an eager removal breaks.
pub fn cancel(mut rt: Runtime, id: i64) -> bool {
    var i: usize = 0
    for i < list.len(i64, rt.ids) {
        if list.get(i64, rt.ids, i) == id and list.get(bool, rt.alive, i) {
            list.set(bool, rt.alive, i, false)
            rt.cancelled = rt.cancelled + 1
            return true
        }
        i = i + 1
    }
    return false
}

// ---- pollables ----------------------------------------------------------------

// Hand the runtime the thing that knows how to wait on handles. Until this is called a
// runtime has `no_poller()`, which is never consulted because a runtime with no watches
// never asks — so a timer-only program behaves exactly as it did before `Pollable` existed.
pub fn set_poller(mut rt: Runtime, read p: Poller) {
    rt.poller = p
}

// Watch `fd` for readability. When it becomes readable the task runs, exactly as a timer's
// does, and the watch stays registered — a server accepts more than one connection.
//
// **A watch is level-triggered and does NOT rearm itself out of existence**: it fires every
// time the loop finds the handle readable, which is the semantics `accept` and `recv` want
// (there is more to read, so there is more to do). A caller that wants one-shot calls
// `unwatch` from inside the task, which is safe for the same reason cancelling a timer from
// a callback is: the loop marks, it does not remove.
//
// `tok` groups it with timers under the same `CancelToken`, so `cancel_all` stops a
// connection's timers and its socket watch together — which is the whole reason
// cancellation is a group and not an id.
pub fn watch(mut rt: Runtime, fd: i64, read tok: CancelToken, read t: Task) -> i64 {
    let id: i64 = rt.next_id
    rt.next_id = rt.next_id + 1
    list.push(i64, rt.fds, fd)
    list.push(i64, rt.pids, id)
    list.push(bool, rt.palive, true)
    list.push(i64, rt.pgroups, tok.grp)
    list.push(Task, rt.ptasks, t)
    return id
}

// Stop watching. True if this call did it, false if it was already gone — the same
// idempotent report `cancel` makes, and for the same reason: a cleanup path that runs twice
// should not have to care.
pub fn unwatch(mut rt: Runtime, id: i64) -> bool {
    var i: usize = 0
    for i < list.len(i64, rt.pids) {
        if list.get(i64, rt.pids, i) == id {
            if list.get(bool, rt.palive, i) {
                list.set(bool, rt.palive, i, false)
                return true
            }
            return false
        }
        i = i + 1
    }
    return false
}

// How many watches are live.
pub fn watching(read rt: Runtime) -> usize {
    var n: usize = 0
    var i: usize = 0
    for i < list.len(bool, rt.palive) {
        if list.get(bool, rt.palive, i) { n = n + 1 }
        i = i + 1
    }
    return n
}

// How many watch callbacks have run — the pollable half of `fired`.
pub fn ready_count(read rt: Runtime) -> i64 { return rt.ready }

// How many timers are still live.
pub fn pending(read rt: Runtime) -> usize {
    var n: usize = 0
    var i: usize = 0
    for i < list.len(bool, rt.alive) {
        if list.get(bool, rt.alive, i) { n = n + 1 }
        i = i + 1
    }
    return n
}

// The runtime OWNS its clock (`take` at construction), so time is driven through the
// runtime and not through the caller's copy. That is not a wart, it is the consequence of
// the ownership being honest: a `Clock` handed to `make` is moved in, and a test that kept
// advancing its own copy would be advancing a clock nothing reads. The first draft of the
// suite did exactly that and every timer silently failed to fire.
pub fn advance(mut rt: Runtime, by: i64) -> bool {
    return time.advance(rt.clock, by)
}

// The runtime's current time.
pub fn now(mut rt: Runtime) -> i64 {
    return time.read_nanos(rt.clock)
}

pub fn fired(read rt: Runtime) -> i64 { return rt.fired }
pub fn cancelled(read rt: Runtime) -> i64 { return rt.cancelled }
// **Idle means nothing can happen next**, which is no longer the same as "no timers".
// A runtime with a watched socket and no timers is not finished — it is waiting for
// something only the poller can deliver. This is the inversion `poll_for`'s header note
// promised.
pub fn is_idle(read rt: Runtime) -> bool { return pending(rt) == 0 and watching(rt) == 0 }

// The earliest live deadline, or -1 when nothing is scheduled. What a caller would sleep
// until if it had something to sleep on — this module never sleeps itself.
pub fn next_deadline(read rt: Runtime) -> i64 {
    var best: i64 = 0 - 1
    var i: usize = 0
    for i < list.len(i64, rt.deadlines) {
        if list.get(bool, rt.alive, i) {
            let d: i64 = list.get(i64, rt.deadlines, i)
            if best < 0 or d < best { best = d }
        }
        i = i + 1
    }
    return best
}

// The index of the next timer to fire at `now`: earliest deadline, ties broken by
// REGISTRATION ORDER, which is the index itself. Returns -1 when nothing is due.
//
// A linear scan, deliberately. A binary heap is the textbook answer and it is the wrong
// one here: a heap does not preserve insertion order among equal keys without a tiebreak
// field, and the tiebreak is the property tests depend on. When a loop holds thousands of
// timers this becomes the thing to fix, and the fix is a heap keyed on `(deadline, id)` —
// recorded rather than pre-empted.
fn due_index(read rt: Runtime, now: i64) -> isize {
    var best: isize = 0 - 1
    var best_d: i64 = 0
    var i: usize = 0
    for i < list.len(i64, rt.deadlines) {
        if list.get(bool, rt.alive, i) {
            let d: i64 = list.get(i64, rt.deadlines, i)
            if d <= now {
                if best < 0 or d < best_d {
                    best = i as isize
                    best_d = d
                }
            }
        }
        i = i + 1
    }
    return best
}

// Fire every timer due at the current time. Returns how many fired.
//
// **Named `fire_due` rather than `poll`, and the reason is a hard constraint.** An
// `extern` declaration's name is a C SYMBOL, so it is globally reserved against any Jestyr
// function declared in exactly one module — and POSIX readiness polling is spelled
// `poll(2)`. With this function called `poll`, `jestyrc` refused any program importing both
// (*duplicate definition of `poll`*) and `jc` silently renamed the EXTERN instead, emitting
// an undefined reference. `close` is not affected, because `std/file` and `std/sysdir` both
// declare one and the canonicaliser has already renamed them.
//
// It is also the better name: this fires what is due and returns, where `poll_for` is the
// one that waits.
//
// A timer registered BY a callback during this pass is not fired by the same pass even if
// it is already due — the loop re-reads the clock once at entry and fires against that.
// Without that rule a `soon` that re-schedules itself would spin forever inside one pass,
// which is the classic starvation bug and is much easier to prevent than to debug.
pub fn fire_due(mut rt: Runtime) -> i64 {
    let now: i64 = time.read_nanos(rt.clock)
    let limit: usize = list.len(i64, rt.deadlines)
    var n: i64 = 0
    for true {
        let ix: isize = due_index(rt, now)
        if ix < 0 { break }
        let i: usize = ix as usize
        if i >= limit { break }
        list.set(bool, rt.alive, i, false)
        let t: Task = list.get(Task, rt.tasks, i)
        rt.fired = rt.fired + 1
        n = n + 1
        t.on_fire(t.ctx, list.get(i64, rt.ids, i), now)
    }
    return n
}

// Poll until nothing is due at the current time. Timers scheduled by callbacks ARE fired
// here, because each `fire_due` re-reads the clock — so this is the "settle" operation, and it
// still cannot spin on a self-rescheduling zero-delay task under a manual clock: that task
// is due again immediately, so `max_rounds` bounds it rather than pretending it cannot
// happen.
pub fn run_until_idle(mut rt: Runtime, max_rounds: usize) -> i64 {
    var total: i64 = 0
    var r: usize = 0
    for r < max_rounds {
        let n: i64 = fire_due(rt)
        if n == 0 { break }
        total = total + n
        r = r + 1
    }
    return total
}

// ---- the waiting poll --------------------------------------------------------
//
// What `fire_due` reports: a count, which cannot distinguish "nothing was due" from "there is
// nothing left to do". A loop needs that difference — the first means wait, the second
// means exit — so the waiting form answers with a kind.

pub const RT_FIRED: i32 = 0      // at least one timer ran
pub const RT_IDLE: i32 = 1       // nothing is scheduled at all; the loop may stop
pub const RT_TIMEOUT: i32 = 2    // work is still pending, but the budget ran out first
pub const RT_READY: i32 = 3      // at least one watched handle became readable

// `@copy`: three integers. `waited` is the time this call actually spent waiting, which is
// not the time it asked for — see `time.wait`.
@copy pub struct Event {
    pub kind: i32,
    pub fired: i64,
    pub waited: i64,
}

@no_alloc @no_os pub fn ev_name(kind: i32) -> str {
    if kind == RT_FIRED { return "fired" }
    if kind == RT_IDLE { return "idle" }
    if kind == RT_READY { return "ready" }
    return "timeout"
}

// Ask the poller which watched handles are readable, waiting up to `timeout_nanos`, and run
// the task of each one that is. Returns how many ran.
//
// The live watches are COMPACTED into a scratch array first, with their original indices
// alongside, because the poller takes a dense list and the registry is sparse (a cancelled
// watch keeps its slot, exactly as a cancelled timer does — the loop marks, it never
// removes, which is where use-after-free lives in every event loop that does).
//
// A callback may `watch` or `unwatch` while this is running. Both are safe: the snapshot's
// indices point at entries that already existed, a push only appends, and `unwatch` sets a
// flag the NEXT pass reads. The same rule timers live under.
//
// A poller that reports -1 (the platform refused) is treated as "nothing is ready". The
// alternative — surfacing it — would make every loop body handle an error it cannot act on,
// and a genuinely broken handle shows up as a failing read the moment its task runs.
fn fire_ready(mut rt: Runtime, timeout_nanos: i64) -> i64 {
    let n: usize = list.len(i64, rt.fds)
    if n == 0 { return 0 }
    var fdbuf: *mut i64 = alloc(i64, n)
    var idxbuf: *mut i64 = alloc(i64, n)
    var rdy: *mut u8 = alloc(u8, n)
    var m: usize = 0
    var i: usize = 0
    for i < n {
        if list.get(bool, rt.palive, i) {
            unsafe { (fdbuf + m).* = list.get(i64, rt.fds, i) }
            unsafe { (idxbuf + m).* = i as i64 }
            unsafe { (rdy + m).* = 0 as u8 }
            m = m + 1
        }
        i = i + 1
    }
    var count: i64 = 0
    if m > 0 {
        let pl: Poller = rt.poller
        let got: i64 = pl.wait_fn(pl.ctx, fdbuf, rdy, m, timeout_nanos)
        if got > 0 {
            let now: i64 = time.read_nanos(rt.clock)
            var k: usize = 0
            for k < m {
                var b: u8 = 0
                unsafe { b = (rdy + k).* }
                if (b as i32) != 0 {
                    var ix: i64 = 0
                    unsafe { ix = (idxbuf + k).* }
                    let w: usize = ix as usize
                    // Re-check liveness: an earlier callback in this same pass may have
                    // cancelled this watch, and running it anyway would be the bug the
                    // mark-do-not-remove rule exists to prevent.
                    if list.get(bool, rt.palive, w) {
                        let t: Task = list.get(Task, rt.ptasks, w)
                        rt.ready = rt.ready + 1
                        count = count + 1
                        t.on_fire(t.ctx, list.get(i64, rt.pids, w), now)
                    }
                }
                k = k + 1
            }
        }
    }
    free_ptr(rdy)
    free_ptr(idxbuf)
    free_ptr(fdbuf)
    return count
}

// Run what is due; if nothing is, WAIT for the earlier of `timeout_nanos` and the next
// deadline, then run what is due again.
//
// **This is the one function in the module that can block, and it blocks through the
// clock.** `time.wait` sleeps on a `host()` clock and ADVANCES a `manual()` one, so this
// same code idles in production and runs instantly in a test — and the test does not call
// `advance` itself, because waiting is advancing. That is what lets the suite assert a
// sequence of events over simulated seconds and still take none.
//
// The wait is clamped to the next deadline so a large timeout cannot overshoot a timer.
// A caller with nothing scheduled gets `RT_IDLE` immediately and never waits at all: there
// is nothing that could arrive to end the wait, so sleeping would be a hang with extra
// steps. **This is the note that said it would have to change the day IO existed, and it
// has:** `RT_IDLE` now means "no live timers AND no watched pollables", and a runtime with
// a watch and no timers waits on the `Poller` rather than reporting itself finished.
//
// The two waits are exclusive and the choice is not a preference. With pollables registered
// the wait goes through the poller, because that is the only wait a socket can END; with
// none it goes through the clock, because that is the only wait a timer can end. A runtime
// with both waits on the poller, bounded by the next deadline — the timer still fires on
// time, and a socket that becomes ready cuts the wait short.
pub fn poll_for(mut rt: Runtime, timeout_nanos: i64) -> Event {
    let n0: i64 = fire_due(rt)
    if n0 > 0 { return Event{ kind: RT_FIRED, fired: n0, waited: 0 } }
    if is_idle(rt) { return Event{ kind: RT_IDLE, fired: 0, waited: 0 } }

    // Something is pending and nothing was due, so every live deadline is in the future.
    let now: i64 = time.read_nanos(rt.clock)
    let d: i64 = next_deadline(rt)
    var want: i64 = timeout_nanos
    if d >= 0 {
        let until: i64 = d - now
        if until < want { want = until }
    }
    if want < 0 { want = 0 }

    // **With watches registered the wait belongs to the POLLER**, because a socket is the
    // only thing that can end it early — and the timeout is still clamped to the next
    // deadline, so a timer cannot be overshot by a quiet socket.
    //
    // The clock is only READ on this path, never waited on. Under `time.host()` that is
    // right: the poller did the real waiting and the wall clock moved on its own. Under
    // `time.manual()` it means **a test with watches drives time with `advance`**, the way
    // every other manual-clock caller does — the timer-only path below is the one where
    // waiting IS advancing.
    if watching(rt) > 0 {
        let r: i64 = fire_ready(rt, want)
        if r > 0 { return Event{ kind: RT_READY, fired: r, waited: 0 } }
        let n2: i64 = fire_due(rt)
        if n2 > 0 { return Event{ kind: RT_FIRED, fired: n2, waited: want } }
        return Event{ kind: RT_TIMEOUT, fired: 0, waited: want }
    }

    let waited: i64 = time.wait(rt.clock, want)

    let n1: i64 = fire_due(rt)
    if n1 > 0 { return Event{ kind: RT_FIRED, fired: n1, waited: waited } }
    return Event{ kind: RT_TIMEOUT, fired: 0, waited: waited }
}

// Drive the loop until it goes idle or `budget_nanos` of waiting is used up. Returns the
// last event, so a caller can tell which of the two happened.
//
// `rounds` bounds the loop for the same reason `run_until_idle`'s does: a zero-delay task
// that reschedules itself is due again immediately, and a bound is honest about that where
// pretending it cannot happen is not.
pub fn run_for(mut rt: Runtime, budget_nanos: i64, rounds: usize) -> Event {
    var left: i64 = budget_nanos
    var last: Event = Event{ kind: RT_IDLE, fired: 0, waited: 0 }
    var r: usize = 0
    for r < rounds {
        let e: Event = poll_for(rt, left)
        last = e
        if e.kind == RT_IDLE { return e }
        left = left - e.waited
        if left <= 0 { return e }
        r = r + 1
    }
    return last
}

// The counters as text, into a caller `Sink`. **Check `sink.overflowed`.**
@no_alloc @no_os pub fn render(mut s: Sink, mut buf: []u8, read rt: Runtime) -> usize {
    let before: usize = sink.written(s)
    sink.put_str(s, buf, "fired=")
    sink.put_i64(s, buf, rt.fired)
    sink.put_str(s, buf, " cancelled=")
    sink.put_i64(s, buf, rt.cancelled)
    sink.put_str(s, buf, " pending=")
    sink.put_usize(s, buf, pending(rt))
    return sink.written(s) - before
}
