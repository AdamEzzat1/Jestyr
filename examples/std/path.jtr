// std/path.jtr — lexical path manipulation.
//
// TIER: `core`-shaped. No heap, no OS, no syscalls. Every function here is
// `@no_alloc`, so "path handling never allocates" is a *proven* property, not a
// comment — the escape checker rejects this file if any of it ever reaches for
// the allocator. Nothing here touches the filesystem: `path.base("/nope")` is
// answerable without the file existing, which is exactly why the lexical layer
// is separate from `std/fs`.
//
// TWO SHAPES, matching the rest of std:
//   * queries return a `str` VIEW into the argument (`-> read str`) — zero copy,
//     and the view is only valid while the argument is;
//   * composition writes into a CALLER buffer and returns the byte count, the
//     same idiom as `core.format_u64` — so the allocation is the caller's,
//     visible at the call site, and this module keeps its `@no_alloc` proof.
//
// SEPARATORS: `/` and `\` are BOTH accepted when parsing, because Jestyr builds
// on Windows and POSIX and the compiler's own module loader already reads both.
// `/` is the only separator ever WRITTEN, so composed output is byte-identical
// across platforms — the determinism rule applied to paths.
//
// The self-hosted compiler hand-rolls this logic today (`path_dir_len` and the
// stem/join code in `examples/std/cgen.jtr`); it is the intended first consumer
// once this module has settled.
//
// Run the tests:  jestyrc test examples/std/path.jtr

const SLASH: i32 = 47      // '/'
const BACKSLASH: i32 = 92  // '\'
const DOT: i32 = 46        // '.'
const COLON: i32 = 58      // ':'

// ---------------------------------------------------------------- predicates

// Is `ch` a path separator? Both spellings count.
@no_alloc @no_os pub fn is_sep(ch: i32) -> bool {
    return ch == SLASH or ch == BACKSLASH
}

// Is the byte at `i` a separator? (Bounds are the caller's; `i < p.len`.)
@no_alloc @no_os fn sep_at(read p: str, i: usize) -> bool {
    return is_sep(p[i] as i32)
}

// Does `p` name a location from a root rather than from the current directory?
// True for a leading separator, and for a Windows drive prefix (`C:`).
@no_alloc @no_os pub fn is_abs(read p: str) -> bool {
    if p.len == 0 { return false }
    if sep_at(p, 0) { return true }
    if p.len >= 2 {
        if (p[1] as i32) == COLON { return true }
    }
    return false
}

// ------------------------------------------------------------------- queries

// The length of the directory prefix INCLUDING its trailing separator, so that
// `p[0 .. dir_len(p)]` is a prefix you can concatenate onto directly. 0 when `p`
// has no separator. (This is the exact shape `cgen.jtr`'s loader needs.)
@no_alloc @no_os pub fn dir_len(read p: str) -> usize {
    var i: usize = p.len
    for i > 0 {
        if sep_at(p, i - 1) { return i }
        i = i - 1
    }
    return 0
}

// The last segment: everything after the final separator.
//   base("a/b/c.jtr") == "c.jtr"      base("bare") == "bare"
//   base("a/b/")      == ""           (a trailing separator means "no segment")
@no_alloc @no_os pub fn base(read p: str) -> read str {
    return p[dir_len(p) .. p.len]
}

// Everything before the final separator, WITHOUT the trailing separator.
//   dir("a/b/c") == "a/b"     dir("c") == ""      dir("/a") == "/"
// Note "" (not POSIX's ".") for a bare name: an empty prefix is what `join`
// wants, and it keeps this function a pure view with no invented storage.
@no_alloc @no_os pub fn dir(read p: str) -> read str {
    let d: usize = dir_len(p)
    if d == 0 { return p[0 .. 0] }
    if d == 1 { return p[0 .. 1] }   // the root itself: "/"
    return p[0 .. d - 1]
}

// The byte offset of the extension's dot within `base(p)`, or `base.len` when
// there is none. A dot at offset 0 is a dotfile (".bashrc"), not an extension.
@no_alloc @no_os fn ext_dot(read b: str) -> usize {
    var i: usize = b.len
    for i > 1 {
        if (b[i - 1] as i32) == DOT { return i - 1 }
        i = i - 1
    }
    return b.len
}

// The extension WITHOUT its dot; "" when there is none.
//   ext("a/b.tar.gz") == "gz"   ext("README") == ""   ext(".bashrc") == ""
@no_alloc @no_os pub fn ext(read p: str) -> read str {
    let b: str = base(p)
    let d: usize = ext_dot(b)
    if d == b.len { return b[0 .. 0] }
    return b[d + 1 .. b.len]
}

// The last segment with its extension removed.
//   stem("a/b.tar.gz") == "b.tar"   stem("README") == "README"
//   stem(".bashrc")    == ".bashrc"
@no_alloc @no_os pub fn stem(read p: str) -> read str {
    let b: str = base(p)
    return b[0 .. ext_dot(b)]
}

// --------------------------------------------------------------- composition

// Join `a` and `b` into `buf`, returning the byte count written.
//
// Rules (Rust's `Path::join` semantics): an absolute `b` replaces `a` entirely;
// an empty side contributes nothing; exactly one `/` lands between them.
// REQUIRES `buf.len >= a.len + b.len + 1` — a short buffer trips the slice
// bounds check, which is a deterministic fault rather than a silent truncation.
@no_alloc @no_os pub fn join(read a: str, read b: str, mut buf: []u8) -> usize {
    var n: usize = 0
    if is_abs(b) or a.len == 0 {
        for i in 0..b.len {
            buf[n] = b[i] as u8
            n = n + 1
        }
        return n
    }
    for i in 0..a.len {
        buf[n] = a[i] as u8
        n = n + 1
    }
    if b.len == 0 { return n }
    if sep_at(a, a.len - 1) == false {
        buf[n] = SLASH as u8
        n = n + 1
    }
    for j in 0..b.len {
        buf[n] = b[j] as u8
        n = n + 1
    }
    return n
}

// Scan back from `n` for the start of the last segment in `buf`, not below
// `root`. Used to pop a segment when `..` is resolved.
@no_alloc @no_os fn pop_seg(read buf: []u8, n: usize, root: usize) -> usize {
    var k: usize = n
    for k > root {
        if (buf[k - 1] as i32) == SLASH { return k - 1 }
        k = k - 1
    }
    return root
}

// Normalize `p` into `buf`, returning the byte count written.
//
// Separators become `/`; runs of separators collapse; `.` segments drop; `..`
// segments cancel the preceding one when there is one to cancel. A relative
// path keeps leading `..` (there is nothing above it to cancel); an absolute
// path never rises above its root. An empty result is written as ".", so the
// output is always a usable path — which also makes normalize IDEMPOTENT:
// `normalize(normalize(p)) == normalize(p)` for every input.
//
// REQUIRES `buf.len >= p.len` when `p` is non-empty, and `buf.len >= 1`
// otherwise: normalization only ever shrinks, except "" which becomes ".".
@no_alloc @no_os pub fn normalize(read p: str, mut buf: []u8) -> usize {
    let abs: bool = p.len > 0 and sep_at(p, 0)
    var n: usize = 0
    if abs {
        buf[0] = SLASH as u8
        n = 1
    }
    let root: usize = n
    var i: usize = 0
    for i < p.len {
        if sep_at(p, i) {
            i = i + 1
            continue
        }
        // The segment is [s, i) once this inner scan stops.
        let s: usize = i
        for i < p.len {
            if sep_at(p, i) { break }
            i = i + 1
        }
        let seg: str = p[s .. i]
        if seg.len == 1 {
            if (seg[0] as i32) == DOT { continue }
        }
        if seg.len == 2 {
            if (seg[0] as i32) == DOT and (seg[1] as i32) == DOT {
                // Pop, unless there is nothing poppable: an absolute path is
                // already at its root, and a relative one must keep the `..`.
                if n > root {
                    let back: usize = pop_seg(buf, n, root)
                    // Where the previous segment actually starts: past the
                    // separator `pop_seg` landed on, or at the root when it
                    // found none.
                    var seg_start: usize = root
                    if back > root { seg_start = back + 1 }
                    // A leading `..` chain is not poppable — it is not a segment
                    // we put there, so keep appending instead. Compare the whole
                    // SEGMENT, not its last two bytes: a directory legitimately
                    // named `a..` ends in two dots and must still be popped.
                    let plen: usize = n - seg_start
                    var prev_is_dotdot: bool = false
                    if plen == 2 {
                        prev_is_dotdot = (buf[seg_start] as i32) == DOT and (buf[seg_start + 1] as i32) == DOT
                    }
                    if prev_is_dotdot == false {
                        n = back
                        continue
                    }
                } else {
                    if abs { continue }
                }
            }
        }
        if n > root {
            buf[n] = SLASH as u8
            n = n + 1
        }
        for k in s..i {
            buf[n] = p[k] as u8
            n = n + 1
        }
    }
    if n == 0 {
        buf[0] = DOT as u8
        return 1
    }
    return n
}
