// std/str_demo.jtr — worked examples for `std/str`, and the oracle the Rust property
// tests drive.
//
// TWO MODES, the shape `path_demo.jtr` established:
//   * no arguments — print the worked demo below. The c-oracle test asserts it, so the
//     documented output is verified rather than claimed.
//   * `str_demo <op> <a> [b]` — apply one operation, print one line, nothing else.
//     `src/proptests.rs` builds this once and drives it per generated case, so the
//     properties are statements about the REAL Jestyr module rather than about a Rust
//     re-description of it.
//
// Ops: before after beforelast afterlast stripp strips trimstart trimend stripcr
//      lastindex count blank
//
// In an argument, `_` stands for a space, `;` a newline, `~` a carriage return and `@`
// a tab — a command line cannot carry those literally, and whitespace is exactly where
// trimming bugs live, so the substitution buys real coverage. The Rust oracle applies
// the same mapping and nothing else.
//
// Run:  cargo run --release -- run examples/std/str_demo.jtr
//   →   -- parsing a config line --
//       timeout
//       30
//       1
//       -- paths, lexically --
//       archive.tar
//       gz
//       -- flags --
//       verbose
//       1
//       -- counting --
//       3
//       2

import "str"
import "env"

const CAP: usize = 512

// `_` -> space, `;` -> newline, `~` -> CR, `@` -> tab.
fn unescape_arg(read s: str, mut dst: []u8) -> usize {
    var n: usize = 0
    for i in 0..s.len {
        let ch: i32 = s[i] as i32
        var out_byte: i32 = ch
        if ch == 95 { out_byte = 32 }        // '_' -> space
        if ch == 59 { out_byte = 10 }        // ';' -> LF
        if ch == 126 { out_byte = 13 }       // '~' -> CR
        if ch == 64 { out_byte = 9 }         // '@' -> tab
        dst[n] = out_byte as u8
        n = n + 1
    }
    return n
}

// A tiny unsigned decimal, local so this demo stays a leaf — the same choice (and
// reason) as `path_demo.jtr`'s.
fn emit_num(v: i64, mut dst: []u8, raw: *mut u8) {
    if v < 0 {
        print_str("-1")
        return
    }
    if v == 0 {
        print_str("0")
        return
    }
    var n: usize = 0
    var x: i64 = v
    for x > 0 {
        dst[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    var j: usize = n - 1
    for i < j {
        let t: u8 = dst[i]
        dst[i] = dst[j]
        dst[j] = t
        i = i + 1
        j = j - 1
    }
    print_str(from_utf8(slice(u8, raw, n)))
}

// `op a b` -> one line on stdout. An unknown op prints nothing and exits 2, so a typo
// in the harness fails loudly instead of silently passing.
fn run_op(read op: str, read a: str, read b: str) -> i32 {
    var araw: *mut u8 = alloc(u8, CAP)
    var braw: *mut u8 = alloc(u8, CAP)
    var nraw: *mut u8 = alloc(u8, CAP)
    var abuf: []u8 = slice(u8, araw, CAP)
    var bbuf: []u8 = slice(u8, braw, CAP)
    var nbuf: []u8 = slice(u8, nraw, CAP)

    let x: str = from_utf8(slice(u8, araw, unescape_arg(a, abuf)))
    let y: str = from_utf8(slice(u8, braw, unescape_arg(b, bbuf)))
    var code: i32 = 0

    if str.eq(op, "before") {
        print_str(str.before(x, y))
    } else if str.eq(op, "after") {
        print_str(str.after(x, y))
    } else if str.eq(op, "beforelast") {
        print_str(str.before_last(x, y))
    } else if str.eq(op, "afterlast") {
        print_str(str.after_last(x, y))
    } else if str.eq(op, "stripp") {
        print_str(str.strip_prefix(x, y))
    } else if str.eq(op, "strips") {
        print_str(str.strip_suffix(x, y))
    } else if str.eq(op, "trimstart") {
        print_str(str.trim_start(x))
    } else if str.eq(op, "trimend") {
        print_str(str.trim_end(x))
    } else if str.eq(op, "stripcr") {
        print_str(str.strip_cr(x))
    } else if str.eq(op, "lastindex") {
        emit_num(str.last_index_of(x, y) as i64, nbuf, nraw)
    } else if str.eq(op, "count") {
        emit_num(str.count_of(x, y) as i64, nbuf, nraw)
    } else if str.eq(op, "blank") {
        if str.is_blank(x) { print_str("1") } else { print_str("0") }
    } else {
        code = 2
    }

    free_ptr(nraw)
    free_ptr(braw)
    free_ptr(araw)
    return code
}

fn b2i(read b: bool) -> i32 {
    if b { return 1 }
    return 0
}

fn demo() {
    var raw: *mut u8 = alloc(u8, CAP)
    var buf: []u8 = slice(u8, raw, CAP)

    // The job `examples/str_ops.jtr` says you must do by hand with `find` + `substr`.
    print_str("-- parsing a config line --")
    let line: str = "  timeout = 30  \r"
    let clean: str = str.trimmed(str.strip_cr(line))
    print_str(str.trimmed(str.before(clean, "=")))    // timeout
    print_str(str.trimmed(str.after(clean, "=")))     // 30
    print_int(b2i(str.is_blank("   \t")))             // 1

    // Lexical suffix handling, without touching `std/path`.
    print_str("-- paths, lexically --")
    let file: str = "archive.tar.gz"
    print_str(str.before_last(file, "."))             // archive.tar
    print_str(str.after_last(file, "."))              // gz

    // A flag, stripped of its leading dashes.
    print_str("-- flags --")
    print_str(str.strip_prefix("--verbose", "--"))    // verbose
    print_int(b2i(str.has_prefix("--verbose", "--"))) // 1

    print_str("-- counting --")
    emit_num(str.count_of("a,b,c,d", ",") as i64, buf, raw)   // 3
    emit_num(str.count_of("aaaa", "aa") as i64, buf, raw)     // 2 (non-overlapping)

    free_ptr(raw)
}

fn main() -> i32 {
    if env.argc() < 2 {
        demo()
        return 0
    }
    let op: str = env.argv(1)
    var a: str = ""
    var b: str = ""
    if env.argc() > 2 { a = env.argv(2) }
    if env.argc() > 3 { b = env.argv(3) }
    return run_op(op, a, b)
}
