// examples/std/lexer.jtr — the self-hosting front-end driver. It composes the
// self-hosting unblockers — read source with `fs`, take a path from `env` (argv),
// classify identifiers with the `intern`er — and the shared `tokens` module to turn
// source text into a token stream and dump it. Proof that Jestyr can implement its
// own front end.
//
// **The tokenizer now lives in `tokens.jtr`** (extracted so the parser can import it
// in-process, handoff §3.3a). This driver `import`s it, calls `tokens.tokenize` to get
// a `List(tokens.Token)`, and walks that vector to print the token stream in one of
// three modes:
//   • lexemes — each token's raw source slice `[start..end]`  (the P1 golden)
//   • kinds   — each token's `TokenKind::describe()` label     (the P2a label golden)
//   • nums    — each token's integer `TokenKind` discriminant  (the P2a tag golden —
//               the actual integers the parser switches on)
// followed by a 6-number summary. The observable output is byte-identical to the
// pre-extraction lexer, so the `..._match_reference_on_corpus` goldens remain the
// acceptance test — and building this driver now exercises cross-module generic
// monomorphization (`list.get(tokens.Token, …)` resolving to the producer's instance).
//
// Run with a path to lex a real file (`lexer.exe foo.jtr`); a second arg switches to
// kind-label output (`lexer.exe foo.jtr kinds`) or integer kind tags
// (`lexer.exe foo.jtr nums`). With no args it lexes a built-in sample (what the test pins).
import "mem"
import "intern"
import "fs"
import "env"
import "list"
import "tokens"

// Byte-wise equality of two string views — enough to pick the output mode from argv.
fn str_eq(read a: str, read b: str) -> bool {
    if a.len != b.len { return false }
    var i: usize = 0
    for i < a.len {
        if (a[i] as i32) != (b[i] as i32) { return false }
        i = i + 1
    }
    return true
}

// Print the reference `TokenKind::describe()` label for a token's kind — what the kinds
// dump emits. For keywords and operators the label *is* the source slice, so only the
// literal/identifier kinds and the `<unknown>` sentinel need naming here. The label is
// *printed* (a slice passed further down to `print_str`), never returned: a `read` borrow
// of `src` is second-class and may not escape the call.
fn print_kind(read src: str, t: tokens.Token) {
    let k: i32 = t.kind
    if k == 0 { print_str("ident") return }
    if k == 1 { print_str("int") return }
    if k == 2 { print_str("float") return }
    if k == 3 { print_str("string") return }
    if k == 4 { print_str("f-string") return }
    if k == 5 { print_str("char") return }
    if k == 6 { print_str("_") return }
    if k == 112 { print_str("<unknown>") return }
    print_str(src[t.start..t.end])   // keyword or operator: label == source symbol
                                     // (incl. `with`, kind 111 — its label is its spelling)
}

// Tokenize `src` (via the shared `tokens` module), then walk the token vector printing
// each token — followed by a 6-number summary. The `mode` selects what each token
// prints: 0 = its raw source lexeme (P1 golden), 1 = its kind *label* (P2a label
// golden), 2 = its integer kind *tag* (the discriminant the parser switches on).
// Every output is derived purely from the `List(Token)`, so modes 0/1 stay
// byte-identical to the pre-extraction lexer. Summary: total, #keywords, #identifiers,
// #number literals, #punctuation, #distinct user ids.
fn lex(read src: str, mut it: Interner, kwcount: i64, read a: Allocator, mode: i32) {
    var toks: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let m: usize = list.len(tokens.Token, toks)
    var total: i32 = 0
    var nkw: i32 = 0
    var nid: i32 = 0
    var nnum: i32 = 0
    var npunct: i32 = 0
    var j: usize = 0
    for j < m {
        let t: tokens.Token = list.get(tokens.Token, toks, j)
        let k: i32 = t.kind
        if mode == 2 { print_int(k) } else if mode == 1 { print_kind(src, t) } else { print_str(src[t.start..t.end]) }
        // Tally by kind, matching the original per-branch counters: keywords are
        // 7..=62 plus `with` (111 — appended after Eof in the pinned numbering), idents
        // are Ident(0) and the lone `_`(6), numbers are Int(1)/Float(2), and punctuation
        // is every operator/Unknown (>= 63, excluding 111). Strings, chars, and
        // f-strings count only toward the total.
        if k >= 7 { if k <= 62 { nkw = nkw + 1 } }
        if k == 111 { nkw = nkw + 1 }
        if k == 0 { nid = nid + 1 }
        if k == 6 { nid = nid + 1 }
        if k == 1 { nnum = nnum + 1 }
        if k == 2 { nnum = nnum + 1 }
        if k >= 63 { if k != 111 { npunct = npunct + 1 } }
        total = total + 1
        j = j + 1
    }
    let distinct_users: i32 = (intern.count(it) as i64 - kwcount) as i32
    print_int(total)
    print_int(nkw)
    print_int(nid)
    print_int(nnum)
    print_int(npunct)
    print_int(distinct_users)
}

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(it)

    if env.argc() > 1 {
        // Real use: lex the file named on the command line (the self-hosting loop).
        // A second argument selects the dump: `nums` prints integer kind tags, any other
        // value (e.g. `kinds`) prints kind labels; with just the path it prints lexemes.
        var mode: i32 = 0
        if env.argc() > 2 {
            if str_eq(env.argv(2), "nums") { mode = 2 } else { mode = 1 }
        }
        var src: String = fs.read_text(env.argv(1))
        lex(string_view(src), it, kwcount, a, mode)
        string_free(src)
    } else {
        // Deterministic built-in sample (what the test pins).
        let sample: str = "// add two ints\nfn add(x: i32, y: i32) -> i32 {\n    return x + y\n}\n"
        lex(sample, it, kwcount, a, 0)
    }
    return 0   // `it`/`toks` drop here (RAII): interner table + token buffer freed
}
