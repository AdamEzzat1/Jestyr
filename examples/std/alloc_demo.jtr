// examples/std/alloc_demo.jtr — the explicit allocator interface, end to end.
//
// The *same* code path (`fill_and_sum`) works against two different allocator
// strategies, chosen by the value passed in. This is the whole point of an
// explicit allocator value: the strategy travels with the value (now a real
// fn-pointer vtable), nothing is hidden.
//
// Note: functions/consts are import-gated (qualified `mem.allocate`), but *types*
// resolve by bare name in the v1 flat namespace — so the `Allocator` type is
// written bare even though it is defined in `mem`.
//
//   jestyrc run examples/std/alloc_demo.jtr   →   60, 60

import "mem"

// Allocate 3 ints from `a`, fill them, sum them, then release. Allocator-agnostic.
fn fill_and_sum(a: Allocator) -> i32 {
    var p: *mut i32 = mem.allocate(i32, a, 3)
    unsafe { (p + 0).* = 10; (p + 1).* = 20; (p + 2).* = 30 }
    var total: i32 = 0
    unsafe { total = (p + 0).* + (p + 1).* + (p + 2).* }
    mem.release(i32, a, p)
    return total
}

fn main() -> i32 {
    // 1) general-purpose (malloc) allocator
    var gpa: Allocator = mem.system_allocator()
    print_int(fill_and_sum(gpa))   // 60

    // 2) bump-arena allocator — same fill_and_sum, different strategy. (With the
    // vtable allocator there is no enum variant to shadow, so the local may even be
    // named `arena`; `bump` is kept for continuity.)
    var bump: Allocator = mem.arena_allocator(1024)
    print_int(fill_and_sum(bump))  // 60
    mem.destroy(bump)

    return 0
}
