// examples/std/parse_float.jtr — correctly-rounded decimal → f64 (Eisel–Lemire).
//
// `core.parse_float` reads a locale-free decimal string into the *nearest* double,
// bit-for-bit identical on every platform — the float side of the numerics
// determinism contract. Each check compares the parsed bits to the bits of the
// equivalent Jestyr float literal (which the C backend rounds the same way).
//
//   jestyrc run examples/std/parse_float.jtr   →   thirteen 1s
import "core"
import "io"

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }

// 1 iff `s` parses and its bits equal `expected`'s bits.
fn eqf(s: str, expected: f64) -> i32 {
    match core.parse_float(s) {
        ok(v) => b2i(core.f64_bits(v) == core.f64_bits(expected)),
        err(e) => 0,
    }
}

// 1 iff `s` is rejected (an error, not a value).
fn rej(s: str) -> i32 {
    match core.parse_float(s) {
        ok(v) => 0,
        err(e) => 1,
    }
}

fn main() -> i32 {
    io.print_i32(eqf("0", 0.0))                                // 1
    io.print_i32(eqf("1.5", 1.5))                              // 1
    io.print_i32(eqf("0.1", 0.1))                              // 1
    io.print_i32(eqf("0.30000000000000004", 0.30000000000000004))  // 1
    io.print_i32(eqf("1234567890123456", 1234567890123456.0)) // 1
    io.print_i32(eqf("100", 100.0))                           // 1
    io.print_i32(eqf("-2.5", 0.0 - 2.5))                      // 1
    io.print_i32(eqf("1e10", 1.0e10))                         // 1
    io.print_i32(eqf("3.14159265358979", 3.14159265358979))  // 1

    // round-to-even tie: 2^53 + 1 is not representable; ties to the even neighbour,
    // which is 2^53 itself (mantissa even).
    io.print_i32(eqf("9007199254740993", 9007199254740992.0))   // 1

    // smallest subnormal, via the subnormal path
    io.print_i32(eqf("5e-324", 5.0e-324))                     // 1

    // rejections: malformed, and > 19 significant digits (fast path → err)
    io.print_i32(rej("12x"))                                  // 1
    io.print_i32(rej("12345678901234567890"))                // 1
    return 0
}
