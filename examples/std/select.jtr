// examples/std/select.jtr — `select` over move-only channels (concurrency,
// workstream N): wait on several channels, take from whichever is ready.
//
// Two tasks fill two channels; the main thread then drains all four values with a
// `select` loop — each `select` runs the arm of whichever channel currently has a
// value (Crystal/Go CSP ergonomics, here over Jestyr's move-only `Channel(i64)`).
// The total is an order-independent sum, so the result is deterministic.
//
//   jestyrc run examples/std/select.jtr   →   66  146 4  146 4
import "sync"

// One producer: send two values into its channel (by move).
fn fill(read ch: sync.Channel(i64), base: i64) {
    sync.channel_send(i64, ch, base + 1)
    sync.channel_send(i64, ch, base + 2)
}

// The same, but saying so when it is finished — which is what lets Part 2's consumer
// stop without being told a count.
fn fill_close(read ch: sync.Channel(i64), base: i64) {
    sync.channel_send(i64, ch, base + 1)
    sync.channel_send(i64, ch, base + 2)
    sync.channel_close(i64, ch)
}

fn main() -> i32 {
    var a = sync.channel_make(i64, 8)
    var b = sync.channel_make(i64, 8)
    concurrent {
        spawn fill(a, 10)        // 11, 12
        spawn fill(b, 20)        // 21, 22
    }

    // Drain all four values, taking from whichever channel is ready each time.
    var total: i64 = 0
    var n: i64 = 0
    for n < 4 {
        select {
            recv(a) => x { total = total + x }
            recv(b) => y { total = total + y }
        }
        n = n + 1
    }
    print_int(total as i32)      // 11 + 12 + 21 + 22 = 66

    sync.channel_free(i64, a)
    sync.channel_free(i64, b)

    // --- Part 2: the same drain, with NO COUNT ------------------------------------
    //
    // The loop above is told 4. It had to be: readiness is `len > 0`, so once both
    // channels ran dry the `select` had nothing to wait for and nothing to end it —
    // entering it a fifth time would have spun forever. A count agreed in advance was
    // the only thing the language allowed, and the header above presented that as
    // determinism rather than as the constraint it was.
    //
    // Now a `select` whose channels are ALL closed and drained completes instead of
    // spinning, so the consumer can find out for itself. `seen` is the anti-vacuity
    // half: it is a number this loop was never given and could only learn by draining
    // to the end of both producers.
    // Filled on this thread and closed before the drain begins — no `concurrent`, so the
    // scheduler cannot decide the answer. Part 1 is the concurrent case; what is under
    // test here is termination, and a producer racing the consumer would let the loop end
    // early for the wrong reason and still print a plausible number.
    var c = sync.channel_make(i64, 8)
    var d = sync.channel_make(i64, 8)
    fill_close(c, 30)            // 31, 32, then close
    fill_close(d, 40)            // 41, 42, then close

    var sum2: i64 = 0
    var seen: i64 = 0
    var going: bool = true
    for going {
        let before: i64 = seen
        select {
            recv(c) => p { sum2 = sum2 + p  seen = seen + 1 }
            recv(d) => q { sum2 = sum2 + q  seen = seen + 1 }
        }
        // A select that took nothing is a select that found everything closed.
        if seen == before { going = false }
    }
    print_int(sum2 as i32)       // 31 + 32 + 41 + 42 = 146
    print_int(seen as i32)       // 4 — never told, only discovered

    sync.channel_free(i64, c)
    sync.channel_free(i64, d)

    // --- Part 3: the same drain again, with the `closed` ARM ----------------------
    //
    // Part 2 has to say the quiet part out loud: read `seen` before the `select`, read
    // it after, and infer from "it did not move" that everything was closed. That is a
    // sentinel — three lines of bookkeeping around the one line that matters, and it is
    // only correct because every arm happens to increment the same counter.
    //
    // `closed { … }` is that inference, named. The exit condition was already computed
    // (all channels closed AND drained) and was already where the loop ended; the arm is
    // somewhere to put a statement, not a new capability. Nothing here can do what
    // Part 2 could not — the point is that it says so directly.
    //
    // The totals must match Part 2 exactly, which is what makes this a check rather than
    // a demo: 146 and 4, reached without a sentinel. And because closing is tested only
    // AFTER every readiness arm, the values buffered before the close still arrive — if
    // the arm ran early, both numbers would drop.
    var e = sync.channel_make(i64, 8)
    var f = sync.channel_make(i64, 8)
    fill_close(e, 30)            // 31, 32, then close
    fill_close(f, 40)            // 41, 42, then close

    var sum3: i64 = 0
    var seen3: i64 = 0
    var live: bool = true
    for live {
        select {
            recv(e) => p { sum3 = sum3 + p  seen3 = seen3 + 1 }
            recv(f) => q { sum3 = sum3 + q  seen3 = seen3 + 1 }
            closed { live = false }
        }
    }
    print_int(sum3 as i32)       // 146 — identical to Part 2
    print_int(seen3 as i32)      // 4

    sync.channel_free(i64, e)
    sync.channel_free(i64, f)
    return 0
}
