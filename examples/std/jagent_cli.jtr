// examples/std/jagent_cli.jtr — `jagent`, the command.
//
//   jagent [-c <config>] serve
//   jagent [-c <config>] run <job>
//   jagent [-c <config>] run group <group>
//   jagent [-c <config>] groups
//   jagent [-c <config>] compact
//   jagent [-c <config>] schedule <job>
//   jagent [-c <config>] status
//   jagent [-c <config>] logs [<job>]
//   jagent [-c <config>] jobs
//   jagent [-c <config>] check              (also: config validate)
//   jagent [-c <config>] config show
//   jagent [-c <config>] doctor [--no-probes]
//   jagent [-c <config>] ask <question...>
//   jagent [-c <config>] init [--force]
//
// The runner is `std/jagent` and the operator's layer is `std/jagent_ops`; this file is
// the argv, the real clocks, the signal handling and the exit codes around them —
// `jcadd_demo`'s shape, so every interesting claim lives in a module a test can drive.
// Build it once and run the binary with arguments (`jestyrc run` forwards none):
//
//   jestyrc build examples/std/jagent_cli.jtr            # <temp>/jestyr_jagent_cli.exe
//   jestyrc plan tools/jagent/build.jestyr --build        # ./jagent.exe, from the repo root
//
// **Where the configuration comes from**, in order: `-c <path>`; the `JAGENT_CONFIG`
// environment variable; `jagent.ini` in the working directory. The environment is read
// once, here, and handed to `jagent_ops.discover` as a value.
//
// Results go to stdout; log records go to stderr (logfmt), so a script that reads the
// output of `jagent status` is not reading the agent's diary.
//
// Exit codes: 0 the command succeeded (and, for `run`, the job did; for `doctor`, no check
// failed; for `ask`, the question was one it answers); 1 the job failed or does not exist,
// the configuration could not be loaded, a check failed, `init` found a file it would not
// replace, or the question was not one this layer knows; 2 usage, or a configuration this
// build cannot serve (`agent.tls = true`).
//
// `serve` binds `agent.host:agent.port` (0 asks the platform; the port is printed), answers
// the API, re-reads the configuration when its directory changes, runs any job whose
// `interval_ms` has come due, and stops on SIGINT or SIGTERM — draining first, then halting
// with the reason `std/service` computed. A run requested over the API is executed on the
// server's thread, so the API is quiet for that job's duration, bounded by its timeout.

import "env"
import "fs"
import "httpd"
import "httpds"
import "jagent"
import "jagent_ops"
import "log"
import "mem"
import "service"
import "str"
import "sysignal"
import "sysnet"
import "sysproc"
import "time"
import "tls"
import "writer"

fn nothing() { }

fn usage() -> i32 {
    eprint_str("usage: jagent [-c <config>] <command>")
    eprint_str("  serve | run <job> | run group <group> | schedule <job> | status | logs [<job>]")
    eprint_str("  jobs | groups | compact | check | config show | config validate")
    eprint_str("  doctor [--no-probes] | ask <question...> | init [--force]")
    eprint_str("the configuration: -c, else $JAGENT_CONFIG, else ./jagent.ini")
    return 2
}

// A logger to stderr, so stdout carries only the command's answer.
fn stderr_logger() -> log.Logger {
    return log.make(time.host(), writer.to_stderr(), log.LOG_INFO, log.LOG_LOGFMT)
}

fn show(read text: str) {
    let t: str = str.trim_end(text)
    if t.len > 0 { print_str(t) }
}

// Load the configuration or say why not. False means "exit 1".
fn load_or_complain(mut ag: jagent.Agent, mut h: fs.Fs, read cfg: str) -> bool {
    let r: i32 = jagent.load_file(ag, h, cfg)
    if r == jagent.JA_LOADED { return true }
    eprint_str("jagent: the configuration could not be loaded")
    let f: str = jagent.faults(ag)
    if f.len > 0 { eprint_str(str.trim_end(f)) }
    return false
}

fn cmd_status(mut ag: jagent.Agent, mut h: fs.Fs) -> i32 {
    jagent.open_store(ag, h)
    var s: String = string_new()
    jagent.render_status(ag, s)
    show(string_view(s))
    string_free(s)
    return 0
}

fn cmd_jobs(mut ag: jagent.Agent) -> i32 {
    var s: String = string_new()
    jagent.render_jobs(ag, s)
    let v: str = string_view(s)
    if v.len == 0 {
        print_str("(no jobs configured)")
    } else {
        show(v)
    }
    string_free(s)
    return 0
}

// The last 20 runs of one job, or of every job when no name is given.
fn cmd_logs(mut ag: jagent.Agent, mut h: fs.Fs, read job: str) -> i32 {
    if job.len > 0 {
        if jagent.find_job(ag, job) < 0 {
            eprint_str("jagent: no such job")
            return 1
        }
    }
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: the history store could not be opened")
        return 1
    }
    var s: String = string_new()
    let n: usize = jagent.render_logs(ag, job, 20, s)
    if n == 0 {
        print_str("(no runs recorded)")
    } else {
        show(string_view(s))
    }
    string_free(s)
    return 0
}

// The retention policy, after a run: prune past the bound, compact past the threshold.
// Says so on stderr when it did something, so the operator's diary has it.
fn upkeep(mut ag: jagent.Agent, mut h: fs.Fs) {
    let m: jagent.Maint = jagent.maintain(ag, h)
    if m.pruned > 0 or m.compacted {
        var s: String = string_new()
        string_push(s, "jagent: history pruned=")
        push_num(s, m.pruned)
        string_push(s, " compacted=")
        if m.compacted { string_push(s, "true reclaimed=") } else { string_push(s, "false reclaimed=") }
        push_num(s, m.reclaimed)
        eprint_str(string_view(s))
        string_free(s)
    }
}

fn cmd_run(mut ag: jagent.Agent, mut h: fs.Fs, mut sp: sysproc.Spawner, read job: str) -> i32 {
    if jagent.find_job(ag, job) < 0 {
        eprint_str("jagent: no such job")
        return 1
    }
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: warning: the history store could not be opened; this run will not be recorded")
    }
    var blk: time.Clock = time.host()
    let r: jagent.Run = jagent.run_job(ag, sp, blk, job)
    var s: String = string_new()
    jagent.render_run(ag, job, r, s)
    show(string_view(s))
    string_free(s)
    upkeep(ag, h)
    if r.status == jagent.RUN_SUCCESS { return 0 }
    return 1
}

// `run group <name>`: every member in order, the summary, exit 1 when any failed.
fn cmd_run_group(mut ag: jagent.Agent, mut h: fs.Fs, mut sp: sysproc.Spawner, read group: str) -> i32 {
    if jagent.find_group(ag, group) < 0 {
        eprint_str("jagent: no such group")
        return 1
    }
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: warning: the history store could not be opened; these runs will not be recorded")
    }
    var blk: time.Clock = time.host()
    var s: String = string_new()
    let bad: i64 = jagent.run_group(ag, sp, blk, group, s)
    show(string_view(s))
    string_free(s)
    upkeep(ag, h)
    if bad == 0 { return 0 }
    return 1
}

fn cmd_groups(mut ag: jagent.Agent) -> i32 {
    var s: String = string_new()
    jagent.render_groups(ag, s)
    let v: str = string_view(s)
    if v.len == 0 {
        print_str("(no groups configured)")
    } else {
        show(v)
    }
    string_free(s)
    return 0
}

// `compact`: the history rewritten with only its live records, whatever the threshold.
fn cmd_compact(mut ag: jagent.Agent, mut h: fs.Fs) -> i32 {
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: the history store could not be opened")
        return 1
    }
    let before_runs: i64 = jagent.history_runs(ag)
    let dead: i64 = jagent.history_dead_bytes(ag)
    let m: jagent.Maint = jagent.maintain(ag, h)
    let reclaimed: i64 = jagent.compact_now(ag, h)
    if reclaimed < 0 {
        eprint_str("jagent: the compaction failed; the store is as it was")
        return 1
    }
    var s: String = string_new()
    string_push(s, "history: runs=")
    push_num(s, jagent.history_runs(ag))
    string_push(s, " pruned=")
    push_num(s, m.pruned)
    string_push(s, " dead_bytes_before=")
    push_num(s, dead)
    string_push(s, " reclaimed=")
    push_num(s, reclaimed + m.reclaimed)
    string_push(s, " live_bytes=")
    push_num(s, jagent.history_live_bytes(ag))
    string_push(s, " (had ")
    push_num(s, before_runs)
    string_push(s, " runs)")
    print_str(string_view(s))
    string_free(s)
    return 0
}

// Run one job on its interval until a shutdown signal arrives.
fn cmd_schedule(mut ag: jagent.Agent, mut h: fs.Fs, mut sp: sysproc.Spawner, read job: str) -> i32 {
    let ji: i32 = jagent.find_job(ag, job)
    if ji < 0 {
        eprint_str("jagent: no such job")
        return 1
    }
    let iv: i64 = jagent.job_interval_ms(ag, ji as usize)
    if iv <= 0 {
        eprint_str("jagent: this job declares no `interval_ms`; nothing to schedule")
        return 1
    }
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: warning: the history store could not be opened; runs will not be recorded")
    }
    var sig: sysignal.Signals = sysignal.host()
    sysignal.arm_shutdown(sig)
    var blk: time.Clock = time.host()
    var failures: i64 = 0
    for sysignal.shutdown_requested(sig) == false {
        let r: jagent.Run = jagent.run_job(ag, sp, blk, job)
        if r.status != jagent.RUN_SUCCESS { failures = failures + 1 }
        var s: String = string_new()
        jagent.render_run(ag, job, r, s)
        show(string_view(s))
        string_free(s)
        upkeep(ag, h)
        // Sleep the interval in slices, so a signal is answered within a slice.
        var left: i64 = iv * 1000000
        for left > 0 and sysignal.shutdown_requested(sig) == false {
            var sl: i64 = 200000000
            if sl > left { sl = left }
            left = left - time.wait(blk, sl)
        }
    }
    eprint_str("jagent: schedule stopped by signal")
    if failures > 0 { return 1 }
    return 0
}

// Every blocking call on a TLS connection — the handshake, the request, the response — is
// bounded by this; a peer that stalls costs the loop this long and no longer.
const JC_TLS_TIMEOUT_MS: i64 = 5000

fn listening_line(read ag: jagent.Agent, port: i64, read cfg: str, watching: bool, tls: bool) {
    var line: String = string_new()
    string_push(line, "jagent: listening on ")
    if tls { string_push(line, "https://") } else { string_push(line, "http://") }
    if jagent.host_is_loopback(ag) { string_push(line, "127.0.0.1:") } else { string_push(line, "0.0.0.0:") }
    push_num(line, port)
    string_push(line, " (config ")
    string_push(line, cfg)
    if watching { string_push(line, ", watched") } else { string_push(line, ", not watched") }
    if tls { string_push(line, ", one request per connection)") } else { string_push(line, ")") }
    print_str(string_view(line))
    string_free(line)
}

fn cmd_serve(mut ag: jagent.Agent, mut h: fs.Fs, read cfg: str) -> i32 {
    let a: Allocator = mem.system_allocator()
    let why: str = jagent.serve_refusal(ag)
    if why.len > 0 {
        eprint_str("jagent: refusing to serve")
        eprint_str(why)
        return 2
    }
    if jagent.open_store(ag, h) == false {
        eprint_str("jagent: the history store could not be opened")
        return 1
    }
    if jagent.host_is_loopback(ag) == false and jagent.token_required(ag) == false {
        eprint_str("jagent: warning: agent.host = 0.0.0.0 exposes an unauthenticated API to every interface; set agent.token")
    }
    let tls_on: bool = jagent.tls_wanted(ag)
    var cert: String = string_new()
    var key: String = string_new()
    if tls_on {
        jagent.tls_cert(ag, cert)
        jagent.tls_key(ag, key)
    }
    var net: sysnet.Net = sysnet.host()
    // The routes and middleware live on an `httpd.Server` either way; over TLS it never
    // binds — `httpds` reads the connection and hands the bytes to its dispatch.
    var sv: httpd.Server = httpd.make(a, time.host(), stderr_logger(), true, 16, 65536)
    var ts: httpds.TlsServer = httpds.make(a, string_view(cert), string_view(key))
    var addr: sysnet.SocketAddr = sysnet.loopback(jagent.port(ag) as u16)
    if jagent.host_is_loopback(ag) == false { addr = sysnet.any_addr(jagent.port(ag) as u16) }
    var bound: bool = false
    var port: i64 = 0
    if tls_on {
        if httpds.context_loaded(ts) == false {
            eprint_str("jagent: refusing to serve: the TLS certificate or key did not load")
            var oe: String = string_new()
            tls.last_error(oe)
            if string_view(oe).len > 0 { eprint_str(string_view(oe)) }
            string_free(oe)
            httpds.free(ts)
            httpd.free(sv)
            sysnet.shutdown(net)
            string_free(key)
            string_free(cert)
            return 2
        }
        bound = httpds.start(ts, net, addr, 16, JC_TLS_TIMEOUT_MS)
        port = httpds.port(ts) as i64
    } else {
        bound = httpd.start(sv, net, addr, 16)
        port = httpd.port(sv) as i64
    }
    string_free(key)
    string_free(cert)
    if bound == false {
        eprint_str("jagent: could not bind the address")
        httpds.free(ts)
        httpd.free(sv)
        sysnet.shutdown(net)
        return 1
    }
    var dir: String = string_new()
    jagent_ops.dir_of(cfg, dir)
    let watching: bool = jagent.watch(ag, h, string_view(dir))
    string_free(dir)
    listening_line(ag, port, cfg, watching, tls_on)

    // The agent moves into a cell; every handler and this loop reach it by address.
    var cell: *mut jagent.Agent = alloc(jagent.Agent, 1)
    unsafe { (cell + 0).* = ag }
    var ctx: *mut jagent.Serve = jagent.serve_ctx(cell, sysproc.host(), time.host())
    jagent.install(sv, ctx)
    var sig: sysignal.Signals = sysignal.host()
    sysignal.arm_shutdown(sig)
    var sp: sysproc.Spawner = sysproc.host()
    var blk: time.Clock = time.host()

    for sysignal.shutdown_requested(sig) == false {
        if tls_on {
            httpds.step(ts, sv, net, 200)
        } else {
            httpd.serve_for(sv, net, 200)
        }
        unsafe { jagent.poll_config((cell + 0).*, h) }
        unsafe { jagent.tick((cell + 0).*, sp, blk) }
        // The policy runs between requests, so an API run's record is pruned or compacted
        // by the next round, never during the answer.
        unsafe { upkeep((cell + 0).*, h) }
    }

    var back: jagent.Agent = unsafe { (cell + 0).* }
    jagent.begin_drain(back)
    let why2: i32 = jagent.halt(back)
    var bye: String = string_new()
    string_push(bye, "jagent: stopped on ")
    string_push(bye, sysignal.signal_name(sysignal.caught(sig)))
    string_push(bye, ", ")
    string_push(bye, service.exit_name(why2))
    print_str(string_view(bye))
    string_free(bye)
    if tls_on { httpds.stop(ts, net) } else { httpd.stop(sv, net) }
    httpds.free(ts)
    httpd.free(sv)
    sysnet.shutdown(net)
    jagent.free(back)
    jagent.free_serve(ctx)
    free_ptr(cell as *mut u8)
    if why2 == service.SVC_CLEAN { return 0 }
    return 1
}

// `check` / `config validate`: load it, say so, exit by the verdict. The faults are on
// stderr through `load_or_complain`; this prints the one line a script reads.
fn cmd_validate(mut ag: jagent.Agent, read cfg: str) -> i32 {
    var s: String = string_new()
    string_push(s, "config: ok path=")
    string_push(s, cfg)
    string_push(s, " jobs=")
    push_num(s, jagent.job_count(ag) as i64)
    print_str(string_view(s))
    string_free(s)
    return 0
}

// The text in force, secrets redacted — `agent.token` prints as `****`.
fn cmd_config_show(mut ag: jagent.Agent) -> i32 {
    var s: String = string_new()
    jagent.render_config(ag, s)
    show(string_view(s))
    string_free(s)
    return 0
}

fn cmd_doctor(read a: Allocator, mut h: fs.Fs, mut sp: sysproc.Spawner, read cfg: str, source: i32, probes: bool) -> i32 {
    var blk: time.Clock = time.host()
    var r: jagent_ops.Report = jagent_ops.doctor_from(a, h, sp, blk, cfg, source, probes)
    show(jagent_ops.report_text(r))
    let f: str = jagent_ops.report_faults(r)
    if f.len > 0 { eprint_str(str.trim_end(f)) }
    if jagent_ops.is_ok(r) { return 0 }
    return 1
}

fn cmd_ask(mut ag: jagent.Agent, mut h: fs.Fs, read a: Allocator, read question: str) -> i32 {
    var s: String = string_new()
    let r: i32 = jagent_ops.ask(ag, h, a, question, s)
    show(string_view(s))
    string_free(s)
    if r == jagent_ops.ASK_ANSWERED or r == jagent_ops.ASK_REFUSED { return 0 }
    return 1
}

fn cmd_init(mut h: fs.Fs, read cfg: str, force: bool) -> i32 {
    let r: i32 = jagent_ops.init(h, cfg, force)
    var s: String = string_new()
    string_push(s, "jagent: ")
    if r == jagent_ops.INIT_CREATED {
        string_push(s, "created ")
        string_push(s, cfg)
        print_str(string_view(s))
        string_free(s)
        return 0
    }
    if r == jagent_ops.INIT_EXISTS {
        string_push(s, cfg)
        string_push(s, " exists; not replaced (pass --force to replace it)")
    } else {
        string_push(s, "could not write ")
        string_push(s, cfg)
    }
    eprint_str(string_view(s))
    string_free(s)
    return 1
}

fn push_num(mut s: String, v: i64) {
    if v >= 10 { push_num(s, v / 10) }
    let d: i64 = v % 10
    if d == 0 { string_push(s, "0") }
    if d == 1 { string_push(s, "1") }
    if d == 2 { string_push(s, "2") }
    if d == 3 { string_push(s, "3") }
    if d == 4 { string_push(s, "4") }
    if d == 5 { string_push(s, "5") }
    if d == 6 { string_push(s, "6") }
    if d == 7 { string_push(s, "7") }
    if d == 8 { string_push(s, "8") }
    if d == 9 { string_push(s, "9") }
}

// The words from argv[from] on, joined by single spaces — the question `ask` reads.
fn join_from(from: i32, mut dst: String) {
    var i: i32 = from
    for i < env.argc() {
        if i > from { string_push(dst, " ") }
        string_push(dst, env.argv(i))
        i = i + 1
    }
}

fn main() -> i32 {
    // `-c <config>` may come first; then the command and its argument(s).
    var i: i32 = 1
    var flag: str = ""
    if env.argc() > i + 1 {
        if str_eq(env.argv(i), "-c") {
            flag = env.argv(i + 1)
            i = i + 2
        }
    }
    if env.argc() <= i { return usage() }
    var h: fs.Fs = fs.host()
    var cfg: String = string_new()
    let source: i32 = jagent_ops.discover(h, flag, env.get(jagent_ops.OPS_ENV_VAR), cfg)

    let cmd: str = env.argv(i)
    var arg: str = ""
    if env.argc() > i + 1 { arg = env.argv(i + 1) }
    // `run group <name>`: the second word selects the group form.
    var group_arg: str = ""
    if str_eq(cmd, "run") and str_eq(arg, "group") {
        if env.argc() > i + 2 { group_arg = env.argv(i + 2) }
        if group_arg.len == 0 {
            string_free(cfg)
            return usage()
        }
    }

    // The commands that need no loaded configuration.
    if str_eq(cmd, "init") {
        var force: bool = false
        if str_eq(arg, "--force") { force = true }
        if arg.len > 0 and force == false {
            string_free(cfg)
            return usage()
        }
        let code0: i32 = cmd_init(h, string_view(cfg), force)
        string_free(cfg)
        return code0
    }
    let a: Allocator = mem.system_allocator()
    var sp: sysproc.Spawner = sysproc.host()
    if str_eq(cmd, "doctor") {
        var probes: bool = true
        if str_eq(arg, "--no-probes") { probes = false }
        if arg.len > 0 and probes {
            string_free(cfg)
            return usage()
        }
        let code1: i32 = cmd_doctor(a, h, sp, string_view(cfg), source, probes)
        string_free(cfg)
        return code1
    }

    // `config show|validate` is two words; `check` is `config validate`.
    var sub: str = ""
    if str_eq(cmd, "config") {
        sub = arg
        if str_eq(sub, "show") == false and str_eq(sub, "validate") == false {
            string_free(cfg)
            return usage()
        }
    }
    var known: bool = false
    if str_eq(cmd, "status") or str_eq(cmd, "serve") or str_eq(cmd, "run") or str_eq(cmd, "schedule") { known = true }
    if str_eq(cmd, "logs") or str_eq(cmd, "jobs") or str_eq(cmd, "check") or str_eq(cmd, "config") or str_eq(cmd, "ask") { known = true }
    if str_eq(cmd, "groups") or str_eq(cmd, "compact") { known = true }
    if known == false {
        string_free(cfg)
        return usage()
    }
    if str_eq(cmd, "run") or str_eq(cmd, "schedule") or str_eq(cmd, "ask") {
        if arg.len == 0 {
            string_free(cfg)
            return usage()
        }
    }
    var ag: jagent.Agent = jagent.make(a, time.host(), stderr_logger())
    var code: i32 = 2
    if load_or_complain(ag, h, string_view(cfg)) == false {
        // `status` and `ask` still report what they can: the faults are the status.
        if str_eq(cmd, "status") { cmd_status(ag, h) }
        if str_eq(cmd, "ask") {
            var q0: String = string_new()
            join_from(i + 1, q0)
            cmd_ask(ag, h, a, string_view(q0))
            string_free(q0)
        }
        string_free(cfg)
        jagent.free(ag)
        return 1
    }
    if str_eq(cmd, "status") { code = cmd_status(ag, h) }
    if str_eq(cmd, "jobs") { code = cmd_jobs(ag) }
    if str_eq(cmd, "logs") { code = cmd_logs(ag, h, arg) }
    if str_eq(cmd, "check") { code = cmd_validate(ag, string_view(cfg)) }
    if str_eq(cmd, "config") {
        if str_eq(sub, "validate") { code = cmd_validate(ag, string_view(cfg)) }
        if str_eq(sub, "show") { code = cmd_config_show(ag) }
    }
    if str_eq(cmd, "ask") {
        var q: String = string_new()
        join_from(i + 1, q)
        code = cmd_ask(ag, h, a, string_view(q))
        string_free(q)
    }
    if str_eq(cmd, "run") {
        if group_arg.len > 0 { code = cmd_run_group(ag, h, sp, group_arg) } else { code = cmd_run(ag, h, sp, arg) }
    }
    if str_eq(cmd, "groups") { code = cmd_groups(ag) }
    if str_eq(cmd, "compact") { code = cmd_compact(ag, h) }
    if str_eq(cmd, "schedule") { code = cmd_schedule(ag, h, sp, arg) }
    if str_eq(cmd, "serve") {
        // `serve` consumes the agent (it moves into the handlers' cell).
        code = cmd_serve(ag, h, string_view(cfg))
        string_free(cfg)
        return code
    }
    string_free(cfg)
    jagent.free(ag)
    return code
}
