// examples/std/format_float.jtr — shortest, correctly-rounded f64 → decimal (Dragon4).
//
// `core.format_float` writes the *shortest* decimal that parses back to the exact
// double, into a caller `[]u8` (no alloc), locale-free and deterministic. The
// strongest check is the **round-trip**: parse_float(format_float(x)) is bit-identical
// to x — which also ties the formatter to the (separately validated) parser.
//
//   jestyrc run examples/std/format_float.jtr
//   →  eleven 1s, then the formatted strings  1.5e0  5e-1  1e0  3.14159265358979e0

import "core"
import "io"

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }

// unwrap a parse result (tail-position match — the C-backend-supported form), with a
// default on error (never taken here, since format_float output always parses).
fn uo_f(take r: Result(f64, ParseFloatError), take d: f64) -> f64 {
    match r { ok(v) => v, err(e) => d }
}

// format x into a fresh buffer, parse it back, return 1 iff bit-identical to x.
fn roundtrip(x: f64) -> i32 {
    var raw: *mut u8 = alloc(u8, 32)
    var buf: []u8 = slice(u8, raw, 32)
    let n: usize = core.format_float(x, buf)
    let sv: []u8 = slice(u8, raw, n)
    let v: f64 = uo_f(core.parse_float(from_utf8(sv)), 0.0)
    free_ptr(raw)
    return b2i(core.f64_bits(v) == core.f64_bits(x))
}

// format x and print the string (to eyeball the shortest form).
fn show(x: f64) {
    var raw: *mut u8 = alloc(u8, 32)
    var buf: []u8 = slice(u8, raw, 32)
    let n: usize = core.format_float(x, buf)
    let sv: []u8 = slice(u8, raw, n)
    io.print_line(from_utf8(sv))
    free_ptr(raw)
}

fn main() -> i32 {
    io.print_i32(roundtrip(1.5))                            // 1
    io.print_i32(roundtrip(0.1))                            // 1
    io.print_i32(roundtrip(0.3))                            // 1
    io.print_i32(roundtrip(100.0))                          // 1
    io.print_i32(roundtrip(0.0 - 2.5))                      // 1
    io.print_i32(roundtrip(1.0e10))                         // 1
    io.print_i32(roundtrip(3.14159265358979))              // 1
    io.print_i32(roundtrip(9007199254740992.0))            // 1
    io.print_i32(roundtrip(5.0e-324))                      // 1  (subnormal)
    io.print_i32(roundtrip(1.7976931348623157e308))        // 1  (max normal)
    io.print_i32(roundtrip(0.30000000000000004))           // 1

    show(1.5)                                               // 1.5e0
    show(0.5)                                               // 5e-1
    show(1.0)                                               // 1e0
    show(3.14159265358979)                                 // 3.14159265358979e0
    return 0
}
