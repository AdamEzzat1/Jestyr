// std/env.jtr — the `std` process-environment tier: thin, named wrappers over the
// command-line-argument intrinsics, so user code says `env.argc()` / `env.argv(i)`
// instead of reaching for a bare compiler builtin. This is how a self-hosted compiler
// learns *which* `.jtr` file to compile.

// The number of command-line arguments, including the program path at index 0.
pub fn argc() -> i32 {
    return arg_count()
}

// The i-th command-line argument as a `str` view (no copy). `argv(0)` is the program
// path; an out-of-range index yields an empty `str`.
pub fn argv(i: i32) -> str {
    return arg(i)
}
