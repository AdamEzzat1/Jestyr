// std/env.jtr — the `std` process-environment tier: thin, named wrappers over the
// command-line-argument intrinsics, so user code says `env.argc()` / `env.argv(i)`
// instead of reaching for a bare compiler builtin. This is how a self-hosted compiler
// learns *which* `.jtr` file to compile.

// The number of command-line arguments, including the program path at index 0.
pub fn argc() -> i32 {
    return arg_count()
}

// The i-th command-line argument as a `str` view (no copy). `argv(0)` is the program
// path; an out-of-range index yields an empty `str`.
pub fn argv(i: i32) -> str {
    return arg(i)
}

// The value of environment variable `name`, or an empty `str` when it is unset.
// A view into the process environment — OS-owned storage, no allocation and
// nothing to free, the same contract as `argv`. Unset and set-but-empty are
// deliberately indistinguishable here; use `has` when the difference matters.
//
// (Named `get` rather than Rust's `var` because `var` is a Jestyr keyword.)
pub fn get(read name: str) -> str {
    return env_var(name)
}

// Is `name` present in the environment with a non-empty value? The honest
// spelling of the check `get` cannot express on its own.
pub fn has(read name: str) -> bool {
    return env_var(name).len > 0
}

// The value of `name`, or `fallback` when it is unset or empty — the common
// "read config with a default" shape, so callers stop hand-writing it.
pub fn get_or(read name: str, read fallback: str) -> read str {
    let v: str = env_var(name)
    if v.len > 0 { return v }
    return fallback
}

// The program's own path, as the OS reported it (`argv(0)`).
pub fn program() -> str {
    return arg(0)
}

// --------------------------------------------------------- the Env capability
//
// Everything above is ambient: any function can read any variable and no signature
// says so. `Env` is the same reads behind an explicit handle.
//
// THE RESTRICTED MODE PROVES A NEGATIVE, which is the point. A `sealed()` handle
// reports every variable as unset while still COUNTING the lookups, so a test can
// establish two different things: that a subsystem behaves identically without any
// ambient configuration (pass it a sealed handle and compare output), and that it
// nevertheless tried to read N variables (assert `lookups`). The first is a
// reproducibility claim; the second tells you which claim you are actually making.
//
// This matters more than it looks for a compiler. A build that silently varies with
// `CC` or `TMPDIR` is not reproducible, and the failure is invisible until someone
// else's machine disagrees. Passing `sealed()` turns that into a test.
//
// Not enforcement — `env_var` stays reachable. It puts the dependency in the
// signature. Same trade as `std/process`, argued at length there.

pub struct Env {
    sealed: bool,
    lookups: i64,
}

// A handle onto the real process environment.
pub fn host() -> Env {
    return Env{ sealed: false, lookups: 0 }
}

// A handle that reports every variable as unset, counting the attempts. Hand this to
// code that must not depend on ambient configuration.
pub fn sealed() -> Env {
    return Env{ sealed: true, lookups: 0 }
}

// The value of `name`, or "" when unset — or always "" through a sealed handle.
// Named `lookup` because `get` above already owns the ambient spelling.
pub fn lookup(mut e: Env, read name: str) -> str {
    e.lookups = e.lookups + 1
    if e.sealed { return "" }
    return env_var(name)
}

// `lookup` with a default, the shape most configuration reading actually wants. A
// sealed handle therefore yields `fallback` for everything, which is exactly the
// "does this still work with no configuration at all" question.
// (`-> read str` for the same reason `get_or` above needs it: `fallback` is a
// second-class borrow, so returning it has to be declared. Note the return may
// borrow from EITHER the environment or `fallback` — borrowed projection has no way
// to say which, safety-mosaic item 2, and this is now its third stdlib consumer.)
pub fn lookup_or(mut e: Env, read name: str, read fallback: str) -> read str {
    let v: str = lookup(e, name)
    if v.len > 0 { return v }
    return fallback
}

// Is `name` set and non-empty? Always false through a sealed handle.
pub fn present(mut e: Env, read name: str) -> bool {
    return lookup(e, name).len > 0
}

// How many variables were looked up through this handle — the count a test asserts
// to show a sealed run really did try to read configuration.
pub fn lookups(read e: Env) -> i64 {
    return e.lookups
}

// Does this handle hide the environment?
pub fn is_sealed(read e: Env) -> bool {
    return e.sealed
}
