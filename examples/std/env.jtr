// std/env.jtr — the `std` process-environment tier: thin, named wrappers over the
// command-line-argument intrinsics, so user code says `env.argc()` / `env.argv(i)`
// instead of reaching for a bare compiler builtin. This is how a self-hosted compiler
// learns *which* `.jtr` file to compile.

// The number of command-line arguments, including the program path at index 0.
pub fn argc() -> i32 {
    return arg_count()
}

// The i-th command-line argument as a `str` view (no copy). `argv(0)` is the program
// path; an out-of-range index yields an empty `str`.
pub fn argv(i: i32) -> str {
    return arg(i)
}

// The value of environment variable `name`, or an empty `str` when it is unset.
// A view into the process environment — OS-owned storage, no allocation and
// nothing to free, the same contract as `argv`. Unset and set-but-empty are
// deliberately indistinguishable here; use `has` when the difference matters.
//
// (Named `get` rather than Rust's `var` because `var` is a Jestyr keyword.)
pub fn get(read name: str) -> str {
    return env_var(name)
}

// Is `name` present in the environment with a non-empty value? The honest
// spelling of the check `get` cannot express on its own.
pub fn has(read name: str) -> bool {
    return env_var(name).len > 0
}

// The value of `name`, or `fallback` when it is unset or empty — the common
// "read config with a default" shape, so callers stop hand-writing it.
pub fn get_or(read name: str, read fallback: str) -> read str {
    let v: str = env_var(name)
    if v.len > 0 { return v }
    return fallback
}

// The program's own path, as the OS reported it (`argv(0)`).
pub fn program() -> str {
    return arg(0)
}
