// std/httpd_test.jtr — the server, on real loopback sockets, one exchange at a time.
//
// Every test here runs a real `Server` and a real `Client` in ONE thread, taking turns: the
// client sends, the server is driven for a bounded budget, the client reads. There is no
// scheduler in the transcript, so each assertion is exact — which is the property the
// single-threaded design was chosen for. The routing, middleware, keep-alive, streaming and
// static-file cases are all such transcripts; the timeout case is the one that waits, and
// it asserts a lower bound only.
//
// Run:  jestyrc test examples/std/httpd_test.jtr

import "fs"
import "http"
import "httpc"
import "httpd"
import "log"
import "mem"
import "sysnet"
import "test"
import "test_report"
import "time"
import "writer"

const HD_T_CAP: usize = 16384
const HD_T_STATIC: str = "examples"

fn nothing() { }

fn quiet_logger() -> log.Logger {
    return log.make(time.manual(0), writer.to_buffer(), log.LOG_INFO, log.LOG_LOGFMT)
}

// ---- handlers -------------------------------------------------------------------------

fn h_hello(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    httpd.set_header(x, "X-Served-By", "jhttpd")
    httpd.respond(x, 200, "text/plain", "hello")
    return 0
}

fn h_user(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var s: String = string_new()
    string_push(s, "user:")
    string_push(s, httpd.param(x, "id"))
    httpd.respond(x, 200, "text/plain", string_view(s))
    string_free(s)
    return 0
}

fn h_echo(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var s: String = string_new()
    string_push(s, "echo:")
    string_push(s, httpd.body(x))
    httpd.respond(x, 200, "text/plain", string_view(s))
    string_free(s)
    return 0
}

fn h_query(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var s: String = string_new()
    string_push(s, "q=")
    string_push(s, httpd.query(x))
    httpd.respond(x, 200, "text/plain", string_view(s))
    string_free(s)
    return 0
}

fn h_stream(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    httpd.stream_begin(x, 200, "text/plain")
    httpd.stream_write(x, "ab")
    httpd.stream_write(x, "")            // a no-op, NOT a terminator
    httpd.stream_write(x, "cd")
    httpd.stream_write(x, "ef")
    httpd.stream_end(x)
    return 0
}

fn h_static(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var h: fs.Fs = fs.host()
    httpd.serve_file(x, h, HD_T_STATIC, httpd.param(x, "*"))
    return 0
}

// A handler that records that it RAN, through the context pointer — the only way to see
// whether a middleware's `DONE` really skipped routing. The client cannot: a handler that
// runs after a 401 has its own response refused as a duplicate, so the status looks right
// either way, and a probe that ignored `DONE` passed the first version of this suite.
fn h_counted(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    unsafe { p.* = p.* + 1 }
    httpd.respond(x, 200, "text/plain", "counted")
    return 0
}

fn h_silent(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    return 0                             // sends nothing: the server must answer for it
}

// Middleware: refuse anything without the token.
fn mw_auth(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    if str_eq(httpd.header(x, "x-token"), "ok") { return httpd.HTTPD_NEXT }
    httpd.respond(x, 401, "text/plain", "no token")
    return httpd.HTTPD_DONE
}

// Middleware: count every request that reaches it, through the context pointer.
fn mw_count(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    unsafe { p.* = p.* + 1 }
    return httpd.HTTPD_NEXT
}

// ---- body sinks, and the four counters that prove a body streamed ------------------------
//
// A sink's context is four `i64` slots in a raw array, because a sink is a fn pointer and a
// closure that captures cannot be one: [0] bytes seen, [1] their checksum, [2] how many
// PIECES they arrived in, [3] the largest of those pieces. The last two are the assertions
// that a whole body did not simply fit — a buffered implementation would pass slots 0 and 1
// and fail both of these.
const TS_BYTES: usize = 0
const TS_SUM: usize = 1
const TS_PIECES: usize = 2
const TS_MAX: usize = 3

fn ts_new() -> *mut i64 {
    var p: *mut i64 = alloc(i64, 4)
    var i: usize = 0
    for i < 4 {
        unsafe { (p + i).* = 0 }
        i = i + 1
    }
    return p
}

fn ts_get(p: *mut i64, i: usize) -> i64 {
    var v: i64 = 0
    unsafe { v = (p + i).* }
    return v
}

fn ts_set(p: *mut i64, i: usize, v: i64) {
    unsafe { (p + i).* = v }
}

fn tally_open(ctx: *mut u8, read x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    var i: usize = 0
    for i < 4 {
        ts_set(p, i, 0)
        i = i + 1
    }
    return 0
}

fn tally_data(ctx: *mut u8, read d: []u8) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    var s: i64 = ts_get(p, TS_SUM)
    var i: usize = 0
    for i < d.len {
        s = s + (d[i] as i64)
        i = i + 1
    }
    ts_set(p, TS_BYTES, ts_get(p, TS_BYTES) + (d.len as i64))
    ts_set(p, TS_SUM, s)
    ts_set(p, TS_PIECES, ts_get(p, TS_PIECES) + 1)
    if (d.len as i64) > ts_get(p, TS_MAX) { ts_set(p, TS_MAX, d.len as i64) }
    return 0
}

// A sink that refuses on the HEAD. It answers with a STATUS rather than a response, because
// the response belongs to the route's handler — which is exactly what never runs here.
fn gate_open(ctx: *mut u8, read x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    ts_set(p, TS_BYTES, 0)
    if str_eq(httpd.header(x, "x-token"), "ok") { return 0 }
    return 401
}

// A sink that refuses PART WAY IN: it takes at most 600 bytes whatever the framing declared.
fn small_open(ctx: *mut u8, read x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    ts_set(p, TS_BYTES, 0)
    return 0
}

fn small_data(ctx: *mut u8, read d: []u8) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    let n: i64 = ts_get(p, TS_BYTES) + (d.len as i64)
    ts_set(p, TS_BYTES, n)
    if n > 600 { return 413 }
    return 0
}

// The streamed route's handler. It runs ONCE, after the body is complete, and reports what
// the sink counted beside what the exchange itself holds — which must be nothing.
fn h_upload(ctx: *mut u8, mut x: httpd.Exchange) -> i32 {
    var p: *mut i64 = ctx as *mut i64
    var s: String = string_new()
    string_push(s, "up:")
    push_i64(s, httpd.body_streamed(x))
    string_push(s, "/")
    push_i64(s, ts_get(p, TS_SUM))
    string_push(s, " buffered:")
    push_i64(s, httpd.body_len(x) as i64)
    httpd.respond(x, 200, "text/plain", string_view(s))
    string_free(s)
    return 0
}

// ---- helpers ------------------------------------------------------------------------------

fn push_i64(mut s: String, v: i64) {
    if v == 0 {
        string_push(s, "0")
        return
    }
    var raw: *mut u8 = alloc(u8, 24)
    var b: []u8 = slice(u8, raw, 24)
    var n: usize = 0
    var t: i64 = v
    for t > 0 {
        b[n] = (48 + (t % 10)) as u8
        t = t / 10
        n = n + 1
    }
    var i: usize = 0
    for i < n / 2 {
        let tmp: u8 = b[i]
        b[i] = b[n - 1 - i]
        b[n - 1 - i] = tmp
        i = i + 1
    }
    string_push(s, from_utf8(b[0 .. n]))
    free_ptr(raw)
}

fn push_hex(mut s: String, v: usize) {
    if v == 0 {
        string_push(s, "0")
        return
    }
    var raw: *mut u8 = alloc(u8, 24)
    var b: []u8 = slice(u8, raw, 24)
    var n: usize = 0
    var t: usize = v
    for t > 0 {
        let d: usize = t % 16
        if d < 10 { b[n] = (48 + d) as u8 } else { b[n] = (87 + d) as u8 }
        t = t / 16
        n = n + 1
    }
    var i: usize = 0
    for i < n / 2 {
        let tmp: u8 = b[i]
        b[i] = b[n - 1 - i]
        b[n - 1 - i] = tmp
        i = i + 1
    }
    string_push(s, from_utf8(b[0 .. n]))
    free_ptr(raw)
}

// `n` bytes of a repeating pattern into `dst`, returning the checksum a sink that saw every
// one of them must report. The checksum is what makes "4096 bytes arrived" into "the RIGHT
// 4096 bytes arrived, in order".
fn pattern(n: usize, mut dst: String) -> i64 {
    var raw: *mut u8 = alloc(u8, n + 1)
    var b: []u8 = slice(u8, raw, n)
    var sum: i64 = 0
    var i: usize = 0
    for i < n {
        let v: u8 = (97 + (i % 26)) as u8
        b[i] = v
        sum = sum + (v as i64)
        i = i + 1
    }
    string_push(dst, from_utf8(b))
    free_ptr(raw)
    return sum
}

// `data`, chunk-encoded in pieces of `piece` bytes, terminator included.
fn chunked_of(read data: str, piece: usize, mut dst: String) {
    var i: usize = 0
    for i < data.len {
        var n: usize = piece
        if i + n > data.len { n = data.len - i }
        push_hex(dst, n)
        string_push(dst, "\r\n")
        string_push(dst, data[i .. i + n])
        string_push(dst, "\r\n")
        i = i + n
    }
    string_push(dst, "0\r\n\r\n")
}

fn boot(read a: Allocator, mut net: sysnet.Net, logging: bool) -> httpd.Server {
    var sv: httpd.Server = httpd.make(a, time.host(), quiet_logger(), logging, 4, 8192)
    httpd.start(sv, net, sysnet.loopback(0), 8)
    httpd.route(sv, "GET", "/hello", httpd.handler(null, &h_hello))
    httpd.route(sv, "GET", "/users/:id", httpd.handler(null, &h_user))
    httpd.route(sv, "POST", "/echo", httpd.handler(null, &h_echo))
    httpd.route(sv, "GET", "/q", httpd.handler(null, &h_query))
    httpd.route(sv, "GET", "/stream", httpd.handler(null, &h_stream))
    httpd.route(sv, "GET", "/static/*", httpd.handler(null, &h_static))
    httpd.route(sv, "*", "/silent", httpd.handler(null, &h_silent))
    return sv
}

// A server whose connection buffer is DELIBERATELY too small for the bodies the streaming
// tests send: 512 bytes for a 4096-byte upload, so nothing here can pass by accident of
// fitting. `/echo` is an ordinary route beside the streamed ones, which is how the "a body
// nobody streams" cases are asked.
fn boot_stream(read a: Allocator, mut net: sysnet.Net, tally: *mut i64, buf_cap: usize) -> httpd.Server {
    var sv: httpd.Server = httpd.make(a, time.host(), quiet_logger(), false, 4, buf_cap)
    httpd.start(sv, net, sysnet.loopback(0), 8)
    httpd.route(sv, "GET", "/hello", httpd.handler(null, &h_hello))
    httpd.route(sv, "POST", "/echo", httpd.handler(null, &h_echo))
    httpd.route_stream(sv, "POST", "/up", httpd.handler(tally as *mut u8, &h_upload),
                       httpd.body_sink(tally as *mut u8, &tally_open, &tally_data))
    httpd.route_stream(sv, "POST", "/gate", httpd.handler(tally as *mut u8, &h_upload),
                       httpd.body_sink(tally as *mut u8, &gate_open, &tally_data))
    httpd.route_stream(sv, "POST", "/small", httpd.handler(tally as *mut u8, &h_upload),
                       httpd.body_sink(tally as *mut u8, &small_open, &small_data))
    return sv
}

fn addr_of(read sv: httpd.Server) -> sysnet.SocketAddr {
    return sysnet.loopback(httpd.port(sv))
}

// One request through a fresh connection, with the server driven in between.
fn ask(mut sv: httpd.Server, mut net: sysnet.Net, read method: str, read path: str, read extra: str, read body: str, mut dst: String) -> i32 {
    var c: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    if httpc.is_open(c) == false { return 0 - 1 }
    httpc.request(c, method, path, extra, body)
    httpd.serve_for(sv, net, 40)
    var st: i32 = 0 - 1
    if httpc.read_response(c) == http.HTTP_OK {
        st = httpc.status(c)
        httpc.body(c, dst)
    }
    httpc.hangup(c)
    // The server sees the close on its next step; take it now so the table is clean.
    httpd.serve_for(sv, net, 5)
    return st
}

// ---- routing --------------------------------------------------------------------------------

@test fn routes_match_by_method_and_pattern_and_bind_params() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)
    test.is_true(c, rep, "the server listens", httpd.is_listening(sv))

    var b: String = string_new()
    test.eq_i64(c, rep, "GET /hello is 200", ask(sv, net, "GET", "/hello", "", "", b) as i64, 200)
    test.eq_str(c, rep, "with its body", string_view(b), "hello")

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "a :param route matches", ask(sv, net, "GET", "/users/42", "", "", b) as i64, 200)
    test.eq_str(c, rep, "and binds the segment", string_view(b), "user:42")

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "a missing segment does not match", ask(sv, net, "GET", "/users", "", "", b) as i64, 404)

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "the method is part of the match", ask(sv, net, "POST", "/hello", "", "", b) as i64, 404)

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "a POST with a body reaches its handler", ask(sv, net, "POST", "/echo", "", "ping", b) as i64, 200)
    test.eq_str(c, rep, "which reads the body", string_view(b), "echo:ping")

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "the query is split off the path", ask(sv, net, "GET", "/q?x=1&y=2", "", "", b) as i64, 200)
    test.eq_str(c, rep, "and readable", string_view(b), "q=x=1&y=2")

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "an unknown path is 404", ask(sv, net, "GET", "/nope", "", "", b) as i64, 404)

    // A handler that answers nothing is a server bug, and the server says so rather than
    // leaving the client hanging on a connection that will never carry a response.
    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "a silent handler is a 500", ask(sv, net, "GET", "/silent", "", "", b) as i64, 500)

    test.eq_i64(c, rep, "eight requests served", httpd.served(sv), 8)
    test.eq_usize(c, rep, "and no connection left open", httpd.live_connections(sv), 0)

    string_free(b)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn middleware_runs_in_order_and_may_end_the_exchange() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)
    var seen: *mut i64 = alloc(i64, 1)
    unsafe { (seen + 0).* = 0 }
    var ran: *mut i64 = alloc(i64, 1)
    unsafe { (ran + 0).* = 0 }
    httpd.use_middleware(sv, httpd.handler(seen as *mut u8, &mw_count))
    httpd.use_middleware(sv, httpd.handler(null, &mw_auth))
    httpd.route(sv, "GET", "/counted", httpd.handler(ran as *mut u8, &h_counted))

    var b: String = string_new()
    test.eq_i64(c, rep, "without the token the auth middleware answers", ask(sv, net, "GET", "/counted", "", "", b) as i64, 401)
    test.eq_str(c, rep, "with its own body", string_view(b), "no token")
    // **The assertion that makes DONE observable**: the route's handler did not run.
    var r0: i64 = 0
    unsafe { r0 = (ran + 0).* }
    test.eq_i64(c, rep, "and the route handler never ran", r0, 0)

    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "with the token the route answers", ask(sv, net, "GET", "/counted", "X-Token: ok\r\n", "", b) as i64, 200)
    test.eq_str(c, rep, "the handler's body", string_view(b), "counted")
    var r1: i64 = 0
    unsafe { r1 = (ran + 0).* }
    test.eq_i64(c, rep, "and this time it ran, once", r1, 1)

    // The counter ran first both times — order is the list's order, and a DONE from a later
    // middleware does not skip an earlier one.
    var n: i64 = 0
    unsafe { n = (seen + 0).* }
    test.eq_i64(c, rep, "the counting middleware saw both", n, 2)

    string_free(b)
    free_ptr(ran as *mut u8)
    free_ptr(seen as *mut u8)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- keep-alive ----------------------------------------------------------------------------

@test fn a_connection_carries_many_requests_and_pipelined_ones() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)

    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    test.is_true(c, rep, "connected", httpc.is_open(cl))

    // Two requests, one after the other, on ONE socket.
    httpc.request(cl, "GET", "/hello", "", "")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "first answered", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "200", httpc.status(cl) as i64, 200)
    test.eq_i64(c, rep, "the connection stayed", httpd.live_connections(sv) as i64, 1)

    httpc.request(cl, "GET", "/users/7", "", "")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "second answered on the same socket", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    var b: String = string_new()
    httpc.body(cl, b)
    test.eq_str(c, rep, "with its own body", string_view(b), "user:7")
    test.eq_i64(c, rep, "one connection accepted for two requests", httpd.accepted(sv), 1)

    // **Pipelining**: both requests in one write, before either answer is read. The server
    // must answer both, in order, from one buffer.
    httpc.send_raw(cl, "GET /hello HTTP/1.1\r\nHost: x\r\n\r\nGET /users/9 HTTP/1.1\r\nHost: x\r\n\r\n")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "pipelined: first", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    string_free(b)  b = string_new()
    httpc.body(cl, b)
    test.eq_str(c, rep, "hello first", string_view(b), "hello")
    test.eq_i64(c, rep, "pipelined: second", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    string_free(b)  b = string_new()
    httpc.body(cl, b)
    test.eq_str(c, rep, "then the user", string_view(b), "user:9")
    test.eq_i64(c, rep, "four served", httpd.served(sv), 4)

    // `Connection: close` ends it after the answer.
    httpc.request(cl, "GET", "/hello", "Connection: close\r\n", "")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "answered before closing", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_str(c, rep, "and the server said so", httpc.header(cl, "connection"), "close")
    test.eq_usize(c, rep, "the server dropped it", httpd.live_connections(sv), 0)
    httpc.hangup(cl)

    // HTTP/1.0 closes by default.
    var c2: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c2, "GET /hello HTTP/1.0\r\n\r\n")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "a 1.0 request is answered", httpc.read_response(c2) as i64, http.HTTP_OK as i64)
    test.eq_usize(c, rep, "and its connection closed", httpd.live_connections(sv), 0)
    httpc.hangup(c2)

    string_free(b)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- streaming --------------------------------------------------------------------------------

@test fn a_streamed_response_is_chunked_and_decodes_whole() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)

    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.request(cl, "GET", "/stream", "", "")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "answered", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.is_true(c, rep, "framed as chunked", httpc.is_chunked(cl))
    var b: String = string_new()
    test.is_true(c, rep, "decodes", httpc.body(cl, b))
    // The empty write in the middle must not have terminated the body.
    test.eq_str(c, rep, "all three chunks, in order", string_view(b), "abcdef")
    // And the connection is still usable: chunked framing ended the message, not the socket.
    httpc.request(cl, "GET", "/hello", "", "")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "the next request on the same socket", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    httpc.hangup(cl)

    string_free(b)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- static files -----------------------------------------------------------------------------

@test fn static_files_are_served_by_type_and_traversal_is_refused() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var h: fs.Fs = fs.host()
    // The static root is the repository's own `examples/` directory, and the "secret" one
    // level above it is a file that really exists there. No scratch tree — originally
    // because `std/sysfs` would bring `std/file` into the closure, and a second type named
    // `Writer` next to `writer.Writer` tripped the drop-glue defect A13. That defect is
    // CLOSED (`drop_collide_demo` pins the pair); the shape is kept because it is simpler.
    fs.put(h, "examples/zz_httpd_asset.css", "body{}")
    var sv: httpd.Server = boot(a, net, false)

    var b: String = string_new()
    test.eq_i64(c, rep, "a file under the root", ask(sv, net, "GET", "/static/zz_httpd_asset.css", "", "", b) as i64, 200)
    test.eq_str(c, rep, "with its bytes", string_view(b), "body{}")

    // The media type is checked through a kept-alive client, because `ask` drops headers.
    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.request(cl, "GET", "/static/zz_httpd_asset.css", "", "")
    httpd.serve_for(sv, net, 40)
    httpc.read_response(cl)
    test.eq_str(c, rep, "typed by extension", httpc.header(cl, "content-type"), "text/css")
    httpc.request(cl, "GET", "/static/hello.jtr", "", "")
    httpd.serve_for(sv, net, 40)
    httpc.read_response(cl)
    test.eq_i64(c, rep, "a real corpus file is served", httpc.status(cl) as i64, 200)
    test.eq_str(c, rep, "an unknown extension is bytes", httpc.header(cl, "content-type"), "application/octet-stream")
    httpc.hangup(cl)
    httpd.serve_for(sv, net, 5)

    // **Traversal.** `CHANGELOG.md` exists one level up; the path must not reach it, and the
    // refusal must look exactly like a missing file.
    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "`..` is refused as a 404", ask(sv, net, "GET", "/static/../CHANGELOG.md", "", "", b) as i64, 404)
    test.is_false(c, rep, "and nothing of it leaked", contains(string_view(b), "Changelog"))
    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "a missing file is a 404", ask(sv, net, "GET", "/static/zz_nope.txt", "", "", b) as i64, 404)
    string_free(b)  b = string_new()
    test.eq_i64(c, rep, "an empty rest asks for index.html, absent here", ask(sv, net, "GET", "/static/", "", "", b) as i64, 404)

    // The pure half, on every host.
    test.is_true(c, rep, "plain", httpd.safe_relative_path("a/b.txt"))
    test.is_false(c, rep, "dot-dot inside", httpd.safe_relative_path("a/../b"))
    test.is_false(c, rep, "dot-dot alone", httpd.safe_relative_path(".."))
    test.is_false(c, rep, "backslash", httpd.safe_relative_path("a\\b"))
    test.is_true(c, rep, "a dot-file is fine", httpd.safe_relative_path(".well-known/x"))
    test.eq_str(c, rep, "json type", httpd.content_type_for("x/y.json"), "application/json")
    test.eq_str(c, rep, "html type", httpd.content_type_for("index.html"), "text/html; charset=utf-8")
    test.eq_str(c, rep, "no extension", httpd.content_type_for("README"), "application/octet-stream")

    string_free(b)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    fs.erase(h, "examples/zz_httpd_asset.css")
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- access log ---------------------------------------------------------------------------------

@test fn every_exchange_writes_one_access_log_record() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, true)

    var b: String = string_new()
    ask(sv, net, "GET", "/users/5", "", "", b)
    let rec: str = httpd.last_log(sv)
    test.is_true(c, rep, "a record was written", rec.len > 0)
    test.is_true(c, rep, "with the method", contains(rec, "method=GET"))
    test.is_true(c, rep, "the path", contains(rec, "path=/users/5"))
    test.is_true(c, rep, "the status", contains(rec, "status=200"))
    test.is_true(c, rep, "and the bytes sent", contains(rec, "bytes="))

    string_free(b)  b = string_new()
    ask(sv, net, "GET", "/nope", "", "", b)
    test.is_true(c, rep, "a 404 is logged as one", contains(httpd.last_log(sv), "status=404"))

    string_free(b)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- refusals and timeouts --------------------------------------------------------------------

@test fn a_smuggling_attempt_is_refused_and_the_connection_closed() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)

    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(cl, "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /hello HTTP/1.1\r\n\r\n")
    httpd.serve_for(sv, net, 40)
    test.eq_i64(c, rep, "a response came back", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "and it is a 400", httpc.status(cl) as i64, 400)
    test.eq_i64(c, rep, "counted as a bad request", httpd.bad_requests(sv), 1)
    test.eq_i64(c, rep, "nothing was served — the smuggled GET never ran", httpd.served(sv), 0)
    // The connection is gone: a second read finds nothing at all.
    test.eq_i64(c, rep, "the connection was closed", httpc.read_response(cl) as i64, http.HTTP_INCOMPLETE as i64)
    httpc.hangup(cl)

    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_stalled_request_times_out_and_an_idle_connection_is_closed() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = boot(a, net, false)
    httpd.set_timeouts(sv, 60, 60)

    // Slowloris: half a request line, then silence.
    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(cl, "GET /hel")
    var clk: time.Clock = time.host()
    let t0: i64 = time.read_nanos(clk)
    httpd.serve_for(sv, net, 200)
    let waited: i64 = (time.read_nanos(clk) - t0) / 1000000
    test.eq_i64(c, rep, "the stall was answered with a 408", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "408", httpc.status(cl) as i64, 408)
    test.eq_i64(c, rep, "counted as a timeout", httpd.timeouts(sv), 1)
    test.is_true(c, rep, "and not before the read timeout", waited >= 60)
    httpc.hangup(cl)

    // Idle: a connection that opens and says nothing is closed without a response.
    var c2: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpd.serve_for(sv, net, 200)
    test.eq_i64(c, rep, "the idle connection got no response", httpc.read_response(c2) as i64, http.HTTP_INCOMPLETE as i64)
    test.eq_i64(c, rep, "and was counted", httpd.timeouts(sv), 2)
    test.eq_usize(c, rep, "nothing is left in the table", httpd.live_connections(sv), 0)
    httpc.hangup(c2)

    // The control: a request that completes in time is served normally under the same knobs.
    var b: String = string_new()
    test.eq_i64(c, rep, "a prompt request is unaffected", ask(sv, net, "GET", "/hello", "", "", b) as i64, 200)
    string_free(b)

    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- streamed request bodies -----------------------------------------------------------
//
// Every server here has a 512-byte connection buffer and every body is 4096 bytes or more, so
// "the body arrived" can only be true if it arrived in pieces. The counters in the sink's
// context say how many pieces and how large the largest was; a buffered implementation fails
// those two lines and passes the rest, which is why they are here.

@test fn a_content_length_body_larger_than_the_buffer_streams_in_bounded_pieces() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var tally: *mut i64 = ts_new()
    var sv: httpd.Server = boot_stream(a, net, tally, 512)

    var body: String = string_new()
    let want: i64 = pattern(4096, body)

    var msg: String = string_new()
    string_push(msg, "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 4096\r\n\r\n")
    string_push(msg, string_view(body))
    // **Pipelined**: the next request rides in the SAME write, immediately after the last byte
    // of the body. If the streaming reader takes one byte too many or one too few, this is the
    // request that breaks.
    string_push(msg, "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")

    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    test.is_true(c, rep, "connected", httpc.is_open(cl))
    httpc.send_raw(cl, string_view(msg))
    httpd.serve_for(sv, net, 200)

    test.eq_i64(c, rep, "the upload was answered", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 200", httpc.status(cl) as i64, 200)
    var got: String = string_new()
    httpc.body(cl, got)
    var wantbody: String = string_new()
    string_push(wantbody, "up:4096/")
    push_i64(wantbody, want)
    string_push(wantbody, " buffered:0")
    test.eq_str(c, rep, "the handler saw the whole body through the sink, and none of it buffered",
        string_view(got), string_view(wantbody))

    test.eq_i64(c, rep, "every byte reached the sink", ts_get(tally, TS_BYTES), 4096)
    test.eq_i64(c, rep, "and they were the right bytes, in order", ts_get(tally, TS_SUM), want)
    test.is_true(c, rep, "it arrived in more than one piece", ts_get(tally, TS_PIECES) > 1)
    test.is_true(c, rep, "and no piece was larger than the buffer", ts_get(tally, TS_MAX) <= 512)

    // **The pipelining invariant.** When the body ended the buffer sat exactly at the next
    // request's first byte, so the `GET` that followed it is answered on the same connection.
    test.eq_i64(c, rep, "the pipelined request was answered too", httpc.read_response(cl) as i64,
        http.HTTP_OK as i64)
    string_free(got)  got = string_new()
    httpc.body(cl, got)
    test.eq_str(c, rep, "and it is the one that followed the body", string_view(got), "hello")
    test.eq_i64(c, rep, "two requests served", httpd.served(sv), 2)
    test.eq_i64(c, rep, "on one connection", httpd.accepted(sv), 1)
    httpc.hangup(cl)
    httpd.serve_for(sv, net, 5)

    string_free(wantbody)
    string_free(got)
    string_free(msg)
    string_free(body)
    free_ptr(tally as *mut u8)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_chunked_body_is_decoded_as_it_arrives_and_a_bad_size_is_a_400() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var tally: *mut i64 = ts_new()
    var sv: httpd.Server = boot_stream(a, net, tally, 512)

    var body: String = string_new()
    let want: i64 = pattern(4200, body)
    var enc: String = string_new()
    chunked_of(string_view(body), 700, enc)

    var msg: String = string_new()
    string_push(msg, "POST /up HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n")
    string_push(msg, string_view(enc))
    string_push(msg, "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")

    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(cl, string_view(msg))
    httpd.serve_for(sv, net, 200)

    test.eq_i64(c, rep, "the chunked upload was answered", httpc.read_response(cl) as i64,
        http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 200", httpc.status(cl) as i64, 200)
    var got: String = string_new()
    httpc.body(cl, got)
    var wantbody: String = string_new()
    string_push(wantbody, "up:4200/")
    push_i64(wantbody, want)
    string_push(wantbody, " buffered:0")
    test.eq_str(c, rep, "the DECODED body reached the sink whole", string_view(got), string_view(wantbody))
    test.eq_i64(c, rep, "decoded byte for byte", ts_get(tally, TS_SUM), want)
    test.is_true(c, rep, "in more than one piece", ts_get(tally, TS_PIECES) > 1)
    test.is_true(c, rep, "none larger than the buffer", ts_get(tally, TS_MAX) <= 512)

    // The chunk framing bytes are not the body, and the request after the terminator is the
    // next request — the same invariant, over the other framing.
    test.eq_i64(c, rep, "the pipelined request after the terminator", httpc.read_response(cl) as i64,
        http.HTTP_OK as i64)
    string_free(got)  got = string_new()
    httpc.body(cl, got)
    test.eq_str(c, rep, "is the one that followed it", string_view(got), "hello")
    httpc.hangup(cl)
    httpd.serve_for(sv, net, 5)

    // **A malformed chunk size is a 400, not a hang.** `zz` can never become a valid size, so
    // waiting for more bytes would be waiting forever.
    var c2: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c2, "POST /up HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nnope\r\n")
    httpd.serve_for(sv, net, 100)
    test.eq_i64(c, rep, "a malformed chunk size is ANSWERED", httpc.read_response(c2) as i64,
        http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 400", httpc.status(c2) as i64, 400)
    test.eq_i64(c, rep, "and the connection closed", httpc.read_response(c2) as i64,
        http.HTTP_INCOMPLETE as i64)
    test.eq_i64(c, rep, "counted as a bad request", httpd.bad_requests(sv), 1)
    httpc.hangup(c2)

    string_free(wantbody)
    string_free(got)
    string_free(msg)
    string_free(enc)
    string_free(body)
    free_ptr(tally as *mut u8)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_body_over_the_bound_or_the_buffer_is_413_and_the_connection_closes() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var tally: *mut i64 = ts_new()
    var sv: httpd.Server = boot_stream(a, net, tally, 512)
    httpd.set_max_body(sv, 1000)

    // **A DECLARED length over the bound is refused before one body byte is waited for**, so
    // the sink is never opened at all. The sentinel is what proves it: `on_open` would have
    // cleared it.
    ts_set(tally, TS_BYTES, 0 - 1)
    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(cl, "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 4096\r\n\r\n")
    httpd.serve_for(sv, net, 100)
    test.eq_i64(c, rep, "a declared length over the bound is answered at once",
        httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 413", httpc.status(cl) as i64, 413)
    test.eq_i64(c, rep, "the sink was never opened", ts_get(tally, TS_BYTES), 0 - 1)
    test.eq_i64(c, rep, "counted", httpd.oversized_bodies(sv), 1)
    test.eq_i64(c, rep, "and the connection closed", httpc.read_response(cl) as i64,
        http.HTTP_INCOMPLETE as i64)
    httpc.hangup(cl)

    // A chunked body has no declared length, so its bound is enforced MID-STREAM, on bytes
    // received rather than bytes decoded.
    var body: String = string_new()
    pattern(4200, body)
    var enc: String = string_new()
    chunked_of(string_view(body), 700, enc)
    var msg: String = string_new()
    string_push(msg, "POST /up HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n")
    string_push(msg, string_view(enc))
    var c2: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c2, string_view(msg))
    httpd.serve_for(sv, net, 100)
    test.eq_i64(c, rep, "a chunked body that grows past the bound is answered",
        httpc.read_response(c2) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 413", httpc.status(c2) as i64, 413)
    test.eq_i64(c, rep, "counted", httpd.oversized_bodies(sv), 2)
    test.is_true(c, rep, "and it stopped near the bound, not at the end of the body",
        ts_get(tally, TS_BYTES) < 2000)
    test.eq_i64(c, rep, "nothing was served", httpd.served(sv), 0)
    httpc.hangup(c2)

    // **A body nobody streams.** `/echo` is an ordinary route: a body that FITS the buffer is
    // parsed with the message and a handler may ignore it, but one that does NOT fit is 413
    // and a close. It is not drained — see the module header.
    httpd.set_max_body(sv, 100000)
    var c3: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c3, "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 3000\r\n\r\n")
    httpd.serve_for(sv, net, 100)
    test.eq_i64(c, rep, "an unstreamed body larger than the buffer is answered",
        httpc.read_response(c3) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 413", httpc.status(c3) as i64, 413)
    test.eq_i64(c, rep, "counted", httpd.oversized_bodies(sv), 3)
    test.eq_i64(c, rep, "and the connection closed rather than drained", httpc.read_response(c3) as i64,
        http.HTTP_INCOMPLETE as i64)
    httpc.hangup(c3)

    // The control: the very same route, with a body that fits, is served.
    var b: String = string_new()
    test.eq_i64(c, rep, "a body that fits the buffer is unaffected",
        ask(sv, net, "POST", "/echo", "", "ping", b) as i64, 200)
    test.eq_str(c, rep, "and reaches the handler", string_view(b), "echo:ping")

    string_free(b)
    string_free(msg)
    string_free(enc)
    string_free(body)
    free_ptr(tally as *mut u8)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_sink_may_refuse_and_a_body_that_never_finishes_times_out() -> bool {
    var raw: *mut u8 = alloc(u8, HD_T_CAP)
    var rep: []u8 = slice(u8, raw, HD_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var net: sysnet.Net = sysnet.host()
    var tally: *mut i64 = ts_new()
    var sv: httpd.Server = boot_stream(a, net, tally, 512)
    // The IDLE knob is pushed out of reach so that the one timeout this test counts can only
    // be the READ one. With both at 60ms a kept-alive connection left over from an earlier
    // case expires during the stall and the count says 2 — a true number about the wrong
    // thing.
    httpd.set_timeouts(sv, 60, 5000)

    var body: String = string_new()
    pattern(4096, body)

    // **Refused on the head.** The sink looks at a header and says 401; the route's handler
    // never runs, and the connection closes rather than reading a body that was refused.
    var msg: String = string_new()
    string_push(msg, "POST /gate HTTP/1.1\r\nHost: x\r\nContent-Length: 4096\r\n\r\n")
    string_push(msg, string_view(body))
    var cl: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(cl, string_view(msg))
    httpd.serve_for(sv, net, 100)
    test.eq_i64(c, rep, "the refusal is a response", httpc.read_response(cl) as i64, http.HTTP_OK as i64)
    test.eq_i64(c, rep, "the status the sink chose", httpc.status(cl) as i64, 401)
    test.eq_i64(c, rep, "no body byte was taken", ts_get(tally, TS_BYTES), 0)
    test.eq_i64(c, rep, "and no request was served", httpd.served(sv), 0)
    test.eq_i64(c, rep, "the connection is closed", httpc.read_response(cl) as i64,
        http.HTTP_INCOMPLETE as i64)
    httpc.hangup(cl)

    // The same route, with the token: the body streams and the handler runs.
    var msg2: String = string_new()
    string_push(msg2, "POST /gate HTTP/1.1\r\nHost: x\r\nX-Token: ok\r\nContent-Length: 4096\r\n\r\n")
    string_push(msg2, string_view(body))
    var c2: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c2, string_view(msg2))
    httpd.serve_for(sv, net, 200)
    test.eq_i64(c, rep, "with the token it is accepted", httpc.read_response(c2) as i64,
        http.HTTP_OK as i64)
    test.eq_i64(c, rep, "200", httpc.status(c2) as i64, 200)
    test.eq_i64(c, rep, "and the whole body streamed", ts_get(tally, TS_BYTES), 4096)
    httpc.hangup(c2)
    httpd.serve_for(sv, net, 5)

    // **Refused part way in.** `/small` takes 600 bytes and then says 413.
    var msg3: String = string_new()
    string_push(msg3, "POST /small HTTP/1.1\r\nHost: x\r\nContent-Length: 4096\r\n\r\n")
    string_push(msg3, string_view(body))
    var c3: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c3, string_view(msg3))
    httpd.serve_for(sv, net, 200)
    test.eq_i64(c, rep, "a mid-body refusal is a response", httpc.read_response(c3) as i64,
        http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with the sink's status", httpc.status(c3) as i64, 413)
    test.eq_i64(c, rep, "still only one request served", httpd.served(sv), 1)
    httpc.hangup(c3)

    // **A `Content-Length` that lies short.** The server takes exactly what was promised and
    // never one byte more, so a client that under-delivers stalls — and the READ timeout,
    // not a stolen next request, is what ends it.
    var c4: httpc.Client = httpc.dial(net, addr_of(sv), HD_T_CAP)
    httpc.send_raw(c4, "POST /up HTTP/1.1\r\nHost: x\r\nContent-Length: 4096\r\n\r\nshort")
    var clk: time.Clock = time.host()
    let t0: i64 = time.read_nanos(clk)
    httpd.serve_for(sv, net, 250)
    let waited: i64 = (time.read_nanos(clk) - t0) / 1000000
    test.eq_i64(c, rep, "the stalled upload is answered", httpc.read_response(c4) as i64,
        http.HTTP_OK as i64)
    test.eq_i64(c, rep, "with a 408", httpc.status(c4) as i64, 408)
    test.is_true(c, rep, "and not before the read timeout", waited >= 60)
    test.eq_i64(c, rep, "counted as a timeout", httpd.timeouts(sv), 1)
    test.eq_i64(c, rep, "the handler never ran", httpd.served(sv), 1)
    test.eq_i64(c, rep, "though the sink did see what arrived", ts_get(tally, TS_BYTES), 5)
    httpc.hangup(c4)

    string_free(msg3)
    string_free(msg2)
    string_free(msg)
    string_free(body)
    free_ptr(tally as *mut u8)
    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
