// std/list.jtr — a generic growable list, allocator-parameterized (design §16.1).
//
// `List(T)` *stores* the `Allocator` it was built from (Rust's `Vec<T, A>`), owns
// a heap buffer obtained through that allocator's vtable, and grows it on demand.
// The concrete `List(i32)` instantiation carries a `Drop` impl, so its buffer is
// freed **automatically at scope exit** — no manual `free` needed. (`free` is kept
// for explicit teardown and is idempotent, so calling it *and* relying on Drop is
// safe — exactly one release.)

import "mem"

pub fn List(comptime T: type) -> type {
    return struct {
        ptr: *mut T,
        len: usize,
        cap: usize,
        a: Allocator,
    }
}

// An empty list bound to allocator `a`. It owns no memory until the first `push`.
pub fn make(comptime T: type, read a: Allocator) -> List(T) {
    return List(T){ ptr: null, len: 0, cap: 0, a: a }
}

// Append `x`, growing (doubling) the backing buffer from the stored allocator
// when full.
pub fn push(comptime T: type, mut l: List(T), x: T) {
    if l.len == l.cap {
        var newcap: usize = 4
        if l.cap != 0 { newcap = l.cap * 2 }
        var np: *mut T = mem.allocate(T, l.a, newcap)
        for i in 0..l.len {
            unsafe { (np + i).* = (l.ptr + i).* }
        }
        if l.cap != 0 { mem.release(T, l.a, l.ptr) }
        l.ptr = np
        l.cap = newcap
    }
    unsafe { (l.ptr + l.len).* = x }
    l.len = l.len + 1
}

// The element at `i` (caller-checked; a refined/bounds-checked variant is future work).
pub fn get(comptime T: type, l: List(T), i: usize) -> T {
    unsafe { (l.ptr + i).* }
}

pub fn len(comptime T: type, l: List(T)) -> usize {
    return l.len
}

// Explicit teardown — idempotent (zeroes `cap`, so a following auto-drop is a
// no-op). RAII (`Drop`) handles this automatically if you don't call it.
pub fn free(comptime T: type, mut l: List(T)) {
    if l.cap != 0 { mem.release(T, l.a, l.ptr) }
    l.ptr = null
    l.len = 0
    l.cap = 0
}

// Free a buffer (already type-erased to bytes) through its allocator. A free
// function — not the `impl` method — so the module-qualified `mem.free_bytes`
// resolves (qualified calls inside an `impl`-method body are not yet resolved, a
// known bootstrap limitation). It is non-generic (takes `*mut u8`), so it works
// for every element type and needs no monomorphization.
fn release_buf(read a: Allocator, p: *mut u8, n: usize) {
    if n != 0 { mem.free_bytes(a, p) }
}

// RAII for *every* `List(T)` at once — a blanket `impl[T] Drop for List(T)`,
// monomorphized per concrete element type. The buffer is freed through the stored
// allocator at scope exit; no manual free, no per-type boilerplate.
impl[T] Drop for List(T) {
    fn drop(mut self) {
        release_buf(self.a, self.ptr as *mut u8, self.cap)
    }
}
