// examples/std/await.jtr — task results + `await` (concurrency, workstream N).
//
// `let h = spawn f(args)` launches a task and binds an awaitable handle of type
// `Task(T)` (T = f's return type). `await h` joins that task and yields its result.
// Tasks run on their own OS threads inside the structured `concurrent { … }` scope:
// the two `sum_squares` tasks below compute disjoint partial sums in parallel, and
// `await` brings each result back to be combined. Any handle not awaited is still
// joined at the closing brace (the safety net), so no task can outlive its scope.
//
//   jestyrc run examples/std/await.jtr   →   385, 14
//
// 385 = Σ k² for k in 1..=10, split across two tasks (55 + 330); 14 = Σ k² for 1..=3
// from a single awaited task.

// Sum of squares over the half-open range [lo, hi).
fn sum_squares(lo: i64, hi: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = lo
    for i < hi {
        s = s + i * i
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    // Two tasks compute disjoint halves in parallel; `await` combines their results.
    concurrent {
        let lo = spawn sum_squares(1, 6)        // 1+4+9+16+25  = 55
        let hi = spawn sum_squares(6, 11)       // 36+49+64+81+100 = 330
        let total: i64 = await lo + await hi    // 385
        print_int(total as i32)                 // 385
    }

    // A single task's result, awaited and cast in one expression.
    concurrent {
        let t = spawn sum_squares(1, 4)         // 1+4+9 = 14
        print_int(await t as i32)               // 14
    }
    return 0
}
