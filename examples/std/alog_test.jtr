// std/alog_test.jtr — the crash-safety claim, checked rather than described.
//
// The module claims that reopening a log after a crash yields exactly the records that were
// completely written and says how many bytes it discarded. Three of these tests DAMAGE a real
// log on disk and assert what comes back, because a recovery path that is never exercised is
// a recovery path that does not work.
//
// **The damaged logs are built BYTE BY BYTE by this file**, not by poking at one the module
// wrote. That costs a second implementation of the frame here — and buys two things: the test
// says exactly what it is feeding in rather than describing an offset, and the module's layout
// is cross-checked against an independent encoder rather than only against itself. A test that
// corrupts a file the module wrote can only ever agree with the module.
//
// `the_published_crc32_vector_matches` is the one that runs everywhere and costs nothing: a
// checksum that is subtly wrong accepts everything it wrote itself and rejects nothing, which
// looks exactly like a working log until another implementation reads it.
//
// Run:  jestyrc test examples/std/alog_test.jtr

import "alog"
import "file"
import "fs"
import "mem"
import "test"
import "test_report"

const A_T_CAP: usize = 8192
const A_T_PATH: str = "zz_alog_scratch.log"

// ---- helpers ------------------------------------------------------------------

fn nothing() { }
fn no_log() -> alog.Log { return alog.closed() }
fn no_cur() -> alog.Cursor { return alog.no_cursor() }

fn scrub(mut f: fs.Fs) {
    fs.erase(f, A_T_PATH)
}

// Fill `n` bytes of `buf` with `v`. Callers slice `buf[0 .. n]` themselves, because a
// second-class borrow may not be returned from the call that made it.
fn fill(mut buf: []u8, n: usize, v: u8) {
    var i: usize = 0
    for i < n {
        buf[i] = v
        i = i + 1
    }
}

// ---- an INDEPENDENT encoder for the frame -------------------------------------
//
// Deliberately a second implementation. See the file header.

fn put_u32(mut b: []u8, at: usize, v: i64) {
    b[at + 0] = (v & 255) as u8
    b[at + 1] = ((v >> 8) & 255) as u8
    b[at + 2] = ((v >> 16) & 255) as u8
    b[at + 3] = ((v >> 24) & 255) as u8
}

fn put_u64(mut b: []u8, at: usize, v: i64) {
    var i: usize = 0
    for i < 8 {
        b[at + i] = ((v >> ((i * 8) as i64)) & 255) as u8
        i = i + 1
    }
}

// Write one frame into `out` at `at`: payload of `n` bytes all `v`, numbered `seq`.
// `crc_delta` is added to the correct checksum, so passing 0 writes a VALID record and
// passing 1 writes one whose payload cannot be trusted.
//
// Returns the offset just past the frame.
fn put_frame(mut buf: []u8, at: usize, seq: i64, n: usize, v: u8, crc_delta: i64) -> usize {
    // The checksummed region: len ++ seq ++ payload.
    var sc: *mut u8 = alloc(u8, 12 + n)
    var sb: []u8 = slice(u8, sc, 12 + n)
    put_u32(sb, 0, n as i64)
    put_u64(sb, 4, seq)
    var i: usize = 0
    for i < n {
        sb[12 + i] = v
        i = i + 1
    }
    let c: i64 = (alog.crc32(sb[0 .. 12 + n]) as i64) + crc_delta
    free_ptr(sc)

    put_u32(buf, at, n as i64)
    put_u32(buf, at + 4, c)
    put_u64(buf, at + 8, seq)
    var k: usize = 0
    for k < n {
        buf[at + 16 + k] = v
        k = k + 1
    }
    return at + 16 + n
}

// Write `bytes` to the scratch path, replacing whatever was there.
fn lay_down(read a: Allocator, read bytes: []u8) {
    var w: file.Writer = file.create_path(a, A_T_PATH)
    file.write_from(w, bytes)
    let n: usize = file.finish(w) catch 0
}

// Append `n` bytes of `v` to the scratch path — a torn write, from outside the module.
fn append_raw(read a: Allocator, n: usize, v: u8) {
    var b: *mut u8 = alloc(u8, n)
    var bs: []u8 = slice(u8, b, n)
    fill(bs, n, v)
    var w: file.Writer = file.append_path(a, A_T_PATH)
    file.write_from(w, bs)
    let k: usize = file.finish(w) catch 0
    free_ptr(b)
}

// ---- the checksum, on every host ----------------------------------------------

@test fn the_published_crc32_vector_matches() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()

    // **The standard CRC-32 check value.** This is the only assertion that catches a
    // home-grown polynomial or a reflection mistake — a wrong CRC is self-consistent and
    // therefore invisible to every round-trip test in this file.
    var b: *mut u8 = alloc(u8, 16)
    var sb: []u8 = slice(u8, b, 16)
    let digits: str = "123456789"
    var i: usize = 0
    for i < digits.len {
        sb[i] = digits[i]
        i = i + 1
    }
    test.eq_i64(c, rep, "crc32(\"123456789\") is the published vector",
        alog.crc32(sb[0 .. 9]) as i64, 3421780262)      // 0xCBF43926

    // The empty input is 0, not 0xFFFFFFFF — the final inversion applied to the initial
    // value. A CRC that skipped either would still pass every round trip in this file.
    test.eq_i64(c, rep, "crc32 of nothing is zero", alog.crc32(sb[0 .. 0]) as i64, 0)

    // One flipped bit changes it. The anti-vacuity control for a checksum that returned a
    // constant.
    sb[0] = 50 as u8                                    // '1' -> '2'
    test.is_true(c, rep, "one changed byte changes the checksum",
        (alog.crc32(sb[0 .. 9]) as i64) != 3421780262)

    free_ptr(b)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- the round trip -------------------------------------------------------------

@test fn records_round_trip_in_order_with_their_sequences() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var pb: *mut u8 = alloc(u8, 256)
    var pbuf: []u8 = slice(u8, pb, 256)

    var l: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    test.is_true(c, rep, "a fresh log opens", alog.is_open(l))
    test.eq_i64(c, rep, "and starts empty", alog.next_seq(l), 0)
    test.eq_i64(c, rep, "having recovered nothing", alog.recovered(l), 0)

    // Sequences are assigned by the log and returned, so a caller can reference a record it
    // just wrote without re-reading the file.
    fill(pbuf, 5, 65)
    test.eq_i64(c, rep, "first record is 0", alog.append(l, pbuf[0 .. 5]) catch 0 - 1, 0)
    fill(pbuf, 40, 66)
    test.eq_i64(c, rep, "second is 1", alog.append(l, pbuf[0 .. 40]) catch 0 - 1, 1)
    fill(pbuf, 1, 67)
    test.eq_i64(c, rep, "third is 2", alog.append(l, pbuf[0 .. 1]) catch 0 - 1, 2)

    // An EMPTY payload is a real record, not a no-op: a log of events where the event is the
    // whole message needs one, and a frame that could not express it would push callers into
    // writing a dummy byte.
    test.eq_i64(c, rep, "an empty record is still a record", alog.append(l, pbuf[0 .. 0]) catch 0 - 1, 3)

    alog.sync(l) catch nothing()
    test.eq_i64(c, rep, "one sync", alog.syncs(l), 1)
    test.eq_i64(c, rep, "four appends", alog.appended(l), 4)
    test.eq_i64(c, rep, "the size is headers plus payloads", alog.size_bytes(l), 4 * 16 + 46)
    alog.close(l) catch nothing()

    var cu: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.is_true(c, rep, "a cursor opens", alog.cursor_is_open(cu))
    test.eq_i64(c, rep, "record 0 is 5 bytes", alog.next(cu, pbuf) as i64, 5)
    test.eq_i64(c, rep, "and its first byte survived", pbuf[0] as i64, 65)
    test.eq_i64(c, rep, "record 1 is 40 bytes", alog.next(cu, pbuf) as i64, 40)
    test.eq_i64(c, rep, "record 2 is 1 byte", alog.next(cu, pbuf) as i64, 1)
    test.eq_i64(c, rep, "record 3 is empty", alog.next(cu, pbuf) as i64, 0)
    test.eq_i64(c, rep, "then the log ends", alog.next(cu, pbuf) as i64, 0 - 1)

    // **A clean end is not damage**, and the distinction is what tells a replaying caller
    // whether it consumed the whole log or stopped at a wound.
    test.is_false(c, rep, "and the end is clean, not damaged", alog.cursor_damaged(cu))
    test.eq_i64(c, rep, "four records were read", alog.cursor_count(cu), 4)
    alog.cursor_close(cu)

    // Reopening finds them all and discards nothing — the no-crash control for the recovery
    // tests below.
    var l2: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    test.eq_i64(c, rep, "reopening recovers all four", alog.recovered(l2), 4)
    test.eq_i64(c, rep, "discarding nothing", alog.discarded(l2), 0)
    test.eq_i64(c, rep, "and the next sequence continues", alog.next_seq(l2), 4)
    alog.close(l2) catch nothing()

    scrub(h)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- the crash --------------------------------------------------------------------

@test fn a_torn_tail_is_discarded_and_reported() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var pb: *mut u8 = alloc(u8, 256)
    var pbuf: []u8 = slice(u8, pb, 256)

    var l: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    fill(pbuf, 8, 88)
    alog.append(l, pbuf[0 .. 8]) catch 0 - 1
    alog.append(l, pbuf[0 .. 8]) catch 0 - 1
    alog.close(l) catch nothing()

    // **The crash.** A process killed mid-write leaves a partial record: here, seven bytes of
    // a header that promised sixteen. Nothing about these bytes is a valid record and the log
    // must not pretend otherwise.
    append_raw(a, 7, 255 as u8)

    var l2: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    test.is_true(c, rep, "the log still opens after a torn write", alog.is_open(l2))
    test.eq_i64(c, rep, "the two complete records survive", alog.recovered(l2), 2)
    test.eq_i64(c, rep, "and the torn seven bytes are discarded", alog.discarded(l2), 7)
    test.eq_i64(c, rep, "the next sequence follows the survivors", alog.next_seq(l2), 2)
    test.eq_i64(c, rep, "and the file is back to two whole records", alog.size_bytes(l2), 2 * 24)

    // **Appending after recovery must produce a readable log**, which is the property the
    // truncation buys: without it record 2 would land after seven bytes of garbage and every
    // future reader would stop at record 2.
    fill(pbuf, 4, 90)
    test.eq_i64(c, rep, "the next append is record 2", alog.append(l2, pbuf[0 .. 4]) catch 0 - 1, 2)
    alog.close(l2) catch nothing()

    var cu: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "record 0 reads", alog.next(cu, pbuf) as i64, 8)
    test.eq_i64(c, rep, "record 1 reads", alog.next(cu, pbuf) as i64, 8)
    test.eq_i64(c, rep, "and the record written after recovery reads", alog.next(cu, pbuf) as i64, 4)
    test.eq_i64(c, rep, "then a clean end", alog.next(cu, pbuf) as i64, 0 - 1)
    test.is_false(c, rep, "with no damage reported", alog.cursor_damaged(cu))
    alog.cursor_close(cu)

    scrub(h)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_corrupted_payload_is_caught_by_the_checksum() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var pb: *mut u8 = alloc(u8, 256)
    var pbuf: []u8 = slice(u8, pb, 256)
    var fb: *mut u8 = alloc(u8, 512)
    var fbuf: []u8 = slice(u8, fb, 512)

    // Two records, laid down by this file's own encoder. Record 1's checksum is deliberately
    // one off — bit rot, or a partial sector write that left the length and sequence intact.
    // The frame is structurally perfect: only the checksum can tell.
    var at: usize = 0
    at = put_frame(fbuf, at, 0, 20, 70 as u8, 0)
    at = put_frame(fbuf, at, 1, 20, 71 as u8, 1)
    lay_down(a, fbuf[0 .. at])

    var cu: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "record 0 is untouched", alog.next(cu, pbuf) as i64, 20)
    test.eq_i64(c, rep, "and its payload is what was written", pbuf[0] as i64, 70)
    test.eq_i64(c, rep, "record 1 is refused", alog.next(cu, pbuf) as i64, 0 - 1)
    // **Refused as DAMAGE, not as the end.** A caller replaying this log must be able to tell
    // that it stopped early, or a corrupted log replays as a shorter healthy one.
    test.is_true(c, rep, "and the cursor says it is damaged", alog.cursor_damaged(cu))
    test.eq_i64(c, rep, "having handed back only the good record", alog.cursor_count(cu), 1)
    alog.cursor_close(cu)

    // Recovery agrees with the reader: one good record, the rest discarded.
    var l2: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    test.eq_i64(c, rep, "recovery keeps the one good record", alog.recovered(l2), 1)
    test.eq_i64(c, rep, "and discards the corrupted one entirely", alog.discarded(l2), 36)
    alog.close(l2) catch nothing()

    // **The control that makes the assertions above about the CHECKSUM.** The identical two
    // records with a correct checksum both read. Without it this test would pass for a reader
    // that refused every second record.
    scrub(h)
    var at2: usize = 0
    at2 = put_frame(fbuf, at2, 0, 20, 70 as u8, 0)
    at2 = put_frame(fbuf, at2, 1, 20, 71 as u8, 0)
    lay_down(a, fbuf[0 .. at2])
    var cu2: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "with a correct checksum record 0 reads", alog.next(cu2, pbuf) as i64, 20)
    test.eq_i64(c, rep, "and so does record 1", alog.next(cu2, pbuf) as i64, 20)
    test.is_false(c, rep, "with no damage", alog.cursor_damaged(cu2))
    alog.cursor_close(cu2)

    free_ptr(fb)
    scrub(h)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_stale_record_that_lands_at_the_wrong_position_is_rejected() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var pb: *mut u8 = alloc(u8, 256)
    var pbuf: []u8 = slice(u8, pb, 256)
    var fb: *mut u8 = alloc(u8, 512)
    var fbuf: []u8 = slice(u8, fb, 512)

    // **The reset that leaves a survivor.** A log was rewound to one record and written again,
    // but the bytes beyond the new tail were never cleared — a crash during a compaction, or a
    // truncate that did not reach the disk. What follows record 0 is a record from the old
    // generation: it is numbered 9, because that is where it used to sit.
    //
    // Its checksum is CORRECT. It was a real record once.
    var at: usize = 0
    at = put_frame(fbuf, at, 0, 4, 1 as u8, 0)
    at = put_frame(fbuf, at, 9, 4, 2 as u8, 0)
    lay_down(a, fbuf[0 .. at])

    var cu: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "record 0 still reads", alog.next(cu, pbuf) as i64, 4)

    // **This is the assertion the sequence field exists for.** The bytes at this position are
    // a structurally perfect, correctly checksummed record — but it claims to be number 9
    // while the reader is owed number 1. A checksum-only reader has no way to notice, and
    // would hand a caller a record from a generation of the log that no longer exists.
    test.eq_i64(c, rep, "a record numbered for another position is refused",
        alog.next(cu, pbuf) as i64, 0 - 1)
    test.is_true(c, rep, "and it counts as damage", alog.cursor_damaged(cu))
    test.eq_i64(c, rep, "so only the one legitimate record was handed back", alog.cursor_count(cu), 1)
    alog.cursor_close(cu)

    // **The control, and it is the one that proves the CHECKSUM did not do this work.** The
    // same two records with the second numbered 1 instead of 9 both read — identical bytes
    // apart from the sequence field and its checksum.
    scrub(h)
    var at2: usize = 0
    at2 = put_frame(fbuf, at2, 0, 4, 1 as u8, 0)
    at2 = put_frame(fbuf, at2, 1, 4, 2 as u8, 0)
    lay_down(a, fbuf[0 .. at2])
    var cu2: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "correctly numbered, record 0 reads", alog.next(cu2, pbuf) as i64, 4)
    test.eq_i64(c, rep, "and record 1 reads too", alog.next(cu2, pbuf) as i64, 4)
    test.is_false(c, rep, "with no damage", alog.cursor_damaged(cu2))
    alog.cursor_close(cu2)

    free_ptr(fb)
    scrub(h)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// ---- refusals ---------------------------------------------------------------------

@test fn a_denied_capability_and_a_small_buffer_both_refuse_by_type() -> bool {
    var raw: *mut u8 = alloc(u8, A_T_CAP)
    var rep: []u8 = slice(u8, raw, A_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var pb: *mut u8 = alloc(u8, 256)
    var pbuf: []u8 = slice(u8, pb, 256)

    // A read-only capability may not open a log for append: `open` RECOVERS, which can
    // truncate, so it needs write permission even when the caller intends only to read.
    // Reading is `reader`, which takes the read capability.
    var ro: fs.Fs = fs.read_only()
    var l0: alog.Log = alog.open(ro, a, A_T_PATH) catch no_log()
    test.is_false(c, rep, "a read-only capability opens no log", alog.is_open(l0))

    var d: fs.Fs = fs.denied()
    var cu0: alog.Cursor = alog.reader(d, a, A_T_PATH) catch no_cur()
    test.is_false(c, rep, "and a denied one reads none", alog.cursor_is_open(cu0))

    // A closed log refuses rather than writing through a dead handle — the property that
    // makes `open(...) catch closed()` survivable.
    fill(pbuf, 4, 1)
    test.eq_i64(c, rep, "appending to a closed log refuses",
        alog.append(l0, pbuf[0 .. 4]) catch 0 - 99, 0 - 99)
    test.eq_i64(c, rep, "and reading from a closed cursor ends rather than crashing",
        alog.next(cu0, pbuf) as i64, 0 - 1)

    // **A record too big for the reader's buffer is DAMAGE, not a short read.** Handing back
    // 8 of 40 bytes with no way to know it is partial is exactly the silent truncation the
    // whole frame exists to prevent.
    var l: alog.Log = alog.open(h, a, A_T_PATH) catch no_log()
    fill(pbuf, 40, 77)
    alog.append(l, pbuf[0 .. 40]) catch 0 - 1
    alog.close(l) catch nothing()

    var small: *mut u8 = alloc(u8, 8)
    var smallbuf: []u8 = slice(u8, small, 8)
    var cu: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "a record that does not fit is refused", alog.next(cu, smallbuf) as i64, 0 - 1)
    test.is_true(c, rep, "and reported as damage rather than as an end", alog.cursor_damaged(cu))
    alog.cursor_close(cu)

    // The control: the same record through a big enough buffer reads fine, so the refusal
    // above is about the buffer and not about the record.
    var cu2: alog.Cursor = alog.reader(h, a, A_T_PATH) catch no_cur()
    test.eq_i64(c, rep, "the same record fits a larger buffer", alog.next(cu2, pbuf) as i64, 40)
    test.is_false(c, rep, "with no damage", alog.cursor_damaged(cu2))
    alog.cursor_close(cu2)

    free_ptr(small)
    scrub(h)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
