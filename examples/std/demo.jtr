// examples/std/demo.jtr — the standard library, end to end (items K + I).
//
// Pulls together four std modules — `mem` (allocator-as-value), `list` (a generic
// growable collection that takes an allocator), `core` (allocation-free helpers),
// and `io` (output) — into one multi-file program.
//
//   jestyrc run examples/std/demo.jtr
//   →   5            (length after 5 pushes; one growth happened at cap 4→8)
//       10           (first element)
//       50           (last element)
//       40           (core.imax of elements 2 and 3)

import "mem"
import "list"
import "core"
import "io"

fn main() -> i32 {
    // The allocator is a value. `list` never names a concrete strategy — it just
    // takes whatever allocator we hand it.
    var gpa: Allocator = mem.system_allocator()

    var xs = list.make(i32)
    list.push(i32, xs, gpa, 10)
    list.push(i32, xs, gpa, 20)
    list.push(i32, xs, gpa, 30)
    list.push(i32, xs, gpa, 40)
    list.push(i32, xs, gpa, 50)   // 5th push grows the buffer from cap 4 → 8

    io.print_i32(list.len(i32, xs))          // 5
    io.print_i32(list.get(i32, xs, 0))       // 10
    io.print_i32(list.get(i32, xs, 4))       // 50
    io.print_i32(core.imax(list.get(i32, xs, 2), list.get(i32, xs, 3)))  // 40

    list.free(i32, xs, gpa)
    return 0
}
