// examples/std/demo.jtr — the standard library, end to end (items K + I, Phase 3).
//
// Pulls together four std modules — `mem` (the fn-pointer-vtable allocator), `list`
// (a generic growable collection that stores its allocator and frees by RAII),
// `core` (allocation-free helpers), and `io` (output) — into one multi-file program.
//
//   jestyrc run examples/std/demo.jtr
//   →   5            (length after 5 pushes; one growth happened at cap 4->8)
//       10           (first element)
//       50           (last element)
//       40           (core.imax of elements 2 and 3)
//   The list's buffer is freed automatically when `xs` leaves scope (RAII).

import "mem"
import "list"
import "core"
import "io"

fn main() -> i32 {
    // The allocator is a value with a real vtable. `list` never names a concrete
    // strategy — it just takes whatever allocator we hand it, and stores it.
    var gpa: Allocator = mem.system_allocator()

    var xs = list.make(i32, gpa)
    list.push(i32, xs, 10)
    list.push(i32, xs, 20)
    list.push(i32, xs, 30)
    list.push(i32, xs, 40)
    list.push(i32, xs, 50)   // 5th push grows the buffer from cap 4 -> 8

    io.print_i32(list.len(i32, xs) as i32)   // 5 — `len` is a `usize`; narrowing is explicit
    io.print_i32(list.get(i32, xs, 0))       // 10
    io.print_i32(list.get(i32, xs, 4))       // 50
    io.print_i32(core.imax(list.get(i32, xs, 2), list.get(i32, xs, 3)))  // 40

    return 0   // `xs` drops here — its buffer is freed through the stored allocator
}
