// examples/std/jagent_bench.jtr — what `jagent`'s operations cost, measured rather than
// guessed.
//
//   jestyrc run examples/std/jagent_bench.jtr
//
// Not a test: it prints numbers and exits 0. The numbers are recorded in `docs/jagent.md`
// with the machine they came from; this file is how to get new ones. Each measurement is
// a loop over the real path — a real child through the shell, a real store on disk, a real
// socket — timed on `time.host()`, so a slow machine prints slow numbers rather than
// failing.
//
// What is measured, and what is not:
//
//   * a configuration load (`load_text`, ten jobs, the two-pass scan plus `std/ini`)
//   * a trivial command job (`exit 0`) end to end: start, drain, reap, sweep, record
//   * the history write on its own: one `std/kv` batch of the three keys a run writes,
//     with a record the size a run produces — the cost `run_job` pays over the child
//   * `GET /health` over loopback, on a fresh connection each time and on one kept alive
//   * storage growth: the store file's size after N recorded entries, and the bytes per entry
//   * resource cleanup after repeated runs: every child released and every group emptied,
//     asserted by the spawner's counter and `tree_reaped` — process memory is NOT measured
//     here, because nothing in the language reads it; `docs/jagent.md` says how it was
//     observed by hand
//
// The bench does not pass or fail on a number: the tree has no established threshold
// harness for wall-clock figures, and a threshold that flakes on a loaded runner would be
// worse than a number a reader compares against the recorded one.

import "fs"
import "http"
import "httpc"
import "httpd"
import "jagent"
import "jagent_ops"
import "kv"
import "log"
import "mem"
import "runtime"
import "str"
import "sysfs"
import "sysnet"
import "syspoll"
import "sysproc"
import "time"
import "writer"

const JB_ROOT: str = "zz_jagent_bench"
const JB_STORE: str = "zz_jagent_bench/history.db"
const JB_GROWTH: str = "zz_jagent_bench/growth.db"
const JB_STARTER: str = "zz_jagent_bench/starter.ini"
const JB_DOCTOR: str = "zz_jagent_bench/doctor.ini"
const JB_OPS: str = "zz_jagent_bench/ops.db"
const JB_CAP: usize = 16384

fn nothing() { }

fn quiet_logger() -> log.Logger {
    return log.make(time.manual(0), writer.to_buffer(), log.LOG_INFO, log.LOG_LOGFMT)
}

fn scrub(mut h: fs.Fs, read a: Allocator) {
    fs.erase(h, JB_STORE)
    fs.erase(h, JB_GROWTH)
    fs.erase(h, JB_STARTER)
    fs.erase(h, JB_DOCTOR)
    fs.erase(h, JB_OPS)
    fs.erase(h, "zz_jagent_bench/growth.db.compact")
    let gone: bool = sysfs.remove_dir(h, a, JB_ROOT) catch false
}

fn push_num(mut s: String, v: i64) {
    if v < 0 {
        string_push(s, "-")
        push_num(s, 0 - v)
        return
    }
    if v >= 10 { push_num(s, v / 10) }
    let d: i64 = v % 10
    if d == 0 { string_push(s, "0") }
    if d == 1 { string_push(s, "1") }
    if d == 2 { string_push(s, "2") }
    if d == 3 { string_push(s, "3") }
    if d == 4 { string_push(s, "4") }
    if d == 5 { string_push(s, "5") }
    if d == 6 { string_push(s, "6") }
    if d == 7 { string_push(s, "7") }
    if d == 8 { string_push(s, "8") }
    if d == 9 { string_push(s, "9") }
}

// `label: <per> <unit> per op over <n> ops (<total> ms total)`
fn report(read label: str, n: i64, total_ns: i64, read unit: str, div: i64) {
    var s: String = string_new()
    string_push(s, label)
    string_push(s, ": ")
    push_num(s, total_ns / n / div)
    string_push(s, " ")
    string_push(s, unit)
    string_push(s, " per op over ")
    push_num(s, n)
    string_push(s, " ops (")
    push_num(s, total_ns / 1000000)
    string_push(s, " ms total)")
    print_str(string_view(s))
    string_free(s)
}

fn ten_jobs(mut dst: String) {
    string_push(dst, "[agent]\nstore = zz_jagent_bench/history.db\n")
    var i: i64 = 0
    for i < 10 {
        string_push(dst, "[job.j")
        push_num(dst, i)
        string_push(dst, "]\ncommand = echo job ")
        push_num(dst, i)
        string_push(dst, "\ntimeout_ms = 1000\n")
        i = i + 1
    }
}

fn file_size(read a: Allocator, mut h: fs.Fs, read p: str) -> i64 {
    let m: sysfs.Meta = sysfs.metadata(h, a, p) catch sysfs.missing()
    return m.bytes as i64
}

fn answered(read cl: httpc.Client, ms: i64) -> bool {
    if httpc.pending(cl) > 0 { return true }
    var p: runtime.Poller = syspoll.host()
    var fds: *mut i64 = alloc(i64, 1)
    var rdy: *mut u8 = alloc(u8, 1)
    unsafe { (fds + 0).* = httpc.fd(cl) }
    unsafe { (rdy + 0).* = 0 as u8 }
    let got: i64 = runtime.ask(p, fds, rdy, 1, ms * 1000000)
    var r: u8 = 0
    unsafe { r = (rdy + 0).* }
    free_ptr(rdy)
    free_ptr(fds)
    if got <= 0 { return false }
    return (r as i32) != 0
}

fn main() -> i32 {
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h, a)
    let made: bool = sysfs.make_dir(h, a, JB_ROOT) catch false
    var clk: time.Clock = time.host()
    var sp: sysproc.Spawner = sysproc.host()

    print_str("-- jagent bench --")

    // ---- configuration load ----
    var cfg: String = string_new()
    ten_jobs(cfg)
    var ag: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    let n_load: i64 = 200
    let t0: i64 = time.read_nanos(clk)
    var i: i64 = 0
    for i < n_load {
        // Alternate two texts so no load is answered `same`.
        if i % 2 == 0 {
            jagent.load_text(ag, "bench.ini", string_view(cfg))
        } else {
            jagent.load_text(ag, "bench.ini", "[agent]\nstore = zz_jagent_bench/history.db\n[job.only]\ncommand = echo one\n")
        }
        i = i + 1
    }
    report("config load, ten jobs", n_load, time.read_nanos(clk) - t0, "us", 1000)
    jagent.load_text(ag, "bench.ini", "[agent]\nstore = zz_jagent_bench/history.db\n[job.trivial]\ncommand = exit 0\ntimeout_ms = 5000\n")
    jagent.open_store(ag, h)

    // ---- a trivial job, end to end ----
    let n_run: i64 = 20
    let t1: i64 = time.read_nanos(clk)
    var reaped: i64 = 0
    i = 0
    for i < n_run {
        let r: jagent.Run = jagent.run_job(ag, sp, clk, "trivial")
        if r.tree_reaped { reaped = reaped + 1 }
        i = i + 1
    }
    report("trivial command job (exit 0), recorded", n_run, time.read_nanos(clk) - t1, "ms", 1000000)
    var s: String = string_new()
    string_push(s, "children started, trees confirmed reaped: ")
    push_num(s, sysproc.started(sp))
    string_push(s, ", ")
    push_num(s, reaped)
    print_str(string_view(s))
    string_free(s)

    // ---- the history write on its own ----
    //
    // The same three keys a run writes, with a record of the size a run produces, into a
    // fresh store: this is what `run_job` pays over the child.
    var store: kv.Store = kv.closed()
    kv.open(h, a, JB_GROWTH, store) catch nothing()
    let rec: str = "{\"seq\":1,\"job\":\"health-check\",\"status\":\"success\",\"code\":0,\"started_at\":1700000000,\"duration_ms\":12,\"out_bytes\":9,\"output\":\"healthy\\r\\n\",\"error\":\"\"}"
    let n_rec: i64 = 1000
    let t2: i64 = time.read_nanos(clk)
    i = 0
    for i < n_rec {
        var key: String = string_new()
        string_push(key, "run:")
        push_num(key, 1000000 + i)
        var seqv: String = string_new()
        push_num(seqv, i + 1)
        var b: kv.Batch = kv.batch()
        kv.batch_put(b, string_view(key), rec)
        kv.batch_put(b, "last:health-check", string_view(key))
        kv.batch_put(b, "seq", string_view(seqv))
        kv.commit(store, b) catch nothing()
        // Synced per entry, as `run_job` does: `recorded` means the bytes reached the disk.
        kv.sync(store) catch nothing()
        string_free(seqv)
        string_free(key)
        i = i + 1
    }
    let t_rec: i64 = time.read_nanos(clk) - t2
    report("history entry (one kv batch of three keys, synced)", n_rec, t_rec, "us", 1000)
    let grown: i64 = file_size(a, h, JB_GROWTH)
    var g: String = string_new()
    string_push(g, "storage after ")
    push_num(g, n_rec)
    string_push(g, " entries: ")
    push_num(g, grown)
    string_push(g, " bytes, ")
    push_num(g, grown / n_rec)
    string_push(g, " bytes per entry (record + pointer + counter, framed); live bytes ")
    push_num(g, kv.live_bytes(store))
    string_push(g, ", dead bytes ")
    push_num(g, kv.dead_bytes(store))
    print_str(string_view(g))
    string_free(g)
    let compacted: i64 = kv.compact(h, a, store) catch 0 - 1
    var g2: String = string_new()
    string_push(g2, "after compaction: ")
    push_num(g2, file_size(a, h, JB_GROWTH))
    string_push(g2, " bytes for ")
    push_num(g2, compacted)
    string_push(g2, " live keys")
    print_str(string_view(g2))
    string_free(g2)
    kv.close(store)

    // ---- GET /health over loopback ----
    var cell: *mut jagent.Agent = alloc(jagent.Agent, 1)
    unsafe { (cell + 0).* = ag }
    var ctx: *mut jagent.Serve = jagent.serve_ctx(cell, sysproc.host(), time.host())
    var net: sysnet.Net = sysnet.host()
    var sv: httpd.Server = httpd.make(a, time.host(), quiet_logger(), false, 4, 8192)
    httpd.start(sv, net, sysnet.loopback(0), 8)
    jagent.install(sv, ctx)
    let addr: sysnet.SocketAddr = sysnet.loopback(httpd.port(sv))

    let n_http: i64 = 100
    var ok_fresh: i64 = 0
    let t3: i64 = time.read_nanos(clk)
    i = 0
    for i < n_http {
        var cl: httpc.Client = httpc.dial(net, addr, JB_CAP)
        httpc.request(cl, "GET", "/health", "", "")
        httpd.serve_for(sv, net, 0)
        var rounds: i64 = 0
        for answered(cl, 0) == false and rounds < 1000 {
            httpd.serve_for(sv, net, 1)
            rounds = rounds + 1
        }
        if httpc.read_response(cl) == http.HTTP_OK {
            if httpc.status(cl) == 200 { ok_fresh = ok_fresh + 1 }
        }
        httpc.hangup(cl)
        httpd.serve_for(sv, net, 0)
        i = i + 1
    }
    report("GET /health, a fresh connection each time", n_http, time.read_nanos(clk) - t3, "us", 1000)

    var ok_keep: i64 = 0
    var cl2: httpc.Client = httpc.dial(net, addr, JB_CAP)
    let t4: i64 = time.read_nanos(clk)
    i = 0
    for i < n_http {
        httpc.request(cl2, "GET", "/health", "", "")
        var rounds2: i64 = 0
        for answered(cl2, 0) == false and rounds2 < 1000 {
            httpd.serve_for(sv, net, 1)
            rounds2 = rounds2 + 1
        }
        if httpc.read_response(cl2) == http.HTTP_OK {
            if httpc.status(cl2) == 200 { ok_keep = ok_keep + 1 }
        }
        i = i + 1
    }
    report("GET /health, one kept-alive connection", n_http, time.read_nanos(clk) - t4, "us", 1000)
    httpc.hangup(cl2)
    var okl: String = string_new()
    string_push(okl, "200s received: ")
    push_num(okl, ok_fresh)
    string_push(okl, " fresh, ")
    push_num(okl, ok_keep)
    string_push(okl, " kept-alive")
    print_str(string_view(okl))
    string_free(okl)

    httpd.stop(sv, net)
    httpd.free(sv)
    sysnet.shutdown(net)
    var back: jagent.Agent = unsafe { (cell + 0).* }
    jagent.free(back)
    jagent.free_serve(ctx)
    free_ptr(cell as *mut u8)

    // ---- the operator's layer (std/jagent_ops) ----
    print_str("-- jagent_ops --")

    // `init`: the starter written, forced, over the same path.
    let n_init: i64 = 200
    let t5: i64 = time.read_nanos(clk)
    i = 0
    for i < n_init {
        jagent_ops.init(h, JB_STARTER, true)
        i = i + 1
    }
    report("init (the starter written, forced)", n_init, time.read_nanos(clk) - t5, "us", 1000)

    // Discovery with nothing to find: the three steps, the last a stat.
    let n_disc: i64 = 10000
    let t6: i64 = time.read_nanos(clk)
    i = 0
    for i < n_disc {
        var p: String = string_new()
        jagent_ops.discover(h, "", "", p)
        string_free(p)
        i = i + 1
    }
    report("config discovery (no flag, no env, no jagent.ini)", n_disc, time.read_nanos(clk) - t6, "us", 1000)

    // `config validate` on a large file: the two-pass load, a hundred jobs.
    var big: String = string_new()
    many_jobs(big, 100, JB_STORE)
    var va: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    let n_val: i64 = 50
    let t7: i64 = time.read_nanos(clk)
    i = 0
    for i < n_val {
        if i % 2 == 0 {
            jagent.load_text(va, "big.ini", string_view(big))
        } else {
            jagent.load_text(va, "big.ini", "[agent]\nstore = zz_jagent_bench/history.db\n[job.only]\ncommand = echo one\n")
        }
        i = i + 1
    }
    report("config validate, 100 jobs (load_text)", n_val, time.read_nanos(clk) - t7, "us", 1000)
    jagent.free(va)

    // `doctor`: without the process probes (load, store open + sync, bind + release,
    // watch open + close) and with them (+ a child that prints, + a child that is timed out).
    fs.put(h, JB_DOCTOR, string_view(cfg))
    let n_doc: i64 = 5
    let t8: i64 = time.read_nanos(clk)
    i = 0
    for i < n_doc {
        var r1: jagent_ops.Report = jagent_ops.doctor(a, h, sp, clk, JB_DOCTOR, false)
        i = i + 1
    }
    report("doctor --no-probes (load, store open+sync, bind+release, watch)", n_doc, time.read_nanos(clk) - t8, "ms", 1000000)
    let n_doc2: i64 = 3
    let t9: i64 = time.read_nanos(clk)
    i = 0
    for i < n_doc2 {
        var r2: jagent_ops.Report = jagent_ops.doctor(a, h, sp, clk, JB_DOCTOR, true)
        i = i + 1
    }
    report("doctor with probes (+ a child, + a timed-out child and its tree)", n_doc2, time.read_nanos(clk) - t9, "ms", 1000000)

    // A synthetic history — fifty jobs, a thousand records in the agent's own key shape —
    // for what the summary and the status cost over a store of some size. Written with
    // `std/kv` directly (a thousand real runs would be a minute of `cmd.exe`).
    var ops_cfg: String = string_new()
    many_jobs(ops_cfg, 50, JB_OPS)
    var st2: kv.Store = kv.closed()
    kv.open(h, a, JB_OPS, st2) catch nothing()
    let n_hist: i64 = 1000
    i = 0
    for i < n_hist {
        let seq: i64 = i + 1
        let j: i64 = i % 50
        var key: String = string_new()
        string_push(key, "run:")
        push_padded(key, seq)
        var lastk: String = string_new()
        string_push(lastk, "last:j")
        push_num(lastk, j)
        var seqp: String = string_new()
        push_padded(seqp, seq)
        var seqv: String = string_new()
        push_num(seqv, seq)
        var rec2: String = string_new()
        string_push(rec2, "{\"seq\":")
        push_num(rec2, seq)
        string_push(rec2, ",\"job\":\"j")
        push_num(rec2, j)
        if i % 3 == 0 {
            string_push(rec2, "\",\"status\":\"failure\",\"code\":1,")
        } else {
            string_push(rec2, "\",\"status\":\"success\",\"code\":0,")
        }
        string_push(rec2, "\"started_at\":1700000000,\"duration_ms\":12,\"out_bytes\":9,\"output\":\"healthy\\r\\n\",\"error\":\"")
        if i % 3 == 0 { string_push(rec2, "exit code 1") }
        string_push(rec2, "\"}")
        var b2: kv.Batch = kv.batch()
        kv.batch_put(b2, string_view(key), string_view(rec2))
        kv.batch_put(b2, string_view(lastk), string_view(seqp))
        kv.batch_put(b2, "seq", string_view(seqv))
        kv.commit(st2, b2) catch nothing()
        string_free(rec2)
        string_free(seqv)
        string_free(seqp)
        string_free(lastk)
        string_free(key)
        i = i + 1
    }
    kv.sync(st2) catch nothing()
    kv.close(st2)

    var oa: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    jagent.load_text(oa, "ops.ini", string_view(ops_cfg))
    let t10: i64 = time.read_nanos(clk)
    jagent.open_store(oa, h)
    report("history open, 1000 records over 50 jobs (the store replayed)", 1, time.read_nanos(clk) - t10, "us", 1000)
    let n_ask: i64 = 100
    let t11: i64 = time.read_nanos(clk)
    i = 0
    for i < n_ask {
        var ans: String = string_new()
        jagent_ops.ask(oa, h, a, "check my machine", ans)
        string_free(ans)
        i = i + 1
    }
    report("ask \"check my machine\", 50 jobs over 1000 records", n_ask, time.read_nanos(clk) - t11, "us", 1000)
    let t12: i64 = time.read_nanos(clk)
    i = 0
    for i < n_ask {
        var stt: String = string_new()
        jagent.render_status(oa, stt)
        string_free(stt)
        i = i + 1
    }
    report("status render, 50 jobs with their last runs", n_ask, time.read_nanos(clk) - t12, "us", 1000)
    let t13: i64 = time.read_nanos(clk)
    i = 0
    for i < n_ask {
        var lg: String = string_new()
        jagent.render_logs(oa, "j7", 20, lg)
        string_free(lg)
        i = i + 1
    }
    report("logs of one job, filtered from 1000 records", n_ask, time.read_nanos(clk) - t13, "us", 1000)
    let t14: i64 = time.read_nanos(clk)
    i = 0
    for i < n_ask {
        var ans2: String = string_new()
        jagent_ops.ask(oa, h, a, "what failed", ans2)
        string_free(ans2)
        i = i + 1
    }
    report("ask \"what failed\", 50 jobs over 1000 records (last pointers)", n_ask, time.read_nanos(clk) - t14, "us", 1000)
    let t15: i64 = time.read_nanos(clk)
    i = 0
    for i < n_ask {
        var ans3: String = string_new()
        jagent_ops.ask(oa, h, a, "what is risky", ans3)
        string_free(ans3)
        i = i + 1
    }
    report("ask \"what is risky\", 50 jobs over 1000 records (the risk rules)", n_ask, time.read_nanos(clk) - t15, "us", 1000)
    let t16: i64 = time.read_nanos(clk)
    i = 0
    for i < 10 {
        var ans4: String = string_new()
        jagent_ops.ask(oa, h, a, "what failed recently", ans4)
        string_free(ans4)
        i = i + 1
    }
    report("ask \"what failed recently\" (the last 20 of 1000 records rendered and filtered)", 10, time.read_nanos(clk) - t16, "us", 1000)
    jagent.free(oa)
    string_free(ops_cfg)
    string_free(big)

    // ---- v3: the http-check, the token's cost, a group, retention ----
    print_str("-- v3 --")
    // An http-check against this process's own plaintext server, driven between checks
    // from a spawned thread's point of view... which this single-threaded bench cannot do
    // for a BLOCKING client. So the check's cost is measured against `std/httpd` served
    // by a second agent on the same thread? No: `run_job` blocks in `read_response`. The
    // honest measurement here is the CHEAP half — the URL parse and the connect refusal
    // — and the docs quote the suite's round trip for the rest.
    var hc: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    jagent.load_text(hc, "hc.ini", "[job.down]\nkind = http-check\nurl = http://127.0.0.1:1/health\ntimeout_ms = 1000\n")
    let n_hc: i64 = 20
    let t17: i64 = time.read_nanos(clk)
    i = 0
    for i < n_hc {
        jagent.run_job(hc, sp, clk, "down")
        i = i + 1
    }
    report("http-check, connection refused (parse + dial + refusal), unrecorded", n_hc, time.read_nanos(clk) - t17, "us", 1000)
    jagent.free(hc)

    // The token gate: `/health` with and without a configured token, same server, kept alive.
    var ta: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    jagent.load_text(ta, "t.ini", "[agent]\ntoken = s3cret-token\nstore = zz_jagent_bench/history.db\n[job.only]\ncommand = echo one\n")
    var tcell: *mut jagent.Agent = alloc(jagent.Agent, 1)
    unsafe { (tcell + 0).* = ta }
    var tctx: *mut jagent.Serve = jagent.serve_ctx(tcell, sysproc.host(), time.host())
    var tnet: sysnet.Net = sysnet.host()
    var tsv: httpd.Server = httpd.make(a, time.host(), quiet_logger(), false, 4, 8192)
    httpd.start(tsv, tnet, sysnet.loopback(0), 8)
    jagent.install(tsv, tctx)
    let taddr: sysnet.SocketAddr = sysnet.loopback(httpd.port(tsv))
    var tcl: httpc.Client = httpc.dial(tnet, taddr, JB_CAP)
    let t18: i64 = time.read_nanos(clk)
    i = 0
    for i < n_http {
        httpc.request(tcl, "GET", "/jobs", "Authorization: Bearer s3cret-token\r\n", "")
        var rounds3: i64 = 0
        for answered(tcl, 0) == false and rounds3 < 1000 {
            httpd.serve_for(tsv, tnet, 1)
            rounds3 = rounds3 + 1
        }
        httpc.read_response(tcl)
        i = i + 1
    }
    report("GET /jobs with the bearer token (constant-time compare + routing), kept-alive", n_http, time.read_nanos(clk) - t18, "us", 1000)
    let t19: i64 = time.read_nanos(clk)
    i = 0
    for i < n_http {
        httpc.request(tcl, "GET", "/jobs", "", "")
        var rounds4: i64 = 0
        for answered(tcl, 0) == false and rounds4 < 1000 {
            httpd.serve_for(tsv, tnet, 1)
            rounds4 = rounds4 + 1
        }
        httpc.read_response(tcl)
        i = i + 1
    }
    report("GET /jobs refused 401 (no token), kept-alive", n_http, time.read_nanos(clk) - t19, "us", 1000)
    httpc.hangup(tcl)
    httpd.stop(tsv, tnet)
    httpd.free(tsv)
    sysnet.shutdown(tnet)
    var tback: jagent.Agent = unsafe { (tcell + 0).* }
    jagent.free(tback)
    jagent.free_serve(tctx)
    free_ptr(tcell as *mut u8)

    // A group of five trivial jobs, and retention over a store kept at fifty runs.
    var ga: jagent.Agent = jagent.make(a, time.host(), quiet_logger())
    jagent.load_text(ga, "g.ini", "[agent]\nstore = zz_jagent_bench/group.db\nhistory_max_runs = 50\ncompact_after_dead_bytes = 4096\n[job.a]\ncommand = exit 0\n[job.b]\ncommand = exit 0\n[job.c]\ncommand = exit 0\n[job.d]\ncommand = exit 0\n[job.e]\ncommand = exit 0\n[group.five]\njobs = a, b, c, d, e\n")
    jagent.open_store(ga, h)
    let t20: i64 = time.read_nanos(clk)
    var gs: String = string_new()
    jagent.run_group(ga, sp, clk, "five", gs)
    string_free(gs)
    report("run group of five trivial command jobs (five runs, five records)", 5, time.read_nanos(clk) - t20, "ms", 1000000)
    // Fill past the bound, then measure what `maintain` costs when it prunes and compacts.
    i = 0
    for i < 12 {
        var gs2: String = string_new()
        jagent.run_group(ga, sp, clk, "five", gs2)
        string_free(gs2)
        i = i + 1
    }
    let t21: i64 = time.read_nanos(clk)
    let mt: jagent.Maint = jagent.maintain(ga, h)
    let t_m: i64 = time.read_nanos(clk) - t21
    var ms: String = string_new()
    string_push(ms, "maintain over 65 runs with max=50: pruned=")
    push_num(ms, mt.pruned)
    string_push(ms, " compacted=")
    if mt.compacted { string_push(ms, "true") } else { string_push(ms, "false") }
    string_push(ms, " reclaimed=")
    push_num(ms, mt.reclaimed)
    string_push(ms, " bytes in ")
    push_num(ms, t_m / 1000)
    string_push(ms, " us; runs now ")
    push_num(ms, jagent.history_runs(ga))
    print_str(string_view(ms))
    string_free(ms)
    let t22: i64 = time.read_nanos(clk)
    i = 0
    for i < 100 {
        jagent.maintain(ga, h)
        i = i + 1
    }
    report("maintain with nothing to do (the check every serve round pays)", 100, time.read_nanos(clk) - t22, "us", 1000)
    jagent.free(ga)
    fs.erase(h, "zz_jagent_bench/group.db")
    fs.erase(h, "zz_jagent_bench/group.db.compact")

    string_free(cfg)
    scrub(h, a)
    return 0
}

// `[agent]` plus `n` echo jobs `j0..`, the store at `store`.
fn many_jobs(mut dst: String, n: i64, read store: str) {
    string_push(dst, "[agent]\nstore = ")
    string_push(dst, store)
    string_push(dst, "\n")
    var i: i64 = 0
    for i < n {
        string_push(dst, "[job.j")
        push_num(dst, i)
        string_push(dst, "]\ncommand = echo job ")
        push_num(dst, i)
        string_push(dst, "\ntimeout_ms = 10000\n")
        i = i + 1
    }
}

// The agent's own sequence spelling: twelve digits, zero-padded.
fn push_padded(mut dst: String, v: i64) {
    var digits: i64 = 1
    var t: i64 = v
    for t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var pad: i64 = 12 - digits
    for pad > 0 {
        string_push(dst, "0")
        pad = pad - 1
    }
    push_num(dst, v)
}
