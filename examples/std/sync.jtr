// std/sync.jtr — concurrency synchronization primitives (workstream N).
//
// `Mutex(T)` is an Ada-style PROTECTED OBJECT: the guarded value, its lock, and
// the operations that touch the value are one unit. The only way to reach the
// value is through `mutex_with`/`mutex_get`, each of which brackets the access
// between a lock acquire and release — so a caller *cannot forget to lock*. Mutual
// exclusion is structural, not a convention you have to remember.
//
// The lock is a test-and-set SPINLOCK over a single atomic `int64` cell (the
// `atomic_xchg` intrinsic): the whole primitive is library code over the existing
// atomics — no OS mutex, no special type, fully portable. Combined with the
// structured `concurrent { … }` scope (which joins every task before the value is
// freed), a Mutex can't be used after free either.
//
//   N threads each incrementing the guarded counter through `mutex_with` see no
//   lost updates: the final value is *exactly* N (see examples/std/mutex.jtr).

// Acquire `lock`: atomically swap in 1 and read the previous value. If it was 0
// the lock was free and is now ours; otherwise another task holds it, so spin
// until a release stores 0 back. Test-and-set is the minimal mutual-exclusion
// atom — one indivisible read-modify-write.
pub fn lock_acquire(lock: *mut i64) {
    var held: i64 = atomic_xchg(lock, 1)
    for held != 0 {
        held = atomic_xchg(lock, 1)
    }
}

// Release `lock`: a single seq-cst store of 0. The release publishes every write
// made while the lock was held to whichever task acquires it next.
pub fn lock_release(lock: *mut i64) {
    atomic_store(lock, 0)
}

// The protected object. The guarded value lives on the heap (`data`) paired with
// its lock word (`lock`); every task that holds a copy of the Mutex shares those
// same two cells. The pointers alias deliberately — that *is* the shared state —
// and all access to it is serialized by the lock.
pub fn Mutex(comptime T: type) -> type {
    return struct {
        data: *mut T,
        lock: *mut i64,
    }
}

// Read a cell behind a raw pointer (the one unsafe step, localized here so the
// public operations stay safe). Always called while the lock is held.
fn load_cell(comptime T: type, p: *mut T) -> T { unsafe { return (p + 0).* } }

// Create a Mutex guarding `init`: allocate the value cell and the lock cell
// (initialized unlocked, i.e. 0).
pub fn mutex_make(comptime T: type, init: T) -> Mutex(T) {
    var d: *mut T = alloc(T, 1)
    unsafe { d.* = init }
    var l: *mut i64 = alloc(i64, 1)
    atomic_store(l, 0)
    return Mutex(T){ data: d, lock: l }
}

// The protected procedure: run `op` with EXCLUSIVE access to the guarded value.
// Acquire the lock, hand `op` a `*mut T` to the value, release. `op` is the only
// code that sees the value, and it always runs under the lock — there is no path
// that mutates the value without holding it.
pub fn mutex_with(comptime T: type, read m: Mutex(T), op: fn(*mut T)) {
    lock_acquire(m.lock)
    op(m.data)
    lock_release(m.lock)
}

// The protected function: a locked snapshot of the guarded value (read under the
// lock, return a copy).
pub fn mutex_get(comptime T: type, read m: Mutex(T)) -> T {
    lock_acquire(m.lock)
    let v: T = load_cell(T, m.data)
    lock_release(m.lock)
    return v
}

// Release the Mutex's heap cells. Call once, after every task sharing it has
// joined — the `concurrent { … }` scope guarantees that at its closing brace.
pub fn mutex_free(comptime T: type, read m: Mutex(T)) {
    free_ptr(m.data)
    free_ptr(m.lock)
}

// ── Channels: move-only message passing (share by communicating) ──────────────
//
// `Channel(T)` is a bounded ring buffer guarded by the same spinlock. The headline
// is its `send`: it takes the value by `take`, so OWNERSHIP MOVES INTO the channel
// and no alias survives in the sender. Race-freedom then falls out of the existing
// escape analysis with no `Send`/`Sync` marker traits and no runtime detector — the
// give-away rule already forbids handing a *borrow* to a `take` parameter, so you
// can only send something you own, and once sent it is the receiver's. This is the
// Erlang/Pony share-nothing model expressed through Jestyr's second-class refs (a
// uniquely-owned `take` value ≈ Pony `iso`); combined with `concurrent { … }`, a
// message can't be touched by its sender after it leaves.
//
// The control word packs the five shared counters into one `[5]i64` cell so a
// channel handle is two heap allocations (buffer + control), copied by value into
// each task — every copy shares the same buffer, indices, lock and closed flag.

pub fn Channel(comptime T: type) -> type {
    return struct {
        buf:  *mut T,    // `cap` slots, used as a ring
        ctrl: *mut i64,  // [0]=head [1]=tail [2]=count [3]=lock [4]=closed
        cap:  i64,
    }
}

// Make a channel that can buffer `cap` in-flight values (cap ≥ 1).
pub fn channel_make(comptime T: type, cap: i64) -> Channel(T) {
    var b: *mut T = alloc(T, cap as usize)
    var c: *mut i64 = alloc(i64, 5)
    unsafe { atomic_store(c + 0, 0) }   // head   — next recv slot
    unsafe { atomic_store(c + 1, 0) }   // tail   — next send slot
    unsafe { atomic_store(c + 2, 0) }   // count  — buffered items
    unsafe { atomic_store(c + 3, 0) }   // lock   — unlocked
    unsafe { atomic_store(c + 4, 0) }   // closed — still open
    return Channel(T){ buf: b, ctrl: c, cap: cap }
}

// Send `v` by move. Blocks (spins) until the buffer has room, then writes the
// value under the lock and advances the tail. After this call the sender no longer
// owns `v` — using it would be a use-after-move; passing a *borrow* here is a
// compile error (the give-away rule). Bounded capacity gives natural backpressure.
pub fn channel_send(comptime T: type, read ch: Channel(T), take v: T) {
    var sent: bool = false
    for !sent {
        unsafe { lock_acquire(ch.ctrl + 3) }
        let count: i64 = unsafe { atomic_load(ch.ctrl + 2) }
        if count < ch.cap {
            let tail: i64 = unsafe { atomic_load(ch.ctrl + 1) }
            unsafe { (ch.buf + (tail as usize)).* = v }   // ownership moves into the buffer
            unsafe { atomic_store(ch.ctrl + 1, (tail + 1) % ch.cap) }
            unsafe { atomic_store(ch.ctrl + 2, count + 1) }
            sent = true
        }
        unsafe { lock_release(ch.ctrl + 3) }
    }
}

// `channel_try_send` outcomes.
pub const CH_SENT: i32 = 0
pub const CH_CLOSED: i32 = 1
pub const CH_FULL: i32 = 2

// Offer `v` without blocking, and **hand it back if it cannot be taken**.
//
// ─── Why this is not just `channel_send` returning a bool ──────────────────────────
//
// `send` takes `v` by `take`, so by the time a refusal is known the callee ALREADY OWNS
// the value. Returning `false` there would leak it for any `T` whose teardown matters —
// the caller's binding was consumed at the call and there is nothing left to drop. A
// correct refusal has to give ownership back, which is what `back` is for: on
// `CH_CLOSED` or `CH_FULL` the value is written there and the caller owns it again; on
// `CH_SENT` it moved into the buffer and `back` is untouched.
//
// That is the whole reason `channel_send` was left alone rather than made fallible. Its
// signature cannot express the give-back, and changing it would break the `select`
// lowering, which calls the monomorphic wrappers by their C names.
//
// ─── CLOSED and FULL are different answers ─────────────────────────────────────────
//
// A caller retries on FULL and gives up on CLOSED, and collapsing them into one `false`
// makes a shutdown indistinguishable from backpressure — a producer would spin forever
// against a closed channel believing it was merely busy.
//
// ─── Who may close ─────────────────────────────────────────────────────────────────
//
// **The producer owns the close**, and in the ordinary one-producer shape nothing else
// closes, so `channel_send` after `channel_close` is a programmer error of the same
// class as a use-after-free rather than something to check for. `try_send` exists for
// the cases where that does not hold: several producers, or a shutdown triggered from
// outside the producer.
pub fn channel_try_send(comptime T: type, read ch: Channel(T), take v: T, back: *mut T) -> i32 {
    var outcome: i32 = CH_FULL
    unsafe { lock_acquire(ch.ctrl + 3) }
    let closed: i64 = unsafe { atomic_load(ch.ctrl + 4) }
    if closed != 0 {
        outcome = CH_CLOSED
    } else {
        let count: i64 = unsafe { atomic_load(ch.ctrl + 2) }
        if count < ch.cap {
            let tail: i64 = unsafe { atomic_load(ch.ctrl + 1) }
            unsafe { (ch.buf + (tail as usize)).* = v }   // ownership moves into the buffer
            unsafe { atomic_store(ch.ctrl + 1, (tail + 1) % ch.cap) }
            unsafe { atomic_store(ch.ctrl + 2, count + 1) }
            outcome = CH_SENT
        }
    }
    // The give-back, on BOTH refusal paths. Written under the lock for the same reason
    // the send is: a `T` large enough to tear is torn by a concurrent reader otherwise.
    if outcome != CH_SENT { unsafe { back.* = v } }
    unsafe { lock_release(ch.ctrl + 3) }
    return outcome
}

// The name of a `channel_try_send` outcome.
pub fn channel_send_outcome(o: i32) -> str {
    if o == CH_SENT { return "sent" }
    if o == CH_CLOSED { return "closed" }
    if o == CH_FULL { return "full" }
    return "?"
}

// Receive the next value by move. Blocks (spins) until an item is available, then
// reads it out *under the lock* (so no concurrent sender can overwrite the slot
// mid-read) and advances the head. Ownership transfers to the caller.
pub fn channel_recv(comptime T: type, read ch: Channel(T)) -> T {
    for {
        unsafe { lock_acquire(ch.ctrl + 3) }
        let count: i64 = unsafe { atomic_load(ch.ctrl + 2) }
        if count > 0 {
            let head: i64 = unsafe { atomic_load(ch.ctrl + 0) }
            let v: T = unsafe { load_cell(T, ch.buf + (head as usize)) }
            unsafe { atomic_store(ch.ctrl + 0, (head + 1) % ch.cap) }
            unsafe { atomic_store(ch.ctrl + 2, count - 1) }
            unsafe { lock_release(ch.ctrl + 3) }
            return v
        }
        unsafe { lock_release(ch.ctrl + 3) }
    }
}

// Number of buffered (not-yet-received) items — a snapshot, for draining loops.
pub fn channel_len(comptime T: type, read ch: Channel(T)) -> i64 {
    return unsafe { atomic_load(ch.ctrl + 2) }
}

// --- Closing: how a receiver learns there will be no more values. ---
//
// Without this, `channel_recv` on an empty channel spins forever and nothing can
// ever wake it, so every consumer has to be told IN ADVANCE how many items to
// expect. That is not a stylistic limitation: "drain until the producer is done",
// the shape every worker and every graceful shutdown needs, could not be written
// at all. `examples/std/channel.jtr` part 3 is the consumer that could not exist
// before this, and its drain loop takes no count.
//
// Closing is a fact about the CHANNEL, not about one sender: it is idempotent, any
// holder may do it, and it does not discard what is already buffered.
//
// **What this does NOT do: refuse a send on a closed channel.** `channel_send` is
// unchanged and will happily park a value in a channel nobody will drain. That is
// a real hazard and it is left open deliberately rather than papered over, because
// refusing the send raises an ownership question this increment does not answer:
// `send` takes its value by `take`, so by the time the refusal is known the callee
// already owns it, and returning `false` would leak it for any `T` whose teardown
// matters. A correct refusal has to hand the value back, and that is its own
// increment. Closing today signals EOF to RECEIVERS; it does not seal senders.
//
// `channel_recv` is also unchanged, and still spins forever on a closed, empty
// channel. It keeps its signature because the `select` lowering calls
// `channel_recv_i64` by that exact C name. New drain loops want `channel_recv_open`.
//
// `select` is not fixed by this either: it polls `channel_len_i64(ch) > 0`, which
// is false forever once a channel is closed and drained, so a `select` over only
// closed channels still spins. Termination there needs a default arm — separate work.

// Mark the channel closed: no further values will be sent. Idempotent — closing
// twice is not an error, which is what lets several producers race to be last
// without coordinating. Taken under the lock so a receiver cannot observe "empty"
// and "still open" from either side of this store.
pub fn channel_close(comptime T: type, read ch: Channel(T)) {
    unsafe { lock_acquire(ch.ctrl + 3) }
    unsafe { atomic_store(ch.ctrl + 4, 1) }
    unsafe { lock_release(ch.ctrl + 3) }
}

// Has the channel been closed? A snapshot, and NOT the same question as "is there
// anything left to receive" — a closed channel still hands out whatever was already
// buffered. Use `channel_recv_open` to drain; use this to report state.
pub fn channel_is_closed(comptime T: type, read ch: Channel(T)) -> bool {
    let shut: i64 = unsafe { atomic_load(ch.ctrl + 4) }
    return shut != 0
}

// Receive the next value into `slot`, or report that there will never be one.
// Blocks (spins) exactly as `channel_recv` does while the channel is open and
// empty; returns `false` only when the channel is closed AND drained.
//
// **Draining after close is the point.** The buffered-items branch is tested
// BEFORE the closed flag, so a producer that closes with values still in flight
// does not destroy them — otherwise closing would be a race against the consumer
// and shutdown would silently lose work. `false` therefore means "empty and no
// more coming", which is the only condition under which a drain loop may stop.
//
// The out-pointer is not a stylistic choice: an error union would make every
// caller a cross-module `catch`, and a `Recv(T)` result struct would be another
// module's type — both disqualify a corpus file from the byte-identity golden,
// which runs with imports unresolved. `sysproc.read_output` and `alog.next`
// already report their outcome as an integer for the same reason.
pub fn channel_recv_open(comptime T: type, read ch: Channel(T), slot: *mut T) -> bool {
    for {
        unsafe { lock_acquire(ch.ctrl + 3) }
        let count: i64 = unsafe { atomic_load(ch.ctrl + 2) }
        if count > 0 {
            let head: i64 = unsafe { atomic_load(ch.ctrl + 0) }
            let v: T = unsafe { load_cell(T, ch.buf + (head as usize)) }
            unsafe { atomic_store(ch.ctrl + 0, (head + 1) % ch.cap) }
            unsafe { atomic_store(ch.ctrl + 2, count - 1) }
            unsafe { lock_release(ch.ctrl + 3) }
            unsafe { slot.* = v }
            return true
        }
        let shut: i64 = unsafe { atomic_load(ch.ctrl + 4) }
        unsafe { lock_release(ch.ctrl + 3) }
        if shut != 0 {
            return false
        }
    }
}

// Monomorphic `i64` wrappers — the `select` lowering calls these by their stable
// (non-generic) C names, so the compiler need not synthesize a monomorphized call.
pub fn channel_len_i64(read ch: Channel(i64)) -> i64 { return channel_len(i64, ch) }
pub fn channel_recv_i64(read ch: Channel(i64)) -> i64 { return channel_recv(i64, ch) }
// The third one the lowering needs: without it a `select` cannot tell "nothing ready yet"
// from "nothing will ever be ready", and spins forever once every channel is closed and
// drained. Paired with `channel_len_i64` at each arm, because a closed channel that still
// holds values is not finished — draining outranks closing, as it does in `recv_open`.
pub fn channel_is_closed_i64(read ch: Channel(i64)) -> bool { return channel_is_closed(i64, ch) }

// Release the channel's heap cells. Call once, after every task sharing it has
// joined and the buffer has been drained (any values still buffered are leaked —
// the channel does not drop them in the bootstrap).
pub fn channel_free(comptime T: type, read ch: Channel(T)) {
    free_ptr(ch.buf)
    free_ptr(ch.ctrl)
}
