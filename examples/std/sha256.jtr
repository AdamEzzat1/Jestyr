// examples/std/sha256.jtr — a dependency-free SHA-256 (FIPS 180-4), written in Jestyr.
//
// The in-language half of `jestyr attest`'s hash: `jc <file> attest` commits to the
// emitted C by this digest, exactly as the Rust reference's `src/sha256.rs` does (the
// attest header golden pins the two byte-for-byte). Words are carried in `i64` and
// masked to 32 bits after every add/rotate — identical arithmetic to `u32` wrapping,
// with no unsigned subtleties. Zero imports; the padded message is read VIRTUALLY
// (no buffer): byte j is the source byte, the 0x80 terminator, a zero, or one of the
// eight big-endian bit-length bytes.

const SHA_K: [64]i64 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

@no_os fn mask32(x: i64) -> i64 {
    return x & 4294967295
}

@no_os fn rotr32(x: i64, n: i64) -> i64 {
    return mask32((x >> n) | (x << (32 - n)))
}

// Byte `j` of the virtually-padded message (source, 0x80, zeros, 8-byte BE bit length).
@no_os fn pad_byte(read data: str, j: usize, padded: usize) -> i64 {
    if j < data.len { return data[j] as i64 }
    if j == data.len { return 128 }
    if j >= padded - 8 {
        let bits: i64 = (data.len as i64) * 8
        let sh: i64 = ((padded - 1 - j) as i64) * 8
        return (bits >> sh) & 255
    }
    return 0
}

@no_os fn push_hex8(mut sb: String, x: i64) {
    let digits: str = "0123456789abcdef"
    var sh: i64 = 28
    for sh >= 0 {
        let d: i64 = (x >> sh) & 15
        string_push(sb, digits[d as usize .. (d + 1) as usize])
        sh = sh - 4
    }
}

// Append the lowercase-hex SHA-256 digest of `data` (64 ASCII chars) to `sb`.
@no_os pub fn push_sha256_hex(mut sb: String, read data: str) {
    var h: [8]i64 = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let rem: usize = (data.len + 1) % 64
    var pad: usize = 0
    if rem <= 56 { pad = 56 - rem } else { pad = 120 - rem }
    let padded: usize = data.len + 1 + pad + 8
    var w: [64]i64 = [0; 64]
    var blk: usize = 0
    for blk < padded / 64 {
        let base: usize = blk * 64
        var i: usize = 0
        for i < 16 {
            let o: usize = base + i * 4
            w[i] = (pad_byte(data, o, padded) << 24) | (pad_byte(data, o + 1, padded) << 16) | (pad_byte(data, o + 2, padded) << 8) | pad_byte(data, o + 3, padded)
            i = i + 1
        }
        var i2: usize = 16
        for i2 < 64 {
            let s0: i64 = rotr32(w[i2 - 15], 7) ^ rotr32(w[i2 - 15], 18) ^ (w[i2 - 15] >> 3)
            let s1: i64 = rotr32(w[i2 - 2], 17) ^ rotr32(w[i2 - 2], 19) ^ (w[i2 - 2] >> 10)
            w[i2] = mask32(w[i2 - 16] + s0 + w[i2 - 7] + s1)
            i2 = i2 + 1
        }
        var a: i64 = h[0]
        var b: i64 = h[1]
        var c: i64 = h[2]
        var d: i64 = h[3]
        var e: i64 = h[4]
        var f: i64 = h[5]
        var g: i64 = h[6]
        var hh: i64 = h[7]
        var r: usize = 0
        for r < 64 {
            let bs1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch: i64 = (e & f) ^ (mask32(~e) & g)
            let t1: i64 = mask32(hh + bs1 + ch + SHA_K[r] + w[r])
            let bs0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let mj: i64 = (a & b) ^ (a & c) ^ (b & c)
            let t2: i64 = mask32(bs0 + mj)
            hh = g
            g = f
            f = e
            e = mask32(d + t1)
            d = c
            c = b
            b = a
            a = mask32(t1 + t2)
            r = r + 1
        }
        h[0] = mask32(h[0] + a)
        h[1] = mask32(h[1] + b)
        h[2] = mask32(h[2] + c)
        h[3] = mask32(h[3] + d)
        h[4] = mask32(h[4] + e)
        h[5] = mask32(h[5] + f)
        h[6] = mask32(h[6] + g)
        h[7] = mask32(h[7] + hh)
        blk = blk + 1
    }
    var k: usize = 0
    for k < 8 {
        push_hex8(sb, h[k])
        k = k + 1
    }
}
