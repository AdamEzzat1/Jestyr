// std/memprof_test.jtr — the unit suite for `std/memprof`.
//
// Run:  jestyrc test examples/std/memprof_test.jtr

import "memprof"
import "list"
import "sink"
import "mem"
import "test"
import "test_report"

const REPORT_CAP: usize = 4096

@test fn a_wrapped_allocator_counts_what_passes_through_it() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    var prof: memprof.Counting = memprof.counting(mem.system_allocator())
    let a: Allocator = memprof.allocator(prof)

    test.eq_i64(c, rep, "starts at zero", memprof.allocs(prof), 0)
    var p: *mut u8 = mem.alloc_bytes(a, 100)
    test.eq_i64(c, rep, "one alloc", memprof.allocs(prof), 1)
    test.eq_i64(c, rep, "100 requested", memprof.bytes_requested(prof), 100)
    test.eq_i64(c, rep, "100 live", memprof.live_bytes(prof), 100)
    test.eq_i64(c, rep, "one outstanding", memprof.outstanding(prof), 1)
    test.is_false(c, rep, "not clean yet", memprof.clean(prof))

    mem.free_bytes(a, p)
    test.eq_i64(c, rep, "one free", memprof.frees(prof), 1)
    // The number `free_fn` is not given and this module has to remember — see the header
    // on the size header. If it were lost, `released` would be 0 and `live` would stay
    // at 100 forever, which is the failure this asserts against.
    test.eq_i64(c, rep, "100 released", memprof.bytes_released(prof), 100)
    test.eq_i64(c, rep, "nothing live", memprof.live_bytes(prof), 0)
    test.is_true(c, rep, "clean", memprof.clean(prof))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn the_peak_is_not_the_total_and_that_is_the_point() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    var prof: memprof.Counting = memprof.counting(mem.system_allocator())
    let a: Allocator = memprof.allocator(prof)

    // Ten 1000-byte blocks, allocated and freed ONE AT A TIME. Total requested is 10,000;
    // the peak is 1,000. A memory budget is written against the second number, and no
    // amount of totals can recover it after the fact — which is why `peak` is a field
    // maintained during the run rather than something computed at the end.
    var i: usize = 0
    for i < 10 {
        var p: *mut u8 = mem.alloc_bytes(a, 1000)
        mem.free_bytes(a, p)
        i = i + 1
    }
    test.eq_i64(c, rep, "10,000 requested in total", memprof.bytes_requested(prof), 10000)
    test.eq_i64(c, rep, "but the peak is 1,000", memprof.peak_bytes(prof), 1000)
    test.eq_i64(c, rep, "and nothing is live", memprof.live_bytes(prof), 0)

    // Now hold them all at once: the same total, a ten-fold peak. Same totals, different
    // answer to "does it fit" — the whole reason this distinction is maintained.
    var prof2: memprof.Counting = memprof.counting(mem.system_allocator())
    let a2: Allocator = memprof.allocator(prof2)
    var held: List(i64) = list.make(i64, mem.system_allocator())
    var j: usize = 0
    for j < 10 {
        var q: *mut u8 = mem.alloc_bytes(a2, 1000)
        list.push(i64, held, q as i64)
        j = j + 1
    }
    test.eq_i64(c, rep, "same total", memprof.bytes_requested(prof2), 10000)
    test.eq_i64(c, rep, "ten times the peak", memprof.peak_bytes(prof2), 10000)
    var k: usize = 0
    for k < 10 {
        var back: *mut u8 = null
        unsafe { back = list.get(i64, held, k) as *mut u8 }
        mem.free_bytes(a2, back)
        k = k + 1
    }
    test.is_true(c, rep, "and it still ends clean", memprof.clean(prof2))
    list.free(i64, held)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn it_instruments_a_container_without_the_container_knowing() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    // The point of wrapping rather than replacing: `std/list` is unmodified and unaware.
    // If instrumenting a data structure required editing it, this would only ever measure
    // the code someone remembered to change.
    var prof: memprof.Counting = memprof.counting(mem.system_allocator())
    let a: Allocator = memprof.allocator(prof)

    var l: List(i64) = list.make(i64, a)
    var i: i64 = 0
    for i < 100 {
        list.push(i64, l, i)
        i = i + 1
    }
    test.eq_usize(c, rep, "the list works", list.len(i64, l), 100)
    // A doubling list allocates on 4, 8, 16, 32, 64, 128 — several allocations, and a
    // peak larger than the final buffer because grow copies before releasing.
    test.is_true(c, rep, "it allocated", memprof.allocs(prof) > 1)
    test.is_true(c, rep, "and the peak exceeds the final size", memprof.peak_bytes(prof) >= memprof.live_bytes(prof))

    let before_free: i64 = memprof.live_bytes(prof)
    test.is_true(c, rep, "something is live", before_free > 0)

    list.free(i64, l)
    // The leak check in its intended position: after the structure under test is gone.
    test.eq_i64(c, rep, "no leak", memprof.leaked(prof), 0)
    test.is_true(c, rep, "clean", memprof.clean(prof))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_leak_is_visible_and_the_control_shows_it_is_not_noise() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    // Deliberately leak: allocate and never free.
    var leaky: memprof.Counting = memprof.counting(mem.system_allocator())
    let a1: Allocator = memprof.allocator(leaky)
    var p: *mut u8 = mem.alloc_bytes(a1, 256)
    test.eq_i64(c, rep, "the leak is exact", memprof.leaked(leaky), 256)
    test.eq_i64(c, rep, "and counted", memprof.outstanding(leaky), 1)
    test.is_false(c, rep, "not clean", memprof.clean(leaky))

    // The positive control: the identical sequence WITH the free reports zero. Without
    // this, "leaked returns 256" would also pass for an implementation that reported
    // every run as leaking.
    var tidy: memprof.Counting = memprof.counting(mem.system_allocator())
    let a2: Allocator = memprof.allocator(tidy)
    var q: *mut u8 = mem.alloc_bytes(a2, 256)
    mem.free_bytes(a2, q)
    test.eq_i64(c, rep, "positive control", memprof.leaked(tidy), 0)
    test.is_true(c, rep, "clean", memprof.clean(tidy))

    mem.free_bytes(a1, p)                    // tidy up the deliberate leak
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_wrapped_pointer_is_offset_from_the_bases() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    // The documented hazard, pinned. The pointer a caller receives is NOT the one the
    // base allocator returned — there is a size header in front of it — so freeing it
    // through the base allocator directly would free the wrong address. Nothing enforces
    // this today; the language cannot yet. This test is what makes the claim in the
    // header a fact rather than a note, and it is the one to change when a linear-type
    // obligation can express "this pointer belongs to that allocator".
    var prof: memprof.Counting = memprof.counting(mem.system_allocator())
    let a: Allocator = memprof.allocator(prof)
    var p: *mut u8 = mem.alloc_bytes(a, 64)

    // The payload is writable for its full requested length: the header sits BEFORE it,
    // so instrumentation must not eat into what the caller asked for.
    var i: usize = 0
    for i < 64 {
        unsafe { (p + i).* = 65 as u8 }
        i = i + 1
    }
    var first: u8 = 0
    var last: u8 = 0
    unsafe { first = p.* }
    unsafe { last = (p + 63).* }
    test.eq_i64(c, rep, "first byte survives", first as i64, 65)
    test.eq_i64(c, rep, "last byte survives", last as i64, 65)
    test.eq_i64(c, rep, "and the size was recorded", memprof.live_bytes(prof), 64)

    mem.free_bytes(a, p)
    test.is_true(c, rep, "clean", memprof.clean(prof))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn the_report_renders_and_overflow_is_visible() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()

    var prof: memprof.Counting = memprof.counting(mem.system_allocator())
    let a: Allocator = memprof.allocator(prof)
    var p: *mut u8 = mem.alloc_bytes(a, 16)
    mem.free_bytes(a, p)

    var braw: *mut u8 = alloc(u8, 256)
    var buf: []u8 = slice(u8, braw, 256)
    var s: sink.Sink = sink.new()
    memprof.render(s, buf, prof)
    test.eq_str(c, rep, "report", sink.view(s, buf),
        "allocs=1 frees=1 requested=16 released=16 live=0 peak=16")
    test.is_false(c, rep, "fits", sink.overflowed(s))

    // Unguarded into a buffer that cannot hold it.
    var small: *mut u8 = alloc(u8, 8)
    var sbuf: []u8 = slice(u8, small, 8)
    var s2: sink.Sink = sink.new()
    memprof.render(s2, sbuf, prof)
    test.is_true(c, rep, "THE signal", sink.overflowed(s2))

    free_ptr(small)
    free_ptr(braw)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
