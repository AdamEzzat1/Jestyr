// std/plugin_test.jtr — the frame, and the refusals that happen before a process starts.
//
// The END-TO-END half of this protocol — a real plugin, really invoked, failing three
// different ways — is `plugin_demo.jtr` and the Rust test that drives it, because it needs a
// COMPILED plugin and a `.jtr` suite cannot build one.
//
// What is here is everything that does not need a second process: the frame, the order the
// validity checks happen in, and the capability refusals. All of it runs on any host.
//
// Run:  jestyrc test examples/std/plugin_test.jtr

import "plugin"
import "file"
import "fs"
import "process"
import "mem"
import "test"
import "test_report"

const P_T_CAP: usize = 8192
const P_T_REQ: str = "zz_plugin_req.bin"
const P_T_RESP: str = "zz_plugin_resp.bin"

fn scrub(mut f: fs.Fs) {
    fs.erase(f, P_T_REQ)
    fs.erase(f, P_T_RESP)
}

fn load(mut buf: []u8, read text: str) -> usize {
    for i in 0..text.len {
        buf[i] = text[i]
    }
    return text.len
}

// Write raw bytes to the request path, so a test can hand the reader something a well-behaved
// host would never produce.
fn lay_down(read a: Allocator, read bytes: []u8) {
    var w: file.Writer = file.create_path(a, P_T_REQ)
    file.write_from(w, bytes)
    let n: usize = file.finish(w) catch 0
}

@test fn a_frame_round_trips_through_a_file() -> bool {
    var raw: *mut u8 = alloc(u8, P_T_CAP)
    var rep: []u8 = slice(u8, raw, P_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var fb: *mut u8 = alloc(u8, 512)
    var frame: []u8 = slice(u8, fb, 512)
    var pb: *mut u8 = alloc(u8, 512)
    var payload: []u8 = slice(u8, pb, 512)

    let n: usize = load(payload, "a request payload")
    let total: usize = plugin.encode(frame, plugin.PLUGIN_KIND_REQUEST, plugin.PLUGIN_VERSION, payload[0 .. n])
    test.eq_usize(c, rep, "the frame is header plus payload plus trailer", total,
        plugin.PLUGIN_HEADER + plugin.PLUGIN_TRAILER + n)

    // The magic is the first four bytes, so a file that is not a message is refused before
    // anything in it is believed.
    test.eq_i64(c, rep, "magic J", frame[0] as i64, 74)
    test.eq_i64(c, rep, "magic P", frame[1] as i64, 80)
    test.eq_i64(c, rep, "magic L", frame[2] as i64, 76)
    test.eq_i64(c, rep, "magic 1", frame[3] as i64, 49)

    lay_down(a, frame[0 .. total])
    var status: i32 = 99
    let got: isize = plugin.read_request(a, P_T_REQ, payload, status)
    test.eq_i64(c, rep, "the payload comes back whole", got as i64, n as i64)
    test.eq_i64(c, rep, "with an ok status", status as i64, plugin.PLUGIN_REQ_OK as i64)
    test.eq_str(c, rep, "and the same bytes", from_utf8(payload[0 .. got as usize]), "a request payload")

    // A RESPONSE frame is not a request. The kind field exists so a host and a plugin cannot
    // read each other's messages by accident — which, with a symmetric frame, they otherwise
    // would.
    test.is_true(c, rep, "a response writes", plugin.write_response(a, P_T_RESP, payload[0 .. n]))
    var st2: i32 = 99
    test.eq_i64(c, rep, "and is NOT accepted as a request",
        plugin.read_request(a, P_T_RESP, payload, st2) as i64, 0 - 1)

    // An empty payload is a real message: a plugin invoked for its effect rather than its
    // answer still has to say it finished.
    let z: usize = plugin.encode(frame, plugin.PLUGIN_KIND_REQUEST, plugin.PLUGIN_VERSION, payload[0 .. 0])
    lay_down(a, frame[0 .. z])
    var st3: i32 = 99
    test.eq_i64(c, rep, "an empty request is a request", plugin.read_request(a, P_T_REQ, payload, st3) as i64, 0)
    test.eq_i64(c, rep, "and it is ok", st3 as i64, plugin.PLUGIN_REQ_OK as i64)

    free_ptr(pb)
    free_ptr(fb)
    scrub(h)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn something_that_is_not_a_message_is_refused_as_a_bad_frame() -> bool {
    var raw: *mut u8 = alloc(u8, P_T_CAP)
    var rep: []u8 = slice(u8, raw, P_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var fb: *mut u8 = alloc(u8, 512)
    var frame: []u8 = slice(u8, fb, 512)
    var pb: *mut u8 = alloc(u8, 512)
    var payload: []u8 = slice(u8, pb, 512)

    // **A file of zeroes is the case the magic exists for.** Without it, sixteen zero bytes
    // parse as a version-0, kind-0, length-0 message whose checksum over nothing is zero —
    // a structurally valid message that nobody wrote.
    var i: usize = 0
    for i < 32 {
        frame[i] = 0 as u8
        i = i + 1
    }
    lay_down(a, frame[0 .. 32])
    var st: i32 = 99
    test.eq_i64(c, rep, "a file of zeroes is not a message", plugin.read_request(a, P_T_REQ, payload, st) as i64, 0 - 1)
    test.eq_i64(c, rep, "and it is a bad FRAME, not a bad version", st as i64, plugin.PLUGIN_BAD_FRAME as i64)

    // A truncated message: a real header whose payload never arrived.
    let n: usize = load(payload, "some payload")
    let total: usize = plugin.encode(frame, plugin.PLUGIN_KIND_REQUEST, plugin.PLUGIN_VERSION, payload[0 .. n])
    lay_down(a, frame[0 .. total - 3])
    var st2: i32 = 99
    test.eq_i64(c, rep, "a truncated message is refused", plugin.read_request(a, P_T_REQ, payload, st2) as i64, 0 - 1)

    // A corrupted payload with an intact header: only the checksum can tell.
    lay_down(a, frame[0 .. total])
    frame[plugin.PLUGIN_HEADER + 2] = 88 as u8
    lay_down(a, frame[0 .. total])
    var st3: i32 = 99
    test.eq_i64(c, rep, "a corrupted payload is refused", plugin.read_request(a, P_T_REQ, payload, st3) as i64, 0 - 1)
    test.eq_i64(c, rep, "as a bad frame", st3 as i64, plugin.PLUGIN_BAD_FRAME as i64)

    // A missing file is a bad frame too, not a crash — a plugin handed a path that is not
    // there must report rather than fault.
    fs.erase(h, P_T_REQ)
    var st4: i32 = 99
    test.eq_i64(c, rep, "a missing request is refused", plugin.read_request(a, P_T_REQ, payload, st4) as i64, 0 - 1)

    free_ptr(pb)
    free_ptr(fb)
    scrub(h)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_wrong_version_is_reported_as_a_version_and_only_when_intact() -> bool {
    var raw: *mut u8 = alloc(u8, P_T_CAP)
    var rep: []u8 = slice(u8, raw, P_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()
    var h: fs.Fs = fs.host()
    scrub(h)

    var fb: *mut u8 = alloc(u8, 512)
    var frame: []u8 = slice(u8, fb, 512)
    var pb: *mut u8 = alloc(u8, 512)
    var payload: []u8 = slice(u8, pb, 512)

    // A well-formed message from a FUTURE version of the protocol: correct magic, correct
    // checksum, a version this build does not know.
    let n: usize = load(payload, "from the future")
    let total: usize = plugin.encode(frame, plugin.PLUGIN_KIND_REQUEST, plugin.PLUGIN_VERSION + 1, payload[0 .. n])
    lay_down(a, frame[0 .. total])
    var st: i32 = 99
    test.eq_i64(c, rep, "a future version is refused", plugin.read_request(a, P_T_REQ, payload, st) as i64, 0 - 1)
    // **Reported as a VERSION problem**, which is a deployment mismatch, not as corruption,
    // which is a broken host or a broken disk. Two different bugs, two different fixes.
    test.eq_i64(c, rep, "and named as a version, not as corruption", st as i64, plugin.PLUGIN_BAD_VERSION as i64)

    // **The ordering claim**: a frame that is BOTH corrupt and from another version is
    // reported as corrupt. A corrupt frame can carry any version at all, so trusting the
    // version field first would send a caller after an imaginary deployment mismatch.
    frame[plugin.PLUGIN_HEADER + 1] = 90 as u8
    lay_down(a, frame[0 .. total])
    var st2: i32 = 99
    test.eq_i64(c, rep, "corrupt AND future is refused", plugin.read_request(a, P_T_REQ, payload, st2) as i64, 0 - 1)
    test.eq_i64(c, rep, "and reported as corruption, because the checksum is checked first",
        st2 as i64, plugin.PLUGIN_BAD_FRAME as i64)

    // The control: the same message at the CURRENT version is accepted, so the assertions
    // above are about the version field and not about the encoder.
    let ok2: usize = plugin.encode(frame, plugin.PLUGIN_KIND_REQUEST, plugin.PLUGIN_VERSION, payload[0 .. n])
    lay_down(a, frame[0 .. ok2])
    var st3: i32 = 99
    test.eq_i64(c, rep, "the current version is accepted", plugin.read_request(a, P_T_REQ, payload, st3) as i64, n as i64)

    free_ptr(pb)
    free_ptr(fb)
    scrub(h)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn the_capabilities_are_checked_before_anything_runs() -> bool {
    var raw: *mut u8 = alloc(u8, P_T_CAP)
    var rep: []u8 = slice(u8, raw, P_T_CAP)
    var c: test.Check = test.new()
    let a: Allocator = mem.system_allocator()

    var pb: *mut u8 = alloc(u8, 256)
    var payload: []u8 = slice(u8, pb, 256)
    var rb: *mut u8 = alloc(u8, 256)
    var resp: []u8 = slice(u8, rb, 256)
    let n: usize = load(payload, "hello")

    // **A denied process capability is `PLUGIN_REFUSED`, never `PLUGIN_CRASHED`**, and that
    // distinction takes a deliberate check: `process.run` answers -1 for a refusal AND for a
    // real failure, which its own header calls out as not a discriminator. So `can_run` is
    // asked first. Without it this reads as "the plugin crashed", sending a caller to debug a
    // plugin that never ran.
    var denied: plugin.Host = plugin.host(process.denied(), fs.host())
    let r1: plugin.Reply = plugin.call(denied, a, "anything", P_T_REQ, P_T_RESP, payload[0 .. n], resp)
    test.eq_i64(c, rep, "a denied process refuses", r1.outcome as i64, plugin.PLUGIN_REFUSED as i64)
    test.is_false(c, rep, "and it did not succeed", plugin.succeeded(r1))
    test.eq_i64(c, rep, "the call was counted", plugin.calls(denied), 1)
    test.eq_i64(c, rep, "as a failure", plugin.failures(denied), 1)

    // A host that cannot write cannot stage a request either, and refuses for the same reason
    // rather than producing a half-written one.
    var nowrite: plugin.Host = plugin.host(process.host(), fs.read_only())
    let r2: plugin.Reply = plugin.call(nowrite, a, "anything", P_T_REQ, P_T_RESP, payload[0 .. n], resp)
    test.eq_i64(c, rep, "a read-only filesystem refuses", r2.outcome as i64, plugin.PLUGIN_REFUSED as i64)

    // **A path with a space is refused rather than mis-quoted.** The two paths are appended to
    // a shell command line unquoted, and quoting differs between `cmd.exe` and `sh` — a
    // half-right rule would send the plugin a truncated path and blame the plugin.
    var okhost: plugin.Host = plugin.host(process.host(), fs.host())
    let r3: plugin.Reply = plugin.call(okhost, a, "anything", "has a space.bin", P_T_RESP, payload[0 .. n], resp)
    test.eq_i64(c, rep, "a request path with a space refuses", r3.outcome as i64, plugin.PLUGIN_REFUSED as i64)
    let r4: plugin.Reply = plugin.call(okhost, a, "anything", P_T_REQ, "also spaced.bin", payload[0 .. n], resp)
    test.eq_i64(c, rep, "a response path with a space refuses", r4.outcome as i64, plugin.PLUGIN_REFUSED as i64)

    // The outcome names, which are what a demo and a build log print.
    test.eq_str(c, rep, "ok", plugin.outcome_name(plugin.PLUGIN_OK), "ok")
    test.eq_str(c, rep, "failed", plugin.outcome_name(plugin.PLUGIN_FAILED), "failed")
    test.eq_str(c, rep, "crashed", plugin.outcome_name(plugin.PLUGIN_CRASHED), "crashed")
    test.eq_str(c, rep, "bad-response", plugin.outcome_name(plugin.PLUGIN_BAD_RESPONSE), "bad-response")
    test.eq_str(c, rep, "refused", plugin.outcome_name(plugin.PLUGIN_REFUSED), "refused")

    var f: fs.Fs = fs.host()
    scrub(f)
    free_ptr(rb)
    free_ptr(pb)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
