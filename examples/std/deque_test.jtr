// std/deque_test.jtr — the unit suite for `std/deque`.
//
// A sibling file, not colocated: a `@test` is emitted into every consumer of its
// module (see `path_test.jtr` for the measurement).
//
// The suite that carries the weight is `growth_while_wrapped_preserves_order`.
// Everything else passes for a ring that copies its buffer VERBATIM on growth;
// only that one notices that the elements were split across the end of the old
// buffer and must come out in logical order.
//
// Run:  jestyrc test examples/std/deque_test.jtr

import "deque"
import "mem"
import "test"
import "test_report"

const REPORT_CAP: usize = 512
const NONE: i64 = 0 - 1

// ------------------------------------------------------------------------ basics

@test fn fifo_and_lifo() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    test.is_true(c, rep, "empty", deque.is_empty(i64, d))
    test.eq_i64(c, rep, "pop_front(empty)", deque.pop_front(i64, d, NONE), NONE)
    test.eq_i64(c, rep, "pop_back(empty)", deque.pop_back(i64, d, NONE), NONE)
    test.eq_i64(c, rep, "front(empty)", deque.front(i64, d, NONE), NONE)

    // Queue behaviour: back in, front out.
    deque.push_back(i64, d, 1)
    deque.push_back(i64, d, 2)
    deque.push_back(i64, d, 3)
    test.eq_usize(c, rep, "len", deque.len(i64, d), 3)
    test.eq_i64(c, rep, "front", deque.front(i64, d, NONE), 1)
    test.eq_i64(c, rep, "back", deque.back(i64, d, NONE), 3)
    test.eq_i64(c, rep, "fifo 1", deque.pop_front(i64, d, NONE), 1)
    test.eq_i64(c, rep, "fifo 2", deque.pop_front(i64, d, NONE), 2)
    test.eq_i64(c, rep, "fifo 3", deque.pop_front(i64, d, NONE), 3)
    test.is_true(c, rep, "drained", deque.is_empty(i64, d))

    // Stack behaviour: back in, back out.
    deque.push_back(i64, d, 10)
    deque.push_back(i64, d, 20)
    test.eq_i64(c, rep, "lifo 20", deque.pop_back(i64, d, NONE), 20)
    test.eq_i64(c, rep, "lifo 10", deque.pop_back(i64, d, NONE), 10)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn push_front_reverses_the_order() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    deque.push_front(i64, d, 1)
    deque.push_front(i64, d, 2)
    deque.push_front(i64, d, 3)
    // Pushing at the front three times leaves 3,2,1 front-to-back.
    test.eq_i64(c, rep, "front is the last pushed", deque.front(i64, d, NONE), 3)
    test.eq_i64(c, rep, "back is the first pushed", deque.back(i64, d, NONE), 1)
    test.eq_i64(c, rep, "get(0)", deque.get(i64, d, 0, NONE), 3)
    test.eq_i64(c, rep, "get(1)", deque.get(i64, d, 1, NONE), 2)
    test.eq_i64(c, rep, "get(2)", deque.get(i64, d, 2, NONE), 1)
    test.eq_i64(c, rep, "get(out of range)", deque.get(i64, d, 3, NONE), NONE)

    // Both ends at once: 3,2,1 then append 0 at the back.
    deque.push_back(i64, d, 0)
    test.eq_i64(c, rep, "back after mixed push", deque.back(i64, d, NONE), 0)
    test.eq_usize(c, rep, "len after mixed push", deque.len(i64, d), 4)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// -------------------------------------------------------------------- wraparound

// Drive `head` away from 0 and push past the end of the buffer, so logical index
// and physical slot stop agreeing. A ring that forgot to mask reads garbage here.
@test fn indices_wrap_around_the_buffer() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    // Fill the initial capacity of 8 exactly.
    var i: i64 = 0
    for i < 8 {
        deque.push_back(i64, d, i)
        i = i + 1
    }
    test.eq_usize(c, rep, "cap after 8", deque.cap(i64, d), 8)

    // Free three slots at the front, then refill them from the back — those three
    // land at physical slots 0,1,2 while the front sits at slot 3.
    test.eq_i64(c, rep, "drop 0", deque.pop_front(i64, d, NONE), 0)
    test.eq_i64(c, rep, "drop 1", deque.pop_front(i64, d, NONE), 1)
    test.eq_i64(c, rep, "drop 2", deque.pop_front(i64, d, NONE), 2)
    deque.push_back(i64, d, 100)
    deque.push_back(i64, d, 101)
    deque.push_back(i64, d, 102)
    test.eq_usize(c, rep, "still cap 8 (no growth needed)", deque.cap(i64, d), 8)
    test.eq_usize(c, rep, "len back to 8", deque.len(i64, d), 8)

    // Logical order must read 3..7 then 100,101,102 despite the physical split.
    var bad: i64 = 0
    var j: usize = 0
    for j < 5 {
        if deque.get(i64, d, j, NONE) != (j as i64) + 3 { bad = bad + 1 }
        j = j + 1
    }
    if deque.get(i64, d, 5, NONE) != 100 { bad = bad + 1 }
    if deque.get(i64, d, 6, NONE) != 101 { bad = bad + 1 }
    if deque.get(i64, d, 7, NONE) != 102 { bad = bad + 1 }
    test.eq_i64(c, rep, "elements misread across the wrap", bad, 0)
    test.eq_i64(c, rep, "front across the wrap", deque.front(i64, d, NONE), 3)
    test.eq_i64(c, rep, "back across the wrap", deque.back(i64, d, NONE), 102)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// THE test. Growing while the contents are split across the end of the buffer is
// the only case where copying the old buffer verbatim differs from copying in
// logical order — and it is the bug every hand-written ring buffer has once.
@test fn growth_while_wrapped_preserves_order() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    var i: i64 = 0
    for i < 8 {
        deque.push_back(i64, d, i)
        i = i + 1
    }
    // head -> 3, and three elements wrap onto slots 0,1,2.
    deque.pop_front(i64, d, NONE)
    deque.pop_front(i64, d, NONE)
    deque.pop_front(i64, d, NONE)
    deque.push_back(i64, d, 100)
    deque.push_back(i64, d, 101)
    deque.push_back(i64, d, 102)

    // Now force a grow from a WRAPPED state.
    deque.push_back(i64, d, 103)
    test.eq_usize(c, rep, "grew", deque.cap(i64, d), 16)
    test.eq_usize(c, rep, "len after growth", deque.len(i64, d), 9)

    // Expected logical order: 3,4,5,6,7,100,101,102,103.
    let want: [9]i64 = [3, 4, 5, 6, 7, 100, 101, 102, 103]
    var bad: i64 = 0
    var j: usize = 0
    for j < 9 {
        if deque.get(i64, d, j, NONE) != want[j] { bad = bad + 1 }
        j = j + 1
    }
    test.eq_i64(c, rep, "order lost by growing while wrapped", bad, 0)

    // …and draining agrees with random access.
    var drained_ok: bool = true
    var k: usize = 0
    for k < 9 {
        if deque.pop_front(i64, d, NONE) != want[k] { drained_ok = false }
        k = k + 1
    }
    test.is_true(c, rep, "drain order matches", drained_ok)
    test.is_true(c, rep, "empty after drain", deque.is_empty(i64, d))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A long mixed-ends run, so growth happens repeatedly from arbitrary head
// positions rather than the one hand-built state above.
@test fn mixed_ends_survive_repeated_growth() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    // Push 0..99 alternately at the front and the back. The result is a known
    // sequence: odds descending, then evens ascending.
    var i: i64 = 0
    for i < 100 {
        if i % 2 == 0 { deque.push_back(i64, d, i) } else { deque.push_front(i64, d, i) }
        i = i + 1
    }
    test.eq_usize(c, rep, "len", deque.len(i64, d), 100)
    test.eq_i64(c, rep, "front is the last odd", deque.front(i64, d, NONE), 99)
    test.eq_i64(c, rep, "back is the last even", deque.back(i64, d, NONE), 98)

    // Front half: 99, 97, …, 1. Back half: 0, 2, …, 98.
    var bad: i64 = 0
    var j: usize = 0
    for j < 50 {
        if deque.get(i64, d, j, NONE) != 99 - (j as i64) * 2 { bad = bad + 1 }
        j = j + 1
    }
    var k: usize = 50
    for k < 100 {
        if deque.get(i64, d, k, NONE) != ((k as i64) - 50) * 2 { bad = bad + 1 }
        k = k + 1
    }
    test.eq_i64(c, rep, "elements wrong after repeated growth", bad, 0)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// --------------------------------------------------------------------- teardown

@test fn clear_keeps_the_buffer_and_free_is_idempotent() -> bool {
    var raw: *mut u8 = alloc(u8, REPORT_CAP)
    var rep: []u8 = slice(u8, raw, REPORT_CAP)
    var c: test.Check = test.new()
    var sys: Allocator = mem.system_allocator()

    var d: deque.Deque(i64) = deque.make(i64, sys)
    var i: i64 = 0
    for i < 20 {
        deque.push_back(i64, d, i)
        i = i + 1
    }
    let before: usize = deque.cap(i64, d)
    deque.clear(i64, d)
    test.is_true(c, rep, "empty after clear", deque.is_empty(i64, d))
    test.eq_usize(c, rep, "clear keeps the buffer", deque.cap(i64, d), before)
    // …and it is immediately reusable, from a reset head.
    deque.push_back(i64, d, 7)
    test.eq_i64(c, rep, "reusable after clear", deque.front(i64, d, NONE), 7)

    // `free` releases and zeroes `cap`; the automatic drop then sees an empty
    // deque and releases nothing. Both running must not double-free.
    deque.free(i64, d)
    test.eq_usize(c, rep, "cap after free", deque.cap(i64, d), 0)
    test.is_true(c, rep, "empty after free", deque.is_empty(i64, d))
    deque.push_back(i64, d, 5)
    test.eq_i64(c, rep, "reusable after free", deque.front(i64, d, NONE), 5)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
