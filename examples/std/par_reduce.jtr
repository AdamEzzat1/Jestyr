// examples/std/par_reduce.jtr — the determinism headline: a PARALLEL reduction whose
// result is bit-identical to the serial one, on real OS threads.
//
// `core.par_binned_sum` splits the slice across worker threads, each binning its
// chunk into its own accumulator, then merges (integer add, order-independent) and
// finalizes (correctly rounded). Because the bins encode the exact value, the answer
// cannot depend on the chunk split or the thread schedule — so it equals the serial
// `f64_binned_sum` bit-for-bit. A naive/Kahan parallel sum cannot promise this.
//
//   jestyrc run examples/std/par_reduce.jtr   →   1, 1, 1   (all bit-identical)
import "core"
import "io"

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }
fn setf(p: *mut f64, i: usize, v: f64) { unsafe { (p + i).* = v } }

// 1 iff the parallel sum equals the serial sum bit-for-bit.
fn canary(read s: []f64) -> i32 {
    let serial: f64 = core.f64_binned_sum(s)
    let par: f64 = core.par_binned_sum(s)
    return b2i(core.f64_bits(serial) == core.f64_bits(par))
}

fn main() -> i32 {
    // (1) wide dynamic range + catastrophic cancellation: 1 + 1e16 − 1e16 + 3 + …
    var a: *mut f64 = alloc(f64, 16)
    var i: usize = 0
    for i < 16 {
        setf(a, i, 1.0)
        i = i + 1
    }
    setf(a, 1, 1.0e16)
    setf(a, 2, 0.0 - 1.0e16)
    setf(a, 7, 3.0)
    setf(a, 11, 0.0 - 2.5)
    io.print_i32(canary(slice(f64, a, 16)))     // 1
    free_ptr(a)

    // (2) large n that genuinely spreads work across threads: 1000 × 0.1
    var b: *mut f64 = alloc(f64, 1000)
    var j: usize = 0
    for j < 1000 {
        setf(b, j, 0.1)
        j = j + 1
    }
    io.print_i32(canary(slice(f64, b, 1000)))   // 1
    free_ptr(b)

    // (3) n not divisible by the worker count (uneven last chunk): 7 values
    var c: *mut f64 = alloc(f64, 7)
    var k: usize = 0
    for k < 7 {
        setf(c, k, (k as f64) * 0.3)
        k = k + 1
    }
    io.print_i32(canary(slice(f64, c, 7)))      // 1
    free_ptr(c)
    return 0
}
