// examples/std/par_cost.jtr — the work-span cost model: `@span(...)` as a CHECKED
// contract (Workstream Q, the Motley cost-model tie-in; Cilk/NESL).
//
// A function may declare its parallel *span* (depth — its critical-path length, the
// time on unbounded processors). The compiler COMPUTES the body's span from its loop
// structure and rejects a body whose span exceeds the declaration:
//   * a sequential `for` over the input has span O(n)  → `@span(linear)`;
//   * a deterministic `par for … reduce(r)` is a parallel tree reduction with span
//     O(log n)                                          → `@span(log)`.
// So the cost is part of the proven interface: a refactor that accidentally
// SERIALIZES the reduction (replacing `par for` with `for`) flips its span from
// O(log n) to O(n) and becomes a COMPILE ERROR, not a silent performance regression.
// (The rejection is exercised in `attrs::cost_model` / `proptests`.)
//
//   jestyrc run examples/std/par_cost.jtr   →   5050, 1
import "core"
import "io"

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }
fn seti(p: *mut i64, i: usize, v: i64) { unsafe { (p + i).* = v } }

// The deterministic parallel reduction — the compiler VERIFIES its span is O(log n).
@span(log) fn par_sum(read s: []i64) -> i64 {
    par for x in s reduce(core.sum_reduction()) { x }
}

// Its serial reference is honestly O(n), declared and checked as linear.
@span(linear) fn serial_sum(read s: []i64) -> i64 {
    var a: i64 = 0
    for x in s { a = a + x }
    return a
}

fn main() -> i32 {
    var a: *mut i64 = alloc(i64, 100)
    var i: usize = 0
    for i < 100 {
        seti(a, i, (i as i64) + 1)        // 1, 2, …, 100
        i = i + 1
    }
    let s: []i64 = slice(i64, a, 100)
    io.print_i32(par_sum(s) as i32)                    // 5050 (= 100·101/2)
    io.print_i32(b2i(par_sum(s) == serial_sum(s)))     // 1 (bit-identical to serial)
    free_ptr(a)
    return 0
}
