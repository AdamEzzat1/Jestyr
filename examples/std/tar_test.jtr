// std/tar_test.jtr — reproducibility as a claim, and the checksum quirk.
//
// Two tests carry this file:
//
//   * `an_archive_of_the_same_entries_is_byte_identical` builds the same archive twice and
//     compares every byte. That is the only way the module's headline claim can be believed,
//     and it is the assertion a `time(0)` in `put_header` would fail.
//   * `the_checksum_is_computed_over_spaces` pins the one detail every tar writer gets wrong.
//     A checksum summed over a zeroed field produces an archive that `tar` refuses, and no
//     round-trip test in this file would notice — the reader would agree with the writer.
//
// Nothing here touches a filesystem: an archive is bytes in a buffer, so the format runs on
// any host.
//
// Run:  jestyrc test examples/std/tar_test.jtr

import "tar"
import "test"
import "test_report"

const T_T_CAP: usize = 16384

fn fill(mut buf: []u8, read text: str) -> usize {
    for i in 0..text.len {
        buf[i] = text[i]
    }
    return text.len
}

// Build a small archive into `b` and return its length.
fn build(mut ar: tar.Archive, mut b: []u8, mut scratch: []u8) -> usize {
    let n1: usize = fill(scratch, "hello world")
    tar.add_file(ar, b, "greeting.txt", scratch[0 .. n1])
    tar.add_dir(ar, b, "docs/")
    let n2: usize = fill(scratch, "second file")
    tar.add_file(ar, b, "docs/notes.md", scratch[0 .. n2])
    tar.finish(ar, b)
    return tar.written(ar)
}

@test fn an_archive_of_the_same_entries_is_byte_identical() -> bool {
    var raw: *mut u8 = alloc(u8, T_T_CAP)
    var rep: []u8 = slice(u8, raw, T_T_CAP)
    var c: test.Check = test.new()

    var sraw: *mut u8 = alloc(u8, 256)
    var scratch: []u8 = slice(u8, sraw, 256)
    var a1: *mut u8 = alloc(u8, 8192)
    var b1: []u8 = slice(u8, a1, 8192)
    var a2: *mut u8 = alloc(u8, 8192)
    var b2: []u8 = slice(u8, a2, 8192)

    // The buffers are deliberately dirtied first. An archive whose block padding carried
    // whatever was in memory would differ between the two runs — which is both an
    // irreproducibility and a leak of whatever that memory held.
    var i: usize = 0
    for i < 8192 {
        b1[i] = 219 as u8
        b2[i] = 7 as u8
        i = i + 1
    }

    var ar1: tar.Archive = tar.begin()
    let n1: usize = build(ar1, b1, scratch)
    var ar2: tar.Archive = tar.begin()
    let n2: usize = build(ar2, b2, scratch)

    test.eq_usize(c, rep, "the same entries make the same length", n1, n2)
    var same: bool = true
    var k: usize = 0
    for k < n1 {
        if b1[k] != b2[k] { same = false  break }
        k = k + 1
    }
    // **The claim.** A `time(0)` in the header, a real uid, or padding left as it was found
    // all fail exactly here.
    test.is_true(c, rep, "and every byte of the archive is identical", same)

    // The shape is right too: three entries plus two zero blocks, all block-aligned.
    test.eq_i64(c, rep, "three entries", tar.entries(ar1), 3)
    test.eq_usize(c, rep, "and the archive is a whole number of blocks", n1 % tar.TAR_BLOCK, 0)

    free_ptr(a2)
    free_ptr(a1)
    free_ptr(sraw)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn the_checksum_is_computed_over_spaces() -> bool {
    var raw: *mut u8 = alloc(u8, T_T_CAP)
    var rep: []u8 = slice(u8, raw, T_T_CAP)
    var c: test.Check = test.new()

    var braw: *mut u8 = alloc(u8, 1024)
    var blk: []u8 = slice(u8, braw, 1024)

    // A block of zeros: the checksum is 8 spaces and nothing else, so 8 * 32 = 256. If the
    // field were summed as ZEROS the answer would be 0, and an archive built that way is one
    // every real `tar` rejects.
    var i: usize = 0
    for i < 512 {
        blk[i] = 0 as u8
        i = i + 1
    }
    test.eq_i64(c, rep, "a zero block checksums to eight spaces", tar.header_checksum(blk[0 .. 512]), 256)

    // And the field's own contents are IGNORED, which is what lets a reader verify a header
    // that already carries its checksum. Writing garbage into 148..156 must not change it.
    var k: usize = 148
    for k < 156 {
        blk[k] = 255 as u8
        k = k + 1
    }
    test.eq_i64(c, rep, "and the field's own bytes are ignored", tar.header_checksum(blk[0 .. 512]), 256)

    // A byte OUTSIDE the field does change it — the anti-vacuity control for a checksum that
    // ignored everything.
    blk[0] = 1 as u8
    test.eq_i64(c, rep, "a byte outside the field counts", tar.header_checksum(blk[0 .. 512]), 257)

    free_ptr(braw)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn a_real_ustar_header_has_the_bytes_the_format_specifies() -> bool {
    var raw: *mut u8 = alloc(u8, T_T_CAP)
    var rep: []u8 = slice(u8, raw, T_T_CAP)
    var c: test.Check = test.new()

    var sraw: *mut u8 = alloc(u8, 256)
    var scratch: []u8 = slice(u8, sraw, 256)
    var araw: *mut u8 = alloc(u8, 4096)
    var b: []u8 = slice(u8, araw, 4096)
    var ar: tar.Archive = tar.begin()

    let n: usize = fill(scratch, "abc")
    test.eq_i64(c, rep, "a file is added", tar.add_file(ar, b, "f.txt", scratch[0 .. n]) as i64, tar.TAR_OK as i64)

    // The magic and version at their specified offsets. A mistake here is an archive `tar`
    // cannot read, and a round-trip test would not notice because the reader would agree.
    test.eq_str(c, rep, "the ustar magic", from_utf8(b[257 .. 262]), "ustar")
    test.eq_i64(c, rep, "NUL-terminated", b[262] as i64, 0)
    test.eq_str(c, rep, "version 00", from_utf8(b[263 .. 265]), "00")
    test.eq_str(c, rep, "the name", from_utf8(b[0 .. 5]), "f.txt")
    test.eq_i64(c, rep, "a regular file", b[156] as i64, tar.TAR_TYPE_FILE as i64)

    // **The reproducible defaults, asserted as bytes**, so an "improvement" that writes a real
    // mtime has to change this test on purpose.
    test.eq_str(c, rep, "mode 0644", from_utf8(b[100 .. 107]), "0000644")
    test.eq_str(c, rep, "uid 0", from_utf8(b[108 .. 115]), "0000000")
    test.eq_str(c, rep, "gid 0", from_utf8(b[116 .. 123]), "0000000")
    test.eq_str(c, rep, "size 3, octal", from_utf8(b[124 .. 135]), "00000000003")
    test.eq_str(c, rep, "mtime 0 — the whole point", from_utf8(b[136 .. 147]), "00000000000")
    test.eq_i64(c, rep, "uname is empty", b[265] as i64, 0)

    // The checksum field's shape: six octal digits, a NUL, then a space.
    test.eq_i64(c, rep, "the checksum ends NUL", b[154] as i64, 0)
    test.eq_i64(c, rep, "then a space", b[155] as i64, 32)

    // The body, and its padding zeroed to the block boundary.
    test.eq_str(c, rep, "the body", from_utf8(b[512 .. 515]), "abc")
    test.eq_i64(c, rep, "padded with zeros, not with whatever was there", b[515] as i64, 0)
    test.eq_usize(c, rep, "one header plus one block of body", tar.written(ar), 1024)

    // A directory has no body and its own mode.
    test.eq_i64(c, rep, "a directory is added", tar.add_dir(ar, b, "d/") as i64, tar.TAR_OK as i64)
    test.eq_i64(c, rep, "typed as a directory", b[1024 + 156] as i64, tar.TAR_TYPE_DIR as i64)
    test.eq_str(c, rep, "mode 0755", from_utf8(b[1024 + 100 .. 1024 + 107]), "0000755")
    test.eq_usize(c, rep, "and occupies one block", tar.written(ar), 1536)

    free_ptr(araw)
    free_ptr(sraw)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

@test fn entries_round_trip_and_a_corrupt_one_is_refused() -> bool {
    var raw: *mut u8 = alloc(u8, T_T_CAP)
    var rep: []u8 = slice(u8, raw, T_T_CAP)
    var c: test.Check = test.new()

    var sraw: *mut u8 = alloc(u8, 256)
    var scratch: []u8 = slice(u8, sraw, 256)
    var araw: *mut u8 = alloc(u8, 8192)
    var b: []u8 = slice(u8, araw, 8192)
    var ar: tar.Archive = tar.begin()
    let total: usize = build(ar, b, scratch)

    var e: tar.Entry = tar.empty_entry()
    test.eq_i64(c, rep, "the first entry reads", tar.read_entry(b, 0, e) as i64, tar.TAR_OK as i64)
    test.eq_str(c, rep, "its name", tar.entry_name(e, b), "greeting.txt")
    test.eq_str(c, rep, "its body", from_utf8(b[e.body_off .. e.body_off + e.body_len]), "hello world")

    test.eq_i64(c, rep, "the directory reads", tar.read_entry(b, e.next, e) as i64, tar.TAR_OK as i64)
    test.eq_str(c, rep, "its name", tar.entry_name(e, b), "docs/")
    test.eq_i64(c, rep, "typed as a directory", e.kind as i64, tar.TAR_TYPE_DIR as i64)
    test.eq_usize(c, rep, "with no body", e.body_len, 0)

    test.eq_i64(c, rep, "the third reads", tar.read_entry(b, e.next, e) as i64, tar.TAR_OK as i64)
    test.eq_str(c, rep, "its name", tar.entry_name(e, b), "docs/notes.md")
    test.eq_str(c, rep, "its body", from_utf8(b[e.body_off .. e.body_off + e.body_len]), "second file")

    // **The end marker is its own answer, not "bad".** A reader that could not tell them apart
    // would report every complete archive as corrupt.
    let after_last: usize = e.next
    test.eq_i64(c, rep, "then the end marker", tar.read_entry(b, after_last, e) as i64, tar.TAR_END as i64)
    // And the archive is exactly the entries plus the two zero blocks that close it.
    test.eq_usize(c, rep, "the archive ends two blocks past the last entry", total, after_last + 2 * tar.TAR_BLOCK)

    // Corrupt one byte of the first header's NAME. The checksum no longer matches, so the
    // entry is refused rather than extracting under a wrong filename — which is the whole
    // reason a reader verifies rather than trusting.
    b[2] = 88 as u8
    test.eq_i64(c, rep, "a corrupted header is refused", tar.read_entry(b, 0, e) as i64, tar.TAR_BAD as i64)

    // The refusals a writer makes, each one a refusal rather than a truncation.
    var ar2: tar.Archive = tar.begin()
    var long: *mut u8 = alloc(u8, 200)
    var lbuf: []u8 = slice(u8, long, 200)
    var i: usize = 0
    for i < 150 {
        lbuf[i] = 97 as u8
        i = i + 1
    }
    test.eq_i64(c, rep, "a name over 100 bytes is refused, not truncated",
        tar.add_file(ar2, b, from_utf8(lbuf[0 .. 150]), scratch[0 .. 0]) as i64, tar.TAR_NAME_TOO_LONG as i64)
    test.eq_i64(c, rep, "an empty name is refused",
        tar.add_file(ar2, b, "", scratch[0 .. 0]) as i64, tar.TAR_NAME_TOO_LONG as i64)
    free_ptr(long)

    // A buffer too small is a refusal, not an overrun.
    var tiny: *mut u8 = alloc(u8, 100)
    var tbuf: []u8 = slice(u8, tiny, 100)
    var ar3: tar.Archive = tar.begin()
    test.eq_i64(c, rep, "a buffer that cannot hold a header refuses",
        tar.add_file(ar3, tbuf, "x", scratch[0 .. 0]) as i64, tar.TAR_NO_ROOM as i64)
    free_ptr(tiny)

    free_ptr(araw)
    free_ptr(sraw)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}
