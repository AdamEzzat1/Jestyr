// examples/std/binned.jtr — the binned superaccumulator (CJC's defining determinism
// primitive), the chunk-count-independent reduction. Adding a value deposits its
// integer significand into its exponent bin; integer addition is exactly
// associative+commutative, so two accumulators filled from different *chunks* and
// then merged give a **bit-identical** result to one filled from the whole — the
// guarantee a naive/Kahan/pairwise sum cannot make.
//
// The finalize is also **correctly rounded** (round-to-nearest-even of the bins'
// exact value), which a naive float sum is not.
//
//   jestyrc run examples/std/binned.jtr   →   4, 4, 1, 1, 1, 1, 1
import "core"
import "io"

fn setf(p: *mut f64, i: i32, v: f64) { unsafe { (p + i).* = v } }
fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }

fn main() -> i32 {
    var buf: *mut f64 = alloc(f64, 4)
    setf(buf, 0, 1.0)
    setf(buf, 1, 1.0e16)
    setf(buf, 2, 0.0 - 1.0e16)
    setf(buf, 3, 3.0)
    var s: []f64 = slice(f64, buf, 4)

    // Whole: one accumulator over the entire slice.
    let whole: f64 = core.f64_binned_sum(s)
    io.print_f64(whole)                                  // 4

    // Chunked: two accumulators over the two halves, then merged.
    var a: [2048]i64 = core.binned_new()
    var b: [2048]i64 = core.binned_new()
    core.binned_add(a, 1.0)
    core.binned_add(a, 1.0e16)
    core.binned_add(b, 0.0 - 1.0e16)
    core.binned_add(b, 3.0)
    core.binned_merge(a, b)
    let chunked: f64 = core.binned_sum(a)
    io.print_f64(chunked)                                // 4

    // The two are bit-identical regardless of the split — the headline property.
    io.print_i32(b2i(core.f64_bits(whole) == core.f64_bits(chunked)))   // 1

    free_ptr(buf)

    // Correct rounding vs naive: 2^53 + 1 + 1 + 1. The exact sum is 2^53+3, which
    // sits exactly between the representable 2^53+2 and 2^53+4 → ties-to-even rounds
    // it to 2^53+4. Naive left-to-right summation instead absorbs each +1 into 2^53
    // (each step rounds back down) and yields 2^53. The binned finalize is *correctly
    // rounded*; naive is not.
    let p53: f64 = core.f64_from_bits((1076 as u64) << 52)   // 2^53
    var rb: *mut f64 = alloc(f64, 4)
    setf(rb, 0, p53)
    setf(rb, 1, 1.0)
    setf(rb, 2, 1.0)
    setf(rb, 3, 1.0)
    var rs: []f64 = slice(f64, rb, 4)

    let rounded: f64 = core.f64_binned_sum(rs)
    let naive: f64 = core.f64_sum(rs)
    let expected: f64 = p53 + 4.0                            // 2^53 + 4, exact
    io.print_i32(b2i(core.f64_bits(rounded) == core.f64_bits(expected)))   // 1
    io.print_i32(b2i(core.f64_bits(naive) == core.f64_bits(p53)))          // 1
    io.print_i32(b2i(core.f64_bits(rounded) != core.f64_bits(naive)))      // 1

    free_ptr(rb)

    // Per-bin overflow: 3000 × 1.0 all land in one exponent bin. 3000·2^52 ≈ 1.35e19
    // exceeds i64::MAX (≈9.22e18), so without the add-time carry the bin would wrap.
    // The cascading carry keeps it exact → 3000.0.
    var ov: [2048]i64 = core.binned_new()
    var k: i32 = 0
    for k < 3000 {
        core.binned_add(ov, 1.0)
        k = k + 1
    }
    let big: f64 = core.binned_sum(ov)
    io.print_i32(b2i(core.f64_bits(big) == core.f64_bits(3000.0)))   // 1

    return 0
}
