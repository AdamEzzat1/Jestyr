// examples/std/cgen.jtr — the P5 C backend, written *in Jestyr*. It imports the P2 parser (AST)
// and the P3 typeck (per-expr types + resolution records), then lowers the program to C —
// aiming to be **byte-identical** to the Rust reference `src/cgen.rs` (`cgen::emit`). This is the
// last and largest pass of the self-hosting port (ROADMAP workstream P); it is grown
// construct-by-construct, starting from `examples/hello.jtr`, mirroring `emit_program`'s exact
// section order (the emission ORDER is load-bearing for byte-identity).
//
// **Verification.** `jestyr_cgen_matches_reference` (`--features c-oracle`) builds this program,
// runs it on each corpus `.jtr` file, and diffs its stdout (the emitted C) line-for-line against
// `cgen::emit(&ast, &info)` — where `info` comes from the single-file `typeck::check`, so the
// reference's `#line` debug directives are empty (the unit-test path), and the target is the
// pure C text. A `CGEN_GOLDEN_DENYLIST` holds the files not yet covered; it shrinks per construct.
//
// Increment 1 (this file's current reach): `hello.jtr` — the prelude, one `fn main -> i32`, a
// `print_str("…")` intrinsic call, a string literal, and `return 0`. Everything else is denylisted.
import "mem"
import "intern"
import "fs"
import "env"
import "list"
import "tokens"
import "parser"
import "typeck"
import "ctfe"
import "escape"
import "sha256"
import "diag"
import "sink"

// ---- the fixed C prelude (mirrors Cgen::prelude) ----
// A FIXED header block: includes + the `jestyr_rt_*` runtime + the JestyrStr/String/Cow/Builder
// value types + the print/file-IO/argv intrinsics. Transcribed byte-for-byte from `cgen.rs`
// (Jestyr and Rust share the same string-escape conventions, so `"\\n"` here is a literal
// backslash-n in the emitted C, and `"\n"` is a real C-source line break — the double-transpile
// composes). The pthread/time/try_read/arena conditional blocks are only emitted when used;
// `hello` uses none, so they are elided (added back per construct as later files need them).
// Does the program use the bump-arena runtime — a `region` block, a region-scoped loop, or a
// value-level arena intrinsic? Gates the arena prelude block (mirrors `uses_arena`).
// Does the program call `try_read_file`? Gates its runtime helper + `JestyrResult_String`
// typedef so unrelated programs stay byte-identical (mirrors `uses_try_read`).
// Is `it` a `@test`/`@bench` item that the current mode does not emit? (Mirrors
// `Cgen::test_only_item`.) A `@test` is an ordinary fn with an attribute and there is
// no dead-code elimination, so in NON-test mode it and everything only it reaches
// used to land in every consumer of the module.
fn test_only_item(read p: parser.Parser, read src: str, read it: parser.ItemData, tmode: bool) -> bool {
    if tmode { return false }
    if item_has_attr(p, src, it, "test") { return true }
    return item_has_attr(p, src, it, "bench")
}

// Does expression span [s, e) lie inside such an item? The `uses_*` gates below scan
// the flat expression arena, so without this a `print_str` in a test body would still
// switch on the print runtime for every consumer. Span containment, matching the
// reference's `live` filter. (A `@test` takes no parameters, so its item span and its
// body span contain exactly the same expressions.)
fn in_skipped_test(read p: parser.Parser, read src: str, tmode: bool, s: usize, e: usize) -> bool {
    if tmode { return false }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if test_only_item(p, src, it, tmode) {
                if s >= it.start {
                    if e <= it.end { return true }
                }
            }
        }
        r = r + 1
    }
    return false
}

fn uses_try_read(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "try_read_file") { return true }
            }
        }
        i = i + 1
    }
    return false
}

// Does the program call `run_command` / `eprint_str`? Gates the driver-plumbing runtime
// helpers (mirrors `uses_run_command` / `uses_eprint`).
fn uses_run_command(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "run_command") { return true }
            }
        }
        i = i + 1
    }
    return false
}

fn uses_eprint(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
