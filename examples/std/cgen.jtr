}

// Does the program ask for the environment BLOCK? Gates the `environ` accessor
// (mirrors `uses_env_block`). Distinct from `uses_env_var`, which is a single lookup.
fn uses_env_block(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "env_block") { return true }
            }
        }
        i = i + 1
    }
    return false
}

// Does the program draw OS entropy? Gates the CSPRNG helper (mirrors `uses_random`).
fn uses_random(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "random_fill") { return true }
            }
        }
        i = i + 1
    }
    return false
}

// Does the program touch signals? ONE gate for all three names (mirrors `uses_signal`),
// because they are useless apart: arming without reading discards every delivery, reading
// without arming answers 0 forever, and raising without arming just kills the process.
// Three gates would let a program emit half the machinery.
fn uses_signal(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                let nm: str = src[callee.start .. callee.end]
                if str_eq(nm, "signal_arm") { return true }
                if str_eq(nm, "signal_caught") { return true }
                if str_eq(nm, "signal_raise") { return true }
            }
        }
        i = i + 1
    }
    return false
}

// Does the program call `env_var`? Gates its runtime helper (mirrors `uses_env_var`).
fn uses_env_var(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "env_var") { return true }
            }
        }
        i = i + 1
    }
    return false
}

// Does the program call `mono_nanos`? Gates its runtime helper AND <time.h>
// (mirrors `uses_mono_nanos`).
fn uses_mono_nanos(read p: parser.Parser, read src: str, tmode: bool) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 and !in_skipped_test(p, src, tmode, e.start, e.end) {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "mono_nanos") { return true }
            }
        }
        i = i + 1
    }
    return false
}

fn uses_arena(read p: parser.Parser, read src: str) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 43 { return true }               // a `region r { … }` block
        if e.kind == 31 {                             // a region-scoped scratch loop
            if list.get(i32, p.lar, (e.a + 2) as usize) >= 0 { return true }
        }
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                let nm: str = src[callee.start .. callee.end]
                if str_eq(nm, "arena_open") or str_eq(nm, "arena_alloc") or str_eq(nm, "arena_close") {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

fn emit_prelude(mut sb: String, read p: parser.Parser, read src: str, read g: Cg) {
    string_push(sb, "#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <assert.h>\n")
    var needs_pthread: bool = false
    if list.len(i32, g.sps) > 0 { needs_pthread = true }   // any spawn site
    if list.len(i32, g.pfs) > 0 { needs_pthread = true }   // a fused par-for makes its own threads
    if needs_pthread {                                // -> the pthread runtime
        string_push(sb, "#include <pthread.h>\n")
    }
    if g.tmode or uses_mono_nanos(p, src, g.tmode) {           // `@bench` timing via clock(); `mono_nanos`
        string_push(sb, "#include <time.h>\n")
    }
    // Headers named by `extern "<hdr>.h" fn …` — what makes that spelling mean what it
    // says. `emit_extern_protos` emits no prototype for such a declaration because the
    // header declares it; without this nothing made the header PRESENT, so the call was
    // an implicit declaration and its pointer return was truncated through `int`.
    // First-appearance order, deduplicated. The abi's INNER span is `(w,u)`, -1 absent.
    //
    // **Two passes, and `<winsock2.h>` goes in the first one.** `windows.h` pulls in the
    // Winsock 1.1 header, so including it first makes `winsock2.h` collide with what it has
    // already seen -- mingw downgrades that to `#warning Please include winsock2.h before
    // windows.h`, MSVC does not. `std/syserr` names `windows.h` and `std/sysnet` names
    // `winsock2.h`, so every program using both hit it. `seen_h` is shared across the two
    // passes, so pass 1 skips whatever pass 0 emitted and every other header keeps its
    // first-appearance position. Mirrors the reference's stable `sort_by_key`.
    var seen_h: String = string_new()
    var hpass: i32 = 0
    for hpass < 2 {
    var hr: i32 = 0
    for hr < list.len(i32, p.roots) {
        let hid: i32 = list.get(i32, p.roots, hr as usize)
        let hit: parser.ItemData = list.get(parser.ItemData, p.it, hid as usize)
        if hit.kind == 8 and hit.w >= 0 {
            if hit.u - hit.w >= 2 {
                if str_eq(src[(hit.u - 2) as usize .. hit.u as usize], ".h") {
                    let is_ws2: bool = str_eq(src[hit.w as usize .. hit.u as usize], "winsock2.h")
                    var want_now: bool = is_ws2
                    if hpass == 1 { want_now = !is_ws2 }
                    if want_now {
                    var probe_h: String = string_new()
                    string_push(probe_h, "|")
                    string_push(probe_h, src[hit.w as usize .. hit.u as usize])
                    string_push(probe_h, "|")
                    if !contains(string_view(seen_h), string_view(probe_h)) {
                        string_push(seen_h, string_view(probe_h))
                        // A header inherits the `@cfg` of the declarations that name it — and
                        // only when they ALL agree. `<dirent.h>` does not exist on Windows, so
                        // an unguarded `#include` of it would fail before the guarded `opendir`
                        // prototype was even reached; the include is the first thing that has to
                        // be conditional. Mixed cfgs (or any unguarded declaration) fall back to
                        // an unconditional include, because a header one platform needs
                        // unconditionally cannot be guarded away.
                        let hname: str = src[hit.w as usize .. hit.u as usize]
                        var hw: str = ""
                        var hfirst: bool = true
                        var hmixed: bool = false
                        var qr: i32 = 0
                        for qr < list.len(i32, p.roots) {
                            let qid: i32 = list.get(i32, p.roots, qr as usize)
                            let qit: parser.ItemData = list.get(parser.ItemData, p.it, qid as usize)
                            if qit.kind == 8 and qit.w >= 0 {
                                if qit.u - qit.w >= 2 {
                                    if str_eq(src[(qit.u - 2) as usize .. qit.u as usize], ".h") and str_eq(src[qit.w as usize .. qit.u as usize], hname) {
                                        let qw: str = cfg_word(p, src, qit.xat, qit.xac)
                                        if hfirst { hw = qw  hfirst = false }
                                        else if !str_eq(hw, qw) { hmixed = true }
                                    }
                                }
                            }
                            qr = qr + 1
                        }
                        if hmixed { hw = "" }
                        let hg: bool = cfg_open(sb, cfg_cond(hw))
                        string_push(sb, "#include <")
                        string_push(sb, hname)
                        string_push(sb, ">\n")
                        cfg_close(sb, hg)
                    }
                    string_free(probe_h)
                    }
                }
            }
        }
        hr = hr + 1
    }
    hpass = hpass + 1
    }
    string_free(seen_h)
    string_push(sb, "\n")
    string_push(sb, "/* Jestyr string view — a length-carrying `{ptr, len}` (a borrowed UTF-8 view,\n")
    string_push(sb, "   like Zig `[]const u8` / Rust `&str`). `.len` is O(1); no `strlen`. A bare\n")
    string_push(sb, "   `cstr` (null-terminated `const char*`) is the distinct C-interop type. */\n")
    string_push(sb, "typedef struct { const char* ptr; size_t len; } JestyrStr;\n")
    string_push(sb, "#define JSTR(s) ((JestyrStr){ (s), sizeof(s) - 1 })\n")
    string_push(sb, "/* O(n) codepoint count (vs O(1) `.len`): a UTF-8 leading byte is one whose top two bits aren't 10. */\n")
    string_push(sb, "static size_t jestyr_rt_count_cp(JestyrStr s) { size_t n = 0; for (size_t k = 0; k < s.len; k++) if (((uint8_t)s.ptr[k] & 0xC0u) != 0x80u) n++; return n; }\n")
    string_push(sb, "/* Simplified grapheme segmentation: a cluster is a base codepoint plus following combining marks (é = e + U+0301). ZWJ emoji sequences are not merged — full UAX#29 needs Unicode tables. */\n")
    string_push(sb, "static bool jestyr_rt_is_combining(uint32_t cp) { return (cp >= 0x0300u && cp <= 0x036Fu) || (cp >= 0x1AB0u && cp <= 0x1AFFu) || (cp >= 0x1DC0u && cp <= 0x1DFFu) || (cp >= 0x20D0u && cp <= 0x20FFu) || (cp >= 0xFE20u && cp <= 0xFE2Fu); }\n")
    string_push(sb, "/* Decode the UTF-8 codepoint at *k, advancing *k past it (replacement char on a bad lead byte). */\n")
    string_push(sb, "static uint32_t jestyr_rt_decode_cp(const char* p, size_t len, size_t* k) { size_t i = *k; uint8_t b = (uint8_t)p[i]; uint32_t cp; size_t n; if (b < 0x80u) { cp = b; n = 1; } else if ((b & 0xE0u) == 0xC0u) { cp = b & 0x1Fu; n = 2; } else if ((b & 0xF0u) == 0xE0u) { cp = b & 0x0Fu; n = 3; } else if ((b & 0xF8u) == 0xF0u) { cp = b & 0x07u; n = 4; } else { *k = i + 1; return 0xFFFDu; } for (size_t j = 1; j < n && i + j < len; j++) cp = (cp << 6) | ((uint8_t)p[i + j] & 0x3Fu); *k = i + n; return cp; }\n")
    string_push(sb, "/* O(n) grapheme-cluster count: base codepoints (combining marks attach to the preceding base). */\n")
    string_push(sb, "static size_t jestyr_rt_count_graphemes(JestyrStr s) { size_t k = 0, n = 0; while (k < s.len) { uint32_t cp = jestyr_rt_decode_cp(s.ptr, s.len, &k); if (!jestyr_rt_is_combining(cp)) n++; } return n; }\n")
    string_push(sb, "/* Validate a byte range as UTF-8 (used at the bytes->str boundary). */\n")
    string_push(sb, "static bool jestyr_rt_valid_utf8(const char* p, size_t len) { size_t k = 0; while (k < len) { uint8_t b = (uint8_t)p[k]; size_t n; if (b < 0x80u) n = 1; else if ((b & 0xE0u) == 0xC0u) n = 2; else if ((b & 0xF0u) == 0xE0u) n = 3; else if ((b & 0xF8u) == 0xF0u) n = 4; else return false; if (k + n > len) return false; for (size_t j = 1; j < n; j++) if (((uint8_t)p[k + j] & 0xC0u) != 0x80u) return false; k += n; } return true; }\n")
    string_push(sb, "/* A boundary-checked sub-view (Rust discipline): start<=end<=len, and both on UTF-8 char boundaries. Zero-copy. */\n")
    string_push(sb, "static bool jestyr_rt_is_boundary(JestyrStr s, size_t i) { return i == s.len || ((uint8_t)s.ptr[i] & 0xC0u) != 0x80u; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_substr(JestyrStr s, size_t start, size_t end) { assert(start <= end && end <= s.len); assert(jestyr_rt_is_boundary(s, start) && jestyr_rt_is_boundary(s, end)); return (JestyrStr){ s.ptr + start, end - start }; }\n")
    string_push(sb, "/* Byte-level string operations: equality, prefix/suffix, search, trim. All view-based (find/trim are zero-copy). */\n")
    string_push(sb, "static bool jestyr_rt_str_eq(JestyrStr a, JestyrStr b) { return a.len == b.len && memcmp(a.ptr, b.ptr, a.len) == 0; }\n")
    string_push(sb, "static bool jestyr_rt_starts_with(JestyrStr s, JestyrStr p) { return s.len >= p.len && memcmp(s.ptr, p.ptr, p.len) == 0; }\n")
    string_push(sb, "static bool jestyr_rt_ends_with(JestyrStr s, JestyrStr p) { return s.len >= p.len && memcmp(s.ptr + (s.len - p.len), p.ptr, p.len) == 0; }\n")
    string_push(sb, "static int64_t jestyr_rt_find(JestyrStr s, JestyrStr n) { if (n.len == 0) return 0; if (n.len > s.len) return -1; for (size_t i = 0; i + n.len <= s.len; i++) if (memcmp(s.ptr + i, n.ptr, n.len) == 0) return (int64_t)i; return -1; }\n")
    string_push(sb, "static bool jestyr_rt_contains(JestyrStr s, JestyrStr n) { return jestyr_rt_find(s, n) >= 0; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_trim(JestyrStr s) { size_t a = 0, b = s.len; while (a < b) { char c = s.ptr[a]; if (c==' '||c=='\\t'||c=='\\n'||c=='\\r') a++; else break; } while (b > a) { char c = s.ptr[b-1]; if (c==' '||c=='\\t'||c=='\\n'||c=='\\r') b--; else break; } return (JestyrStr){ s.ptr + a, b - a }; }\n")
    string_push(sb, "/* ASCII case-insensitive equality — the opt-in normalization-aware compare. Full Unicode case-folding / NFC normalization needs the Unicode tables (deferred). */\n")
    string_push(sb, "static char jestyr_rt_ascii_lower(char c) { return (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c; }\n")
    string_push(sb, "static bool jestyr_rt_eq_fold(JestyrStr a, JestyrStr b) { if (a.len != b.len) return false; for (size_t i = 0; i < a.len; i++) if (jestyr_rt_ascii_lower(a.ptr[i]) != jestyr_rt_ascii_lower(b.ptr[i])) return false; return true; }\n\n")
    string_push(sb, "/* Jestyr owned String — a heap-owned, growable buffer (the owned half of the\n")
    string_push(sb, "   owned/view split). `string_view` borrows it as a `str` view; no copy. */\n")
    string_push(sb, "typedef struct { char* ptr; size_t len; size_t cap; } JestyrString;\n")
    string_push(sb, "static JestyrString jestyr_rt_str_new(void) { JestyrString s; s.ptr = NULL; s.len = 0; s.cap = 0; return s; }\n")
    string_push(sb, "static JestyrString jestyr_rt_str_from(JestyrStr v) { JestyrString s; s.cap = v.len ? v.len : 1; s.ptr = (char*)malloc(s.cap); memcpy(s.ptr, v.ptr, v.len); s.len = v.len; return s; }\n")
    string_push(sb, "static void jestyr_rt_str_push(JestyrString* s, JestyrStr v) { if (s->len + v.len > s->cap) { size_t nc = s->cap ? s->cap * 2 : 8; while (nc < s->len + v.len) nc *= 2; s->ptr = (char*)realloc(s->ptr, nc); s->cap = nc; } memcpy(s->ptr + s->len, v.ptr, v.len); s->len += v.len; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_str_view(JestyrString* s) { return (JestyrStr){ s->ptr, s->len }; }\n")
    string_push(sb, "static void jestyr_rt_str_free(JestyrString* s) { free(s->ptr); s->ptr = NULL; s->len = 0; s->cap = 0; }\n")
    string_push(sb, "/* Append an integer's decimal digits (for f-string interpolation; copies). */\n")
    string_push(sb, "static void jestyr_rt_str_push_i64(JestyrString* s, int64_t v) { char b[24]; int n = snprintf(b, sizeof(b), \"%lld\", (long long)v); if (n < 0) n = 0; jestyr_rt_str_push(s, (JestyrStr){ b, (size_t)n }); }\n")
    string_push(sb, "/* Lossily decode unvalidated platform text (os_str) into a proven UTF-8 String, replacing each ill-formed byte with U+FFFD. */\n")
    string_push(sb, "/* Cow<str>: borrowed-or-owned, visible. cap==0 means borrowed (no allocation, free is a no-op); cap>0 means owned. cow_to_mut is the copy-on-write point. */\n")
    string_push(sb, "typedef struct { char* ptr; size_t len; size_t cap; } JestyrCow;\n")
    string_push(sb, "static JestyrCow jestyr_rt_cow_borrow(JestyrStr v) { JestyrCow c; c.ptr = (char*)v.ptr; c.len = v.len; c.cap = 0; return c; }\n")
    string_push(sb, "static bool jestyr_rt_cow_is_owned(JestyrCow c) { return c.cap > 0; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_cow_view(JestyrCow c) { return (JestyrStr){ c.ptr, c.len }; }\n")
    string_push(sb, "static JestyrCow jestyr_rt_cow_to_mut(JestyrCow c) { if (c.cap > 0) return c; JestyrCow o; o.cap = c.len ? c.len : 1; o.ptr = (char*)malloc(o.cap); memcpy(o.ptr, c.ptr, c.len); o.len = c.len; return o; }\n")
    string_push(sb, "static void jestyr_rt_cow_free(JestyrCow* c) { if (c->cap > 0) free(c->ptr); c->ptr = NULL; c->len = 0; c->cap = 0; }\n")
    string_push(sb, "static JestyrString jestyr_rt_to_str_lossy(JestyrStr os) { JestyrString out = jestyr_rt_str_new(); size_t k = 0; while (k < os.len) { uint8_t b = (uint8_t)os.ptr[k]; size_t n; bool ok = true; if (b < 0x80u) n = 1; else if ((b & 0xE0u) == 0xC0u) n = 2; else if ((b & 0xF0u) == 0xE0u) n = 3; else if ((b & 0xF8u) == 0xF0u) n = 4; else { ok = false; n = 1; } if (ok && k + n <= os.len) { for (size_t j = 1; j < n; j++) if (((uint8_t)os.ptr[k + j] & 0xC0u) != 0x80u) { ok = false; break; } } else if (n > 1) ok = false; if (ok) { jestyr_rt_str_push(&out, (JestyrStr){ os.ptr + k, n }); k += n; } else { jestyr_rt_str_push(&out, (JestyrStr){ \"\\xEF\\xBF\\xBD\", 3 }); k += 1; } } return out; }\n\n")
    string_push(sb, "/* Jestyr Builder — an iolist: a list of `str` *fragments* collected with no\n")
    string_push(sb, "   copying; `builder_build` sums the lengths, allocates once, and flattens in a\n")
    string_push(sb, "   single pass (Erlang iodata). Fragments must outlive the build. */\n")
    string_push(sb, "typedef struct { JestyrStr* frags; size_t n; size_t cap; } JestyrBuilder;\n")
    string_push(sb, "static JestyrBuilder jestyr_rt_b_new(void) { JestyrBuilder b; b.frags = NULL; b.n = 0; b.cap = 0; return b; }\n")
    string_push(sb, "static void jestyr_rt_b_push(JestyrBuilder* b, JestyrStr v) { if (b->n == b->cap) { size_t nc = b->cap ? b->cap * 2 : 8; b->frags = (JestyrStr*)realloc(b->frags, nc * sizeof(JestyrStr)); b->cap = nc; } b->frags[b->n++] = v; }\n")
    string_push(sb, "static JestyrString jestyr_rt_b_build(JestyrBuilder* b) { size_t total = 0; for (size_t i = 0; i < b->n; i++) total += b->frags[i].len; JestyrString s; s.cap = total ? total : 1; s.ptr = (char*)malloc(s.cap); s.len = total; size_t off = 0; for (size_t i = 0; i < b->n; i++) { memcpy(s.ptr + off, b->frags[i].ptr, b->frags[i].len); off += b->frags[i].len; } return s; }\n")
    string_push(sb, "static void jestyr_rt_b_free(JestyrBuilder* b) { free(b->frags); b->frags = NULL; b->n = 0; b->cap = 0; }\n\n")
    string_push(sb, "/* Jestyr runtime prelude — temporary print intrinsics (stand-in for a stdlib). */\n")
    string_push(sb, "static void jestyr_rt_print_int(int64_t x) { printf(\"%lld\\n\", (long long) x); }\n")
    string_push(sb, "static void jestyr_rt_print_float(double x) { printf(\"%g\\n\", x); }\n")
    string_push(sb, "static void jestyr_rt_print_str(JestyrStr s) { printf(\"%.*s\\n\", (int) s.len, s.ptr); }\n")
    string_push(sb, "static void jestyr_rt_print_bool(bool b) { printf(\"%s\\n\", b ? \"true\" : \"false\"); }\n\n")
    if uses_eprint(p, src, g.tmode) {
        string_push(sb, "/* Stderr line print (driver diagnostics) — same shape as print_str, other stream. */\n")
        string_push(sb, "static void jestyr_rt_eprint_str(JestyrStr s) { fprintf(stderr, \"%.*s\\n\", (int) s.len, s.ptr); }\n\n")
    }
    string_push(sb, "/* Jestyr file I/O (self-hosting plumbing): whole-file read/write. A `str` path\n")
    string_push(sb, "   is a {ptr,len} view (not NUL-terminated), so each call copies it into a\n")
    string_push(sb, "   NUL-terminated temporary for libc. Binary mode + whole-file-at-once = no\n")
    string_push(sb, "   buffering or newline-translation surprises (deterministic across platforms). */\n")
    string_push(sb, "static char* jestyr_rt_cpath(JestyrStr p) { char* c = (char*)malloc(p.len + 1); memcpy(c, p.ptr, p.len); c[p.len] = '\\0'; return c; }\n")
    string_push(sb, "static JestyrString jestyr_rt_read_file(JestyrStr path) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); JestyrString s = jestyr_rt_str_new(); if (!f) return s; if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return s; } long sz = ftell(f); if (sz < 0) { fclose(f); return s; } rewind(f); size_t cap = (size_t)sz ? (size_t)sz : 1; s.ptr = (char*)malloc(cap); s.cap = cap; s.len = fread(s.ptr, 1, (size_t)sz, f); fclose(f); return s; }\n")
    string_push(sb, "static bool jestyr_rt_write_file(JestyrStr path, JestyrStr data) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"wb\"); free(cp); if (!f) return false; size_t put = data.len ? fwrite(data.ptr, 1, data.len, f) : 0; int rc = fclose(f); return rc == 0 && put == data.len; }\n")
    string_push(sb, "static bool jestyr_rt_file_exists(JestyrStr path) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); if (f) { fclose(f); return true; } return false; }\n")
    string_push(sb, "static bool jestyr_rt_remove_file(JestyrStr path) { char* cp = jestyr_rt_cpath(path); int rc = remove(cp); free(cp); return rc == 0; }\n")
    // Recoverable read (B3): emitted ONLY when `try_read_file` is used, so a program that
    // doesn't use it stays byte-identical.
    if uses_try_read(p, src, g.tmode) {
        string_push(sb, "/* Recoverable whole-file read: false on open/seek failure (the `String !IoError` err branch). */\n")
        string_push(sb, "static bool jestyr_rt_try_read_file(JestyrStr path, JestyrString* out) { *out = jestyr_rt_str_new(); char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); if (!f) return false; if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return false; } long sz = ftell(f); if (sz < 0) { fclose(f); return false; } rewind(f); size_t cap = (size_t)sz ? (size_t)sz : 1; out->ptr = (char*)malloc(cap); out->cap = cap; out->len = fread(out->ptr, 1, (size_t)sz, f); fclose(f); return true; }\n")
    }
    // Driving an external command (the self-hosted driver's gcc invocation) — on use only.
    if uses_run_command(p, src, g.tmode) {
        string_push(sb, "/* Run an external command via system(), returning the EXIT CODE on every platform. */\n")
        // `system()`'s value is not portable: Windows gives the exit code, POSIX a
        // wait status with the code in the high byte, so `exit 3` was 3 vs 768. Only
        // zero coincided. Normalised HERE because the library cannot see which
        // platform it is on -- the intrinsic is the platform boundary. `-1` means
        // "did not exit normally", distinguishable from any real code (0..255).
        string_push(sb, "#if defined(_WIN32)\n")
        string_push(sb, "static int32_t jestyr_rt_run_command(JestyrStr cmd) { char* cp = jestyr_rt_cpath(cmd); int rc = system(cp); free(cp); return (int32_t)rc; }\n")
        string_push(sb, "#else\n")
        string_push(sb, "#include <sys/wait.h>\n")
        string_push(sb, "static int32_t jestyr_rt_run_command(JestyrStr cmd) { char* cp = jestyr_rt_cpath(cmd); int rc = system(cp); free(cp); if (rc == -1) return -1; return WIFEXITED(rc) ? (int32_t)WEXITSTATUS(rc) : -1; }\n")
        string_push(sb, "#endif\n")
    }
    // The environment BLOCK -- the `char**` a child needs to inherit the whole
    // environment, as opposed to `env_var`'s single lookup. This is the one thing `extern`
    // cannot reach: it binds FUNCTIONS, and `environ` is data. The `extern char** environ`
    // declaration therefore lives in the emitted C, where the standard puts it.
    //
    // Windows returns NULL deliberately rather than reaching for `_environ`: NULL is what
    // CreateProcessA already reads as "inherit", so the platforms agree on the CALL rather
    // than on the pointer.
    if uses_env_block(p, src, g.tmode) {
        string_push(sb, "/* The environment block: what a child needs to inherit the whole environment. */\n")
        string_push(sb, "#if defined(_WIN32)\n")
        string_push(sb, "static void* jestyr_rt_env_block(void) { return NULL; }\n")
        string_push(sb, "#else\n")
        string_push(sb, "extern char** environ;\n")
        string_push(sb, "static void* jestyr_rt_env_block(void) { return (void*)environ; }\n")
        string_push(sb, "#endif\n")
    }
    // Cryptographically secure randomness, straight from the OS. NOT a PRNG: no seed, no
    // state, nothing to reseed. A seeded generator in a library is how key material ends
    // up predictable, and Jestyr has no module-level state to keep a seed in anyway.
    //
    // The VALUE comes back through a pointer and the return is a bool, which is not
    // decoration: a `-> i64` shape cannot report failure, because 0 is a legal random
    // draw. A sentinel a legal value can equal is not a sentinel.
    //
    // Windows `rand_s` is documented as cryptographically secure (it calls RtlGenRandom)
    // and lives in the CRT, so it needs no extra link library and therefore no change to
    // the LOCKED cc-flags every attest manifest records. Declared BY HAND rather than by
    // defining _CRT_RAND_S, which must precede <stdlib.h> -- already included above.
    if uses_random(p, src, g.tmode) {
        string_push(sb, "/* OS entropy. Not a PRNG: no seed, no state. */\n")
        string_push(sb, "#if defined(_WIN32)\n")
        string_push(sb, "int rand_s(unsigned int*);\n")
        string_push(sb, "static bool jestyr_rt_os_rand32(uint32_t* out) { unsigned int v = 0; if (rand_s(&v) != 0) return false; *out = (uint32_t)v; return true; }\n")
        string_push(sb, "#else\n")
        string_push(sb, "static bool jestyr_rt_os_rand32(uint32_t* out) { FILE* f = fopen(\"/dev/urandom\", \"rb\"); if (!f) return false; size_t n = fread(out, 1, 4, f); fclose(f); return n == 4; }\n")
        string_push(sb, "#endif\n")
        string_push(sb, "static bool jestyr_rt_random_fill(int64_t* out) { uint32_t a = 0, b = 0; if (!jestyr_rt_os_rand32(&a)) return false; if (!jestyr_rt_os_rand32(&b)) return false; *out = (int64_t)(((uint64_t)a << 32) | (uint64_t)b); return true; }\n")
    }
    // Signal delivery -- the one place the language's "no module-level mutable state"
    // rule cannot hold, because the OS fixes the handler's signature and it has nowhere
    // to put a context pointer. A handler may touch only a `volatile sig_atomic_t`, and
    // Jestyr has no spelling for one: it has no module-level `var`, and its `extern` binds
    // FUNCTIONS rather than globals, with no external symbol serving as a user flag
    // either. So the flag is emitted HERE, where it can be given exactly the type the C
    // standard requires, and the language keeps its rule.
    //
    // `signal()` rather than `sigaction()`: it is C89 and works on the Windows CRT, so
    // SIGINT and SIGTERM are reachable on both platforms with no `@cfg` split. `sigaction`
    // would cost a `struct sigaction` whose layout differs per libc -- the guessed-layout
    // claim `std/sysdir` refuses to make.
    if uses_signal(p, src, g.tmode) {
        string_push(sb, "/* Signal delivery: the flag a handler may legally write, and a way to read it. */\n")
        string_push(sb, "#include <signal.h>\n")
        string_push(sb, "static volatile sig_atomic_t jestyr_rt_sigflag = 0;\n")
        string_push(sb, "static void jestyr_rt_sighandler(int s) { jestyr_rt_sigflag = (sig_atomic_t)s; }\n")
        string_push(sb, "static bool jestyr_rt_signal_arm(int32_t s) { return signal((int)s, jestyr_rt_sighandler) != SIG_ERR; }\n")
        string_push(sb, "static int32_t jestyr_rt_signal_caught(void) { return (int32_t)jestyr_rt_sigflag; }\n")
        string_push(sb, "static bool jestyr_rt_signal_raise(int32_t s) { return raise((int)s) == 0; }\n")
    }
    // Environment lookup. The name must be NUL-terminated for getenv, so it goes
    // through `cpath`; the RESULT is OS-owned storage, returned as a borrowed
    // view (never freed here), exactly like argv in `arg`.
    if uses_env_var(p, src, g.tmode) {
        string_push(sb, "/* getenv() as a str view; empty when unset. Storage is the environment's. */\n")
        string_push(sb, "static JestyrStr jestyr_rt_env_var(JestyrStr name) { char* cn = jestyr_rt_cpath(name); const char* v = getenv(cn); free(cn); if (!v) return (JestyrStr){ \"\", 0 }; return (JestyrStr){ v, strlen(v) }; }\n")
    }
    // A monotonic nanosecond counter. CLOCK_MONOTONIC never jumps with the wall
    // clock, so a difference is a real elapsed duration; the origin is
    // unspecified, which is why only differences are meaningful.
    if uses_mono_nanos(p, src, g.tmode) {
        string_push(sb, "/* Monotonic nanoseconds. Only DIFFERENCES are meaningful (origin unspecified). */\n")
        string_push(sb, "static int64_t jestyr_rt_mono_nanos(void) { struct timespec _ts; clock_gettime(CLOCK_MONOTONIC, &_ts); return (int64_t)_ts.tv_sec * 1000000000 + (int64_t)_ts.tv_nsec; }\n")
    }
    string_push(sb, "\n")
    string_push(sb, "/* Command-line arguments (self-hosting plumbing): argv is captured in main()\n")
    string_push(sb, "   into file-scope globals, exposed to Jestyr as arg_count() -> i32 and\n")
    string_push(sb, "   arg(i) -> str (a zero-copy view into argv[i]; out-of-range yields empty).\n")
    string_push(sb, "   arg(0) is the program path. argv strings are NUL-terminated, OS-owned. */\n")
    string_push(sb, "static int jestyr_rt_argc = 0;\n")
    string_push(sb, "static char** jestyr_rt_argv = NULL;\n")
    string_push(sb, "static int64_t jestyr_rt_arg_count(void) { return (int64_t)jestyr_rt_argc; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_arg(int64_t i) { if (i < 0 || i >= (int64_t)jestyr_rt_argc) return (JestyrStr){ \"\", 0 }; const char* a = jestyr_rt_argv[i]; size_t n = 0; while (a[n]) n++; return (JestyrStr){ a, n }; }\n\n")
    if uses_arena(p, src) {
        string_push(sb, "/* Jestyr bump arena — backs region refs (`&[r]T`) and the std arena allocator. */\n")
        string_push(sb, "typedef struct { char* buf; size_t off; size_t cap; } JestyrArena;\n")
        string_push(sb, "static JestyrArena jestyr_arena_new(size_t cap) { JestyrArena a; a.buf = (char*)malloc(cap); a.off = 0; a.cap = cap; return a; }\n")
        string_push(sb, "static void* jestyr_arena_alloc(JestyrArena* a, size_t n) { size_t al = (n + 7u) & ~(size_t)7u; void* p = a->buf + a->off; a->off += al; return p; }\n")
        string_push(sb, "static void jestyr_arena_free(JestyrArena* a) { free(a->buf); }\n\n")
    }
}

// ---- primitive type -> C type (mirrors the prim arm of Cgen::c_type) ----
// Increment 1 covers the integer/float/bool/unit prims. Structural types (str, slices, pointers,
// named aggregates) are added as later files need them.
fn c_prim(read name: str) -> str {
    if str_eq(name, "i8") { return "int8_t" }
    if str_eq(name, "i16") { return "int16_t" }
    if str_eq(name, "i32") { return "int32_t" }
    if str_eq(name, "i64") { return "int64_t" }
    if str_eq(name, "u8") { return "uint8_t" }
    if str_eq(name, "u16") { return "uint16_t" }
    if str_eq(name, "u32") { return "uint32_t" }
    if str_eq(name, "u64") { return "uint64_t" }
    if str_eq(name, "usize") { return "size_t" }
    if str_eq(name, "isize") { return "intptr_t" }
    if str_eq(name, "f32") { return "float" }
    if str_eq(name, "f64") { return "double" }
    if str_eq(name, "bool") { return "bool" }
    if str_eq(name, "char") { return "uint32_t" }
    if str_eq(name, "str") { return "JestyrStr" }
    if str_eq(name, "os_str") { return "JestyrStr" }
    if str_eq(name, "cstr") { return "const char*" }
    if str_eq(name, "cptr") { return "void*" }         // opaque FFI handle; agrees with <stdio.h>
    if str_eq(name, "String") { return "JestyrString" }
    if str_eq(name, "Builder") { return "JestyrBuilder" }
    if str_eq(name, "Cow") { return "JestyrCow" }
    return ""                                          // not a primitive
}

// A type node (`TypeId`) rendered as its C type, pushed onto `sb` (a user type needs the runtime
// `Jestyr_<name>` concatenation, so this writes rather than returns). Increment 4 covers primitive
// Name types and user Name types (distinct/struct/enum -> `Jestyr_<name>`). Structural forms
// (str, slices, pointers, App/Path) are added as later files need them. `tyid` < 0 is unit (void).
fn emit_c_ty(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    if tyid < 0 { string_push(sb, "void")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {                                   // Name
        let nm: str = src[t.start .. t.end]
        let pc: str = c_prim(nm)
        if !str_eq(pc, "") { string_push(sb, pc)  return }
        // a niche-optimized enum lowers to its bare pointer payload
        let nvb: i32 = niche_named_some(p, find_enum_item(p, src, t.start, t.end))
        if nvb >= 0 {
            emit_c_ty(sb, p, src, list.get(i32, p.ear, (list.get(i32, p.ear, (nvb + 2) as usize) + 2) as usize))
            return
        }
        // a DECLARED user type lowers to its `Jestyr_<name>` typedef; an unresolved name
        // (an import's type in the single-file golden path) degenerates to `int`, exactly
        // like the reference's external-type diag arm.
        if find_named_item(p, src, t.start as i32, t.end as i32) >= 0 {
            string_push(sb, "Jestyr_")
            string_push(sb, nm)
            return
        }
        string_push(sb, "int")
        return
    }
    if t.kind == 2 {                                   // Ptr: `<inner>*`
        emit_c_ty(sb, p, src, t.a)
        string_push(sb, "*")
        return
    }
    if t.kind == 3 {                                   // Slice: `JestyrSlice_<mangle>`
        string_push(sb, "JestyrSlice_")
        push_ast_mangle(sb, p, src, t.a)
        return
    }
    if t.kind == 4 {                                   // Array `[N]T`: `JestyrArr_<mangle>_<N>`
        string_push(sb, "JestyrArr_")
        push_ast_mangle(sb, p, src, t.a)               // a = elem
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)                // b = len ExprId
        return
    }
    if t.kind == 5 {                                   // GenRef `&T`: `JestyrRef_<elem mangle>`
        string_push(sb, "JestyrRef_")
        push_ast_mangle(sb, p, src, t.a)
        return
    }
    if t.kind == 6 {                                   // RegionRef `&[r]T`: zero-cost plain pointer
        emit_c_ty(sb, p, src, t.a)
        string_push(sb, "*")
        return
    }
    if t.kind == 9 {                                   // Fn: its `JestyrFn_<sig>` typedef name
        string_push(sb, "JestyrFn_")
        push_ast_mangle(sb, p, src, tyid)
        return
    }
    if t.kind == 10 {                                  // `dyn Trait`: the fat-pointer typedef
        string_push(sb, "JestyrDyn_")
        string_push(sb, src[t.x as usize .. t.y as usize])
        return
    }
    if t.kind == 7 {                                   // App `Ctor(args)`: `Jestyr_<ctor>__<args>`
        let apay: i32 = niche_app_pay(p, src, t)       // `Option(*T)` written as an annotation
        if apay >= 0 {
            emit_c_ty(sb, p, src, apay)
            return
        }
        string_push(sb, "Jestyr_")
        string_push(sb, src[t.x as usize .. t.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < t.a {                                  // (op,a) = arg slice of TypeIds in tar
            if i > 0 { string_push(sb, "_") }
            push_ast_mangle(sb, p, src, list.get(i32, p.tar, (t.op + i) as usize))
            i = i + 1
        }
        return
    }
    if t.kind == 8 {                                   // Path `mod.Type(args)` — degenerate in the
        if t.a == 0 {                                  // single-file path, like the reference:
            if find_named_item(p, src, t.z, t.w) >= 0 {   // a LOCAL type of that name wins,
                string_push(sb, "Jestyr_")
                string_push(sb, src[t.z as usize .. t.w as usize])
            } else {
                string_push(sb, "int")                 // else the external-type `int`
            }
            return
        }
        string_push(sb, "Jestyr_")                     // with args: the instance's C name
        string_push(sb, src[t.z as usize .. t.w as usize])
        string_push(sb, "__")
        var pi8: i32 = 0
        for pi8 < t.a {
            if pi8 > 0 { string_push(sb, "_") }
            push_ast_mangle(sb, p, src, list.get(i32, p.tar, (t.op + pi8) as usize))
            pi8 = pi8 + 1
        }
        return
    }
    string_push(sb, "void")                            // TODO: dyn-in-ast etc.
}

// An array length expression rendered as its literal digits (`[5]T` -> `5`). Array lengths are
// constant expressions; an integer literal is the case the backend supports.
fn push_array_len(mut sb: String, read p: parser.Parser, read src: str, len_eid: i32) {
    if len_eid < 0 { string_push(sb, "0")  return }
    let l: parser.ExprData = list.get(parser.ExprData, p.ex, len_eid as usize)
    if l.kind != 0 {
        // The length is part of the emitted C TYPE NAME (`JestyrArr_i32_4`), so it has to
        // be a number here — the C compiler never sees the expression. Anything that is
        // not a literal goes through the comptime interpreter, and an unevaluable length
        // still yields 0 so emission stays total (typeck has already reported it).
        var lci: ctfe.Interp = ctfe.make(mem.system_allocator())
        let n: i64 = ctfe.eval_usize(lci, p, src, len_eid)
        if n < 0 { string_push(sb, "0") } else { push_uint(sb, n) }
        return
    }
    emit_int_literal(sb, src[l.start .. l.end])
}

// The mangle suffix of an AST type node (mirrors `ty_mangle` for the forms handled so far:
// a Name is its source text — prim or declared; a Ptr is `ptr_<inner>`).
fn push_ast_mangle(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 { string_push(sb, src[t.start .. t.end])  return }
    if t.kind == 2 { string_push(sb, "ptr_")  push_ast_mangle(sb, p, src, t.a)  return }
    if t.kind == 3 { string_push(sb, "slice_")  push_ast_mangle(sb, p, src, t.a)  return }
    if t.kind == 5 { string_push(sb, "ref_")  push_ast_mangle(sb, p, src, t.a)  return }   // GenRef
    if t.kind == 9 {                                   // Fn: `fn_<tag><ty>…_ret_<ty>` (conv-tagged params)
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < t.a {                                  // (op,a) = (conv,TypeId) pair slice in tar
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, p.tar, (t.op + i * 2) as usize))
            push_ast_mangle(sb, p, src, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, "_ret_")
        if t.x >= 0 { push_ast_mangle(sb, p, src, t.x) } else { string_push(sb, "unit") }
        return
    }
    if t.kind == 4 {                                   // Array: `arr_<elem>_<len>`
        string_push(sb, "arr_")
        push_ast_mangle(sb, p, src, t.a)
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)
        return
    }
    if t.kind == 8 { string_push(sb, src[t.z as usize .. t.w as usize])  return }   // Path: its name
    string_push(sb, "?")
}

// A fn-type param convention's one-letter mangle tag (a `mut`/`out` param lowers to `T*`, a
// different C type — the tag keeps such signatures distinct). Mirrors the `ty_mangle` Fn arm.
fn push_conv_tag(mut sb: String, conv: i32) {
    if conv == 1 { string_push(sb, "r")  return }
    if conv == 2 { string_push(sb, "m")  return }
    if conv == 3 { string_push(sb, "t")  return }
    if conv == 4 { string_push(sb, "o")  return }
    string_push(sb, "d")
}

// A primitive type CODE (typeck's `prim_name` numbering) rendered as its C type. Used by
// `emit_ty_c` when the Checker gives an inferred primitive type.
fn prim_code_c(mut sb: String, code: i32) {
    if code == 0 { string_push(sb, "int8_t")  return }
    if code == 1 { string_push(sb, "int16_t")  return }
    if code == 2 { string_push(sb, "int32_t")  return }
    if code == 3 { string_push(sb, "int64_t")  return }
    if code == 4 { string_push(sb, "intptr_t")  return }
    if code == 5 { string_push(sb, "uint8_t")  return }
    if code == 6 { string_push(sb, "uint16_t")  return }
    if code == 7 { string_push(sb, "uint32_t")  return }
    if code == 8 { string_push(sb, "uint64_t")  return }
    if code == 9 { string_push(sb, "size_t")  return }
    if code == 10 { string_push(sb, "float")  return }
    if code == 11 { string_push(sb, "double")  return }
    if code == 12 { string_push(sb, "bool")  return }
    if code == 13 { string_push(sb, "uint32_t")  return }   // char
    if code == 14 { string_push(sb, "JestyrStr")  return }  // str
    if code == 15 { string_push(sb, "const char*")  return } // cstr
    // The same truncation as `prim_jname`, in the C-TYPE table rather than the mangle one —
    // they are the pair that must agree, and both stopped at 15 while `typeck.prim_code`
    // reaches 21. Spellings are the reference's (`os_str` is structurally a view, so
    // `JestyrStr`; `cptr` is `void*`).
    if code == 16 { string_push(sb, "JestyrStr")  return }      // os_str
    if code == 17 { string_push(sb, "JestyrString")  return }
    if code == 18 { string_push(sb, "JestyrBuilder")  return }
    if code == 19 { string_push(sb, "JestyrCow")  return }
    if code == 21 { string_push(sb, "void*")  return }          // cptr
    string_push(sb, "void")
}

// A Checker per-expr type (a `TyId` into `c.tys`) rendered as its C type, mirroring `cgen::c_type`.
// Used for inferred-`let` locals (`let x = …` with no annotation). Covers Unit, primitives, and
// Named aggregates (`Jestyr_<name>`, name span in the `tdecl` row `d.x`: cols 0/1). Other TyData
// kinds (Ptr/Slice/GenStruct/Fn/…) are added when a corpus file's inference needs them.
fn emit_ty_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32) {
    if tyid < 0 { string_push(sb, "void")  return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    if d.kind == 1 { string_push(sb, "void")  return }         // Unit
    if d.kind == 2 { prim_code_c(sb, d.x)  return }            // Prim
    if d.kind == 15 {                                          // Named: Jestyr_<name>
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        // a niche-optimized enum IS its bare pointer payload
        let nvb: i32 = niche_named_some(p, find_enum_item(p, src, ns as usize, ne as usize))
        if nvb >= 0 {
            emit_c_ty(sb, p, src, list.get(i32, p.ear, (list.get(i32, p.ear, (nvb + 2) as usize) + 2) as usize))
            return
        }
        string_push(sb, "Jestyr_")
        string_push(sb, src[ns as usize .. ne as usize])
        return
    }
    if d.kind == 3 {                                           // Ptr: `<inner>*`
        emit_ty_c(sb, p, src, c, d.a)
        string_push(sb, "*")
        return
    }
    if d.kind == 8 {                                           // Slice: `JestyrSlice_<mangle>`
        string_push(sb, "JestyrSlice_")
        push_ty_mangle(sb, src, c, d.a)
        return
    }
    if d.kind == 9 {                                           // Array: `JestyrArr_<mangle>_<N>`
        string_push(sb, "JestyrArr_")
        push_ty_mangle(sb, src, c, d.a)                        // a = elem
        string_push(sb, "_")
        push_uint(sb, d.b as i64)                              // b = length
        return
    }
    if d.kind == 5 {                                           // Result `T!`: `JestyrResult_<mangle(ok)>`
        string_push(sb, "JestyrResult_")
        push_ty_mangle(sb, src, c, d.a)                        // a = ok type
        return
    }
    if d.kind == 10 {                                          // GenRef `&T`: `JestyrRef_<elem mangle>`
        string_push(sb, "JestyrRef_")
        push_ty_mangle(sb, src, c, d.a)
        return
    }
    if d.kind == 11 {                                          // RegionRef `&[r]T`: plain pointer
        emit_ty_c(sb, p, src, c, d.a)
        string_push(sb, "*")
        return
    }
    if d.kind == 12 {                                          // Fn: its `JestyrFn_<sig>` typedef name
        string_push(sb, "JestyrFn_")
        push_ty_mangle(sb, src, c, tyid)
        return
    }
    if d.kind == 17 {                                          // DynOpaque: `JestyrDyn_<Trait>`
        string_push(sb, "JestyrDyn_")
        string_push(sb, src[d.x as usize .. d.y as usize])
        return
    }
    if d.kind == 6 {                                           // GenStruct/GenEnum instance: `Jestyr_<ctor>__<args>`
        let nvb6: i32 = niche_inst_some(p, src, c, tyid)       // a niche instance IS its pointer
        if nvb6 >= 0 {
            emit_ty_c(sb, p, src, c, niche_inst_pay(p, src, c, tyid, nvb6))
            return
        }
        string_push(sb, "Jestyr_")
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < d.b {
            if i > 0 { string_push(sb, "_") }
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i) as usize))
            i = i + 1
        }
        return
    }
    if d.kind == 0 or d.kind == 4 or d.kind == 16 or d.kind == 18 {
        string_push(sb, "int")                                 // Unknown / Opaque / Error / OpaqueLit:
        return                                                 // the reference's degenerate `int`
    }
    string_push(sb, "void")                                    // TODO: other TyData kinds
}

// The mangle suffix of a Checker type (mirrors `ty_mangle`): a prim is its Jestyr name, a Named
// type its declared name, `ptr_`/`slice_` prefixes for the structural forms handled so far.
fn push_ty_mangle(mut sb: String, read src: str, read c: typeck.Checker, tyid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    // The RESOLVED Unit type mangles to `unit` too. `tyid < 0` above is "no type at all"
    // (an absent return type); this is a real TyData whose kind is Unit, which is what a
    // `!{ E }`-only result's ok type resolves to. Without this arm it fell through to the
    // `?` default and the port emitted `JestyrResult_?` where the reference emits
    // `JestyrResult_unit` -- invisible until a corpus file first had a unit result.
    if d.kind == 1 { string_push(sb, "unit")  return }
    if d.kind == 2 { string_push(sb, prim_jname(d.x))  return }
    if d.kind == 15 {
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, src[ns as usize .. ne as usize])
        return
    }
    if d.kind == 3 { string_push(sb, "ptr_")  push_ty_mangle(sb, src, c, d.a)  return }
    if d.kind == 4 { string_push(sb, src[d.x as usize .. d.y as usize])  return }   // Opaque: its name
    if d.kind == 8 { string_push(sb, "slice_")  push_ty_mangle(sb, src, c, d.a)  return }
    if d.kind == 10 { string_push(sb, "ref_")  push_ty_mangle(sb, src, c, d.a)  return }   // GenRef
    if d.kind == 12 {                                          // Fn: conv-tagged param mangles
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < d.b {                                          // (a,b) = (conv,TyId) pairs in tya
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, c.tya, (d.a + i * 2) as usize))
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, "_ret_")
        push_ty_mangle(sb, src, c, d.x)
        return
    }
    if d.kind == 9 {                                           // Array: `arr_<elem>_<len>`
        string_push(sb, "arr_")
        push_ty_mangle(sb, src, c, d.a)
        string_push(sb, "_")
        push_uint(sb, d.b as i64)
        return
    }
    if d.kind == 5 { string_push(sb, "result_")  push_ty_mangle(sb, src, c, d.a)  return }   // Result ok
    if d.kind == 6 {                                           // GenStruct/GenEnum: `<ctor>__<args>`
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < d.b {
            if i > 0 { string_push(sb, "_") }
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i) as usize))
            i = i + 1
        }
        return
    }
    string_push(sb, "?")
}

// A primitive type CODE rendered as its Jestyr source name (the mangle alphabet).
fn prim_jname(code: i32) -> str {
    if code == 0 { return "i8" }
    if code == 1 { return "i16" }
    if code == 2 { return "i32" }
    if code == 3 { return "i64" }
    if code == 4 { return "isize" }
    if code == 5 { return "u8" }
    if code == 6 { return "u16" }
    if code == 7 { return "u32" }
    if code == 8 { return "u64" }
    if code == 9 { return "usize" }
    if code == 10 { return "f32" }
    if code == 11 { return "f64" }
    if code == 12 { return "bool" }
    if code == 13 { return "char" }
    if code == 14 { return "str" }
    // **Codes 15..21 were missing and every one of them mangled `?`.** The reference's
    // `ty_mangle` renders a primitive as its NAME, so this table has to run as far as
    // `typeck.prim_code` does — and that table reaches 21. The observable was
    // `JestyrResult_?` for `let a = f()` where `f` is `-> String !{ E }`: an un-annotated
    // `let` takes its C type from the CHECKER (there is no annotation to read), so this is
    // the only path that renders it, and gcc saw `JestyrResult_? j_a = …` — parsing
    // `JestyrResult_` as an identifier and `?` as a conditional, hence its baffling
    // "expected ':' before ';'". `examples/std/try_read.jtr` is the corpus's instance.
    //
    // Recorded as an INFERENCE gap in an earlier note; measured, it is a mangle gap. Typeck
    // agrees with the reference on the type — the whole-corpus typeck golden passes on that
    // file — and only the emission was wrong. (20 is typeck's internal error binder, which
    // has no C spelling and should never reach a mangle.)
    if code == 15 { return "cstr" }
    if code == 16 { return "os_str" }
    if code == 17 { return "String" }
    if code == 18 { return "Builder" }
    if code == 19 { return "Cow" }
    if code == 21 { return "cptr" }
    return "?"
}

// A binary-operator code (`ExprData.op` for a Binary node) rendered as its C operator. Mirrors
// `binop_c`; codes come from the parser's `bin_op` (1=add … 18=shr).
fn binop_c(code: i32) -> str {
    if code == 1 { return "+" }
    if code == 2 { return "-" }
    if code == 3 { return "*" }
    if code == 4 { return "/" }
    if code == 5 { return "%" }
    if code == 6 { return "==" }
    if code == 7 { return "!=" }
    if code == 8 { return "<" }
    if code == 9 { return "<=" }
    if code == 10 { return ">" }
    if code == 11 { return ">=" }
    if code == 12 { return "&&" }
    if code == 13 { return "||" }
    if code == 14 { return "&" }
    if code == 15 { return "|" }
    if code == 16 { return "^" }
    if code == 17 { return "<<" }
    if code == 18 { return ">>" }
    return "?"
}

// Is the Checker's type of expr `eid` the primitive `str`? (TyData kind 2 Prim, code 14.)
fn expr_is_str(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == 14
}

// Is the Checker's type of expr `eid` the primitive with code `pc`? (TyData kind 2; codes per
// typeck's `prim_name`: 14 str, 15 cstr, 16 os_str, 17 String, 18 Builder, 19 Cow.)
fn expr_is_prim(read c: typeck.Checker, eid: i32, pc: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == pc
}

// Is the Checker's type of expr `eid` a slice `[]T`? (TyData kind 8.)
fn expr_is_slice(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 8
}

// ---- `distinct` representation peeling (mirrors the reference's `peel_distinct`/`repr_of`) ----
//
// `distinct D = Base` lowers to `typedef <base C type> Jestyr_D`, so `D` and `Base` are
// LITERALLY the same C type and an inherited operation emits byte-for-byte what the base
// emits. What the backend needs the peel for is DISPATCH — deciding which arm of Field /
// Index / the index-assign lvalue path to take at all. Without it a `distinct P = str`
// reached the struct-field arm and emitted `.j_len`, a member `JestyrStr` has not got.
//
// The REPRESENTATION TyId of expr `eid`: its recorded type with every `distinct` layer
// removed. Capped at 16 hops for the same reason typeck's is — `check` accepts a cyclic
// `distinct A = B` / `distinct B = A` today, and an uncapped walk would hang the compiler.
// tdecl slot 2 = kind (2 = distinct), slot 9 = the base TyId.
fn repr_tyid(read c: typeck.Checker, eid: i32) -> i32 {
    var cur: i32 = list.get(i32, c.et, eid as usize)
    var i: i32 = 0
    for i < 16 {
        if cur < 0 { return cur }
        let d: typeck.TyData = list.get(typeck.TyData, c.tys, cur as usize)
        if d.kind != 15 { return cur }                            // not Named
        if list.get(i32, c.tdecl, (d.x * 10 + 2) as usize) != 2 { return cur }
        cur = list.get(i32, c.tdecl, (d.x * 10 + 9) as usize)     // the distinct's base
        i = i + 1
    }
    return 0 - 1
}

// Is the REPRESENTATION of expr `eid` the primitive `str`? (TyData kind 2 Prim, code 14.)
fn repr_is_str(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = repr_tyid(c, eid)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == 14
}

// Is the REPRESENTATION of expr `eid` the primitive with code `pc`?
fn repr_is_prim(read c: typeck.Checker, eid: i32, pc: i32) -> bool {
    let tid: i32 = repr_tyid(c, eid)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == pc
}

// Is the REPRESENTATION of expr `eid` a slice `[]T`? (TyData kind 8.)
fn repr_is_slice(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = repr_tyid(c, eid)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 8
}

// The tdecl row of expr `eid`'s type if it is a Named ENUM (tdecl kind 1), else -1. The `Jestyr_<E>`
// tag prefix and payload C types come from this row's name.
fn expr_enum_row(read c: typeck.Checker, eid: i32) -> i32 {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 15 { return 0 - 1 }                          // Named
    if list.get(i32, c.tdecl, (d.x * 10 + 2) as usize) != 1 { return 0 - 1 }   // kind 1 = enum
    return d.x
}

fn expr_is_enum(read c: typeck.Checker, eid: i32) -> bool {
    return expr_enum_row(c, eid) >= 0
}

// The tdecl row of expr `eid`'s type if it is a Named STRUCT (tdecl kind 0), else -1.
fn expr_struct_row(read c: typeck.Checker, eid: i32) -> i32 {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 15 { return 0 - 1 }                          // Named
    if list.get(i32, c.tdecl, (d.x * 10 + 2) as usize) != 0 { return 0 - 1 }   // kind 0 = struct
    return d.x
}

// The Fn ITEM id of struct `sit`'s method named `src[ns..ne]`, or -1. A method member in `mar` is
// the 10-tuple [1, fn_item_id, -1 …]; the fn item (kind 3, not in roots) carries the signature.
fn find_struct_method(read p: parser.Parser, read src: str, sit: i32, ns: usize, ne: usize) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
    var m: i32 = 0
    for m < it.b {
        let base: i32 = it.a + m * 10
        if list.get(i32, p.mar, base as usize) == 1 {         // tag 1 = method
            let fid: i32 = list.get(i32, p.mar, (base + 1) as usize)
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
            if str_eq(src[ns .. ne], src[fd.x .. fd.y]) { return fid }
        }
        m = m + 1
    }
    return 0 - 1
}

// The struct item + method fn item of a method-sugar call `recv.m(…)`, or -1: the callee must be
// a Field whose base types as a Named struct that declares a method of that name. Packs the pair
// as `sit * 1000000 + fid` (item ids are far smaller); -1 = not a struct-method call.
fn resolve_method_call(read p: parser.Parser, read src: str, read c: typeck.Checker, read callee: parser.ExprData) -> i32 {
    let row: i32 = expr_struct_row(c, callee.a)
    if row < 0 { return 0 - 1 }
    let sns: i32 = list.get(i32, c.tdecl, (row * 10 + 0) as usize)
    let sne: i32 = list.get(i32, c.tdecl, (row * 10 + 1) as usize)
    let sit: i32 = find_struct_item(p, src, sns as usize, sne as usize)
    if sit < 0 { return 0 - 1 }
    let fid: i32 = find_struct_method(p, src, sit, callee.x as usize, callee.y as usize)
    if fid < 0 { return 0 - 1 }
    return sit * 1000000 + fid
}

// The `conv` code of a method's `self` parameter (0 read-ish default; 2/4 = by pointer), or 0.
fn method_self_conv(read p: parser.Parser, fid: i32) -> i32 {
    let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
    var i: i32 = 0
    for i < fd.b {
        let pbase: i32 = fd.a + i * 7
        if list.get(i32, p.iar, (pbase + 4) as usize) == 1 {  // is_self
            return list.get(i32, p.iar, (pbase + 1) as usize)
        }
        i = i + 1
    }
    return 0
}

// Collect every (struct item, method fn item) a method-sugar call instantiates, first-seen order,
// as pairs in `g.mi` — the reference's `method_instances` (non-generic receivers: empty type args).
// The expr arena is scanned in creation order, which tracks body order for a single file.
fn collect_method_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 5 {
                let packed: i32 = resolve_method_call(p, src, c, callee)
                if packed >= 0 {
                    var seen: bool = false
                    var k: usize = 0
                    for k < list.len(i32, g.mi) {
                        if list.get(i32, g.mi, k) == packed / 1000000 {
                            if list.get(i32, g.mi, k + 1) == packed % 1000000 { seen = true }
                        }
                        k = k + 2
                    }
                    if !seen {
                        list.push(i32, g.mi, packed / 1000000)
                        list.push(i32, g.mi, packed % 1000000)
                    }
                }
            }
        }
        i = i + 1
    }
}

// Is Checker type `tid` a generic-ENUM instance (TyData kind 6 whose ctor names an enum item)
// with all-concrete args? Returns the enum ITEM id, or -1. (Kind 6 also covers comptime-fn
// generic-struct ctors, which don't name an enum item — excluded here.)
// Is Checker type `tid` fully concrete (no Unknown/Opaque/Error anywhere)? Mirrors
// `is_concrete`: structural forms recurse; only an unresolved leaf disqualifies.
fn tyid_concrete(read c: typeck.Checker, tid: i32) -> bool {
    if tid < 0 { return true }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 0 or d.kind == 4 or d.kind == 16 or d.kind == 18 { return false }   // Unknown/Opaque/Error/OpaqueLit
    if d.kind == 3 or d.kind == 5 or d.kind == 8 or d.kind == 10 or d.kind == 11 or d.kind == 9 {
        return tyid_concrete(c, d.a)                  // Ptr/Result/Slice/GenRef/RegionRef/Array -> inner
    }
    if d.kind == 6 {                                  // GenStruct/GenEnum -> all args
        var i: i32 = 0
        for i < d.b {
            if !tyid_concrete(c, list.get(i32, c.tya, (d.a + i) as usize)) { return false }
            i = i + 1
        }
        return true
    }
    if d.kind == 12 {                                 // Fn -> params + ret
        var i: i32 = 0
        for i < d.b {
            if !tyid_concrete(c, list.get(i32, c.tya, (d.a + i * 2 + 1) as usize)) { return false }
            i = i + 1
        }
        return tyid_concrete(c, d.x)
    }
    return true
}

fn genum_item_of(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> i32 {
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 6 { return 0 - 1 }
    let eit: i32 = find_enum_item(p, src, d.x as usize, d.y as usize)
    if eit < 0 { return 0 - 1 }
    var i: i32 = 0
    for i < d.b {                                     // every arg must be CONCRETE (a pointer is!)
        if !tyid_concrete(c, list.get(i32, c.tya, (d.a + i) as usize)) { return 0 - 1 }
        i = i + 1
    }
    return eit
}

// The same question asked from INSIDE a monomorphized body: an argument that is still an
// opaque tparam is concrete if the active substitution binds it, because an instance's
// bindings are concrete by construction.
//
// **Without this a tail `match` on a generic enum inside a generic function emitted NOTHING.**
// `genum_item_of` answered -1 (the arg `T` is opaque in the template), `emit_match` took its
// import-degenerate escape hatch, and the port produced
// `bool jestyr_opt_is_some__i32(Jestyr_Option__i32 j_o) { }` — a function that falls off its
// end. gcc accepts that with a warning, so it COMPILED and returned garbage: every
// `Option`/`Result` combinator in `core` answered 0. A silent miscompile, and the reason the
// `jc_build_matrix` gate now compares OUTPUT rather than just exit status.
//
// Falls through to `genum_item_of` when no substitution is armed, so it is a strict superset
// and cannot change emission outside an instance body.
fn genum_item_of_su(read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tid: i32) -> i32 {
    if tid < 0 { return 0 - 1 }
    if list.len(i32, g.su) == 0 { return genum_item_of(p, src, c, tid) }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 6 { return 0 - 1 }
    let eit: i32 = find_enum_item(p, src, d.x as usize, d.y as usize)
    if eit < 0 { return 0 - 1 }
    var i: i32 = 0
    for i < d.b {
        let arg: i32 = list.get(i32, c.tya, (d.a + i) as usize)
        var okc: bool = tyid_concrete(c, arg)
        if !okc {
            let ad: typeck.TyData = list.get(typeck.TyData, c.tys, arg as usize)
            if ad.kind == 4 and su_slot(src, g, ad.x as usize, ad.y as usize) >= 0 { okc = true }
        }
        if !okc { return 0 - 1 }
        i = i + 1
    }
    return eit
}

// Collect the distinct generic-enum instances in `g.gei` (TyId per instance, deduped by the
// rendered C name, in expression order) — mirrors `collect_enum_instances`' expr_types scan.
// (The reference also scans fn signatures after; add that pass when a corpus file has an
// instance that appears in a signature but in no expression.)
fn collect_genum_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var seen: String = string_new()
    var i: usize = 0
    for i < list.len(i32, c.et) {
        let tid: i32 = list.get(i32, c.et, i)
        if genum_item_of(p, src, c, tid) >= 0 {
            var nm: String = string_new()
            emit_ty_c(nm, p, src, c, tid)
            var probe: String = string_new()
            string_push(probe, "|")  string_push(probe, string_view(nm))  string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                list.push(i32, g.gei, tid)
            }
            string_free(nm)  string_free(probe)
        }
        i = i + 1
    }
    string_free(seen)
}

// Emit field type `fty` under the generic-enum instance `tid`'s substitution: a bare Name that
// matches enum tparam k renders instance arg k; anything else renders as-is. Mirrors
// `ast_type_to_ty(fty, subst)` for the instance's tparam->arg map.
fn emit_field_ty_subst(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, fty: i32, eit: i32, tid: i32) {
    if tid >= 0 and fty >= 0 and eit >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
        if t.kind == 0 {
            let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
            var k: i32 = 0
            for k < it.a {                            // tparam name-span pairs in ear at it.op
                let tps: i32 = list.get(i32, p.ear, (it.op + k * 2) as usize)
                let tpe: i32 = list.get(i32, p.ear, (it.op + k * 2 + 1) as usize)
                if str_eq(src[t.start .. t.end], src[tps as usize .. tpe as usize]) {
                    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
                    emit_ty_c(sb, p, src, c, list.get(i32, c.tya, (d.a + k) as usize))
                    return
                }
                k = k + 1
            }
        }
    }
    emit_c_ty(sb, p, src, fty)
}

// Does an enclosing exclusive `for i in 0..s.len` prove `base[index]` in range? Mirrors
// `index_in_range`: base + index are bare Names, the index name has an active refinement whose
// Range hi is `<base>.len` (a Field named `len` whose base Name matches `base`'s text).
fn index_in_range(read g: Cg, read p: parser.Parser, read src: str, base: i32, index: i32) -> bool {
    let bx: parser.ExprData = list.get(parser.ExprData, p.ex, base as usize)
    let ix: parser.ExprData = list.get(parser.ExprData, p.ex, index as usize)
    if bx.kind != 2 { return false }
    if ix.kind != 2 { return false }
    // innermost-first scan of the refinement stack for the index name
    var i: i32 = (list.len(i32, g.rf) / 3) as i32
    for i > 0 {
        i = i - 1
        let rns: i32 = list.get(i32, g.rf, (i * 3) as usize)
        let rne: i32 = list.get(i32, g.rf, (i * 3 + 1) as usize)
        if str_eq(src[ix.start .. ix.end], src[rns as usize .. rne as usize]) {
            let rid: i32 = list.get(i32, g.rf, (i * 3 + 2) as usize)
            let rx: parser.ExprData = list.get(parser.ExprData, p.ex, rid as usize)
            if rx.kind != 13 { return false }          // must be a Range
            if rx.op == 1 { return false }             // exclusive only
            if rx.b < 0 { return false }               // needs a hi bound
            let hx: parser.ExprData = list.get(parser.ExprData, p.ex, rx.b as usize)
            if hx.kind != 5 { return false }           // hi must be a Field
            if !str_eq(src[hx.x as usize .. hx.y as usize], "len") { return false }
            let fb: parser.ExprData = list.get(parser.ExprData, p.ex, hx.a as usize)
            if fb.kind != 2 { return false }           // field base must be a Name
            return str_eq(src[fb.start .. fb.end], src[bx.start .. bx.end])
        }
    }
    return false
}

// ---- places (mirrors Cgen::{is_checked_index, place_through_checked_index, emit_place}) ----

// Does `emit_expr` lower `eid` to a bounds-checked STATEMENT EXPRESSION — a `({ …; elem; })` that
// yields a *value*? Legal wherever a value is wanted, illegal in all three place positions: the
// left of `=`, the operand of `&`, and the base of another index.
fn is_checked_index(read g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, eid: i32) -> bool {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind != 6 { return false }                   // Index
    // A slice spills only when the bounds check survives; a refinement-proved index emits
    // `(b).ptr[(i)]`, which is already an lvalue. REPRESENTATION-based, so a
    // `distinct Buf = []i64` answers the same as its base — this must agree with the Index
    // arm's own peel, or the two disagree about whether a statement expression was emitted
    // and a place chain reaches for an lvalue that is not there.
    if repr_is_slice(c, e.a) { return !index_in_range(g, p, src, e.a, e.b) }
    let bt: i32 = repr_tyid(c, e.a)
    if bt < 0 { return false }
    let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
    return bd.kind == 9                               // a fixed-size array ALWAYS spills through &base
}

// Is `eid` a place expression that reaches *through* a checked index (`xs[i].f`, `m[i][j]`,
// `xs[i].f.g`)? Those are exactly the places `emit_expr` cannot produce. A *directly* indexed
// target (`xs[i] = v`) is deliberately excluded — the Assign arm has its own lvalue lowering for
// that, and keeping it is what leaves every existing program's emitted C unchanged.
fn place_through_checked_index(read g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, eid: i32) -> bool {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind != 5 and e.kind != 6 { return false }   // Field / Index
    if is_checked_index(g, p, src, c, e.a) { return true }
    return place_through_checked_index(g, p, src, c, e.a)
}

// Does `eid` reach through a GENREF DEREF (`h.*`, `h.*.f`, `h.*.f[i]`)? Writing through one
// cannot use `emit_expr` — the checked deref is a statement expression, an rvalue — so the
// target routes through `emit_place`, whose genref arm yields `(*({ …; ptr; }))` instead.
// Mirrors `place_through_genref_deref`; found by the first program to WRITE through a genref
// field (`dlist_genref.jtr` / region_escape.jtr route 3).
fn place_through_genref_deref(read p: parser.Parser, read c: typeck.Checker, eid: i32) -> bool {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 7 {                                  // Deref
        let bt: i32 = list.get(i32, c.et, e.a as usize)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 10 { return true }          // GenRef
        }
        return place_through_genref_deref(p, c, e.a)
    }
    if e.kind == 5 or e.kind == 6 { return place_through_genref_deref(p, c, e.a) }
    return false
}

// Emit `eid` as a C LVALUE — a place, not a value. Identical to `emit_expr` for every form except
// a checked index, which becomes the address-yielding `(*({ …; &elem; }))`: the statement
// expression produces a *pointer*, and dereferencing it gives back a place, so a projection chain
// can continue through it. `wr` selects the qualifier on the spilled base pointer — a read keeps
// `const` (as `emit_expr` does) so indexing a `static const` table does not discard the qualifier;
// a write must not, or the store goes through a pointer-to-const.
fn emit_place(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, wr: bool) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 5 {                                  // Field
        let bt: i32 = repr_tyid(c, e.a)
        var barr: bool = false
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 { barr = true }
        }
        // Only a struct-shaped base projects to an assignable field. A slice's `.ptr`/`.len`, a
        // `str`'s views and an array's constant `.len` are computed, never places. Peeled, so a
        // `distinct` over a STRUCT still projects (`w.x = 9`) while one over a slice/array/`str`
        // correctly falls back to `emit_expr`.
        if barr or repr_is_slice(c, e.a) or repr_is_str(c, e.a) or repr_is_prim(c, e.a, 17) {
            emit_expr(sb, p, src, c, g, eid)
            return
        }
        emit_place(sb, p, src, c, g, e.a, wr)
        string_push(sb, ".j_")
        string_push(sb, src[e.x as usize .. e.y as usize])
        return
    }
    if e.kind == 6 {                                  // Index
        let bt: i32 = repr_tyid(c, e.a)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 {                         // array: `(*({ A* _a = &(<place>); …; &_a->a[_ix]; }))`
                // The base is emitted as a place too, so an array of arrays keeps a real chain of
                // addresses (`&m[i]` is legal because `m[i]` is itself an lvalue here).
                var abuf: String = string_new()       // base/index emit BEFORE the temp
                emit_place(abuf, p, src, c, g, e.a, wr)
                var aibuf: String = string_new()
                emit_expr(aibuf, p, src, c, g, e.b)
                let na: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "(*({ ")
                if !wr { string_push(sb, "const ") }
                emit_su_tyid(sb, p, src, c, g, bt)     // subst-aware: `[8]T` in an instance body
                string_push(sb, "* _a")
                push_uint(sb, na as i64)
                string_push(sb, " = &(")
                string_push(sb, string_view(abuf))
                string_push(sb, "); size_t _ix")
                push_uint(sb, na as i64)
                string_push(sb, " = (size_t)(")
                string_push(sb, string_view(aibuf))
                string_push(sb, "); assert(_ix")
                push_uint(sb, na as i64)
                string_push(sb, " < ")
                push_uint(sb, bd.b as i64)
                string_push(sb, "); &_a")
                push_uint(sb, na as i64)
                string_push(sb, "->a[_ix")
                push_uint(sb, na as i64)
                string_push(sb, "]; }))")
                string_free(abuf)
                string_free(aibuf)
                return
            }
        }
        if repr_is_slice(c, e.a) and !index_in_range(g, p, src, e.a, e.b) {
            // The spilled `{ptr,len}` view is a copy, but the address taken points into the
            // *buffer*, so it outlives the statement expression — a slice copy names the same
            // elements.
            var sbuf: String = string_new()           // base/index emit BEFORE the temp
            emit_expr(sbuf, p, src, c, g, e.a)
            var sibuf: String = string_new()
            emit_expr(sibuf, p, src, c, g, e.b)
            let ns: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "(*({ ")
            emit_ty_c(sb, p, src, c, bt)
            string_push(sb, " _s")
            push_uint(sb, ns as i64)
            string_push(sb, " = (")
            string_push(sb, string_view(sbuf))
            string_push(sb, "); size_t _ix")
            push_uint(sb, ns as i64)
            string_push(sb, " = (size_t)(")
            string_push(sb, string_view(sibuf))
            string_push(sb, "); assert(_ix")
            push_uint(sb, ns as i64)
            string_push(sb, " < _s")
            push_uint(sb, ns as i64)
            string_push(sb, ".len); &_s")
            push_uint(sb, ns as i64)
            string_push(sb, ".ptr[_ix")
            push_uint(sb, ns as i64)
            string_push(sb, "]; }))")
            string_free(sbuf)
            string_free(sibuf)
            return
        }
        emit_expr(sb, p, src, c, g, eid)
        return
    }
    if e.kind == 7 {                                  // Deref of a GENREF: the lvalue form
        let bt: i32 = list.get(i32, c.et, e.a as usize)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 10 {
                // The same generation check the reading deref performs, but yielding the
                // POINTER so the surrounding `(*…)` is a real C lvalue. Base emits BEFORE
                // the temp (counter lockstep with the reference).
                var rbuf: String = string_new()
                emit_expr(rbuf, p, src, c, g, e.a)
                let nr: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "(*({ ")
                emit_ty_c(sb, p, src, c, bt)
                string_push(sb, " _r")
                push_uint(sb, nr as i64)
                string_push(sb, " = (")
                string_push(sb, string_view(rbuf))
                string_push(sb, "); assert(((uint64_t*)_r")
                push_uint(sb, nr as i64)
                string_push(sb, ".ptr)[-1] == _r")
                push_uint(sb, nr as i64)
                string_push(sb, ".gen); _r")
                push_uint(sb, nr as i64)
                string_push(sb, ".ptr; }))")
                string_free(rbuf)
                return
            }
        }
        emit_expr(sb, p, src, c, g, eid)
        return
    }
    emit_expr(sb, p, src, c, g, eid)
}

// Emit `eid` as an argument passed BY ADDRESS — a `mut`/`out` parameter, or a `mut`/`out self`
// receiver. Such an argument is a PLACE, not a value, so it routes through `emit_place`:
// `cs[i].bump()` otherwise takes the address of a bounds-checked statement expression, which is
// not an lvalue. Anything not reached through a checked index emits exactly as `&(<expr>)` always
// did. (Mirrors `Cgen::emit_addr_arg`.)
fn emit_addr_arg(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32) {
    string_push(sb, "&(")
    emit_place(sb, p, src, c, g, eid, true)
    string_push(sb, ")")
}

// ---- expressions (mirrors the relevant arms of Cgen::emit_expr) ----
// Threads `read c: typeck.Checker` — Field/Index are type-directed (`.len` on a `str` is a real C
// field; `s[lo..hi]` on a `str` is a `jestyr_rt_substr` sub-view).
fn emit_expr(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32) {
    // A value the Checker recorded as coercing to `dyn Trait` wraps into the `{ data, vtable }`
    // fat pointer FIRST — before any kind dispatch. `g.dg` guards the re-entrant emission of
    // the underlying concrete value (mirrors the reference's `dyn_guard`).
    if g.dg != eid {
        var dci: usize = 0
        for dci < list.len(i32, c.dcoerce) {
            if list.get(i32, c.dcoerce, dci) == eid {
                emit_dyn_coercion(sb, p, src, c, g, eid, list.get(i32, c.dcoerce, dci + 1), list.get(i32, c.dcoerce, dci + 2))
                return
            }
            dci = dci + 3
        }
    }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 29 {                                 // Str: emit the literal verbatim inside JSTR
        string_push(sb, "JSTR(")
        string_push(sb, src[e.start .. e.end])
        string_push(sb, ")")
        return
    }
    if e.kind == 0 or e.kind == 1 {                   // Int / Float: underscores stripped
        emit_int_literal(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 26 {                                 // Char: the literal verbatim
        string_push(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 27 {                                 // Bool: op 1 = true, 0 = false
        if e.op == 1 { string_push(sb, "true") } else { string_push(sb, "false") }
        return
    }
    if e.kind == 30 {                                 // Null
        string_push(sb, "NULL")
        return
    }
    if e.kind == 44 {                                 // Comptime: emit the VALUE, never the block
        // Re-evaluating here rather than reading a table typeck filled is the reference's
        // choice too: the interpreter is pure and total, so a second run must agree with
        // the first, and no phase has to carry state. Total, like every cgen path — typeck
        // has already reported an unevaluable block, so this is never the first news of it.
        var ci: ctfe.Interp = ctfe.make(g.alloc)
        let v: ctfe.Value = ctfe.eval(ci, p, src, eid)
        if ci.failed { string_push(sb, "0") }
        else if v.tag == 4 {
            // An aggregate fills a fresh array value, exactly as a written `[a, b, …]`
            // does — the two are indistinguishable in the output. (At a `const`
            // initializer this path is bypassed for the brace form; see `emit_consts`,
            // which is what a large lookup table actually needs.)
            let ety: i32 = list.get(i32, c.et, eid as usize)
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            let td: typeck.TyData = list.get(typeck.TyData, c.tys, ety as usize)
            if td.kind == 9 { emit_ty_c(sb, p, src, c, ety) } else { string_push(sb, "int") }
            string_push(sb, " _cl")
            push_i64(sb, n as i64)
            string_push(sb, ";")
            let cnt: i64 = ctfe.list_len(ci, v)
            var k: i64 = 0
            for k < cnt {
                string_push(sb, " _cl")
                push_i64(sb, n as i64)
                string_push(sb, ".a[")
                push_i64(sb, k)
                string_push(sb, "] = (")
                let e: ctfe.Value = ctfe.list_get(ci, v, k)
                push_ctfe_scalar(sb, ci, e)
                string_push(sb, ");")
                k = k + 1
            }
            string_push(sb, " _cl")
            push_i64(sb, n as i64)
            string_push(sb, "; })")
        }
        else if v.tag == 0 { push_i64(sb, v.i) }
        else if v.tag == 1 {
            if v.i == 1 { string_push(sb, "true") } else { string_push(sb, "false") }
        } else if v.tag == 2 {
            string_push(sb, "JSTR(")
            push_c_string(sb, ctfe.str_of(ci, v))
            string_push(sb, ")")
        } else { string_push(sb, "0") }
        return
    }
    if e.kind == 3 {                                  // Unary: (OPrhs). op 1=neg 2=not 3=bitnot 4=ref
        if e.op == 4 {
            let rhs: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if rhs.kind == 2 {                        // `&some_fn` -> the MANGLED fn's address
                if find_fn_item(p, src, src[rhs.start .. rhs.end]) >= 0 {
                    string_push(sb, "(&jestyr_")
                    string_push(sb, src[rhs.start .. rhs.end])
                    string_push(sb, ")")
                    return
                }
            }
            // `&mod.f` -> the same mangled address. A Field node carries its name's
            // span in (x, y), so the module base is simply skipped: after flattening
            // there are no modules left, only the one mangled symbol. Without this the
            // generic path below emitted `(&j_f)` — a local's spelling — which gcc
            // rejects as undeclared, after the whole front end had passed.
            if rhs.kind == 5 {
                let qs: usize = rhs.x as usize
                let qe: usize = rhs.y as usize
                if find_fn_item(p, src, src[qs .. qe]) >= 0 {
                    string_push(sb, "(&jestyr_")
                    string_push(sb, src[qs .. qe])
                    string_push(sb, ")")
                    return
                }
            }
        }
        string_push(sb, "(")
        if e.op == 1 { string_push(sb, "-") }
        else if e.op == 2 { string_push(sb, "!") }
        else if e.op == 3 { string_push(sb, "~") }
        else if e.op == 4 { string_push(sb, "&") }
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 19 {                                 // SelfValue: j_self ((*j_self) for mut/out self)
        if g.self_ptr { string_push(sb, "(*j_self)") } else { string_push(sb, "j_self") }
        return
    }
    if e.kind == 2 {                                  // Name (value position)
        // Inside a lifted closure body, a captured name lives in the environment.
        var cpi: usize = 0
        for cpi < list.len(i32, g.caps) {
            let cns: i32 = list.get(i32, g.caps, cpi)
            let cne: i32 = list.get(i32, g.caps, cpi + 1)
            if str_eq(src[e.start .. e.end], src[cns as usize .. cne as usize]) {
                string_push(sb, "(j__env->j_")
                string_push(sb, src[e.start .. e.end])
                string_push(sb, ")")
                return
            }
            cpi = cpi + 2
        }
        // A bare *nullary* enum variant (e.g. `none`, `red`) constructs its enum value. A
        // payload-bearing variant referenced bare is not a construction (it would be called).
        let venum: i32 = find_variant_enum(p, src, e.start, e.end)
        if venum >= 0 {
            let vb: i32 = variant_tuple(p, src, venum, e.start, e.end)
            if list.get(i32, p.ear, (vb + 3) as usize) == 0 {   // field_count == 0: nullary
                let own: i32 = list.get(i32, c.et, eid as usize)
                let nvb: i32 = niche_of_tyid(p, src, c, own)     // niche: `none` IS the null pointer
                if nvb >= 0 {
                    string_push(sb, "((")
                    emit_niche_pay_c(sb, p, src, c, own, nvb)
                    string_push(sb, ")0)")
                    return
                }
                if genum_item_of_su(p, src, c, g, own) >= 0 {          // a generic-enum instance value
                    emit_gvariant_head(sb, p, src, c, g, own, src[e.start .. e.end])
                } else {
                    emit_variant_head(sb, p, src, venum, src[e.start .. e.end])
                }
                string_push(sb, " }")
                return
            }
        }
        if is_ptr_name(g, src, e.start, e.end) {      // a by-pointer name dereferences on use
            string_push(sb, "(*j_")
            string_push(sb, src[e.start .. e.end])
            string_push(sb, ")")
            return
        }
        string_push(sb, "j_")
        string_push(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 4 {                                  // Binary: operator-trait dispatch, else (lhs OP rhs)
        var ob: i32 = 0 - 1
        var oi: usize = 0
        for oi < list.len(i32, c.icalls) {            // an icalls record on a BINARY id = an op impl
            if list.get(i32, c.icalls, oi) == eid { ob = oi as i32 }
            oi = oi + 5
        }
        if ob >= 0 {
            emit_operator_call(sb, p, src, c, g, e, ob)
            return
        }
        string_push(sb, "(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, " ")
        string_push(sb, binop_c(e.op))
        string_push(sb, " ")
        emit_expr(sb, p, src, c, g, e.b)
        string_push(sb, ")")
        return
    }
    if e.kind == 5 {                                  // Field access. (x,y) = name span
        let fname: str = src[e.x as usize .. e.y as usize]
        // A fixed-size array's `.len` is its CONSTANT length, not a struct field — the base is a
        // place expression, so not emitting it loses no side effect (mirrors the reference).
        // REPRESENTATION-based throughout this arm: a `distinct` inherits its base's MEMBERS
        // (`p.len` on a `distinct P = str`, `w.x` on a `distinct W = Pt`), so the arm is chosen
        // on what the value IS in C. Without the peel every distinct fell through to `.j_len`,
        // a member `JestyrStr` has not got.
        let bt: i32 = repr_tyid(c, e.a)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 and str_eq(fname, "len") {
                string_push(sb, "((size_t)")
                push_uint(sb, bd.b as i64)
                string_push(sb, ")")
                return
            }
        }
        // `(x as T).f` — C binds `.` TIGHTER than a cast, so the `(<cty>)(<inner>)` a Cast
        // base emits parses as `(JestyrStr)((j_p).len)`: a `size_t` cast to a struct,
        // "conversion to non-scalar type requested". The base position needs parens of its
        // own. Gated on the base really being a Cast (kind 11) so every existing golden is
        // byte-identical. Not a `distinct` bug — `(s as str).len` on a plain `str` fails
        // the same way.
        let bcast: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
        if bcast.kind == 11 { string_push(sb, "(") }
        emit_expr(sb, p, src, c, g, e.a)
        if bcast.kind == 11 { string_push(sb, ")") }
        // A string view's `len`/`ptr`/`cstr` are real C fields (not `j_`-prefixed).
        if repr_is_str(c, e.a) {
            if str_eq(fname, "len") { string_push(sb, ".len")  return }
            if str_eq(fname, "ptr") or str_eq(fname, "cstr") { string_push(sb, ".ptr")  return }
        }
        // A slice's `ptr`/`len` are real C fields too.
        if repr_is_slice(c, e.a) {
            if str_eq(fname, "len") or str_eq(fname, "ptr") {
                string_push(sb, ".")
                string_push(sb, fname)
                return
            }
        }
        // An owned `String`'s byte length is its real C field (O(1)).
        if repr_is_prim(c, e.a, 17) {                 // prim code 17 = String
            if str_eq(fname, "len") { string_push(sb, ".len")  return }
        }
        string_push(sb, ".j_")
        string_push(sb, fname)
        return
    }
    if e.kind == 6 {                                  // Index. `s[lo..hi]` on a str -> substr sub-view
        // REPRESENTATION-based: `p[0]` on a `distinct P = str` reads a byte and `p[0..2]` takes
        // the zero-copy sub-view. Typeck hands the sub-view back AT `P` (the substitution rule),
        // but the C is identical either way — `Jestyr_P` IS `JestyrStr`.
        if repr_is_str(c, e.a) {
            let ix: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
            if ix.kind == 13 {                        // Range: op=inclusive, a=lo (-1 none), b=hi (-1 none)
                string_push(sb, "jestyr_rt_substr(")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, ", ")
                if ix.a >= 0 { emit_expr(sb, p, src, c, g, ix.a) } else { string_push(sb, "0") }
                string_push(sb, ", ")
                if ix.b >= 0 {
                    if ix.op == 1 {                   // inclusive `..=hi` -> ((hi) + 1)
                        string_push(sb, "((")
                        emit_expr(sb, p, src, c, g, ix.b)
                        string_push(sb, ") + 1)")
                    } else {
                        emit_expr(sb, p, src, c, g, ix.b)
                    }
                } else {                              // open end -> ({base}).len
                    string_push(sb, "(")
                    emit_expr(sb, p, src, c, g, e.a)
                    string_push(sb, ").len")
                }
                string_push(sb, ")")
                return
            }
            // A scalar index reads the byte at that offset: `((uint8_t)(<s>).ptr[(<i>)])`.
            string_push(sb, "((uint8_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ").ptr[(")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, ")])")
            return
        }
        if repr_is_slice(c, e.a) {                    // slice indexing
            let sx: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
            if sx.kind == 13 {                        // Range -> a narrower view of the same buffer
                // `{ ptr, len }` in, `{ ptr + lo, hi - lo }` out: pointer arithmetic and
                // a subtraction, no copy. Emitted inline rather than as a runtime helper
                // because it is generic in the element type. Bounds are asserted, so a
                // bad range faults deterministically; no UTF-8 boundary check, unlike
                // `str` -- a `[]T` has no encoding.
                //
                // The BASE emits before the temp is taken and lo/hi after, matching the
                // reference's order so nested temps number identically.
                var rb: String = string_new()
                emit_expr(rb, p, src, c, g, e.a)
                let n: i32 = g.tmp
                g.tmp = g.tmp + 1
                let sty: i32 = repr_tyid(c, e.a)
                var lob: String = string_new()
                if sx.a >= 0 { emit_expr(lob, p, src, c, g, sx.a) } else { string_push(lob, "0") }
                var hib: String = string_new()
                if sx.b >= 0 {
                    if sx.op == 1 {                   // inclusive `..=hi` -> ((hi) + 1)
                        string_push(hib, "((")
                        emit_expr(hib, p, src, c, g, sx.b)
                        string_push(hib, ") + 1)")
                    } else {
                        emit_expr(hib, p, src, c, g, sx.b)
                    }
                } else {                              // open end -> the spilled `.len`
                    string_push(hib, "_s")
                    push_uint(hib, n as i64)
                    string_push(hib, ".len")
                }
                string_push(sb, "({ ")
                emit_su_tyid(sb, p, src, c, g, sty)
                string_push(sb, " _s")
                push_uint(sb, n as i64)
                string_push(sb, " = (")
                string_push(sb, string_view(rb))
                string_push(sb, "); size_t _lo")
                push_uint(sb, n as i64)
                string_push(sb, " = (size_t)(")
                string_push(sb, string_view(lob))
                string_push(sb, "); size_t _hi")
                push_uint(sb, n as i64)
                string_push(sb, " = (size_t)(")
                string_push(sb, string_view(hib))
                string_push(sb, "); assert(_lo")
                push_uint(sb, n as i64)
                string_push(sb, " <= _hi")
                push_uint(sb, n as i64)
                string_push(sb, " && _hi")
                push_uint(sb, n as i64)
                string_push(sb, " <= _s")
                push_uint(sb, n as i64)
                string_push(sb, ".len); (")
                emit_su_tyid(sb, p, src, c, g, sty)
                string_push(sb, "){ _s")
                push_uint(sb, n as i64)
                string_push(sb, ".ptr + _lo")
                push_uint(sb, n as i64)
                string_push(sb, ", _hi")
                push_uint(sb, n as i64)
                string_push(sb, " - _lo")
                push_uint(sb, n as i64)
                string_push(sb, " }; })")
                return
            }
            if index_in_range(g, p, src, e.a, e.b) {  // refinement proved i < s.len: raw access
                string_push(sb, "((")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, ").ptr[(")
                emit_expr(sb, p, src, c, g, e.b)
                string_push(sb, ")])")
                return
            }
            // Bounds-checked: spill the slice once, assert, then index.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            emit_su_tyid(sb, p, src, c, g, repr_tyid(c, e.a))
            string_push(sb, " _s")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "); size_t _ix")
            push_uint(sb, n as i64)
            string_push(sb, " = (size_t)(")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, "); assert(_ix")
            push_uint(sb, n as i64)
            string_push(sb, " < _s")
            push_uint(sb, n as i64)
            string_push(sb, ".len); _s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_ix")
            push_uint(sb, n as i64)
            string_push(sb, "]; })")
            return
        }
        let bt: i32 = repr_tyid(c, e.a)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 {                         // array indexing: spill the address, assert, index
                // An array index takes `&base`, so the base has to be a PLACE: for `m[i][j]` the
                // inner `m[i]` is itself a checked index and `&({ … })` is not an lvalue. Every
                // other base emits exactly as before (`emit_place` falls through to `emit_expr`).
                // Base and index emit BEFORE the temp is taken — the reference's order, which
                // only becomes observable once a base can allocate a temp of its own.
                var rbuf: String = string_new()
                emit_place(rbuf, p, src, c, g, e.a, false)
                var ribuf: String = string_new()
                emit_expr(ribuf, p, src, c, g, e.b)
                let n: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ const ")
                emit_su_tyid(sb, p, src, c, g, bt)     // subst-aware (see the place-form above)
                string_push(sb, "* _a")
                push_uint(sb, n as i64)
                string_push(sb, " = &(")
                string_push(sb, string_view(rbuf))
                string_push(sb, "); size_t _ix")
                push_uint(sb, n as i64)
                string_push(sb, " = (size_t)(")
                string_push(sb, string_view(ribuf))
                string_push(sb, "); assert(_ix")
                push_uint(sb, n as i64)
                string_push(sb, " < ")
                push_uint(sb, bd.b as i64)
                string_push(sb, "); _a")
                push_uint(sb, n as i64)
                string_push(sb, "->a[_ix")
                push_uint(sb, n as i64)
                string_push(sb, "]; })")
                string_free(rbuf)
                string_free(ribuf)
                return
            }
        }
        // A non-slice, non-array base falls back to raw C indexing.
        string_push(sb, "(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")[")
        emit_expr(sb, p, src, c, g, e.b)
        string_push(sb, "]")
        return
    }
    if e.kind == 14 {                                 // ArrayLit: ({ A _al{n}; _al{n}.a[i] = (v); … _al{n}; })
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        string_push(sb, "({ ")
        emit_ty_c(sb, p, src, c, list.get(i32, c.et, eid as usize))
        string_push(sb, " _al")
        push_uint(sb, n as i64)
        string_push(sb, ";")
        var i: i32 = 0
        for i < e.y {                                 // (x,y) = elem slice into ar
            string_push(sb, " _al")
            push_uint(sb, n as i64)
            string_push(sb, ".a[")
            push_uint(sb, i as i64)
            string_push(sb, "] = (")
            emit_expr(sb, p, src, c, g, list.get(i32, p.ar, (e.x + i) as usize))
            string_push(sb, ");")
            i = i + 1
        }
        string_push(sb, " _al")
        push_uint(sb, n as i64)
        string_push(sb, "; })")
        return
    }
    if e.kind == 17 {                                 // GenStructLit: (Jestyr_<ctor>__<args>){ .j_f = v, … }
        string_push(sb, "(")
        emit_su_tyid(sb, p, src, c, g, list.get(i32, c.et, eid as usize))   // own type, under the subst
        string_push(sb, "){ ")
        var gi: i32 = 0
        for gi < e.y {
            if gi > 0 { string_push(sb, ", ") }
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + gi) as usize) as usize)
            string_push(sb, ".j_")
            string_push(sb, src[fi_.x as usize .. fi_.y as usize])
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, fi_.a)
            gi = gi + 1
        }
        string_push(sb, " }")
        return
    }
    if e.kind == 16 {                                 // StructLit: (Jestyr_X){ .j_f = v, … }
        let path: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)   // a = path Name expr
        // `circle { r: 2.0 }` — a struct-VARIANT construction: the path is an enum variant.
        let svenum: i32 = find_variant_enum(p, src, path.start, path.end)
        if svenum >= 0 {
            let own: i32 = list.get(i32, c.et, eid as usize)
            let nvb: i32 = niche_of_tyid(p, src, c, own)     // niche: `some { p }` IS the pointer
            if nvb >= 0 {
                if e.y > 0 {
                    let fi0: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, e.x as usize) as usize)
                    emit_expr(sb, p, src, c, g, fi0.a)
                } else { string_push(sb, "0") }
                return
            }
            if genum_item_of_su(p, src, c, g, own) >= 0 {
                emit_gvariant_head(sb, p, src, c, g, own, src[path.start .. path.end])
            } else {
                emit_variant_head(sb, p, src, svenum, src[path.start .. path.end])
            }
            if e.y > 0 {
                string_push(sb, ", .u.")
                string_push(sb, src[path.start .. path.end])
                string_push(sb, " = { ")
                var svi: i32 = 0
                for svi < e.y {
                    if svi > 0 { string_push(sb, ", ") }
                    let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + svi) as usize) as usize)
                    string_push(sb, ".j_")
                    string_push(sb, src[fi_.x as usize .. fi_.y as usize])
                    string_push(sb, " = ")
                    emit_expr(sb, p, src, c, g, fi_.a)
                    svi = svi + 1
                }
                string_push(sb, " }")
            }
            string_push(sb, " }")
            return
        }
        // `Point { x: 9, ..p }` — functional update: copy the spread base, assign listed fields.
        if e.b >= 0 {
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ Jestyr_")
            string_push(sb, src[path.start .. path.end])
            string_push(sb, " jss_")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, "; ")
            var si: i32 = 0
            for si < e.y {
                let sfid: i32 = list.get(i32, p.ar, (e.x + si) as usize)
                let sfi: parser.ExprData = list.get(parser.ExprData, p.ex, sfid as usize)
                string_push(sb, "jss_")
                push_uint(sb, n as i64)
                string_push(sb, ".j_")
                string_push(sb, src[sfi.x as usize .. sfi.y as usize])
                string_push(sb, " = ")
                emit_expr(sb, p, src, c, g, sfi.a)
                string_push(sb, "; ")
                si = si + 1
            }
            string_push(sb, "jss_")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        string_push(sb, "(Jestyr_")
        string_push(sb, src[path.start .. path.end])
        string_push(sb, "){ ")
        var first: bool = true
        var i: i32 = 0
        for i < e.y {                                 // (x,y) = FieldInit slice into ar
            if !first { string_push(sb, ", ") }
            first = false
            let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
            let fi: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)   // FieldInit (kind 18)
            string_push(sb, ".j_")
            string_push(sb, src[fi.x as usize .. fi.y as usize])   // field name span
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, fi.a)               // a = value
            i = i + 1
        }
        // Fill any omitted field that declares a `= <default>` (declaration order).
        let sit: i32 = find_struct_item(p, src, path.start, path.end)
        if sit >= 0 {
            let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
            var m: i32 = 0
            for m < sd.b {
                let mb: i32 = sd.a + m * 10
                let dflt: i32 = list.get(i32, p.mar, (mb + 5) as usize)
                if list.get(i32, p.mar, mb as usize) == 0 and dflt >= 0 {   // a field with a default
                    let fns2: i32 = list.get(i32, p.mar, (mb + 2) as usize)
                    let fne2: i32 = list.get(i32, p.mar, (mb + 3) as usize)
                    if !structlit_has_field(p, src, e, fns2 as usize, fne2 as usize) {
                        if !first { string_push(sb, ", ") }
                        first = false
                        string_push(sb, ".j_")
                        string_push(sb, src[fns2 as usize .. fne2 as usize])
                        string_push(sb, " = ")
                        emit_expr(sb, p, src, c, g, dflt)
                    }
                }
                m = m + 1
            }
        }
        string_push(sb, " }")
        return
    }
    if e.kind == 11 {                                 // Cast: (TargetType)(inner). x = target TypeId
        string_push(sb, "(")
        emit_su_ty(sb, p, src, c, g, e.x)             // subst-aware: `as *mut T` in an instance body
        if expr_is_enum(c, e.a) {                     // enum -> int reads its discriminant: (T)((e).tag)
            string_push(sb, ")((")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ").tag)")
            return
        }
        string_push(sb, ")(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 12 {                                 // Assign: `<target> <aop> <value>` (stmt adds `;`)
        // A target that reaches THROUGH a checked index (`xs[i].f = v`, `m[i][j] = v`) is a place
        // `emit_expr` cannot produce at all — it would yield the statement-expression *value*, and
        // gcc reports "lvalue required as left operand of assignment". `emit_place` lowers the
        // whole projection chain through element addresses.
        if place_through_checked_index(g, p, src, c, e.a) or place_through_genref_deref(p, c, e.a) {
            emit_place(sb, p, src, c, g, e.a, true)
            string_push(sb, " ")
            string_push(sb, assign_c(e.op))
            string_push(sb, " ")
            emit_expr(sb, p, src, c, g, e.b)
            return
        }
        let tgt: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
        if tgt.kind == 6 {
            // REPRESENTATION again: a `distinct Buf = []i64` writes through the same
            // `{ptr,len}` lvalue its base does, and the spilled temp's C type is the base's.
            let btid: i32 = repr_tyid(c, tgt.a)
            if btid >= 0 {
                let bd: typeck.TyData = list.get(typeck.TyData, c.tys, btid as usize)
                if bd.kind == 8 {                     // slice-index WRITE: fold into the stmt-expr
                    var sbb: String = string_new()    // base/index/VALUE emit before the temp
                    emit_expr(sbb, p, src, c, g, tgt.a)
                    var sib: String = string_new()
                    emit_expr(sib, p, src, c, g, tgt.b)
                    var svb: String = string_new()
                    emit_expr(svb, p, src, c, g, e.b)
                    if index_in_range(g, p, src, tgt.a, tgt.b) {   // a refinement proves the bound
                        string_push(sb, "(")
                        string_push(sb, string_view(sbb))
                        string_push(sb, ").ptr[(")
                        string_push(sb, string_view(sib))
                        string_push(sb, ")] ")
                        string_push(sb, assign_c(e.op))
                        string_push(sb, " ")
                        string_push(sb, string_view(svb))
                    } else {
                        let n2: i32 = g.tmp
                        g.tmp = g.tmp + 1
                        string_push(sb, "({ ")
                        emit_ty_c(sb, p, src, c, btid)
                        string_push(sb, " _s")
                        push_uint(sb, n2 as i64)
                        string_push(sb, " = (")
                        string_push(sb, string_view(sbb))
                        string_push(sb, "); size_t _ix")
                        push_uint(sb, n2 as i64)
                        string_push(sb, " = (size_t)(")
                        string_push(sb, string_view(sib))
                        string_push(sb, "); assert(_ix")
                        push_uint(sb, n2 as i64)
                        string_push(sb, " < _s")
                        push_uint(sb, n2 as i64)
                        string_push(sb, ".len); _s")
                        push_uint(sb, n2 as i64)
                        string_push(sb, ".ptr[_ix")
                        push_uint(sb, n2 as i64)
                        string_push(sb, "] ")
                        string_push(sb, assign_c(e.op))
                        string_push(sb, " ")
                        string_push(sb, string_view(svb))
                        string_push(sb, "; })")
                    }
                    string_free(sbb)
                    string_free(sib)
                    string_free(svb)
                    return
                }
                if bd.kind == 9 {                     // array-index WRITE: fold into the stmt-expr
                    var bbuf: String = string_new()   // base/index/VALUE emit before the temp
                    emit_expr(bbuf, p, src, c, g, tgt.a)
                    var ibuf: String = string_new()
                    emit_expr(ibuf, p, src, c, g, tgt.b)
                    var vbuf2: String = string_new()
                    emit_expr(vbuf2, p, src, c, g, e.b)
                    let n: i32 = g.tmp                // (non-const pointer; ONE temp)
                    g.tmp = g.tmp + 1
                    string_push(sb, "({ ")
                    emit_su_tyid(sb, p, src, c, g, btid)   // subst-aware (the WRITE form)
                    string_push(sb, "* _a")
                    push_uint(sb, n as i64)
                    string_push(sb, " = &(")
                    string_push(sb, string_view(bbuf))
                    string_push(sb, "); size_t _ix")
                    push_uint(sb, n as i64)
                    string_push(sb, " = (size_t)(")
                    string_push(sb, string_view(ibuf))
                    string_push(sb, "); assert(_ix")
                    push_uint(sb, n as i64)
                    string_push(sb, " < ")
                    push_uint(sb, bd.b as i64)
                    string_push(sb, "); _a")
                    push_uint(sb, n as i64)
                    string_push(sb, "->a[_ix")
                    push_uint(sb, n as i64)
                    string_push(sb, "] ")
                    string_push(sb, assign_c(e.op))
                    string_push(sb, " ")
                    string_push(sb, string_view(vbuf2))
                    string_push(sb, "; })")
                    string_free(bbuf)
                    string_free(ibuf)
                    string_free(vbuf2)
                    return
                }
            }
        }
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, " ")
        string_push(sb, assign_c(e.op))
        string_push(sb, " ")
        emit_expr(sb, p, src, c, g, e.b)
        return
    }
    if e.kind == 15 {                                 // ArrayRepeat `[v; N]`: fill via a temp. ONE temp.
        let atid: i32 = list.get(i32, c.et, eid as usize)
        let ad: typeck.TyData = list.get(typeck.TyData, c.tys, atid as usize)   // Array: a=elem, b=len
        var vbuf: String = string_new()               // the value emits FIRST (reference order)
        emit_expr(vbuf, p, src, c, g, e.a)
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        string_push(sb, "({ ")
        emit_su_tyid(sb, p, src, c, g, atid)          // subst-aware: `[zero; 8]` of a `T`
        string_push(sb, " _ar")
        push_uint(sb, n as i64)
        string_push(sb, "; ")
        emit_su_tyid(sb, p, src, c, g, ad.a)          // ...and its ELEMENT type likewise
        string_push(sb, " _v")
        push_uint(sb, n as i64)
        string_push(sb, " = (")
        string_push(sb, string_view(vbuf))
        string_push(sb, "); for (size_t _k")
        push_uint(sb, n as i64)
        string_push(sb, " = 0; _k")
        push_uint(sb, n as i64)
        string_push(sb, " < ")
        push_uint(sb, ad.b as i64)
        string_push(sb, "; _k")
        push_uint(sb, n as i64)
        string_push(sb, "++) _ar")
        push_uint(sb, n as i64)
        string_push(sb, ".a[_k")
        push_uint(sb, n as i64)
        string_push(sb, "] = _v")
        push_uint(sb, n as i64)
        string_push(sb, "; _ar")
        push_uint(sb, n as i64)
        string_push(sb, "; })")
        string_free(vbuf)
        return
    }
    if e.kind == 34 {                                 // Invariant: assert(<cond>) (stmt adds `;`)
        string_push(sb, "assert(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 25 or e.kind == 23 {                 // VALUE-position unsafe { E } / { E } (B4):
        var beid: i32 = eid                           // yields the single tail expression's value
        if e.kind == 25 { beid = e.a }
        let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
        if blk.y == 1 {
            let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, blk.x as usize) as usize)
            if s.kind == 2 { emit_expr(sb, p, src, c, g, s.a) }
        }
        return
    }
    if e.kind == 24 {                                 // VALUE-position if/else (Q-S2b)
        // Lowered to C's conditional operator when both arms are a single tail
        // expression — it evaluates exactly one side, so it matches `if` semantics, needs
        // no temporary, and raises no drop question. An arm carrying statements is left
        // to the statement/return path (the reference diagnoses it there).
        let t: i32 = sd_tail_of(p, e.b)
        var f: i32 = 0 - 1
        if e.op >= 0 { f = sd_tail_of_expr(p, e.op) }
        if t >= 0 {
            if f >= 0 {
                string_push(sb, "((")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, ") ? (")
                emit_expr(sb, p, src, c, g, t)
                string_push(sb, ") : (")
                emit_expr(sb, p, src, c, g, f)
                string_push(sb, "))")
                return
            }
        }
        return
    }
    if e.kind == 35 {                                 // Variant: strictly-decreasing termination measure
        var t: i32 = 0 - 1
        var vi: usize = g.vtf as usize
        for vi < list.len(i32, g.vt) {                // only the CURRENT loop's hoisted trackers
            if list.get(i32, g.vt, vi) == eid { t = list.get(i32, g.vt, vi + 1) }
            vi = vi + 2
        }
        if t >= 0 {
            string_push(sb, "({ int64_t _vv")
            push_uint(sb, t as i64)
            string_push(sb, " = (int64_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "); assert(_vv")
            push_uint(sb, t as i64)
            string_push(sb, " >= 0); assert(_vv")
            push_uint(sb, t as i64)
            string_push(sb, " < _vt")
            push_uint(sb, t as i64)
            string_push(sb, "); _vt")
            push_uint(sb, t as i64)
            string_push(sb, " = _vv")
            push_uint(sb, t as i64)
            string_push(sb, "; })")
        } else {
            string_push(sb, "assert((int64_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ") >= 0)")
        }
        return
    }
    if e.kind == 32 {                                 // Break: labeled -> goto; plain reroutes past an `else`
        if e.x >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[e.x as usize .. e.y as usize])
            string_push(sb, "__break")
            return
        }
        if g.bl_fe >= 0 {
            string_push(sb, "goto _fe")
            push_uint(sb, g.bl_fe as i64)
            string_push(sb, "__break")
            return
        }
        if g.bl_ns >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[g.bl_ns as usize .. g.bl_ne as usize])
            string_push(sb, "__break")
            return
        }
        if g.sw {                                     // inside a switch-lowered match: a bare C
            if g.ll_ns >= 0 {                         // `break` would exit the SWITCH, not the loop
                string_push(sb, "goto ")
                string_push(sb, src[g.ll_ns as usize .. g.ll_ne as usize])
                string_push(sb, "__break")
                return
            }
            if g.swb < 0 { g.swb = g.tmp  g.tmp = g.tmp + 1 }   // synthesize `_sb{n}` on first use
            string_push(sb, "goto _sb")
            push_uint(sb, g.swb as i64)
            string_push(sb, "__break")
            return
        }
        string_push(sb, "break")
        return
    }
    if e.kind == 33 {                                 // Continue: labeled -> goto its target
        if e.x >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[e.x as usize .. e.y as usize])
            string_push(sb, "__continue")
            return
        }
        string_push(sb, "continue")
        return
    }
    if e.kind == 7 {                                  // Deref
        let btid: i32 = list.get(i32, c.et, e.a as usize)
        if btid >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, btid as usize)
            if bd.kind == 10 {                        // genref deref: generation check, ONE temp
                let n: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ ")
                emit_ty_c(sb, p, src, c, btid)
                string_push(sb, " _r")
                push_uint(sb, n as i64)
                string_push(sb, " = (")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, "); assert(((uint64_t*)_r")
                push_uint(sb, n as i64)
                string_push(sb, ".ptr)[-1] == _r")
                push_uint(sb, n as i64)
                string_push(sb, ".gen); *_r")
                push_uint(sb, n as i64)
                string_push(sb, ".ptr; })")
                return
            }
        }
        string_push(sb, "(*")                         // plain pointer deref
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 8 {                                  // Try `e?`: early-return-on-error statement-expr
        // **THE BASE IS EMITTED BEFORE `_q{n}` IS ALLOCATED, matching the reference's temp
        // order** -- the same rule the Catch arm below already states. The reference emits
        // the base expression first and only then formats its own temp name, so any temps
        // the base allocates get the lower numbers.
        //
        // Latent until `std/sysnet` wrote `send_bytes(s, buf[off .. buf.len])?`, which is
        // the corpus's first `?` over a call carrying a slice-RANGE argument: the reference
        // numbered the range's `_s2` before the try's `_q3`, the port numbered `_q2` before
        // `_s3`. Every existing `?` had an argument that allocates nothing, so the two
        // orders coincided and nothing noticed.
        var qb: String = string_new()
        emit_expr(qb, p, src, c, g, e.a)
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        // `!E`-only base: a unit result carries NO `ok` member, so nothing is yielded and
        // the statement-expression's type is `void` -- which is right, since `f(x)?` on a
        // unit-fallible callee is a statement. Same test the two recovering forms below
        // already use (`kind == 5` is Result, `.a == 1` is the unit ok type).
        let qbt: i32 = list.get(i32, c.et, e.a as usize)
        let qbtd: typeck.TyData = list.get(typeck.TyData, c.tys, qbt as usize)
        let q_unit: bool = qbtd.kind == 5 and qbtd.a == 1
        string_push(sb, "({ ")
        emit_ty_c(sb, p, src, c, qbt)                 // the base's own Result type
        string_push(sb, " _q")
        push_uint(sb, n as i64)
        string_push(sb, " = ")
        string_push(sb, string_view(qb))
        string_free(qb)
        string_push(sb, "; if (_q")
        push_uint(sb, n as i64)
        string_push(sb, ".is_err) return (")
        emit_result_name(sb, p, src, c, g, g.res_ok)                     // re-wrap in the CURRENT fn's result
        string_push(sb, "){ .is_err = true, .err = _q")
        push_uint(sb, n as i64)
        string_push(sb, ".err")
        if err_pay_gated(c) {                         // the BLIND union copy (D3)
            string_push(sb, ", .pay = _q")
            push_uint(sb, n as i64)
            string_push(sb, ".pay")
        }
        if q_unit {
            string_push(sb, " }; })")
        } else {
            string_push(sb, " }; _q")
            push_uint(sb, n as i64)
            string_push(sb, ".ok; })")
        }
        return
    }
    if e.kind == 45 {                                 // Catch `e catch v`: recover, don't propagate
        // Where `?` early-returns the error, this substitutes a value and carries on --
        // so it emits no `return` and needs no fallible enclosing fn. The fallback must
        // be evaluated ONLY on the error path (it is a fallback, not a default
        // argument), which is why this is C's conditional operator and not two
        // statements. The base is spilled to a temp because it is read twice.
        //
        // BASE AND FALLBACK ARE EMITTED BEFORE `_ct{n}` IS ALLOCATED, matching the
        // reference's temp order. Emitting them straight into `sb` would number this
        // node's temp ahead of theirs the moment either allocates one.
        var sbb: String = string_new()
        emit_expr(sbb, p, src, c, g, e.a)
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        let bt: i32 = list.get(i32, c.et, e.a as usize)
        let btd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
        // `catch |e| return e` -- explicit propagation: exactly `?`'s lowering (early
        // return, tag preserved), and the fallback (the binder name) is NEVER emitted.
        if e.op == 1 {
            if g.res_ok < 0 {                         // outside a fallible fn: the diag case
                string_push(sb, "((")
                string_push(sb, string_view(sbb))
                string_push(sb, ").ok)")
                string_free(sbb)
                return
            }
            string_push(sb, "({ ")
            emit_ty_c(sb, p, src, c, bt)
            string_push(sb, " _ct")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            string_push(sb, string_view(sbb))
            string_push(sb, "; if (_ct")
            push_uint(sb, n as i64)
            string_push(sb, ".is_err) return (")
            emit_result_name(sb, p, src, c, g, g.res_ok)
            string_push(sb, "){ .is_err = true, .err = _ct")
            push_uint(sb, n as i64)
            string_push(sb, ".err")
            if err_pay_gated(c) {                     // rethrow copies pay exactly as `?` does
                string_push(sb, ", .pay = _ct")
                push_uint(sb, n as i64)
                string_push(sb, ".pay")
            }
            if btd.kind == 5 and btd.a == 1 {     // `!E`-only: nothing to yield
                string_push(sb, " }; })")
            } else {
                string_push(sb, " }; _ct")
                push_uint(sb, n as i64)
                string_push(sb, ".ok; })")
            }
            string_free(sbb)
            return
        }
        // `catch |e| fallback` -- the binder is a `const int` scoped to the error
        // branch. A `?:` cannot carry a declaration, so this form lowers as if/else
        // over a result variable; the binder-less form below KEEPS its original `?:`
        // string, character for character.
        if e.x >= 0 {
            // `catch |e| match e { ... }` -- the payload extractor (E5, the
            // reference's emit_err_match): when the fallback is a match over
            // the binder itself, it lowers to a tag if-chain in the error
            // branch. `_cv` is allocated BEFORE the arm bodies are emitted
            // (the reference's temp order), and the LAST arm is unconditional
            // -- exhaustiveness was proven at check time.
            let fbe: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
            var is_extract: bool = false
            if fbe.kind == 28 {
                let sce: parser.ExprData = list.get(parser.ExprData, p.ex, fbe.a as usize)
                if sce.kind == 2 {
                    if str_eq(src[sce.start .. sce.end], src[e.x as usize .. e.y as usize]) { is_extract = true }
                }
            }
            if is_extract {
                emit_err_match(sb, p, src, c, g, e, fbe, string_view(sbb), n, bt)
                string_free(sbb)
                return
            }
            var svb2: String = string_new()
            emit_expr(svb2, p, src, c, g, e.b)        // fallback BEFORE `_cv` is allocated
            let m: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            emit_ty_c(sb, p, src, c, bt)
            string_push(sb, " _ct")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            string_push(sb, string_view(sbb))
            if btd.kind == 5 and btd.a == 1 {         // `!E`-only: no `ok` member
                string_push(sb, "; if (_ct")
                push_uint(sb, n as i64)
                string_push(sb, ".is_err) { const int j_")
                string_push(sb, src[e.x as usize .. e.y as usize])
                string_push(sb, " = _ct")
                push_uint(sb, n as i64)
                string_push(sb, ".err; (void)j_")
                string_push(sb, src[e.x as usize .. e.y as usize])
                string_push(sb, "; ")
                string_push(sb, string_view(svb2))
                string_push(sb, "; } })")
            } else {
                string_push(sb, "; ")
                if btd.kind == 5 { emit_ty_c(sb, p, src, c, btd.a) } else { string_push(sb, "int") }
                string_push(sb, " _cv")
                push_uint(sb, m as i64)
                string_push(sb, "; if (_ct")
                push_uint(sb, n as i64)
                string_push(sb, ".is_err) { const int j_")
                string_push(sb, src[e.x as usize .. e.y as usize])
                string_push(sb, " = _ct")
                push_uint(sb, n as i64)
                string_push(sb, ".err; (void)j_")
                string_push(sb, src[e.x as usize .. e.y as usize])
                string_push(sb, "; _cv")
                push_uint(sb, m as i64)
                string_push(sb, " = (")
                string_push(sb, string_view(svb2))
                string_push(sb, "); } else { _cv")
                push_uint(sb, m as i64)
                string_push(sb, " = _ct")
                push_uint(sb, n as i64)
                string_push(sb, ".ok; } _cv")
                push_uint(sb, m as i64)
                string_push(sb, "; })")
            }
            string_free(sbb)
            string_free(svb2)
            return
        }
        var svb: String = string_new()
        emit_expr(svb, p, src, c, g, e.b)
        string_push(sb, "({ ")
        emit_ty_c(sb, p, src, c, bt)                  // the base's own Result type
        string_push(sb, " _ct")
        push_uint(sb, n as i64)
        string_push(sb, " = ")
        string_push(sb, string_view(sbb))
        if btd.kind == 5 and btd.a == 1 {             // `!E`-only: no `ok` member to read
            string_push(sb, "; if (_ct")
            push_uint(sb, n as i64)
            string_push(sb, ".is_err) { ")
            string_push(sb, string_view(svb))
            string_push(sb, "; } })")
        } else {
            string_push(sb, "; _ct")
            push_uint(sb, n as i64)
            string_push(sb, ".is_err ? (")
            string_push(sb, string_view(svb))
            string_push(sb, ") : _ct")
            push_uint(sb, n as i64)
            string_push(sb, ".ok; })")
        }
        string_free(sbb)
        string_free(svb)
        return
    }
    if e.kind == 37 {                                 // Closure: the lifted value at its creation site
        let k: i32 = closure_index_of(g, eid)
        if k < 0 { string_push(sb, "0")  return }     // uncollected (e.g. in a generic body): the diag case
        let rn: i32 = ref_expr_id(p, eid)
        if closure_is_thin(c, eid) {                  // coerced: the value IS the function's address
            string_push(sb, "(&jestyr_lam_")
            push_uint(sb, rn as i64)
            string_push(sb, ")")
            return
        }
        let cb: i32 = list.get(i32, g.ccx, (k * 2) as usize)
        let cc: i32 = list.get(i32, g.ccx, (k * 2 + 1) as usize)
        string_push(sb, "(JestyrClosure_")
        push_uint(sb, rn as i64)
        string_push(sb, "){ .call = jestyr_lam_")
        push_uint(sb, rn as i64)
        string_push(sb, ", .env = ")
        if cc == 0 { string_push(sb, "{0}") }
        else {
            string_push(sb, "{ ")
            var ci: i32 = 0
            for ci < cc {
                if ci > 0 { string_push(sb, ", ") }
                let b: i32 = (cb + ci) * 3
                let ns: i32 = list.get(i32, g.cca, b as usize)
                let ne: i32 = list.get(i32, g.cca, (b + 1) as usize)
                string_push(sb, ".j_")
                string_push(sb, src[ns as usize .. ne as usize])
                string_push(sb, " = ")
                // the captured value in the ENCLOSING scope (a by-pointer param derefs)
                if is_ptr_name(g, src, ns as usize, ne as usize) {
                    string_push(sb, "(*j_")
                    string_push(sb, src[ns as usize .. ne as usize])
                    string_push(sb, ")")
                } else {
                    string_push(sb, "j_")
                    string_push(sb, src[ns as usize .. ne as usize])
                }
                ci = ci + 1
            }
            string_push(sb, " }")
        }
        string_push(sb, " }")
        return
    }
    if e.kind == 40 {                                 // await h: join-once + yield the task box's ret
        let t: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
        if t.kind == 2 {
            var ti: usize = g.thf as usize
            for ti < list.len(i32, g.th) {
                let hns: i32 = list.get(i32, g.th, ti)
                let hne: i32 = list.get(i32, g.th, ti + 1)
                if str_eq(src[t.start .. t.end], src[hns as usize .. hne as usize]) {
                    let h: i32 = list.get(i32, g.th, ti + 2)
                    string_push(sb, "({ if (!_jd")
                    push_uint(sb, h as i64)
                    string_push(sb, ") { pthread_join(_jt")
                    push_uint(sb, h as i64)
                    string_push(sb, ", NULL); _jd")
                    push_uint(sb, h as i64)
                    string_push(sb, " = 1; }")
                    if list.get(i32, g.th, ti + 3) == 1 {
                        string_push(sb, " _ja")
                        push_uint(sb, h as i64)
                        string_push(sb, ".ret;")
                    }
                    string_push(sb, " })")
                    return
                }
                ti = ti + 4
            }
        }
        string_push(sb, "0")                          // unresolved handle: the diag case
        return
    }
    if e.kind == 41 {                                 // `par for v in xs reduce(r) { body }`:
        // map serially into a scratch []i64, then the deterministic par_reduce. ONE temp,
        // taken FIRST; iter/reduction/body emit in that order. Mirrors `emit_par_for`.
        let pfn: i32 = g.tmp
        g.tmp = g.tmp + 1
        // The SOURCE keeps its own element type while the engine still takes []i64 — two
        // different slice types in one lowering, which is exactly what makes iterating a
        // narrower width free. An i64 source reproduces the previous C character for
        // character. Mirrors `emit_par_for`.
        let ety: i32 = par_elem_ty(c, e.a)
        if sd_is_site(g, eid) {
            sd_emit_par_for(sb, p, src, c, g, e, eid, ety, pfn)
            return
        }
        let pfi: i32 = pf_index_of(g, eid)
        if pfi >= 0 {
            pf_emit_fused(sb, p, src, c, g, e, ety, pfn, pfi)
            return
        }
        string_push(sb, "({ JestyrSlice_")
        push_ty_mangle(sb, src, c, ety)
        string_push(sb, " _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, " = ")
        emit_expr(sb, p, src, c, g, e.a)              // iter
        string_push(sb, "; int64_t* _pm")
        push_uint(sb, pfn as i64)
        string_push(sb, " = (int64_t*)malloc(_pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".len * sizeof(int64_t)); for (size_t _pi")
        push_uint(sb, pfn as i64)
        string_push(sb, " = 0; _pi")
        push_uint(sb, pfn as i64)
        string_push(sb, " < _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".len; _pi")
        push_uint(sb, pfn as i64)
        string_push(sb, "++) { ")
        emit_ty_c(sb, p, src, c, ety)                 // the loop var has the ELEMENT's type
        string_push(sb, " j_")
        string_push(sb, src[e.x as usize .. e.y as usize])
        string_push(sb, " = _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".ptr[_pi")
        push_uint(sb, pfn as i64)
        string_push(sb, "]; _pm")
        push_uint(sb, pfn as i64)
        string_push(sb, "[_pi")
        push_uint(sb, pfn as i64)
        string_push(sb, "] = ")
        var prd: String = string_new()                // reduction BEFORE body (reference order)
        emit_expr(prd, p, src, c, g, e.b)
        // The contribution is widened once per element — and the cast is OMITTED when the
        // body is already i64, so the pre-existing lowering is reproduced exactly.
        let bty: i32 = list.get(i32, c.et, e.op as usize)
        let widen: bool = ty_is_i64(c, bty) == false
        if widen { string_push(sb, "(int64_t)(") }
        emit_expr(sb, p, src, c, g, e.op)             // body (references j_<var>)
        if widen { string_push(sb, ")") }
        string_push(sb, "; } int64_t _pr")
        push_uint(sb, pfn as i64)
        string_push(sb, " = jestyr_par_reduce((JestyrSlice_i64){ _pm")
        push_uint(sb, pfn as i64)
        string_push(sb, ", _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".len }, ")
        string_push(sb, string_view(prd))
        string_push(sb, "); free(_pm")
        push_uint(sb, pfn as i64)
        string_push(sb, "); _pr")
        push_uint(sb, pfn as i64)
        string_push(sb, "; })")
        string_free(prd)
        return
    }
    if e.kind == 22 {                                 // FString: the _fs{n} push chain
        emit_fstring(sb, p, src, c, g, e)
        return
    }
    if e.kind == 10 {                                 // Call
        emit_call(sb, p, src, c, g, e, eid)
        return
    }
}

// An AssignOp code (parser `assign_op`, 1..9) rendered as its C operator (mirrors `assign_c`).
fn assign_c(code: i32) -> str {
    if code == 1 { return "=" }
    if code == 2 { return "+=" }
    if code == 3 { return "-=" }
    if code == 4 { return "*=" }
    if code == 5 { return "/=" }
    if code == 6 { return "%=" }
    if code == 7 { return "&=" }
    if code == 8 { return "|=" }
    if code == 9 { return "^=" }
    return "="
}

// An integer literal with `_` digit separators removed (mirrors `c_int_literal`; the `0b` binary
// -> decimal rewrite is added when a corpus file needs it — decimal/`0x` are already valid C).
fn emit_int_literal(mut sb: String, read lex: str) {
    // A `0b`/`0B` binary literal is not valid C: convert to decimal (mirrors `c_int_literal`).
    // Decimal and `0x…` pass through with `_` separators stripped.
    if lex.len > 2 {
        if str_eq(lex[0 .. 2], "0b") or str_eq(lex[0 .. 2], "0B") {
            var v: i64 = 0
            var k: usize = 2
            for k < lex.len {
                let ch: str = lex[k .. k + 1]
                if str_eq(ch, "1") { v = v * 2 + 1 }
                else if str_eq(ch, "0") { v = v * 2 }
                k = k + 1                             // `_` separators just skip
            }
            push_uint(sb, v)
            return
        }
    }
    var i: usize = 0
    for i < lex.len {
        let c: str = lex[i .. i + 1]
        if !str_eq(c, "_") { string_push(sb, c) }
        i = i + 1
    }
}

// The C runtime helper an intrinsic call lowers to (`""` = not a runtime intrinsic). The print
// intrinsics and the byte-level string ops all lower to `<helper>(<args>)`, which is exactly what
// `emit_arg_list` produces (and what the reference's `emit_str_binop`/print arms emit for the
// argument counts these are called with). Grown as corpus files introduce more intrinsics.
fn intrinsic_helper(read nm: str) -> str {
    if str_eq(nm, "print_str") { return "jestyr_rt_print_str" }
    if str_eq(nm, "print_int") { return "jestyr_rt_print_int" }
    if str_eq(nm, "print_bool") { return "jestyr_rt_print_bool" }
    if str_eq(nm, "print_float") { return "jestyr_rt_print_float" }
    if str_eq(nm, "str_eq") { return "jestyr_rt_str_eq" }
    if str_eq(nm, "eq_fold") { return "jestyr_rt_eq_fold" }
    if str_eq(nm, "starts_with") { return "jestyr_rt_starts_with" }
    if str_eq(nm, "ends_with") { return "jestyr_rt_ends_with" }
    if str_eq(nm, "contains") { return "jestyr_rt_contains" }
    if str_eq(nm, "find") { return "jestyr_rt_find" }
    if str_eq(nm, "trim") { return "jestyr_rt_trim" }
    if str_eq(nm, "read_file") { return "jestyr_rt_read_file" }
    if str_eq(nm, "run_command") { return "jestyr_rt_run_command" }
    if str_eq(nm, "eprint_str") { return "jestyr_rt_eprint_str" }
    if str_eq(nm, "signal_arm") { return "jestyr_rt_signal_arm" }
    if str_eq(nm, "signal_caught") { return "jestyr_rt_signal_caught" }
    if str_eq(nm, "signal_raise") { return "jestyr_rt_signal_raise" }
    if str_eq(nm, "random_fill") { return "jestyr_rt_random_fill" }
    if str_eq(nm, "env_block") { return "jestyr_rt_env_block" }
    if str_eq(nm, "env_var") { return "jestyr_rt_env_var" }
    if str_eq(nm, "mono_nanos") { return "jestyr_rt_mono_nanos" }
    if str_eq(nm, "write_file") { return "jestyr_rt_write_file" }
    if str_eq(nm, "file_exists") { return "jestyr_rt_file_exists" }
    if str_eq(nm, "remove_file") { return "jestyr_rt_remove_file" }
    if str_eq(nm, "substr") { return "jestyr_rt_substr" }
    if str_eq(nm, "count_cp") { return "jestyr_rt_count_cp" }
    if str_eq(nm, "count_graphemes") { return "jestyr_rt_count_graphemes" }
    if str_eq(nm, "to_str_lossy") { return "jestyr_rt_to_str_lossy" }
    if str_eq(nm, "string_from") { return "jestyr_rt_str_from" }
    if str_eq(nm, "cow_borrow") { return "jestyr_rt_cow_borrow" }
    if str_eq(nm, "cow_to_mut") { return "jestyr_rt_cow_to_mut" }
    if str_eq(nm, "cow_view") { return "jestyr_rt_cow_view" }
    if str_eq(nm, "cow_is_owned") { return "jestyr_rt_cow_is_owned" }
    return ""
}

// Intrinsics that take their FIRST argument by address (`<helper>(&<a0>[, rest])`) — the mutating
// owned-buffer operations. "" = not one of them.
fn intrinsic_helper_byref(read nm: str) -> str {
    if str_eq(nm, "string_push") { return "jestyr_rt_str_push" }
    if str_eq(nm, "string_view") { return "jestyr_rt_str_view" }
    if str_eq(nm, "string_free") { return "jestyr_rt_str_free" }
    if str_eq(nm, "cow_free") { return "jestyr_rt_cow_free" }
    if str_eq(nm, "builder_push") { return "jestyr_rt_b_push" }
    if str_eq(nm, "builder_build") { return "jestyr_rt_b_build" }
    if str_eq(nm, "builder_free") { return "jestyr_rt_b_free" }
    return ""
}


// An f-string (a single lexer token; the node is span-only) lowers to the reference's
// statement-expression push chain: `({ JestyrString _fs{n} = jestyr_rt_str_new(); …; _fs{n}; })`.
// The token text is re-scanned from src (like the parser dump does): literal runs push
// `JSTR("…")` verbatim; a `{name}` interp pushes by the name's TYPE — str directly, String via
// str_view, bool via a ternary, anything else as decimal via str_push_i64. Interp names resolve
// against the CURRENT fn's params and (annotated or inferred) lets — corpus interps are bare
// names; general sub-expressions would need parser support (kind-22 is span-only).
fn emit_fstring(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    string_push(sb, "({ JestyrString _fs")
    push_uint(sb, n as i64)
    string_push(sb, " = jestyr_rt_str_new(); ")
    var i: usize = e.start + 2                        // skip `f"`
    var part_start: usize = i
    for i < e.end - 1 {
        if str_eq(src[i .. i + 1], "{") {
            if i > part_start {                       // flush the literal run before the interp
                string_push(sb, "jestyr_rt_str_push(&_fs")
                push_uint(sb, n as i64)
                string_push(sb, ", JSTR(\"")
                string_push(sb, src[part_start .. i])
                string_push(sb, "\")); ")
            }
            var j: usize = i + 1
            for j < e.end - 1 {
                if str_eq(src[j .. j + 1], "}") { break }
                j = j + 1
            }
            emit_fstring_interp(sb, p, src, c, g, n, i + 1, j)
            i = j + 1
            part_start = i
        } else {
            i = i + 1
        }
    }
    if i > part_start {                               // the trailing literal run
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", JSTR(\"")
        string_push(sb, src[part_start .. i])
        string_push(sb, "\")); ")
    }
    string_push(sb, "_fs")
    push_uint(sb, n as i64)
    string_push(sb, "; })")
}

// One `{name}` interpolation: emit the push matching the name's type category.
fn emit_fstring_interp(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, n: i32, ns: usize, ne: usize) {
    let cat: i32 = fstring_cat(p, src, c, g, ns, ne)
    if cat == 0 {                                     // str: push the view directly
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", ")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, "); ")
        return
    }
    if cat == 1 {                                     // String: borrow as a view first
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", jestyr_rt_str_view(&")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, ")); ")
        return
    }
    if cat == 2 {                                     // bool: a true/false ternary
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", (")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, ") ? JSTR(\"true\") : JSTR(\"false\")); ")
        return
    }
    string_push(sb, "jestyr_rt_str_push_i64(&_fs")    // integers (and the fallback): decimal
    push_uint(sb, n as i64)
    string_push(sb, ", (int64_t)(")
    emit_fstring_name(sb, src, g, ns, ne)
    string_push(sb, ")); ")
}

// An interp name as a C value (`j_<name>`, `(*j_<name>)` for a by-pointer param).
fn emit_fstring_name(mut sb: String, read src: str, read g: Cg, ns: usize, ne: usize) {
    if is_ptr_name(g, src, ns, ne) {
        string_push(sb, "(*j_")
        string_push(sb, src[ns .. ne])
        string_push(sb, ")")
        return
    }
    string_push(sb, "j_")
    string_push(sb, src[ns .. ne])
}

// The type CATEGORY of interp name `src[ns..ne]` in the current fn: 0 str, 1 String, 2 bool,
// 3 other (decimal). Params first, then `let`/`var` statements whose span lies inside the fn
// (annotation text, else the init's Checker prim: 14 str, 17 String, 12 bool).
fn fstring_cat(read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, ns: usize, ne: usize) -> i32 {
    if g.curfn < 0 { return 3 }
    let fd: parser.ItemData = list.get(parser.ItemData, p.it, g.curfn as usize)
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
        let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
        if str_eq(src[ns .. ne], src[pns as usize .. pne as usize]) {
            return ast_ty_cat(p, src, list.get(i32, p.iar, (base + 5) as usize))
        }
        i = i + 1
    }
    var si: usize = 0
    for si < list.len(parser.StmtData, p.st) {
        let sd: parser.StmtData = list.get(parser.StmtData, p.st, si)
        if sd.kind == 0 and sd.start >= fd.start and sd.end <= fd.end {
            if str_eq(src[ns .. ne], src[sd.x as usize .. sd.y as usize]) {
                if sd.ty >= 0 { return ast_ty_cat(p, src, sd.ty) }
                if sd.a >= 0 {
                    let tid: i32 = list.get(i32, c.et, sd.a as usize)
                    if tid >= 0 {
                        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
                        if d.kind == 2 {
                            if d.x == 14 { return 0 }
                            if d.x == 17 { return 1 }
                            if d.x == 12 { return 2 }
                        }
                    }
                }
                return 3
            }
        }
        si = si + 1
    }
    return 3
}

// The interp category of an AST type annotation (a bare Name node's text).
fn ast_ty_cat(read p: parser.Parser, read src: str, tyid: i32) -> i32 {
    if tyid < 0 { return 3 }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 0 { return 3 }
    if str_eq(src[t.start .. t.end], "str") { return 0 }
    if str_eq(src[t.start .. t.end], "String") { return 1 }
    if str_eq(src[t.start .. t.end], "bool") { return 2 }
    return 3
}

// The TYPE KEY of a Checker type: a Named type's name, a prim's Jestyr name (both already C
// identifiers — the reference sanitises only exotic keys these can't produce).
fn push_key_of_tyid(mut sb: String, read src: str, read c: typeck.Checker, tid: i32) {
    if tid < 0 { return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 15 {
        let kns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let kne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, src[kns as usize .. kne as usize])
        return
    }
    if d.kind == 2 { string_push(sb, prim_jname(d.x)) }
}

// The fn item of `impl <src[tns..tne]> for <key>`'s method named `src[mns..mne]`, or -1
// (used for the self/arg conventions of impl and operator dispatch).
fn find_impl_method_item(read p: parser.Parser, read src: str, tns: i32, tne: i32, read key: str, mns: i32, mne: i32) -> i32 {
    var mid: i32 = 0 - 1
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            if str_eq(src[it.x .. it.y], src[tns as usize .. tne as usize]) {
                let tt: parser.TypeData = list.get(parser.TypeData, p.ty, it.a as usize)
                if tt.kind == 0 {
                    if str_eq(src[tt.start .. tt.end], key) {
                        var k: i32 = 0
                        for k < it.z {
                            let cand: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                            let fd0: parser.ItemData = list.get(parser.ItemData, p.it, cand as usize)
                            if str_eq(src[fd0.x .. fd0.y], src[mns as usize .. mne as usize]) { mid = cand }
                            k = k + 1
                        }
                    }
                }
            }
        }
        r = r + 1
    }
    return mid
}

// An operator-trait binary op (`a + b` on a user type, icalls-recorded on the Binary id):
// `jestyr_impl_<Trait>__<key>__<m>(a, b)`. The four base ops call directly; the DERIVED
// comparisons reuse a base with a swap and/or negate: `!=` -> !eq(a,b), `>` -> lt(b,a),
// `<=` -> !lt(b,a), `>=` -> !lt(a,b). Mirrors `emit_operator_call`.
fn emit_operator_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, ob: i32) {
    let tns: i32 = list.get(i32, c.icalls, (ob + 1) as usize)
    let tne: i32 = list.get(i32, c.icalls, (ob + 2) as usize)
    let mns: i32 = list.get(i32, c.icalls, (ob + 3) as usize)
    let mne: i32 = list.get(i32, c.icalls, (ob + 4) as usize)
    let swap: bool = e.op == 10 or e.op == 9          // `>` and `<=` compare via b < a
    let negate: bool = e.op == 7 or e.op == 9 or e.op == 11   // !=, <=, >= negate their base
    var key: String = string_new()
    push_key_of_tyid(key, src, c, list.get(i32, c.et, e.a as usize))
    let mid: i32 = find_impl_method_item(p, src, tns, tne, string_view(key), mns, mne)
    var sconv: i32 = 0
    var rconv: i32 = 0
    if mid >= 0 {
        sconv = method_self_conv(p, mid)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
        var pi: i32 = 0
        for pi < fd.b {                               // the first non-self, non-comptime param
            let pb: i32 = fd.a + pi * 7
            if rconv == 0 and list.get(i32, p.iar, pb as usize) == 0 and list.get(i32, p.iar, (pb + 4) as usize) == 0 {
                rconv = list.get(i32, p.iar, (pb + 1) as usize)
            }
            pi = pi + 1
        }
    }
    var recv_id: i32 = e.a
    var arg_id: i32 = e.b
    if swap { recv_id = e.b  arg_id = e.a }
    if negate { string_push(sb, "(!") }
    string_push(sb, "jestyr_impl_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "__")
    string_push(sb, string_view(key))
    string_push(sb, "__")
    string_push(sb, src[mns as usize .. mne as usize])
    string_push(sb, "(")
    string_free(key)
    if sconv == 2 or sconv == 4 {
        emit_addr_arg(sb, p, src, c, g, recv_id)
    } else {
        emit_expr(sb, p, src, c, g, recv_id)
    }
    string_push(sb, ", ")
    if rconv == 2 or rconv == 4 {
        emit_addr_arg(sb, p, src, c, g, arg_id)
    } else {
        emit_expr(sb, p, src, c, g, arg_id)
    }
    string_push(sb, ")")
    if negate { string_push(sb, ")") }
}

// The impl-dispatch lowering shared by icalls (concrete receiver) and bcalls (bound receiver,
// key resolved through the ACTIVE substitution): a direct call of
// `jestyr_impl_<Trait>__<key>__<method>`, the receiver first (by `&` for a `mut`/`out self`),
// args honouring the resolved impl method's conventions (param 0 = self). The method name is
// the callee Field's span. Mirrors `emit_impl_call`.
fn emit_impl_dispatch(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read callee: parser.ExprData, tns: i32, tne: i32, read key: str) {
    let mns: i32 = callee.x
    let mne: i32 = callee.y
    let mid: i32 = find_impl_method_item(p, src, tns, tne, key, mns, mne)
    string_push(sb, "jestyr_impl_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "__")
    string_push(sb, key)
    string_push(sb, "__")
    string_push(sb, src[mns as usize .. mne as usize])
    string_push(sb, "(")
    var sconv: i32 = 0
    if mid >= 0 { sconv = method_self_conv(p, mid) }
    if sconv == 2 or sconv == 4 {
        emit_addr_arg(sb, p, src, c, g, callee.a)
    } else {
        emit_expr(sb, p, src, c, g, callee.a)
    }
    var ai: i32 = 0
    for ai < e.y {
        string_push(sb, ", ")
        var byref: bool = false
        if mid >= 0 {
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
            if ai + 1 < fd.b {
                let pconv: i32 = list.get(i32, p.iar, (fd.a + (ai + 1) * 7 + 1) as usize)
                if pconv == 2 or pconv == 4 { byref = true }
            }
        }
        if byref {
            emit_addr_arg(sb, p, src, c, g, arg_at(p, e, ai))
        } else {
            emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
        }
        ai = ai + 1
    }
    string_push(sb, ")")
}

// A call. Intrinsics (see `intrinsic_helper`) lower to `<helper>(<args>)`; `size_of(T)` lowers to
// C `sizeof(<cty>)`; a plain named call to a user function lowers to `jestyr_<name>(<args>)`.
// Method sugar and mangled/collision names later.
fn emit_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, eid: i32) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    // `@name(…)` is a whole FAMILY of forms, only some of which are compile-time
    // queries — `@address(0x…)` in an MMIO declaration is a call this backend still has
    // to emit normally. So the guard is on the intrinsic NAME, not on the `@` sigil.
    if callee.kind == 21 and ctfe.is_reflect(src[callee.x as usize .. callee.y as usize]) {
        // Unlike `size_of`/`align_of`/`offset_of`, these are answered by THIS compiler
        // rather than deferred to C, so they reach the output as a literal. Total, and
        // never the first place a user hears about a bad query: typeck's fold ran first.
        var rci: ctfe.Interp = ctfe.make(g.alloc)
        let rv: ctfe.Value = ctfe.eval(rci, p, src, eid)
        if rci.failed { string_push(sb, "0") }
        else if rv.tag == 0 { push_i64(sb, rv.i) }
        else if rv.tag == 2 {
            string_push(sb, "JSTR(")
            push_c_string(sb, ctfe.str_of(rci, rv))
            string_push(sb, ")")
        } else { string_push(sb, "0") }
        return
    }
    if callee.kind == 5 {                             // method sugar `recv.m(args)`
        let packed: i32 = resolve_method_call(p, src, c, callee)
        if packed >= 0 {
            let sit: i32 = packed / 1000000
            let fid: i32 = packed % 1000000
            let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
            string_push(sb, "jestyr_")
            string_push(sb, src[sd.x .. sd.y])
            string_push(sb, "_")
            string_push(sb, src[callee.x as usize .. callee.y as usize])
            string_push(sb, "(")
            // The receiver is the first C argument: by address for a `mut`/`out self`.
            let sconv: i32 = method_self_conv(p, fid)
            if sconv == 2 or sconv == 4 {
                emit_addr_arg(sb, p, src, c, g, callee.a)
            } else {
                emit_expr(sb, p, src, c, g, callee.a)
            }
            // Then the call args, honouring the method's own param conventions (param 0 = self).
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
            var ai: i32 = 0
            for ai < e.y {
                string_push(sb, ", ")
                var byref: bool = false
                if ai + 1 < fd.b {
                    let pconv: i32 = list.get(i32, p.iar, (fd.a + (ai + 1) * 7 + 1) as usize)
                    if pconv == 2 or pconv == 4 { byref = true }
                }
                if byref {
                    emit_addr_arg(sb, p, src, c, g, arg_at(p, e, ai))
                } else {
                    emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
                }
                ai = ai + 1
            }
            string_push(sb, ")")
            return
        }
        // A FREE-fn method-sugar call (`mcalls`): `xs.push(10)` lowers to the free fn with the
        // receiver as the first argument — a generic target names its instance with targs
        // RECOVERED from the receiver (su-resolved), a plain target calls directly. Free
        // resolution outranks a struct-node method, mirroring typeck's order.
        let mcf: i32 = mcall_of(c, eid)
        if mcf >= 0 {
            let mfd: parser.ItemData = list.get(parser.ItemData, p.it, mcf as usize)
            string_push(sb, "jestyr_")
            string_push(sb, src[mfd.x .. mfd.y])
            if fn_is_gen(p, mfd) {
                string_push(sb, "__")
                let rtid2: i32 = list.get(i32, c.et, callee.a as usize)
                var mt: i32 = 0
                var mpi: i32 = 0
                let mrp: i32 = first_runtime_param_ty(p, mcf)
                for mpi < mfd.b {
                    let mbase: i32 = mfd.a + mpi * 7
                    if list.get(i32, p.iar, mbase as usize) == 1 {
                        let mpty: i32 = list.get(i32, p.iar, (mbase + 5) as usize)
                        if mpty >= 0 {
                            let mtd: parser.TypeData = list.get(parser.TypeData, p.ty, mpty as usize)
                            if mtd.kind == 1 {
                                if mt > 0 { string_push(sb, "_") }
                                let midx: i32 = app_targ_index(p, src, mrp, list.get(i32, p.iar, (mbase + 2) as usize) as usize, list.get(i32, p.iar, (mbase + 3) as usize) as usize)
                                var mdone: bool = false
                                if midx >= 0 and rtid2 >= 0 {
                                    let mrd: typeck.TyData = list.get(typeck.TyData, c.tys, rtid2 as usize)
                                    if mrd.kind == 6 and midx < mrd.b {
                                        let marg: i32 = list.get(i32, c.tya, (mrd.a + midx) as usize)
                                        let mad: typeck.TyData = list.get(typeck.TyData, c.tys, marg as usize)
                                        if mad.kind == 4 {   // Opaque tparam: resolve via g.su
                                            let msl: i32 = su_slot(src, g, mad.x as usize, mad.y as usize)
                                            if msl >= 0 {
                                                push_targ_mangle(sb, src, c, list.get(i32, g.su, (msl + 2) as usize), list.get(i32, g.su, (msl + 3) as usize), list.get(i32, g.su, (msl + 4) as usize))
                                                mdone = true
                                            }
                                        }
                                        if !mdone { push_ty_mangle(sb, src, c, marg)  mdone = true }
                                    }
                                }
                                if !mdone { string_push(sb, "x") }
                                mt = mt + 1
                            }
                        }
                    }
                    mpi = mpi + 1
                }
            }
            string_push(sb, "(")
            // the receiver takes the FIRST runtime param's convention…
            var mrconv: i32 = 0
            var mfirst: i32 = 0 - 1
            var mj: i32 = 0
            for mj < mfd.b {
                let mb2: i32 = mfd.a + mj * 7
                if mfirst < 0 and list.get(i32, p.iar, mb2 as usize) == 0 {
                    mfirst = mj
                    mrconv = list.get(i32, p.iar, (mb2 + 1) as usize)
                }
                mj = mj + 1
            }
            if mrconv == 2 or mrconv == 4 {
                emit_addr_arg(sb, p, src, c, g, callee.a)
            } else {
                emit_expr(sb, p, src, c, g, callee.a)
            }
            // …and each call arg the convention of the runtime param AFTER it.
            var mai: i32 = 0
            for mai < e.y {
                string_push(sb, ", ")
                var mbyref: bool = false
                let mpidx: i32 = mfirst + 1 + mai
                if mpidx < mfd.b {
                    let mb3: i32 = mfd.a + mpidx * 7
                    if list.get(i32, p.iar, mb3 as usize) == 0 {
                        let mpc: i32 = list.get(i32, p.iar, (mb3 + 1) as usize)
                        if mpc == 2 or mpc == 4 { mbyref = true }
                    }
                }
                if mbyref {
                    emit_addr_arg(sb, p, src, c, g, arg_at(p, e, mai))
                } else {
                    emit_expr(sb, p, src, c, g, arg_at(p, e, mai))
                }
                mai = mai + 1
            }
            string_push(sb, ")")
            return
        }
        // A GENERIC-struct method call: the receiver's kind-6 instance type (su-resolved
        // inside template bodies) names the monomorphized `jestyr_<Ctor>__<mangles>_<method>`;
        // the receiver passes by `&` for a `mut`/`out self`, args honour the method's convs
        // (the method must live in the ctor's struct node — an impl method never hijacks).
        let grt: i32 = list.get(i32, c.et, callee.a as usize)
        if grt >= 0 {
            let grd: typeck.TyData = list.get(typeck.TyData, c.tys, grt as usize)
            if grd.kind == 6 {
                let cfit: i32 = gstruct_ctor_fn(p, src, c, grt)
                if cfit >= 0 {
                    let mfit: i32 = gnode_method(p, src, cfit, callee.x as usize, callee.y as usize)
                    if mfit >= 0 {
                        string_push(sb, "jestyr_")
                        string_push(sb, src[grd.x as usize .. grd.y as usize])
                        string_push(sb, "__")
                        var gi2: i32 = 0
                        for gi2 < grd.b {
                            if gi2 > 0 { string_push(sb, "_") }
                            let garg: i32 = list.get(i32, c.tya, (grd.a + gi2) as usize)
                            let gad: typeck.TyData = list.get(typeck.TyData, c.tys, garg as usize)
                            var gdone: bool = false
                            if gad.kind == 4 {         // an Opaque tparam arg: resolve via g.su
                                let gsl: i32 = su_slot(src, g, gad.x as usize, gad.y as usize)
                                if gsl >= 0 {
                                    push_targ_mangle(sb, src, c, list.get(i32, g.su, (gsl + 2) as usize), list.get(i32, g.su, (gsl + 3) as usize), list.get(i32, g.su, (gsl + 4) as usize))
                                    gdone = true
                                }
                            }
                            if !gdone { push_ty_mangle(sb, src, c, garg) }
                            gi2 = gi2 + 1
                        }
                        string_push(sb, "_")
                        string_push(sb, src[callee.x as usize .. callee.y as usize])
                        string_push(sb, "(")
                        let gsconv: i32 = method_self_conv(p, mfit)
                        if gsconv == 2 or gsconv == 4 {
                            emit_addr_arg(sb, p, src, c, g, callee.a)
                        } else {
                            emit_expr(sb, p, src, c, g, callee.a)
                        }
                        let gfd: parser.ItemData = list.get(parser.ItemData, p.it, mfit as usize)
                        var gai: i32 = 0
                        for gai < e.y {
                            string_push(sb, ", ")
                            var gbyref: bool = false
                            if gai + 1 < gfd.b {
                                let gpconv: i32 = list.get(i32, p.iar, (gfd.a + (gai + 1) * 7 + 1) as usize)
                                if gpconv == 2 or gpconv == 4 { gbyref = true }
                            }
                            if gbyref {
                                emit_addr_arg(sb, p, src, c, g, arg_at(p, e, gai))
                            } else {
                                emit_expr(sb, p, src, c, g, arg_at(p, e, gai))
                            }
                            gai = gai + 1
                        }
                        string_push(sb, ")")
                        return
                    }
                }
            }
        }
        // An impl-dispatched call (recorded in the Checker's `icalls` 5-tuples): a DIRECT,
        // statically-dispatched call of `jestyr_impl_<Trait>__<TypeKey>__<method>`, the key
        // from the receiver's concrete Checker type. Mirrors the `impl_calls` arm.
        var ib: i32 = 0 - 1
        var ii: usize = 0
        for ii < list.len(i32, c.icalls) {
            if list.get(i32, c.icalls, ii) == eid { ib = ii as i32 }
            ii = ii + 5
        }
        if ib >= 0 {
            var key: String = string_new()
            push_key_of_tyid(key, src, c, list.get(i32, c.et, callee.a as usize))
            emit_impl_dispatch(sb, p, src, c, g, e, callee, list.get(i32, c.icalls, (ib + 1) as usize), list.get(i32, c.icalls, (ib + 2) as usize), string_view(key))
            string_free(key)
            return
        }
        // A bound-dispatched call inside a bracket-generic body (the Checker's `bcalls`): the
        // concrete receiver is the type param's binding in the CURRENT monomorphization — the
        // active substitution — dispatching to `impl <bound> for <that type>` (mirrors the
        // `bound_method_calls` arm).
        var bb: i32 = 0 - 1
        var bi: usize = 0
        for bi < list.len(i32, c.bcalls) {
            if list.get(i32, c.bcalls, bi) == eid { bb = bi as i32 }
            bi = bi + 5
        }
        if bb >= 0 {
            let pns: i32 = list.get(i32, c.bcalls, (bb + 3) as usize)
            let pne: i32 = list.get(i32, c.bcalls, (bb + 4) as usize)
            var key: String = string_new()
            var si: usize = 0
            for si < list.len(i32, g.su) {             // the tparam's binding in g.su
                let sns: i32 = list.get(i32, g.su, si)
                let sne: i32 = list.get(i32, g.su, si + 1)
                if str_eq(src[pns as usize .. pne as usize], src[sns as usize .. sne as usize]) {
                    let akind: i32 = list.get(i32, g.su, si + 2)
                    let aa: i32 = list.get(i32, g.su, si + 3)
                    let ab2: i32 = list.get(i32, g.su, si + 4)
                    if akind == 0 { string_push(key, src[aa as usize .. ab2 as usize]) }
                    else if akind == 1 { push_key_of_tyid(key, src, c, aa) }
                }
                si = si + 5
            }
            emit_impl_dispatch(sb, p, src, c, g, e, callee, list.get(i32, c.bcalls, (bb + 1) as usize), list.get(i32, c.bcalls, (bb + 2) as usize), string_view(key))
            string_free(key)
            return
        }
        // `d.m(args)` on a `dyn Trait` receiver (the Checker's `dcalls` records): a DYNAMIC
        // call through the vtable slot — `d.vtable->m(d.data, args)`. The receiver emits
        // ONCE into a buffer, reused for both `.vtable` and `.data`.
        var dcb: i32 = 0 - 1
        var dqi: usize = 0
        for dqi < list.len(i32, c.dcalls) {
            if list.get(i32, c.dcalls, dqi) == eid { dcb = dqi as i32 }
            dqi = dqi + 3
        }
        if dcb >= 0 {
            var recv: String = string_new()
            emit_expr(recv, p, src, c, g, callee.a)
            string_push(sb, string_view(recv))
            string_push(sb, ".vtable->")
            let dms: i32 = list.get(i32, c.dcalls, (dcb + 1) as usize)
            let dme: i32 = list.get(i32, c.dcalls, (dcb + 2) as usize)
            string_push(sb, src[dms as usize .. dme as usize])
            string_push(sb, "(")
            string_push(sb, string_view(recv))
            string_push(sb, ".data")
            var dai: i32 = 0
            for dai < e.y {
                string_push(sb, ", ")
                emit_expr(sb, p, src, c, g, arg_at(p, e, dai))
                dai = dai + 1
            }
            string_push(sb, ")")
            string_free(recv)
            return
        }
    }
    // Invoking a *thin fn-pointer* VALUE — a local/param/field whose CHECKER type is `fn(…)`
    // (the "disambiguate by field type" rule: `a.alloc_fn(x)` is a pointer call because the
    // field's type says so). Indirect: no `jestyr_` mangling; `mut`/`out` params of the fn
    // TYPE take their args by address. Mirrors `emit_fn_ptr_invoke`.
    let ctid: i32 = list.get(i32, c.et, e.a as usize)
    if ctid >= 0 {
        let ctd: typeck.TyData = list.get(typeck.TyData, c.tys, ctid as usize)
        // Invoking a CLOSURE value (Opaque("closure"), kind 18/x=0): `f.call(&f.env, args)` for
        // a named value; an inline immediately-invoked closure spills once so its env is built
        // exactly once (ONE temp). Args buffer FIRST — the reference emits them before the
        // callee, so any temps they consume number first. Mirrors `emit_closure_invoke`.
        if ctd.kind == 18 and ctd.x == 0 {
            var argv: String = string_new()
            var ai: i32 = 0
            for ai < e.y {
                string_push(argv, ", ")
                emit_expr(argv, p, src, c, g, arg_at(p, e, ai))
                ai = ai + 1
            }
            if callee.kind == 2 {
                var cs: String = string_new()
                emit_expr(cs, p, src, c, g, e.a)
                string_push(sb, string_view(cs))
                string_push(sb, ".call(&")
                string_push(sb, string_view(cs))
                string_push(sb, ".env")
                string_push(sb, string_view(argv))
                string_push(sb, ")")
                string_free(cs)
            } else {
                var lit: String = string_new()
                emit_expr(lit, p, src, c, g, e.a)
                let t: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ JestyrClosure_")
                push_uint(sb, ref_expr_id(p, e.a) as i64)
                string_push(sb, " _f")
                push_uint(sb, t as i64)
                string_push(sb, " = ")
                string_push(sb, string_view(lit))
                string_push(sb, "; _f")
                push_uint(sb, t as i64)
                string_push(sb, ".call(&_f")
                push_uint(sb, t as i64)
                string_push(sb, ".env")
                string_push(sb, string_view(argv))
                string_push(sb, "); })")
                string_free(lit)
            }
            string_free(argv)
            return
        }
        if ctd.kind == 12 {
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "(")
            var ai: i32 = 0
            for ai < e.y {
                if ai > 0 { string_push(sb, ", ") }
                var byref: bool = false
                if ai < ctd.b {
                    let pconv: i32 = list.get(i32, c.tya, (ctd.a + ai * 2) as usize)
                    if pconv == 2 or pconv == 4 { byref = true }
                }
                if byref {
                    emit_addr_arg(sb, p, src, c, g, arg_at(p, e, ai))
                } else {
                    emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
                }
                ai = ai + 1
            }
            string_push(sb, ")")
            return
        }
    }
    if callee.kind == 21 {                            // `@address(0x…)` — a fixed-address pointer (MMIO)
        if str_eq(src[callee.x as usize .. callee.y as usize], "address") {
            string_push(sb, "((void*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "))")
            return
        }
    }
    if callee.kind == 2 {
        let nm: str = src[callee.start .. callee.end]
        // A payload-bearing variant construction `circle(2.0)` -> the tagged-union struct literal.
        let venum: i32 = find_variant_enum(p, src, callee.start, callee.end)
        if venum >= 0 {
            let own: i32 = list.get(i32, c.et, eid as usize)
            // niche: `some(p)` IS the pointer — the value emits bare
            if niche_of_tyid(p, src, c, own) >= 0 {
                emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
                return
            }
            if genum_item_of_su(p, src, c, g, own) >= 0 {   // a generic-enum instance value
                emit_gvariant_head(sb, p, src, c, g, own, nm)
            } else {
                emit_variant_head(sb, p, src, venum, nm)
            }
            string_push(sb, ", .u.")
            string_push(sb, nm)
            string_push(sb, " = { ")
            var vi: i32 = 0
            for vi < e.y {
                if vi > 0 { string_push(sb, ", ") }
                emit_expr(sb, p, src, c, g, arg_at(p, e, vi))
                vi = vi + 1
            }
            string_push(sb, " } }")
            return
        }
        // The `__atomic_*` builtins (no <stdatomic.h>, no special type): pointer + value cast
        // to int64_t, SEQ_CST. Mirrors the atomic_store/load/add/sub/xchg arms.
        if str_eq(nm, "atomic_store") or str_eq(nm, "atomic_add") or str_eq(nm, "atomic_sub") or str_eq(nm, "atomic_xchg") {
            if str_eq(nm, "atomic_store") { string_push(sb, "__atomic_store_n((int64_t*)(") }
            else if str_eq(nm, "atomic_add") { string_push(sb, "__atomic_fetch_add((int64_t*)(") }
            else if str_eq(nm, "atomic_sub") { string_push(sb, "__atomic_fetch_sub((int64_t*)(") }
            else { string_push(sb, "__atomic_exchange_n((int64_t*)(") }
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "), (int64_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "), __ATOMIC_SEQ_CST)")
            return
        }
        if str_eq(nm, "atomic_load") {
            string_push(sb, "__atomic_load_n((int64_t*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "), __ATOMIC_SEQ_CST)")
            return
        }
        if str_eq(nm, "size_of") {                    // size_of(T) -> sizeof(<cty>)
            string_push(sb, "sizeof(")
            let a0: i32 = list.get(i32, p.ar, e.x as usize)
            let arg: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
            if arg.kind == 2 {                        // the type argument is a bare Name
                let sl: i32 = su_slot(src, g, arg.start, arg.end)
                if sl >= 0 {                          // a tparam under the active substitution
                    emit_targ_cty(sb, p, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
                    string_push(sb, ")")
                    return
                }
                let tn: str = src[arg.start .. arg.end]
                let pc: str = c_prim(tn)
                if !str_eq(pc, "") { string_push(sb, pc) }
                else {
                    // a niche enum's size IS its pointer payload's
                    let nvb: i32 = niche_named_some(p, find_enum_item(p, src, arg.start, arg.end))
                    if nvb >= 0 {
                        emit_c_ty(sb, p, src, list.get(i32, p.ear, (list.get(i32, p.ear, (nvb + 2) as usize) + 2) as usize))
                    } else {
                        string_push(sb, "Jestyr_")
                        string_push(sb, tn)
                    }
                }
            }
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "align_of") {                   // align_of(T) -> _Alignof(<cty>)
            string_push(sb, "_Alignof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "offset_of") {                  // offset_of(T, f) -> offsetof(<cty>, j_<f>)
            string_push(sb, "offsetof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ", j_")
            let fa: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 1) as usize)
            string_push(sb, src[fa.start .. fa.end])
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "alloc") {                      // alloc(T, n) -> ((T*) malloc((size_t)(n) * sizeof(T)))
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "*) malloc((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")))")
            return
        }
        if str_eq(nm, "realloc") {                    // realloc(T, p, n)
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "*) realloc(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")))")
            return
        }
        // The bytes<->str boundary: `is_utf8` checks, `from_utf8` asserts then views. Both spill
        // the byte slice into `_u` (a FIXED name — neither consumes the temp counter).
        if str_eq(nm, "is_utf8") or str_eq(nm, "from_utf8") {
            string_push(sb, "({ ")
            emit_ty_c(sb, p, src, c, list.get(i32, c.et, arg_at(p, e, 0) as usize))
            string_push(sb, " _u = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            if str_eq(nm, "is_utf8") {
                string_push(sb, "; jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len); })")
            } else {
                string_push(sb, "; assert(jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len)); (JestyrStr){ (const char*)_u.ptr, _u.len }; })")
            }
            return
        }
        if str_eq(nm, "bytes") {                      // str -> []u8 view (consumes a temp)
            let nb: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrStr _bv")
            push_uint(sb, nb as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrSlice_u8){ (uint8_t*)_bv")
            push_uint(sb, nb as i64)
            string_push(sb, ".ptr, _bv")
            push_uint(sb, nb as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "count_codepoints") {           // O(n) codepoint count
            string_push(sb, "jestyr_rt_count_cp(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "string_new") { string_push(sb, "jestyr_rt_str_new()")  return }
        if str_eq(nm, "builder_new") { string_push(sb, "jestyr_rt_b_new()")  return }
        if str_eq(nm, "os_from_bytes") {              // reinterpret a byte slice as an os_str view
            string_push(sb, "({ __typeof__(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") _ob = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrStr){ (const char*)_ob.ptr, _ob.len }; })")
            return
        }
        let bref: str = intrinsic_helper_byref(nm)    // `<helper>(&<a0>[, rest])`
        if !str_eq(bref, "") {
            string_push(sb, bref)
            string_push(sb, "(&")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            var bi: i32 = 1
            for bi < e.y {
                string_push(sb, ", ")
                emit_expr(sb, p, src, c, g, arg_at(p, e, bi))
                bi = bi + 1
            }
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "alloc_i32") {                  // ((int32_t*) malloc((size_t)(<n>) * sizeof(int32_t)))
            string_push(sb, "((int32_t*) malloc((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") * sizeof(int32_t)))")
            return
        }
        if str_eq(nm, "free_ptr") {                   // free(<p>)
            string_push(sb, "free(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "realloc_i32") {                // ((int32_t*) realloc(<p>, (size_t)(<n>) * sizeof(int32_t)))
            string_push(sb, "((int32_t*) realloc(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ") * sizeof(int32_t)))")
            return
        }
        if str_eq(nm, "bytes") {                      // str -> []u8 view: ({ JestyrStr _bv{n} = s; (JestyrSlice_u8){ … }; })
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrStr _bv")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrSlice_u8){ (uint8_t*)_bv")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _bv")
            push_uint(sb, n as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "try_from_utf8") {              // validate-at-boundary: []u8 -> str !Utf8Error
            let a0: i32 = arg_at(p, e, 0)
            string_push(sb, "({ ")
            emit_ty_c(sb, p, src, c, list.get(i32, c.et, a0 as usize))
            string_push(sb, " _u = ")
            emit_expr(sb, p, src, c, g, a0)
            string_push(sb, "; jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len) ? (JestyrResult_str){ .is_err = false, .ok = (JestyrStr){ (const char*)_u.ptr, _u.len } } : (JestyrResult_str){ .is_err = true, .err = ")
            push_uint(sb, intrinsic_tag(g, src, "Utf8Error") as i64)
            if err_pay_gated(c) { string_push(sb, ", .pay = {0}") }
            string_push(sb, " }; })")
            return
        }
        if str_eq(nm, "try_read_file") {              // B3 recoverable read: FIXED temps _s/_ok (no counter)
            string_push(sb, "({ JestyrString _s; bool _ok = jestyr_rt_try_read_file(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ", &_s); _ok ? (JestyrResult_String){ .is_err = false, .ok = _s } : (JestyrResult_String){ .is_err = true, .err = ")
            push_uint(sb, intrinsic_tag(g, src, "IoError") as i64)
            if err_pay_gated(c) { string_push(sb, ", .pay = {0}") }
            string_push(sb, " }; })")
            return
        }
        if str_eq(nm, "arg_count") {                  // arg_count() -> the argv-count runtime global
            string_push(sb, "jestyr_rt_arg_count()")
            return
        }
        if str_eq(nm, "arg") {                        // arg(i) -> jestyr_rt_arg((int64_t)(<i>))
            string_push(sb, "jestyr_rt_arg((int64_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "))")
            return
        }
        if str_eq(nm, "region_alloc") {               // region_alloc(r, T, v): bump-alloc + init, plain ptr. ONE temp.
            // the VALUE emits first (its own temps number before this one --
            // reference order; latent until a nested region_alloc existed)
            var vbuf0: String = string_new()
            emit_expr(vbuf0, p, src, c, g, arg_at(p, e, 2))
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ ")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", sizeof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ")); *_p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            string_push(sb, string_view(vbuf0))
            string_free(vbuf0)
            string_push(sb, "); _p")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        if str_eq(nm, "region_str") {                 // region_str(r, s): copy a str into the arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ JestyrStr _sv")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "; char* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (char*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len); (JestyrStr){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "region_concat") {              // region_concat(r, a, b): join two strs in the arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ JestyrStr _a")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "; JestyrStr _b")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, "; size_t _t")
            push_uint(sb, n as i64)
            string_push(sb, " = _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len + _b")
            push_uint(sb, n as i64)
            string_push(sb, ".len; char* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (char*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", _t")
            push_uint(sb, n as i64)
            string_push(sb, "); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, ", _a")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, " + _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len, _b")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _b")
            push_uint(sb, n as i64)
            string_push(sb, ".len); (JestyrStr){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", _t")
            push_uint(sb, n as i64)
            string_push(sb, " }; })")
            return
        }
        if str_eq(nm, "arena_open") {                 // arena_open(cap): heap arena, opaque handle. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrArena* _a")
            push_uint(sb, n as i64)
            string_push(sb, " = (JestyrArena*)malloc(sizeof(JestyrArena)); *_a")
            push_uint(sb, n as i64)
            string_push(sb, " = jestyr_arena_new((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")); (uint8_t*)_a")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        if str_eq(nm, "arena_alloc") {                // arena_alloc(h, T, n): bump n T's. NO temp.
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "*) jestyr_arena_alloc((JestyrArena*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "), (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ")))")
            return
        }
        if str_eq(nm, "arena_close") {                // arena_close(h): free the whole arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrArena* _a")
            push_uint(sb, n as i64)
            string_push(sb, " = (JestyrArena*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "); jestyr_arena_free(_a")
            push_uint(sb, n as i64)
            string_push(sb, "); free(_a")
            push_uint(sb, n as i64)
            string_push(sb, "); })")
            return
        }
        if str_eq(nm, "gen_new") {                    // gen_new(T, v): allocate [gen | T], init, {ptr, gen}. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let ty0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ void* _b")
            push_uint(sb, n as i64)
            string_push(sb, " = malloc(8 + sizeof(")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")); *(uint64_t*)_b")
            push_uint(sb, n as i64)
            string_push(sb, " = 1; ")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_type_arg_cty(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "*)((char*)_b")
            push_uint(sb, n as i64)
            string_push(sb, " + 8); *_p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "); (JestyrRef_")
            string_push(sb, src[ty0.start .. ty0.end])   // elem type name = its own mangle
            string_push(sb, "){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", 1 }; })")
            return
        }
        if str_eq(nm, "gen_free") {                   // gen_free(r): bump the generation. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            emit_ty_c(sb, p, src, c, list.get(i32, c.et, arg_at(p, e, 0) as usize))
            string_push(sb, " _r")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "); ((uint64_t*)_r")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr)[-1]++; })")
            return
        }
        if str_eq(nm, "slice") {                      // slice(T, ptr, n) -> (JestyrSlice_<T>){ ptr, (size_t)(n) }
            let ty0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "(JestyrSlice_")
            string_push(sb, src[ty0.start .. ty0.end])   // elem type name = its own mangle (prim/named)
            string_push(sb, "){ ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") }")
            return
        }
        if str_eq(nm, "ok") {                         // ok(v) -> (<cur_result>){ .is_err = false, .ok = (v) }
            if g.res_ok == 0 - 2 {                    // outside a fallible fn (an IMPORTED generic
                emit_expr(sb, p, src, c, g, arg_at(p, e, 0))   // Result's ctor): the diag arm's bare arg
                return
            }
            string_push(sb, "(")
            emit_result_name(sb, p, src, c, g, g.res_ok)
            string_push(sb, "){ .is_err = false, .ok = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") }")
            return
        }
        if str_eq(nm, "err") {                        // err(E) -> (<cur_result>){ .is_err = true, .err = <tag> }
            if g.res_ok == 0 - 2 {                    // outside a fallible fn: the diag arm's `0`
                string_push(sb, "0")
                return
            }
            string_push(sb, "(")
            emit_result_name(sb, p, src, c, g, g.res_ok)
            string_push(sb, "){ .is_err = true, .err = ")
            let en: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            // The applied payload form `err(Name(v))` digs the CALLEE for the
            // tag (E5, mirrors the reference's error_tag_of Call arm); in a
            // gated program the construction carries `.pay` -- the declared
            // member for a payload carrier, an explicit `{0}` otherwise.
            var tns: usize = en.start
            var tne: usize = en.end
            var payex: i32 = 0 - 1
            if en.kind == 10 {
                let ecal: parser.ExprData = list.get(parser.ExprData, p.ex, en.a as usize)
                if ecal.kind == 2 {
                    tns = ecal.start
                    tne = ecal.end
                    if en.y > 0 { payex = list.get(i32, p.ar, en.x as usize) }
                }
            }
            push_uint(sb, error_tag_of(g, src, tns, tne) as i64)
            if err_pay_gated(c) {
                var isp: bool = false
                if payex >= 0 {
                    if typeck.err_payload_of(c, src, tns as i32, tne as i32) >= 0 { isp = true }
                }
                if isp {
                    string_push(sb, ", .pay = { .j_")
                    string_push(sb, src[tns .. tne])
                    string_push(sb, " = (")
                    emit_expr(sb, p, src, c, g, payex)
                    string_push(sb, ") }")
                } else {
                    string_push(sb, ", .pay = {0}")
                }
            }
            string_push(sb, " }")
            return
        }
        if str_eq(nm, "unwrap") {                     // unwrap(e) -> ((e).ok)
            string_push(sb, "((")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ").ok)")
            return
        }
        if str_eq(nm, "is_err") {                     // is_err(e) -> ((e).is_err)
            string_push(sb, "((")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ").is_err)")
            return
        }
        let helper: str = intrinsic_helper(nm)
        if !str_eq(helper, "") {
            string_push(sb, helper)
            emit_arg_list(sb, p, src, c, g, e)
            return
        }
        // An `extern "c"` callee is invoked by its BARE name (resolved by the linker);
        // `mut`/`out` params still take the argument by address.
        let xit: i32 = find_extern_item(p, src, nm)
        if xit >= 0 {
            // The C SYMBOL, which under a declared alias is not the Jestyr name: `(g,h)`
            // holds `= "read"` and `nm` is `sys_read`. The Jestyr name exists only so the
            // source can NAME a symbol whose spelling Jestyr spent on its own grammar.
            let xd: parser.ItemData = list.get(parser.ItemData, p.it, xit as usize)
            if xd.cns < 0 { string_push(sb, nm) } else { string_push(sb, src[xd.cns as usize .. xd.cne as usize]) }
            emit_args_for_item(sb, p, src, c, g, e, xit)
            return
        }
        // Plain user function: mangle to `jestyr_<name>`. A `mut`/`out` parameter takes the
        // argument by address (`&(arg)`), so look up the callee's param conventions.
        // A call to a generic template monomorphizes: `jestyr_<name>__<mangles>` with the
        // comptime type args erased (mirrors `emit_generic_call`).
        let ufit: i32 = find_fn_item(p, src, nm)
        var bare: bool = false
        if ufit >= 0 {
            let uf: parser.ItemData = list.get(parser.ItemData, p.it, ufit as usize)
            if fn_is_gen(p, uf) {
                emit_generic_call(sb, p, src, c, g, e, ufit)
                return
            }
            if item_has_attr(p, src, uf, "no_mangle") { bare = true }   // `@no_mangle` target
        }
        if !bare { string_push(sb, "jestyr_") }
        string_push(sb, nm)
        emit_user_args(sb, p, src, c, g, e, nm)
        return
    }
    // Default: any other callee form emits plainly — callee expr, then plain args. (The
    // single-file golden's DEGENERATE module-qualified call `env.argc()` -> `j_env.j_argc()`
    // lands here, matching the reference's final fallback byte-for-byte.)
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, "(")
    var di: i32 = 0
    for di < e.y {
        if di > 0 { string_push(sb, ", ") }
        emit_expr(sb, p, src, c, g, arg_at(p, e, di))
        di = di + 1
    }
    string_push(sb, ")")
}

// One C prototype per `extern "c"` declaration (bare name, linker-resolved), + a blank iff any.
// Params render `<cty>[*] j_<name>` with NO `restrict` (a foreign fn makes no aliasing promise).
fn emit_extern_protos(mut sb: String, read p: parser.Parser, read src: str) {
    var any: bool = false
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        // A HEADER-declared extern (`extern "stdio.h" fn …`) gets NO prototype: C
        // requires a redeclaration to be compatible, and Jestyr cannot reproduce most
        // libc signatures exactly (`int32_t fclose(void*)` vs `int fclose(FILE*)`).
        // The abi's INNER span is `(w,u)`, -1 when absent (the default "c").
        //
        // The `kind == 8` test has to come FIRST. `(w,u)` only means "abi span" on an
        // extern; on a Fn they are the body ExprId and the attribute slice, so testing
        // them on every root item read two arbitrary source bytes — silently harmless
        // while they never spelled `.h`, and an out-of-bounds/non-boundary slice the
        // moment an offset landed inside a multibyte character.
        if it.kind == 8 {
            var hdr: bool = false
            if it.w >= 0 {
                if it.u - it.w >= 2 {
                    if str_eq(src[(it.u - 2) as usize .. it.u as usize], ".h") { hdr = true }
                }
            }
            if !hdr {
                any = true
                // The prototype declares the C SYMBOL. Under a declared alias the Jestyr
                // name never reaches the emitted C at all — and the specificity rule keys
                // on the symbol too, since that is the identity the linker sees.
                var xns: i32 = it.x  var xne: i32 = it.y
                if it.cns >= 0 { xns = it.cns  xne = it.cne }
                let eg: bool = cfg_open_for(sb, p, src, xns, xne, cfg_word(p, src, it.xat, it.xac))
                emit_c_ty(sb, p, src, it.z)               // ret type (-1 = void)
                string_push(sb, " ")
                string_push(sb, src[xns as usize .. xne as usize])
                string_push(sb, "(")
                var emitted: i32 = 0
                var i: i32 = 0
                for i < it.b {
                    let base: i32 = it.a + i * 7
                    if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
                        if emitted > 0 { string_push(sb, ", ") }
                        let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
                        emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                        if conv == 2 or conv == 4 { string_push(sb, "*") }
                        string_push(sb, " j_")
                        string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
                        emitted = emitted + 1
                    }
                    i = i + 1
                }
                if emitted == 0 { string_push(sb, "void") }
                string_push(sb, ");\n")
                cfg_close(sb, eg)
            }
        }
        r = r + 1
    }
    if any { string_push(sb, "\n") }
}

// The item id of an `extern "c"` fn named `src[ns..ne]`… by name, or -1.
fn find_extern_item(read p: parser.Parser, read src: str, read nm: str) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 8 {
            if str_eq(src[it.x .. it.y], nm) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// The `(args)` list for a call whose callee item id is known (mut/out params by `&()`).
fn emit_args_for_item(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, fit: i32) {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {
        if i > 0 { string_push(sb, ", ") }
        var byref: bool = false
        if i < it.b {
            let conv: i32 = list.get(i32, p.iar, (it.a + i * 7 + 1) as usize)
            if conv == 2 or conv == 4 { byref = true }
        }
        if byref {
            emit_addr_arg(sb, p, src, c, g, arg_at(p, e, i))
        } else {
            emit_expr(sb, p, src, c, g, arg_at(p, e, i))
        }
        i = i + 1
    }
    string_push(sb, ")")
}

// The `ExprId` of a Call node's `i`th argument (`(x,y)` = arg slice into `ar`).
fn arg_at(read p: parser.Parser, read e: parser.ExprData, i: i32) -> i32 {
    return list.get(i32, p.ar, (e.x + i) as usize)
}

// A bare-Name *type argument* (`size_of(T)`-style) rendered as its C type.
// The substitution-free form, for section-level collection sites that carry no `Cg`.
fn emit_type_arg_cty_plain(mut sb: String, read p: parser.Parser, read src: str, aid: i32) {
    let arg: parser.ExprData = list.get(parser.ExprData, p.ex, aid as usize)
    if arg.kind == 2 {
        let tn: str = src[arg.start .. arg.end]
        let pc: str = c_prim(tn)
        if !str_eq(pc, "") { string_push(sb, pc) }
        else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
    }
}

fn emit_type_arg_cty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, aid: i32) {
    let arg: parser.ExprData = list.get(parser.ExprData, p.ex, aid as usize)
    if arg.kind == 2 {
        let sl: i32 = su_slot(src, g, arg.start, arg.end)
        if sl >= 0 {                                  // a tparam under the active substitution
            emit_targ_cty(sb, p, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
            return
        }
        let tn: str = src[arg.start .. arg.end]
        let pc: str = c_prim(tn)
        if !str_eq(pc, "") { string_push(sb, pc) }
        else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
    }
}

// Emit a user call's `(arg0, arg1, …)` list, taking each `mut`/`out` parameter by address. The
// callee's param conventions come from its Fn item (found by name); an unknown callee (or a
// variadic mismatch) falls back to by-value, which is correct for all-default signatures.
fn emit_user_args(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read nm: str) {
    let fit: i32 = find_fn_item(p, src, nm)
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {
        if i > 0 { string_push(sb, ", ") }
        var byref: bool = false
        if fit >= 0 {
            let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
            if i < it.b {
                let conv: i32 = list.get(i32, p.iar, (it.a + i * 7 + 1) as usize)
                if conv == 2 or conv == 4 { byref = true }
            }
        }
        if byref {
            emit_addr_arg(sb, p, src, c, g, arg_at(p, e, i))
        } else {
            emit_expr(sb, p, src, c, g, arg_at(p, e, i))
        }
        i = i + 1
    }
    string_push(sb, ")")
}

// The item index of a top-level Fn named `nm`, or -1 if none.
fn find_fn_item(read p: parser.Parser, read src: str, read nm: str) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], nm) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// The `(a0, a1, …)` argument list of a Call node (`(x,y)` = arg slice into `ar`).
fn emit_arg_list(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData) {
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {                                     // y = arg_count
        if i > 0 { string_push(sb, ", ") }
        let aid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
        emit_expr(sb, p, src, c, g, aid)
        i = i + 1
    }
    string_push(sb, ")")
}

// ---- statements / body (mirrors Cgen::emit_body / emit_stmt / emit_return / emit_if) ----
fn indent(mut sb: String, depth: i32) {
    var i: i32 = 0
    for i < depth { string_push(sb, "    ")  i = i + 1 }
}

// A whole `<indent>text\n` line at `depth`.
fn line_at(mut sb: String, depth: i32, read text: str) {
    indent(sb, depth)
    string_push(sb, text)
    string_push(sb, "\n")
}

// Mutable per-program emitter state (mirrors the reference's `Cgen` fields as they're needed).
// `tmp` is the shared unique-temporary counter (`_hi{n}` loop bounds, `_s{n}` slice spills, …) —
// global across the program, never reset per fn, exactly like the reference. `pp` holds the
// current fn's by-pointer (`mut`/`out`) parameter name spans as (ns, ne) pairs — uses render
// `(*j_<name>)`; a `for mut x in xs` binding joins temporarily. `rf` is the refinement stack:
// (ns, ne, range `ExprId`) triples for each enclosing exclusive `for i in 0..s.len` loop, so a
// provably-in-range `s[i]` elides its bounds check (mirrors `cur_refines`/`index_in_range`).
// `mv` holds the current fn's *moved-out* local-name spans (ns,ne pairs — the reference's
// `cur_moved`; free fns AND method/impl bodies all collect it, like the reference). `tkd` is the
// pending take-param drop list (`cur_take_drops`): pre-filtered 4-int `ds`-format entries armed
// per fn, drained ONCE by `emit_body` into the root drop scope. `ds` is the
// flattened drop-scope stack: 4-int entries (local ns, ne, type-name ns, ne) of live droppable
// locals; `dsb` holds each open scope's start offset into `ds`. `autoret` marks a method/impl body
// (the reference's empty `cur_ret_cty`) so a spilled return uses `__auto_type`.
// `bl_*` is the innermost loop-with-`else` break label a plain `break` must `goto` (the
// reference's `break_label`): a user label span (`bl_ns`,`bl_ne`) or a synthesized `_fe<bl_fe>`;
// all -1 when the nearest loop has no `else` (plain C `break` is right). `cl_*` is an armed
// labeled-loop continue-target span (the reference's `cont_label`), consumed — `.take()` — by
// the FIRST loop body that closes after arming.
// `sw` is true while emitting the arms of a switch-lowered `match` (the reference's
// `in_switch`, saved/reset per loop): a plain `break` there must `goto` the loop's `__break`
// label — a bare C `break` would exit the `switch`, not the loop. `ll_*` is the innermost
// loop's USER label span (the reference's `loop_label`; -1 when unlabeled) and `swb` the
// `_sb<swb>` label synthesized ON FIRST USE for an unlabeled, `else`-less loop (-1 until
// then, so loops without the construct emit byte-identical C).
// `sr_*` is a region-scoped loop's armed scratch-arena name span (the reference's
// `scratch_reset`), consumed — `.take()` — at the top of the next loop body. `vt` holds the
// current loop's hoisted `variant`-tracker (ExprId, temp) pairs with `vtf` the active loop's
// floor (the reference REPLACES `variant_trackers` per loop; the floor models that on a flat
// list, and inner loops save/restore both).
// `gfi` holds the collected generic-fn instance records ([fn item, argc, (kind,a,b) targ
// triples…], variable length — walk with a cursor); `su` is the ACTIVE instance's
// type-parameter substitution (5-tuples: tparam span + arg triple), read by `emit_su_ty`.
struct Cg { sds: List(i32), pfs: List(i32), pfb: String, pfo: List(i32), tmp: i32, pp: List(i32), rf: List(i32), res_ok: i32, etags: List(i32), req: List(i32), ens: List(i32), retty: i32, mi: List(i32), self_ptr: bool, gei: List(i32), curfn: i32, mv: List(i32), tkd: List(i32), ds: List(i32), dsb: List(i32), autoret: bool, bl_ns: i32, bl_ne: i32, bl_fe: i32, sw: bool, ll_ns: i32, ll_ne: i32, swb: i32, cl_ns: i32, cl_ne: i32, sr_ns: i32, sr_ne: i32, vt: List(i32), vtf: i32, gfi: List(i32), su: List(i32), cls: List(i32), ccx: List(i32), cca: List(i32), caps: List(i32), gsi: List(i32), sps: List(i32), dspawn: bool, th: List(i32), thf: i32, dg: i32, gmi: List(i32), tmode: bool, alloc: Allocator, dmap: List(i32), dmods: List(i32), dnb: String, dall: String, dnl: List(i32), dbg_on: bool, dbgl_m: i32, dbgl_l: i32 }

// The integer tag of an error name `src[ns..ne]` in the whole-program tag map (`etags` holds
// (start,end) src-span pairs, first-seen order across every fn's error set; tag = index + 1).
// Mirrors the reference's `error_tags` (built in `emit_program`). 0 = unknown.
fn error_tag_of(read g: Cg, read src: str, ns: usize, ne: usize) -> i32 {
    var i: usize = 0
    for i < list.len(i32, g.etags) {
        let es: i32 = list.get(i32, g.etags, i)
        let ee: i32 = list.get(i32, g.etags, i + 1)
        if str_eq(src[ns .. ne], src[es as usize .. ee as usize]) { return (i / 2 + 1) as i32 }
        i = i + 2
    }
    return 0
}

// Is Fn item `it` a monomorphization template — a bracket-form `[T: Bound]` generic (`it.h` > 0)
// or a `comptime T: type` parameter (comp==1, type = TypeKw)? Templates are never emitted
// directly (mirrors `is_generic_ast`). A comptime VALUE param also suppresses emission
// (`fn_supported_ast`'s other half) — both are "skip this fn" here.
fn fn_is_template(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.h > 0 { return true }                       // bracket generics
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 { // a comptime param (type OR value)
            return true
        }
        i = i + 1
    }
    return false
}

// Is the top-level Fn item `it` fallible (has a non-empty `!{…}` error set)? The `far` extras
// block at `it.e` starts with the error count.
fn fn_is_fallible(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.e < 0 { return false }
    return list.get(i32, p.far, it.e as usize) > 0
}

// Emit a fallible fn's C result type name `JestyrResult_<mangle(ok)>` (ok = `it.z`, -1 = unit).
// SUBST-AWARE: inside a monomorphized generic body a `-> T !{ E }` must name the
// INSTANCE's result (`JestyrResult_f64`), not the parameter's -- a Name ok-type is
// resolved through the armed `g.su` first, exactly as `emit_su_ty` resolves C types.
// With no subst armed the lookup misses and this is the original mangle, character
// for character, so every free-function site is unchanged.
fn emit_result_name(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, ok_ty: i32) {
    string_push(sb, "JestyrResult_")
    if ok_ty < 0 { string_push(sb, "unit")  return }
    push_su_result_mangle(sb, p, src, c, g, ok_ty)
}

// The ok-type mangle, subst-aware (shared by the result NAME and the typedef scan's
// dedup key, so the two cannot disagree on which instances share a typedef).
fn push_su_result_mangle(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, ok_ty: i32) {
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, ok_ty as usize)
    if t.kind == 0 {
        let sl: i32 = su_slot(src, g, t.start, t.end)
        if sl >= 0 {
            push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
            return
        }
    }
    push_ast_mangle(sb, p, src, ok_ty)
}

// The no-subst form, for sig emitters that have no Checker/Cg in scope (free fns --
// where a subst can never apply). Byte-identical to the original emitter.
fn emit_result_name_plain(mut sb: String, read p: parser.Parser, read src: str, ok_ty: i32) {
    string_push(sb, "JestyrResult_")
    if ok_ty < 0 { string_push(sb, "unit") } else { push_ast_mangle(sb, p, src, ok_ty) }
}

// Assign every error name (across all fns' `!{…}` sets, in item then declaration order) a distinct
// 1-based tag, recorded as (start,end) span pairs in `g.etags` (first-seen wins). Mirrors the
// reference's `error_tags` pass in `emit_program`.
fn build_error_tags(mut g: Cg, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and it.e >= 0 {
            let ecount: i32 = list.get(i32, p.far, it.e as usize)
            var k: i32 = 0
            for k < ecount {
                let ns: i32 = list.get(i32, p.far, (it.e + 1 + k * 3) as usize)
                let ne: i32 = list.get(i32, p.far, (it.e + 2 + k * 3) as usize)
                if error_tag_of(g, src, ns as usize, ne as usize) == 0 {
                    list.push(i32, g.etags, ns)
                    list.push(i32, g.etags, ne)
                }
                k = k + 1
            }
        }
        // Fallible STRUCT METHODS declare error sets too -- same whole-program map,
        // scanned after the item's own set so a method never renumbers a free fn's
        // tags (mirrors the reference's struct-member scan; trait impls stay out by
        // the fallible-impl refusal).
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mbase: i32 = it.a + m * 10
                if list.get(i32, p.mar, mbase as usize) == 1 {   // tag 1 = method
                    let mfd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mbase + 1) as usize) as usize)
                    if mfd.e >= 0 {
                        let mec: i32 = list.get(i32, p.far, mfd.e as usize)
                        var mk: i32 = 0
                        for mk < mec {
                            let mns: i32 = list.get(i32, p.far, (mfd.e + 1 + mk * 3) as usize)
                            let mne: i32 = list.get(i32, p.far, (mfd.e + 2 + mk * 3) as usize)
                            if error_tag_of(g, src, mns as usize, mne as usize) == 0 {
                                list.push(i32, g.etags, mns)
                                list.push(i32, g.etags, mne)
                            }
                            mk = mk + 1
                        }
                    }
                }
                m = m + 1
            }
        }
        // TRAIT declarations and their impls carry sets too (trait-errors T2) --
        // same whole-program map, same item order as the reference, so no
        // existing program's tags move (nothing in the old corpus declares
        // either).
        if it.kind == 6 {
            var ti: i32 = 0
            for ti < it.b {
                let tfe: i32 = list.get(i32, p.mar, (it.a + ti * 8 + 7) as usize)
                if tfe >= 0 {
                    let tfc: i32 = list.get(i32, p.far, tfe as usize)
                    var tfk: i32 = 0
                    for tfk < tfc {
                        let tfs: i32 = list.get(i32, p.far, (tfe + 1 + tfk * 3) as usize)
                        let tfn: i32 = list.get(i32, p.far, (tfe + 2 + tfk * 3) as usize)
                        if error_tag_of(g, src, tfs as usize, tfn as usize) == 0 {
                            list.push(i32, g.etags, tfs)
                            list.push(i32, g.etags, tfn)
                        }
                        tfk = tfk + 1
                    }
                }
                ti = ti + 1
            }
        }
        if it.kind == 7 {
            var ii: i32 = 0
            for ii < it.z {
                let ifd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + ii) as usize) as usize)
                if ifd.e >= 0 {
                    let ifc: i32 = list.get(i32, p.far, ifd.e as usize)
                    var ifk: i32 = 0
                    for ifk < ifc {
                        let ifs: i32 = list.get(i32, p.far, (ifd.e + 1 + ifk * 3) as usize)
                        let ifn: i32 = list.get(i32, p.far, (ifd.e + 2 + ifk * 3) as usize)
                        if error_tag_of(g, src, ifs as usize, ifn as usize) == 0 {
                            list.push(i32, g.etags, ifs)
                            list.push(i32, g.etags, ifn)
                        }
                        ifk = ifk + 1
                    }
                }
                ii = ii + 1
            }
        }
        r = r + 1
    }
}

// Is `src[ns..ne]` currently a by-pointer name (a `mut`/`out` param or a `for mut x` binding)?
fn is_ptr_name(read g: Cg, read src: str, ns: usize, ne: usize) -> bool {
    var i: usize = 0
    for i < list.len(i32, g.pp) {
        let pns: i32 = list.get(i32, g.pp, i)
        let pne: i32 = list.get(i32, g.pp, i + 1)
        if str_eq(src[ns .. ne], src[pns as usize .. pne as usize]) { return true }
        i = i + 2
    }
    return false
}

// ---- generic-FUNCTION monomorphization (mirrors collect_all_instances / mangle / make_subst /
// emit_generic_call — slice 1: free-fn instances found in NON-template bodies; walking instance
// bodies for nested generic calls, structural unification, and generic-struct methods are later
// increments) ----

// Is Fn item `it` a monomorphizable generic template — bracket `[T]` generics or a `comptime
// T: type` parameter? (A comptime VALUE param also suppresses direct emission — fn_is_template —
// but such a fn is never instantiated; mirrors the reference's `generics` set.)
fn fn_is_gen(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.h > 0 { return true }
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 { return true }        // `comptime T: type`
            }
        }
        i = i + 1
    }
    return false
}

// One instance type argument as a (kind, a, b) triple: kind 0 = an explicit bare-Name comptime
// type arg (a,b = its source span), kind 1 = an inferred Checker TyId (a), kind 2 = unresolved
// (mangles `x`, like the reference's Ty::Unknown).
fn push_targ_mangle(mut sb: String, read src: str, read c: typeck.Checker, kind: i32, a: i32, b: i32) {
    if kind == 0 { string_push(sb, src[a as usize .. b as usize])  return }
    if kind == 1 { push_ty_mangle(sb, src, c, a)  return }
    string_push(sb, "x")
}
fn emit_targ_cty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, kind: i32, a: i32, b: i32) {
    if kind == 0 {
        let tn: str = src[a as usize .. b as usize]
        let pc: str = c_prim(tn)
        if !str_eq(pc, "") { string_push(sb, pc) } else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
        return
    }
    if kind == 1 { emit_ty_c(sb, p, src, c, a)  return }
    string_push(sb, "int")
}

// Like `emit_c_ty`, but a bare Name matching the active type-parameter substitution (`g.su`
// 5-tuples: tparam span, then the arg triple) renders the instance's concrete C type. Used for
// instance SIGNATURES; template-body lets under subst are a later increment.
// The active-substitution slot index in `g.su` for tparam name `src[ns..ne]`, or -1.
fn su_slot(read src: str, read g: Cg, ns: usize, ne: usize) -> i32 {
    var i: usize = 0
    for i < list.len(i32, g.su) {
        let sns: i32 = list.get(i32, g.su, i)
        let sne: i32 = list.get(i32, g.su, i + 1)
        if str_eq(src[ns .. ne], src[sns as usize .. sne as usize]) { return i as i32 }
        i = i + 5
    }
    return 0 - 1
}

// The AST-type mangle under the ACTIVE substitution (a tparam Name mangles as its bound
// arg's mangle; everything else mirrors `push_ast_mangle`).
fn push_su_mangle(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tyid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {
        let sl: i32 = su_slot(src, g, t.start, t.end)
        if sl >= 0 {
            push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
            return
        }
        string_push(sb, src[t.start .. t.end])
        return
    }
    if t.kind == 2 { string_push(sb, "ptr_")  push_su_mangle(sb, p, src, c, g, t.a)  return }
    if t.kind == 3 { string_push(sb, "slice_")  push_su_mangle(sb, p, src, c, g, t.a)  return }
    if t.kind == 5 { string_push(sb, "ref_")  push_su_mangle(sb, p, src, c, g, t.a)  return }
    if t.kind == 9 {
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < t.a {
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, p.tar, (t.op + i * 2) as usize))
            push_su_mangle(sb, p, src, c, g, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, "_ret_")
        if t.x >= 0 { push_su_mangle(sb, p, src, c, g, t.x) } else { string_push(sb, "unit") }
        return
    }
    if t.kind == 4 {
        string_push(sb, "arr_")
        push_su_mangle(sb, p, src, c, g, t.a)
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)
        return
    }
    // An APPLICATION under substitution (`Option(U)` -> `Option__i32`). This mirrors
    // `emit_su_ty`'s kind-7 arm exactly, minus its `Jestyr_` prefix — that arm renders the C
    // TYPE NAME and this one the MANGLE, and the first is the second with the prefix.
    //
    // **Without it a generic-enum return inside a fn-pointer type mangled `?`**, because the
    // fallthrough below is substitution-blind: `opt_and_then`'s `f: fn(T) -> Option(U)`
    // became `JestyrFn_fn_di32_ret_?`, a name no typedef could ever define. It reached gcc
    // rather than the checker, which is the degrades-to-gcc mode this tree keeps finding.
    // `examples/std/combinators.jtr` is the corpus's instance; the reference spells the same
    // type `JestyrFn_fn_di32_ret_Option__i32`.
    if t.kind == 7 {
        string_push(sb, src[t.x as usize .. t.y as usize])
        string_push(sb, "__")
        var ai7: i32 = 0
        for ai7 < t.a {
            if ai7 > 0 { string_push(sb, "_") }
            push_su_mangle(sb, p, src, c, g, list.get(i32, p.tar, (t.op + ai7) as usize))
            ai7 = ai7 + 1
        }
        return
    }
    push_ast_mangle(sb, p, src, tyid)
}

// A CHECKER type's mangle under the ACTIVE substitution: an Opaque tparam mangles as its
// bound arg, everything else falls to `push_ty_mangle`. This is `emit_su_tyid`'s leaf rule
// in mangle form — factored out because the Array arm below needs the ELEMENT's substituted
// mangle to name `JestyrArr_<elem>_<N>`, and `push_ty_mangle` alone would render the opaque
// tparam (`JestyrArr_T_8`) rather than the instance's element type.
fn push_su_tymangle(mut sb: String, read src: str, read c: typeck.Checker, read g: Cg, tid: i32) {
    if tid >= 0 and list.len(i32, g.su) > 0 {
        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
        if d.kind == 4 {                              // Opaque tparam -> its bound arg
            let sl: i32 = su_slot(src, g, d.x as usize, d.y as usize)
            if sl >= 0 {
                push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
                return
            }
        }
    }
    push_ty_mangle(sb, src, c, tid)
}

fn emit_su_ty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tyid: i32) {
    if tyid >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
        if t.kind == 0 {
            let sl: i32 = su_slot(src, g, t.start, t.end)
            if sl >= 0 {
                emit_targ_cty(sb, p, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
                return
            }
        }
        if list.len(i32, g.su) > 0 {                  // structural forms substitute inward
            if t.kind == 2 or t.kind == 6 {
                emit_su_ty(sb, p, src, c, g, t.a)
                string_push(sb, "*")
                return
            }
            if t.kind == 7 {                          // App under subst: Jestyr_<ctor>__<su-mangles>
                string_push(sb, "Jestyr_")
                string_push(sb, src[t.x as usize .. t.y as usize])
                string_push(sb, "__")
                var i: i32 = 0
                for i < t.a {
                    if i > 0 { string_push(sb, "_") }
                    push_su_mangle(sb, p, src, c, g, list.get(i32, p.tar, (t.op + i) as usize))
                    i = i + 1
                }
                return
            }
            if t.kind == 9 {
                string_push(sb, "JestyrFn_")
                push_su_mangle(sb, p, src, c, g, tyid)
                return
            }
            if t.kind == 3 {
                string_push(sb, "JestyrSlice_")
                push_su_mangle(sb, p, src, c, g, t.a)
                return
            }
            if t.kind == 5 {
                string_push(sb, "JestyrRef_")
                push_su_mangle(sb, p, src, c, g, t.a)
                return
            }
            if t.kind == 4 {
                string_push(sb, "JestyrArr_")
                push_su_mangle(sb, p, src, c, g, t.a)
                string_push(sb, "_")
                push_array_len(sb, p, src, t.b)
                return
            }
        }
    }
    emit_c_ty(sb, p, src, tyid)
}

// A CHECKER type rendered under the active substitution: an Opaque tparam takes its bound
// arg; a kind-6 instance with Opaque args renders each through the substitution (the
// template-body `Vec(T){…}` type inside a monomorphized instance). Falls to `emit_ty_c`.
fn emit_su_tyid(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tid: i32) {
    if tid >= 0 and list.len(i32, g.su) > 0 {
        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
        if d.kind == 4 {                              // Opaque tparam
            let sl: i32 = su_slot(src, g, d.x as usize, d.y as usize)
            if sl >= 0 {
                emit_targ_cty(sb, p, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize))
                return
            }
        }
        if d.kind == 6 {
            string_push(sb, "Jestyr_")
            string_push(sb, src[d.x as usize .. d.y as usize])
            string_push(sb, "__")
            var i: i32 = 0
            for i < d.b {
                if i > 0 { string_push(sb, "_") }
                let arg: i32 = list.get(i32, c.tya, (d.a + i) as usize)
                let ad: typeck.TyData = list.get(typeck.TyData, c.tys, arg as usize)
                var done: bool = false
                if ad.kind == 4 {
                    let sl2: i32 = su_slot(src, g, ad.x as usize, ad.y as usize)
                    if sl2 >= 0 {
                        push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl2 + 2) as usize), list.get(i32, g.su, (sl2 + 3) as usize), list.get(i32, g.su, (sl2 + 4) as usize))
                        done = true
                    }
                }
                if !done { push_ty_mangle(sb, src, c, arg) }
                i = i + 1
            }
            return
        }
        if d.kind == 3 {                              // Ptr of an Opaque tparam
            emit_su_tyid(sb, p, src, c, g, d.a)
            string_push(sb, "*")
            return
        }
        if d.kind == 8 {                              // Slice `[]T` inside an instance body
            // The Array arm below was added for `JestyrArr_T_8` and this one was NOT, which
            // is the exact failure the note beside that fix warned about: **these renderers
            // have to be checked AS A SET, because a type form handled by one and not the
            // others is precisely this bug.** An `s[mid]` index inside
            // `core.sl_binary_search`'s monomorphized body emitted
            // `JestyrSlice_T _s124 = j_s;` and gcc refused the program `jestyrc` compiles.
            //
            // It fails LOUDLY where the array one failed silently, and the difference is
            // worth knowing: there is no `int` fallback for an undefined struct typedef, so
            // a wrong slice element is a compile error while a wrong array element was a
            // 32-bit truncation of every `i64`.
            string_push(sb, "JestyrSlice_")
            push_su_tymangle(sb, src, c, g, d.a)
            return
        }
        if d.kind == 9 {                              // Array `[N]T` inside an instance body
            // Without this arm a `[8]T` place inside `SmallVec(i64)`'s monomorphized body
            // fell to `emit_ty_c`, which renders the still-opaque element: the C read
            // `JestyrArr_T_8* _a = &v.buf` typed the field as `int a[8]`. That COMPILED —
            // `int` is a real type — and silently truncated every `i64` to 32 bits.
            string_push(sb, "JestyrArr_")
            push_su_tymangle(sb, src, c, g, d.a)
            string_push(sb, "_")
            push_uint(sb, d.b as i64)
            return
        }
    }
    emit_ty_c(sb, p, src, c, tid)
}

// A generic CALL's type arguments in instance order — explicit comptime type args (bare-Name
// exprs at the comptime-type param positions) first, then each bracket param inferred by
// unifying the params' bare-Name annotations against the args' Checker types (first bind wins;
// structural unification through slices/pointers is a later increment). Appends (kind, a, b)
// triples to `dst`; returns the count. Mirrors `emit_generic_call`'s targ assembly +
// `infer_bracket_args`.
fn gcall_targs(mut dst: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, fit: i32, read e: parser.ExprData) -> i32 {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    var count: i32 = 0
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 and i < e.y {
                    let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, i) as usize)
                    if ax.kind == 2 {
                        list.push(i32, dst, 0)
                        list.push(i32, dst, ax.start as i32)
                        list.push(i32, dst, ax.end as i32)
                    } else {
                        list.push(i32, dst, 2)
                        list.push(i32, dst, 0 - 1)
                        list.push(i32, dst, 0 - 1)
                    }
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // bracket params, declaration order
        let gb: i32 = f.g + gk * 4
        let gns: i32 = list.get(i32, p.gar, gb as usize)
        let gne: i32 = list.get(i32, p.gar, (gb + 1) as usize)
        var bkind: i32 = 2
        var ba: i32 = 0 - 1
        var pi: i32 = 0
        for pi < f.b {
            let pb: i32 = f.a + pi * 7
            let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
            if bkind == 2 and pty >= 0 and pi < e.y and list.get(i32, p.iar, pb as usize) == 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 0 {
                    if str_eq(src[t.start .. t.end], src[gns as usize .. gne as usize]) {
                        let atid: i32 = list.get(i32, c.et, arg_at(p, e, pi) as usize)
                        if atid >= 0 { bkind = 1  ba = atid }
                    }
                }
            }
            pi = pi + 1
        }
        list.push(i32, dst, bkind)
        list.push(i32, dst, ba)
        list.push(i32, dst, 0 - 1)
        count = count + 1
        gk = gk + 1
    }
    return count
}

// The mangled C name `jestyr_<name>__<m0>_<m1>…` of the instance record at `lst[rb..]`
// ([fn item, argc, (kind,a,b)…] — the shared shape of the worklist and `g.gfi`).
fn push_gfn_name(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read lst: List(i32), rb: i32) {
    let fit: i32 = list.get(i32, lst, rb as usize)
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "jestyr_")
    string_push(sb, src[f.x .. f.y])
    string_push(sb, "__")
    let argc: i32 = list.get(i32, lst, (rb + 1) as usize)
    var i: i32 = 0
    for i < argc {
        if i > 0 { string_push(sb, "_") }
        let ab: i32 = rb + 2 + i * 3
        push_targ_mangle(sb, src, c, list.get(i32, lst, ab as usize), list.get(i32, lst, (ab + 1) as usize), list.get(i32, lst, (ab + 2) as usize))
        i = i + 1
    }
}

// If Call `e` targets a generic template, append its instance record to the worklist.
fn gfind_call_check(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, read e: parser.ExprData) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 2 { return }
    let fit: i32 = find_fn_item(p, src, src[callee.start .. callee.end])
    if fit < 0 { return }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    if !fn_is_gen(p, f) { return }
    let rb: i32 = list.len(i32, wk) as i32
    list.push(i32, wk, fit)
    list.push(i32, wk, 0)
    let argc: i32 = gcall_targs(wk, p, src, c, fit, e)
    list.set(i32, wk, (rb + 1) as usize, argc)
    list.push(i32, wks, rb)
    list.push(i32, wks, 0)                            // tag 0 = a generic FN record
}

// The method fn item named `src[ns..ne]` among a comptime struct ctor's tag-1 members, or -1.
fn gnode_method(read p: parser.Parser, read src: str, cfit: i32, ns: usize, ne: usize) -> i32 {
    let node: i32 = ctor_struct_node(p, cfit)
    if node < 0 { return 0 - 1 }
    let sx: parser.ExprData = list.get(parser.ExprData, p.ex, node as usize)
    var m: i32 = 0
    for m < sx.y {
        let mb: i32 = sx.x + m * 10
        if list.get(i32, p.mar, mb as usize) == 1 {
            let mid: i32 = list.get(i32, p.mar, (mb + 1) as usize)
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
            if str_eq(src[fd.x .. fd.y], src[ns .. ne]) { return mid }
        }
        m = m + 1
    }
    return 0 - 1
}

// The `mcalls` record for call `eid` (a method-sugar call typeck resolved to a FREE fn), or -1.
fn mcall_of(read c: typeck.Checker, eid: i32) -> i32 {
    var i: usize = 0
    for i < list.len(i32, c.mcalls) {
        if list.get(i32, c.mcalls, i) == eid { return list.get(i32, c.mcalls, i + 1) }
        i = i + 2
    }
    return 0 - 1
}

// The first non-comptime param's annotation TypeId of fn `fit` (the free method's RECEIVER
// param), or -1.
fn first_runtime_param_ty(read p: parser.Parser, fit: i32) -> i32 {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 0 {
            return list.get(i32, p.iar, (base + 5) as usize)
        }
        i = i + 1
    }
    return 0 - 1
}

// The index of the App type-arg that is exactly the bare Name `src[ns..ne]`, or -1
// (`List(T)` -> index of `T`). Recovers a comptime targ position from the receiver param.
fn app_targ_index(read p: parser.Parser, read src: str, appty: i32, ns: usize, ne: usize) -> i32 {
    if appty < 0 { return 0 - 1 }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, appty as usize)
    if t.kind != 7 { return 0 - 1 }
    var i: i32 = 0
    for i < t.a {
        let at: parser.TypeData = list.get(parser.TypeData, p.ty, list.get(i32, p.tar, (t.op + i) as usize) as usize)
        if at.kind == 0 {
            if str_eq(src[at.start .. at.end], src[ns .. ne]) { return i }
        }
        i = i + 1
    }
    return 0 - 1
}

// A free-method sugar call (`xs.push(10)` -> `push(i32, xs, 10)`, recorded in `mcalls`): each
// comptime-TYPE targ is RECOVERED from the receiver — the tparam's position in the receiver
// param's `Ctor(T…)` annotation indexes the receiver's kind-6 instance args. Appends (kind,a,b)
// triples; returns the count. Mirrors MethodRes.type_args.
fn gmcall_targs(mut dst: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, fit: i32, recv_tid: i32) -> i32 {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    let rp: i32 = first_runtime_param_ty(p, fit)
    var count: i32 = 0
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 {
                    let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
                    let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
                    let idx: i32 = app_targ_index(p, src, rp, pns as usize, pne as usize)
                    var done: bool = false
                    if idx >= 0 and recv_tid >= 0 {
                        let d: typeck.TyData = list.get(typeck.TyData, c.tys, recv_tid as usize)
                        if d.kind == 6 and idx < d.b {
                            list.push(i32, dst, 1)
                            list.push(i32, dst, list.get(i32, c.tya, (d.a + idx) as usize))
                            list.push(i32, dst, 0 - 1)
                            done = true
                        }
                    }
                    if !done {
                        list.push(i32, dst, 2)        // unresolved -> `x`
                        list.push(i32, dst, 0 - 1)
                        list.push(i32, dst, 0 - 1)
                    }
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    return count
}

// A free-method sugar call to a GENERIC free fn pushes a plain Fn record with the recovered
// targs (mirrors Work::Fn from a MethodRes with no recv_ctor).
fn gmcall_check(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, read e: parser.ExprData, eid: i32) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 5 { return }
    let fit: i32 = mcall_of(c, eid)
    if fit < 0 { return }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    if !fn_is_gen(p, f) { return }
    let rb: i32 = list.len(i32, wk) as i32
    list.push(i32, wk, fit)
    list.push(i32, wk, 0)
    let argc: i32 = gmcall_targs(wk, p, src, c, fit, list.get(i32, c.et, callee.a as usize))
    list.set(i32, wk, (rb + 1) as usize, argc)
    list.push(i32, wks, rb)
    list.push(i32, wks, 0)                            // an ordinary Fn record
}

// A method-sugar call whose receiver's Checker type is a generic-struct instance (kind 6,
// comptime struct ctor) pushes a METHOD record: [method fn item, argc, (kind,a,b)×argc from
// the RECEIVER's instance args, ctor fn item]. Mirrors `Work::Method` — the receiver's type
// args ARE the instance's (an Opaque arg inside a template body remaps like any other).
fn gmethod_check(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, read e: parser.ExprData, eid: i32) {
    if mcall_of(c, eid) >= 0 { return }               // a FREE method resolved first (typeck order)
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 5 { return }
    let rtid: i32 = list.get(i32, c.et, callee.a as usize)
    if rtid < 0 { return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, rtid as usize)
    if d.kind != 6 {
        // A PLAIN named-struct receiver takes the SAME worklist, with argc 0 and the
        // STRUCT item in the trailing slot. The reference pushes Work::Method for
        // every resolved method call, generic or not, and drains LIFO -- which is why
        // a flat arena scan cannot reproduce its order: three plain methods called
        // first/second/third emit third/second/first. The old `g.mi` flat scan was a
        // LATENT divergence no corpus file had two instances to expose.
        let packed: i32 = resolve_method_call(p, src, c, callee)
        if packed < 0 { return }
        let rb: i32 = list.len(i32, wk) as i32
        list.push(i32, wk, packed % 1000000)          // the method fn item
        list.push(i32, wk, 0)                          // argc 0: no type args
        list.push(i32, wk, packed / 1000000)           // trailing: the struct ITEM
        list.push(i32, wks, rb)
        list.push(i32, wks, 1)                         // tag 1 = a METHOD record
        return
    }
    let cfit: i32 = gstruct_ctor_fn(p, src, c, rtid)
    if cfit < 0 { return }
    let mfit: i32 = gnode_method(p, src, cfit, callee.x as usize, callee.y as usize)
    if mfit < 0 { return }
    let rb: i32 = list.len(i32, wk) as i32
    list.push(i32, wk, mfit)
    list.push(i32, wk, d.b)
    var i: i32 = 0
    for i < d.b {
        list.push(i32, wk, 1)                         // kind 1 = a Checker TyId arg
        list.push(i32, wk, list.get(i32, c.tya, (d.a + i) as usize))
        list.push(i32, wk, 0 - 1)
        i = i + 1
    }
    list.push(i32, wk, cfit)                          // trailing ctor item
    list.push(i32, wks, rb)
    list.push(i32, wks, 1)                            // tag 1 = a METHOD record
}

fn gfind_expr(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 10 {                                 // Call: recurse callee + args FIRST, then check
        gfind_expr(wk, wks, p, src, c, e.a)
        var i: i32 = 0
        for i < e.y {
            gfind_expr(wk, wks, p, src, c, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        gfind_call_check(wk, wks, p, src, c, e)
        gmcall_check(wk, wks, p, src, c, e, eid)      // free-method sugar first (typeck's order)
        gmethod_check(wk, wks, p, src, c, e, eid)
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 or e.kind == 45 {   // Binary / Index / Assign / Catch
        // Catch (45) matters here: a generic method called ONLY inside a `catch` --
        // `sf.get() catch 0.0` -- would otherwise never be discovered, and its
        // instance would be a LINK error, not a diagnostic. The reference's
        // find_calls_expr grew its Catch arm with the construct; this is the port's.
        gfind_expr(wk, wks, p, src, c, e.a)
        gfind_expr(wk, wks, p, src, c, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 11 or e.kind == 34 or e.kind == 35 {
        gfind_expr(wk, wks, p, src, c, e.a)
        return
    }
    if e.kind == 13 {
        if e.a >= 0 { gfind_expr(wk, wks, p, src, c, e.a) }
        if e.b >= 0 { gfind_expr(wk, wks, p, src, c, e.b) }
        return
    }
    if e.kind == 16 {                                 // StructLit fields + spread
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            gfind_expr(wk, wks, p, src, c, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { gfind_expr(wk, wks, p, src, c, e.b) }
        return
    }
    if e.kind == 17 {                                 // GenStructLit fields
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            gfind_expr(wk, wks, p, src, c, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {                                 // If
        gfind_expr(wk, wks, p, src, c, e.a)
        gfind_block(wk, wks, p, src, c, e.b)
        if e.op >= 0 { gfind_expr(wk, wks, p, src, c, e.op) }
        return
    }
    if e.kind == 23 { gfind_block(wk, wks, p, src, c, eid)  return }
    if e.kind == 25 or e.kind == 43 { gfind_block(wk, wks, p, src, c, e.a)  return }   // Unsafe / Region
    if e.kind == 28 {                                 // Match
        gfind_expr(wk, wks, p, src, c, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { gfind_expr(wk, wks, p, src, c, guard) }
            gfind_expr(wk, wks, p, src, c, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For
        if e.op == 1 { gfind_expr(wk, wks, p, src, c, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                gfind_expr(wk, wks, p, src, c, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        gfind_block(wk, wks, p, src, c, e.b)
        if e.x >= 0 { gfind_block(wk, wks, p, src, c, e.x) }
        return
    }
}

fn gfind_block(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { gfind_expr(wk, wks, p, src, c, s.a) }
        i = i + 1
    }
}

// Collect every generic-function instance: scan each non-template fn body + concrete
// impl-method body for template calls (expression order), then drain the worklist LIFO — the
// reference pops a STACK, so instances land in REVERSE discovery order — deduping on the
// mangled name into `g.gfi`.
fn collect_gfn_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read a: Allocator) {
    var wk: List(i32) = list.make(i32, a)
    var wks: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) { gfind_block(wk, wks, p, src, c, it.w) }
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + k) as usize) as usize)
                gfind_block(wk, wks, p, src, c, fd.w)
                k = k + 1
            }
        }
        r = r + 1
    }
    var seen: String = string_new()
    for list.len(i32, wks) > 0 {                      // (rb, tag) pairs; tag 1 = a METHOD record
        let tag: i32 = list.get(i32, wks, list.len(i32, wks) - 1)
        let rb: i32 = list.get(i32, wks, list.len(i32, wks) - 2)
        list.truncate(i32, wks, list.len(i32, wks) - 2)
        var probe: String = string_new()
        string_push(probe, "|")
        if tag == 1 { string_push(probe, "m:")  push_gmi_name(probe, p, src, c, wk, rb) }
        else { push_gfn_name(probe, p, src, c, wk, rb) }
        string_push(probe, "|")
        if !contains(string_view(seen), string_view(probe)) {
            string_push(seen, string_view(probe))
            let argc: i32 = list.get(i32, wk, (rb + 1) as usize)
            var reclen: i32 = 2 + argc * 3
            if tag == 1 { reclen = reclen + 1 }       // + the trailing ctor item
            var t: i32 = 0
            for t < reclen {
                if tag == 1 { list.push(i32, g.gmi, list.get(i32, wk, (rb + t) as usize)) }
                else { list.push(i32, g.gfi, list.get(i32, wk, (rb + t) as usize)) }
                t = t + 1
            }
            // A generic calling a generic: walk THIS instance's template/method body for
            // nested template calls, then resolve each new record's tparam-typed args through
            // this record's bindings (the reference's subst-aware `collect_all_instances`
            // worklist; dedup-on-pop bounds recursion). A METHOD's tparams are its CTOR's.
            var ctx: i32 = list.get(i32, wk, rb as usize)
            if tag == 1 { ctx = list.get(i32, wk, (rb + 2 + argc * 3) as usize) }
            let f2: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, wk, rb as usize) as usize)
            if f2.w >= 0 {
                let before: usize = list.len(i32, wks)
                gfind_block(wk, wks, p, src, c, f2.w)
                var nw: usize = before
                for nw < list.len(i32, wks) {
                    remap_targs(wk, p, src, c, ctx, rb, list.get(i32, wks, nw))
                    nw = nw + 2
                }
            }
        }
        string_free(probe)
    }
    string_free(seen)
}

// The C name of a monomorphized generic-struct method, `jestyr_<Ctor>__<mangles>_<method>`
// (mirrors `method_c_name`). Record layout: [method fn item, argc, triples…, ctor fn item].
fn push_gmi_name(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read lst: List(i32), rb: i32) {
    let argc: i32 = list.get(i32, lst, (rb + 1) as usize)
    let cf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, lst, (rb + 2 + argc * 3) as usize) as usize)
    let mf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, lst, rb as usize) as usize)
    string_push(sb, "jestyr_")
    string_push(sb, src[cf.x .. cf.y])
    if argc == 0 {                                    // plain struct: jestyr_<Struct>_<method>
        string_push(sb, "_")
        string_push(sb, src[mf.x .. mf.y])
        return
    }
    string_push(sb, "__")
    var t: i32 = 0
    for t < argc {
        if t > 0 { string_push(sb, "_") }
        let tb: i32 = rb + 2 + t * 3
        push_targ_mangle(sb, src, c, list.get(i32, lst, tb as usize), list.get(i32, lst, (tb + 1) as usize), list.get(i32, lst, (tb + 2) as usize))
        t = t + 1
    }
    string_push(sb, "_")
    string_push(sb, src[mf.x .. mf.y])
}

// The index of tparam `src[ns..ne]` in fn `f`'s INSTANCE type-arg order (comptime-type params
// first, then bracket params), or -1.
fn tparam_index_of(read p: parser.Parser, read src: str, read f: parser.ItemData, ns: usize, ne: usize) -> i32 {
    var idx: i32 = 0
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 {
                    let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
                    let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
                    if str_eq(src[pns as usize .. pne as usize], src[ns .. ne]) { return idx }
                    idx = idx + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {
        let gb: i32 = f.g + gk * 4
        let gns: i32 = list.get(i32, p.gar, gb as usize)
        let gne: i32 = list.get(i32, p.gar, (gb + 1) as usize)
        if str_eq(src[gns as usize .. gne as usize], src[ns .. ne]) { return idx }
        idx = idx + 1
        gk = gk + 1
    }
    return 0 - 1
}

// Rewrite the type-arg triples of a record discovered INSIDE an instance body: a kind-0 span
// (or a kind-1 Opaque) naming one of the ENCLOSING record's tparams takes that record's
// binding triple — so `load_cell(T, …)` inside `chan_recv__i64` records as `load_cell__i64`.
fn remap_targs(mut wk: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, ctx_fit: i32, outer_rb: i32, new_rb: i32) {
    let of_: parser.ItemData = list.get(parser.ItemData, p.it, ctx_fit as usize)
    let argc: i32 = list.get(i32, wk, (new_rb + 1) as usize)
    var t: i32 = 0
    for t < argc {
        let tb: i32 = new_rb + 2 + t * 3
        let kind: i32 = list.get(i32, wk, tb as usize)
        var ns: i32 = 0 - 1
        var ne: i32 = 0 - 1
        if kind == 0 {
            ns = list.get(i32, wk, (tb + 1) as usize)
            ne = list.get(i32, wk, (tb + 2) as usize)
        } else if kind == 1 {
            let d: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, wk, (tb + 1) as usize) as usize)
            if d.kind == 4 { ns = d.x  ne = d.y }     // an Opaque tparam type
        }
        if ns >= 0 {
            let idx: i32 = tparam_index_of(p, src, of_, ns as usize, ne as usize)
            if idx >= 0 {
                let ob: i32 = outer_rb + 2 + idx * 3
                list.set(i32, wk, tb as usize, list.get(i32, wk, ob as usize))
                list.set(i32, wk, (tb + 1) as usize, list.get(i32, wk, (ob + 1) as usize))
                list.set(i32, wk, (tb + 2) as usize, list.get(i32, wk, (ob + 2) as usize))
            }
        }
        t = t + 1
    }
}

// The instance's signature `<ret> jestyr_<name>__<mangles>(<params>)` under its substitution:
// arms `g.su` (tparam spans in instance order — comptime-type names, then brackets — zipped
// with the record's arg triples) and leaves it set for the body; the caller clears it.
// Arm `g.su` from instance record `rb`: tparam name spans in instance order (comptime-type
// names, then brackets) zipped with the record's arg triples. The caller clears it.
fn arm_record_su(mut g: Cg, read p: parser.Parser, rb: i32) {
    let fit: i32 = list.get(i32, g.gfi, rb as usize)
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    list.truncate(i32, g.su, 0)
    var ai: i32 = 0
    var i: i32 = 0
    for i < f.b {                                     // comptime-type param names first
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 {
                    let ab: i32 = rb + 2 + ai * 3
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 2) as usize))
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 3) as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, ab as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, (ab + 1) as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, (ab + 2) as usize))
                    ai = ai + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // then the bracket params
        let gb: i32 = f.g + gk * 4
        let ab: i32 = rb + 2 + ai * 3
        list.push(i32, g.su, list.get(i32, p.gar, gb as usize))
        list.push(i32, g.su, list.get(i32, p.gar, (gb + 1) as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, ab as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, (ab + 1) as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, (ab + 2) as usize))
        ai = ai + 1
        gk = gk + 1
    }
}

fn emit_gfn_sig(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, rb: i32) {
    let fit: i32 = list.get(i32, g.gfi, rb as usize)
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    arm_record_su(g, p, rb)
    emit_su_ty(sb, p, src, c, g, f.z)
    string_push(sb, " ")
    push_gfn_name(sb, p, src, c, g.gfi, rb)
    string_push(sb, "(")
    var emitted: i32 = 0
    var pi: i32 = 0
    for pi < f.b {
        let base: i32 = f.a + pi * 7
        if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            emit_su_ty(sb, p, src, c, g, list.get(i32, p.iar, (base + 5) as usize))
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
            string_push(sb, " j_")
            string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            emitted = emitted + 1
        }
        pi = pi + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// A generic call site: `jestyr_<name>__<mangles>(<args sans comptime-type args>)`, `mut`/`out`
// args by address. The mangle recomputation must agree with `gcall_targs` exactly.
fn emit_generic_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, fit: i32) {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "jestyr_")
    string_push(sb, src[f.x .. f.y])
    string_push(sb, "__")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < f.b {                                     // explicit comptime type args
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 and i < e.y {
                    if emitted > 0 { string_push(sb, "_") }
                    let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, i) as usize)
                    if ax.kind == 2 {
                        // a tparam passed onward inside an instance body resolves through the
                        // ACTIVE substitution (`load_cell(T, …)` under T=i64 -> `__i64`)
                        let sl: i32 = su_slot(src, g, ax.start, ax.end)
                        if sl >= 0 { push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl + 2) as usize), list.get(i32, g.su, (sl + 3) as usize), list.get(i32, g.su, (sl + 4) as usize)) }
                        else { string_push(sb, src[ax.start .. ax.end]) }
                    } else { string_push(sb, "x") }
                    emitted = emitted + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // inferred bracket args
        let gb: i32 = f.g + gk * 4
        let gns: i32 = list.get(i32, p.gar, gb as usize)
        let gne: i32 = list.get(i32, p.gar, (gb + 1) as usize)
        var bound: i32 = 0 - 1
        var pi: i32 = 0
        for pi < f.b {
            let pb: i32 = f.a + pi * 7
            let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
            if bound < 0 and pty >= 0 and pi < e.y and list.get(i32, p.iar, pb as usize) == 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 0 {
                    if str_eq(src[t.start .. t.end], src[gns as usize .. gne as usize]) {
                        let atid: i32 = list.get(i32, c.et, arg_at(p, e, pi) as usize)
                        if atid >= 0 { bound = atid }
                    }
                }
            }
            pi = pi + 1
        }
        if emitted > 0 { string_push(sb, "_") }
        if bound >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bound as usize)
            var done: bool = false
            if bd.kind == 4 {                          // an Opaque tparam: resolve through g.su
                let sl2: i32 = su_slot(src, g, bd.x as usize, bd.y as usize)
                if sl2 >= 0 {
                    push_targ_mangle(sb, src, c, list.get(i32, g.su, (sl2 + 2) as usize), list.get(i32, g.su, (sl2 + 3) as usize), list.get(i32, g.su, (sl2 + 4) as usize))
                    done = true
                }
            }
            if !done { push_ty_mangle(sb, src, c, bound) }
        } else { string_push(sb, "x") }
        emitted = emitted + 1
        gk = gk + 1
    }
    string_push(sb, "(")
    var wrote: i32 = 0
    var aidx: i32 = 0
    for aidx < e.y {
        var is_targ: bool = false
        if aidx < f.b {
            let pb: i32 = f.a + aidx * 7
            if list.get(i32, p.iar, pb as usize) == 1 {
                let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
                if pty >= 0 {
                    let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                    if t.kind == 1 { is_targ = true }  // a type argument — erased
                }
            }
        }
        if !is_targ {
            if wrote > 0 { string_push(sb, ", ") }
            var conv: i32 = 0
            if aidx < f.b { conv = list.get(i32, p.iar, (f.a + aidx * 7 + 1) as usize) }
            if conv == 2 or conv == 4 {
                emit_addr_arg(sb, p, src, c, g, arg_at(p, e, aidx))
            } else {
                emit_expr(sb, p, src, c, g, arg_at(p, e, aidx))
            }
            wrote = wrote + 1
        }
        aidx = aidx + 1
    }
    string_push(sb, ")")
}

// ---- RAII drop glue (mirrors needs_drop / emit_drop_place / emit_all_drops / collect_moved) ----

// The item id of the top-level struct/enum/distinct declaring the type named `src[ns..ne]`, or -1.
fn find_named_item(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 or it.kind == 5 or it.kind == 1 {
            if str_eq(src[it.x .. it.y], src[ns as usize .. ne as usize]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Is there a concrete `impl Drop for <name>` (kind 7, non-generic, trait "Drop", a Name target)?
// Mirrors `drop_key_of` for named receivers; blanket generic Drop impls are a later increment.
fn has_drop_impl(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> bool {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            if str_eq(src[it.x .. it.y], "Drop") {
                let tt: parser.TypeData = list.get(parser.TypeData, p.ty, it.a as usize)
                if tt.kind == 0 {
                    if str_eq(src[tt.start .. tt.end], src[ns as usize .. ne as usize]) { return true }
                }
            }
        }
        r = r + 1
    }
    return false
}

// Does variant `k` of enum item `it` carry a payload field that needs drop?
fn variant_droppable(read p: parser.Parser, read src: str, read it: parser.ItemData, k: i32) -> bool {
    let vb: i32 = it.b + k * 5
    let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
    let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
    var fi: i32 = 0
    for fi < fc {
        if needs_drop_ast_ty(p, src, list.get(i32, p.ear, (fs + fi * 3 + 2) as usize)) { return true }
        fi = fi + 1
    }
    return false
}

// Does a value of the named type `src[ns..ne]` need drop glue — its own `Drop` impl, or an owned
// struct field / enum payload that transitively does? Indirection (pointers/references) is never
// followed, which also bounds the recursion (a by-value aggregate can't contain itself). An
// untagged `union` has no single live field, so it never auto-drops. (The reference short-circuits
// on `is_copy` first; that check is inert here — a `@copy` aggregate can't own droppables, so it
// can only reach `false` through these same paths.)
fn needs_drop_name(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> bool {
    if has_drop_impl(p, src, ns, ne) { return true }
    let iid: i32 = find_named_item(p, src, ns, ne)
    if iid < 0 { return false }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
    if it.kind == 4 and it.op != 2 {                  // struct/record (not union): any owned field?
        var i: i32 = 0
        for i < it.b {
            let mb: i32 = it.a + i * 10
            if list.get(i32, p.mar, mb as usize) == 0 {           // a field (tag 0)
                if needs_drop_ast_ty(p, src, list.get(i32, p.mar, (mb + 4) as usize)) { return true }
            }
            i = i + 1
        }
    }
    if it.kind == 5 and it.a == 0 {                   // non-generic enum: any droppable payload?
        var k: i32 = 0
        for k < it.z {
            if variant_droppable(p, src, it, k) { return true }
            k = k + 1
        }
    }
    return false
}

// `needs_drop` for an AST type annotation: a bare Name type, or a generic application
// `Ctor(args)` covered by a blanket `impl[T] Drop for Ctor(T)` (pointers, slices, arrays, refs
// are indirection or non-owning — the reference reaches the same `false`).
fn needs_drop_ast_ty(read p: parser.Parser, read src: str, tyid: i32) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 { return needs_drop_name(p, src, t.start as i32, t.end as i32) }
    if t.kind == 7 { return generic_drop_impl_of(p, src, t.x as usize, t.y as usize) >= 0 }
    return false
}

// The sanitized `ty_key` display of an AST-written type (the annotation-side mirror of
// `push_ty_key_safe`): a Name is already a C identifier; `Ctor(a, b)` -> `Ctor_a__b_`.
fn push_ast_key_safe(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    if tyid < 0 { string_push(sb, "_")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 { string_push(sb, src[t.start .. t.end])  return }
    if t.kind == 7 {
        string_push(sb, src[t.x as usize .. t.y as usize])
        string_push(sb, "_")
        var i: i32 = 0
        for i < t.a {
            if i > 0 { string_push(sb, "__") }
            push_ast_key_safe(sb, p, src, list.get(i32, p.tar, (t.op + i) as usize))
            i = i + 1
        }
        string_push(sb, "_")
        return
    }
    string_push(sb, "_")
}

// Emit the drop call for a field/payload whose AST type is a generic application: its
// monomorphized blanket impl IS the drop (the reference's GenStruct arm of `emit_drop_place` —
// no field recursion, `aggregate_drop_fields` is Named-only).
fn emit_app_drop(mut sb: String, read p: parser.Parser, read src: str, read place: str, tyid: i32, depth: i32) {
    indent(sb, depth)
    string_push(sb, "jestyr_impl_Drop__")
    push_ast_key_safe(sb, p, src, tyid)
    string_push(sb, "__drop(&")
    string_push(sb, place)
    string_push(sb, ");\n")
}

// Emit drop glue for the value at C lvalue `place` of the named type `src[tns..tne]`: its own
// `Drop::drop` first (receiver by `&place`), then — additively — each owned struct field / live
// enum payload in reverse declaration order. Every line lands flat at `depth` (the reference's
// `self.line`, whose depth never changes inside the walker — even the switch/case lines).
fn emit_drop_place(mut sb: String, read p: parser.Parser, read src: str, read place: str, tns: i32, tne: i32, depth: i32) {
    if has_drop_impl(p, src, tns, tne) {
        indent(sb, depth)
        string_push(sb, "jestyr_impl_Drop__")
        string_push(sb, src[tns as usize .. tne as usize])   // a Name key is already a C identifier
        string_push(sb, "__drop(&")
        string_push(sb, place)
        string_push(sb, ");\n")
    }
    let iid: i32 = find_named_item(p, src, tns, tne)
    if iid < 0 { return }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
    if it.kind == 4 {
        if it.op == 2 { return }                      // untagged union: never auto-drop fields
        var i: i32 = it.b - 1
        for i >= 0 {                                  // owned fields, reverse declaration order
            let mb: i32 = it.a + i * 10
            if list.get(i32, p.mar, mb as usize) == 0 {
                let fty: i32 = list.get(i32, p.mar, (mb + 4) as usize)
                if needs_drop_ast_ty(p, src, fty) {
                    let ftd: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                    var cp: String = string_new()
                    string_push(cp, place)
                    string_push(cp, ".j_")
                    string_push(cp, src[list.get(i32, p.mar, (mb + 2) as usize) as usize .. list.get(i32, p.mar, (mb + 3) as usize) as usize])
                    if ftd.kind == 7 {
                        emit_app_drop(sb, p, src, string_view(cp), fty, depth)
                    } else {
                        emit_drop_place(sb, p, src, string_view(cp), ftd.start as i32, ftd.end as i32, depth)
                    }
                    string_free(cp)
                }
            }
            i = i - 1
        }
        return
    }
    if it.kind == 5 and it.a == 0 {                   // live enum payload: switch on the tag
        var any: bool = false
        var k0: i32 = 0
        for k0 < it.z {
            if variant_droppable(p, src, it, k0) { any = true }
            k0 = k0 + 1
        }
        if !any { return }
        let en: str = src[it.x .. it.y]
        indent(sb, depth)
        string_push(sb, "switch (")
        string_push(sb, place)
        string_push(sb, ".tag) {\n")
        var k: i32 = 0
        for k < it.z {                                // droppable variants contribute a `case` each
            if variant_droppable(p, src, it, k) {
                let vb: i32 = it.b + k * 5
                let vname: str = src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize]
                indent(sb, depth)
                string_push(sb, "case Jestyr_")
                string_push(sb, en)
                string_push(sb, "_")
                string_push(sb, vname)
                string_push(sb, ": {\n")
                let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
                let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                var fi: i32 = fc - 1
                for fi >= 0 {                         // payload fields, reverse declaration order
                    let fb: i32 = fs + fi * 3
                    let pfty: i32 = list.get(i32, p.ear, (fb + 2) as usize)
                    if needs_drop_ast_ty(p, src, pfty) {
                        let ftd: parser.TypeData = list.get(parser.TypeData, p.ty, pfty as usize)
                        var cp: String = string_new()
                        string_push(cp, place)
                        string_push(cp, ".u.")
                        string_push(cp, vname)
                        string_push(cp, ".j_")
                        string_push(cp, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                        if ftd.kind == 7 {
                            emit_app_drop(sb, p, src, string_view(cp), pfty, depth)
                        } else {
                            emit_drop_place(sb, p, src, string_view(cp), ftd.start as i32, ftd.end as i32, depth)
                        }
                        string_free(cp)
                    }
                    fi = fi - 1
                }
                line_at(sb, depth, "break;")
                line_at(sb, depth, "}")
            }
            k = k + 1
        }
        line_at(sb, depth, "default: break;")
        line_at(sb, depth, "}")
    }
}

// Open a drop scope for a `{ }` block (records the current entry-list length).
fn drop_scope_enter(mut g: Cg) {
    list.push(i32, g.dsb, list.len(i32, g.ds) as i32)
}

// Emit one registered local's drop glue: `j_<name>` of its recorded type.
fn emit_local_drop(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, base: i32, depth: i32) {
    var place: String = string_new()
    string_push(place, "j_")
    string_push(place, src[list.get(i32, g.ds, base as usize) as usize .. list.get(i32, g.ds, (base + 1) as usize) as usize])
    let tns: i32 = list.get(i32, g.ds, (base + 2) as usize)
    if tns < 0 - 1 {                                  // a GENERIC-STRUCT instance (encoded -2 - TyId):
        let tid: i32 = 0 - 2 - tns                    // drop via its monomorphized blanket impl
        indent(sb, depth)
        string_push(sb, "jestyr_impl_Drop__")
        push_ty_key_safe(sb, src, c, tid)
        string_push(sb, "__drop(&")
        string_push(sb, string_view(place))
        string_push(sb, ");\n")
        string_free(place)
        return
    }
    emit_drop_place(sb, p, src, string_view(place), tns, list.get(i32, g.ds, (base + 3) as usize), depth)
    string_free(place)
}

// Close the innermost drop scope, dropping its locals in reverse declaration order (the normal
// fall-through path).
fn drop_scope_exit_emit(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, depth: i32) {
    let floor: i32 = list.get(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.dsb, list.len(i32, g.dsb) - 1)
    var i: i32 = list.len(i32, g.ds) as i32 - 4
    for i >= floor {
        emit_local_drop(sb, p, src, c, g, i, depth)
        i = i - 4
    }
    list.truncate(i32, g.ds, floor as usize)
}

// Close the innermost drop scope without emitting (the block already diverged via a `return`,
// which dropped everything).
fn drop_scope_exit_discard(mut g: Cg) {
    let floor: i32 = list.get(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.ds, floor as usize)
}

// Drop every live local across all open scopes, innermost first — the cleanup run *before* a
// `return`. Does not pop: the C locals stay in scope until the `return` that follows.
fn emit_all_drops(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, depth: i32) {
    var i: i32 = list.len(i32, g.ds) as i32 - 4
    for i >= 0 {
        emit_local_drop(sb, p, src, c, g, i, depth)
        i = i - 4
    }
}

// True if any open scope holds a live droppable — a `return` here must spill, drop, then return.
fn has_live_drops(read g: Cg) -> bool {
    return list.len(i32, g.ds) > 0
}

// Was `src[ns..ne]` marked moved-out by the current fn's move analysis?
fn is_moved_name(read g: Cg, read src: str, ns: i32, ne: i32) -> bool {
    var i: usize = 0
    for i < list.len(i32, g.mv) {
        let ms: i32 = list.get(i32, g.mv, i)
        let me: i32 = list.get(i32, g.mv, i + 1)
        if str_eq(src[ns as usize .. ne as usize], src[ms as usize .. me as usize]) { return true }
        i = i + 2
    }
    return false
}

// Register a freshly-declared `let` for scope-exit drop glue, if its type needs drop and its
// value does not escape (`mv`). The type comes from the annotation when present, else the
// Checker's inferred type of the initializer — only a Named type can be droppable.
fn register_drop_local(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read s: parser.StmtData) {
    if list.len(i32, g.dsb) == 0 { return }
    var tns: i32 = 0 - 1
    var tne: i32 = 0 - 1
    if s.ty >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, s.ty as usize)
        if t.kind == 0 { tns = t.start as i32  tne = t.end as i32 }
    }
    if tns < 0 and s.a >= 0 {                         // no bare-Name annotation: the Checker's
        // inferred initializer type (an App-annotated `x: List(i32)` local registers here too —
        // the reference keys drops on the local's resolved Ty, not the annotation's spelling)
        let tid: i32 = list.get(i32, c.et, s.a as usize)
        if tid >= 0 {
            let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
            if d.kind == 15 {                         // Named: the tdecl row carries the name span
                tns = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
                tne = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
            }
            if d.kind == 6 {                          // a generic-struct instance: droppable iff a
                if tyid_concrete(c, tid) {            // blanket `impl[T] Drop` covers its ctor
                    if generic_drop_impl_of(p, src, d.x as usize, d.y as usize) >= 0 {
                        if !is_moved_name(g, src, s.x, s.y) {
                            list.push(i32, g.ds, s.x)
                            list.push(i32, g.ds, s.y)
                            list.push(i32, g.ds, 0 - 2 - tid)   // encoded instance TyId
                            list.push(i32, g.ds, 0 - 1)
                        }
                        return
                    }
                }
            }
        }
    }
    if tns < 0 { return }
    if is_moved_name(g, src, s.x, s.y) { return }
    if !needs_drop_name(p, src, tns, tne) { return }
    list.push(i32, g.ds, s.x)
    list.push(i32, g.ds, s.y)
    list.push(i32, g.ds, tns)
    list.push(i32, g.ds, tne)
}

// The fn's droppable `take` parameters, pre-filtered into `ds`-format 4-tuples (name span,
// type-name span) awaiting the body's ROOT drop scope — a `take` parameter is an ownership
// transfer, so the callee is the new owner and drops it at scope exit unless the body moves
// it on. Mirrors `take_param_drops` + the `register_drop_local` filters, applied at fill
// time (after the move analysis) since a param is not a `let`: skip `self`, `comptime`,
// non-`take`, moved-on (`mv`), and non-droppable annotations. Only a bare-Name annotation
// registers — a blanket-droppable `Ctor(T)` param and a substituted tparam `take x: T`
// instance are the recorded later increment, the same class as template-body lets under
// subst (the reference registers those; no corpus file reaches them yet).
fn fill_take_drops(mut g: Cg, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    list.truncate(i32, g.tkd, 0)
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        let comp: i32 = list.get(i32, p.iar, base as usize)
        let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
        let is_self: i32 = list.get(i32, p.iar, (base + 4) as usize)
        let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
        if comp == 0 and conv == 3 and is_self == 0 and pty >= 0 {
            let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
            let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
            let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
            if t.kind == 0 and !is_moved_name(g, src, pns, pne) {
                if needs_drop_name(p, src, t.start as i32, t.end as i32) {
                    list.push(i32, g.tkd, pns)
                    list.push(i32, g.tkd, pne)
                    list.push(i32, g.tkd, t.start as i32)
                    list.push(i32, g.tkd, t.end as i32)
                }
            }
        }
        i = i + 1
    }
}

// ---- move analysis (mirrors collect_moved / collect_moved_expr — over-approximated, leak-safe:
// a name is "moved" if returned, bound to a `take` param, captured into a literal, or rebound;
// borrows never move. Free fns AND method/impl bodies all run this, exactly like the reference's
// `cur_moved` lifecycle since the take-drop fix.) ----

// Mark `eid`'s span moved if it is exactly a bare Name.
fn mv_mark(mut g: Cg, read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 2 {
        list.push(i32, g.mv, e.start as i32)
        list.push(i32, g.mv, e.end as i32)
    }
}

// Mark each bare-name argument landing at a `take` param of a *free* call as moved. A callee we
// can't resolve to a user fn (an intrinsic) never takes ownership. A comptime TYPE param's slot
// carries a type argument, so the pair is skipped (mirrors `mark_free_arg_takes`). Method-sugar
// receivers (`take self`) are deferred until a droppable-with-methods file needs them.
fn mark_take_args(mut g: Cg, read p: parser.Parser, read src: str, read e: parser.ExprData) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 2 { return }
    var fid: i32 = 0 - 1
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], src[callee.start .. callee.end]) { fid = iid }
        }
        r = r + 1
    }
    if fid < 0 { return }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
    var i: i32 = 0
    for i < f.b {
        if i < e.y {                                  // args align 1:1 with the params
            let pb: i32 = f.a + i * 7
            var skip: bool = false
            if list.get(i32, p.iar, pb as usize) == 1 {           // a comptime param …
                let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
                if pty >= 0 {
                    let pt: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                    if pt.kind == 1 { skip = true }   // … of type `type`: the arg is a type, skip
                }
            }
            if !skip and list.get(i32, p.iar, (pb + 1) as usize) == 3 {   // `take`
                mv_mark(g, p, list.get(i32, p.ar, (e.x + i) as usize))
            }
        }
        i = i + 1
    }
}

fn collect_moved_expr(mut g: Cg, read p: parser.Parser, read src: str, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 10 {                                 // Call: take-args, then recurse
        mark_take_args(g, p, src, e)
        collect_moved_expr(g, p, src, e.a)
        var i: i32 = 0
        for i < e.y {
            collect_moved_expr(g, p, src, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 12 {                                 // Assign: the value rebinds
        mv_mark(g, p, e.b)
        collect_moved_expr(g, p, src, e.a)
        collect_moved_expr(g, p, src, e.b)
        return
    }
    if e.kind == 16 {                                 // StructLit: field values are captured
        var i: i32 = 0
        for i < e.y {
            let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
            mv_mark(g, p, fi_.a)
            collect_moved_expr(g, p, src, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { collect_moved_expr(g, p, src, e.b) }        // spread
        return
    }
    if e.kind == 17 {                                 // GenStructLit: same, fields at (b, y)
        var i: i32 = 0
        for i < e.y {
            let fid: i32 = list.get(i32, p.ar, (e.b + i) as usize)
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
            mv_mark(g, p, fi_.a)
            collect_moved_expr(g, p, src, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 {                   // Binary / Index
        collect_moved_expr(g, p, src, e.a)
        collect_moved_expr(g, p, src, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 11 or e.kind == 34 or e.kind == 35 {
        collect_moved_expr(g, p, src, e.a)            // Unary/Field/Deref/Try/Cast/Invariant/Variant
        return
    }
    if e.kind == 43 { collect_moved_block(g, p, src, e.a)  return }   // Region block
    if e.kind == 46 {                                 // WithAlive: body + else blocks (the genref
        collect_moved_block(g, p, src, e.b)           // scrutinee is Copy — never a move source)
        if e.op >= 0 { collect_moved_block(g, p, src, e.op) }
        return
    }
    if e.kind == 13 {                                 // Range
        if e.a >= 0 { collect_moved_expr(g, p, src, e.a) }
        if e.b >= 0 { collect_moved_expr(g, p, src, e.b) }
        return
    }
    if e.kind == 24 {                                 // If: cond, then-block, else
        collect_moved_expr(g, p, src, e.a)
        collect_moved_block(g, p, src, e.b)
        if e.op >= 0 { collect_moved_expr(g, p, src, e.op) }
        return
    }
    if e.kind == 23 { collect_moved_block(g, p, src, eid)  return }   // Block
    if e.kind == 25 { collect_moved_block(g, p, src, e.a)  return }   // Unsafe block
    if e.kind == 28 {                                 // Match: scrutinee, guards, arm bodies
        collect_moved_expr(g, p, src, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { collect_moved_expr(g, p, src, guard) }
            collect_moved_expr(g, p, src, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For: head sources/cond + body + else
        if e.op == 1 { collect_moved_expr(g, p, src, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                collect_moved_expr(g, p, src, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        collect_moved_block(g, p, src, e.b)
        if e.x >= 0 { collect_moved_block(g, p, src, e.x) }    // the else block
        return
    }
}

// The statement walk: a `let`'s bare-name init, a `return`'s bare-name value, and the block's
// bare-name tail expression all move; every subexpression is walked for take-args and captures.
fn collect_moved_block(mut g: Cg, read p: parser.Parser, read src: str, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    let n: i32 = blk.y
    var i: i32 = 0
    for i < n {
        let sid: i32 = list.get(i32, p.sar, (blk.x + i) as usize)
        let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        if s.kind == 0 and s.a >= 0 {
            mv_mark(g, p, s.a)
            collect_moved_expr(g, p, src, s.a)
        }
        if s.kind == 1 and s.a >= 0 {
            mv_mark(g, p, s.a)
            collect_moved_expr(g, p, src, s.a)
        }
        if s.kind == 2 {
            if i + 1 == n { mv_mark(g, p, s.a) }
            collect_moved_expr(g, p, src, s.a)
        }
        i = i + 1
    }
}

// The statement group threads `read c: typeck.Checker` (inferred-`let` types, type-directed
// lowering) and `mut g: Cg` (the temp counter). (`emit_expr` needs neither mutability nor `g` yet.)
// The SUCCESS return of a unit-fallible fn: `return (JestyrResult_unit){ .is_err = false };`.
// Mirrors `emit_value_return` on the reference side -- `ensures` postconditions and the
// scope's drops run exactly as they do for a written value return, which is why this is a
// helper and not two `string_push`es at each of its two call sites.
//
// `.is_err = false` alone: C zero-initializes every member a designated initializer omits,
// so `err` and the payload union are cleared without being named.
fn emit_unit_ok_return(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, depth: i32) {
    if list.len(i32, g.ens) > 0 or has_live_drops(g) {
        indent(sb, depth)
        emit_result_name(sb, p, src, c, g, g.res_ok)
        string_push(sb, " j_result = (")
        emit_result_name(sb, p, src, c, g, g.res_ok)
        string_push(sb, "){ .is_err = false };\n")
        var ei: usize = 0
        for ei < list.len(i32, g.ens) {
            let ene: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, g.ens, ei) as usize)
            cg_mark_line(sb, g, ene.start)
            indent(sb, depth)
            string_push(sb, "assert(")
            emit_expr(sb, p, src, c, g, list.get(i32, g.ens, ei))
            string_push(sb, ");\n")
            ei = ei + 1
        }
        emit_all_drops(sb, p, src, c, g, depth)
        line_at(sb, depth, "return j_result;")
        return
    }
    indent(sb, depth)
    string_push(sb, "return (")
    emit_result_name(sb, p, src, c, g, g.res_ok)
    string_push(sb, "){ .is_err = false };\n")
}

fn emit_return(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, val: i32, depth: i32) {
    if val < 0 {
        // A valueless `return` out of a UNIT-fallible fn is the success path and has to
        // construct the result struct -- a bare `return;` from a function whose C return
        // type is `JestyrResult_unit` is only a gcc WARNING, so it compiled and handed the
        // caller an indeterminate tag. `res_ok == -1` is exactly "fallible, no declared
        // return type"; `-2` is "not fallible" and keeps the bare `return;`.
        //
        // Scoped to unit deliberately: a valueless `return` out of a `-> T !E` has no `T`
        // to supply, so synthesizing a success there would manufacture a zero-valued OK.
        if g.res_ok == 0 - 1 {
            emit_unit_ok_return(sb, p, src, c, g, depth)
            return
        }
        emit_all_drops(sb, p, src, c, g, depth)          // drop every live local before returning
        line_at(sb, depth, "return;")
        return
    }
    // A control-flow value return dispatches to its block form (`return if …` becomes a C `if`).
    let v: parser.ExprData = list.get(parser.ExprData, p.ex, val as usize)
    if v.kind == 24 { emit_if(sb, p, src, c, g, val, true, depth)  return }      // If
    if v.kind == 28 { emit_match(sb, p, src, c, g, val, true, depth)  return }   // match
    if v.kind == 25 { emit_body(sb, p, src, c, g, v.a, true, depth)  return }    // return unsafe { … }
    if v.kind == 23 { emit_body(sb, p, src, c, g, val, true, depth)  return }    // return { … }
    if v.kind == 31 { emit_for(sb, p, src, c, g, val, depth)  return }           // a loop has no value:
                                                                                 // emit as a statement
    // `ensures` postconditions or live drops: spill the value to `j_result` *before* running
    // asserts/drops (so the value can't read a local we're about to drop), then return the spill.
    // Mirrors `emit_value_return`; a method body (`autoret`) has no tracked ret cty -> `__auto_type`.
    if list.len(i32, g.ens) > 0 or has_live_drops(g) {
        indent(sb, depth)
        if g.res_ok >= 0 - 1 { emit_result_name(sb, p, src, c, g, g.res_ok) }
        else if g.autoret { string_push(sb, "__auto_type") }
        else { emit_c_ty(sb, p, src, g.retty) }
        string_push(sb, " j_result = ")
        emit_expr(sb, p, src, c, g, val)
        string_push(sb, ";\n")
        var ei: usize = 0
        for ei < list.len(i32, g.ens) {
            // Point the postcondition's assert at the `ensures` clause.
            let ene: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, g.ens, ei) as usize)
            cg_mark_line(sb, g, ene.start)
            indent(sb, depth)
            string_push(sb, "assert(")
            emit_expr(sb, p, src, c, g, list.get(i32, g.ens, ei))
            string_push(sb, ");\n")
            ei = ei + 1
        }
        emit_all_drops(sb, p, src, c, g, depth)
        line_at(sb, depth, "return j_result;")
        return
    }
    indent(sb, depth)
    string_push(sb, "return ")
    emit_expr(sb, p, src, c, g, val)
    string_push(sb, ";\n")
}

// How many recorded newline offsets are strictly below `off` -- a binary search,
// NOT a scan from byte 0 (the recorded quadratic trap). `nl` is sorted.
fn nl_count_below(read nl: List(i32), off: i32) -> i32 {
    var lo: usize = 0
    var hi: usize = list.len(i32, nl)
    for lo < hi {
        let mid: usize = lo + (hi - lo) / 2
        if list.get(i32, nl, mid) < off { lo = mid + 1 } else { hi = mid }
    }
    return lo as i32
}

// Emit a C `#line <line> "<file>"` directive for the statement starting at merged
// offset `start` -- mirroring `Cgen::mark_line` exactly: resolve through the
// rewrite checkpoints to the original concatenation, find the owning module, count
// its 1-based line, dedup against the last directive, normalize `\` to `/`, write
// at column 0. A NO-OP when no debug table was supplied (`dbg_on`), which is every
// path except `jc build|run` -- the same gate that keeps the reference's
// single-file path byte-identical.
fn cg_mark_line(mut sb: String, mut g: Cg, start: usize) {
    if !g.dbg_on { return }
    var cm: i32 = 0 - 1                               // last checkpoint at or before `start`
    var co: i32 = 0 - 1
    var i: usize = 0
    for i < list.len(i32, g.dmap) / 2 {
        let mp: i32 = list.get(i32, g.dmap, i * 2)
        if mp as usize <= start {
            cm = mp
            co = list.get(i32, g.dmap, i * 2 + 1)
        }
        i = i + 1
    }
    if cm < 0 { return }
    let orig: i32 = co + ((start - (cm as usize)) as i32)
    var found: i32 = 0 - 1                            // the module owning `orig`
    var mi: usize = 0
    for mi < list.len(i32, g.dmods) / 6 {
        let ss: i32 = list.get(i32, g.dmods, mi * 6 + 4)
        let se: i32 = list.get(i32, g.dmods, mi * 6 + 5)
        if orig >= ss and orig <= se { found = mi as i32 }
        mi = mi + 1
    }
    if found < 0 { return }
    let mb: usize = (found as usize) * 6
    let ss2: i32 = list.get(i32, g.dmods, mb + 4)
    let line: i32 = nl_count_below(g.dnl, orig) - nl_count_below(g.dnl, ss2) + 1
    if g.dbgl_m == found and g.dbgl_l == line { return }
    g.dbgl_m = found
    g.dbgl_l = line
    string_push(sb, "#line ")
    push_uint(sb, line as i64)
    string_push(sb, " \"")
    let nbv: str = string_view(g.dnb)
    let ps: usize = list.get(i32, g.dmods, mb + 2) as usize
    let pe: usize = list.get(i32, g.dmods, mb + 3) as usize
    var k: usize = ps
    for k < pe {
        if (nbv[k] as i32) == 92 { string_push(sb, "/") } else { string_push(sb, nbv[k .. k + 1]) }
        k = k + 1
    }
    string_push(sb, "\"\n")
}

// The statement's span start for `#line` mapping, mirroring `Cgen::stmt_span`:
// an expression-statement uses its EXPRESSION's span; Let/Return carry their own.
fn stmt_mark_start(read p: parser.Parser, sid: i32) -> usize {
    let st: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
    if st.kind == 2 {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, st.a as usize)
        return e.start
    }
    return st.start
}

fn emit_stmt(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, sid: i32, depth: i32) {
    // Per-statement `#line` (deduped) -- lands at column 0, before this
    // statement's own indentation, exactly where the reference writes it.
    cg_mark_line(sb, g, stmt_mark_start(p, sid))
    let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
    if s.kind == 1 {                                  // Return
        emit_return(sb, p, src, c, g, s.a, depth)
        return
    }
    if s.kind == 2 {                                  // Expr statement
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
        if e.kind == 24 { emit_if(sb, p, src, c, g, s.a, false, depth)  return }   // If as a statement
        if e.kind == 28 { emit_match(sb, p, src, c, g, s.a, false, depth)  return } // match as a statement
        if e.kind == 31 { emit_for(sb, p, src, c, g, s.a, depth)  return }         // For as a statement
        if e.kind == 25 { emit_body(sb, p, src, c, g, e.a, false, depth)  return } // unsafe { … } block
        if e.kind == 23 { emit_body(sb, p, src, c, g, s.a, false, depth)  return } // bare { … } block
        if e.kind == 43 { emit_region(sb, p, src, c, g, s.a, depth)  return }      // region r { … }
        if e.kind == 46 { emit_with_alive(sb, p, src, c, g, s.a, depth)  return }  // with alive … { … }
        if e.kind == 38 { emit_concurrent(sb, p, src, c, g, s.a, depth)  return }  // concurrent { … }
        if e.kind == 42 { emit_select(sb, p, src, c, g, e, depth)  return }        // select { … }
        if e.kind == 39 and g.dspawn {                                             // spawn in a loop:
            emit_dyn_spawn(sb, p, src, c, g, e.a, depth)                           // dynamic-N push
            return
        }
        indent(sb, depth)
        emit_expr(sb, p, src, c, g, s.a)
        string_push(sb, ";\n")
        return
    }
    if s.kind == 0 {                                  // Let / var: `<cty> j_<name> [= <init>];`
        indent(sb, depth)
        // Annotated type (`ty` >= 0) renders from the annotation; an inferred `let x = <init>` reads
        // the Checker's per-expr type `c.et[init]`. `(x,y)` = name span; `ty` = annotation; `a` = init.
        if s.ty >= 0 {
            emit_su_ty(sb, p, src, c, g, s.ty)        // subst-aware: `var np: *mut T` in an instance
        } else if s.a >= 0 {
            // a closure-bound local takes the closure's concrete `{call, env}` struct type
            let ie: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
            if ie.kind == 37 and closure_index_of(g, s.a) >= 0 {
                string_push(sb, "JestyrClosure_")
                push_uint(sb, ref_expr_id(p, s.a) as i64)
            } else {
                emit_su_tyid(sb, p, src, c, g, list.get(i32, c.et, s.a as usize))
            }
        } else {
            string_push(sb, "int")                    // no annotation, no init (mirrors the reference)
        }
        string_push(sb, " j_")
        string_push(sb, src[s.x as usize .. s.y as usize])
        if s.a >= 0 {
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, s.a)
        }
        string_push(sb, ";\n")
        // Register the local for scope-exit drop glue *after* its declaration, so an earlier
        // `return` never references it. Mirrors `register_drop_local`.
        register_drop_local(g, p, src, c, s)
        return
    }
}

// A `{ … }` block: brace at `depth`, statements at `depth+1`, closing brace at `depth`. When `ret`,
// the tail statement is emitted as a `return` (an Expr tail becomes `return <expr>`, a Return tail
// stays `return <value>`). Mirrors `Cgen::emit_body`, drop scopes included: a diverging block
// (tail-as-return, or a trailing explicit `return`) already dropped, so its scope is discarded;
// a fall-through block drops its locals in reverse declaration order before the closing brace.
fn emit_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, block_eid: i32, ret: bool, depth: i32) {
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    // Pending droppable `take` params (armed per fn) join the ROOT drop scope before any
    // statement — drained here, once, so nested blocks find the list empty. Mirrors
    // `register_take_drops`; emits nothing, so requires-asserts below are unaffected.
    if list.len(i32, g.tkd) > 0 {
        var tk: usize = 0
        for tk < list.len(i32, g.tkd) {
            list.push(i32, g.ds, list.get(i32, g.tkd, tk))
            tk = tk + 1
        }
        list.truncate(i32, g.tkd, 0)
    }
    // Pending `requires` preconditions (armed per fn by emit_fn_defs) fire as asserts at the top
    // of the FN body only — consumed here so nested blocks don't re-emit them.
    if list.len(i32, g.req) > 0 {
        var qi: usize = 0
        for qi < list.len(i32, g.req) {
            // Point the precondition's assert at the `requires` clause itself.
            let rqe: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, g.req, qi) as usize)
            cg_mark_line(sb, g, rqe.start)
            indent(sb, depth + 1)
            string_push(sb, "assert(")
            emit_expr(sb, p, src, c, g, list.get(i32, g.req, qi))
            string_push(sb, ");\n")
            qi = qi + 1
        }
        list.truncate(i32, g.req, 0)
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, block_eid as usize)   // Block (kind 23)
    let n: i32 = blk.y                                // y = stmt_count
    var i: i32 = 0
    for i < n {
        let sid: i32 = list.get(i32, p.sar, (blk.x + i) as usize)   // x = stmt_start into sar
        let last: bool = i + 1 == n
        if last and ret {
            // The tail is emitted as a `return` directly (bypassing emit_stmt),
            // so map its line here, like the reference's tail arms do.
            cg_mark_line(sb, g, stmt_mark_start(p, sid))
            let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
            // **A tail EXPRESSION is not a return value when the ok type is unit.** `ret` is
            // true for a unit-fallible fn (its C return type is `JestyrResult_unit`), so
            // without this guard a body whose last statement is an ordinary one --
            // `l.synced = l.synced + 1` -- emitted `return l.synced + 1`, which gcc refuses.
            // The success return is synthesized below instead, after the statement runs.
            //
            // The condition is the same `depth == 0 and res_ok == -1` the unit-ok return
            // below uses, and it is spelled once here so the two cannot drift apart.
            let unit_tail: bool = depth == 0 and g.res_ok == 0 - 1
            if s.kind == 1 { emit_return(sb, p, src, c, g, s.a, depth + 1) }
            else if s.kind == 2 and unit_tail == false { emit_return(sb, p, src, c, g, s.a, depth + 1) }
            else { emit_stmt(sb, p, src, c, g, sid, depth + 1) }
        } else {
            emit_stmt(sb, p, src, c, g, sid, depth + 1)
        }
        i = i + 1
    }
    // Does the body already end in an explicit `return`? Read once, used twice below.
    var tail_ret: bool = false
    if n > 0 {
        let lsid0: i32 = list.get(i32, p.sar, (blk.x + n - 1) as usize)
        let ls0: parser.StmtData = list.get(parser.StmtData, p.st, lsid0 as usize)
        if ls0.kind == 1 { tail_ret = true }
    }
    // **Falling off the end of a unit-fallible fn means SUCCESS**, and it has to be
    // spelled: `fn f(..) !{ E } { if bad { return err(E) } }` is the natural way to write
    // a procedure that either fails early or completes, and it used to run off the end of
    // a function whose C return type is `JestyrResult_unit`.
    //
    // `depth == 0` is what makes this the FUNCTION's body and not a nested one. Every one
    // of the six `emit_body` call sites that opens a fn body passes a literal `0`, and
    // every nested body (an `if` branch, a block, a match arm) is reached through
    // `emit_stmt` at `depth + 1` -- so depth 0 is the outermost body by construction, the
    // same role the reference gives its one-shot `unit_tail` flag.
    //
    // `res_ok == -1` is exactly "fallible with no declared return type"; `-2` is "not
    // fallible". Well-defined only because the ok type is unit: there is no value to
    // invent. A `-> T !E` (or a plain `-> T`) falling off the end is a different,
    // pre-existing gap and is deliberately untouched.
    if depth == 0 and g.res_ok == 0 - 1 and tail_ret == false {
        emit_unit_ok_return(sb, p, src, c, g, depth + 1)
    }
    // `block_diverges`: `ret` (the tail was emitted as a return) or a trailing explicit `return`.
    var dv: bool = ret
    if tail_ret { dv = true }
    if dv { drop_scope_exit_discard(g) } else { drop_scope_exit_emit(sb, p, src, c, g, depth + 1) }
    line_at(sb, depth, "}")
}

// An `if (cond) { … } [else …]`. The If node (kind 24): `a`=cond, `b`=then Block, `op`=else
// (-1 none, else an `if` chain or a Block). The condition gets its own paren pair on top of any the
// expression itself adds (so `if n < 2` renders `if ((j_n < 2))`, matching the reference).
fn emit_if(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, ret: bool, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    indent(sb, depth)
    string_push(sb, "if (")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ")\n")
    emit_body(sb, p, src, c, g, e.b, ret, depth)
    if e.op >= 0 {
        line_at(sb, depth, "else")
        let els: parser.ExprData = list.get(parser.ExprData, p.ex, e.op as usize)
        if els.kind == 24 { emit_if(sb, p, src, c, g, e.op, ret, depth) }     // else if
        else { emit_body(sb, p, src, c, g, e.op, ret, depth) }               // else block
    }
}

// The body of a `match` arm: a `return <e>;` in return position, else the expression as a
// statement (with block/if forms recursing). Mirrors `emit_arm_body`.
fn emit_arm_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, ret: bool, depth: i32) {
    let bd: parser.ExprData = list.get(parser.ExprData, p.ex, body as usize)
    if ret {
        if bd.kind == 24 { emit_if(sb, p, src, c, g, body, true, depth)  return }
        if bd.kind == 28 { emit_match(sb, p, src, c, g, body, true, depth)  return }
        if bd.kind == 23 { emit_body(sb, p, src, c, g, body, true, depth)  return }
        emit_return(sb, p, src, c, g, body, depth)
        return
    }
    if bd.kind == 24 { emit_if(sb, p, src, c, g, body, false, depth)  return }
    if bd.kind == 28 { emit_match(sb, p, src, c, g, body, false, depth)  return }
    if bd.kind == 23 { emit_body(sb, p, src, c, g, body, false, depth)  return }
    indent(sb, depth)
    emit_expr(sb, p, src, c, g, body)
    string_push(sb, ";\n")
}

// A `match` on a tagged enum -> `<cty> jm_{n} = <scrut>; switch (jm_{n}.tag) { case … }`. Each arm
// binds any payload fields (`<fcty> j_<b> = jm_{n}.u.<v>.j_<field>;`) then runs its body; a non-
// return arm ends with `break;`. An exhaustive return-position match closes with
// `__builtin_unreachable();`. Mirrors `emit_match` (flat, unguarded path). Guards/nesting/niche and
// scalar (int/char/bool) scrutinees are deferred (added when a corpus file needs them).
// ---- the niche optimization (mirrors `NicheInfo`/`niche_enum_at`/`niche_enum_instance`/
// `emit_niche_match`): an enum with exactly one nullary variant and one single THIN-pointer
// variant (`*T` / `&[r]T` — a fat `&T` or slice does NOT qualify) is represented as JUST that
// pointer; the nullary variant is NULL. Zero tag, zero padding. ----

// The some-variant 5-tuple base of NON-generic enum item `eit` iff niche-shaped (its payload
// field written as a plain pointer type in the AST), else -1. Mirrors `niche_enum_at`.
fn niche_named_some(read p: parser.Parser, eit: i32) -> i32 {
    if eit < 0 { return 0 - 1 }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
    if it.kind != 5 { return 0 - 1 }
    if it.a != 0 { return 0 - 1 }
    if it.z != 2 { return 0 - 1 }
    var none_seen: bool = false
    var some_vb: i32 = 0 - 1
    var k: i32 = 0
    for k < 2 {
        let vb: i32 = it.b + k * 5
        let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
        if fc == 0 { none_seen = true }
        else if fc == 1 {
            let fty: i32 = list.get(i32, p.ear, (list.get(i32, p.ear, (vb + 2) as usize) + 2) as usize)
            if fty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                if t.kind == 2 or t.kind == 6 { some_vb = vb }
            }
        }
        k = k + 1
    }
    if !none_seen { return 0 - 1 }
    return some_vb
}

// The SUBSTITUTED payload TyId of instance `tid`'s 1-field variant at `vb` iff a plain
// pointer (Checker kind 3 Ptr / 11 RegionRef), else -1. (Corpus shape: the field is a bare
// tparam Name — `some(v: T)` with `T = *i32`; a structural `*T` field is a later increment.)
fn niche_inst_pay(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32, vb: i32) -> i32 {
    let eit: i32 = genum_item_of(p, src, c, tid)
    if eit < 0 { return 0 - 1 }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
    let fty: i32 = list.get(i32, p.ear, (list.get(i32, p.ear, (vb + 2) as usize) + 2) as usize)
    if fty < 0 { return 0 - 1 }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
    if t.kind != 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    var k: i32 = 0
    for k < it.a {                                    // tparam name-span pairs in ear at it.op
        let tps: i32 = list.get(i32, p.ear, (it.op + k * 2) as usize)
        let tpe: i32 = list.get(i32, p.ear, (it.op + k * 2 + 1) as usize)
        if str_eq(src[t.start .. t.end], src[tps as usize .. tpe as usize]) {
            if k < d.b {
                let arg: i32 = list.get(i32, c.tya, (d.a + k) as usize)
                let ad: typeck.TyData = list.get(typeck.TyData, c.tys, arg as usize)
                if ad.kind == 3 or ad.kind == 11 { return arg }
            }
            return 0 - 1
        }
        k = k + 1
    }
    return 0 - 1
}

// The some-variant 5-tuple base of a kind-6 generic-enum instance iff niche, else -1.
// Mirrors `niche_enum_instance` (`Option(*T)` inherits the optimization automatically).
fn niche_inst_some(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> i32 {
    let eit: i32 = genum_item_of(p, src, c, tid)
    if eit < 0 { return 0 - 1 }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
    if it.z != 2 { return 0 - 1 }
    var none_seen: bool = false
    var some_vb: i32 = 0 - 1
    var k: i32 = 0
    for k < 2 {
        let vb: i32 = it.b + k * 5
        let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
        if fc == 0 { none_seen = true }
        else if fc == 1 {
            if niche_inst_pay(p, src, c, tid, vb) >= 0 { some_vb = vb }
        }
        k = k + 1
    }
    if !none_seen { return 0 - 1 }
    return some_vb
}

// Niche info for a Checker type: the some-variant tuple base, or -1 (kind 15 Named by its own
// AST shape; kind 6 by the instance's substitution). Mirrors `niche_of_ty`.
fn niche_of_tyid(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> i32 {
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 15 {
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        return niche_named_some(p, find_enum_item(p, src, ns as usize, ne as usize))
    }
    if d.kind == 6 { return niche_inst_some(p, src, c, tid) }
    return 0 - 1
}

// The niche payload C type of `tid` (named -> the AST field type; instance -> the
// substituted arg's Checker type).
fn emit_niche_pay_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32, some_vb: i32) {
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 15 {
        let fty: i32 = list.get(i32, p.ear, (list.get(i32, p.ear, (some_vb + 2) as usize) + 2) as usize)
        emit_c_ty(sb, p, src, fty)
        return
    }
    emit_ty_c(sb, p, src, c, niche_inst_pay(p, src, c, tid, some_vb))
}

// The AST payload TypeId of a niche `Ctor(args)` APPLICATION type (`Option(*mut i32)` as an
// annotation), or -1: the enum's 1-field variant is a bare tparam Name and the matching App
// arg is a plain-pointer AST type.
fn niche_app_pay(read p: parser.Parser, read src: str, read t: parser.TypeData) -> i32 {
    var eit: i32 = 0 - 1
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let cand: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if cand.kind == 5 and cand.a > 0 {
            if str_eq(src[cand.x .. cand.y], src[t.x as usize .. t.y as usize]) { eit = iid }
        }
        r = r + 1
    }
    if eit < 0 { return 0 - 1 }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
    if it.z != 2 { return 0 - 1 }
    var none_seen: bool = false
    var pay: i32 = 0 - 1
    var k: i32 = 0
    for k < 2 {
        let vb: i32 = it.b + k * 5
        let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
        if fc == 0 { none_seen = true }
        else if fc == 1 {
            let fty: i32 = list.get(i32, p.ear, (list.get(i32, p.ear, (vb + 2) as usize) + 2) as usize)
            if fty >= 0 {
                let ft: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                if ft.kind == 0 {
                    var tp: i32 = 0
                    for tp < it.a {
                        let tps: i32 = list.get(i32, p.ear, (it.op + tp * 2) as usize)
                        let tpe: i32 = list.get(i32, p.ear, (it.op + tp * 2 + 1) as usize)
                        if str_eq(src[ft.start .. ft.end], src[tps as usize .. tpe as usize]) {
                            if tp < t.a {
                                let arg: i32 = list.get(i32, p.tar, (t.op + tp) as usize)
                                let at: parser.TypeData = list.get(parser.TypeData, p.ty, arg as usize)
                                if at.kind == 2 or at.kind == 6 { pay = arg }
                            }
                        }
                        tp = tp + 1
                    }
                }
            }
        }
        k = k + 1
    }
    if !none_seen { return 0 - 1 }
    return pay
}

// A `match` on a niche enum: a null test, not a tag switch (ONE temp). Arms classify into
// some (variant pat naming the some variant, optional Ident subpat binding), none (a bare
// Ident naming the nullary variant), and a wildcard/binding catch-all. Mirrors
// `emit_niche_match` (the guarded counterpart is a later increment).
fn emit_niche_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, stid: i32, some_vb: i32, ret: bool, depth: i32) {
    // the scrutinee emits FIRST (its own temps number before the match temp — reference order)
    var scr: String = string_new()
    emit_expr(scr, p, src, c, g, e.a)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    var pay: String = string_new()
    emit_niche_pay_c(pay, p, src, c, stid, some_vb)
    let sns: i32 = list.get(i32, p.ear, some_vb as usize)
    let sne: i32 = list.get(i32, p.ear, (some_vb + 1) as usize)
    // the none variant is the some variant's sibling (a niche enum has exactly two)
    var neit: i32 = 0 - 1
    let sd9: typeck.TyData = list.get(typeck.TyData, c.tys, stid as usize)
    if sd9.kind == 15 {
        let ens9: i32 = list.get(i32, c.tdecl, (sd9.x * 10 + 0) as usize)
        let ene9: i32 = list.get(i32, c.tdecl, (sd9.x * 10 + 1) as usize)
        neit = find_enum_item(p, src, ens9 as usize, ene9 as usize)
    } else {
        neit = genum_item_of(p, src, c, stid)
    }
    let nit9: parser.ItemData = list.get(parser.ItemData, p.it, neit as usize)
    var none_vb: i32 = nit9.b
    if none_vb == some_vb { none_vb = nit9.b + 5 }
    let nns: i32 = list.get(i32, p.ear, none_vb as usize)
    let nne: i32 = list.get(i32, p.ear, (none_vb + 1) as usize)
    indent(sb, depth)
    string_push(sb, string_view(pay))
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(scr))
    string_push(sb, ";\n")
    string_free(scr)
    // classify the arms
    var some_body: i32 = 0 - 1
    var some_bns: i32 = 0 - 1
    var some_bne: i32 = 0 - 1
    var none_body: i32 = 0 - 1
    var def_body: i32 = 0 - 1
    var def_bns: i32 = 0 - 1
    var def_bne: i32 = 0 - 1
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        if pd.kind == 2 and str_eq(src[pd.x as usize .. pd.y as usize], src[sns as usize .. sne as usize]) {
            some_body = body
            if pd.a > 0 {
                let sp: i32 = list.get(i32, p.par, pd.op as usize)
                let spd: parser.PatData = list.get(parser.PatData, p.pt, sp as usize)
                if spd.kind == 1 { some_bns = spd.start as i32  some_bne = spd.end as i32 }
            }
        } else if pd.kind == 1 {
            // a bare Ident naming the NONE variant is the none arm; any other Ident binds
            if str_eq(src[pd.start .. pd.end], src[nns as usize .. nne as usize]) { none_body = body }
            else { def_body = body  def_bns = pd.start as i32  def_bne = pd.end as i32 }
        } else if pd.kind == 0 {
            def_body = body
            def_bns = 0 - 1
            def_bne = 0 - 1
        }
        k = k + 1
    }
    indent(sb, depth)
    string_push(sb, "if (jm_")
    push_uint(sb, n as i64)
    string_push(sb, " != ((")
    string_push(sb, string_view(pay))
    string_push(sb, ")0))\n")
    line_at(sb, depth, "{")
    var sb2: i32 = some_body
    var bns: i32 = some_bns
    var bne: i32 = some_bne
    if sb2 < 0 { sb2 = def_body  bns = def_bns  bne = def_bne }
    if sb2 >= 0 {
        if bns >= 0 {
            indent(sb, depth + 1)
            string_push(sb, string_view(pay))
            string_push(sb, " j_")
            string_push(sb, src[bns as usize .. bne as usize])
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
        emit_arm_body(sb, p, src, c, g, sb2, ret, depth + 1)
    }
    line_at(sb, depth, "}")
    line_at(sb, depth, "else")
    line_at(sb, depth, "{")
    if none_body >= 0 {
        emit_arm_body(sb, p, src, c, g, none_body, ret, depth + 1)
    } else if def_body >= 0 {
        if def_bns >= 0 {
            indent(sb, depth + 1)
            string_push(sb, string_view(pay))
            string_push(sb, " j_")
            string_push(sb, src[def_bns as usize .. def_bne as usize])
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
        emit_arm_body(sb, p, src, c, g, def_body, ret, depth + 1)
    }
    line_at(sb, depth, "}")
    string_free(pay)
}

// ---- nested / struct-variant match (mirrors `pat_needs_nesting`/`pat_test`/
// `emit_nested_match`): a constructor inside a variant's fields — or any struct-variant
// pattern — needs the recursive decision-tree lowering (an ordered if-chain of pattern
// tests, auto-dereferencing pointer fields to look through `indirect` recursion). ----

// Is this pattern a constructor (something that TESTS rather than just binds)?
fn pat_is_ctor(read p: parser.Parser, read src: str, pat: i32) -> bool {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
    if pd.kind == 2 or pd.kind == 3 or pd.kind == 4 or pd.kind == 5 { return true }
    if pd.kind == 1 { return find_variant_enum(p, src, pd.start, pd.end) >= 0 }
    if pd.kind == 6 {
        var i: i32 = 0
        for i < pd.a {
            if pat_is_ctor(p, src, list.get(i32, p.par, (pd.op + i) as usize)) { return true }
            i = i + 1
        }
    }
    return false
}

fn is_flat_subpat(read p: parser.Parser, read src: str, sp: i32) -> bool {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, sp as usize)
    if pd.kind == 0 or pd.kind == 7 { return true }   // wildcard / rest
    if pd.kind == 1 { return find_variant_enum(p, src, pd.start, pd.end) < 0 }   // a binding
    return false
}

fn pat_needs_nesting(read p: parser.Parser, read src: str, pat: i32) -> bool {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
    if pd.kind == 2 {                                 // Variant: any non-flat subpat
        var i: i32 = 0
        for i < pd.a {
            if !is_flat_subpat(p, src, list.get(i32, p.par, (pd.op + i) as usize)) { return true }
            i = i + 1
        }
        return false
    }
    if pd.kind == 3 { return true }                   // a struct-variant pattern is always recursive
    if pd.kind == 6 {
        var i: i32 = 0
        for i < pd.a {
            if pat_needs_nesting(p, src, list.get(i32, p.par, (pd.op + i) as usize)) { return true }
            i = i + 1
        }
    }
    return false
}

// The recursive pattern test: appends the C boolean for `pat` against `subject` (C type
// `scty`, enum item `eit` or -1) to `tst` ("1" = irrefutable) and any binding declarations
// (unindented `;\n`-terminated lines) to `bnd`. Mirrors `pat_test`.
fn pat_test(mut tst: String, mut bnd: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read subject: str, read scty: str, eit: i32, pat: i32) {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
    if pd.kind == 0 or pd.kind == 7 or pd.kind == 8 { string_push(tst, "1")  return }
    if pd.kind == 1 {
        if find_variant_enum(p, src, pd.start, pd.end) >= 0 {   // a nullary variant: tag test
            let enn: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
            string_push(tst, subject)
            string_push(tst, ".tag == Jestyr_")
            string_push(tst, src[enn.x .. enn.y])
            string_push(tst, "_")
            string_push(tst, src[pd.start .. pd.end])
            return
        }
        string_push(tst, "1")                         // a binding
        string_push(bnd, scty)
        string_push(bnd, " j_")
        string_push(bnd, src[pd.start .. pd.end])
        string_push(bnd, " = ")
        string_push(bnd, subject)
        string_push(bnd, ";\n")
        return
    }
    if pd.kind == 4 {                                 // literal
        string_push(tst, subject)
        string_push(tst, " == (")
        emit_expr(tst, p, src, c, g, pd.a)
        string_push(tst, ")")
        return
    }
    if pd.kind == 5 {                                 // range
        string_push(tst, subject)
        string_push(tst, " >= (")
        emit_expr(tst, p, src, c, g, pd.a)
        string_push(tst, ") && ")
        string_push(tst, subject)
        if pd.op == 1 { string_push(tst, " <= (") } else { string_push(tst, " < (") }
        emit_expr(tst, p, src, c, g, pd.b)
        string_push(tst, ")")
        return
    }
    if pd.kind == 6 {                                 // or-pattern: OR of alternatives (no binds)
        var i: i32 = 0
        for i < pd.a {
            if i > 0 { string_push(tst, " || ") }
            string_push(tst, "(")
            var dummy: String = string_new()
            pat_test(tst, dummy, p, src, c, g, subject, scty, eit, list.get(i32, p.par, (pd.op + i) as usize))
            string_free(dummy)
            string_push(tst, ")")
            i = i + 1
        }
        return
    }
    if pd.kind == 2 or pd.kind == 3 {                 // variant / struct-variant
        let vname: str = src[pd.x as usize .. pd.y as usize]
        let enn: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
        string_push(tst, subject)
        string_push(tst, ".tag == Jestyr_")
        string_push(tst, src[enn.x .. enn.y])
        string_push(tst, "_")
        string_push(tst, vname)
        let vb: i32 = variant_tuple(p, src, eit, pd.x as usize, pd.y as usize)
        if vb < 0 { return }
        let fstart: i32 = list.get(i32, p.ear, (vb + 2) as usize)
        let fcount: i32 = list.get(i32, p.ear, (vb + 3) as usize)
        var i: i32 = 0
        for i < pd.a {
            var sub: i32 = 0 - 1
            var fb: i32 = 0 - 1
            if pd.kind == 2 {                         // positional: field i
                sub = list.get(i32, p.par, (pd.op + i) as usize)
                let spd0: parser.PatData = list.get(parser.PatData, p.pt, sub as usize)
                if spd0.kind == 7 { i = pd.a  continue }   // trailing `..` stops the walk
                fb = fstart + i * 3
            } else {                                  // by NAME: find the decl field
                let pfns: i32 = list.get(i32, p.par, (pd.op + i * 3) as usize)
                let pfne: i32 = list.get(i32, p.par, (pd.op + i * 3 + 1) as usize)
                sub = list.get(i32, p.par, (pd.op + i * 3 + 2) as usize)
                var f2: i32 = 0
                for f2 < fcount {
                    let dfns: i32 = list.get(i32, p.ear, (fstart + f2 * 3) as usize)
                    let dfne: i32 = list.get(i32, p.ear, (fstart + f2 * 3 + 1) as usize)
                    if str_eq(src[pfns as usize .. pfne as usize], src[dfns as usize .. dfne as usize]) { fb = fstart + f2 * 3 }
                    f2 = f2 + 1
                }
            }
            if fb >= 0 and (pd.kind == 3 or i < fcount) {
                let fns: i32 = list.get(i32, p.ear, fb as usize)
                let fne: i32 = list.get(i32, p.ear, (fb + 1) as usize)
                var fty: i32 = list.get(i32, p.ear, (fb + 2) as usize)
                var fpath: String = string_new()
                string_push(fpath, subject)
                string_push(fpath, ".u.")
                string_push(fpath, vname)
                string_push(fpath, ".j_")
                string_push(fpath, src[fns as usize .. fne as usize])
                // auto-deref: a constructor pattern against a pointer field looks THROUGH it
                var deref: bool = false
                if pat_is_ctor(p, src, sub) and fty >= 0 {
                    let ftd: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                    if ftd.kind == 2 or ftd.kind == 6 { deref = true  fty = ftd.a }
                }
                var subj2: String = string_new()
                if deref {
                    string_push(subj2, "(*")
                    string_push(subj2, string_view(fpath))
                    string_push(subj2, ")")
                } else {
                    string_push(subj2, string_view(fpath))
                }
                var scty2: String = string_new()
                emit_c_ty(scty2, p, src, fty)
                var eit2: i32 = 0 - 1
                if fty >= 0 {
                    let ftd2: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                    if ftd2.kind == 0 { eit2 = find_enum_item(p, src, ftd2.start, ftd2.end) }
                }
                var sub_t: String = string_new()
                pat_test(sub_t, bnd, p, src, c, g, string_view(subj2), string_view(scty2), eit2, sub)
                if !str_eq(string_view(sub_t), "1") {
                    string_push(tst, " && ")
                    string_push(tst, string_view(sub_t))
                }
                string_free(sub_t)
                string_free(scty2)
                string_free(subj2)
                string_free(fpath)
            }
            i = i + 1
        }
        return
    }
}

// A `match` with nested / struct-variant patterns: an ordered if-chain of recursive tests
// (TWO temps: scrutinee + end label — the scrutinee expr emits FIRST, so its own temps
// number before them). Mirrors `emit_nested_match`.
fn emit_nested_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, stid: i32, ret: bool, depth: i32) {
    var scrut: String = string_new()
    emit_expr(scrut, p, src, c, g, e.a)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let nend: i32 = g.tmp
    g.tmp = g.tmp + 1
    var scty: String = string_new()
    emit_ty_c(scty, p, src, c, stid)
    var eit: i32 = 0 - 1
    let row: i32 = expr_enum_row(c, e.a)
    if row >= 0 {
        let ens: i32 = list.get(i32, c.tdecl, (row * 10 + 0) as usize)
        let ene: i32 = list.get(i32, c.tdecl, (row * 10 + 1) as usize)
        eit = find_enum_item(p, src, ens as usize, ene as usize)
    }
    var subj: String = string_new()
    string_push(subj, "jm_")
    push_uint(subj, n as i64)
    indent(sb, depth)
    string_push(sb, string_view(scty))
    string_push(sb, " ")
    string_push(sb, string_view(subj))
    string_push(sb, " = ")
    string_push(sb, string_view(scrut))
    string_push(sb, ";\n")
    var has_uncond: bool = false
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        var tst: String = string_new()
        var bnd: String = string_new()
        pat_test(tst, bnd, p, src, c, g, string_view(subj), string_view(scty), eit, pat)
        let uncond: bool = str_eq(string_view(tst), "1")
        if uncond and guard < 0 { has_uncond = true }
        if uncond {
            line_at(sb, depth, "{")
        } else {
            indent(sb, depth)
            string_push(sb, "if (")
            string_push(sb, string_view(tst))
            string_push(sb, ")\n")
            line_at(sb, depth, "{")
        }
        // binding lines, each at depth+1
        var bi: usize = 0
        let bv: str = string_view(bnd)
        var lstart: usize = 0
        for bi < bv.len {
            if (bv[bi] as i32) == 10 {                // '\n' — one binding line per newline
                indent(sb, depth + 1)
                string_push(sb, bv[lstart .. bi])
                string_push(sb, "\n")
                lstart = bi + 1
            }
            bi = bi + 1
        }
        emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
        line_at(sb, depth, "}")
        string_free(tst)
        string_free(bnd)
        k = k + 1
    }
    if !ret {
        indent(sb, depth)
        string_push(sb, "jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ": ;\n")
    } else if !has_uncond {
        line_at(sb, depth, "__builtin_unreachable();")
    }
    string_free(subj)
    string_free(scty)
    string_free(scrut)
}

fn emit_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, ret: bool, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let scrut: i32 = e.a
    // Resolve the scrutinee's enum: a plain Named enum or a generic-enum instance. `pfx` is the
    // shared C name — both the scrutinee's C type and the tag/case prefix.
    let stid: i32 = list.get(i32, c.et, scrut as usize)
    if stid >= 0 {
        // A nested sub-pattern (or struct-variant pattern) needs the recursive decision tree.
        var needs_nest: bool = false
        var kn: i32 = 0
        for kn < e.y {
            if pat_needs_nesting(p, src, list.get(i32, p.par, (e.x + kn * 3) as usize)) { needs_nest = true }
            kn = kn + 1
        }
        if needs_nest {
            emit_nested_match(sb, p, src, c, g, e, stid, ret, depth)
            return
        }
        // A niche-optimized enum (plain or a generic instance) matches on a null test.
        let nvb: i32 = niche_of_tyid(p, src, c, stid)
        if nvb >= 0 {
            emit_niche_match(sb, p, src, c, g, e, stid, nvb, ret, depth)
            return
        }
        let sd0: typeck.TyData = list.get(typeck.TyData, c.tys, stid as usize)
        if sd0.kind == 2 and (sd0.x <= 9 or sd0.x == 12 or sd0.x == 13) {   // int/bool/char scrutinee
            emit_scalar_match(sb, p, src, c, g, e, stid, ret, depth)
            return
        }
    }
    var inst: i32 = 0 - 1
    var enum_iid: i32 = 0 - 1
    let row: i32 = expr_enum_row(c, scrut)
    var pfx: String = string_new()
    if row >= 0 {
        let ens: i32 = list.get(i32, c.tdecl, (row * 10 + 0) as usize)
        let ene: i32 = list.get(i32, c.tdecl, (row * 10 + 1) as usize)
        enum_iid = find_enum_item(p, src, ens as usize, ene as usize)
        string_push(pfx, "Jestyr_")
        string_push(pfx, src[ens as usize .. ene as usize])
    } else {
        enum_iid = genum_item_of_su(p, src, c, g, stid)
        inst = stid
        emit_su_tyid(pfx, p, src, c, g, stid)
        if enum_iid < 0 {                             // neither a local enum nor a local generic
            string_free(pfx)                          // instance (an import-degenerate scrutinee):
            return                                    // the reference diags and emits NOTHING
        }
    }
    // Any guarded arm forces the ordered-if-chain lowering (a C switch cannot stack two cases on
    // one tag nor fall through on a false guard).
    var guarded: bool = false
    var ks: i32 = 0
    for ks < e.y {
        if list.get(i32, p.par, (e.x + ks * 3 + 1) as usize) >= 0 { guarded = true }
        ks = ks + 1
    }
    if guarded {
        emit_guarded_match(sb, p, src, c, g, e, enum_iid, inst, string_view(pfx), ret, depth)
        string_free(pfx)
        return
    }
    // the scrutinee emits FIRST (its own temps number before the match temp --
    // reference order; latent until a scrutinee that CONSUMES temps existed,
    // e.g. `match node.*.prev` through a genref deref)
    var scr0: String = string_new()
    emit_expr(scr0, p, src, c, g, scrut)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, string_view(pfx))
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(scr0))
    string_free(scr0)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "switch (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag)\n")
    line_at(sb, depth, "{")
    let cd: i32 = depth + 1                            // case labels sit one level in from the switch
    var has_default: bool = false
    // Arm bodies live inside the C `switch`: a plain `break` in them must route through the
    // loop's `__break` label, never lower to a C `break` (mirrors `in_switch`).
    let ssw: bool = g.sw
    g.sw = true
    var k: i32 = 0
    for k < e.y {                                     // e.x = arm_start, e.y = arm_count (triples in par)
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        if pd.kind == 2 {                             // Variant `v(subpats)`
            let vname: str = src[pd.x as usize .. pd.y as usize]
            indent(sb, cd)
            string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ":\n")
            line_at(sb, cd, "{")
            emit_variant_bindings(sb, p, src, c, enum_iid, inst, n, vname, pd, cd + 1)
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 1 and find_variant_enum(p, src, pd.start, pd.end) >= 0 {   // nullary variant
            let vname: str = src[pd.start .. pd.end]
            indent(sb, cd)
            string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ":\n")
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 1 {                      // binding catch-all (binds whole scrutinee)
            has_default = true
            line_at(sb, cd, "default:")
            line_at(sb, cd, "{")
            indent(sb, cd + 1)
            string_push(sb, string_view(pfx))  string_push(sb, " j_")  string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")  push_uint(sb, n as i64)  string_push(sb, ";\n")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 0 {                      // wildcard `_`
            has_default = true
            line_at(sb, cd, "default:")
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 6 {                      // or-pattern of nullary variants: stacked cases
            var oi: i32 = 0
            for oi < pd.a {                           // (op,a) = alternative PatIds in par
                let alt: i32 = list.get(i32, p.par, (pd.op + oi) as usize)
                let ad: parser.PatData = list.get(parser.PatData, p.pt, alt as usize)
                indent(sb, cd)
                string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")
                string_push(sb, src[ad.start .. ad.end])
                string_push(sb, ":\n")
                oi = oi + 1
            }
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        }
        k = k + 1
    }
    g.sw = ssw
    line_at(sb, depth, "}")
    if ret and !has_default { line_at(sb, depth, "__builtin_unreachable();") }
    string_free(pfx)
}

// A `match` on a scalar (int/char/bool) scrutinee -> an ordered if-chain on the VALUE (there is
// no tag to switch on); mirrors `emit_scalar_match`. Each arm: `if (<cond>) { [bind;] body }`
// with the guard machinery shared with the enum chain; consumes TWO temps (value + end label).
fn emit_scalar_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, stid: i32, ret: bool, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let nend: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_ty_c(sb, p, src, c, stid)
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ";\n")
    var has_uncond_default: bool = false
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        var cond: String = string_new()
        let has_cond: bool = scalar_pat_cond(cond, p, src, c, g, pat, n)
        if !has_cond and guard < 0 { has_uncond_default = true }
        if has_cond {
            indent(sb, depth)
            string_push(sb, "if (")
            string_push(sb, string_view(cond))
            string_push(sb, ")\n")
        }
        line_at(sb, depth, "{")
        if pd.kind == 1 {                             // a bare name binds the scrutinee value
            indent(sb, depth + 1)
            emit_ty_c(sb, p, src, c, stid)
            string_push(sb, " j_")
            string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
        emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
        line_at(sb, depth, "}")
        string_free(cond)
        k = k + 1
    }
    if !ret {
        indent(sb, depth)
        string_push(sb, "jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ": ;\n")
    } else if !has_uncond_default {
        line_at(sb, depth, "__builtin_unreachable();")
    }
}

// The C value test of a scalar pattern against `jm_{n}`, written into `cond`; false = the
// pattern matches everything (wildcard/binding). Mirrors `scalar_pat_cond`: a literal tests
// equality, a range tests bounds, an or-pattern ORs its alternatives (each parenthesized;
// an alternative that matches everything makes the whole pattern unconditional).
fn scalar_pat_cond(mut cond: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, pat: i32, n: i32) -> bool {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
    if pd.kind == 4 {                                 // Lit: a = the literal ExprId
        string_push(cond, "jm_")
        push_uint(cond, n as i64)
        string_push(cond, " == (")
        emit_expr(cond, p, src, c, g, pd.a)
        string_push(cond, ")")
        return true
    }
    if pd.kind == 5 {                                 // Range: a=lo, b=hi, op=inclusive
        string_push(cond, "jm_")
        push_uint(cond, n as i64)
        string_push(cond, " >= (")
        emit_expr(cond, p, src, c, g, pd.a)
        string_push(cond, ") && jm_")
        push_uint(cond, n as i64)
        if pd.op == 1 { string_push(cond, " <= (") } else { string_push(cond, " < (") }
        emit_expr(cond, p, src, c, g, pd.b)
        string_push(cond, ")")
        return true
    }
    if pd.kind == 6 {                                 // Or: (op,a) = alternative PatIds in par
        var i: i32 = 0
        for i < pd.a {
            var alt: String = string_new()
            if !scalar_pat_cond(alt, p, src, c, g, list.get(i32, p.par, (pd.op + i) as usize), n) {
                string_free(alt)
                return false                          // an alternative matches everything
            }
            if i > 0 { string_push(cond, " || ") }
            string_push(cond, "(")
            string_push(cond, string_view(alt))
            string_push(cond, ")")
            string_free(alt)
            i = i + 1
        }
        return true
    }
    return false                                      // wildcard / binding catch-all
}

// A `match` with at least one guarded arm -> an ordered if-chain (mirrors `emit_guarded_match`):
// per arm `if (jm_{n}.tag == <pfx>_<v>) { bind; [if (guard)] { body } }`. A false guard falls
// through to the NEXT arm's tag re-test. Statement position gotos a shared `jm_end_{n+1}` label;
// return position relies on the bodies' returns and closes with `__builtin_unreachable()` unless
// an unguarded catch-all exists. Consumes TWO temps (scrutinee + end label), like the reference.
fn emit_guarded_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, enum_iid: i32, inst: i32, read pfx: str, ret: bool, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let nend: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, pfx)
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ";\n")
    var has_uncond_default: bool = false
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        if pd.kind == 2 {                             // Variant `v(subpats)`
            let vname: str = src[pd.x as usize .. pd.y as usize]
            indent(sb, depth)
            string_push(sb, "if (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag == ")
            string_push(sb, pfx)  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ")\n")
            line_at(sb, depth, "{")
            emit_variant_bindings(sb, p, src, c, enum_iid, inst, n, vname, pd, depth + 1)
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 1 and find_variant_enum(p, src, pd.start, pd.end) >= 0 {   // nullary variant
            indent(sb, depth)
            string_push(sb, "if (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag == ")
            string_push(sb, pfx)  string_push(sb, "_")  string_push(sb, src[pd.start .. pd.end])  string_push(sb, ")\n")
            line_at(sb, depth, "{")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 1 {                      // binding catch-all
            if guard < 0 { has_uncond_default = true }
            line_at(sb, depth, "{")
            indent(sb, depth + 1)
            string_push(sb, pfx)  string_push(sb, " j_")  string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")  push_uint(sb, n as i64)  string_push(sb, ";\n")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 0 {                      // wildcard `_`
            if guard < 0 { has_uncond_default = true }
            line_at(sb, depth, "{")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        }
        k = k + 1
    }
    if !ret {
        indent(sb, depth)
        string_push(sb, "jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ": ;\n")
    } else if !has_uncond_default {
        line_at(sb, depth, "__builtin_unreachable();")
    }
}

// One arm of a guarded chain: gate the body on the guard if present; in statement position a
// fired arm leaves the chain via `goto jm_end_{nend};` (mirrors `emit_guarded_arm`).
fn emit_guarded_arm(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, guard: i32, ret: bool, nend: i32, depth: i32) {
    if guard >= 0 {
        indent(sb, depth)
        string_push(sb, "if (")
        emit_expr(sb, p, src, c, g, guard)
        string_push(sb, ")\n")
        line_at(sb, depth, "{")
        emit_arm_body(sb, p, src, c, g, body, ret, depth + 1)
        if !ret {
            indent(sb, depth + 1)
            string_push(sb, "goto jm_end_")
            push_uint(sb, nend as i64)
            string_push(sb, ";\n")
        }
        line_at(sb, depth, "}")
        return
    }
    emit_arm_body(sb, p, src, c, g, body, ret, depth)
    if !ret {
        indent(sb, depth)
        string_push(sb, "goto jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ";\n")
    }
}

// Emit a Variant pattern's payload bindings: for each Ident subpat, project the matching field
// `<fcty> j_<bind> = jm_{n}.u.<vname>.j_<fieldname>;` — the field C type runs through the
// instance substitution when the scrutinee is a generic-enum instance (`inst` = its TyId, -1 for
// a plain enum). Wildcard/rest subpats project nothing.
fn emit_variant_bindings(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, enum_iid: i32, inst: i32, n: i32, read vname: str, read pd: parser.PatData, depth: i32) {
    let vb: i32 = variant_tuple(p, src, enum_iid, pd.x as usize, pd.y as usize)
    if vb < 0 { return }
    let fstart: i32 = list.get(i32, p.ear, (vb + 2) as usize)   // field 3-tuple base
    var i: i32 = 0
    for i < pd.a {                                    // (op,a) = subpat slice in par
        let sp: i32 = list.get(i32, p.par, (pd.op + i) as usize)
        let spd: parser.PatData = list.get(parser.PatData, p.pt, sp as usize)
        if spd.kind == 1 {                            // an Ident binding projects field i
            let fb: i32 = fstart + i * 3
            indent(sb, depth)
            emit_field_ty_subst(sb, p, src, c, list.get(i32, p.ear, (fb + 2) as usize), enum_iid, inst)
            string_push(sb, " j_")
            string_push(sb, src[spd.start .. spd.end])   // binding name
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ".u.")
            string_push(sb, vname)
            string_push(sb, ".j_")
            string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])   // field name
            string_push(sb, ";\n")
        }
        i = i + 1
    }
}

// Does the struct member at 10-tuple `base` carry a field attr named `want`? Member slots 6/7 are
// its attr 4-tuple slice in `aar`.
fn field_has_attr(read p: parser.Parser, read src: str, base: i32, read want: str) -> bool {
    let astart: i32 = list.get(i32, p.mar, (base + 6) as usize)
    let acount: i32 = list.get(i32, p.mar, (base + 7) as usize)
    if astart < 0 { return false }
    var a: i32 = 0
    for a < acount {
        let ab: i32 = astart + a * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        if str_eq(src[ns as usize .. ne as usize], want) { return true }
        a = a + 1
    }
    return false
}

// Layout attrs on a struct item: `@packed` -> `packed`, `@align(n)` -> `aligned(n)`, joined into
// one ` __attribute__((…))` clause (mirrors `struct_attr`; unknown attrs are ignored). Attrs are
// 4-tuples in `aar` at `(u,v)`: [name_start, name_end, arg_start, arg_count]; args are ExprIds.
fn emit_struct_attr(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.u < 0 { return }
    var wrote: bool = false
    var a: i32 = 0
    for a < it.v {
        let ab: i32 = it.u + a * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        let nm: str = src[ns as usize .. ne as usize]
        if str_eq(nm, "packed") {
            if !wrote { string_push(sb, " __attribute__((") } else { string_push(sb, ", ") }
            wrote = true
            string_push(sb, "packed")
        } else if str_eq(nm, "align") {
            if list.get(i32, p.aar, (ab + 3) as usize) >= 1 {
                let arg: i32 = list.get(i32, p.aar, (ab + 2) as usize)
                let ax: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.aar, arg as usize) as usize)
                if ax.kind == 0 {
                    if !wrote { string_push(sb, " __attribute__((") } else { string_push(sb, ", ") }
                    wrote = true
                    string_push(sb, "aligned(")
                    emit_int_literal(sb, src[ax.start .. ax.end])
                    string_push(sb, ")")
                }
            }
        }
        a = a + 1
    }
    if wrote { string_push(sb, "))") }
}

// The item id of a struct/record/union named `src[ns..ne]`, or -1.
fn find_struct_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 {
            if str_eq(src[ns .. ne], src[it.x .. it.y]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Does StructLit `e` list a field named `src[ns..ne]`?
fn structlit_has_field(read p: parser.Parser, read src: str, read e: parser.ExprData, ns: usize, ne: usize) -> bool {
    var i: i32 = 0
    for i < e.y {
        let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
        let fi: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
        if str_eq(src[ns .. ne], src[fi.x as usize .. fi.y as usize]) { return true }
        i = i + 1
    }
    return false
}

// The item id of a non-generic enum named `src[ns..ne]`, or -1.
fn find_enum_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 {
            if str_eq(src[ns .. ne], src[it.x .. it.y]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Decimal digits of a non-negative integer (for `_hi{n}` temp names).
// A signed decimal — a comptime fold can produce a negative number, which `push_uint`
// cannot render. (`i64::MIN` has no positive counterpart, so it is spelled out rather
// than negated.)
fn push_i64(mut sb: String, v: i64) {
    if v < 0 {
        if v == 0 - 9223372036854775807 - 1 {
            string_push(sb, "(-9223372036854775807LL - 1)")
            return
        }
        string_push(sb, "-")
        push_uint(sb, 0 - v)
        return
    }
    push_uint(sb, v)
}

// Encode a comptime-produced string as a C string literal. A `Str` written in source is
// passed through verbatim (its escapes are already C's); a COMPUTED string has no source
// text, so it must be re-encoded — and two C rules make the naive encoder wrong:
//   * a hex escape is maximal-munch (`"\x41" "1"` reads as `\x411`), so non-printables
//     use three-digit octal, which has a fixed width;
//   * `-std=c11` still honours trigraphs, so a literal `?` is escaped rather than left to
//     turn `??/` into a backslash.
// Bytes, not chars: a non-ASCII scalar emits its UTF-8 bytes, which is what `JSTR`'s
// `sizeof(lit) - 1` counts. Mirrors `c_string_literal`.
fn push_c_string(mut sb: String, s: str) {
    string_push(sb, "\"")
    var i: usize = 0
    for i < s.len {
        let b: i32 = s[i] as i32
        if b == 34 { string_push(sb, "\\\"") }
        else if b == 92 { string_push(sb, "\\\\") }
        else if b == 10 { string_push(sb, "\\n") }
        else if b == 13 { string_push(sb, "\\r") }
        else if b == 9 { string_push(sb, "\\t") }
        else if b == 63 { string_push(sb, "\\?") }
        else if b >= 32 { if b <= 126 { string_push(sb, s[i .. i + 1]) } }
        if b < 32 { push_octal3(sb, b) }
        if b > 126 { push_octal3(sb, b) }
        i = i + 1
    }
    string_push(sb, "\"")
}

// A byte as exactly three octal digits, so the escape cannot swallow a following digit.
fn push_octal3(mut sb: String, b: i32) {
    string_push(sb, "\\")
    push_octal_digit(sb, (b / 64) % 8)
    push_octal_digit(sb, (b / 8) % 8)
    push_octal_digit(sb, b % 8)
}

fn push_octal_digit(mut sb: String, d: i32) {
    if d == 0 { string_push(sb, "0") } else if d == 1 { string_push(sb, "1") }
    else if d == 2 { string_push(sb, "2") } else if d == 3 { string_push(sb, "3") }
    else if d == 4 { string_push(sb, "4") } else if d == 5 { string_push(sb, "5") }
    else if d == 6 { string_push(sb, "6") } else { string_push(sb, "7") }
}

fn push_uint(mut sb: String, v: i64) {
    if v >= 10 { push_uint(sb, v / 10) }
    let d: i64 = v % 10
    if d == 0 { string_push(sb, "0") } else if d == 1 { string_push(sb, "1") }
    else if d == 2 { string_push(sb, "2") } else if d == 3 { string_push(sb, "3") }
    else if d == 4 { string_push(sb, "4") } else if d == 5 { string_push(sb, "5") }
    else if d == 6 { string_push(sb, "6") } else if d == 7 { string_push(sb, "7") }
    else if d == 8 { string_push(sb, "8") } else { string_push(sb, "9") }
}

// A loop body (mirrors `emit_loop_body`): like `emit_body(ret=false)` — drop scope included —
// plus the armed labeled-continue target `<label>__continue: ;` at the bottom (after the drops,
// before the closing brace), consumed here exactly like the reference's `cont_label.take()`.
fn emit_loop_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, block_eid: i32, depth: i32) {
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    emit_scratch_reset(sb, src, g, depth + 1)
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, block_eid as usize)
    let n: i32 = blk.y
    var i: i32 = 0
    for i < n {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    var dv: bool = false
    if n > 0 {
        let lsid: i32 = list.get(i32, p.sar, (blk.x + n - 1) as usize)
        let ls: parser.StmtData = list.get(parser.StmtData, p.st, lsid as usize)
        if ls.kind == 1 { dv = true }
    }
    if dv { drop_scope_exit_discard(g) } else { drop_scope_exit_emit(sb, p, src, c, g, depth + 1) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// Emit + consume the armed labeled-continue target, if any (shared by every loop-body shape).
fn emit_cont_target(mut sb: String, read src: str, mut g: Cg, depth: i32) {
    if g.cl_ns >= 0 {
        indent(sb, depth)
        string_push(sb, src[g.cl_ns as usize .. g.cl_ne as usize])
        string_push(sb, "__continue: ;\n")
        g.cl_ns = 0 - 1
        g.cl_ne = 0 - 1
    }
}

// Emit + consume a region-scoped loop's armed per-iteration scratch reset `j_<r>.off = 0;`
// (the reference's `scratch_reset.take()`, at the top of the next loop body).
fn emit_scratch_reset(mut sb: String, read src: str, mut g: Cg, depth: i32) {
    if g.sr_ns >= 0 {
        indent(sb, depth)
        string_push(sb, "j_")
        string_push(sb, src[g.sr_ns as usize .. g.sr_ne as usize])
        string_push(sb, ".off = 0;\n")
        g.sr_ns = 0 - 1
        g.sr_ne = 0 - 1
    }
}

// A `region r { … }` block (kind 43; mirrors `emit_region`): open a bump arena, run the body
// (its `region_alloc(r, …)` calls hand out zero-cost `&[r]T` pointers into it), free the whole
// arena at the brace. The region's drop scope is DISCARDED, not emitted — the arena reclaims
// everything at once (region-integrated bulk drop; the allocator determines the drop strategy).
fn emit_region(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let rname: str = src[e.x as usize .. e.y as usize]
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    indent(sb, depth + 1)
    string_push(sb, "JestyrArena j_")
    string_push(sb, rname)
    string_push(sb, " = jestyr_arena_new(1u << 20);\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)   // a = body Block
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    drop_scope_exit_discard(g)
    indent(sb, depth + 1)
    string_push(sb, "jestyr_arena_free(&j_")
    string_push(sb, rname)
    string_push(sb, ");\n")
    line_at(sb, depth, "}")
}

// `with alive <genref> as read <name> { body } [else { els }]` (kind 46; mirrors
// `emit_with_alive`): ONE generation check at block entry — the exact test every deref
// emits (`((uint64_t*)ptr)[-1] == gen`, the allocation-header generation) — then
// `j_<name>` binds the plain pointer and joins the by-pointer set for the block, so body
// uses deref through it with NO further checks. Without `else` a stale genref FAULTS at
// the check, exactly like a stale deref; with `else` staleness takes that arm. `_wa<n>`
// consumes ONE number from the global temp counter, and the scrutinee emits BEFORE the
// temp is numbered (subexpr-before-enclosing-temp; counter lockstep with the reference).
fn emit_with_alive(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    var gbuf: String = string_new()                   // scrutinee emits BEFORE the temp
    emit_expr(gbuf, p, src, c, g, e.a)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    line_at(sb, depth, "{")
    indent(sb, depth + 1)
    emit_su_tyid(sb, p, src, c, g, list.get(i32, c.et, e.a as usize))
    string_push(sb, " _wa")
    push_uint(sb, n as i64)
    string_push(sb, " = (")
    string_push(sb, string_view(gbuf))
    string_push(sb, ");\n")
    string_free(gbuf)
    if e.op < 0 {                                     // bare form: fault at entry, like a deref
        indent(sb, depth + 1)
        string_push(sb, "assert(((uint64_t*)_wa")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr)[-1] == _wa")
        push_uint(sb, n as i64)
        string_push(sb, ".gen);\n")
        emit_wa_bind(sb, src, e, n, depth + 1)
        emit_wa_body(sb, p, src, c, g, e, depth + 1)
    } else {                                          // else form: staleness takes that arm
        indent(sb, depth + 1)
        string_push(sb, "if (((uint64_t*)_wa")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr)[-1] == _wa")
        push_uint(sb, n as i64)
        string_push(sb, ".gen) {\n")
        emit_wa_bind(sb, src, e, n, depth + 2)
        emit_wa_body(sb, p, src, c, g, e, depth + 2)
        line_at(sb, depth + 1, "} else {")
        drop_scope_enter(g)
        let eb: parser.ExprData = list.get(parser.ExprData, p.ex, e.op as usize)
        var i: i32 = 0
        for i < eb.y {
            emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (eb.x + i) as usize), depth + 2)
            i = i + 1
        }
        drop_scope_exit_emit(sb, p, src, c, g, depth + 2)
        line_at(sb, depth + 1, "}")
    }
    line_at(sb, depth, "}")
}

// The binding line: `__auto_type j_<name> = _wa<n>.ptr;` — the checked pointer, bound once.
fn emit_wa_bind(mut sb: String, read src: str, read e: parser.ExprData, n: i32, depth: i32) {
    indent(sb, depth)
    string_push(sb, "__auto_type j_")
    string_push(sb, src[e.x as usize .. e.y as usize])
    string_push(sb, " = _wa")
    push_uint(sb, n as i64)
    string_push(sb, ".ptr;\n")
}

// The body of a `with alive` block (mirrors `emit_scoped_block`): the binding joins the
// by-pointer set for its extent, so every use derefs through the bound pointer
// (`(*j_<name>)` / `j_<name>->f`) with no generation checks — those were spent at entry.
fn emit_wa_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, depth: i32) {
    list.push(i32, g.pp, e.x)
    list.push(i32, g.pp, e.y)
    drop_scope_enter(g)
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth)
        i = i + 1
    }
    drop_scope_exit_emit(sb, p, src, c, g, depth)
    list.truncate(i32, g.pp, list.len(i32, g.pp) - 2)
}

// A `for` loop statement (kind 31; mirrors `emit_for`). The `lar` header at `e.a`:
// [0,1]=label span (-1 none), [2,3]=region span, [4]=slot A (while: cond; iterate: bind count),
// [5]=slot B (iterate: source count), [6]=slot C (iterate: step ExprId or -1); iterate binds are
// (conv, ns, ne) triples at +7, sources follow; `x`=else Block ExprId (-1 none). A labeled loop
// arms the continue target; a loop with an `else` synthesizes `_fe{n}` (ONE temp, before the
// head) and reroutes plain `break`s past the `else`; the `<label>__break: ;` target lands after
// the `else` (or right after the body for a label-only loop). `region` / zip / `step` are TODO.
fn emit_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let lls: i32 = list.get(i32, p.lar, e.a as usize)          // label span
    let lle: i32 = list.get(i32, p.lar, (e.a + 1) as usize)
    let rns: i32 = list.get(i32, p.lar, (e.a + 2) as usize)    // region span
    let rne: i32 = list.get(i32, p.lar, (e.a + 3) as usize)
    let els: i32 = e.x                                         // else Block ExprId
    // A region-scoped loop wraps everything (loop, else, break target) in an arena scope and
    // arms the per-iteration scratch reset (consumed at the top of the loop body).
    var d: i32 = depth
    if rns >= 0 {
        line_at(sb, depth, "{")
        d = depth + 1
        indent(sb, d)
        string_push(sb, "JestyrArena j_")
        string_push(sb, src[rns as usize .. rne as usize])
        string_push(sb, " = jestyr_arena_new(1u << 20);\n")
        g.sr_ns = rns
        g.sr_ne = rne
    }
    // Hoist a `int64_t _vt{n} = INT64_MAX;` tracker before the loop for each top-level `variant`
    // statement in the body (ONE temp each; mirrors `hoist_variant_trackers` + the per-loop
    // REPLACE of `variant_trackers` — the floor hides any outer loop's entries).
    let vt_len: i32 = list.len(i32, g.vt) as i32
    let vt_floor: i32 = g.vtf
    g.vtf = vt_len
    let hb: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var hv: i32 = 0
    for hv < hb.y {
        let hsid: i32 = list.get(i32, p.sar, (hb.x + hv) as usize)
        let hs: parser.StmtData = list.get(parser.StmtData, p.st, hsid as usize)
        if hs.kind == 2 {
            let hse: parser.ExprData = list.get(parser.ExprData, p.ex, hs.a as usize)
            if hse.kind == 35 {                                // a `variant <expr>` statement
                let tn: i32 = g.tmp
                g.tmp = g.tmp + 1
                list.push(i32, g.vt, hs.a)
                list.push(i32, g.vt, tn)
                indent(sb, d)
                string_push(sb, "int64_t _vt")
                push_uint(sb, tn as i64)
                string_push(sb, " = INT64_MAX;\n")
            }
        }
        hv = hv + 1
    }
    if lls >= 0 { g.cl_ns = lls  g.cl_ne = lle }               // arm the continue target
    var fe: i32 = 0 - 1                                        // synthesized else-break label id
    if lls < 0 and els >= 0 { fe = g.tmp  g.tmp = g.tmp + 1 }
    // Arm plain-`break` rerouting only for a loop that HAS an `else`; save/restore models
    // "the nearest loop" across nesting (mirrors `break_label`).
    let sbl_ns: i32 = g.bl_ns
    let sbl_ne: i32 = g.bl_ne
    let sbl_fe: i32 = g.bl_fe
    g.bl_ns = 0 - 1
    g.bl_ne = 0 - 1
    g.bl_fe = 0 - 1
    if els >= 0 {
        if lls >= 0 { g.bl_ns = lls  g.bl_ne = lle } else { g.bl_fe = fe }
    }
    // Arm the switch-break context (mirrors `loop_label`/`in_switch`/`switch_break_label`):
    // a plain `break` inside a switch-lowered `match` gotos the user label when the loop has
    // one, else `_sb{n}` synthesized on first use; nested loops save/reset/restore.
    let sll_ns: i32 = g.ll_ns
    let sll_ne: i32 = g.ll_ne
    let ssw: bool = g.sw
    let sswb: i32 = g.swb
    g.ll_ns = lls
    g.ll_ne = lle
    g.sw = false
    g.swb = 0 - 1
    emit_for_inner(sb, p, src, c, g, e, d)
    let swb: i32 = g.swb                                       // this loop's synthesized label, if any
    g.swb = sswb
    g.sw = ssw
    g.ll_ns = sll_ns
    g.ll_ne = sll_ne
    g.bl_ns = sbl_ns
    g.bl_ne = sbl_ne
    g.bl_fe = sbl_fe
    // The `else` runs on normal completion: between the loop and the break target, so falling
    // out runs it while a (rerouted) `break` jumps past it. No new drop scope (reference parity).
    if els >= 0 {
        line_at(sb, d, "{")
        let eb: parser.ExprData = list.get(parser.ExprData, p.ex, els as usize)
        var i: i32 = 0
        for i < eb.y {
            emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (eb.x + i) as usize), d + 1)
            i = i + 1
        }
        line_at(sb, d, "}")
    }
    if lls >= 0 {                                              // labeled- and/or else-break target
        indent(sb, d)
        string_push(sb, src[lls as usize .. lle as usize])
        string_push(sb, "__break: ;\n")
    } else if fe >= 0 {
        indent(sb, d)
        string_push(sb, "_fe")
        push_uint(sb, fe as i64)
        string_push(sb, "__break: ;\n")
    } else if swb >= 0 {                                       // switch-break target (synthesized on use)
        indent(sb, d)
        string_push(sb, "_sb")
        push_uint(sb, swb as i64)
        string_push(sb, "__break: ;\n")
    }
    list.truncate(i32, g.vt, vt_len as usize)                  // restore the outer loop's trackers
    g.vtf = vt_floor
    if rns >= 0 {                                              // close the region scope
        indent(sb, d)
        string_push(sb, "jestyr_arena_free(&j_")
        string_push(sb, src[rns as usize .. rne as usize])
        string_push(sb, ");\n")
        line_at(sb, depth, "}")
    }
}

// The head-shape dispatch (mirrors `emit_for_inner`).
fn emit_for_inner(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, depth: i32) {
    if e.op == 0 {                                    // infinite
        line_at(sb, depth, "for (;;)")
        emit_loop_body(sb, p, src, c, g, e.b, depth)
        return
    }
    if e.op == 1 {                                    // conditional -> C while
        indent(sb, depth)
        string_push(sb, "while (")
        emit_expr(sb, p, src, c, g, list.get(i32, p.lar, (e.a + 4) as usize))
        string_push(sb, ")\n")
        emit_loop_body(sb, p, src, c, g, e.b, depth)
        return
    }
    // iterate
    let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
    let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
    let step: i32 = list.get(i32, p.lar, (e.a + 6) as usize)
    if sc >= 2 {                                      // lockstep zip (length-checked)
        emit_zip_for(sb, p, src, c, g, e, bc, sc, depth)
        return
    }
    if sc == 1 {
        let src0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3) as usize)
        let sx: parser.ExprData = list.get(parser.ExprData, p.ex, src0 as usize)
        if sx.kind == 13 {                            // Range source: the counted C for (+ step)
            emit_range_for(sb, p, src, c, g, e, sx, src0, step, depth)
            return
        }
        if sx.kind == 10 and sx.y == 1 {              // `codepoints(s)` marker: the decode loop
            let cal: parser.ExprData = list.get(parser.ExprData, p.ex, sx.a as usize)
            if cal.kind == 2 {
                if str_eq(src[cal.start .. cal.end], "codepoints") {
                    emit_codepoints_for(sb, p, src, c, g, e, arg_at(p, sx, 0), bc, depth)
                    return
                }
            }
        }
        if sx.kind == 10 and sx.y == 2 {              // `split(s, sep)` marker: separator scan loop
            let cal: parser.ExprData = list.get(parser.ExprData, p.ex, sx.a as usize)
            if cal.kind == 2 {
                if str_eq(src[cal.start .. cal.end], "split") {
                    emit_split_for(sb, p, src, c, g, e, arg_at(p, sx, 0), arg_at(p, sx, 1), depth)
                    return
                }
            }
        }
        if step < 0 {
            if expr_is_slice(c, src0) {               // slice source: snapshot + counted for
                emit_slice_for(sb, p, src, c, g, e, src0, bc, depth)
                return
            }
            if expr_is_str(c, src0) {                 // str source: iterate the bytes
                emit_str_for(sb, p, src, c, g, e, src0, bc, depth)
                return
            }
            let sty: i32 = list.get(i32, c.et, src0 as usize)
            if sty >= 0 {
                let sd2: typeck.TyData = list.get(typeck.TyData, c.tys, sty as usize)
                if sd2.kind == 9 {                    // array source: iterate in place by address
                    emit_array_for(sb, p, src, c, g, e, src0, bc, sty, depth)
                    return
                }
            }
        }
    }
    // TODO: codepoints/graphemes/split iteration.
}

// `for cp in codepoints(s)` — decode UTF-8 one codepoint at a time (mirrors
// `emit_codepoints_for`): `_str{n}` snapshot, a manual `_k{n}` cursor the decode advances by
// the codepoint's byte width, each `cp` a `u32`. An optional second binding is the codepoint's
// byte offset — `_k` BEFORE the decode (Go's range-over-string). ONE temp.
fn emit_codepoints_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, s_arg: i32, bc: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _str")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, s_arg)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0;\n")
    indent(sb, depth)
    string_push(sb, "while (_k")
    push_uint(sb, n as i64)
    string_push(sb, " < _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional byte-offset binding
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    indent(sb, depth + 1)
    if !str_eq(bname, "_") {
        string_push(sb, "uint32_t j_")
        string_push(sb, bname)
        string_push(sb, " = jestyr_rt_decode_cp(_str")
    } else {
        string_push(sb, "(void) jestyr_rt_decode_cp(_str")
    }
    push_uint(sb, n as i64)
    string_push(sb, ".ptr, _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len, &_k")
    push_uint(sb, n as i64)
    string_push(sb, ");\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for part in split(s, sep)` — yield each `str` view between separators (zero-copy; the last
// part is the remainder; an empty `sep` yields the whole string once). ONE temp; the source and
// separator exprs are emitted FIRST (their own temps consume before `n`), mirroring
// `emit_split_for`'s ordering exactly.
fn emit_split_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, s_arg: i32, sep_arg: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    var sbuf: String = string_new()
    emit_expr(sbuf, p, src, c, g, s_arg)
    var pbuf: String = string_new()
    emit_expr(pbuf, p, src, c, g, sep_arg)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _ss")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(sbuf))
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "JestyrStr _sep")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(pbuf))
    string_push(sb, ";\n")
    string_free(sbuf)
    string_free(pbuf)
    indent(sb, depth)
    string_push(sb, "size_t _start")
    push_uint(sb, n as i64)
    string_push(sb, " = 0;\n")
    indent(sb, depth)
    string_push(sb, "int _go")
    push_uint(sb, n as i64)
    string_push(sb, " = 1;\n")
    indent(sb, depth)
    string_push(sb, "while (_go")
    push_uint(sb, n as i64)
    string_push(sb, ")\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    indent(sb, depth + 1)
    string_push(sb, "JestyrStr _rest")
    push_uint(sb, n as i64)
    string_push(sb, " = (JestyrStr){ _ss")
    push_uint(sb, n as i64)
    string_push(sb, ".ptr + _start")
    push_uint(sb, n as i64)
    string_push(sb, ", _ss")
    push_uint(sb, n as i64)
    string_push(sb, ".len - _start")
    push_uint(sb, n as i64)
    string_push(sb, " };\n")
    indent(sb, depth + 1)
    string_push(sb, "int64_t _hit")
    push_uint(sb, n as i64)
    string_push(sb, " = _sep")
    push_uint(sb, n as i64)
    string_push(sb, ".len ? jestyr_rt_find(_rest")
    push_uint(sb, n as i64)
    string_push(sb, ", _sep")
    push_uint(sb, n as i64)
    string_push(sb, ") : -1;\n")
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        string_push(sb, "JestyrStr j_")
        string_push(sb, bname)
        string_push(sb, " = (_hit")
        push_uint(sb, n as i64)
        string_push(sb, " < 0) ? _rest")
        push_uint(sb, n as i64)
        string_push(sb, " : (JestyrStr){ _rest")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr, (size_t)_hit")
        push_uint(sb, n as i64)
        string_push(sb, " };\n")
    }
    indent(sb, depth + 1)
    string_push(sb, "if (_hit")
    push_uint(sb, n as i64)
    string_push(sb, " < 0) _go")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; else _start")
    push_uint(sb, n as i64)
    string_push(sb, " += (size_t)_hit")
    push_uint(sb, n as i64)
    string_push(sb, " + _sep")
    push_uint(sb, n as i64)
    string_push(sb, ".len;\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for a, b in xs, ys` — lockstep zip over slices (mirrors `emit_zip_for`): snapshot each
// source (`_z{n}_{i}`, ONE shared temp), assert equal lengths, one counted loop; each bind
// takes its own source's element (by pointer for `mut`, joining the by-pointer set).
fn emit_zip_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, bc: i32, sc: i32, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    var k: i32 = sc
    if bc < k { k = bc }
    var i: i32 = 0
    for i < k {                                       // snapshot each source slice
        let s0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3 + i) as usize)
        indent(sb, depth)
        emit_ty_c(sb, p, src, c, list.get(i32, c.et, s0 as usize))
        string_push(sb, " _z")
        push_uint(sb, n as i64)
        string_push(sb, "_")
        push_uint(sb, i as i64)
        string_push(sb, " = ")
        emit_expr(sb, p, src, c, g, s0)
        string_push(sb, ";\n")
        i = i + 1
    }
    if k > 1 {                                        // all lengths must match
        indent(sb, depth)
        string_push(sb, "assert(")
        var j: i32 = 1
        for j < k {
            if j > 1 { string_push(sb, " && ") }
            string_push(sb, "_z")
            push_uint(sb, n as i64)
            string_push(sb, "_0.len == _z")
            push_uint(sb, n as i64)
            string_push(sb, "_")
            push_uint(sb, j as i64)
            string_push(sb, ".len")
            j = j + 1
        }
        string_push(sb, ");\n")
    }
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _z")
    push_uint(sb, n as i64)
    string_push(sb, "_0.len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    var added: i32 = 0
    var b: i32 = 0
    for b < k {                                       // each bind takes its source's element
        let conv: i32 = list.get(i32, p.lar, (e.a + 7 + b * 3) as usize)
        let bns: i32 = list.get(i32, p.lar, (e.a + 8 + b * 3) as usize)
        let bne: i32 = list.get(i32, p.lar, (e.a + 9 + b * 3) as usize)
        let bname: str = src[bns as usize .. bne as usize]
        if !str_eq(bname, "_") {
            let s0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3 + b) as usize)
            let sd: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, c.et, s0 as usize) as usize)
            indent(sb, depth + 1)
            emit_ty_c(sb, p, src, c, sd.a)               // Slice: a = elem
            if conv == 2 {                            // mut: bind a pointer into the slice
                string_push(sb, "* j_")
                string_push(sb, bname)
                string_push(sb, " = &_z")
            } else {
                string_push(sb, " j_")
                string_push(sb, bname)
                string_push(sb, " = _z")
            }
            push_uint(sb, n as i64)
            string_push(sb, "_")
            push_uint(sb, b as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
            if conv == 2 {
                list.push(i32, g.pp, bns)
                list.push(i32, g.pp, bne)
                added = added + 1
            }
        }
        b = b + 1
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var si: i32 = 0
    for si < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + si) as usize), depth + 1)
        si = si + 1
    }
    if added > 0 { list.truncate(i32, g.pp, list.len(i32, g.pp) - (added * 2) as usize) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for x in xs` / `for mut x in xs` / `for x, i in xs` over a slice (mirrors `emit_slice_for`):
// snapshot `_s{n}`, count `_k{n}`, bind the element by value (`read`) or by pointer (`mut`, which
// joins the by-pointer name set for the body), optional index binding.
fn emit_slice_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, depth: i32) {
    let conv: i32 = list.get(i32, p.lar, (e.a + 7) as usize)
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let stid: i32 = list.get(i32, c.et, src0 as usize)
    let sd: typeck.TyData = list.get(typeck.TyData, c.tys, stid as usize)   // Slice: a = elem
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_su_tyid(sb, p, src, c, g, stid)
    string_push(sb, " _s")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _s")
    push_uint(sb, n as i64)
    string_push(sb, ".len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding (second triple)
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    var added_ptr: bool = false
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        emit_su_tyid(sb, p, src, c, g, sd.a)
        if conv == 2 {                                // mut: bind a pointer into the slice
            string_push(sb, "* j_")
            string_push(sb, bname)
            string_push(sb, " = &_s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
            list.push(i32, g.pp, bns)
            list.push(i32, g.pp, bne)
            added_ptr = true
        } else {                                      // read: bind the element by value
            string_push(sb, " j_")
            string_push(sb, bname)
            string_push(sb, " = _s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
        }
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    if added_ptr { list.truncate(i32, g.pp, list.len(i32, g.pp) - 2) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for b in s` over a str: snapshot `_str{n}`, count `_k{n}`, bind each BYTE as
// `uint8_t j_b = (uint8_t)_str{n}.ptr[_k{n}];` (mirrors `emit_str_for`). Optional index binding.
fn emit_str_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _str")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding (second triple)
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        string_push(sb, "uint8_t j_")
        string_push(sb, bname)
        string_push(sb, " = (uint8_t)_str")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr[_k")
        push_uint(sb, n as i64)
        string_push(sb, "];\n")
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for x in arr` over a fixed-size array (mirrors `emit_array_for`): take the array's ADDRESS
// (`_a{n}`, so no whole-array copy), count to its constant length, bind the element by value
// (`read`) or by pointer (`mut`, which joins the by-pointer name set for the body).
fn emit_array_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, sty: i32, depth: i32) {
    let conv: i32 = list.get(i32, p.lar, (e.a + 7) as usize)
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let ad: typeck.TyData = list.get(typeck.TyData, c.tys, sty as usize)   // Array: a = elem, b = len
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_su_tyid(sb, p, src, c, g, sty)
    string_push(sb, "* _a")
    push_uint(sb, n as i64)
    string_push(sb, " = &(")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ");\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < ")
    push_uint(sb, ad.b as i64)
    string_push(sb, "; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    var added_ptr: bool = false
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        emit_ty_c(sb, p, src, c, ad.a)
        if conv == 2 {                                // mut: bind a pointer into the array
            string_push(sb, "* j_")
            string_push(sb, bname)
            string_push(sb, " = &_a")
        } else {
            string_push(sb, " j_")
            string_push(sb, bname)
            string_push(sb, " = _a")
        }
        push_uint(sb, n as i64)
        string_push(sb, "->a[_k")
        push_uint(sb, n as i64)
        string_push(sb, "];\n")
        if conv == 2 {
            list.push(i32, g.pp, bns)
            list.push(i32, g.pp, bne)
            added_ptr = true
        }
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    if added_ptr { list.truncate(i32, g.pp, list.len(i32, g.pp) - 2) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for i in lo..hi { B }` -> `<cty> _hi{n} = <hi>; for (<cty> j_i = <lo>; j_i </<= _hi{n}; j_i++)`.
// `cty` is `hi`'s numeric type (via the Checker) or `size_t`; `_` binds an internal `_i{n}`.
fn emit_range_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read sx: parser.ExprData, src0: i32, step: i32, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)   // bind triple: (conv, ns, ne)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    // A negative *literal* step descends: compare with `>`/`>=` and use a signed index (so
    // `size_t` underflow can't run the loop forever). Mirrors `descending` in the reference.
    var descending: bool = false
    if step >= 0 {
        let sp: parser.ExprData = list.get(parser.ExprData, p.ex, step as usize)
        if sp.kind == 3 and sp.op == 1 { descending = true }  // Unary neg
    }
    // The loop-index C type: int64_t when descending, else hi's numeric prim, else size_t.
    var numeric: i32 = 0 - 1
    if sx.b >= 0 {
        let tid: i32 = list.get(i32, c.et, sx.b as usize)
        if tid >= 0 {
            let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
            if d.kind == 2 and d.x <= 11 { numeric = d.x }
        }
    }
    indent(sb, depth)
    if descending { string_push(sb, "int64_t") }
    else if numeric >= 0 { prim_code_c(sb, numeric) }
    else { string_push(sb, "size_t") }
    string_push(sb, " _hi")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    if sx.b >= 0 { emit_expr(sb, p, src, c, g, sx.b) } else { string_push(sb, "0") }
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (")
    if descending { string_push(sb, "int64_t") }
    else if numeric >= 0 { prim_code_c(sb, numeric) }
    else { string_push(sb, "size_t") }
    string_push(sb, " ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    string_push(sb, " = ")
    if sx.a >= 0 { emit_expr(sb, p, src, c, g, sx.a) } else { string_push(sb, "0") }
    string_push(sb, "; ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    if descending {
        if sx.op == 1 { string_push(sb, " >= _hi") } else { string_push(sb, " > _hi") }
    } else {
        if sx.op == 1 { string_push(sb, " <= _hi") } else { string_push(sb, " < _hi") }
    }
    push_uint(sb, n as i64)
    string_push(sb, "; ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    if step >= 0 {                                    // stepped: `<i> += (<step>)`
        string_push(sb, " += (")
        emit_expr(sb, p, src, c, g, step)
        string_push(sb, "))\n")
    } else {
        string_push(sb, "++)\n")
    }
    // An exposed, exclusive, unstepped `for i in lo..hi` registers a refinement for the body, so
    // a `s[i]` whose range hi is `s.len` elides its bounds check (mirrors `cur_refines`).
    var refined: bool = false
    if !str_eq(bname, "_") and sx.op == 0 and step < 0 {
        list.push(i32, g.rf, bns)
        list.push(i32, g.rf, bne)
        list.push(i32, g.rf, src0)
        refined = true
    }
    emit_loop_body(sb, p, src, c, g, e.b, depth)
    if refined { list.truncate(i32, g.rf, list.len(i32, g.rf) - 3) }
}

// The `<ret> jestyr_<name>(<params>)` signature (no trailing newline). Mirrors `fn_signature`.
// Does this item carry attribute `@<want>`? (attrs are 4-tuples in `aar` at (u,v)).
fn item_has_attr(read p: parser.Parser, read src: str, read it: parser.ItemData, read want: str) -> bool {
    var i: i32 = 0
    for i < it.v {
        let ab: i32 = it.u + i * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        if str_eq(src[ns as usize .. ne as usize], want) { return true }
        i = i + 1
    }
    return false
}

// The `@cfg(<platform>)` word on an attribute slice, "" when there is none. `(ats, atc)` is
// the slice into `aar` — `(u,v)` for a fn/const/struct/enum, `(xat,xac)` for an extern
// (whose `(u,v)` is already the abi span). The vocabulary is CLOSED: an unrecognized word yields ""
// here, matching the reference, which reports it as an error rather than guarding on it —
// a typo must not silently become "unguarded on every target". Mirrors `attrs::cfg_of`.
fn cfg_word(read p: parser.Parser, read src: str, ats: i32, atc: i32) -> str {
    var i: i32 = 0
    for i < atc {
        let ab: i32 = ats + i * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        if str_eq(src[ns as usize .. ne as usize], "cfg") {
            let ac: i32 = list.get(i32, p.aar, (ab + 3) as usize)
            if ac > 0 {
                let a0: i32 = list.get(i32, p.aar, list.get(i32, p.aar, (ab + 2) as usize) as usize)
                let ax: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
                if ax.kind == 2 {                      // a bare Name (span-only)
                    let w: str = src[ax.start .. ax.end]
                    if str_eq(w, "posix") { return "posix" }
                    if str_eq(w, "windows") { return "windows" }
                    if str_eq(w, "linux") { return "linux" }
                    if str_eq(w, "macos") { return "macos" }
                }
            }
        }
        i = i + 1
    }
    return ""
}

// A `@cfg` word's C preprocessor condition; "" (no guard) for "" or anything unrecognized.
// Mirrors `attrs::cfg_guard`.
fn cfg_cond(read w: str) -> str {
    if str_eq(w, "windows") { return "defined(_WIN32)" }
    if str_eq(w, "posix") { return "!defined(_WIN32)" }
    // `__linux__` and `__APPLE__` are compiler-predefined and need no header — the same
    // property that made `_WIN32` the right choice for `windows`.
    if str_eq(w, "linux") { return "defined(__linux__)" }
    if str_eq(w, "macos") { return "defined(__APPLE__)" }
    return ""
}

// Is `sub` a strict SUBSET of `sup`? Mirrors `attrs::cfg_is_narrower`. `posix` is a
// SUPERSET of both new words; everything else is disjoint by construction, which is why
// the old two-word vocabulary needed no ordering at all.
fn cfg_is_narrower(read sub: str, read sup: str) -> bool {
    if !str_eq(sup, "posix") { return false }
    if str_eq(sub, "linux") { return true }
    if str_eq(sub, "macos") { return true }
    return false
}

// Does any OTHER item named `src[ns..ne]` carry `@cfg(w)`? The sibling scan behind the
// specificity rule. Fn (kind 3) and Extern (kind 8) are the two item kinds `cfg_open`
// guards, matching the reference's `cfg_siblings` map.
fn cfg_has_sibling(read p: parser.Parser, read src: str, ns: i32, ne: i32, read w: str) -> bool {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 or it.kind == 8 {
            if str_eq(src[it.x .. it.y], src[ns as usize .. ne as usize]) {
                var ats: i32 = it.u
                var atc: i32 = it.v
                if it.kind == 8 { ats = it.xat  atc = it.xac }
                if str_eq(cfg_word(p, src, ats, atc), w) { return true }
            }
        }
        r = r + 1
    }
    return false
}

// **The specificity rule.** An item's own guard, with every NARROWER sibling of the same
// name subtracted — so `@cfg(posix) fn f` beside `@cfg(linux) fn f` emits ONE definition
// on Linux instead of two. Mirrors `Cgen::cfg_open`'s condition-building half.
//
// Without it, adding `linux`/`macos` to the vocabulary would be actively wrong rather than
// merely incomplete: `posix` is a superset, so both guards are true on Linux and the C
// compiler reports a duplicate definition. That is why this was never "two more words in
// a list".
//
// The narrower words are walked in the reference's SORTED order (`linux` then `macos`)
// rather than in item order, so both backends build the same condition string character
// for character — the emitted C has to be byte-identical for attest to mean anything.
fn cfg_cond_for(read p: parser.Parser, read src: str, ns: i32, ne: i32, read w: str) -> String {
    // NOT named `out` — that is a Jestyr KEYWORD (the `out x: T` parameter mode), and it
    // parses as one here too. Fourth time this list has cost something.
    var acc: String = string_new()
    let base: str = cfg_cond(w)
    if base.len == 0 { return acc }
    string_push(acc, base)
    if cfg_is_narrower("linux", w) {
        if cfg_has_sibling(p, src, ns, ne, "linux") {
            string_push(acc, " && !")
            string_push(acc, cfg_cond("linux"))
        }
    }
    if cfg_is_narrower("macos", w) {
        if cfg_has_sibling(p, src, ns, ne, "macos") {
            string_push(acc, " && !")
            string_push(acc, cfg_cond("macos"))
        }
    }
    return acc
}

// Open the C preprocessor guard for a `@cfg`ed item; the bool says whether `cfg_close` must
// emit the `#endif`.
//
// **The item is always emitted.** `@cfg` selects at the C preprocessor, not in codegen, so
// the emitted C is the same on every host and attest's "same source -> byte-identical C"
// survives a platform-conditional program — and both platforms stay type-checked, because
// neither branch is ever dropped. Mirrors `Cgen::cfg_open`.
fn cfg_open(mut sb: String, read cond: str) -> bool {
    if cond.len == 0 { return false }
    string_push(sb, "#if ")
    string_push(sb, cond)
    string_push(sb, "\n")
    return true
}

// `cfg_open` with the specificity rule applied — the shape every call site wants, so the
// subtraction cannot be forgotten at one of them.
fn cfg_open_for(mut sb: String, read p: parser.Parser, read src: str, ns: i32, ne: i32, read w: str) -> bool {
    var cond: String = cfg_cond_for(p, src, ns, ne, w)
    let cv: str = string_view(cond)
    let g: bool = cfg_open(sb, cv)
    string_free(cond)
    return g
}

fn cfg_close(mut sb: String, open: bool) {
    if open { string_push(sb, "#endif\n") }
}

// A fn's optimization/ABI/tooling attributes as its leading declaration clause: a storage
// prefix (`@inline` -> `static inline`, internal linkage dodging C's inline-linkage pitfall)
// plus one GNU `__attribute__((…))` group. Pure hints — never semantics. Mirrors
// `fn_attr_prefix`.
fn emit_fn_attr_prefix(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    var storage: bool = false
    var gnu: String = string_new()
    var any: bool = false
    var i: i32 = 0
    for i < it.v {
        let ab: i32 = it.u + i * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        let nm: str = src[ns as usize .. ne as usize]
        var clause: str = ""
        if str_eq(nm, "inline") { storage = true  clause = "always_inline" }
        else if str_eq(nm, "no_inline") { clause = "noinline" }
        else if str_eq(nm, "hot") { clause = "hot" }
        else if str_eq(nm, "cold") { clause = "cold" }
        else if str_eq(nm, "must_use") { clause = "warn_unused_result" }
        if !str_eq(clause, "") {
            if any { string_push(gnu, ", ") }
            string_push(gnu, clause)
            any = true
        }
        // `section(<str>)` / `deprecated[(<str>)]`: the literal keeps its quotes VERBATIM,
        // so the source text is a ready-made C clause.
        if str_eq(nm, "section") or str_eq(nm, "deprecated") {
            let ac: i32 = list.get(i32, p.aar, (ab + 3) as usize)
            var lit: i32 = 0 - 1
            if ac > 0 {
                let a0: i32 = list.get(i32, p.aar, list.get(i32, p.aar, (ab + 2) as usize) as usize)
                let ax: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
                if ax.kind == 29 { lit = a0 }
            }
            if str_eq(nm, "section") and lit < 0 { i = i + 1  continue }
            if any { string_push(gnu, ", ") }
            string_push(gnu, nm)
            if lit >= 0 {
                let lx: parser.ExprData = list.get(parser.ExprData, p.ex, lit as usize)
                string_push(gnu, "(")
                string_push(gnu, src[lx.start .. lx.end])
                string_push(gnu, ")")
            }
            any = true
        }
        i = i + 1
    }
    if storage { string_push(sb, "static inline ") }
    if any {
        string_push(sb, "__attribute__((")
        string_push(sb, string_view(gnu))
        string_push(sb, ")) ")
    }
    string_free(gnu)
}

fn emit_fn_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    emit_fn_attr_prefix(sb, p, src, it)
    // A fallible fn returns its result struct; otherwise its ok type (`it.z`, -1 = void).
    if fn_is_fallible(p, it) { emit_result_name_plain(sb, p, src, it.z) }
    else { emit_c_ty(sb, p, src, it.z) }
    string_push(sb, " ")
    // `@no_mangle` publishes the BARE name (C interop); everything else is `jestyr_<name>`.
    if !item_has_attr(p, src, it, "no_mangle") { string_push(sb, "jestyr_") }
    string_push(sb, src[it.x .. it.y])
    emit_params(sb, p, src, it)
}

// The `(<params>)` list of a function (mirrors `params_str`). `self` and `comptime` params are
// erased; `mut`/`out` params arrive by pointer. Empty -> `(void)`. Params are 7-tuples in `iar`
// at `it.a`, count `it.b`: [comptime, conv, name_start, name_end, is_self, type_id, refine].
fn emit_params(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        let comp: i32 = list.get(i32, p.iar, base as usize)
        let is_self: i32 = list.get(i32, p.iar, (base + 4) as usize)
        if comp == 0 and is_self == 0 {
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            emit_c_ty(sb, p, src, pty)
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }   // mut / out -> by pointer
            string_push(sb, " j_")
            let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
            let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
            string_push(sb, src[pns as usize .. pne as usize])
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// A method's signature `<ret> jestyr_<S>_<m>(<params>)` — like `emit_fn_sig` but `self` renders
// as a real first parameter `Jestyr_<S>[* restrict] j_self` (pointer for `mut`/`out self`).
// Mirrors `emit_method_decl`'s sig + `method_params_str`.
fn emit_method_sig(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, read sd: parser.ItemData, read fd: parser.ItemData) {
    // A fallible method returns its tagged result struct, exactly as a fallible
    // free function does (mirrors `emit_method_decl`'s errors branch).
    if fn_is_fallible(p, fd) { emit_result_name(sb, p, src, c, g, fd.z) }
    else { emit_c_ty(sb, p, src, fd.z) }
    string_push(sb, " jestyr_")
    string_push(sb, src[sd.x .. sd.y])
    string_push(sb, "_")
    string_push(sb, src[fd.x .. fd.y])
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        if list.get(i32, p.iar, base as usize) == 0 {          // not comptime
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if list.get(i32, p.iar, (base + 4) as usize) == 1 {   // self
                string_push(sb, "Jestyr_")
                string_push(sb, src[sd.x .. sd.y])
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_self")
            } else {
                emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_")
                string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            }
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// Method prototypes (mirrors `method_protos`): one `<sig>;` per collected (struct, method)
// instance, then the section's unconditional trailing blank.
// Arm `g.su` from generic-method record `rb` in `g.gmi`: the CTOR's `comptime X: type` param
// names (declaration order) zip with the record's receiver-arg triples. The caller clears it.
fn arm_gmi_su(mut g: Cg, read p: parser.Parser, rb: i32) {
    let argc: i32 = list.get(i32, g.gmi, (rb + 1) as usize)
    list.truncate(i32, g.su, 0)
    // A plain-struct record (argc 0) has no subst -- and its trailing item is the
    // STRUCT, whose (a, b) are member-array coordinates, not param 7-tuples; reading
    // them as params would index the arena with garbage.
    if argc == 0 { return }
    let cf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.gmi, (rb + 2 + argc * 3) as usize) as usize)
    var ai: i32 = 0
    var i: i32 = 0
    for i < cf.b {
        let base: i32 = cf.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 and ai < argc {
                    let ab: i32 = rb + 2 + ai * 3
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 2) as usize))
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 3) as usize))
                    list.push(i32, g.su, list.get(i32, g.gmi, ab as usize))
                    list.push(i32, g.su, list.get(i32, g.gmi, (ab + 1) as usize))
                    list.push(i32, g.su, list.get(i32, g.gmi, (ab + 2) as usize))
                    ai = ai + 1
                }
            }
        }
        i = i + 1
    }
}

// The monomorphized method's signature `<ret> jestyr_<Ctor>__<mangles>_<method>(<self>, …)` —
// `self` as the instance struct (by `* restrict` for `mut`/`out self`), other params under the
// substitution. Arms `g.su` and leaves it set for the body (mirrors `emit_method_decl`).
fn emit_gmi_sig(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, rb: i32) {
    let mfit: i32 = list.get(i32, g.gmi, rb as usize)
    let mf: parser.ItemData = list.get(parser.ItemData, p.it, mfit as usize)
    let argc: i32 = list.get(i32, g.gmi, (rb + 1) as usize)
    let cf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.gmi, (rb + 2 + argc * 3) as usize) as usize)
    arm_gmi_su(g, p, rb)
    // A fallible generic method returns the INSTANCE's result type -- the ok type is
    // resolved through the armed subst, so `Slot(f64).get -> T !{ Empty }` returns
    // `JestyrResult_f64` (one result type per instantiation, like the reference).
    if fn_is_fallible(p, mf) { emit_result_name(sb, p, src, c, g, mf.z) }
    else { emit_su_ty(sb, p, src, c, g, mf.z) }
    string_push(sb, " ")
    push_gmi_name(sb, p, src, c, g.gmi, rb)
    string_push(sb, "(")
    var emitted: i32 = 0
    var pi: i32 = 0
    for pi < mf.b {
        let base: i32 = mf.a + pi * 7
        if list.get(i32, p.iar, (base + 4) as usize) == 1 {   // self: the instance struct
            if emitted > 0 { string_push(sb, ", ") }
            string_push(sb, "Jestyr_")
            string_push(sb, src[cf.x .. cf.y])
            if argc > 0 {                              // plain (argc 0): Jestyr_<Struct> bare
                string_push(sb, "__")
                var t: i32 = 0
                for t < argc {
                    if t > 0 { string_push(sb, "_") }
                    let tb: i32 = rb + 2 + t * 3
                    push_targ_mangle(sb, src, c, list.get(i32, g.gmi, tb as usize), list.get(i32, g.gmi, (tb + 1) as usize), list.get(i32, g.gmi, (tb + 2) as usize))
                    t = t + 1
                }
            }
            let sconv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if sconv == 2 or sconv == 4 { string_push(sb, "* restrict") }
            string_push(sb, " j_self")
            emitted = emitted + 1
        } else if list.get(i32, p.iar, base as usize) == 0 {
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            emit_su_ty(sb, p, src, c, g, list.get(i32, p.iar, (base + 5) as usize))
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
            string_push(sb, " j_")
            string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            emitted = emitted + 1
        }
        pi = pi + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

fn emit_method_protos(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.mi) {
        let sd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.mi, k) as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.mi, k + 1) as usize)
        emit_method_sig(sb, p, src, c, g, sd, fd)
        string_push(sb, ";\n")
        k = k + 2
    }
    var rb: i32 = 0                                   // monomorphized generic-struct methods
    for rb < list.len(i32, g.gmi) as i32 {
        emit_gmi_sig(sb, p, src, c, g, rb)
        string_push(sb, ";\n")
        list.truncate(i32, g.su, 0)
        let argc: i32 = list.get(i32, g.gmi, (rb + 1) as usize)
        rb = rb + 3 + argc * 3
    }
    string_push(sb, "\n")
}

// Method definitions (mirrors `method_defs` -> `emit_method_decl(body=true)`): sig + body + blank.
// The body runs with `self_ptr` set for a `mut`/`out self` (SelfValue then renders `(*j_self)`),
// the method's `mut`/`out` value params in the by-pointer set, and the method's own return type.
fn emit_method_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.mi) {
        let sit: i32 = list.get(i32, g.mi, k)
        let fid: i32 = list.get(i32, g.mi, k + 1)
        let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
        emit_method_sig(sb, p, src, c, g, sd, fd)
        string_push(sb, "\n")
        list.truncate(i32, g.pp, 0)
        var pi: i32 = 0
        for pi < fd.b {
            let pbase: i32 = fd.a + pi * 7
            let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
            if list.get(i32, p.iar, (pbase + 4) as usize) == 0 and (pconv == 2 or pconv == 4) {
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
            }
            pi = pi + 1
        }
        let sconv: i32 = method_self_conv(p, fid)
        g.self_ptr = sconv == 2 or sconv == 4
        g.retty = fd.z
        g.curfn = fid
        g.autoret = true                              // the reference leaves `cur_ret_cty` unset here
        // Methods own their `take` params exactly as free fns do, and the move analysis
        // must run for the same reason (mirrors `emit_method_decl` post-take-drop-fix).
        list.truncate(i32, g.mv, 0)
        collect_moved_block(g, p, src, fd.w)
        fill_take_drops(g, p, src, fd)
        // A fallible method body constructs ITS result type: `ok`/`err`/`?` inside it
        // consult `res_ok`, exactly as in a fallible free function (mirrors
        // `emit_method_decl` setting `cur_result`).
        let mfall: bool = fn_is_fallible(p, fd)
        if mfall { g.res_ok = fd.z } else { g.res_ok = 0 - 2 }
        emit_body(sb, p, src, c, g, fd.w, fd.z >= 0 or mfall, 0)
        g.res_ok = 0 - 2
        g.self_ptr = false
        g.retty = 0 - 1
        g.autoret = false
        list.truncate(i32, g.pp, 0)
        list.truncate(i32, g.mv, 0)
        string_push(sb, "\n")
        k = k + 2
    }
    var rb: i32 = 0                                   // monomorphized generic-struct method bodies
    for rb < list.len(i32, g.gmi) as i32 {
        let mfit: i32 = list.get(i32, g.gmi, rb as usize)
        let mf: parser.ItemData = list.get(parser.ItemData, p.it, mfit as usize)
        emit_gmi_sig(sb, p, src, c, g, rb)            // arms g.su; the body runs under it
        string_push(sb, "\n")
        list.truncate(i32, g.pp, 0)
        var pi: i32 = 0
        for pi < mf.b {
            let pbase: i32 = mf.a + pi * 7
            let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
            if list.get(i32, p.iar, (pbase + 4) as usize) == 0 and (pconv == 2 or pconv == 4) {
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
            }
            pi = pi + 1
        }
        let sconv: i32 = method_self_conv(p, mfit)
        g.self_ptr = sconv == 2 or sconv == 4
        g.retty = mf.z
        g.curfn = mfit
        g.autoret = true
        // Worklist methods collect moved too (mirrors `emit_method_decl`). A CONCRETE
        // receiver (empty subst — plain methods ride this loop since fddf02a) fills its
        // droppable `take` params from the raw annotations, exactly like a free fn; an
        // armed-subst instance needs the SUBSTITUTED type — the recorded later
        // increment, the same class as template-body lets under subst.
        list.truncate(i32, g.mv, 0)
        collect_moved_block(g, p, src, mf.w)
        if list.len(i32, g.su) == 0 { fill_take_drops(g, p, src, mf) }
        // Fallible generic method: `ok`/`err`/`?` construct the INSTANCE's result
        // (res_ok resolves through the still-armed subst in emit_result_name).
        let gmfall: bool = fn_is_fallible(p, mf)
        if gmfall { g.res_ok = mf.z } else { g.res_ok = 0 - 2 }
        emit_body(sb, p, src, c, g, mf.w, mf.z >= 0 or gmfall, 0)
        g.res_ok = 0 - 2
        g.self_ptr = false
        g.retty = 0 - 1
        g.autoret = false
        list.truncate(i32, g.pp, 0)
        list.truncate(i32, g.su, 0)
        list.truncate(i32, g.mv, 0)
        string_push(sb, "\n")
        let argc: i32 = list.get(i32, g.gmi, (rb + 1) as usize)
        rb = rb + 3 + argc * 3
    }
}

// A concrete trait-impl method's signature `<ret> jestyr_impl_<Trait>__<TypeKey>__<method>(<params>)`.
// The type key is the Name target's own text (already a C identifier — the reference sanitises
// non-alnum chars only for exotic keys a Name can't contain). `self` renders as a real first
// parameter of the impl target's C type, by `* restrict` pointer for a `mut`/`out self`.
// Mirrors `emit_impl_method_decl`'s sig + `method_params_str` + `impl_method_c_name`.
// The ok TypeId of a fallible impl method (trait-errors T2), with `Self`
// resolved to the impl's target -- the mangle, the typedef and the signature
// all key on it from ONE place so they cannot disagree (the reference's
// `impl_ok_ty`).
fn impl_ok_tid(read p: parser.Parser, read src: str, read im: parser.ItemData, read fd: parser.ItemData) -> i32 {
    if fd.z < 0 { return 0 - 1 }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, fd.z as usize)
    if t.kind == 0 { if str_eq(src[t.start .. t.end], "Self") { return im.a } }
    return fd.z
}

fn emit_impl_sig(mut sb: String, read p: parser.Parser, read src: str, read im: parser.ItemData, read fd: parser.ItemData) {
    // A fallible impl method returns its tagged result struct (trait-errors T2)
    // -- the trait's signature is the ABI, exactly as a fallible struct method.
    if fn_is_fallible(p, fd) {
        string_push(sb, "JestyrResult_")
        let iok: i32 = impl_ok_tid(p, src, im, fd)
        if iok < 0 { string_push(sb, "unit") } else { push_ast_mangle(sb, p, src, iok) }
    } else {
        emit_c_ty(sb, p, src, fd.z)
    }
    string_push(sb, " jestyr_impl_")
    string_push(sb, src[im.x .. im.y])                // trait name
    string_push(sb, "__")
    let tt: parser.TypeData = list.get(parser.TypeData, p.ty, im.a as usize)
    string_push(sb, src[tt.start .. tt.end])          // the target's type key
    string_push(sb, "__")
    string_push(sb, src[fd.x .. fd.y])                // method name
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        if list.get(i32, p.iar, base as usize) == 0 {          // not comptime
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if list.get(i32, p.iar, (base + 4) as usize) == 1 {   // self: the impl target's C type
                emit_c_ty(sb, p, src, im.a)
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_self")
            } else {
                emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_")
                string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            }
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// Trait-impl method prototypes (mirrors `impl_protos`): one `<sig>;` per concrete impl method,
// then a CONDITIONAL trailing blank (only if any emitted — unlike method_protos'). Blanket
// generic impls are monomorphized per instance separately (a later increment). A FALLIBLE impl
// method returns its tagged result struct (trait-errors T2), exactly as a fallible struct
// method does — the trait's signature is the ABI.
// The blanket `impl[T] Drop for <Ctor>(T)` item covering generic-struct ctor `src[cns..cne]`,
// or -1. Mirrors `generic_drop_impl` (detection by constructor name).
fn generic_drop_impl_of(read p: parser.Parser, read src: str, cns: usize, cne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h > 0 {
            if str_eq(src[it.x as usize .. it.y as usize], "Drop") {
                if it.a >= 0 {
                    let t: parser.TypeData = list.get(parser.TypeData, p.ty, it.a as usize)
                    if t.kind == 7 {
                        if str_eq(src[t.x as usize .. t.y as usize], src[cns .. cne]) { return iid }
                    }
                }
            }
        }
        r = r + 1
    }
    return 0 - 1
}

// The impl's `drop` method fn item, or -1.
fn impl_drop_method(read p: parser.Parser, read src: str, im: i32) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, im as usize)
    var k: i32 = 0
    for k < it.z {
        let mid: i32 = list.get(i32, p.mar, (it.b + k) as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
        if str_eq(src[fd.x .. fd.y], "drop") { return mid }
        k = k + 1
    }
    return 0 - 1
}

// A Checker type's SANITIZED impl key (`Vec(i32)` -> `Vec_i32_`): the reference keys impl
// instances by the type's display form with every non-alphanumeric byte mapped to `_`
// (`ty_key` + `impl_method_c_name`). Prim = jname; Named = its name; kind 6 = `ctor(a, b)`
// with `(`/`)` -> `_` and `, ` -> `__`; Ptr = `*mut inner` -> `_mut_inner`.
fn push_ty_key_safe(mut sb: String, read src: str, read c: typeck.Checker, tid: i32) {
    if tid < 0 { string_push(sb, "_")  return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 2 { string_push(sb, prim_jname(d.x))  return }
    if d.kind == 15 {
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, src[ns as usize .. ne as usize])
        return
    }
    if d.kind == 6 {
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "_")
        var i: i32 = 0
        for i < d.b {
            if i > 0 { string_push(sb, "__") }
            push_ty_key_safe(sb, src, c, list.get(i32, c.tya, (d.a + i) as usize))
            i = i + 1
        }
        string_push(sb, "_")
        return
    }
    if d.kind == 3 {
        string_push(sb, "_mut_")
        push_ty_key_safe(sb, src, c, d.a)
        return
    }
    string_push(sb, "_")
}

// The signature of one monomorphized blanket-Drop instance:
// `void jestyr_impl_Drop__<key>__drop(<instance cty>[* restrict] j_self)`.
fn emit_gdrop_sig(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32, im: i32) {
    let mid: i32 = impl_drop_method(p, src, im)
    string_push(sb, "void jestyr_impl_Drop__")
    push_ty_key_safe(sb, src, c, tid)
    string_push(sb, "__drop(")
    emit_ty_c(sb, p, src, c, tid)
    let sconv: i32 = method_self_conv(p, mid)
    if sconv == 2 or sconv == 4 { string_push(sb, "* restrict") }
    string_push(sb, " j_self)")
}

fn emit_impl_protos(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var any: bool = false
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {                            // (b,z) = method fn-ItemId slice in mar
                let mid: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
                emit_impl_sig(sb, p, src, it, fd)
                string_push(sb, ";\n")
                any = true
                k = k + 1
            }
        }
        r = r + 1
    }
    // Each generic-struct instance covered by a blanket `impl[T] Drop` gets its own
    // monomorphized proto (mirrors `emit_generic_drop_methods(false)`, sharing the blank).
    var gk: usize = 0
    for gk < list.len(i32, g.gsi) {
        let tid: i32 = list.get(i32, g.gsi, gk)
        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
        let im: i32 = generic_drop_impl_of(p, src, d.x as usize, d.y as usize)
        if im >= 0 {
            emit_gdrop_sig(sb, p, src, c, tid, im)
            string_push(sb, ";\n")
            any = true
        }
        gk = gk + 1
    }
    if any { string_push(sb, "\n") }
}

// Trait-impl method definitions (mirrors `impl_defs` -> `emit_impl_method_decl(body=true)`):
// sig + body + blank each, after the struct-method defs. The body runs like a struct method's —
// `self_ptr` for a `mut`/`out self`, the method's `mut`/`out` params by pointer, `autoret` (the
// reference leaves `cur_ret_cty` unset), its own move set, and its droppable `take` params.
fn emit_impl_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {
                let mid: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
                if true {
                    emit_impl_sig(sb, p, src, it, fd)
                    string_push(sb, "\n")
                    list.truncate(i32, g.pp, 0)
                    var pi: i32 = 0
                    for pi < fd.b {
                        let pbase: i32 = fd.a + pi * 7
                        let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
                        if list.get(i32, p.iar, (pbase + 4) as usize) == 0 and (pconv == 2 or pconv == 4) {
                            list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                            list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
                        }
                        pi = pi + 1
                    }
                    let sconv: i32 = method_self_conv(p, mid)
                    g.self_ptr = sconv == 2 or sconv == 4
                    g.retty = fd.z
                    g.curfn = mid
                    g.autoret = true
                    // An impl method owns its `take` params too (mirrors
                    // `emit_impl_method_decl` post-take-drop-fix).
                    list.truncate(i32, g.mv, 0)
                    collect_moved_block(g, p, src, fd.w)
                    fill_take_drops(g, p, src, fd)
                    // A fallible impl body constructs ITS result type: ok/err/?
                    // consult res_ok, exactly as a fallible struct method
                    // (trait-errors T2; Self ok resolves to the target).
                    let ifall: bool = fn_is_fallible(p, fd)
                    if ifall { g.res_ok = impl_ok_tid(p, src, it, fd) } else { g.res_ok = 0 - 2 }
                    emit_body(sb, p, src, c, g, fd.w, fd.z >= 0 or ifall, 0)
                    g.res_ok = 0 - 2
                    g.self_ptr = false
                    g.retty = 0 - 1
                    g.autoret = false
                    list.truncate(i32, g.pp, 0)
                    list.truncate(i32, g.mv, 0)
                    string_push(sb, "\n")
                }
                k = k + 1
            }
        }
        r = r + 1
    }
    // Monomorphized blanket-Drop instances LAST (mirrors `impl_defs` ending with
    // `emit_generic_drop_methods(true)`): the body runs under the impl's tparam -> the
    // instance's first type-arg substitution, `self` per the drop method's convention.
    var gk: usize = 0
    for gk < list.len(i32, g.gsi) {
        let tid: i32 = list.get(i32, g.gsi, gk)
        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
        let im: i32 = generic_drop_impl_of(p, src, d.x as usize, d.y as usize)
        if im >= 0 {
            let mid: i32 = impl_drop_method(p, src, im)
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
            emit_gdrop_sig(sb, p, src, c, tid, im)
            string_push(sb, "\n")
            let it2: parser.ItemData = list.get(parser.ItemData, p.it, im as usize)
            list.truncate(i32, g.su, 0)
            if it2.h > 0 and d.b > 0 {
                list.push(i32, g.su, list.get(i32, p.gar, it2.g as usize))
                list.push(i32, g.su, list.get(i32, p.gar, (it2.g + 1) as usize))
                list.push(i32, g.su, 1)
                list.push(i32, g.su, list.get(i32, c.tya, d.a as usize))
                list.push(i32, g.su, 0 - 1)
            }
            list.truncate(i32, g.pp, 0)
            let sconv: i32 = method_self_conv(p, mid)
            g.self_ptr = sconv == 2 or sconv == 4
            g.retty = fd.z
            g.curfn = mid
            g.autoret = true
            emit_body(sb, p, src, c, g, fd.w, false, 0)
            g.self_ptr = false
            g.retty = 0 - 1
            g.autoret = false
            list.truncate(i32, g.su, 0)
            string_push(sb, "\n")
        }
        gk = gk + 1
    }
}

// ---- top-level sections (mirrors emit_program's order) ----

// Forward typedefs for struct/distinct/enum aggregates. None in `hello`, so just the trailing
// blank line the reference always emits.
fn emit_forward_types(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 1 {                             // distinct: `typedef <base> Jestyr_<name>;`
            // …unless the base lowers to an ANONYMOUS-struct typedef (`distinct Buf = []i64`
            // -> `JestyrSlice_i64`), which nothing has defined this early — the forward
            // section runs before the definition capture. Those go through
            // `emit_distinct_defs`, which orders them after the base. Every other base (a
            // primitive, a pointer, a named aggregate) keeps its position here, so the
            // emitted C of every existing program is unchanged.
            var dbase: String = string_new()
            emit_c_ty(dbase, p, src, it.a)            // a = base TypeId
            if !cty_is_anon(string_view(dbase)) {
                string_push(sb, "typedef ")
                string_push(sb, string_view(dbase))
                string_push(sb, " Jestyr_")
                string_push(sb, src[it.x .. it.y])
                string_push(sb, ";\n")
            }
            string_free(dbase)
        }
        if it.kind == 4 {                             // struct/record/union: forward typedef
            string_push(sb, "typedef ")
            if it.op == 2 { string_push(sb, "union ") } else { string_push(sb, "struct ") }   // op 2 = union
            string_push(sb, "Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, ";\n")
        }
        if it.kind == 5 and it.a == 0 {               // non-generic enum: `typedef struct Jestyr_<E> Jestyr_<E>;`
            if niche_named_some(p, iid) < 0 {         // a niche enum IS its pointer — no typedef
                string_push(sb, "typedef struct Jestyr_")
                string_push(sb, src[it.x .. it.y])
                string_push(sb, " Jestyr_")
                string_push(sb, src[it.x .. it.y])
                string_push(sb, ";\n")
            }
        }
        r = r + 1
    }
    string_push(sb, "\n")
}

// ---- enum / variant lookup (the reference's `variants` map, computed by AST scan) ----

// The item id of the enum that declares a variant named `src[ns..ne]`, or -1. Variants are
// 5-tuples in `ear` at `it.b`, count `it.z`: [name_start, name_end, field_start, field_count, disc].
fn find_variant_enum(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 {
            var k: i32 = 0
            for k < it.z {
                let vb: i32 = it.b + k * 5
                let vns: i32 = list.get(i32, p.ear, vb as usize)
                let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                if str_eq(src[ns .. ne], src[vns as usize .. vne as usize]) { return iid }
                k = k + 1
            }
        }
        r = r + 1
    }
    return 0 - 1
}

// The variant 5-tuple base (into `ear`) of variant `src[ns..ne]` within enum item `enum_iid`, or -1.
fn variant_tuple(read p: parser.Parser, read src: str, enum_iid: i32, ns: usize, ne: usize) -> i32 {
    if enum_iid < 0 { return 0 - 1 }                  // an IMPORT-DEGENERATE enum resolves nothing
    let it: parser.ItemData = list.get(parser.ItemData, p.it, enum_iid as usize)
    var k: i32 = 0
    for k < it.z {
        let vb: i32 = it.b + k * 5
        let vns: i32 = list.get(i32, p.ear, vb as usize)
        let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
        if str_eq(src[ns .. ne], src[vns as usize .. vne as usize]) { return vb }
        k = k + 1
    }
    return 0 - 1
}

// Emit the leading `(Jestyr_<E>){ .tag = Jestyr_<E>_<v>` of a variant construction (caller adds
// the optional `.u.<v> = { … }` payload and the closing ` }`).
fn emit_variant_head(mut sb: String, read p: parser.Parser, read src: str, enum_iid: i32, read vname: str) {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, enum_iid as usize)
    let en: str = src[it.x .. it.y]
    string_push(sb, "(Jestyr_")
    string_push(sb, en)
    string_push(sb, "){ .tag = Jestyr_")
    string_push(sb, en)
    string_push(sb, "_")
    string_push(sb, vname)
}

// Like `emit_variant_head`, but for a generic-enum INSTANCE (the construct expr's Checker type
// `tid`, kind 6): `(<N>){ .tag = <N>_<v>` where N = `Jestyr_<ctor>__<args>`.
fn emit_gvariant_head(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tid: i32, read vname: str) {
    string_push(sb, "(")
    emit_su_tyid(sb, p, src, c, g, tid)
    string_push(sb, "){ .tag = ")
    emit_su_tyid(sb, p, src, c, g, tid)
    string_push(sb, "_")
    string_push(sb, vname)
}

// ---- `@layout(auto)` field ordering (mirrors `src/layout.rs`, increment L2) --------------
// Opt-in per struct: a struct that does NOT carry `@layout(auto)` emits its fields in
// declaration order, exactly as before, which is why all 140 corpus files stay byte-identical.
//
// Only ALIGNMENT is mirrored here, never size. The ordering needs nothing else, and the reason
// is worth stating because it is also what makes the model non-circular: an aggregate's
// alignment is the max over its components, which no permutation changes, so an alignment can
// be computed without first knowing which structs are reordered.
//
// -1 means "not knowable from the declared shape" — a generic instance, an unresolved name, a
// `dyn` fat pointer. It is the port's spelling of the reference's `Option::None`, and it makes
// the CALLER decline to reorder: reordering by an alignment the compiler had to guess would put
// the two implementations' emitted C at risk of disagreeing, which is the one thing the golden
// exists to prevent.

// The alignment of a primitive by name, or 0 if the name is not one (mirrors `prim_layout`'s
// alignment column). `str`/`String`/`Builder`/`Cow` are multi-word views and buffers, so they
// carry a pointer's alignment rather than their own size.
fn la_prim_align(read name: str) -> i32 {
    if str_eq(name, "i8") { return 1 }
    if str_eq(name, "u8") { return 1 }
    if str_eq(name, "bool") { return 1 }
    if str_eq(name, "i16") { return 2 }
    if str_eq(name, "u16") { return 2 }
    if str_eq(name, "i32") { return 4 }
    if str_eq(name, "u32") { return 4 }
    if str_eq(name, "f32") { return 4 }
    if str_eq(name, "char") { return 4 }
    if str_eq(name, "i64") { return 8 }
    if str_eq(name, "u64") { return 8 }
    if str_eq(name, "f64") { return 8 }
    if str_eq(name, "isize") { return 8 }
    if str_eq(name, "usize") { return 8 }
    if str_eq(name, "str") { return 8 }
    if str_eq(name, "os_str") { return 8 }
    if str_eq(name, "cstr") { return 8 }
    if str_eq(name, "cptr") { return 8 }
    if str_eq(name, "String") { return 8 }
    if str_eq(name, "Builder") { return 8 }
    if str_eq(name, "Cow") { return 8 }
    return 0
}

// The alignment of an AST type node, or -1 when unknowable (mirrors `layout::layout_of`'s
// alignment half). `depth` is a totality bound: a struct cannot contain itself by value in a
// well-typed program, but a malformed one could, and a compiler that hangs is worse than one
// that declines.
fn la_align(read p: parser.Parser, read src: str, tyid: i32, depth: i32) -> i32 {
    if depth <= 0 { return 0 - 1 }
    if tyid < 0 { return 1 }                            // unit
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {                                    // Name: primitive, else a declared type
        let pa: i32 = la_prim_align(src[t.start .. t.end])
        if pa > 0 { return pa }
        let iid: i32 = find_named_item(p, src, t.start as i32, t.end as i32)
        if iid < 0 { return 0 - 1 }                     // unresolved -> unknowable
        return la_item_align(p, src, iid, depth - 1)
    }
    if t.kind == 2 { return 8 }                         // Ptr
    if t.kind == 3 { return 8 }                         // Slice `{ ptr, len }`
    if t.kind == 4 { return la_align(p, src, t.a, depth - 1) }   // Array: the element's own
    if t.kind == 5 { return 8 }                         // GenRef `{ ptr, gen }`
    if t.kind == 6 { return 8 }                         // RegionRef -> a plain pointer
    if t.kind == 9 { return 8 }                         // Fn pointer
    return 0 - 1                                        // App/Path/Dyn/TypeKw/Error: unknowable
}

// The alignment of a declared item (mirrors `named_layout`'s alignment half): a `distinct` is
// its base exactly, a struct is the max over its fields, and a tagged enum is the max of its
// 4-byte tag and every payload field.
fn la_item_align(read p: parser.Parser, read src: str, iid: i32, depth: i32) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
    if it.kind == 1 { return la_align(p, src, it.a, depth) }     // distinct: `a` = base TypeId
    if it.kind == 4 {
        var best: i32 = 1
        var m: i32 = 0
        for m < it.b {
            let base: i32 = it.a + m * 10
            if list.get(i32, p.mar, base as usize) == 0 {        // a field, not a method
                let fa: i32 = la_align(p, src, list.get(i32, p.mar, (base + 4) as usize), depth)
                if fa < 0 { return 0 - 1 }
                if fa > best { best = fa }
            }
            m = m + 1
        }
        return best
    }
    if it.kind == 5 {
        var best2: i32 = 4                                       // the tag
        var k: i32 = 0
        for k < it.z {
            let vb: i32 = it.b + k * 5
            let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
            let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
            var fi: i32 = 0
            for fi < fc {
                let fa2: i32 = la_align(p, src, list.get(i32, p.ear, (fs + fi * 3 + 2) as usize), depth)
                if fa2 < 0 { return 0 - 1 }
                if fa2 > best2 { best2 = fa2 }
                fi = fi + 1
            }
            k = k + 1
        }
        return best2
    }
    return 0 - 1
}

// Does this item carry `@layout(auto)`? (mirrors `layout::wants_auto`). Attrs are 4-tuples in
// `aar` at `(it.u, it.v)`: [name_start, name_end, arg_start, arg_count]; the argument ExprId
// lives in `aar` at `arg_start`. Only the exact word `auto` counts — `@layout(c)` is the
// default said out loud, and the reference refuses any other spelling outright.
fn la_auto(read p: parser.Parser, read src: str, read it: parser.ItemData) -> bool {
    if it.u < 0 { return false }
    var a: i32 = 0
    for a < it.v {
        let ab: i32 = it.u + a * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        if str_eq(src[ns as usize .. ne as usize], "layout") {
            if list.get(i32, p.aar, (ab + 3) as usize) >= 1 {
                let arg: i32 = list.get(i32, p.aar, (ab + 2) as usize)
                let aid: i32 = list.get(i32, p.aar, arg as usize)
                let ax: parser.ExprData = list.get(parser.ExprData, p.ex, aid as usize)
                if ax.kind == 2 {                                // a bare Name argument
                    if str_eq(src[ax.start .. ax.end], "auto") { return true }
                }
            }
        }
        a = a + 1
    }
    return false
}

// May this struct's fields be reordered? Every field's alignment must be knowable AND be one of
// 1/2/4/8 — the complete set the model produces, and the set `la_emit_fields` walks. A width
// outside it would be silently dropped from the emission, so it declines instead.
fn la_reorderable(read p: parser.Parser, read src: str, read it: parser.ItemData) -> bool {
    if !la_auto(p, src, it) { return false }
    var m: i32 = 0
    for m < it.b {
        let base: i32 = it.a + m * 10
        if list.get(i32, p.mar, base as usize) == 0 {
            let fa: i32 = la_align(p, src, list.get(i32, p.mar, (base + 4) as usize), 32)
            if fa != 1 and fa != 2 and fa != 4 and fa != 8 { return false }
        }
        m = m + 1
    }
    return true
}

// One field's declaration line (factored out so declaration order and reordered order emit
// through the same code and cannot drift).
fn la_emit_field(mut sb: String, read p: parser.Parser, read src: str, base: i32) {
    string_push(sb, "    ")
    if field_has_attr(p, src, base, "volatile") { string_push(sb, "volatile ") }
    emit_c_ty(sb, p, src, list.get(i32, p.mar, (base + 4) as usize))
    string_push(sb, " j_")
    let fns: i32 = list.get(i32, p.mar, (base + 2) as usize)
    let fne: i32 = list.get(i32, p.mar, (base + 3) as usize)
    string_push(sb, src[fns as usize .. fne as usize])
    let bs: i32 = list.get(i32, p.mar, (base + 8) as usize)      // `: bits` width span
    if bs >= 0 {
        string_push(sb, " : ")
        string_push(sb, src[bs as usize .. list.get(i32, p.mar, (base + 9) as usize) as usize])
    }
    string_push(sb, ";\n")
}

// Emit a struct's fields in EMISSION order: descending alignment when `@layout(auto)` applies,
// declaration order otherwise.
//
// The reordered pass walks the four alignment levels 8, 4, 2, 1 and within each emits the
// matching fields in declaration order. That is exactly a stable sort by descending alignment —
// the reference's `sort_by_key(Reverse(align))` — but it needs no list and no comparison sort,
// so it is allocation-free and obviously stable. It is only equivalent because the model's
// alignments are drawn from precisely those four values, which is what `la_reorderable` checks
// rather than assumes.
fn la_emit_fields(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if !la_reorderable(p, src, it) {
        var m0: i32 = 0
        for m0 < it.b {
            let b0: i32 = it.a + m0 * 10
            if list.get(i32, p.mar, b0 as usize) == 0 { la_emit_field(sb, p, src, b0) }
            m0 = m0 + 1
        }
        return
    }
    var lvl: i32 = 8
    for lvl >= 1 {
        var m: i32 = 0
        for m < it.b {
            let base: i32 = it.a + m * 10
            if list.get(i32, p.mar, base as usize) == 0 {
                if la_align(p, src, list.get(i32, p.mar, (base + 4) as usize), 32) == lvl {
                    la_emit_field(sb, p, src, base)
                }
            }
            m = m + 1
        }
        lvl = lvl / 2
    }
}

// Struct/record/union definitions (mirrors Cgen::struct_defs). Members are 10-tuples in `mar`
// at `it.a`, count `it.b`: [tag(0=field,1=method), pub, name_start, name_end, type_id, default,
// attr_start, attr_count, bits_start, bits_end]. Only fields are emitted (methods live in fn_defs);
// each struct ends with `};\n\n` (the trailing blank). `@packed`/`@align` attrs are still TODO.
// ---- aggregate-definition capture + topological flush (mirrors `def_cap`/`DefCapture`/
// `flush_def_capture`). The eight aggregate-def sections emit into a CAPTURE buffer; each
// definition registers as a named segment with its by-value type deps (section blanks and other
// glue become anonymous segments pinned in place), and the flush re-emits every segment in a
// stable post-order DFS so a struct embedding another aggregate BY VALUE (e.g. a `List(E)`
// field) follows that aggregate's definition. A program with no forward by-value dependency
// flushes in the original order — byte-identical, which is why this was a no-op until a plain
// struct first held a generic-instance field. Names + deps live in one append-only buffer `nb`
// as `|`-delimited tokens addressed by (start, end) ranges — the port's usual stand-in for the
// reference's `String` collections. ----
struct Dc {
    nb: String,        // names + dep tokens (each dep region is `` or `|A|B|…|`)
    segs: List(i32),   // 6-tuples: (buf_s, buf_e, name_s, name_e, dep_s, dep_e); name_s==name_e = glue
    last: i32,         // end offset (into the capture buffer) of the last finalized segment
    pns: i32,          // the open unit's name/dep ranges + start (pstart -1 = none pending)
    pne: i32,
    pds: i32,
    pde: i32,
    pstart: i32,
}

fn dc_len(mut d: Dc) -> i32 {
    let v: str = string_view(d.nb)
    return v.len as i32
}

fn sb_len(mut sb: String) -> i32 {
    let v: str = string_view(sb)
    return v.len as i32
}

// Finalize any glue text written since the last segment (kept in place, unnamed).
fn dc_glue(mut d: Dc, cap_len: i32) {
    if cap_len > d.last {
        list.push(i32, d.segs, d.last)
        list.push(i32, d.segs, cap_len)
        list.push(i32, d.segs, 0)
        list.push(i32, d.segs, 0)
        list.push(i32, d.segs, 0)
        list.push(i32, d.segs, 0)
        d.last = cap_len
    }
}

// Open a definition segment: name range [ns, ne) and dep range [ds, de) into `d.nb`.
fn dc_begin(mut d: Dc, cap_len: i32, ns: i32, ne: i32, ds: i32, de: i32) {
    dc_glue(d, cap_len)
    d.pns = ns
    d.pne = ne
    d.pds = ds
    d.pde = de
    d.pstart = cap_len
}

// Close the current definition segment.
fn dc_end(mut d: Dc, cap_len: i32) {
    list.push(i32, d.segs, d.pstart)
    list.push(i32, d.segs, cap_len)
    list.push(i32, d.segs, d.pns)
    list.push(i32, d.segs, d.pne)
    list.push(i32, d.segs, d.pds)
    list.push(i32, d.segs, d.pde)
    d.last = cap_len
    d.pstart = 0 - 1
}

// Add one by-value dep to the open collection region starting at `ds` (mirrors `dep_of_cty` +
// `add_dep`): a pointer type needs only a forward declaration — skipped; otherwise the rendered
// C type name, deduped within this definition's region. Primitive names are collected too (the
// reference does) — they match no segment, so they are harmless DFS no-ops.
fn dc_dep(mut d: Dc, ds: i32, read cty: str) {
    if contains(cty, "*") { return }
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, cty)
    string_push(probe, "|")
    var have: bool = false
    {
        let cur: str = string_view(d.nb)
        have = contains(cur[ds as usize .. cur.len], string_view(probe))
    }
    if !have {
        let start_empty: bool = dc_len(d) == ds
        if start_empty { string_push(d.nb, "|") }
        string_push(d.nb, cty)
        string_push(d.nb, "|")
    }
    string_free(probe)
}

// Resolve the `di`-th dep of region [ds, de) to a segment index: the LAST segment whose name
// matches (mirrors `by_name`'s insert-overwrite), -1 if no segment defines it, -2 if `di` is
// past the region's last dep.
fn dc_find_dep(mut d: Dc, ds: i32, de: i32, di: i32, n: i32) -> i32 {
    if de <= ds { return 0 - 2 }
    let nb: str = string_view(d.nb)
    var idx: i32 = 0
    var ts: i32 = ds + 1
    var fs: i32 = 0 - 1
    var fe: i32 = 0 - 1
    var i: i32 = ds + 1
    for i < de {
        if (nb[i as usize] as i32) == 124 {           // '|'
            if idx == di {
                fs = ts
                fe = i
            }
            idx = idx + 1
            ts = i + 1
        }
        i = i + 1
    }
    if fs < 0 { return 0 - 2 }
    var best: i32 = 0 - 1
    var s: i32 = 0
    for s < n {
        let b6: i32 = s * 6
        let ns: i32 = list.get(i32, d.segs, (b6 + 2) as usize)
        let ne: i32 = list.get(i32, d.segs, (b6 + 3) as usize)
        if ne > ns {
            if str_eq(nb[ns as usize .. ne as usize], nb[fs as usize .. fe as usize]) { best = s }
        }
        s = s + 1
    }
    return best
}

// End the capture window and emit the collected segments in a topological order — an iterative
// post-order DFS (deps before dependents), stable in segment order, exactly the reference's.
fn dc_flush(mut sb: String, mut d: Dc, read cap: str, read a: Allocator) {
    dc_glue(d, cap.len as i32)                        // trailing text after the last segment
    let n: i32 = (list.len(i32, d.segs) / 6) as i32
    var state: List(i32) = list.make(i32, a)          // 0 = unvisited, 1 = on stack, 2 = done
    var i: i32 = 0
    for i < n {
        list.push(i32, state, 0)
        i = i + 1
    }
    var order: List(i32) = list.make(i32, a)
    var stack: List(i32) = list.make(i32, a)          // (node, next-dep-index) pairs
    var root: i32 = 0
    for root < n {
        if list.get(i32, state, root as usize) != 0 {
            root = root + 1
            continue
        }
        list.set(i32, state, root as usize, 1)
        list.truncate(i32, stack, 0)
        list.push(i32, stack, root)
        list.push(i32, stack, 0)
        for list.len(i32, stack) > 0 {
            let top: usize = list.len(i32, stack) - 2
            let node: i32 = list.get(i32, stack, top)
            let di: i32 = list.get(i32, stack, top + 1)
            let b6: i32 = node * 6
            let dep_s: i32 = list.get(i32, d.segs, (b6 + 4) as usize)
            let dep_e: i32 = list.get(i32, d.segs, (b6 + 5) as usize)
            let j: i32 = dc_find_dep(d, dep_s, dep_e, di, n)
            if j == 0 - 2 {                           // deps exhausted: emit, pop
                list.push(i32, order, node)
                list.set(i32, state, node as usize, 2)
                list.truncate(i32, stack, top)
            } else {
                list.set(i32, stack, top + 1, di + 1)
                if j >= 0 {
                    if list.get(i32, state, j as usize) == 0 {
                        list.set(i32, state, j as usize, 1)
                        list.push(i32, stack, j)
                        list.push(i32, stack, 0)
                    }
                }
            }
        }
        root = root + 1
    }
    var oi: usize = 0
    for oi < list.len(i32, order) {
        let b6: i32 = list.get(i32, order, oi) * 6
        let bs: i32 = list.get(i32, d.segs, b6 as usize)
        let be: i32 = list.get(i32, d.segs, (b6 + 1) as usize)
        string_push(sb, cap[bs as usize .. be as usize])
        oi = oi + 1
    }
    list.free(i32, state)
    list.free(i32, order)
    list.free(i32, stack)
}

fn emit_struct_defs(mut sb: String, read p: parser.Parser, read src: str, mut d: Dc) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 {
            let ns: i32 = dc_len(d)                   // segment name: Jestyr_<name>
            string_push(d.nb, "Jestyr_")
            string_push(d.nb, src[it.x .. it.y])
            let ne: i32 = dc_len(d)
            var m0: i32 = 0                           // by-value field deps (unions too — the
            for m0 < it.b {                           // reference collects them the same)
                let b0: i32 = it.a + m0 * 10
                if list.get(i32, p.mar, b0 as usize) == 0 {
                    var fc0: String = string_new()
                    emit_c_ty(fc0, p, src, list.get(i32, p.mar, (b0 + 4) as usize))
                    dc_dep(d, ne, string_view(fc0))
                    string_free(fc0)
                }
                m0 = m0 + 1
            }
            dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
            if it.op == 2 { string_push(sb, "union") } else { string_push(sb, "struct") }
            emit_struct_attr(sb, p, src, it)          // `@packed`/`@align(n)` -> __attribute__((…))
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " {\n")
            la_emit_fields(sb, p, src, it)            // declaration order, or `@layout(auto)`'s
            string_push(sb, "};\n\n")
            dc_end(d, sb_len(sb))
        }
        r = r + 1
    }
}

// Enum definitions (mirrors Cgen::enum_defs): a tag enum `enum Jestyr_<E>_tag { … };` (variant
// discriminants set explicit values) then `struct Jestyr_<E> { enum … tag; [union { … } u;] };`.
// The payload union appears only if some variant has fields. Non-generic enums only (a generic
// enum is a template; niche-opt is deferred). Each ends `};\n\n`.
fn emit_enum_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, mut d: Dc) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 and it.a == 0 and niche_named_some(p, iid) < 0 {   // non-generic, non-niche enum
            let en: str = src[it.x .. it.y]
            let ns: i32 = dc_len(d)                   // segment name: Jestyr_<E>
            string_push(d.nb, "Jestyr_")
            string_push(d.nb, en)
            let ne: i32 = dc_len(d)
            var k0: i32 = 0                           // by-value payload field deps, all variants
            for k0 < it.z {
                let vb0: i32 = it.b + k0 * 5
                let fc0: i32 = list.get(i32, p.ear, (vb0 + 3) as usize)
                let fs0: i32 = list.get(i32, p.ear, (vb0 + 2) as usize)
                var fi0: i32 = 0
                for fi0 < fc0 {
                    var ft0: String = string_new()
                    emit_c_ty(ft0, p, src, list.get(i32, p.ear, (fs0 + fi0 * 3 + 2) as usize))
                    dc_dep(d, ne, string_view(ft0))
                    string_free(ft0)
                    fi0 = fi0 + 1
                }
                k0 = k0 + 1
            }
            dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
            string_push(sb, "enum Jestyr_")
            string_push(sb, en)
            string_push(sb, "_tag {\n")
            var any_payload: bool = false
            var k: i32 = 0
            for k < it.z {
                let vb: i32 = it.b + k * 5
                let vns: i32 = list.get(i32, p.ear, vb as usize)
                let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                let disc: i32 = list.get(i32, p.ear, (vb + 4) as usize)
                if list.get(i32, p.ear, (vb + 3) as usize) > 0 { any_payload = true }
                string_push(sb, "    Jestyr_")
                string_push(sb, en)
                string_push(sb, "_")
                string_push(sb, src[vns as usize .. vne as usize])
                if disc >= 0 {
                    string_push(sb, " = ")
                    emit_expr(sb, p, src, c, g, disc)
                }
                string_push(sb, ",\n")
                k = k + 1
            }
            string_push(sb, "};\n")
            string_push(sb, "struct Jestyr_")
            string_push(sb, en)
            string_push(sb, " {\n    enum Jestyr_")
            string_push(sb, en)
            string_push(sb, "_tag tag;\n")
            if any_payload {
                string_push(sb, "    union {\n")
                var k2: i32 = 0
                for k2 < it.z {
                    let vb: i32 = it.b + k2 * 5
                    let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                    if fc > 0 {
                        let vns: i32 = list.get(i32, p.ear, vb as usize)
                        let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                        let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)   // field 3-tuple base
                        string_push(sb, "        struct { ")
                        var fi: i32 = 0
                        for fi < fc {
                            let fb: i32 = fs + fi * 3
                            emit_c_ty(sb, p, src, list.get(i32, p.ear, (fb + 2) as usize))   // field type
                            string_push(sb, " j_")
                            string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                            string_push(sb, "; ")
                            fi = fi + 1
                        }
                        string_push(sb, "} ")
                        string_push(sb, src[vns as usize .. vne as usize])
                        string_push(sb, ";\n")
                    }
                    k2 = k2 + 1
                }
                string_push(sb, "    } u;\n")
            }
            string_push(sb, "};\n\n")
            dc_end(d, sb_len(sb))
        }
        r = r + 1
    }
}

// Forward typedefs for monomorphized generic-enum instances (mirrors `gen_forward_types`):
// `typedef struct <N> <N>;` each, + a trailing blank only if any (a CONDITIONAL blank, unlike
// forward_types'). Generic-STRUCT instances join when comptime-ctor structs are ported.
fn emit_gen_forward_types(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var any: bool = false
    var sk: usize = 0
    for sk < list.len(i32, g.gsi) {                   // struct instances first (reference order)
        let stid: i32 = list.get(i32, g.gsi, sk)
        string_push(sb, "typedef struct ")
        emit_ty_c(sb, p, src, c, stid)
        string_push(sb, " ")
        emit_ty_c(sb, p, src, c, stid)
        string_push(sb, ";\n")
        any = true
        sk = sk + 1
    }
    var k: usize = 0
    for k < list.len(i32, g.gei) {
        let tid: i32 = list.get(i32, g.gei, k)
        if niche_inst_some(p, src, c, tid) < 0 {      // a niche instance IS its pointer — no typedef
            string_push(sb, "typedef struct ")
            emit_ty_c(sb, p, src, c, tid)
            string_push(sb, " ")
            emit_ty_c(sb, p, src, c, tid)
            string_push(sb, ";\n")
            any = true
        }
        k = k + 1
    }
    if any { string_push(sb, "\n") }
}

// Generic-enum instance definitions (mirrors `gen_enum_defs`/`emit_enum_instance`): per collected
// instance, the tag enum + tagged-union struct under the instance name, with each payload field
// type run through the tparam->arg substitution.
fn emit_gen_enum_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, mut d: Dc) {
    var k: usize = 0
    for k < list.len(i32, g.gei) {
        let tid: i32 = list.get(i32, g.gei, k)
        if niche_inst_some(p, src, c, tid) >= 0 { k = k + 1  continue }   // niche: no tag/union def
        let eit: i32 = genum_item_of(p, src, c, tid)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
        let ns: i32 = dc_len(d)                       // segment name: the instance's C name
        emit_ty_c(d.nb, p, src, c, tid)
        let ne: i32 = dc_len(d)
        var k0: i32 = 0                               // substituted payload field deps
        for k0 < it.z {
            let vb0: i32 = it.b + k0 * 5
            let fc0: i32 = list.get(i32, p.ear, (vb0 + 3) as usize)
            let fs0: i32 = list.get(i32, p.ear, (vb0 + 2) as usize)
            var fi0: i32 = 0
            for fi0 < fc0 {
                var ft0: String = string_new()
                emit_field_ty_subst(ft0, p, src, c, list.get(i32, p.ear, (fs0 + fi0 * 3 + 2) as usize), eit, tid)
                dc_dep(d, ne, string_view(ft0))
                string_free(ft0)
                fi0 = fi0 + 1
            }
            k0 = k0 + 1
        }
        dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
        string_push(sb, "enum ")
        emit_ty_c(sb, p, src, c, tid)
        string_push(sb, "_tag {\n")
        var any_payload: bool = false
        var v: i32 = 0
        for v < it.z {
            let vb: i32 = it.b + v * 5
            if list.get(i32, p.ear, (vb + 3) as usize) > 0 { any_payload = true }
            string_push(sb, "    ")
            emit_ty_c(sb, p, src, c, tid)
            string_push(sb, "_")
            string_push(sb, src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize])
            let disc: i32 = list.get(i32, p.ear, (vb + 4) as usize)
            if disc >= 0 {
                string_push(sb, " = ")
                emit_expr(sb, p, src, c, g, disc)
            }
            string_push(sb, ",\n")
            v = v + 1
        }
        string_push(sb, "};\n")
        string_push(sb, "struct ")
        emit_ty_c(sb, p, src, c, tid)
        string_push(sb, " {\n    enum ")
        emit_ty_c(sb, p, src, c, tid)
        string_push(sb, "_tag tag;\n")
        if any_payload {
            string_push(sb, "    union {\n")
            var v2: i32 = 0
            for v2 < it.z {
                let vb: i32 = it.b + v2 * 5
                let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                if fc > 0 {
                    let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
                    string_push(sb, "        struct { ")
                    var fi: i32 = 0
                    for fi < fc {
                        let fb: i32 = fs + fi * 3
                        emit_field_ty_subst(sb, p, src, c, list.get(i32, p.ear, (fb + 2) as usize), eit, tid)
                        string_push(sb, " j_")
                        string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                        string_push(sb, "; ")
                        fi = fi + 1
                    }
                    string_push(sb, "} ")
                    string_push(sb, src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize])
                    string_push(sb, ";\n")
                }
                v2 = v2 + 1
            }
            string_push(sb, "    } u;\n")
        }
        string_push(sb, "};\n\n")
        dc_end(d, sb_len(sb))
        k = k + 1
    }
}

// Slice typedefs: one `typedef struct { <ecty>* ptr; size_t len; } JestyrSlice_<m>;` per distinct
// concrete element type, discovered like `collect_slices` — the type arena's `[]T` annotations
// first, then `slice(T, …)` construction calls — deduped by mangle, + a trailing blank if any.
// (Monomorphized-generic contributions arrive with generics.)
fn emit_slice_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut d: Dc) {
    var seen: String = string_new()
    var any: bool = false
    var i: usize = 0
    for i < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, i)
        if t.kind == 3 { any = emit_one_slice_def(sb, p, src, c, t.a, seen, d) or any }
        i = i + 1
    }
    var e2: usize = 0
    for e2 < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, e2)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "slice") {
                    if e.y >= 1 {
                        let a0: i32 = list.get(i32, p.ar, e.x as usize)
                        let ax: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
                        if ax.kind == 2 { any = emit_one_slice_name(sb, src, c, src[ax.start .. ax.end], seen, d) or any }
                    }
                }
            }
        }
        e2 = e2 + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// One slice typedef from an AST element-type node (a concrete Name only, for now). Returns
// whether a typedef was emitted; `seen` accumulates `|mangle|` markers for dedup.
fn emit_one_slice_def(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, elem_ty: i32, mut seen: String, mut d: Dc) -> bool {
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, elem_ty as usize)
    if t.kind != 0 { return false }                   // structural elems arrive later
    return emit_one_slice_name(sb, src, c, src[t.start .. t.end], seen, d)
}

// One slice typedef for element-name `nm` (a prim or a declared type; anything else — e.g. a
// generic `T` — is an opaque template, skipped like the reference's `is_concrete`). Emitted as a
// NAMED segment: this phase runs AFTER the aggregate phase, so a struct with a slice-typed field
// (which embeds `JestyrSlice_<nm>` by value) can only be reordered behind it if the typedef is a
// segment the sorter can see — glue text is pinned and invisible to `dc_find_dep`.
fn emit_one_slice_name(mut sb: String, read src: str, read c: typeck.Checker, read nm: str, mut seen: String, mut d: Dc) -> bool {
    let pc: str = c_prim(nm)
    if str_eq(pc, "") {
        if !is_declared_type(c, src, nm) { return false }
    }
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, nm)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    let ns: i32 = dc_len(d)                           // segment name: JestyrSlice_<nm>. A slice is
    string_push(d.nb, "JestyrSlice_")                 // `{ E* ptr; len }` — it embeds E only through
    string_push(d.nb, nm)                             // a POINTER, so it has NO by-value dep (an
    let ne: i32 = dc_len(d)                           // empty dep region: ds == de == ne).
    dc_begin(d, sb_len(sb), ns, ne, ne, ne)
    string_push(sb, "typedef struct { ")
    if str_eq(pc, "") { string_push(sb, "Jestyr_")  string_push(sb, nm) } else { string_push(sb, pc) }
    string_push(sb, "* ptr; size_t len; } JestyrSlice_")
    string_push(sb, nm)
    string_push(sb, ";\n")
    dc_end(d, sb_len(sb))
    return true
}

// Is `nm` a declared (Named) type in the Checker's table?
fn is_declared_type(read c: typeck.Checker, read src: str, read nm: str) -> bool {
    var r: i32 = 0
    for r < (list.len(i32, c.tdecl) / 10) as i32 {
        let ns: i32 = list.get(i32, c.tdecl, (r * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (r * 10 + 1) as usize)
        if str_eq(nm, src[ns as usize .. ne as usize]) { return true }
        r = r + 1
    }
    return false
}

// ---- @simd: the vector lowering (workstream Q, Q-S2) ----
//
// The port mirror of `src/simd.rs`'s classifier plus `emit_par_for`'s vector path. Only
// the ACCEPT/REJECT verdict is mirrored, not the rejection reasons: the port emits no
// diagnostics for `@simd`, so what has to agree byte-for-byte is which sites vectorize.
//
// The whitelist is the reference's, item for item: literals, names, unary neg/not/bitnot,
// binary arithmetic/bitwise/compare/short-circuit, a shift by a literal in 0..=63, an
// `if`/`else`, and a block that is a single tail expression. Division and remainder are
// out because a vector evaluates EVERY lane, so a divisor that is zero in a lane the
// scalar run would have skipped becomes a real fault.

// The single tail expression of a block used as a value, or -1 if it carries statements.
// Mirrors `Cgen::value_tail_of_block`.
fn sd_tail_of(read p: parser.Parser, eid: i32) -> i32 {
    if eid < 0 { return 0 - 1 }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind != 23 { return eid }
    if d.y != 1 { return 0 - 1 }
    let st: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, d.x as usize) as usize)
    if st.kind != 2 { return 0 - 1 }
    return st.a
}

// The same for an `else` operand. A nested `If` is returned whole so an else-if chain
// lowers as nested conditionals; a chain whose arms are not expression-shaped is refused.
fn sd_tail_of_expr(read p: parser.Parser, eid: i32) -> i32 {
    if eid < 0 { return 0 - 1 }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind == 23 { return sd_tail_of(p, eid) }
    if d.kind == 24 {
        if sd_tail_of(p, d.b) < 0 { return 0 - 1 }
        if d.op < 0 { return 0 - 1 }
        if sd_tail_of_expr(p, d.op) < 0 { return 0 - 1 }
        return eid
    }
    return eid
}

// Is `eid` a certified vectorizable body? Mirrors `simd::classify`.
fn sd_classify(read p: parser.Parser, read src: str, eid: i32) -> bool {
    if eid < 0 { return false }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind == 0 { return true }                     // Int
    if d.kind == 27 { return true }                    // Bool
    if d.kind == 2 { return true }                     // Name: loop var or loop-invariant
    if d.kind == 3 {                                   // Unary
        if d.op == 4 { return false }                  // `&` is memory
        return sd_classify(p, src, d.a)
    }
    if d.kind == 4 {                                   // Binary
        if d.op == 4 { return false }                  // `/` can fault
        if d.op == 5 { return false }                  // `%` can fault
        if d.op == 17 or d.op == 18 {                  // shifts: literal amount only
            if sd_small_shift(p, src, d.b) == false { return false }
            return sd_classify(p, src, d.a)
        }
        if sd_classify(p, src, d.a) == false { return false }
        return sd_classify(p, src, d.b)
    }
    if d.kind == 24 {                                  // If: an `else` is required
        if d.op < 0 { return false }
        if sd_classify(p, src, d.a) == false { return false }
        if sd_classify(p, src, d.b) == false { return false }
        return sd_classify(p, src, d.op)
    }
    if d.kind == 23 {                                  // Block: a single tail expression
        if d.y != 1 { return false }
        let sid: i32 = list.get(i32, p.sar, d.x as usize)
        let st: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        if st.kind == 0 { return false }               // Let
        if st.kind == 1 { return false }               // Return
        return sd_classify(p, src, st.a)
    }
    return false
}

// A shift amount that is defined in both the scalar and the lane form: a decimal literal
// below 64. Anything else is refused rather than guessed at.
fn sd_small_shift(read p: parser.Parser, read src: str, eid: i32) -> bool {
    if eid < 0 { return false }
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind != 0 { return false }
    let t: str = src[d.start .. d.end]
    var v: i64 = 0
    var i: usize = 0
    for i < t.len {
        let c: i32 = t[i] as i32
        if c == 95 { i = i + 1 } else {
            if c < 48 { return false }
            if c > 57 { return false }
            v = v * 10 + ((c - 48) as i64)
            if v > 63 { return false }
            i = i + 1
        }
    }
    return v < 64
}

// Record every `par for` an `@simd` function declares AND the classifier certifies.
// Span containment finds them, exactly as `sites_in_span` does on the reference side:
// the expression arena is flat and spans nest, so no walker needs maintaining.
fn sd_collect(mut g: Cg, read p: parser.Parser, read src: str) {
    let ne: usize = list.len(parser.ExprData, p.ex)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if item_has_attr(p, src, it, "simd") {
                if it.w >= 0 {
                    let bd: parser.ExprData = list.get(parser.ExprData, p.ex, it.w as usize)
                    var e: usize = 0
                    for e < ne {
                        let d: parser.ExprData = list.get(parser.ExprData, p.ex, e)
                        if d.kind == 41 {
                            if d.start >= bd.start {
                                if d.end <= bd.end {
                                    if sd_classify(p, src, d.op) { list.push(i32, g.sds, e as i32) }
                                }
                            }
                        }
                        e = e + 1
                    }
                }
            }
        }
        r = r + 1
    }
}

fn sd_is_site(read g: Cg, eid: i32) -> bool {
    var i: usize = 0
    for i < list.len(i32, g.sds) {
        if list.get(i32, g.sds, i) == eid { return true }
        i = i + 1
    }
    return false
}

// Does C's integer promotion widen this element type? Mirrors `simd_compute_elem` on the
// reference side, and exists for the same reason: a `par for` emits a vector head AND a
// scalar remainder from one source expression, and in the remainder the loop variable is a
// real `int8_t`, so C promotes it -- `j_x * j_x` is computed in `int` and only then
// narrowed. GNU vector arithmetic has no such rule, it is elementwise at the vector's own
// element type. Lower a `[]i8` body into `int8_t` lanes and the two halves of one loop
// compute in different widths: `33 * 33` is `1089` in the remainder and `65` in the head.
//
// All four narrow types promote to SIGNED `int`, because `int` represents every value of
// each -- including the unsigned two, which is why `~x` over `[]u8` must give `-34`, not
// `222`. The cost is density: a `[]i8` body gets 8 lanes, not 32, the same as `i32`. Paying
// it is not optional while Jestyr's own scalar arithmetic promotes -- `(a * a) as i64` for
// `a: i8 = 33` is `1089` today, not `65`, whatever the type checker calls the product.
fn sd_is_promoted(read c: typeck.Checker, ety: i32) -> bool {
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, ety as usize)
    if d.x == 0 { return true }                        // i8
    if d.x == 5 { return true }                        // u8
    if d.x == 1 { return true }                        // i16
    if d.x == 6 { return true }                        // u16
    return false
}

// The vector typedef NAME for a site's element: `JestyrVec_i32` for every promoted element,
// so a `[]i8` site and a `[]i32` site share one typedef exactly as they do on the reference
// side, and the dedup in `sd_vector_defs` collapses them.
fn sd_push_vec_name(mut sb: String, read src: str, read c: typeck.Checker, ety: i32) {
    string_push(sb, "JestyrVec_")
    if sd_is_promoted(c, ety) { string_push(sb, "i32") }
    else { push_ty_mangle(sb, src, c, ety) }
}

// How many source elements one vector iteration covers -- the lane count of the COMPUTE
// element, never the source element's own width. A `[]i8` loop is 8 lanes wide, not 32;
// reading the lane count straight off the source width is what made a `[]i8` reduction
// return the wrong answer.
fn sd_lanes(read c: typeck.Checker, ety: i32) -> i32 {
    if sd_is_promoted(c, ety) { return 8 }             // promoted to int32_t lanes
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, ety as usize)
    if d.x == 2 { return 8 }                           // i32
    if d.x == 7 { return 8 }                           // u32
    return 4
}

// The certified body with the loop variable bound to a VECTOR. Mirrors `emit_expr_simd`.
// A comparison yields an all-ones lane mask rather than 0/1, so `and`/`or` are bitwise,
// and the conditional operator does not exist on vectors, so an `if` is a mask blend.
fn sd_emit(mut sb: String, read p: parser.Parser, read src: str, eid: i32, read vt: str, read lv: str, read vv: str) {
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if d.kind == 0 {                                   // Int literal, `_` separators dropped
        var i: usize = d.start
        for i < d.end {
            if (src[i] as i32) != 95 { string_push(sb, src[i .. i + 1]) }
            i = i + 1
        }
        return
    }
    if d.kind == 27 {                                  // Bool: built as a lane mask
        if str_eq(src[d.start .. d.end], "true") {
            string_push(sb, "((")  string_push(sb, vt)  string_push(sb, "){0} == (")
            string_push(sb, vt)  string_push(sb, "){0})")
        } else {
            string_push(sb, "((")  string_push(sb, vt)  string_push(sb, "){0} != (")
            string_push(sb, vt)  string_push(sb, "){0})")
        }
        return
    }
    if d.kind == 2 {                                   // Name
        if str_eq(src[d.start .. d.end], lv) { string_push(sb, vv) }
        else {
            string_push(sb, "j_")
            string_push(sb, src[d.start .. d.end])
        }
        return
    }
    if d.kind == 3 {                                   // Unary: `not` is a complement here
        string_push(sb, "(")
        if d.op == 1 { string_push(sb, "-") } else { string_push(sb, "~") }
        sd_emit(sb, p, src, d.a, vt, lv, vv)
        string_push(sb, ")")
        return
    }
    if d.kind == 4 {                                   // Binary
        string_push(sb, "(")
        sd_emit(sb, p, src, d.a, vt, lv, vv)
        string_push(sb, " ")
        string_push(sb, sd_op(d.op))
        string_push(sb, " ")
        sd_emit(sb, p, src, d.b, vt, lv, vv)
        string_push(sb, ")")
        return
    }
    if d.kind == 24 {                                  // If -> mask blend
        string_push(sb, "(((")
        sd_emit(sb, p, src, d.b, vt, lv, vv)           // then
        string_push(sb, ") & (")
        sd_emit(sb, p, src, d.a, vt, lv, vv)           // cond
        string_push(sb, ")) | ((")
        sd_emit(sb, p, src, d.op, vt, lv, vv)          // else
        string_push(sb, ") & ~(")
        sd_emit(sb, p, src, d.a, vt, lv, vv)
        string_push(sb, ")))")
        return
    }
    if d.kind == 23 {                                  // Block: its single tail expression
        let sid: i32 = list.get(i32, p.sar, d.x as usize)
        let st: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        sd_emit(sb, p, src, st.a, vt, lv, vv)
        return
    }
    string_push(sb, "0")
}

// A BinOp code as its vector-C spelling. Short-circuit becomes a blend, which is
// value-preserving only because the certified subset is total.
fn sd_op(op: i32) -> str {
    if op == 1 { return "+" }
    if op == 2 { return "-" }
    if op == 3 { return "*" }
    if op == 6 { return "==" }
    if op == 7 { return "!=" }
    if op == 8 { return "<" }
    if op == 9 { return "<=" }
    if op == 10 { return ">" }
    if op == 11 { return ">=" }
    if op == 12 { return "&" }
    if op == 13 { return "|" }
    if op == 14 { return "&" }
    if op == 15 { return "|" }
    if op == 16 { return "^" }
    if op == 17 { return "<<" }
    if op == 18 { return ">>" }
    return "+"
}

// The vector lowering for one certified site: a lane-at-a-time head, then the SCALAR
// remainder. The remainder genuinely must be scalar — a mask blend is not a conditional
// and a lane comparison is not 0/1 — which is the bug Q-S1's oracle caught in its own
// harness. Mirrors the vector branch of `emit_par_for`.
// `pfn` is the temp the CALLER already took — taking another here would number the
// port's temps one ahead of the reference's, which is how this first showed up.
fn sd_emit_par_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, eid: i32, ety: i32, pfn: i32) {
    let w: i32 = sd_lanes(c, ety)
    // The vector computes in the element's PROMOTED type, because the scalar remainder
    // below does -- see `sd_is_promoted`. For an element C does not promote this is the
    // element itself, so every program that vectorized before emits the same C it did.
    var vt: String = string_new()
    sd_push_vec_name(vt, src, c, ety)
    let vts: str = string_view(vt)
    var vv: String = string_new()
    string_push(vv, "_pv")
    push_uint(vv, pfn as i64)
    let vvs: str = string_view(vv)

    string_push(sb, "({ JestyrSlice_")
    push_ty_mangle(sb, src, c, ety)
    string_push(sb, " _pf")
    push_uint(sb, pfn as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, e.a)                  // iter
    string_push(sb, "; int64_t* _pm")
    push_uint(sb, pfn as i64)
    string_push(sb, " = (int64_t*)malloc(_pf")
    push_uint(sb, pfn as i64)
    string_push(sb, ".len * sizeof(int64_t)); size_t _pi")
    push_uint(sb, pfn as i64)
    string_push(sb, " = 0; for (; _pi")
    push_uint(sb, pfn as i64)
    string_push(sb, " + ")
    push_uint(sb, w as i64)
    string_push(sb, " <= _pf")
    push_uint(sb, pfn as i64)
    string_push(sb, ".len; _pi")
    push_uint(sb, pfn as i64)
    string_push(sb, " += ")
    push_uint(sb, w as i64)
    string_push(sb, ") { ")
    string_push(sb, vts)
    string_push(sb, " ")
    string_push(sb, vvs)
    // The load. A promoted element is widened lane by lane -- the conversion is
    // value-preserving and is the same one the remainder's promotion performs. An
    // unpromoted element is copied as raw bytes, the byte-identical status quo. A
    // `memcpy` of `sizeof(JestyrVec_i32)` over a `[]i8` would read 32 BYTES into 8 lanes,
    // reinterpreting four source elements per lane, so this branch is not an optimization.
    if sd_is_promoted(c, ety) {
        string_push(sb, "; for (size_t _pl")
        push_uint(sb, pfn as i64)
        string_push(sb, " = 0; _pl")
        push_uint(sb, pfn as i64)
        string_push(sb, " < ")
        push_uint(sb, w as i64)
        string_push(sb, "; _pl")
        push_uint(sb, pfn as i64)
        string_push(sb, "++) ")
        string_push(sb, vvs)
        string_push(sb, "[_pl")
        push_uint(sb, pfn as i64)
        string_push(sb, "] = _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".ptr[_pi")
        push_uint(sb, pfn as i64)
        string_push(sb, " + _pl")
        push_uint(sb, pfn as i64)
        string_push(sb, "]; ")
    } else {
        string_push(sb, "; memcpy(&")
        string_push(sb, vvs)
        string_push(sb, ", _pf")
        push_uint(sb, pfn as i64)
        string_push(sb, ".ptr + _pi")
        push_uint(sb, pfn as i64)
        string_push(sb, ", sizeof(")
        string_push(sb, vts)
        string_push(sb, ")); ")
    }
    string_push(sb, vts)
    string_push(sb, " _pw")
    push_uint(sb, pfn as i64)
    string_push(sb, " = ((")
    string_push(sb, vts)
    string_push(sb, "){0}) + (")
    // The reduction is emitted BEFORE the body on the reference side (temp ordering).
    var prd: String = string_new()
    emit_expr(prd, p, src, c, g, e.b)
    sd_emit(sb, p, src, e.op, vts, src[e.x as usize .. e.y as usize], vvs)
    string_push(sb, "); for (size_t _pk")
    push_uint(sb, pfn as i64)
    string_push(sb, " = 0; _pk")
    push_uint(sb, pfn as i64)
    string_push(sb, " < ")
    push_uint(sb, w as i64)
    string_push(sb, "; _pk")
    push_uint(sb, pfn as i64)
    string_push(sb, "++) _pm")
    push_uint(sb, pfn as i64)
    string_push(sb, "[_pi")
    push_uint(sb, pfn as i64)
    string_push(sb, " + _pk")
    push_uint(sb, pfn as i64)
    string_push(sb, "] = (int64_t)_pw")
    push_uint(sb, pfn as i64)
    string_push(sb, "[_pk")
    push_uint(sb, pfn as i64)
    string_push(sb, "]; } for (; _pi")
    push_uint(sb, pfn as i64)
    string_push(sb, " < _pf")
    push_uint(sb, pfn as i64)
    string_push(sb, ".len; _pi")
    push_uint(sb, pfn as i64)
    string_push(sb, "++) { ")
    emit_ty_c(sb, p, src, c, ety)
    string_push(sb, " j_")
    string_push(sb, src[e.x as usize .. e.y as usize])
    string_push(sb, " = _pf")
    push_uint(sb, pfn as i64)
    string_push(sb, ".ptr[_pi")
    push_uint(sb, pfn as i64)
    string_push(sb, "]; _pm")
    push_uint(sb, pfn as i64)
    string_push(sb, "[_pi")
    push_uint(sb, pfn as i64)
    string_push(sb, "] = ")
    let bty: i32 = list.get(i32, c.et, e.op as usize)
    let widen: bool = ty_is_i64(c, bty) == false
    if widen { string_push(sb, "(int64_t)(") }
    emit_expr(sb, p, src, c, g, e.op)
    if widen { string_push(sb, ")") }
    string_push(sb, "; } int64_t _pr")
    push_uint(sb, pfn as i64)
    string_push(sb, " = jestyr_par_reduce((JestyrSlice_i64){ _pm")
    push_uint(sb, pfn as i64)
    string_push(sb, ", _pf")
    push_uint(sb, pfn as i64)
    string_push(sb, ".len }, ")
    string_push(sb, string_view(prd))
    string_push(sb, "); free(_pm")
    push_uint(sb, pfn as i64)
    string_push(sb, "); _pr")
    push_uint(sb, pfn as i64)
    string_push(sb, "; })")
    string_free(prd)
    string_free(vt)
    string_free(vv)
}

// One `typedef E JestyrVec_E __attribute__((vector_size(32)));` per element type a
// vectorized `par for` iterates, in the sites' first-seen order.
//
// Dedup is by the MANGLED NAME, not the TyId — the trap this cost a gate run to find.
// The checker allocates a fresh `TyData` row per occurrence, so two `[]i32` sites carry
// two different ids for the same type, and an id-keyed `seen` emits the typedef twice.
// It happened to agree in normal mode (where both sites landed on one row) and diverged
// only in TEST mode, where the harness's extra code shifts the arena — a reminder that
// "the ids matched" is not the same as "the types are the same".

// ── `par for … reduce` fusion (mirrors `collect_par_fusions` / `par_fusion_workers`) ──
//
// The default lowering maps the body SERIALLY into a full-size int64 temporary and
// hands that to `core.par_reduce`, so the body -- the actual work -- runs on one
// thread while four threads do a trivial `+` over a freshly written array. Fusion
// emits a per-site worker that folds its own chunk of the SOURCE with the body
// inlined: no temporary, and the body runs on all four threads.
//
// Determinism is preserved by construction: the chunk boundaries are
// `core.par_reduce`'s exactly (`q = n / 4`, last chunk takes the remainder) and the
// four slots merge with `combine` from `identity` in the same fixed 0,1,2,3 order.
// Same grouping and same merge order, so the result is bit-identical for any
// reduction on any schedule.
//
// `g.pfs` holds the eids of fusable sites in ASCENDING order, so a site's POSITION
// in the list is its worker index -- the same index the reference assigns by sorting
// on ExprId. That is what makes the two implementations agree structurally rather
// than by two traversal orders happening to match. `g.pfb`/`g.pfo` carry each site's
// lowered body, emitted ONCE during collection (exactly as the reference stores
// `ParFusion::contrib`) so the worker section does not re-run `emit_expr` and shift
// every later temporary number.

fn pf_is_ident_byte(b: i32) -> bool {
    if b >= 48 { if b <= 57 { return true } }         // 0-9
    if b >= 65 { if b <= 90 { return true } }         // A-Z
    if b >= 97 { if b <= 122 { return true } }        // a-z
    if b == 95 { return true }                        // _
    return false
}

// Does this lowered body mention no value name other than the loop variable?
// Mirrors `body_mentions_only_loop_var`: a fused body runs in a hoisted worker that
// cannot see the enclosing frame, so a reference to an enclosing local (or a const,
// which a local may legally shadow) is not fusable without capture analysis. Field
// selectors (`.j_f`, `->j_f`) are fine -- selectors on a value, not scope lookups.
fn pf_body_only_var(read body: str, read vname: str) -> bool {
    let n: usize = body.len
    var i: usize = 0
    for i + 1 < n {
        var isj: bool = false
        if (body[i] as i32) == 106 {                  // 'j'
            if (body[i + 1] as i32) == 95 { isj = true }   // '_'
        }
        if isj {
            var prev: i32 = 0 - 1
            if i > 0 { prev = body[i - 1] as i32 }
            var skip: bool = false
            if prev >= 0 {
                if pf_is_ident_byte(prev) { skip = true }   // inside a longer identifier
                if prev == 46 { skip = true }               // '.' field selector
                if prev == 62 { skip = true }               // '>' through `->`
            }
            if skip == false {
                var j: usize = i + 2
                for j < n {
                    if pf_is_ident_byte(body[j] as i32) == false { break }
                    j = j + 1
                }
                if str_eq(body[i .. j], vname) == false { return false }
            }
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return true
}

// The worker index of a fused site, or -1. Position in `g.pfs` IS the index.
fn pf_index_of(read g: Cg, eid: i32) -> i32 {
    var i: usize = 0
    for i < list.len(i32, g.pfs) {
        if list.get(i32, g.pfs, i) == eid { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}

// Consider one `par for` site for fusion. Lowers the body exactly as the worker will
// and judges the RESULT -- the same textual rule on the same text as the reference.
// `g.tmp` is restored either way, so a rejected trial leaves the ordinary lowering
// numbering its temporaries exactly as it always has.
fn pf_try(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read d: parser.ExprData, eid: i32) {
    let saved_tmp: i32 = g.tmp
    var body: String = string_new()
    let bty: i32 = list.get(i32, c.et, d.op as usize)
    let widen: bool = ty_is_i64(c, bty) == false
    if widen { string_push(body, "(int64_t)(") }
    emit_expr(body, p, src, c, g, d.op)
    if widen { string_push(body, ")") }
    var vname: String = string_new()
    string_push(vname, "j_")
    string_push(vname, src[d.x as usize .. d.y as usize])
    let bs: str = string_view(body)
    let vs: str = string_view(vname)
    if pf_body_only_var(bs, vs) {
        let pb: str = string_view(g.pfb)
        let off: usize = pb.len
        string_push(g.pfb, bs)
        let pb2: str = string_view(g.pfb)
        list.push(i32, g.pfs, eid)
        list.push(i32, g.pfo, off as i32)
        list.push(i32, g.pfo, pb2.len as i32)
    }
    string_free(body)
    string_free(vname)
    g.tmp = saved_tmp
}

// Find every fusable site, in ascending expression order. Mirrors
// `collect_par_fusions`: top-level non-template functions only (a template is
// emitted once per instantiation with a different substitution, so one hoisted
// worker could not serve them all), and never a vectorized site -- `@simd` has its
// own lowering. Must run AFTER `sd_collect`, whose verdicts it consults.
fn pf_collect(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    let ne: usize = list.len(parser.ExprData, p.ex)
    var r: usize = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if fn_is_template(p, it) == false {
                if it.w >= 0 {
                    let bd: parser.ExprData = list.get(parser.ExprData, p.ex, it.w as usize)
                    var e: usize = 0
                    for e < ne {
                        let d: parser.ExprData = list.get(parser.ExprData, p.ex, e)
                        if d.kind == 41 {
                            if d.start >= bd.start {
                                if d.end <= bd.end {
                                    if sd_is_site(g, e as i32) == false {
                                        pf_try(g, p, src, c, d, e as i32)
                                    }
                                }
                            }
                        }
                        e = e + 1
                    }
                }
            }
        }
        r = r + 1
    }
}

// Emit the argument struct and worker for each fused site, before the function
// definitions that name them. The body is INLINED (taken verbatim from `g.pfb`), so
// the C compiler sees straight-line code rather than a call per element; `accfn` is a
// plain C function pointer because it is the same underlying type as the generated
// `JestyrFn_…` typedef and needs no typedef in scope.
fn pf_workers(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg) {
    var i: usize = 0
    for i < list.len(i32, g.pfs) {
        let eid: i32 = list.get(i32, g.pfs, i)
        let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
        let ety: i32 = par_elem_ty(c, d.a)
        let bo: usize = list.get(i32, g.pfo, i * 2) as usize
        let be: usize = list.get(i32, g.pfo, i * 2 + 1) as usize
        let pb: str = string_view(g.pfb)
        string_push(sb, "typedef struct { const ")
        emit_ty_c(sb, p, src, c, ety)
        string_push(sb, "* ptr; size_t lo; size_t hi; int64_t* slot; int64_t ident; int64_t (*accfn)(int64_t, int64_t); } JestyrParArg_")
        push_uint(sb, i as i64)
        string_push(sb, ";\n")
        string_push(sb, "static void* jestyr_parwork_")
        push_uint(sb, i as i64)
        string_push(sb, "(void* _pv)\n{\n    JestyrParArg_")
        push_uint(sb, i as i64)
        string_push(sb, "* _pg = (JestyrParArg_")
        push_uint(sb, i as i64)
        string_push(sb, "*)_pv;\n    int64_t _pacc = _pg->ident;\n    for (size_t _pi = _pg->lo; _pi < _pg->hi; _pi++) {\n        ")
        emit_ty_c(sb, p, src, c, ety)
        string_push(sb, " j_")
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, " = _pg->ptr[_pi];\n        _pacc = _pg->accfn(_pacc, ")
        string_push(sb, pb[bo .. be])
        string_push(sb, ");\n    }\n    *_pg->slot = _pacc;\n    return NULL;\n}\n\n")
        i = i + 1
    }
}

// Emit the fused call site. Keeps the reference's emission ORDER -- iter, reduction,
// then the body (emitted and discarded here, since the worker already carries it) --
// because `emit_expr` consumes temporary numbers and a different order would shift
// every later `_pf<n>` in the file.
fn pf_emit_fused(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, ety: i32, pfn: i32, k: i32) {
    var itb: String = string_new()
    emit_expr(itb, p, src, c, g, e.a)                 // iter
    var rdb: String = string_new()
    emit_expr(rdb, p, src, c, g, e.b)                 // reduction, before the body
    var dead: String = string_new()
    emit_expr(dead, p, src, c, g, e.op)               // body: discarded, but it must
    string_free(dead)                                 // still consume its temp numbers
    let n: i64 = pfn as i64
    let ki: i64 = k as i64
    string_push(sb, "({ JestyrSlice_")
    push_ty_mangle(sb, src, c, ety)
    string_push(sb, " _pf")
    push_uint(sb, n)
    string_push(sb, " = ")
    string_push(sb, string_view(itb))
    string_push(sb, "; ")
    emit_ty_c(sb, p, src, c, list.get(i32, c.et, e.b as usize))
    string_push(sb, " _pd")
    push_uint(sb, n)
    string_push(sb, " = ")
    string_push(sb, string_view(rdb))
    string_push(sb, "; size_t _pn")
    push_uint(sb, n)
    string_push(sb, " = _pf")
    push_uint(sb, n)
    string_push(sb, ".len; size_t _pq")
    push_uint(sb, n)
    string_push(sb, " = _pn")
    push_uint(sb, n)
    string_push(sb, " / 4; int64_t _ps")
    push_uint(sb, n)
    string_push(sb, "[4]; JestyrParArg_")
    push_uint(sb, ki)
    string_push(sb, " _pa")
    push_uint(sb, n)
    string_push(sb, "[4]; pthread_t _pt")
    push_uint(sb, n)
    string_push(sb, "[4]; ")
    var w: i64 = 0
    for w < 4 {
        string_push(sb, "_pa")
        push_uint(sb, n)
        string_push(sb, "[")
        push_uint(sb, w)
        string_push(sb, "] = (JestyrParArg_")
        push_uint(sb, ki)
        string_push(sb, "){ _pf")
        push_uint(sb, n)
        string_push(sb, ".ptr, ")
        pf_push_bound(sb, n, w)                       // lo
        string_push(sb, ", ")
        pf_push_bound(sb, n, w + 1)                   // hi
        string_push(sb, ", &_ps")
        push_uint(sb, n)
        string_push(sb, "[")
        push_uint(sb, w)
        string_push(sb, "], _pd")
        push_uint(sb, n)
        string_push(sb, ".j_identity, _pd")
        push_uint(sb, n)
        string_push(sb, ".j_accumulate }; ")
        w = w + 1
    }
    string_push(sb, "for (int _pw")
    push_uint(sb, n)
    string_push(sb, " = 0; _pw")
    push_uint(sb, n)
    string_push(sb, " < 4; _pw")
    push_uint(sb, n)
    string_push(sb, "++) pthread_create(&_pt")
    push_uint(sb, n)
    string_push(sb, "[_pw")
    push_uint(sb, n)
    string_push(sb, "], NULL, jestyr_parwork_")
    push_uint(sb, ki)
    string_push(sb, ", &_pa")
    push_uint(sb, n)
    string_push(sb, "[_pw")
    push_uint(sb, n)
    string_push(sb, "]); for (int _pw")
    push_uint(sb, n)
    string_push(sb, " = 0; _pw")
    push_uint(sb, n)
    string_push(sb, " < 4; _pw")
    push_uint(sb, n)
    string_push(sb, "++) pthread_join(_pt")
    push_uint(sb, n)
    string_push(sb, "[_pw")
    push_uint(sb, n)
    string_push(sb, "], NULL); int64_t _pr")
    push_uint(sb, n)
    string_push(sb, " = _pd")
    push_uint(sb, n)
    string_push(sb, ".j_identity; for (int _pw")
    push_uint(sb, n)
    string_push(sb, " = 0; _pw")
    push_uint(sb, n)
    string_push(sb, " < 4; _pw")
    push_uint(sb, n)
    string_push(sb, "++) _pr")
    push_uint(sb, n)
    string_push(sb, " = _pd")
    push_uint(sb, n)
    string_push(sb, ".j_combine(_pr")
    push_uint(sb, n)
    string_push(sb, ", _ps")
    push_uint(sb, n)
    string_push(sb, "[_pw")
    push_uint(sb, n)
    string_push(sb, "]); _pr")
    push_uint(sb, n)
    string_push(sb, "; })")
    string_free(itb)
    string_free(rdb)
}

// Chunk boundary `w` of four: 0, q, q+q, q+q+q, then n for w == 4. Spelled as repeated
// addition rather than multiplication because that is exactly how `core.par_reduce`
// writes it, and the whole determinism argument rests on the two agreeing.
fn pf_push_bound(mut sb: String, n: i64, w: i64) {
    if w == 0 { string_push(sb, "0")  return }
    if w == 4 {
        string_push(sb, "_pn")
        push_uint(sb, n)
        return
    }
    var i: i64 = 0
    for i < w {
        if i > 0 { string_push(sb, " + ") }
        string_push(sb, "_pq")
        push_uint(sb, n)
        i = i + 1
    }
}

fn sd_vector_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, read a: Allocator) {
    var seen: String = string_new()
    var any: bool = false
    var i: usize = 0
    for i < list.len(i32, g.sds) {
        let eid: i32 = list.get(i32, g.sds, i)
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
        let ety: i32 = par_elem_ty(c, e.a)
        // Keyed on the VECTOR name, not the source element: a `[]i8` site and a `[]i32`
        // site both ask for `JestyrVec_i32` and must produce one typedef, not two.
        var key: String = string_new()
        string_push(key, "|")
        sd_push_vec_name(key, src, c, ety)
        string_push(key, "|")
        let ks: str = string_view(key)
        let ss: str = string_view(seen)
        if str_contains(ss, ks) == false {
            string_push(seen, ks)
            string_push(sb, "typedef ")
            if sd_is_promoted(c, ety) { string_push(sb, "int32_t") }
            else { emit_ty_c(sb, p, src, c, ety) }
            string_push(sb, " ")
            sd_push_vec_name(sb, src, c, ety)
            string_push(sb, " __attribute__((vector_size(32)));\n")
            any = true
        }
        string_free(key)
        i = i + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// Does `hay` contain `needle`? A local scan — the port has no substring search, and this
// is only ever used on the short delimited key above.
fn str_contains(read hay: str, read needle: str) -> bool {
    if needle.len == 0 { return true }
    if hay.len < needle.len { return false }
    var i: usize = 0
    for i + needle.len <= hay.len {
        var j: usize = 0
        var same: bool = true
        for j < needle.len {
            if (hay[i + j] as i32) != (needle[j] as i32) { same = false  break }
            j = j + 1
        }
        if same { return true }
        i = i + 1
    }
    return false
}

// The element TyId a `par for` iterates: the iterable's element if it is an integer
// primitive, else i64 (the fallback keeps cgen total on a program typeck already
// rejected). Slice is TyData kind 8, array kind 9 — both carry their element in `a`.
//
// Two nines that are NOT the same nine, since they sit two lines apart: the returned `9`
// is the well-known TyId of `i64`, while the `ed.x > 9` test is on the PRIM CODE, whose
// integer range is 0..=9. i64's prim code is 3.
fn par_elem_ty(read c: typeck.Checker, iter: i32) -> i32 {
    let tid: i32 = list.get(i32, c.et, iter as usize)
    if tid < 0 { return 9 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    var et: i32 = 0 - 1
    if d.kind == 8 { et = d.a }
    if d.kind == 9 { et = d.a }
    if et < 0 { return 9 }
    let ed: typeck.TyData = list.get(typeck.TyData, c.tys, et as usize)
    if ed.kind != 2 { return 9 }
    if ed.x > 9 { return 9 }
    return et
}

// Is `id` exactly `i64`? (Prim code 3 — the reduction's own type.)
fn ty_is_i64(read c: typeck.Checker, id: i32) -> bool {
    if id < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, id as usize)
    if d.kind != 2 { return false }
    return d.x == 3
}

// One comptime SCALAR as its C text. A nested list and a unit both render as `0`: neither
// can reach here in a well-formed program (typeck refuses a unit-valued block, and a nested
// aggregate needs an annotation it cannot have in this position), and cgen stays total
// rather than faulting on a program that was already rejected. Mirrors `c_comptime_scalar`.
fn push_ctfe_scalar(mut sb: String, read ci: ctfe.Interp, read v: ctfe.Value) {
    if v.tag == 0 { push_i64(sb, v.i)  return }
    if v.tag == 1 {
        if v.i == 1 { string_push(sb, "true") } else { string_push(sb, "false") }
        return
    }
    if v.tag == 2 {
        string_push(sb, "JSTR(")
        push_c_string(sb, ctfe.str_of(ci, v))
        string_push(sb, ")")
        return
    }
    string_push(sb, "0")
}

// A comptime aggregate as a C BRACE initializer — `{ { 1, 2, 3 } }`, the outer pair for the
// array-wrapper struct and the inner for its `a[]` member. This is the form a `const` needs:
// a static initializer may not contain a statement-expression, so the `({ … })` shape the
// expression path builds would be invalid C at file scope. Mirrors `c_comptime_brace`.
fn push_ctfe_brace(mut sb: String, read ci: ctfe.Interp, read v: ctfe.Value) {
    string_push(sb, "{ { ")
    let n: i64 = ctfe.list_len(ci, v)
    var k: i64 = 0
    for k < n {
        if k > 0 { string_push(sb, ", ") }
        let e: ctfe.Value = ctfe.list_get(ci, v, k)
        if e.tag == 4 { push_ctfe_brace(sb, ci, e) } else { push_ctfe_scalar(sb, ci, e) }
        k = k + 1
    }
    string_push(sb, " } }")
}

// Top-level `const`s: `static const <cty> j_<name> = <value>;` each, then the unconditional
// trailing blank. An array-literal value takes a BRACE initializer (`{ { … } }`) rather than the
// statement-expression `emit_expr` would give — a `static const` can't be initialized by a GNU
// statement-expression. (`@no_mangle` consts + `@section` are still TODO.)
fn emit_consts(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 2 {                             // Const: (x,y)=name span, a=type, b=value
            string_push(sb, "static const ")
            if it.a >= 0 { emit_c_ty(sb, p, src, it.a) }
            else { emit_ty_c(sb, p, src, c, list.get(i32, c.et, it.b as usize)) }
            string_push(sb, " j_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " = ")
            let v: parser.ExprData = list.get(parser.ExprData, p.ex, it.b as usize)
            var done: bool = false
            if v.kind == 44 {                         // comptime block -> maybe a TABLE
                // The payoff of tier 6: a lookup table COMPUTED by the compiler becomes
                // an ordinary static, indistinguishable from one typed out by hand. It
                // needs the brace form for the same reason an array literal does, so
                // this arm sits beside that one rather than inside `emit_expr`.
                var ci: ctfe.Interp = ctfe.make(g.alloc)
                let cv: ctfe.Value = ctfe.eval(ci, p, src, it.b)
                if ci.failed == false {
                    if cv.tag == 4 {
                        push_ctfe_brace(sb, ci, cv)
                        done = true
                    }
                }
            }
            if done == false {
                if v.kind == 14 {                     // array literal -> brace initializer
                    string_push(sb, "{ { ")
                    var i: i32 = 0
                    for i < v.y {
                        if i > 0 { string_push(sb, ", ") }
                        emit_expr(sb, p, src, c, g, list.get(i32, p.ar, (v.x + i) as usize))
                        i = i + 1
                    }
                    string_push(sb, " } }")
                } else {
                    emit_expr(sb, p, src, c, g, it.b)
                }
            }
            string_push(sb, ";\n")
        }
        r = r + 1
    }
    string_push(sb, "\n")
}

// Array typedefs: one `typedef struct { <ecty> a[N]; } JestyrArr_<m>_<N>;` per distinct concrete
// array instance. Mirrors `collect_arrays`' scan ORDER — the Checker's per-expr types FIRST (in
// expr-arena order), then function signature annotations, then a monomorphized generic struct's
// array FIELDS. The expr scan is load-bearing: a `const T: [5]i64 = [2,3,…]` literal infers its
// OWN `[5]i32` (the const's value is inferred with no expected type), so BOTH `JestyrArr_i32_5`
// and `JestyrArr_i64_5` are emitted, in that order. Every scan screens for CONCRETENESS, which
// is what keeps the generic body's own `[8]T` out.
fn emit_array_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, mut d: Dc) {
    var seen: String = string_new()
    var any: bool = false
    var i: usize = 0
    for i < list.len(i32, c.et) {                     // per-expr types, in expr-arena order
        any = emit_one_array_def(sb, p, src, c, list.get(i32, c.et, i), seen, d) or any
    	i = i + 1
    }
    var r: i32 = 0                                    // then fn signature annotations
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            var pi: i32 = 0
            for pi < it.b {
                any = emit_one_array_def_ast(sb, p, src, c, list.get(i32, p.iar, (it.a + pi * 7 + 5) as usize), seen, d) or any
                pi = pi + 1
            }
            any = emit_one_array_def_ast(sb, p, src, c, it.z, seen, d) or any
        }
        r = r + 1
    }
    // Then a monomorphized generic struct's array FIELDS, which the two scans above cannot
    // see. `SmallVec(T) = struct { buf: [8]T, … }` mentions `[8]T` only inside the generic
    // body, where it is not concrete; the concrete `[8]i64` is never an expression type of
    // its own, because nothing ever names the field's type. Instance order, member order,
    // same dedup — mirrors the generic-struct pass of `collect_arrays`.
    //
    // A single-file program hid the gap: an inline `[0; 8]` literal in a NON-generic caller
    // is concrete, so the expr scan caught it. Move the constructor into an imported module
    // and the literal moves into the generic body, where it does not — the module boundary
    // was the trigger.
    var gk: usize = 0
    for gk < list.len(i32, g.gsi) {
        let tid: i32 = list.get(i32, g.gsi, gk)
        let fit: i32 = gstruct_ctor_fn(p, src, c, tid)
        let node: i32 = ctor_struct_node(p, fit)
        if node >= 0 {                                // import-degenerate ctors have no fields
            let sx: parser.ExprData = list.get(parser.ExprData, p.ex, node as usize)
            var mi: i32 = 0
            for mi < sx.y {
                let mb: i32 = sx.x + mi * 10
                if list.get(i32, p.mar, mb as usize) == 0 {
                    let fty: i32 = list.get(i32, p.mar, (mb + 4) as usize)
                    if fty >= 0 {
                        let ft: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                        if ft.kind == 4 {
                            any = emit_one_gs_array_def(sb, p, src, c, fty, fit, tid, seen, d) or any
                        }
                    }
                }
                mi = mi + 1
            }
        }
        gk = gk + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// One array typedef for a generic struct's `[N]T` FIELD, under the instance's substitution:
// the same shape as `emit_one_array_def_ast`, but every element rendering goes through the
// `gs_*` substituting pair so `[8]T` in `SmallVec(i64)` names `JestyrArr_i64_8`.
fn emit_one_gs_array_def(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, fit: i32, tid: i32, mut seen: String, mut d: Dc) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 4 { return false }
    if !gs_elem_concrete(p, src, c, t.a, fit, tid) { return false }
    var m: String = string_new()
    push_gs_mangle(m, p, src, c, t.a, fit, tid)
    string_push(m, "_")
    push_array_len(m, p, src, t.b)
    var ec: String = string_new()
    emit_gs_ty(ec, p, src, c, t.a, fit, tid)
    var ln: String = string_new()
    push_array_len(ln, p, src, t.b)
    let ok: bool = push_array_typedef_raw(sb, string_view(m), seen, string_view(ec), string_view(ln), d)
    string_free(m)  string_free(ec)  string_free(ln)
    return ok
}

// Is an array element concrete under a struct instance's substitution? The `is_concrete`
// screen `collect_arrays` applies, in the one form that can actually fail here: a type
// PARAMETER is concrete only once substituted, and only if the arg it binds to is itself
// concrete (an instance may carry an opaque import name).
fn gs_elem_concrete(read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, fit: i32, tid: i32) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {
        let arg: i32 = gs_tparam_arg(p, src, c, fit, tid, t.start, t.end)
        if arg >= 0 { return tyid_concrete(c, arg) }
        return true                                   // a plain named type (`i64`, a struct)
    }
    if t.kind == 2 or t.kind == 3 or t.kind == 4 or t.kind == 5 or t.kind == 6 {
        return gs_elem_concrete(p, src, c, t.a, fit, tid)
    }
    return true
}

// One array typedef from a Checker TyId (only an Array, kind 9, contributes).
fn emit_one_array_def(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, mut seen: String, mut d: Dc) -> bool {
    if tyid < 0 { return false }
    let td: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    if td.kind != 9 { return false }
    // `collect_arrays` screens every candidate through `is_concrete`; without the mirror the
    // `[zero; 8]` literal in `SmallVec`'s generic body — typed `[8]T` with `T` still opaque —
    // emitted a `JestyrArr_T_8` the reference never emits. The CONCRETE instance comes from
    // the generic-struct pass below instead.
    if !tyid_concrete(c, tyid) { return false }
    var m: String = string_new()                      // the instance key = its full mangle
    push_ty_mangle(m, src, c, td.a)
    string_push(m, "_")
    push_uint(m, td.b as i64)
    let ok: bool = push_array_typedef(sb, string_view(m), seen, p, src, c, td.a, 0 - 1, td.b, d)
    string_free(m)
    return ok
}

// One array typedef from an AST TypeId (a `[N]T` annotation).
fn emit_one_array_def_ast(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, mut seen: String, mut d: Dc) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 4 { return false }
    var m: String = string_new()
    push_ast_mangle(m, p, src, t.a)
    string_push(m, "_")
    push_array_len(m, p, src, t.b)
    var ec: String = string_new()
    emit_c_ty(ec, p, src, t.a)
    var ln: String = string_new()
    push_array_len(ln, p, src, t.b)
    let ok: bool = push_array_typedef_raw(sb, string_view(m), seen, string_view(ec), string_view(ln), d)
    string_free(m)  string_free(ec)  string_free(ln)
    return ok
}

// Emit `typedef struct { <ecty> a[<len>]; } JestyrArr_<key>;` unless `key` was already emitted.
fn push_array_typedef(mut sb: String, read key: str, mut seen: String, read p: parser.Parser, read src: str, read c: typeck.Checker, elem: i32, unused: i32, len: i32, mut d: Dc) -> bool {
    var ec: String = string_new()
    emit_ty_c(ec, p, src, c, elem)
    var ln: String = string_new()
    push_uint(ln, len as i64)
    let ok: bool = push_array_typedef_raw(sb, key, seen, string_view(ec), string_view(ln), d)
    string_free(ec)  string_free(ln)
    return ok
}

// The dedup + emit core: `key` is the instance's mangle (`<elem>_<len>`). A NAMED segment, opened
// AND closed — an unclosed `dc_begin` is silently absorbed as glue by the next one's `dc_glue`,
// which loses the name without losing any text (a divergence, not a corruption).
fn push_array_typedef_raw(mut sb: String, read key: str, mut seen: String, read ecty: str, read len: str, mut d: Dc) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, key)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    let ns: i32 = dc_len(d)                           // segment name: JestyrArr_<key>; the
    string_push(d.nb, "JestyrArr_")                   // element is embedded BY VALUE — one dep
    string_push(d.nb, key)
    let ne: i32 = dc_len(d)
    dc_dep(d, ne, ecty)
    dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
    string_push(sb, "typedef struct { ")
    string_push(sb, ecty)
    string_push(sb, " a[")
    string_push(sb, len)
    string_push(sb, "]; } JestyrArr_")
    string_push(sb, key)
    string_push(sb, ";\n")
    dc_end(d, sb_len(sb))
    return true
}

// One `typedef struct { <E>* ptr; uint64_t gen; } JestyrRef_<m>;`, deduped by elem mangle, as a
// NAMED segment so a struct embedding it by value can depend on it (`genref_struct_defs`).
fn push_genref_typedef(mut sb: String, mut seen: String, read m: str, read ecty: str, mut d: Dc) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, m)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    let ns: i32 = dc_len(d)                           // segment name: JestyrRef_<m>; like a slice it
    string_push(d.nb, "JestyrRef_")                   // holds E through a POINTER — no by-value dep
    string_push(d.nb, m)
    let ne: i32 = dc_len(d)
    dc_begin(d, sb_len(sb), ns, ne, ne, ne)
    string_push(sb, "typedef struct { ")
    string_push(sb, ecty)
    string_push(sb, "* ptr; uint64_t gen; } JestyrRef_")
    string_push(sb, m)
    string_push(sb, ";\n")
    dc_end(d, sb_len(sb))
    return true
}

// Fn-pointer typedefs (mirrors `collect_fn_types` + `fn_type_typedefs`): one
// `typedef <ret> (*JestyrFn_<sig>)(<params>);` per distinct signature written in the type
// arena (arena order — a nested fn type has a smaller id, so inner typedefs emit first),
// deduped by mangle; + a CONDITIONAL trailing blank. The typedef puts the name on the OUTSIDE,
// so every later use is a plain `JestyrFn_<sig> j_x`. A `mut`/`out` param lowers to `T*` (no
// `restrict` — matching a real Jestyr fn's ABI so a pointer can hold `&some_fn`). Generic
// placeholders and monomorphized-signature contributions are a later increment.
// ---- generic STRUCTS via comptime type-fns (mirrors `collect_struct_instances`/
// `gen_struct_defs`/`emit_struct_instance` + the struct-instance pass of `collect_fn_types`).
// A `fn Box(comptime T: type) -> type { return struct { … } }` ctor monomorphizes per concrete
// instance the Checker typed (TyData kind 6 whose ctor names such a fn). ----

// The `return struct { … }` StructType expr (kind 36) of a comptime struct ctor, or -1.
// Mirrors `ctor_struct_body`.
fn ctor_struct_node(read p: parser.Parser, fit: i32) -> i32 {
    if fit < 0 { return 0 - 1 }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    if it.w < 0 { return 0 - 1 }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, it.w as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.kind == 1 and s.a >= 0 {
            let v: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
            if v.kind == 36 { return s.a }
        }
        i = i + 1
    }
    return 0 - 1
}

// A kind-6 instance whose ctor is a comptime type-fn returning `struct { … }`: the ctor's fn
// item, or -1. (A generic-ENUM instance is also kind 6 — those resolve via `genum_item_of`,
// and an enum name is never a fn item, so the two never collide.)
fn gstruct_ctor_fn(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> i32 {
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 6 { return 0 - 1 }
    let fit: i32 = find_fn_item(p, src, src[d.x as usize .. d.y as usize])
    if fit < 0 { return 0 - 1 }
    if ctor_struct_node(p, fit) < 0 { return 0 - 1 }
    return fit
}

// The instance type-arg TyId bound to tparam `src[ns..ne]` of ctor fn `fit` under instance
// `tid`, or -1: the fn's `comptime X: type` params in declaration order zip with the
// instance's args (mirrors `type_param_names` + the subst map).
fn gs_tparam_arg(read p: parser.Parser, read src: str, read c: typeck.Checker, fit: i32, tid: i32, ns: usize, ne: usize) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    var k: i32 = 0
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 {
                    let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
                    let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
                    if str_eq(src[ns .. ne], src[pns as usize .. pne as usize]) {
                        if k < d.b { return list.get(i32, c.tya, (d.a + k) as usize) }
                        return 0 - 1
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// The mangle of an AST type under a struct instance's tparam->arg substitution (a substituted
// Name mangles as its ARG's Checker mangle; everything else mirrors `push_ast_mangle`).
fn push_gs_mangle(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, fit: i32, tid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {
        let arg: i32 = gs_tparam_arg(p, src, c, fit, tid, t.start, t.end)
        if arg >= 0 { push_ty_mangle(sb, src, c, arg)  return }
        string_push(sb, src[t.start .. t.end])
        return
    }
    if t.kind == 2 { string_push(sb, "ptr_")  push_gs_mangle(sb, p, src, c, t.a, fit, tid)  return }
    if t.kind == 3 { string_push(sb, "slice_")  push_gs_mangle(sb, p, src, c, t.a, fit, tid)  return }
    if t.kind == 5 { string_push(sb, "ref_")  push_gs_mangle(sb, p, src, c, t.a, fit, tid)  return }
    if t.kind == 9 {
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < t.a {
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, p.tar, (t.op + i * 2) as usize))
            push_gs_mangle(sb, p, src, c, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize), fit, tid)
            i = i + 1
        }
        string_push(sb, "_ret_")
        if t.x >= 0 { push_gs_mangle(sb, p, src, c, t.x, fit, tid) } else { string_push(sb, "unit") }
        return
    }
    push_ast_mangle(sb, p, src, tyid)
}

// An AST type rendered as C under a struct instance's substitution (a substituted Name
// renders its ARG's Checker C type; a Fn type names its SUBSTITUTED typedef).
fn emit_gs_ty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, fit: i32, tid: i32) {
    if tyid < 0 { string_push(sb, "void")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {
        let arg: i32 = gs_tparam_arg(p, src, c, fit, tid, t.start, t.end)
        if arg >= 0 { emit_ty_c(sb, p, src, c, arg)  return }
        emit_c_ty(sb, p, src, tyid)
        return
    }
    if t.kind == 2 or t.kind == 6 {
        emit_gs_ty(sb, p, src, c, t.a, fit, tid)
        string_push(sb, "*")
        return
    }
    if t.kind == 3 {
        string_push(sb, "JestyrSlice_")
        push_gs_mangle(sb, p, src, c, t.a, fit, tid)
        return
    }
    if t.kind == 5 {
        string_push(sb, "JestyrRef_")
        push_gs_mangle(sb, p, src, c, t.a, fit, tid)
        return
    }
    if t.kind == 9 {
        string_push(sb, "JestyrFn_")
        push_gs_mangle(sb, p, src, c, tyid, fit, tid)
        return
    }
    if t.kind == 4 {                                  // `buf: [8]T` -> `JestyrArr_i64_8`
        string_push(sb, "JestyrArr_")
        push_gs_mangle(sb, p, src, c, t.a, fit, tid)
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)
        return
    }
    emit_c_ty(sb, p, src, tyid)
}

// Collect every generic-STRUCT instance the Checker typed: kind-6 per-expr types whose ctor
// is a comptime struct ctor, expression order, deduped by rendered C name (mirrors
// `collect_struct_instances`; the reference's fn-signature/annotation pass is deferred, like
// the enum collection's was).
// May this kind-6 Checker row back a STRUCT instance? A comptime-ctor instance always; an
// IMPORT-DEGENERATE ctor (no local fn/enum of that name) too — it gets a forward typedef but
// no definition (the reference's unresolved GenStruct). A LOCAL generic enum's rows belong to
// `gei`; a local non-ctor fn name is not a type.
fn gsi_row_ok(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> bool {
    if gstruct_ctor_fn(p, src, c, tid) >= 0 { return true }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if genum_item_of(p, src, c, tid) >= 0 { return false }
    if find_fn_item(p, src, src[d.x as usize .. d.y as usize]) >= 0 { return false }
    return find_enum_item(p, src, d.x as usize, d.y as usize) < 0
}

// Record one rendered instance key: reject a non-concrete render (`?`), dedup, then resolve
// the key to a concrete Checker TyId (the arena's first kind-6 struct instance rendering
// identically) — the gsi consumers are all TyId-based.
fn gsi_add_key(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read key: str, mut seen: String) {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, key)
    string_push(probe, "|")
    if !contains(key, "?") and !contains(string_view(seen), string_view(probe)) {
        var t: usize = 0
        var found: bool = false
        for t < list.len(typeck.TyData, c.tys) {
            if !found {
                let d: typeck.TyData = list.get(typeck.TyData, c.tys, t)
                if d.kind == 6 {
                    if gsi_row_ok(p, src, c, t as i32) {   // Opaque args are fine (import names);
                                                           // an UNKNOWN arg renders `?` and the
                                                           // key reject already screens it
                        var r: String = string_new()
                        emit_ty_c(r, p, src, c, t as i32)
                        if str_eq(string_view(r), key) {
                            string_push(seen, string_view(probe))
                            list.push(i32, g.gsi, t as i32)
                            found = true
                        }
                        string_free(r)
                    }
                }
            }
            t = t + 1
        }
    }
    string_free(probe)
}

// The generic-struct mentions of an AST type: a `Ctor(args)` App whose ctor is a comptime
// type-fn names an instance (rendered under the ACTIVE substitution — plain when `g.su` is
// empty); structural forms recurse. Mirrors `collect_gen_struct` over `ast_type_to_ty`.
fn gsw_type(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, mut seen: String, tyid: i32) {
    if tyid < 0 { return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 7 {
        // a comptime struct ctor names an instance; so does an IMPORT-DEGENERATE ctor (not a
        // local fn, not a local enum) — the reference's single-file GenStruct, which gets a
        // forward typedef but no definition
        let cfit7: i32 = find_fn_item(p, src, src[t.x as usize .. t.y as usize])
        var ok7: bool = ctor_struct_node(p, cfit7) >= 0
        if !ok7 and cfit7 < 0 {
            if find_enum_item(p, src, t.x as usize, t.y as usize) < 0 { ok7 = true }
        }
        if ok7 {
            var key: String = string_new()
            emit_su_ty(key, p, src, c, g, tyid)
            gsi_add_key(g, p, src, c, string_view(key), seen)
            string_free(key)
        }
        return
    }
    if t.kind == 8 and t.a > 0 {                      // `mod.Type(args)`: always import-degenerate
        var key8: String = string_new()
        emit_su_ty(key8, p, src, c, g, tyid)
        gsi_add_key(g, p, src, c, string_view(key8), seen)
        string_free(key8)
        return
    }
    if t.kind == 2 or t.kind == 3 or t.kind == 4 or t.kind == 5 or t.kind == 6 {
        gsw_type(g, p, src, c, seen, t.a)
        return
    }
    if t.kind == 9 {
        var i: i32 = 0
        for i < t.a {
            gsw_type(g, p, src, c, seen, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
            i = i + 1
        }
        gsw_type(g, p, src, c, seen, t.x)
        return
    }
}

fn gsw_expr(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, mut seen: String, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 17 {                                 // GenStructLit: the instance itself, then fields
        var key: String = string_new()
        emit_su_tyid(key, p, src, c, g, list.get(i32, c.et, eid as usize))
        gsi_add_key(g, p, src, c, string_view(key), seen)
        string_free(key)
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            gsw_expr(g, p, src, c, seen, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 11 {                                 // Cast: target type, then operand
        gsw_type(g, p, src, c, seen, e.x)
        gsw_expr(g, p, src, c, seen, e.a)
        return
    }
    if e.kind == 10 {
        gsw_expr(g, p, src, c, seen, e.a)
        var i: i32 = 0
        for i < e.y {
            gsw_expr(g, p, src, c, seen, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {
        gsw_expr(g, p, src, c, seen, e.a)
        gsw_expr(g, p, src, c, seen, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 34 or e.kind == 35 or e.kind == 37 {
        gsw_expr(g, p, src, c, seen, e.a)
        return
    }
    if e.kind == 16 {
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            gsw_expr(g, p, src, c, seen, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { gsw_expr(g, p, src, c, seen, e.b) }
        return
    }
    if e.kind == 24 {
        gsw_expr(g, p, src, c, seen, e.a)
        gsw_block(g, p, src, c, seen, e.b)
        if e.op >= 0 { gsw_expr(g, p, src, c, seen, e.op) }
        return
    }
    if e.kind == 23 { gsw_block(g, p, src, c, seen, eid)  return }
    if e.kind == 25 { gsw_block(g, p, src, c, seen, e.a)  return }
    if e.kind == 28 {
        gsw_expr(g, p, src, c, seen, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { gsw_expr(g, p, src, c, seen, guard) }
            gsw_expr(g, p, src, c, seen, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {
        if e.op == 1 { gsw_expr(g, p, src, c, seen, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                gsw_expr(g, p, src, c, seen, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        gsw_block(g, p, src, c, seen, e.b)
        if e.x >= 0 { gsw_block(g, p, src, c, seen, e.x) }
        return
    }
}

fn gsw_block(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, mut seen: String, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.kind == 0 and s.ty >= 0 { gsw_type(g, p, src, c, seen, s.ty) }   // let annotation first
        if s.a >= 0 { gsw_expr(g, p, src, c, seen, s.a) }
        i = i + 1
    }
}

// One fn's contribution: param annotations, return type, then the body (mirrors
// `collect_structs_in_fn`'s order).
fn gsw_fn(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, mut seen: String, read f: parser.ItemData) {
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        gsw_type(g, p, src, c, seen, list.get(i32, p.iar, (base + 5) as usize))
        i = i + 1
    }
    gsw_type(g, p, src, c, seen, f.z)
    if f.w >= 0 { gsw_block(g, p, src, c, seen, f.w) }
}

// Every generic-STRUCT instance, in the REFERENCE's collection order: (a) SYNTAX mentions
// (GenStructLits, annotations, casts) in non-generic fn bodies + impl-method bodies, item
// order — an inferred call type alone contributes nothing, exactly like the reference; then
// (b) each generic-fn instance's signature + body under its substitution, record order (the
// LIFO-drained instance order — `List(f64)` lands before `List(i32)` when the f64 instance
// drained first). Mirrors `collect_struct_instances` (the receiver/method pass waits for
// generic-struct methods). MUST run after `collect_gfn_instances`.
fn collect_gstruct_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var seen: String = string_new()
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_gen(p, it) { gsw_fn(g, p, src, c, seen, it) }
        if it.kind == 7 {
            var k: i32 = 0
            for k < it.z {
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + k) as usize) as usize)
                gsw_fn(g, p, src, c, seen, fd)
                k = k + 1
            }
        }
        r = r + 1
    }
    var rb: i32 = 0
    for rb < list.len(i32, g.gfi) as i32 {
        arm_record_su(g, p, rb)
        let fit: i32 = list.get(i32, g.gfi, rb as usize)
        let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
        gsw_fn(g, p, src, c, seen, f)
        list.truncate(i32, g.su, 0)
        let argc: i32 = list.get(i32, g.gfi, (rb + 1) as usize)
        rb = rb + 2 + argc * 3
    }
    // (c) each generic-struct METHOD instance: its receiver struct, then the method's
    // sig+body under the ctor substitution (mirrors the reference's method_instances pass).
    var mb: i32 = 0
    for mb < list.len(i32, g.gmi) as i32 {
        let argc2: i32 = list.get(i32, g.gmi, (mb + 1) as usize)
        let cf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.gmi, (mb + 2 + argc2 * 3) as usize) as usize)
        var key: String = string_new()
        string_push(key, "Jestyr_")
        string_push(key, src[cf.x .. cf.y])
        string_push(key, "__")
        var t2: i32 = 0
        for t2 < argc2 {
            if t2 > 0 { string_push(key, "_") }
            let tb2: i32 = mb + 2 + t2 * 3
            push_targ_mangle(key, src, c, list.get(i32, g.gmi, tb2 as usize), list.get(i32, g.gmi, (tb2 + 1) as usize), list.get(i32, g.gmi, (tb2 + 2) as usize))
            t2 = t2 + 1
        }
        gsi_add_key(g, p, src, c, string_view(key), seen)
        string_free(key)
        arm_gmi_su(g, p, mb)
        let mf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.gmi, mb as usize) as usize)
        gsw_fn(g, p, src, c, seen, mf)
        list.truncate(i32, g.su, 0)
        mb = mb + 3 + argc2 * 3
    }
    string_free(seen)
}

// Generic-struct instance definitions (mirrors `gen_struct_defs`/`emit_struct_instance`):
// `struct Jestyr_<ctor>__<args> { <substituted field> j_<name>; … };` + trailing blank each.
// Field members only (tag 0); emitted between the plain enum defs and the gen-enum defs.
fn emit_gen_struct_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, mut d: Dc) {
    var k: usize = 0
    for k < list.len(i32, g.gsi) {
        let tid: i32 = list.get(i32, g.gsi, k)
        let fit: i32 = gstruct_ctor_fn(p, src, c, tid)
        let node: i32 = ctor_struct_node(p, fit)
        if node < 0 {                                 // an import-degenerate instance: forward
            k = k + 1                                 // typedef only, no definition (reference:
            continue                                  // `emit_struct_instance` bails on find_fn)
        }
        let sx: parser.ExprData = list.get(parser.ExprData, p.ex, node as usize)
        let ns: i32 = dc_len(d)                       // segment name: the instance's C name
        emit_ty_c(d.nb, p, src, c, tid)
        let ne: i32 = dc_len(d)
        var m0: i32 = 0                               // substituted by-value field deps
        for m0 < sx.y {
            let mb0: i32 = sx.x + m0 * 10
            if list.get(i32, p.mar, mb0 as usize) == 0 {
                var ft0: String = string_new()
                emit_gs_ty(ft0, p, src, c, list.get(i32, p.mar, (mb0 + 4) as usize), fit, tid)
                dc_dep(d, ne, string_view(ft0))
                string_free(ft0)
            }
            m0 = m0 + 1
        }
        dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
        string_push(sb, "struct ")
        emit_ty_c(sb, p, src, c, tid)
        string_push(sb, " {\n")
        var m: i32 = 0
        for m < sx.y {
            let mb: i32 = sx.x + m * 10
            if list.get(i32, p.mar, mb as usize) == 0 {    // tag 0 = field
                string_push(sb, "    ")
                emit_gs_ty(sb, p, src, c, list.get(i32, p.mar, (mb + 4) as usize), fit, tid)
                string_push(sb, " j_")
                let ns: i32 = list.get(i32, p.mar, (mb + 2) as usize)
                let ne: i32 = list.get(i32, p.mar, (mb + 3) as usize)
                string_push(sb, src[ns as usize .. ne as usize])
                string_push(sb, ";\n")
            }
            m = m + 1
        }
        string_push(sb, "};\n\n")
        dc_end(d, sb_len(sb))
        k = k + 1
    }
}

// Is an AST type fully concrete — every Name a prim or a DECLARED type (a template's bare
// tparam like the `T` in `fn(T) -> T` is neither)? Only concrete fn types get typedefs from
// the textual scan; the instances contribute their substituted forms. Mirrors `is_concrete`.
fn ast_ty_concrete(read p: parser.Parser, read src: str, tyid: i32) -> bool {
    if tyid < 0 { return true }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {
        let nm: str = src[t.start .. t.end]
        if !str_eq(c_prim(nm), "") { return true }
        return find_named_item(p, src, t.start as i32, t.end as i32) >= 0
    }
    if t.kind == 2 or t.kind == 3 or t.kind == 5 or t.kind == 6 { return ast_ty_concrete(p, src, t.a) }
    if t.kind == 4 { return ast_ty_concrete(p, src, t.a) }
    if t.kind == 9 {
        var i: i32 = 0
        for i < t.a {
            if !ast_ty_concrete(p, src, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize)) { return false }
            i = i + 1
        }
        return ast_ty_concrete(p, src, t.x)
    }
    if t.kind == 7 {
        var i: i32 = 0
        for i < t.a {
            if !ast_ty_concrete(p, src, list.get(i32, p.tar, (t.op + i) as usize)) { return false }
            i = i + 1
        }
        return true
    }
    return true
}

// Dep on an anonymous-typedef name a fn-pointer typedef mentions (mirrors
// `dep_of_anon_typedef`). Unlike `dc_dep`, a POINTER does not lift the dependency:
// `JestyrSlice_…`/`JestyrArr_…`/`JestyrRef_…`/`JestyrFn_…` are typedefs of
// anonymous structs with NO forward declaration, so even `JestyrSlice_i64*` needs
// the typedef emitted first. Named aggregates (`Jestyr_…`) are exempt -- the
// forward declarations already satisfy prototype position.
fn dc_dep_anon(mut d: Dc, ds: i32, read cty: str) {
    var e: usize = cty.len
    for e > 0 and cty[e - 1] == '*' { e = e - 1 }
    for e > 0 and cty[e - 1] == ' ' { e = e - 1 }
    let base: str = cty[0 .. e]
    var hit: bool = false
    if starts_with(base, "JestyrSlice_") { hit = true }
    if starts_with(base, "JestyrArr_") { hit = true }
    if starts_with(base, "JestyrRef_") { hit = true }
    if starts_with(base, "JestyrFn_") { hit = true }
    if !hit { return }
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, base)
    string_push(probe, "|")
    var have: bool = false
    {
        let cur: str = string_view(d.nb)
        have = contains(cur[ds as usize .. cur.len], string_view(probe))
    }
    if !have {
        let start_empty: bool = dc_len(d) == ds
        if start_empty { string_push(d.nb, "|") }
        string_push(d.nb, base)
        string_push(d.nb, "|")
    }
    string_free(probe)
}

// Does the rendered C type `cty` name an ANONYMOUS-struct typedef — one with no forward
// declaration to fall back on? Same four prefixes `dc_dep_anon` tests; factored out because
// the `distinct` typedefs need the same question answered about their base.
fn cty_is_anon(read cty: str) -> bool {
    var e: usize = cty.len
    for e > 0 and cty[e - 1] == '*' { e = e - 1 }
    for e > 0 and cty[e - 1] == ' ' { e = e - 1 }
    let base: str = cty[0 .. e]
    if starts_with(base, "JestyrSlice_") { return true }
    if starts_with(base, "JestyrArr_") { return true }
    if starts_with(base, "JestyrRef_") { return true }
    if starts_with(base, "JestyrFn_") { return true }
    return false
}

// `typedef JestyrSlice_i64 Jestyr_Buf;` — the `distinct` typedefs whose base is an
// anonymous-struct typedef, emitted as CAPTURE UNITS so the flush puts the base's definition
// first (mirrors the reference's `distinct_typedefs`). Empty for a program without one, which
// is what makes the split byte-neutral. Found by `examples/distinct_corpus/c07`-`c10`: the
// typedef WAS collected, it was emitted two lines before `JestyrSlice_i64` existed.
fn emit_distinct_defs(mut sb: String, read p: parser.Parser, read src: str, mut d: Dc) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 1 {
            var dbase: String = string_new()
            emit_c_ty(dbase, p, src, it.a)
            if cty_is_anon(string_view(dbase)) {
                let uns: i32 = dc_len(d)
                string_push(d.nb, "Jestyr_")
                string_push(d.nb, src[it.x .. it.y])
                let une: i32 = dc_len(d)
                dc_dep_anon(d, une, string_view(dbase))
                dc_begin(d, sb_len(sb), uns, une, une, dc_len(d))
                string_push(sb, "typedef ")
                string_push(sb, string_view(dbase))
                string_push(sb, " Jestyr_")
                string_push(sb, src[it.x .. it.y])
                string_push(sb, ";\n")
                dc_end(d, sb_len(sb))
            }
            string_free(dbase)
        }
        r = r + 1
    }
}

fn emit_fn_type_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, mut d: Dc) {
    var any: bool = false
    var seen: String = string_new()
    var ti: usize = 0
    for ti < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, ti)
        if t.kind == 9 and ast_ty_concrete(p, src, ti as i32) {
            var m: String = string_new()
            push_ast_mangle(m, p, src, ti as i32)
            var probe: String = string_new()
            string_push(probe, "|")
            string_push(probe, string_view(m))
            string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                // Each typedef is a CAPTURE UNIT named JestyrFn_<m>, depending on
                // every anonymous-typedef name it mentions (mirrors the reference's
                // `fn_type_typedefs` + `dep_of_anon_typedef`) -- the flush emits
                // slice/array/genref typedefs first exactly where a signature
                // names one. Param/ret C types render into a temp so the dep scan
                // sees the finished spelling, `*` suffix included.
                let uns: i32 = dc_len(d)
                string_push(d.nb, "JestyrFn_")
                string_push(d.nb, string_view(m))
                let une: i32 = dc_len(d)
                var line: String = string_new()
                string_push(line, "typedef ")
                var rc: String = string_new()
                emit_c_ty(rc, p, src, t.x)             // ret (-1 -> void)
                dc_dep_anon(d, une, string_view(rc))
                string_push(line, string_view(rc))
                string_free(rc)
                string_push(line, " (*JestyrFn_")
                string_push(line, string_view(m))
                string_push(line, ")(")
                if t.a == 0 { string_push(line, "void") }
                var i: i32 = 0
                for i < t.a {
                    if i > 0 { string_push(line, ", ") }
                    let conv: i32 = list.get(i32, p.tar, (t.op + i * 2) as usize)
                    var pc: String = string_new()
                    emit_c_ty(pc, p, src, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
                    if conv == 2 or conv == 4 { string_push(pc, "*") }
                    dc_dep_anon(d, une, string_view(pc))
                    string_push(line, string_view(pc))
                    string_free(pc)
                    i = i + 1
                }
                string_push(line, ");\n")
                dc_begin(d, sb_len(sb), uns, une, une, dc_len(d))
                string_push(sb, string_view(line))
                dc_end(d, sb_len(sb))
                string_free(line)
                any = true
            }
            string_free(m)
            string_free(probe)
        }
        ti = ti + 1
    }
    // A monomorphized generic struct contributes the CONCRETE fn-pointer type of each
    // fn-pointer field under its substitution (`Box(i32)`'s `op: fn(T) -> T` yields
    // `fn(i32) -> i32`) — instance order, member order, same dedup. Mirrors the
    // struct-instance pass of `collect_fn_types`.
    var gk: usize = 0
    for gk < list.len(i32, g.gsi) {
        let tid: i32 = list.get(i32, g.gsi, gk)
        let fit: i32 = gstruct_ctor_fn(p, src, c, tid)
        let node: i32 = ctor_struct_node(p, fit)
        if node < 0 {                                 // import-degenerate: no fields to walk
            gk = gk + 1
            continue
        }
        let sx: parser.ExprData = list.get(parser.ExprData, p.ex, node as usize)
        var mi: i32 = 0
        for mi < sx.y {
            let mb: i32 = sx.x + mi * 10
            if list.get(i32, p.mar, mb as usize) == 0 {
                let fty: i32 = list.get(i32, p.mar, (mb + 4) as usize)
                if fty >= 0 {
                    let ft: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                    if ft.kind == 9 {
                        var m2: String = string_new()
                        push_gs_mangle(m2, p, src, c, fty, fit, tid)
                        var probe2: String = string_new()
                        string_push(probe2, "|")
                        string_push(probe2, string_view(m2))
                        string_push(probe2, "|")
                        if !contains(string_view(seen), string_view(probe2)) {
                            string_push(seen, string_view(probe2))
                            // Same capture-unit wrapping as pass 1 (deps incl. the
                            // `*` suffix a mut/out conv appends).
                            let uns2: i32 = dc_len(d)
                            string_push(d.nb, "JestyrFn_")
                            string_push(d.nb, string_view(m2))
                            let une2: i32 = dc_len(d)
                            var line2: String = string_new()
                            string_push(line2, "typedef ")
                            var rc2: String = string_new()
                            emit_gs_ty(rc2, p, src, c, ft.x, fit, tid)
                            dc_dep_anon(d, une2, string_view(rc2))
                            string_push(line2, string_view(rc2))
                            string_free(rc2)
                            string_push(line2, " (*JestyrFn_")
                            string_push(line2, string_view(m2))
                            string_push(line2, ")(")
                            if ft.a == 0 { string_push(line2, "void") }
                            var i2: i32 = 0
                            for i2 < ft.a {
                                if i2 > 0 { string_push(line2, ", ") }
                                let conv2: i32 = list.get(i32, p.tar, (ft.op + i2 * 2) as usize)
                                var pc2: String = string_new()
                                emit_gs_ty(pc2, p, src, c, list.get(i32, p.tar, (ft.op + i2 * 2 + 1) as usize), fit, tid)
                                if conv2 == 2 or conv2 == 4 { string_push(pc2, "*") }
                                dc_dep_anon(d, une2, string_view(pc2))
                                string_push(line2, string_view(pc2))
                                string_free(pc2)
                                i2 = i2 + 1
                            }
                            string_push(line2, ");\n")
                            dc_begin(d, sb_len(sb), uns2, une2, une2, dc_len(d))
                            string_push(sb, string_view(line2))
                            dc_end(d, sb_len(sb))
                            string_free(line2)
                            any = true
                        }
                        string_free(m2)
                        string_free(probe2)
                    }
                }
            }
            mi = mi + 1
        }
        gk = gk + 1
    }
    // A monomorphized generic FUNCTION contributes the concrete fn-pointer type of each
    // fn-pointer PARAMETER and of its RETURN under that instance's substitution —
    // `opt_map(i32, i32)`'s `f: fn(T) -> U` yields `fn(i32) -> i32`. Mirrors the third pass
    // of the reference's `collect_fn_types`, which the port did not have.
    //
    // **This is what made four corpus programs unbuildable under `jc`.** Pass 1 walks types
    // written in the AST and skips `fn(T) -> U` because it is not concrete; pass 2 covers
    // generic STRUCT fields only. So a higher-order generic combinator's signature NAMED a
    // typedef nothing emitted, and gcc refused a program `jestyrc` compiles —
    // `combinators`, `slice_algos` and `mutex` are the three instances, and each is an
    // ordinary use of `core`'s or `sync`'s public API rather than anything exotic.
    var rb3: i32 = 0
    for (rb3 as usize) < list.len(i32, g.gfi) {
        let fit3: i32 = list.get(i32, g.gfi, rb3 as usize)
        let f3: parser.ItemData = list.get(parser.ItemData, p.it, fit3 as usize)
        arm_record_su(g, p, rb3)
        var pi3: i32 = 0
        for pi3 <= f3.b {
            // `f3.b` params, then one extra turn for the RETURN type — the reference chains
            // `params.filter_map(ty)` with `ret_ty` into one sequence and this is that chain.
            var ty3: i32 = f3.z
            if pi3 < f3.b { ty3 = list.get(i32, p.iar, (f3.a + pi3 * 7 + 5) as usize) }
            if ty3 >= 0 {
                let t3: parser.TypeData = list.get(parser.TypeData, p.ty, ty3 as usize)
                if t3.kind == 9 {
                    var m3: String = string_new()
                    push_su_mangle(m3, p, src, c, g, ty3)
                    var probe3: String = string_new()
                    string_push(probe3, "|")
                    string_push(probe3, string_view(m3))
                    string_push(probe3, "|")
                    // A `?` in the mangle is exactly what the reference's `is_concrete`
                    // screens out, in the form this side can observe: it means a tparam
                    // reached the mangle unsubstituted, and emitting a typedef under that
                    // name would define something no use can spell.
                    if !contains(string_view(m3), "?") and !contains(string_view(seen), string_view(probe3)) {
                        string_push(seen, string_view(probe3))
                        let uns3: i32 = dc_len(d)
                        string_push(d.nb, "JestyrFn_")
                        string_push(d.nb, string_view(m3))
                        let une3: i32 = dc_len(d)
                        var line3: String = string_new()
                        string_push(line3, "typedef ")
                        var rc3: String = string_new()
                        emit_su_ty(rc3, p, src, c, g, t3.x)
                        dc_dep_anon(d, une3, string_view(rc3))
                        string_push(line3, string_view(rc3))
                        string_free(rc3)
                        string_push(line3, " (*JestyrFn_")
                        string_push(line3, string_view(m3))
                        string_push(line3, ")(")
                        if t3.a == 0 { string_push(line3, "void") }
                        var i3: i32 = 0
                        for i3 < t3.a {
                            if i3 > 0 { string_push(line3, ", ") }
                            let conv3: i32 = list.get(i32, p.tar, (t3.op + i3 * 2) as usize)
                            var pc3: String = string_new()
                            emit_su_ty(pc3, p, src, c, g, list.get(i32, p.tar, (t3.op + i3 * 2 + 1) as usize))
                            if conv3 == 2 or conv3 == 4 { string_push(pc3, "*") }
                            dc_dep_anon(d, une3, string_view(pc3))
                            string_push(line3, string_view(pc3))
                            string_free(pc3)
                            i3 = i3 + 1
                        }
                        string_push(line3, ");\n")
                        dc_begin(d, sb_len(sb), uns3, une3, une3, dc_len(d))
                        string_push(sb, string_view(line3))
                        dc_end(d, sb_len(sb))
                        string_free(line3)
                        any = true
                    }
                    string_free(m3)
                    string_free(probe3)
                }
            }
            pi3 = pi3 + 1
        }
        rb3 = rb3 + 2 + list.get(i32, g.gfi, (rb3 + 1) as usize) * 3
    }
    // `arm_record_su` leaves the substitution armed and its callers are required to clear it;
    // every later emitter reads `g.su` and would otherwise render the last instance's
    // bindings into unrelated code.
    list.truncate(i32, g.su, 0)
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// Generational-reference typedefs (mirrors `collect_genrefs` + `genref_struct_defs`): every
// distinct `&T` element — the type arena's GenRef annotations first (arena order), then
// `gen_new(T, …)` constructions (expr order) — one `JestyrRef_<T>` each, + a CONDITIONAL
// trailing blank. `{ E* ptr; gen }` embeds E only through a pointer, so no by-value dep.
fn emit_genref_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut d: Dc) {
    var any: bool = false
    var seen: String = string_new()
    var ti: usize = 0
    for ti < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, ti)
        if t.kind == 5 {                              // a `&T` annotation
            var m: String = string_new()
            push_ast_mangle(m, p, src, t.a)
            var ec: String = string_new()
            emit_c_ty(ec, p, src, t.a)
            any = push_genref_typedef(sb, seen, string_view(m), string_view(ec), d) or any
            string_free(m)
            string_free(ec)
        }
        ti = ti + 1
    }
    var e2: usize = 0
    for e2 < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, e2)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "gen_new") {
                    if e.y >= 1 {
                        let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
                        if ax.kind == 2 {             // the bare-Name type arg is its own mangle
                            var ec: String = string_new()
                            emit_type_arg_cty_plain(ec, p, src, arg_at(p, e, 0))
                            any = push_genref_typedef(sb, seen, src[ax.start .. ax.end], string_view(ec), d) or any
                            string_free(ec)
                        }
                    }
                }
            }
        }
        e2 = e2 + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// ---- error payloads (E5, docs/error-payloads.md 3) -- all gated on use ----

// Is the payload machinery ON? Driven by DECLARATION (any error name carries a
// payload, `c.epay` non-empty), so a payload-free program emits today's C to
// the byte -- the reference's `err_pay_gated`.
fn err_pay_gated(read c: typeck.Checker) -> bool {
    return list.len(i32, c.epay) > 0
}

// The extra field every result struct gains in a payload-using program.
fn push_pay_field(mut sb: String, read c: typeck.Checker) {
    if err_pay_gated(c) { string_push(sb, "JestyrErrPay pay; ") }
}

// The tag an error name resolves to at a match arm: the user tag when declared,
// else the intrinsic literal 1 for the two builtin names -- the reference's
// `err_name_tag` (both wart-fix halves resolve the same way, so an origin and
// an arm can never disagree on the number).
fn err_name_tag(read g: Cg, read src: str, ns: usize, ne: usize) -> i32 {
    let t: i32 = error_tag_of(g, src, ns, ne)
    if t != 0 { return t }
    if str_eq(src[ns .. ne], "IoError") { return 1 }
    if str_eq(src[ns .. ne], "Utf8Error") { return 1 }
    return 0
}

// An INTRINSIC construction's tag: the user tag of `name` when the program
// declares it, else the historical literal 1 (`intrinsic_err_tag`).
fn intrinsic_tag(read g: Cg, read src: str, read name: str) -> i32 {
    var i: usize = 0
    for i < list.len(i32, g.etags) {
        let es: i32 = list.get(i32, g.etags, i)
        let ee: i32 = list.get(i32, g.etags, i + 1)
        if str_eq(name, src[es as usize .. ee as usize]) { return (i / 2 + 1) as i32 }
        i = i + 2
    }
    return 1
}

// The whole-program payload union (D3): one member per payload-carrying error
// name, deduped and NAME-SORTED (the reference's BTreeMap order), each
// rendered `<cty> j_<Name>; `.
fn emit_err_pay_union(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    string_push(sb, "typedef union { ")
    var done: String = string_new()
    var more: bool = true
    for more {
        var bi: i32 = 0 - 1
        var i: i32 = 0
        for i < list.len(i32, c.epay) as i32 {
            let ns: i32 = list.get(i32, c.epay, i as usize)
            let ne: i32 = list.get(i32, c.epay, (i + 1) as usize)
            var probe: String = string_new()
            string_push(probe, "|")
            string_push(probe, src[ns as usize .. ne as usize])
            string_push(probe, "|")
            var fresh: bool = true
            if contains(string_view(done), string_view(probe)) { fresh = false }
            string_free(probe)
            if fresh {
                if bi < 0 { bi = i }
                else {
                    let bs: i32 = list.get(i32, c.epay, bi as usize)
                    let be: i32 = list.get(i32, c.epay, (bi + 1) as usize)
                    if str_lt(src[ns as usize .. ne as usize], src[bs as usize .. be as usize]) { bi = i }
                }
            }
            i = i + 3
        }
        if bi < 0 { more = false }
        else {
            let ns2: i32 = list.get(i32, c.epay, bi as usize)
            let ne2: i32 = list.get(i32, c.epay, (bi + 1) as usize)
            emit_c_ty(sb, p, src, list.get(i32, c.epay, (bi + 2) as usize))
            string_push(sb, " j_")
            string_push(sb, src[ns2 as usize .. ne2 as usize])
            string_push(sb, "; ")
            string_push(done, "|")
            string_push(done, src[ns2 as usize .. ne2 as usize])
            string_push(done, "|")
        }
    }
    string_push(sb, "} JestyrErrPay;\n")
    string_free(done)
}

// Lower `catch |e| match e { ... }` (error-payloads E5, mirroring the
// reference's emit_err_match): a tag if-chain inside the error branch, each
// payload arm binding its union member as a typed const, the `e` binder still
// present as the usual `const int`, and the LAST arm emitted unconditionally
// (typeck proved exhaustiveness, so C gets a totally-assigned result variable
// with no dead final branch).
fn emit_err_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read fbe: parser.ExprData, read base_c: str, n: i32, bt: i32) {
    let btd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
    let unit_ok: bool = btd.kind == 5 and btd.a == 1
    var m: i32 = 0 - 1
    if !unit_ok {
        m = g.tmp
        g.tmp = g.tmp + 1
    }
    // The chain, bodies emitted in arm order (after `_cv` -- the temp order).
    var chain: String = string_new()
    let last: i32 = fbe.y - 1
    var ai: i32 = 0
    for ai < fbe.y {
        let abase: i32 = fbe.x + ai * 3
        let pd: parser.PatData = list.get(parser.PatData, p.pt, list.get(i32, p.par, abase as usize) as usize)
        var cond: i32 = 0 - 1                         // the tag; -1 = wildcard
        var bind: String = string_new()
        if pd.kind == 1 { cond = err_name_tag(g, src, pd.start, pd.end) }   // an Ident pattern's NAME is its own span (x/y are -1)
        if pd.kind == 2 {
            cond = err_name_tag(g, src, pd.x as usize, pd.y as usize)
            if pd.a > 0 {
                let sp: parser.PatData = list.get(parser.PatData, p.pt, list.get(i32, p.par, pd.op as usize) as usize)
                if sp.kind == 1 {                     // an Ident binder reads its member
                    let ptid: i32 = typeck.err_payload_of(c, src, pd.x, pd.y)
                    string_push(bind, "const ")
                    if ptid >= 0 { emit_c_ty(bind, p, src, ptid) } else { string_push(bind, "int") }
                    string_push(bind, " j_")
                    string_push(bind, src[sp.start .. sp.end])
                    string_push(bind, " = _ct")
                    push_uint(bind, n as i64)
                    string_push(bind, ".pay.j_")
                    string_push(bind, src[pd.x as usize .. pd.y as usize])
                    string_push(bind, "; (void)j_")
                    string_push(bind, src[sp.start .. sp.end])
                    string_push(bind, "; ")
                }
            }
        }
        var body: String = string_new()
        emit_expr(body, p, src, c, g, list.get(i32, p.par, (abase + 2) as usize))
        var blk: String = string_new()
        string_push(blk, "{ ")
        string_push(blk, string_view(bind))
        if unit_ok {
            string_push(blk, string_view(body))
            string_push(blk, ";")
        } else {
            string_push(blk, "_cv")
            push_uint(blk, m as i64)
            string_push(blk, " = (")
            string_push(blk, string_view(body))
            string_push(blk, ");")
        }
        string_push(blk, " }")
        if ai == last or cond < 0 {
            if ai > 0 { string_push(chain, "else ") }
            string_push(chain, string_view(blk))
            string_free(bind)
            string_free(body)
            string_free(blk)
            break
        }
        if ai > 0 { string_push(chain, "else ") }
        string_push(chain, "if (_ct")
        push_uint(chain, n as i64)
        string_push(chain, ".err == ")
        push_uint(chain, cond as i64)
        string_push(chain, ") ")
        string_push(chain, string_view(blk))
        string_push(chain, " ")
        string_free(bind)
        string_free(body)
        string_free(blk)
        ai = ai + 1
    }
    string_push(sb, "({ ")
    emit_ty_c(sb, p, src, c, bt)
    string_push(sb, " _ct")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, base_c)
    string_push(sb, "; ")
    if !unit_ok {
        emit_ty_c(sb, p, src, c, btd.a)
        string_push(sb, " _cv")
        push_uint(sb, m as i64)
        string_push(sb, "; ")
    }
    string_push(sb, "if (_ct")
    push_uint(sb, n as i64)
    string_push(sb, ".is_err) { const int j_")
    string_push(sb, src[e.x as usize .. e.y as usize])
    string_push(sb, " = _ct")
    push_uint(sb, n as i64)
    string_push(sb, ".err; (void)j_")
    string_push(sb, src[e.x as usize .. e.y as usize])
    string_push(sb, "; ")
    string_push(sb, string_view(chain))
    string_push(sb, " }")
    if unit_ok {
        string_push(sb, " })")
    } else {
        string_push(sb, " else { _cv")
        push_uint(sb, m as i64)
        string_push(sb, " = _ct")
        push_uint(sb, n as i64)
        string_push(sb, ".ok; } _cv")
        push_uint(sb, m as i64)
        string_push(sb, "; })")
    }
    string_free(chain)
}

// Result-struct typedefs. `JestyrResult_str` (the `try_from_utf8` intrinsic's result) is emitted
// unconditionally up front; fallible user functions add their own (none in `hello`).
fn emit_result_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, mut d: Dc) {
    // The whole-program payload union (D3) precedes the result typedefs (they
    // embed it by value); absent from every payload-free program.
    if err_pay_gated(c) {
        let un: i32 = dc_len(d)
        string_push(d.nb, "JestyrErrPay")
        let ue: i32 = dc_len(d)
        dc_begin(d, sb_len(sb), un, ue, ue, ue)
        emit_err_pay_union(sb, p, src, c)
        dc_end(d, sb_len(sb))
    }
    let sn: i32 = dc_len(d)                           // JestyrResult_str (dep: the union when gated)
    string_push(d.nb, "JestyrResult_str")
    let se: i32 = dc_len(d)
    if err_pay_gated(c) { dc_dep(d, se, "JestyrErrPay") }
    dc_begin(d, sb_len(sb), sn, se, se, dc_len(d))
    string_push(sb, "typedef struct { bool is_err; JestyrStr ok; int err; ")
    push_pay_field(sb, c)
    string_push(sb, "} JestyrResult_str;\n")
    dc_end(d, sb_len(sb))
    var seen: String = string_new()
    string_push(seen, "|str|")                        // `try_from_utf8`'s result is pre-seeded
    // `try_read_file`'s result type isn't discovered from a fn signature — emit it (only when
    // used) and seed `seen` so a user `String !E` fn doesn't duplicate the typedef (B3).
    if uses_try_read(p, src, g.tmode) {
        let tn: i32 = dc_len(d)
        string_push(d.nb, "JestyrResult_String")
        let te: i32 = dc_len(d)
        if err_pay_gated(c) { dc_dep(d, te, "JestyrErrPay") }
        dc_begin(d, sb_len(sb), tn, te, te, dc_len(d))
        string_push(sb, "typedef struct { bool is_err; JestyrString ok; int err; ")
        push_pay_field(sb, c)
        string_push(sb, "} JestyrResult_String;\n")
        dc_end(d, sb_len(sb))
        string_push(seen, "|String|")
    }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and fn_is_fallible(p, it) {
            var m: String = string_new()              // ok-type mangle = the dedup key
            if it.z < 0 { string_push(m, "unit") } else { push_ast_mangle(m, p, src, it.z) }
            var probe: String = string_new()
            string_push(probe, "|")  string_push(probe, string_view(m))  string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                let ns: i32 = dc_len(d)               // JestyrResult_<m>; the ok type is
                string_push(d.nb, "JestyrResult_")    // embedded BY VALUE (unless unit)
                string_push(d.nb, string_view(m))
                let ne: i32 = dc_len(d)
                if it.z >= 0 {
                    var oc0: String = string_new()
                    emit_c_ty(oc0, p, src, it.z)
                    dc_dep(d, ne, string_view(oc0))
                    string_free(oc0)
                }
                if err_pay_gated(c) { dc_dep(d, ne, "JestyrErrPay") }
                dc_begin(d, sb_len(sb), ns, ne, ne, dc_len(d))
                string_push(sb, "typedef struct { bool is_err; ")
                if it.z >= 0 {                        // a unit ok type omits the `ok` field
                    emit_c_ty(sb, p, src, it.z)
                    string_push(sb, " ok; ")
                }
                string_push(sb, "int err; ")
                push_pay_field(sb, c)
                string_push(sb, "} JestyrResult_")
                string_push(sb, string_view(m))
                string_push(sb, ";\n")
                dc_end(d, sb_len(sb))
            }
            string_free(m)  string_free(probe)
        }
        r = r + 1
    }
    // Fallible TRAIT-IMPL methods (trait-errors T2) need their result typedefs
    // too -- plain impls only (a blanket impl's fallible method is refused at
    // check time until the per-instance path learns the ABI).
    var ri9: i32 = 0
    for ri9 < list.len(i32, p.roots) {
        let iid9: i32 = list.get(i32, p.roots, ri9 as usize)
        let it9: parser.ItemData = list.get(parser.ItemData, p.it, iid9 as usize)
        if it9.kind == 7 and it9.h <= 0 {
            var mk9: i32 = 0
            for mk9 < it9.z {
                let fd9: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it9.b + mk9) as usize) as usize)
                if fn_is_fallible(p, fd9) {
                    let ok9: i32 = impl_ok_tid(p, src, it9, fd9)
                    var m9: String = string_new()
                    if ok9 < 0 { string_push(m9, "unit") } else { push_ast_mangle(m9, p, src, ok9) }
                    var probe9: String = string_new()
                    string_push(probe9, "|")  string_push(probe9, string_view(m9))  string_push(probe9, "|")
                    if !contains(string_view(seen), string_view(probe9)) {
                        string_push(seen, string_view(probe9))
                        let ns9: i32 = dc_len(d)
                        string_push(d.nb, "JestyrResult_")
                        string_push(d.nb, string_view(m9))
                        let ne9: i32 = dc_len(d)
                        if ok9 >= 0 {
                            var oc9: String = string_new()
                            emit_c_ty(oc9, p, src, ok9)
                            dc_dep(d, ne9, string_view(oc9))
                            string_free(oc9)
                        }
                        if err_pay_gated(c) { dc_dep(d, ne9, "JestyrErrPay") }
                        dc_begin(d, sb_len(sb), ns9, ne9, ne9, dc_len(d))
                        string_push(sb, "typedef struct { bool is_err; ")
                        if ok9 >= 0 {
                            emit_c_ty(sb, p, src, ok9)
                            string_push(sb, " ok; ")
                        }
                        string_push(sb, "int err; ")
                        push_pay_field(sb, c)
                        string_push(sb, "} JestyrResult_")
                        string_push(sb, string_view(m9))
                        string_push(sb, ";\n")
                        dc_end(d, sb_len(sb))
                    }
                    string_free(m9)  string_free(probe9)
                }
                mk9 = mk9 + 1
            }
        }
        ri9 = ri9 + 1
    }
    // Fallible METHOD instances need their result typedefs too -- one ok type per
    // instantiation, walked in `g.gmi` order (the LIFO worklist order, which IS the
    // reference's `method_instances` order), deduped through the same `seen` so a
    // method sharing a free fn's ok type never duplicates the typedef.
    var rb: i32 = 0
    for rb < list.len(i32, g.gmi) as i32 {
        let mf: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.gmi, rb as usize) as usize)
        let argc: i32 = list.get(i32, g.gmi, (rb + 1) as usize)
        if fn_is_fallible(p, mf) {
            arm_gmi_su(g, p, rb)                      // the ok type resolves through the subst
            var m2: String = string_new()
            if mf.z < 0 { string_push(m2, "unit") } else { push_su_result_mangle(m2, p, src, c, g, mf.z) }
            var probe2: String = string_new()
            string_push(probe2, "|")  string_push(probe2, string_view(m2))  string_push(probe2, "|")
            if !contains(string_view(seen), string_view(probe2)) {
                string_push(seen, string_view(probe2))
                let ns2: i32 = dc_len(d)
                string_push(d.nb, "JestyrResult_")
                string_push(d.nb, string_view(m2))
                let ne2: i32 = dc_len(d)
                if mf.z >= 0 {
                    var oc2: String = string_new()
                    emit_su_ty(oc2, p, src, c, g, mf.z)
                    dc_dep(d, ne2, string_view(oc2))
                    string_free(oc2)
                }
                if err_pay_gated(c) { dc_dep(d, ne2, "JestyrErrPay") }
                dc_begin(d, sb_len(sb), ns2, ne2, ne2, dc_len(d))
                string_push(sb, "typedef struct { bool is_err; ")
                if mf.z >= 0 {
                    emit_su_ty(sb, p, src, c, g, mf.z)
                    string_push(sb, " ok; ")
                }
                string_push(sb, "int err; ")
                push_pay_field(sb, c)
                string_push(sb, "} JestyrResult_")
                string_push(sb, string_view(m2))
                string_push(sb, ";\n")
                dc_end(d, sb_len(sb))
            }
            string_free(m2)  string_free(probe2)
            list.truncate(i32, g.su, 0)
        }
        var reclen2: i32 = 3 + argc * 3               // fn item, argc, args x3, ctor item
        rb = rb + reclen2
    }
    string_free(seen)
    string_push(sb, "\n")
}

// Function prototypes: one `<sig>;` per non-generic, backend-supported function, then one per
// monomorphized generic instance (subst-aware sig), then the unconditional blank.
// ---- closures: lambda lifting (mirrors `collect_closures`/`make_closure_info`/`closure_types`/
// `closure_fns`/`emit_closure_literal`/`emit_closure_invoke`). Every lifted name embeds the
// closure's ExprId — legal only because the Jestyr parser's expr-arena numbering is pinned to
// the reference's (the P2 golden). A closure the Checker stamped with a `Fn` type (kind 12) is
// a THIN coerced closure -> a bare `static` function + `(&jestyr_lam_<id>)`; one left
// Opaque("closure") (kind 18, x=0) is FAT -> `JestyrEnv_<id>`/`JestyrClosure_<id>` + env. ----

// Find closure expressions in the reference's discovery order: preorder (a closure pushes
// itself, THEN its body walks — a nested closure lands after its owner). NOTE the reference's
// `find_closures_expr` walks a NARROWER arm set than `gfind_expr` (no Cast, no Range, no
// Region) — mirrored exactly, since discovery order = emission order.
fn cfind_expr(mut found: List(i32), read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 37 {                                 // Closure: record, then walk the body
        list.push(i32, found, eid)
        cfind_expr(found, p, e.a)
        return
    }
    if e.kind == 10 {                                 // Call: callee first, then args
        cfind_expr(found, p, e.a)
        var i: i32 = 0
        for i < e.y {
            cfind_expr(found, p, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {   // Binary / Index / Assign
        cfind_expr(found, p, e.a)
        cfind_expr(found, p, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 34 or e.kind == 35 {
        cfind_expr(found, p, e.a)                     // Unary / Field / Deref / Try / Invariant / Variant
        return
    }
    if e.kind == 16 {                                 // StructLit fields + spread
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            cfind_expr(found, p, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { cfind_expr(found, p, e.b) }
        return
    }
    if e.kind == 17 {                                 // GenStructLit fields
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            cfind_expr(found, p, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {                                 // If: cond, then-block, else
        cfind_expr(found, p, e.a)
        cfind_block(found, p, e.b)
        if e.op >= 0 { cfind_expr(found, p, e.op) }
        return
    }
    if e.kind == 23 { cfind_block(found, p, eid)  return }
    if e.kind == 25 { cfind_block(found, p, e.a)  return }
    if e.kind == 28 {                                 // Match: scrutinee, then per-arm guard + body
        cfind_expr(found, p, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { cfind_expr(found, p, guard) }
            cfind_expr(found, p, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For: head sources, body, else
        if e.op == 1 { cfind_expr(found, p, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                cfind_expr(found, p, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        cfind_block(found, p, e.b)
        if e.x >= 0 { cfind_block(found, p, e.x) }
        return
    }
}

fn cfind_block(mut found: List(i32), read p: parser.Parser, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { cfind_expr(found, p, s.a) }
        i = i + 1
    }
}

// Gather every value-name reference in a subtree as (start, end, ExprId) triples, in the
// reference's `collect_refs` traversal order (the ExprId keys the Checker's inferred type for
// the capture's env-field C type). Recurses into NESTED closure bodies, and shares the parent
// walk's deliberate holes (no Cast/Range arms).
fn crefs_expr(mut dst: List(i32), read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 2 {                                  // Name: record it
        list.push(i32, dst, e.start as i32)
        list.push(i32, dst, e.end as i32)
        list.push(i32, dst, eid)
        return
    }
    if e.kind == 37 { crefs_expr(dst, p, e.a)  return }   // nested closure: walk its body
    if e.kind == 10 {
        crefs_expr(dst, p, e.a)
        var i: i32 = 0
        for i < e.y {
            crefs_expr(dst, p, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {
        crefs_expr(dst, p, e.a)
        crefs_expr(dst, p, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 34 or e.kind == 35 {
        crefs_expr(dst, p, e.a)
        return
    }
    if e.kind == 16 {
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            crefs_expr(dst, p, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { crefs_expr(dst, p, e.b) }
        return
    }
    if e.kind == 17 {
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            crefs_expr(dst, p, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {
        crefs_expr(dst, p, e.a)
        crefs_block(dst, p, e.b)
        if e.op >= 0 { crefs_expr(dst, p, e.op) }
        return
    }
    if e.kind == 23 { crefs_block(dst, p, eid)  return }
    if e.kind == 25 { crefs_block(dst, p, e.a)  return }
    if e.kind == 28 {
        crefs_expr(dst, p, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { crefs_expr(dst, p, guard) }
            crefs_expr(dst, p, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {
        if e.op == 1 { crefs_expr(dst, p, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                crefs_expr(dst, p, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        crefs_block(dst, p, e.b)
        if e.x >= 0 { crefs_block(dst, p, e.x) }
        return
    }
}

fn crefs_block(mut dst: List(i32), read p: parser.Parser, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { crefs_expr(dst, p, s.a) }
        i = i + 1
    }
}

// Is `src[ns..ne]` a top-level/global name (so a reference to it inside a closure body is NOT a
// capture)? Fns, types, enum variants, consts, and intrinsics. Mirrors `is_global_name`.
fn is_global_cname(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> bool {
    let nm: str = src[ns .. ne]
    if find_fn_item(p, src, nm) >= 0 { return true }
    if find_named_item(p, src, ns as i32, ne as i32) >= 0 { return true }
    if find_variant_enum(p, src, ns, ne) >= 0 { return true }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 2 {
            if str_eq(src[it.x .. it.y], nm) { return true }
        }
        r = r + 1
    }
    // The full intrinsic name set (mirrors `is_intrinsic` — wider than the helper tables).
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, nm)
    string_push(probe, "|")
    let hit: bool = contains("|print_int|print_float|print_str|print_bool|alloc|alloc_i32|realloc|realloc_i32|free_ptr|size_of|slice|align_of|offset_of|count_codepoints|codepoints|from_utf8|is_utf8|substr|str_eq|starts_with|ends_with|contains|find|trim|count_graphemes|graphemes|split|try_from_utf8|eq_fold|os_from_bytes|to_str_lossy|cow_borrow|cow_to_mut|cow_view|cow_is_owned|cow_free|string_new|string_from|string_push|string_view|string_free|builder_new|builder_push|builder_build|builder_free|region_str|region_concat|bytes|gen_new|gen_free|region_alloc|ok|err|is_err|unwrap|arena_open|arena_alloc|arena_close|read_file|try_read_file|write_file|file_exists|remove_file|run_command|eprint_str|signal_arm|signal_caught|signal_raise|random_fill|env_block|env_var|mono_nanos|arg_count|arg|", string_view(probe))
    string_free(probe)
    return hit
}

// Does closure `e`'s own param list bind `src[ns..ne]`? (clar 3-tuples at e.x, count e.y.)
fn closure_has_param(read p: parser.Parser, read src: str, read e: parser.ExprData, ns: usize, ne: usize) -> bool {
    var i: i32 = 0
    for i < e.y {
        let b: i32 = e.x + i * 3
        let pns: i32 = list.get(i32, p.clar, b as usize)
        let pne: i32 = list.get(i32, p.clar, (b + 1) as usize)
        if str_eq(src[pns as usize .. pne as usize], src[ns .. ne]) { return true }
        i = i + 1
    }
    return false
}

// Append closure `cid`'s captures to `dst` as (start, end, ref ExprId) triples: free names of
// the body in first-reference order — not params, not globals, deduped by text. Mirrors
// `make_closure_info`.
fn closure_captures(mut dst: List(i32), read p: parser.Parser, read src: str, read a: Allocator, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    var refs: List(i32) = list.make(i32, a)
    crefs_expr(refs, p, e.a)
    let base: usize = list.len(i32, dst)
    var i: usize = 0
    for i < list.len(i32, refs) {
        let ns: i32 = list.get(i32, refs, i)
        let ne: i32 = list.get(i32, refs, i + 1)
        var skip: bool = closure_has_param(p, src, e, ns as usize, ne as usize)
        if !skip {
            if is_global_cname(p, src, ns as usize, ne as usize) { skip = true }
        }
        if !skip {
            var j: usize = base
            for j < list.len(i32, dst) {
                let dns: i32 = list.get(i32, dst, j)
                let dne: i32 = list.get(i32, dst, j + 1)
                if str_eq(src[ns as usize .. ne as usize], src[dns as usize .. dne as usize]) { skip = true }
                j = j + 3
            }
        }
        if !skip {
            list.push(i32, dst, ns)
            list.push(i32, dst, ne)
            list.push(i32, dst, list.get(i32, refs, i + 2))
        }
        i = i + 3
    }
    list.free(i32, refs)
}

// Collect every closure in a NON-generic fn body, const value, or non-generic struct-method
// body (item order; closures inside generic bodies are deferred to monomorphization, exactly
// like the reference), then precompute each one's capture list into `g.cca` (`g.ccx` holds the
// per-closure (base, count) pairs, triple units).
fn collect_closures(mut g: Cg, read p: parser.Parser, read src: str, read a: Allocator) {
    var found: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_gen(p, it) { cfind_block(found, p, it.w) }
        if it.kind == 2 { cfind_expr(found, p, it.b) }
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mb: i32 = it.a + m * 10
                if list.get(i32, p.mar, mb as usize) == 1 {   // tag 1 = method
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mb + 1) as usize) as usize)
                    if !fn_is_gen(p, fd) { cfind_block(found, p, fd.w) }
                }
                m = m + 1
            }
        }
        r = r + 1
    }
    var i: usize = 0
    for i < list.len(i32, found) {
        let cid: i32 = list.get(i32, found, i)
        list.push(i32, g.cls, cid)
        let cb: i32 = (list.len(i32, g.cca) / 3) as i32
        closure_captures(g.cca, p, src, a, cid)
        list.push(i32, g.ccx, cb)
        list.push(i32, g.ccx, (list.len(i32, g.cca) / 3) as i32 - cb)
        i = i + 1
    }
    list.free(i32, found)
}

// Map a Jestyr expr id to the REFERENCE parser's ExprId for the same node. The Rust AST stores
// fn/method/impl bodies, if-THEN blocks, for body/else blocks, and unsafe/concurrent/region
// inner blocks as `Block` STRUCTS (no ExprId), and struct-literal field inits as plain structs —
// the Jestyr parser allocates a real expr node for each, shifting every later Jestyr id up by
// one. The reference embeds ITS ids in the lifted-closure names (`jestyr_lam_<id>`,
// `JestyrEnv_<id>`, `JestyrClosure_<id>`), so subtract the Jestyr-only nodes below `eid`.
// (If-ELSE blocks, bare block statements, match-arm bodies, and closure bodies are
// expr-position in Rust — shared ids, no offset. F-string interpolations are the one RUST-only
// allocation — the reference parses each interp as a real sub-expression, the span-only Jestyr
// node doesn't — unhandled until an allowlist file mixes f-strings with closures; select-arm
// blocks likewise wait for concurrency.)
fn ref_expr_id(read p: parser.Parser, eid: i32) -> i32 {
    var off: i32 = 0
    var i: usize = 0
    for i < (eid as usize) {                          // FieldInit nodes are always Jestyr-only
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 18 { off = off + 1 }
        i = i + 1
    }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {                  // fn / struct-method / impl-method bodies
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if it.w >= 0 and it.w < eid { off = off + 1 }
        }
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mb: i32 = it.a + m * 10
                if list.get(i32, p.mar, mb as usize) == 1 {
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mb + 1) as usize) as usize)
                    if fd.w >= 0 and fd.w < eid { off = off + 1 }
                }
                m = m + 1
            }
        }
        if it.kind == 7 {
            var k: i32 = 0
            for k < it.z {
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + k) as usize) as usize)
                if fd.w >= 0 and fd.w < eid { off = off + 1 }
                k = k + 1
            }
        }
        r = r + 1
    }
    var j: usize = 0
    for j < list.len(parser.ExprData, p.ex) {         // expr-embedded struct-slot blocks
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, j)
        if e.kind == 24 {                             // if-THEN
            if e.b >= 0 and e.b < eid { off = off + 1 }
        } else if e.kind == 31 {                      // for body + else
            if e.b >= 0 and e.b < eid { off = off + 1 }
            if e.x >= 0 and e.x < eid { off = off + 1 }
        } else if e.kind == 25 or e.kind == 38 or e.kind == 43 {   // unsafe / concurrent / region
            if e.a >= 0 and e.a < eid { off = off + 1 }
        } else if e.kind == 46 {                      // with alive: body + else are Block structs
            if e.b >= 0 and e.b < eid { off = off + 1 }
            if e.op >= 0 and e.op < eid { off = off + 1 }
        } else if e.kind == 42 {                      // select: EVERY arm body is a Block struct in
            var q: i32 = 0                            // the reference (`SelectArm.body`), so this
            for q < e.y {                             // parser's per-arm block node has no counterpart
                let ab: i32 = list.get(i32, p.par, (e.x + q * 4 + 3) as usize)
                if ab >= 0 and ab < eid { off = off + 1 }
                q = q + 1
            }
        } else if e.kind == 16 {                      // struct-lit path: an Ident in Rust, a Name node
            if e.a >= 0 and e.a < eid { off = off + 1 }   // here. (A GenStructLit's ctor is NOT counted:
        }                                             // the Rust parser reaches `Name(args){` through the
                                                      // call-postfix path, so it allocates-and-abandons
                                                      // the same orphan Name this parser does.)
        j = j + 1
    }
    return eid - off
}

// The index of `cid` in the collected-closure list, or -1 (mirrors `closure_index`).
fn closure_index_of(read g: Cg, cid: i32) -> i32 {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        if list.get(i32, g.cls, k) == cid { return k as i32 }
        k = k + 1
    }
    return 0 - 1
}

// Was this closure coerced to a thin fn-pointer? (The Checker stamps such a closure with the
// expected `Fn` type — TyData kind 12 — instead of Opaque("closure").)
fn closure_is_thin(read c: typeck.Checker, cid: i32) -> bool {
    let t: i32 = list.get(i32, c.et, cid as usize)
    if t < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, t as usize)
    return d.kind == 12
}

// The `closure_types` section: per FAT closure, the env struct + `{call, env}` struct typedefs
// (a thin coerced closure is a bare function — no structs), then the reference's UNCONDITIONAL
// trailing blank.
fn emit_closure_types(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        let cid: i32 = list.get(i32, g.cls, k)
        if !closure_is_thin(c, cid) {
            let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
            let rn: i32 = ref_expr_id(p, cid)         // the REFERENCE's id names the structs
            let cb: i32 = list.get(i32, g.ccx, k * 2)
            let cc: i32 = list.get(i32, g.ccx, k * 2 + 1)
            string_push(sb, "typedef struct { ")
            if cc == 0 { string_push(sb, "char _unused; ") }
            var ci: i32 = 0
            for ci < cc {
                let b: i32 = (cb + ci) * 3
                let ns: i32 = list.get(i32, g.cca, b as usize)
                let ne: i32 = list.get(i32, g.cca, (b + 1) as usize)
                let rid: i32 = list.get(i32, g.cca, (b + 2) as usize)
                emit_ty_c(sb, p, src, c, list.get(i32, c.et, rid as usize))
                string_push(sb, " j_")
                string_push(sb, src[ns as usize .. ne as usize])
                string_push(sb, "; ")
                ci = ci + 1
            }
            string_push(sb, "} JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, ";\n")
            string_push(sb, "typedef struct { ")
            emit_ty_c(sb, p, src, c, list.get(i32, c.et, e.a as usize))   // ret = the body's type
            string_push(sb, " (*call)(JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, "*")
            var pi: i32 = 0
            for pi < e.y {
                string_push(sb, ", ")
                let pty: i32 = list.get(i32, p.clar, (e.x + pi * 3 + 2) as usize)
                if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
                pi = pi + 1
            }
            string_push(sb, "); JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, " env; } JestyrClosure_")
            push_uint(sb, rn as i64)
            string_push(sb, ";\n")
        }
        k = k + 1
    }
    string_push(sb, "\n")
}

// The single non-block-body shape shared by both lifted-fn forms: a Block/Unsafe body reuses
// `emit_body` at depth 0; any other body wraps in a brace pair with the expr as the tail
// return (or a bare statement when the return type is void). Mirrors `emit_closure_body`.
fn emit_closure_body_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, retval: bool) {
    let b: parser.ExprData = list.get(parser.ExprData, p.ex, body as usize)
    if b.kind == 23 { emit_body(sb, p, src, c, g, body, retval, 0)  return }
    if b.kind == 25 { emit_body(sb, p, src, c, g, b.a, retval, 0)  return }
    string_push(sb, "{\n")
    if retval {
        emit_return(sb, p, src, c, g, body, 1)
    } else {
        if b.kind == 24 { emit_if(sb, p, src, c, g, body, false, 1) }
        else if b.kind == 28 { emit_match(sb, p, src, c, g, body, false, 1) }
        else {
            indent(sb, 1)
            emit_expr(sb, p, src, c, g, body)
            string_push(sb, ";\n")
        }
    }
    string_push(sb, "}\n")
}

// A coerced non-capturing closure as a BARE top-level function whose C signature is taken from
// the expected fn-pointer TYPE (so it matches the `JestyrFn_…` typedef byte-for-byte); a
// `mut`/`out` param arrives by pointer, exactly as a real Jestyr function's would. Mirrors
// `emit_thin_closure_fn`.
fn emit_thin_closure_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    let ctd: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, c.et, cid as usize) as usize)
    list.truncate(i32, g.su, 0)
    list.truncate(i32, g.pp, 0)
    list.truncate(i32, g.req, 0)
    list.truncate(i32, g.ens, 0)
    list.truncate(i32, g.caps, 0)
    g.res_ok = 0 - 2
    var rets: String = string_new()
    emit_ty_c(rets, p, src, c, ctd.x)
    string_push(sb, "static ")
    string_push(sb, string_view(rets))
    string_push(sb, " jestyr_lam_")
    push_uint(sb, ref_expr_id(p, cid) as i64)
    string_push(sb, "(")
    if ctd.b == 0 { string_push(sb, "void") }
    var pi: i32 = 0
    for pi < ctd.b {
        if pi > 0 { string_push(sb, ", ") }
        let conv: i32 = list.get(i32, c.tya, (ctd.a + pi * 2) as usize)
        emit_ty_c(sb, p, src, c, list.get(i32, c.tya, (ctd.a + pi * 2 + 1) as usize))
        if conv == 2 or conv == 4 { string_push(sb, "*") }
        string_push(sb, " j_")
        if pi < e.y {
            let pb: i32 = e.x + pi * 3
            let pns: i32 = list.get(i32, p.clar, pb as usize)
            let pne: i32 = list.get(i32, p.clar, (pb + 1) as usize)
            string_push(sb, src[pns as usize .. pne as usize])
            if conv == 2 or conv == 4 {
                list.push(i32, g.pp, pns)
                list.push(i32, g.pp, pne)
            }
        } else {
            string_push(sb, "_p")
            push_uint(sb, pi as i64)
        }
        pi = pi + 1
    }
    string_push(sb, ")\n")
    emit_closure_body_c(sb, p, src, c, g, e.a, !str_eq(string_view(rets), "void"))
    string_push(sb, "\n")
    list.truncate(i32, g.pp, 0)
    string_free(rets)
}

// One lifted FAT closure fn: captures arrive through `j__env`, params as ordinary arguments.
// The active capture set (`g.caps`) makes the body's Name arm render a captured name as
// `(j__env->j_<name>)`. Mirrors the fat arm of `closure_fns`.
fn emit_fat_closure_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, k: usize, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    list.truncate(i32, g.su, 0)
    list.truncate(i32, g.pp, 0)
    list.truncate(i32, g.req, 0)
    list.truncate(i32, g.ens, 0)
    g.res_ok = 0 - 2
    list.truncate(i32, g.caps, 0)
    let cb: i32 = list.get(i32, g.ccx, k * 2)
    let cc: i32 = list.get(i32, g.ccx, k * 2 + 1)
    var ci: i32 = 0
    for ci < cc {
        let b: i32 = (cb + ci) * 3
        list.push(i32, g.caps, list.get(i32, g.cca, b as usize))
        list.push(i32, g.caps, list.get(i32, g.cca, (b + 1) as usize))
        ci = ci + 1
    }
    var rets: String = string_new()
    emit_ty_c(rets, p, src, c, list.get(i32, c.et, e.a as usize))
    let rn: i32 = ref_expr_id(p, cid)
    string_push(sb, "static ")
    string_push(sb, string_view(rets))
    string_push(sb, " jestyr_lam_")
    push_uint(sb, rn as i64)
    string_push(sb, "(JestyrEnv_")
    push_uint(sb, rn as i64)
    string_push(sb, "* j__env")
    var pi: i32 = 0
    for pi < e.y {
        string_push(sb, ", ")
        let pb: i32 = e.x + pi * 3
        let pty: i32 = list.get(i32, p.clar, (pb + 2) as usize)
        if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
        string_push(sb, " j_")
        let pns: i32 = list.get(i32, p.clar, pb as usize)
        let pne: i32 = list.get(i32, p.clar, (pb + 1) as usize)
        string_push(sb, src[pns as usize .. pne as usize])
        pi = pi + 1
    }
    string_push(sb, ")\n")
    emit_closure_body_c(sb, p, src, c, g, e.a, !str_eq(string_view(rets), "void"))
    string_push(sb, "\n")
    list.truncate(i32, g.caps, 0)
    string_free(rets)
}

// ---- `dyn Trait` dispatch (mirrors `dyn_typedefs`/`dyn_vtables`/`emit_dyn_coercion` + the
// `dyn_calls` lowering). A trait is dyn-USED iff some `dyn T` type is written anywhere; each
// impl of such a trait gets `void*`-erased shims + a static vtable instance, and every value
// the Checker recorded as coercing wraps into the `{ data, vtable }` fat pointer. ----

fn trait_is_dyn(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> bool {
    var ti: usize = 0
    for ti < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, ti)
        if t.kind == 10 {
            if str_eq(src[t.x as usize .. t.y as usize], src[ns .. ne]) { return true }
        }
        ti = ti + 1
    }
    return false
}

// Lexicographic byte order on source text (the trait-typedef sort key).
fn str_lt(read a: str, read b: str) -> bool {
    var i: usize = 0
    for i < a.len {
        if i >= b.len { return false }
        let ca: u8 = a[i]
        let cb: u8 = b[i]
        if ca < cb { return true }
        if ca > cb { return false }
        i = i + 1
    }
    return a.len < b.len
}

// A trait method's non-self, non-comptime params as `, <cty>[* restrict] j_<name>` (the shim
// and vtable-slot signatures share this; mirrors `borrow_ptr_cty`).
fn emit_dyn_params(mut sb: String, read p: parser.Parser, read src: str, pstart: i32, pcount: i32) {
    var i: i32 = 0
    for i < pcount {
        let base: i32 = pstart + i * 7
        if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
            string_push(sb, ", ")
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
            string_push(sb, " j_")
            let ns: i32 = list.get(i32, p.iar, (base + 2) as usize)
            let ne: i32 = list.get(i32, p.iar, (base + 3) as usize)
            string_push(sb, src[ns as usize .. ne as usize])
        }
        i = i + 1
    }
}

// The `dyn_typedefs` section: per dyn-used trait (SORTED BY NAME — the reference sorts), the
// vtable struct (one `void* self`-first fn-pointer slot per trait method, decl order) and the
// `{ void* data; const vtable* }` fat-pointer typedef; trailing blank iff any.
fn emit_dyn_typedefs(mut sb: String, read p: parser.Parser, read src: str, read a: Allocator) {
    var trs: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 6 {
            if trait_is_dyn(p, src, it.x as usize, it.y as usize) { list.push(i32, trs, iid) }
        }
        r = r + 1
    }
    var i: usize = 0
    for i < list.len(i32, trs) {                      // selection sort by name (the set is tiny)
        var m: usize = i
        var j: usize = i + 1
        for j < list.len(i32, trs) {
            let ta: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, trs, j) as usize)
            let tb: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, trs, m) as usize)
            if str_lt(src[ta.x .. ta.y], src[tb.x .. tb.y]) { m = j }
            j = j + 1
        }
        if m != i {
            let tmp: i32 = list.get(i32, trs, i)
            list.set(i32, trs, i, list.get(i32, trs, m))
            list.set(i32, trs, m, tmp)
        }
        i = i + 1
    }
    var k: usize = 0
    for k < list.len(i32, trs) {
        let it: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, trs, k) as usize)
        string_push(sb, "typedef struct {\n")
        var mi2: i32 = 0
        for mi2 < it.b {
            let mb: i32 = it.a + mi2 * 8
            string_push(sb, "    ")
            let rty: i32 = list.get(i32, p.mar, (mb + 5) as usize)
            if rty >= 0 { emit_c_ty(sb, p, src, rty) } else { string_push(sb, "void") }
            string_push(sb, " (*")
            let mns: i32 = list.get(i32, p.mar, mb as usize)
            let mne: i32 = list.get(i32, p.mar, (mb + 1) as usize)
            string_push(sb, src[mns as usize .. mne as usize])
            string_push(sb, ")(void* self")
            emit_dyn_params(sb, p, src, list.get(i32, p.mar, (mb + 2) as usize), list.get(i32, p.mar, (mb + 3) as usize))
            string_push(sb, ");\n")
            mi2 = mi2 + 1
        }
        string_push(sb, "} JestyrVtable_")
        string_push(sb, src[it.x .. it.y])
        string_push(sb, ";\n")
        string_push(sb, "typedef struct { void* data; const JestyrVtable_")
        string_push(sb, src[it.x .. it.y])
        string_push(sb, "* vtable; } JestyrDyn_")
        string_push(sb, src[it.x .. it.y])
        string_push(sb, ";\n")
        k = k + 1
    }
    if list.len(i32, trs) > 0 { string_push(sb, "\n") }
    list.free(i32, trs)
}

// The `dyn_vtables` section: per impl of a dyn-used trait (item order), a `void*`-erased shim
// per impl method (deref'd receiver for a by-value self, pointer for `mut`/`out` self) and a
// `static const` vtable instance wired to the shims in TRAIT-method order.
fn emit_dyn_vtables(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let im: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if im.kind == 7 {
            if trait_is_dyn(p, src, im.x as usize, im.y as usize) {
                let tt: parser.TypeData = list.get(parser.TypeData, p.ty, im.a as usize)
                let key: str = src[tt.start .. tt.end]     // a Name target's text IS the type key
                var k: i32 = 0
                for k < im.z {
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (im.b + k) as usize) as usize)
                    string_push(sb, "static ")
                    if fd.z >= 0 { emit_c_ty(sb, p, src, fd.z) } else { string_push(sb, "void") }
                    string_push(sb, " jestyr_vtshim_")
                    string_push(sb, src[im.x as usize .. im.y as usize])
                    string_push(sb, "__")
                    string_push(sb, key)
                    string_push(sb, "__")
                    string_push(sb, src[fd.x .. fd.y])
                    string_push(sb, "(void* self")
                    emit_dyn_params(sb, p, src, fd.a, fd.b)
                    string_push(sb, ") { ")
                    var isret: bool = false
                    if fd.z >= 0 {
                        var rc: String = string_new()
                        emit_c_ty(rc, p, src, fd.z)
                        if !str_eq(string_view(rc), "void") { isret = true }
                        string_free(rc)
                    }
                    if isret { string_push(sb, "return ") }
                    string_push(sb, "jestyr_impl_")
                    string_push(sb, src[im.x as usize .. im.y as usize])
                    string_push(sb, "__")
                    string_push(sb, key)
                    string_push(sb, "__")
                    string_push(sb, src[fd.x .. fd.y])
                    string_push(sb, "(")
                    // `void* self` back to the concrete receiver: deref for by-value self
                    var self_ptr: bool = false
                    if fd.b > 0 {
                        if list.get(i32, p.iar, (fd.a + 4) as usize) == 1 {
                            let sconv: i32 = list.get(i32, p.iar, (fd.a + 1) as usize)
                            if sconv == 2 or sconv == 4 { self_ptr = true }
                        }
                    }
                    if self_ptr { string_push(sb, "(") } else { string_push(sb, "*(") }
                    emit_c_ty(sb, p, src, im.a)
                    string_push(sb, "*)self")
                    var pi: i32 = 0
                    for pi < fd.b {
                        let pb: i32 = fd.a + pi * 7
                        if list.get(i32, p.iar, pb as usize) == 0 and list.get(i32, p.iar, (pb + 4) as usize) == 0 {
                            string_push(sb, ", j_")
                            let pns: i32 = list.get(i32, p.iar, (pb + 2) as usize)
                            let pne: i32 = list.get(i32, p.iar, (pb + 3) as usize)
                            string_push(sb, src[pns as usize .. pne as usize])
                        }
                        pi = pi + 1
                    }
                    string_push(sb, "); }\n")
                    k = k + 1
                }
                // the vtable instance, fields in TRAIT-method order
                string_push(sb, "static const JestyrVtable_")
                string_push(sb, src[im.x as usize .. im.y as usize])
                string_push(sb, " jestyr_vt_")
                string_push(sb, src[im.x as usize .. im.y as usize])
                string_push(sb, "__")
                string_push(sb, key)
                string_push(sb, " = { ")
                var tr: i32 = 0
                var tit: i32 = 0 - 1
                for tr < list.len(i32, p.roots) {
                    let tid2: i32 = list.get(i32, p.roots, tr as usize)
                    let t2: parser.ItemData = list.get(parser.ItemData, p.it, tid2 as usize)
                    if t2.kind == 6 {
                        if str_eq(src[t2.x .. t2.y], src[im.x as usize .. im.y as usize]) { tit = tid2 }
                    }
                    tr = tr + 1
                }
                if tit >= 0 {
                    let t2: parser.ItemData = list.get(parser.ItemData, p.it, tit as usize)
                    var tm: i32 = 0
                    for tm < t2.b {
                        if tm > 0 { string_push(sb, ", ") }
                        let mb2: i32 = t2.a + tm * 8
                        string_push(sb, "jestyr_vtshim_")
                        string_push(sb, src[im.x as usize .. im.y as usize])
                        string_push(sb, "__")
                        string_push(sb, key)
                        string_push(sb, "__")
                        let m2s: i32 = list.get(i32, p.mar, mb2 as usize)
                        let m2e: i32 = list.get(i32, p.mar, (mb2 + 1) as usize)
                        string_push(sb, src[m2s as usize .. m2e as usize])
                        tm = tm + 1
                    }
                }
                string_push(sb, " };\n")
            }
        }
        r = r + 1
    }
}

// A recorded coercion site: wrap the concrete value into the trait's fat pointer. A SCALAR
// value (prim except str/String/Builder, or a pointer — mirrors `is_scalar_ty`) has no
// address, so it wraps through a compound literal.
fn emit_dyn_coercion(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, tns: i32, tne: i32) {
    let at: i32 = list.get(i32, c.et, eid as usize)
    let ad: typeck.TyData = list.get(typeck.TyData, c.tys, at as usize)
    var scalar: bool = false
    if ad.kind == 2 {
        if ad.x != 14 and ad.x != 17 and ad.x != 18 { scalar = true }
    }
    if ad.kind == 3 { scalar = true }
    let saved: i32 = g.dg
    g.dg = eid
    var inner: String = string_new()
    emit_expr(inner, p, src, c, g, eid)
    g.dg = saved
    string_push(sb, "(JestyrDyn_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "){ ")
    if scalar {
        string_push(sb, "&((")
        emit_ty_c(sb, p, src, c, at)
        string_push(sb, "){ ")
        string_push(sb, string_view(inner))
        string_push(sb, " })")
    } else {
        string_push(sb, "&(")
        string_push(sb, string_view(inner))
        string_push(sb, ")")
    }
    string_push(sb, ", &jestyr_vt_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "__")
    push_key_of_tyid(sb, src, c, at)
    string_push(sb, " }")
    string_free(inner)
}

// ---- concurrency: spawn/concurrent (mirrors `collect_spawns`/`spawn_runtime`/
// `emit_concurrent`/`emit_spawn_create`/`emit_dyn_spawn`). A spawn site is the INNER call
// expr of `spawn f(args)`; its REFERENCE ExprId names the arg-pack struct `_jsp_<id>` and
// the `void*` trampoline `jestyr_task_<id>`. ----

// Is the spawn's inner expr a direct call of a named fn? (`spawn_site` returns the call.)
fn spawn_call_of(read p: parser.Parser, inner: i32) -> i32 {
    if inner < 0 { return 0 - 1 }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, inner as usize)
    if e.kind != 10 { return 0 - 1 }
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 2 { return 0 - 1 }
    return inner
}

fn sfind_expr(mut sites: List(i32), read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 38 { sfind_block(sites, p, e.a)  return }        // concurrent { … }
    if e.kind == 23 { sfind_block(sites, p, eid)  return }
    if e.kind == 25 { sfind_block(sites, p, e.a)  return }
    if e.kind == 39 {                                             // spawn: record the inner call
        let call: i32 = spawn_call_of(p, e.a)
        if call >= 0 { list.push(i32, sites, call) }
        return
    }
    if e.kind == 24 {
        sfind_expr(sites, p, e.a)
        sfind_block(sites, p, e.b)
        if e.op >= 0 { sfind_expr(sites, p, e.op) }
        return
    }
    if e.kind == 28 {
        sfind_expr(sites, p, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { sfind_expr(sites, p, guard) }
            sfind_expr(sites, p, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                             // For: body + else only
        sfind_block(sites, p, e.b)
        if e.x >= 0 { sfind_block(sites, p, e.x) }
        return
    }
}

fn sfind_block(mut sites: List(i32), read p: parser.Parser, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { sfind_expr(sites, p, s.a) }
        i = i + 1
    }
}

// Every spawn site in a non-generic fn body or struct-method body (item order). Mirrors
// `collect_spawns` (methods are walked WITHOUT a generic filter, like the reference).
fn collect_spawns(mut g: Cg, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_gen(p, it) { sfind_block(g.sps, p, it.w) }
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mb: i32 = it.a + m * 10
                if list.get(i32, p.mar, mb as usize) == 1 {
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mb + 1) as usize) as usize)
                    sfind_block(g.sps, p, fd.w)
                }
                m = m + 1
            }
        }
        r = r + 1
    }
}

// The `spawn_runtime` section: per spawn site, the arg-pack struct (runtime params, plus a
// `ret` field for a result-bearing target) and the `void*` trampoline that unpacks it and
// calls the target. Trailing blank iff any site exists.
fn emit_spawn_runtime(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.sps) {
        let call: i32 = list.get(i32, g.sps, k)
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, call as usize)
        let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
        let fit: i32 = find_fn_item(p, src, src[callee.start .. callee.end])
        if fit >= 0 {
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
            let rid: i32 = ref_expr_id(p, call)
            // `ret` field only for a non-void target (rendered C type != void)
            var rets: String = string_new()
            if fd.z >= 0 { emit_c_ty(rets, p, src, fd.z) }
            else { string_push(rets, "void") }
            let has_ret: bool = !str_eq(string_view(rets), "void")
            string_push(sb, "struct _jsp_")
            push_uint(sb, rid as i64)
            string_push(sb, " { ")
            var np: i32 = 0                            // runtime (non-comptime, non-self) params
            var i: i32 = 0
            for i < fd.b {
                let base: i32 = fd.a + i * 7
                if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
                    let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
                    if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
                    string_push(sb, " a")
                    push_uint(sb, np as i64)
                    string_push(sb, "; ")
                    np = np + 1
                }
                i = i + 1
            }
            if np == 0 and !has_ret { string_push(sb, "char _unused; ") }
            if has_ret {
                string_push(sb, string_view(rets))
                string_push(sb, " ret; ")
            }
            string_push(sb, "};\n")
            string_push(sb, "static void* jestyr_task_")
            push_uint(sb, rid as i64)
            string_push(sb, "(void* _vp) { struct _jsp_")
            push_uint(sb, rid as i64)
            string_push(sb, "* _a = (struct _jsp_")
            push_uint(sb, rid as i64)
            string_push(sb, "*)_vp; ")
            if has_ret { string_push(sb, "_a->ret = ") }
            string_push(sb, "jestyr_")
            string_push(sb, src[callee.start .. callee.end])
            string_push(sb, "(")
            var ai: i32 = 0
            for ai < np {
                if ai > 0 { string_push(sb, ", ") }
                string_push(sb, "_a->a")
                push_uint(sb, ai as i64)
                ai = ai + 1
            }
            string_push(sb, "); return NULL; }\n")
            string_free(rets)
        }
        k = k + 1
    }
    if list.len(i32, g.sps) > 0 { string_push(sb, "\n") }
}

// Does this subtree contain a spawn anywhere (used for the dynamic-N test)?
fn expr_has_spawn(read p: parser.Parser, eid: i32) -> bool {
    if eid < 0 { return false }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 39 { return true }
    if e.kind == 38 or e.kind == 25 { return block_has_spawn(p, e.a) }
    if e.kind == 23 { return block_has_spawn(p, eid) }
    if e.kind == 24 {
        if expr_has_spawn(p, e.a) { return true }
        if block_has_spawn(p, e.b) { return true }
        if e.op >= 0 { return expr_has_spawn(p, e.op) }
        return false
    }
    if e.kind == 28 {
        if expr_has_spawn(p, e.a) { return true }
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { if expr_has_spawn(p, guard) { return true } }
            if expr_has_spawn(p, list.get(i32, p.par, (ab + 2) as usize)) { return true }
            k = k + 1
        }
        return false
    }
    if e.kind == 31 {
        if block_has_spawn(p, e.b) { return true }
        if e.x >= 0 { return block_has_spawn(p, e.x) }
        return false
    }
    return false
}

fn block_has_spawn(read p: parser.Parser, beid: i32) -> bool {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { if expr_has_spawn(p, s.a) { return true } }
        i = i + 1
    }
    return false
}

// A spawn NOT at the concurrent block's top level (nested in a loop/if) — the dynamic-N
// test. A top-level bare/let spawn is a fixed numbered handle. Mirrors `stmt_has_nested_spawn`.
fn stmt_has_nested_spawn(read p: parser.Parser, sid: i32) -> bool {
    let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
    if s.kind != 0 and s.kind != 2 { return false }
    if s.a < 0 { return false }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
    if e.kind == 39 { return false }
    return expr_has_spawn(p, s.a)
}

// The fixed-handle thread-creation triple for one top-level spawn (handle index `h`):
// `pthread_t _jt<h>;` + the arg box + `pthread_create`. Args buffer FIRST (temp order).
fn emit_spawn_create(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, call: i32, h: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, call as usize)
    let rid: i32 = ref_expr_id(p, call)
    var vals: String = string_new()
    var ai: i32 = 0
    for ai < e.y {
        if ai > 0 { string_push(vals, ", ") }
        emit_expr(vals, p, src, c, g, arg_at(p, e, ai))
        ai = ai + 1
    }
    indent(sb, depth)
    string_push(sb, "pthread_t _jt")
    push_uint(sb, h as i64)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "struct _jsp_")
    push_uint(sb, rid as i64)
    string_push(sb, " _ja")
    push_uint(sb, h as i64)
    string_push(sb, " = ")
    if e.y == 0 { string_push(sb, "{0}") }
    else {
        string_push(sb, "{ ")
        string_push(sb, string_view(vals))
        string_push(sb, " }")
    }
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "pthread_create(&_jt")
    push_uint(sb, h as i64)
    string_push(sb, ", NULL, jestyr_task_")
    push_uint(sb, rid as i64)
    string_push(sb, ", &_ja")
    push_uint(sb, h as i64)
    string_push(sb, ");\n")
    string_free(vals)
}

// One dynamic-N spawn pushed onto the growable handle array `_dt`/`_da` (declared by
// `emit_concurrent`): grow-on-full, a heap arg box (stable address — the arrays may
// realloc-move, the boxes don't), create, count. Mirrors `emit_dyn_spawn`.
fn emit_dyn_spawn(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, inner: i32, depth: i32) {
    let call: i32 = spawn_call_of(p, inner)
    if call < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, call as usize)
    let rid: i32 = ref_expr_id(p, call)
    var vals: String = string_new()
    var ai: i32 = 0
    for ai < e.y {
        if ai > 0 { string_push(vals, ", ") }
        emit_expr(vals, p, src, c, g, arg_at(p, e, ai))
        ai = ai + 1
    }
    line_at(sb, depth, "if (_dn == _dc) { _dc = _dc ? _dc * 2 : 8; _dt = (pthread_t*)realloc(_dt, _dc * sizeof(pthread_t)); _da = (void**)realloc(_da, _dc * sizeof(void*)); }")
    indent(sb, depth)
    string_push(sb, "struct _jsp_")
    push_uint(sb, rid as i64)
    string_push(sb, "* _dap = (struct _jsp_")
    push_uint(sb, rid as i64)
    string_push(sb, "*)malloc(sizeof(struct _jsp_")
    push_uint(sb, rid as i64)
    string_push(sb, ")); *_dap = (struct _jsp_")
    push_uint(sb, rid as i64)
    string_push(sb, ")")
    if e.y == 0 { string_push(sb, "{0}") }
    else {
        string_push(sb, "{ ")
        string_push(sb, string_view(vals))
        string_push(sb, " }")
    }
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "_da[_dn] = _dap; pthread_create(&_dt[_dn], NULL, jestyr_task_")
    push_uint(sb, rid as i64)
    string_push(sb, ", _dap); _dn++;\n")
    string_free(vals)
}

// Does the spawn's target fn return a value (so its task box carries a `ret` field)?
// Mirrors `task_ret_cty(...).is_some()`: the RENDERED ret type is compared to "void".
fn spawn_target_has_ret(read p: parser.Parser, read src: str, call: i32) -> bool {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, call as usize)
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    let fit: i32 = find_fn_item(p, src, src[callee.start .. callee.end])
    if fit < 0 { return false }
    let fd: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    if fd.z < 0 { return false }
    var rets: String = string_new()
    emit_c_ty(rets, p, src, fd.z)
    let r: bool = !str_eq(string_view(rets), "void")
    string_free(rets)
    return r
}

// `select { recv(ch) => x { body } … }`: hoist each channel once, then spin; the first arm
// whose channel has a buffered item receives and runs (an else-if chain so exactly one arm
// fires per pass). Arms are 4-tuples in `par`: (chan, bind ns, bind ne, body Block). Mirrors
// `emit_select` (the non-generic `channel_len_i64`/`channel_recv_i64` std/sync wrappers).
fn emit_select(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, depth: i32) {
    line_at(sb, depth, "{")
    var i: i32 = 0
    for i < e.y {                                     // hoist each channel to a local
        let ab: i32 = e.x + i * 4
        let ch: i32 = list.get(i32, p.par, ab as usize)
        indent(sb, depth + 1)
        emit_ty_c(sb, p, src, c, list.get(i32, c.et, ch as usize))
        string_push(sb, " _sel")
        push_uint(sb, i as i64)
        string_push(sb, " = ")
        emit_expr(sb, p, src, c, g, ch)
        string_push(sb, ";\n")
        i = i + 1
    }
    line_at(sb, depth + 1, "int _seldone = 0;")
    line_at(sb, depth + 1, "while (!_seldone) {")
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 4
        indent(sb, depth + 2)
        if k == 0 { string_push(sb, "if (jestyr_channel_len_i64(_sel") }
        else { string_push(sb, "else if (jestyr_channel_len_i64(_sel") }
        push_uint(sb, k as i64)
        string_push(sb, ") > 0) {\n")
        indent(sb, depth + 3)
        string_push(sb, "int64_t j_")
        let bns: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let bne: i32 = list.get(i32, p.par, (ab + 2) as usize)
        string_push(sb, src[bns as usize .. bne as usize])
        string_push(sb, " = jestyr_channel_recv_i64(_sel")
        push_uint(sb, k as i64)
        string_push(sb, ");\n")
        let blk: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.par, (ab + 3) as usize) as usize)
        var s: i32 = 0
        for s < blk.y {
            emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + s) as usize), depth + 3)
            s = s + 1
        }
        line_at(sb, depth + 3, "_seldone = 1;")
        line_at(sb, depth + 2, "}")
        k = k + 1
    }
    // THE EXIT. Without it the loop spins forever once every channel is closed and
    // drained: readiness is `len > 0`, false for good at that point, so a `select` could
    // be entered and never left. Checked LAST, after every readiness arm, which is what
    // keeps closing non-destructive -- a channel that is closed but still holds buffered
    // values is served by its own arm above and only counts as finished once drained.
    // Testing it first would discard exactly the work a graceful shutdown is finishing.
    if e.y > 0 {
        indent(sb, depth + 2)
        string_push(sb, "else if (")
        var q: i32 = 0
        for q < e.y {
            if q > 0 { string_push(sb, " && ") }
            string_push(sb, "(jestyr_channel_is_closed_i64(_sel")
            push_uint(sb, q as i64)
            string_push(sb, ") && jestyr_channel_len_i64(_sel")
            push_uint(sb, q as i64)
            string_push(sb, ") == 0)")
            q = q + 1
        }
        string_push(sb, ") {\n")
        line_at(sb, depth + 3, "_seldone = 1;")
        line_at(sb, depth + 2, "}")
    }
    line_at(sb, depth + 1, "}")
    line_at(sb, depth, "}")
}

// A `concurrent { … }` nursery: fixed top-level spawns get numbered handles joined at the
// brace; `let h = spawn …` binds an awaitable handle with a `_jd` joined-flag (so an `await`
// and the brace's safety-net join don't double-join); a spawn nested in a loop/if is
// dynamic-N via the growable array. The handle map is scoped per block (the reference
// `mem::take`s it — an inner nursery does NOT see the outer's handles; `g.thf` is that
// floor). No drop scope — mirrors `emit_concurrent`'s plain braces.
fn emit_concurrent(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    let saved_dyn: bool = g.dspawn
    let saved_floor: i32 = g.thf
    let saved_len: usize = list.len(i32, g.th)
    g.thf = saved_len as i32
    line_at(sb, depth, "{")
    var needs_dyn: bool = false
    var si: i32 = 0
    for si < blk.y {
        if stmt_has_nested_spawn(p, list.get(i32, p.sar, (blk.x + si) as usize)) { needs_dyn = true }
        si = si + 1
    }
    if needs_dyn {
        line_at(sb, depth + 1, "pthread_t* _dt = NULL; void** _da = NULL; size_t _dn = 0, _dc = 0;")
    }
    g.dspawn = needs_dyn
    var handles: i32 = 0
    var i: i32 = 0
    for i < blk.y {
        let sid: i32 = list.get(i32, p.sar, (blk.x + i) as usize)
        let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        var handled: bool = false
        if s.kind == 0 and s.a >= 0 {                 // `let h = spawn f(args)` -> awaitable handle
            let se: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
            if se.kind == 39 {
                let call: i32 = spawn_call_of(p, se.a)
                if call >= 0 {
                    emit_spawn_create(sb, p, src, c, g, call, handles, depth + 1)
                    indent(sb, depth + 1)
                    string_push(sb, "int _jd")
                    push_uint(sb, handles as i64)
                    string_push(sb, " = 0;\n")
                    list.push(i32, g.th, s.x)         // handle-name span -> (idx, has_ret)
                    list.push(i32, g.th, s.y)
                    list.push(i32, g.th, handles)
                    if spawn_target_has_ret(p, src, call) { list.push(i32, g.th, 1) }
                    else { list.push(i32, g.th, 0) }
                    handles = handles + 1
                }
                handled = true                        // (a non-call spawn is the diag case)
            }
        }
        if !handled {
            if s.kind == 2 and s.a >= 0 {             // bare `spawn f(args)` -> fire-and-forget
                let se: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
                if se.kind == 39 {
                    let call: i32 = spawn_call_of(p, se.a)
                    if call >= 0 {
                        emit_spawn_create(sb, p, src, c, g, call, handles, depth + 1)
                        handles = handles + 1
                        handled = true
                    }
                }
            }
        }
        if !handled { emit_stmt(sb, p, src, c, g, sid, depth + 1) }
        i = i + 1
    }
    var h: i32 = 0
    for h < handles {                                 // structured join at the brace
        // a let-bound handle guards its join with the `_jd` flag (an await may have joined)
        var guarded: bool = false
        var tj: usize = saved_len
        for tj < list.len(i32, g.th) {
            if list.get(i32, g.th, tj + 2) == h { guarded = true }
            tj = tj + 4
        }
        indent(sb, depth + 1)
        if guarded {
            string_push(sb, "if (!_jd")
            push_uint(sb, h as i64)
            string_push(sb, ") pthread_join(_jt")
        } else {
            string_push(sb, "pthread_join(_jt")
        }
        push_uint(sb, h as i64)
        string_push(sb, ", NULL);\n")
        h = h + 1
    }
    if needs_dyn {
        line_at(sb, depth + 1, "for (size_t _dk = 0; _dk < _dn; _dk++) { pthread_join(_dt[_dk], NULL); free(_da[_dk]); }")
        line_at(sb, depth + 1, "free(_dt); free(_da);")
    }
    line_at(sb, depth, "}")
    list.truncate(i32, g.th, saved_len)
    g.thf = saved_floor
    g.dspawn = saved_dyn
}

// The `closure_fns` section: one top-level `static` function per collected closure (a thin
// coerced closure only when capture-free — a capturing one is the reference's diag case and
// emits nothing).
fn emit_closure_fns(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        let cid: i32 = list.get(i32, g.cls, k)
        if closure_is_thin(c, cid) {
            if list.get(i32, g.ccx, k * 2 + 1) == 0 { emit_thin_closure_c(sb, p, src, c, g, cid) }
        } else {
            emit_fat_closure_c(sb, p, src, c, g, k, cid)
        }
        k = k + 1
    }
}

fn emit_fn_protos(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) and !test_only_item(p, src, it, g.tmode) {  // Fn (templates never emitted directly; @test only in test mode)
            let fg: bool = cfg_open_for(sb, p, src, it.x, it.y, cfg_word(p, src, it.u, it.v))
            emit_fn_sig(sb, p, src, it)
            string_push(sb, ";\n")
            cfg_close(sb, fg)
        }
        r = r + 1
    }
    var gi: i32 = 0
    for (gi as usize) < list.len(i32, g.gfi) {
        // An instance inherits its TEMPLATE's `@cfg`, like every other property of the
        // signature it is substituted from.
        let tid: i32 = list.get(i32, g.gfi, gi as usize)
        let tit: parser.ItemData = list.get(parser.ItemData, p.it, tid as usize)
        let ig: bool = cfg_open_for(sb, p, src, tit.x, tit.y, cfg_word(p, src, tit.u, tit.v))
        emit_gfn_sig(sb, p, src, c, g, gi)
        string_push(sb, ";\n")
        cfg_close(sb, ig)
        list.truncate(i32, g.su, 0)
        gi = gi + 2 + list.get(i32, g.gfi, (gi + 1) as usize) * 3
    }
    string_push(sb, "\n")
}

// Function definitions: `<sig>\n<body>\n` each. (Mirrors Cgen::fn_defs -> emit_fn.)
fn emit_fn_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) and !test_only_item(p, src, it, g.tmode) {  // Fn (templates never emitted directly; @test only in test mode)
            let fg: bool = cfg_open_for(sb, p, src, it.x, it.y, cfg_word(p, src, it.u, it.v))
            emit_fn_sig(sb, p, src, it)
            string_push(sb, "\n")
            // Register the fn's by-pointer (`mut`/`out`) params so body uses render `(*j_x)`.
            list.truncate(i32, g.pp, 0)
            var pi: i32 = 0
            for pi < it.b {
                let pbase: i32 = it.a + pi * 7
                let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
                if pconv == 2 or pconv == 4 {
                    list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                    list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
                }
                pi = pi + 1
            }
            // A refined param (`i: usize in 0..s.len`) seeds the refinement stack for the whole
            // body, so `s[i]` elides its bounds check (mirrors `cur_refines` seeding in emit_fn).
            let rfloor: usize = list.len(i32, g.rf)
            var ri: i32 = 0
            for ri < it.b {
                let rbase: i32 = it.a + ri * 7
                let refine: i32 = list.get(i32, p.iar, (rbase + 6) as usize)
                if refine >= 0 {
                    list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 2) as usize))
                    list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 3) as usize))
                    list.push(i32, g.rf, refine)
                }
                ri = ri + 1
            }
            // `requires`/`ensures` contract exprs from the `far` extras block:
            // [err_count, err span pairs…, req_count, req ExprIds…, ens_count, ens ExprIds…].
            list.truncate(i32, g.req, 0)
            list.truncate(i32, g.ens, 0)
            if it.e >= 0 {
                let ecount: i32 = list.get(i32, p.far, it.e as usize)
                let rq: i32 = it.e + 1 + ecount * 3               // req_count slot (err TRIPLES)
                let rqc: i32 = list.get(i32, p.far, rq as usize)
                var qi: i32 = 0
                for qi < rqc { list.push(i32, g.req, list.get(i32, p.far, (rq + 1 + qi) as usize))  qi = qi + 1 }
                let enp: i32 = rq + 1 + rqc                        // ens_count slot
                let enc: i32 = list.get(i32, p.far, enp as usize)
                var ei: i32 = 0
                for ei < enc { list.push(i32, g.ens, list.get(i32, p.far, (enp + 1 + ei) as usize))  ei = ei + 1 }
            }
            g.retty = it.z
            // A fallible fn's result-ok TypeId is live for its body (ok/err/? read it); -2 = not
            // fallible. It always "returns a value" (the result struct), even for a unit ok type.
            let fallible: bool = fn_is_fallible(p, it)
            if fallible { g.res_ok = it.z } else { g.res_ok = 0 - 2 }
            g.curfn = iid
            // The fn's move analysis: locals whose value escapes are never drop-registered.
            list.truncate(i32, g.mv, 0)
            collect_moved_block(g, p, src, it.w)
            // Droppable `take` params join the body's root drop scope (the callee owns them).
            fill_take_drops(g, p, src, it)
            let returns_value: bool = it.z >= 0 or fallible
            // Map the emitted body back to its `.jtr` declaration line; reset the
            // dedup so this entry directive always fires for a new function.
            g.dbgl_m = 0 - 1
            g.dbgl_l = 0 - 1
            cg_mark_line(sb, g, it.x as usize)
            emit_body(sb, p, src, c, g, it.w, returns_value, 0)   // w = body Block ExprId; fn body at depth 0
            g.res_ok = 0 - 2
            list.truncate(i32, g.pp, 0)
            list.truncate(i32, g.rf, rfloor)
            list.truncate(i32, g.ens, 0)
            list.truncate(i32, g.mv, 0)
            string_push(sb, "\n")
            cfg_close(sb, fg)
        }
        r = r + 1
    }
    // Monomorphized generic-fn instance definitions, after the regular fns (mirrors the
    // instance loop at the end of `fn_defs`): sig under the instance substitution + body.
    var gi: i32 = 0
    for (gi as usize) < list.len(i32, g.gfi) {
        let fit: i32 = list.get(i32, g.gfi, gi as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
        let dg: bool = cfg_open_for(sb, p, src, fd.x, fd.y, cfg_word(p, src, fd.u, fd.v))
        emit_gfn_sig(sb, p, src, c, g, gi)            // arms g.su for the body too
        string_push(sb, "\n")
        list.truncate(i32, g.pp, 0)
        var pi: i32 = 0
        for pi < fd.b {
            let pbase: i32 = fd.a + pi * 7
            let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
            if list.get(i32, p.iar, pbase as usize) == 0 and (pconv == 2 or pconv == 4) {
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
            }
            pi = pi + 1
        }
        let rfloor: usize = list.len(i32, g.rf)
        var ri: i32 = 0
        for ri < fd.b {
            let rbase: i32 = fd.a + ri * 7
            let refine: i32 = list.get(i32, p.iar, (rbase + 6) as usize)
            if refine >= 0 {
                list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 2) as usize))
                list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 3) as usize))
                list.push(i32, g.rf, refine)
            }
            ri = ri + 1
        }
        list.truncate(i32, g.req, 0)
        list.truncate(i32, g.ens, 0)
        if fd.e >= 0 {
            let ecount: i32 = list.get(i32, p.far, fd.e as usize)
            let rq: i32 = fd.e + 1 + ecount * 3
            let rqc: i32 = list.get(i32, p.far, rq as usize)
            var qi: i32 = 0
            for qi < rqc { list.push(i32, g.req, list.get(i32, p.far, (rq + 1 + qi) as usize))  qi = qi + 1 }
            let enp: i32 = rq + 1 + rqc
            let enc: i32 = list.get(i32, p.far, enp as usize)
            var ei: i32 = 0
            for ei < enc { list.push(i32, g.ens, list.get(i32, p.far, (enp + 1 + ei) as usize))  ei = ei + 1 }
        }
        g.retty = fd.z
        let gfallible: bool = fn_is_fallible(p, fd)
        if gfallible { g.res_ok = fd.z } else { g.res_ok = 0 - 2 }
        g.curfn = fit
        list.truncate(i32, g.mv, 0)
        collect_moved_block(g, p, src, fd.w)          // instances collect moved (mirrors emit_fn)
        // A monomorphized instance maps back to its TEMPLATE's declaration line,
        // like the reference (which routes every fn -- plain or instance --
        // through one emitter with the same entry mark + dedup reset).
        g.dbgl_m = 0 - 1
        g.dbgl_l = 0 - 1
        cg_mark_line(sb, g, fd.x as usize)
        emit_body(sb, p, src, c, g, fd.w, fd.z >= 0 or gfallible, 0)
        g.res_ok = 0 - 2
        list.truncate(i32, g.pp, 0)
        list.truncate(i32, g.rf, rfloor)
        list.truncate(i32, g.ens, 0)
        list.truncate(i32, g.mv, 0)
        list.truncate(i32, g.su, 0)
        string_push(sb, "\n")
        cfg_close(sb, dg)
        gi = gi + 2 + list.get(i32, g.gfi, (gi + 1) as usize) * 3
    }
}

// The C `main` wrapper: captures argc/argv into the argv globals, then calls `jestyr_main`.
// Does the Fn item's name pass the optional `jestyrc test <substr>` name filter?
// (Empty filter = no filter = everything, mirroring the reference's `Option<&str>`.)
fn test_name_passes(read src: str, read it: parser.ItemData, read tf: str) -> bool {
    if tf.len == 0 { return true }
    return contains(src[it.x .. it.y], tf)
}

// A runnable harness entry: a top-level Fn with the wanted attr, non-generic and
// backend-supported (a roots-level fn has no `self`, so `!fn_is_template` covers both halves
// of the reference's `runnable` predicate), passing the name filter.
fn test_runnable(read p: parser.Parser, read src: str, read it: parser.ItemData, read want: str, read tf: str) -> bool {
    if it.kind != 3 { return false }
    if !item_has_attr(p, src, it, want) { return false }
    if fn_is_template(p, it) { return false }
    return test_name_passes(src, it, tf)
}

// The Fn's C call name: `@no_mangle` publishes the BARE name, else `jestyr_<name>`.
fn push_test_call(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if !item_has_attr(p, src, it, "no_mangle") { string_push(sb, "jestyr_") }
    string_push(sb, src[it.x .. it.y])
}

// The `jestyrc test` harness main (mirrors `test_main`): run each runnable `@test` (a no-arg
// fn returning `bool`, `true` = pass) tallying pass/fail, then time each `@bench` with
// `clock()`; exit non-zero iff any test failed. User `main` is IGNORED in test mode. `tf` is
// the optional name filter, applied at CODEGEN (not runtime) so the baked `running N test(s)`
// count equals the emitted-runner count — an empty filter is byte-for-byte the unfiltered
// harness.
fn emit_test_main(mut sb: String, read p: parser.Parser, read src: str, read tf: str) {
    var n: i32 = 0
    var r0: i32 = 0
    for r0 < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r0 as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if test_runnable(p, src, it, "test", tf) { n = n + 1 }
        r0 = r0 + 1
    }
    string_push(sb, "int main(void) {\n")
    string_push(sb, "    int _passed = 0, _failed = 0;\n    printf(\"running ")
    push_uint(sb, n as i64)
    string_push(sb, " test(s)\\n\");\n")
    var r: i32 = 0
    for r < list.len(i32, p.roots) {                  // every `@test`, source order
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if test_runnable(p, src, it, "test", tf) {
            string_push(sb, "    printf(\"test ")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " ... \"); fflush(stdout);\n")
            string_push(sb, "    if (")
            push_test_call(sb, p, src, it)
            string_push(sb, "()) { printf(\"ok\\n\"); _passed++; } else { printf(\"FAILED\\n\"); _failed++; }\n")
        }
        r = r + 1
    }
    var r2: i32 = 0
    for r2 < list.len(i32, p.roots) {                 // then every `@bench`, source order
        let iid: i32 = list.get(i32, p.roots, r2 as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if test_runnable(p, src, it, "bench", tf) {
            string_push(sb, "    { clock_t _s = clock(); ")
            push_test_call(sb, p, src, it)
            string_push(sb, "(); clock_t _e = clock(); printf(\"bench ")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " ... %.3f ms\\n\", (double)(_e - _s) * 1000.0 / CLOCKS_PER_SEC); }\n")
        }
        r2 = r2 + 1
    }
    string_push(sb, "    printf(\"\\nresult: %d passed; %d failed\\n\", _passed, _failed);\n    return _failed == 0 ? 0 : 1;\n}\n")
}

// `jestyrc test --list` (mirrors `list_tests` + the CLI's filter): one `test <name>` /
// `bench <name>` line per runnable item, SOURCE order interleaved (a single pass — unlike the
// harness's tests-then-benches split), narrowed by the filter. Built into a String the caller
// prints; the reference's empty-list stderr note is not ported (the golden compares stdout).
fn emit_test_list(mut sb: String, read p: parser.Parser, read src: str, read tf: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if test_runnable(p, src, it, "test", tf) {
            string_push(sb, "test ")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, "\n")
        } else if test_runnable(p, src, it, "bench", tf) {
            string_push(sb, "bench ")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, "\n")
        }
        r = r + 1
    }
}

fn emit_main_wrapper(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], "main") {
                if it.z >= 0 {
                    string_push(sb, "int main(int argc, char** argv) { jestyr_rt_argc = argc; jestyr_rt_argv = argv; return (int) jestyr_main(); }\n")
                } else {
                    string_push(sb, "int main(int argc, char** argv) { jestyr_rt_argc = argc; jestyr_rt_argv = argv; jestyr_main(); return 0; }\n")
                }
                return
            }
        }
        r = r + 1
    }
}

// Lower the whole program to C. The section ORDER mirrors `emit_program` exactly — the five bare
// `"\n"` pushes stand in for the reference's unconditionally-blank sections that are empty for a
// program with no aggregates (closure_types, method_protos, consts) plus the guarded no-ops.
fn emit_program(mut sb: String, read p: parser.Parser, read c: typeck.Checker, read src: str, read a: Allocator, tmode: bool, read tf: str, dmap: List(i32), dmods: List(i32), read dnb: str, read dall: str) {
    // The debug-info table for `#line` (empty on every path but `jc build|run`).
    // The newline index over the original concatenation makes each line lookup a
    // binary search rather than a scan from byte 0.
    var dnbb: String = string_new()
    string_push(dnbb, dnb)
    var dallb: String = string_new()
    string_push(dallb, dall)
    var dnl0: List(i32) = list.make(i32, a)
    var dnli: usize = 0
    for dnli < dall.len {
        if (dall[dnli] as i32) == 10 { list.push(i32, dnl0, dnli as i32) }
        dnli = dnli + 1
    }
    // Own copies of the table lists: a parameter is a second-class borrow and may
    // not be stored in `Cg` (the escape checker enforces exactly that).
    var dmap2: List(i32) = list.make(i32, a)
    var dci: usize = 0
    for dci < list.len(i32, dmap) { list.push(i32, dmap2, list.get(i32, dmap, dci))  dci = dci + 1 }
    var dmods2: List(i32) = list.make(i32, a)
    var dcj: usize = 0
    for dcj < list.len(i32, dmods) { list.push(i32, dmods2, list.get(i32, dmods, dcj))  dcj = dcj + 1 }
    var g: Cg = Cg{ sds: list.make(i32, a), pfs: list.make(i32, a), pfb: string_new(), pfo: list.make(i32, a), tmp: 0, pp: list.make(i32, a), rf: list.make(i32, a), res_ok: 0 - 2, etags: list.make(i32, a), req: list.make(i32, a), ens: list.make(i32, a), retty: 0 - 1, mi: list.make(i32, a), self_ptr: false, gei: list.make(i32, a), curfn: 0 - 1, mv: list.make(i32, a), tkd: list.make(i32, a), ds: list.make(i32, a), dsb: list.make(i32, a), autoret: false, bl_ns: 0 - 1, bl_ne: 0 - 1, bl_fe: 0 - 1, sw: false, ll_ns: 0 - 1, ll_ne: 0 - 1, swb: 0 - 1, cl_ns: 0 - 1, cl_ne: 0 - 1, sr_ns: 0 - 1, sr_ne: 0 - 1, vt: list.make(i32, a), vtf: 0, gfi: list.make(i32, a), su: list.make(i32, a), cls: list.make(i32, a), ccx: list.make(i32, a), cca: list.make(i32, a), caps: list.make(i32, a), gsi: list.make(i32, a), sps: list.make(i32, a), dspawn: false, th: list.make(i32, a), thf: 0, dg: 0 - 1, gmi: list.make(i32, a), tmode: tmode, alloc: a, dmap: dmap2, dmods: dmods2, dnb: dnbb, dall: dallb, dnl: dnl0, dbg_on: list.len(i32, dmap) > 0, dbgl_m: 0 - 1, dbgl_l: 0 - 1 }
    collect_spawns(g, p, src)                        // spawn sites (gates the pthread prelude)
    build_error_tags(g, p, src)                      // whole-program error-name -> tag map
    // Plain-struct methods now flow through the SAME worklist as generic instances
    // (`gmethod_check`'s argc-0 records), because the reference's `method_instances`
    // is one LIFO list for both -- `collect_method_instances`' flat first-seen scan
    // was a latent order divergence (see `gmethod_check`). `g.mi` stays empty; its
    // emission loops are dead and kept only to avoid churning this file's structure.
    collect_gfn_instances(g, p, src, c, a)           // generic-fn instances, LIFO worklist order
    collect_gstruct_instances(g, p, src, c)          // generic-STRUCT instances (reads gfi — after!)
    collect_genum_instances(g, p, src, c)            // generic-enum instance TyIds, expr order
    collect_closures(g, p, src, a)                   // closures + captures, discovery order (LAST, like the reference)
    sd_collect(g, p, src)                            // @simd sites to vectorize (Q-S2)
    pf_collect(g, p, src, c)                         // par-for bodies that can fuse (after sd_collect)
    emit_prelude(sb, p, src, g)
    emit_forward_types(sb, p, src)
    emit_gen_forward_types(sb, p, src, c, g)         // monomorphized generic-enum instance fwd typedefs
    // The definition window emits into a CAPTURE buffer; `dc_flush` re-emits its segments
    // topologically so a by-value embedding (a struct holding a `List(E)` field) is defined
    // after its dependency — a stable no-op when no forward dep exists (byte-identical).
    // The fn-pointer typedefs are INSIDE the capture, first, keeping their old output
    // position: a struct may hold a fn-pointer field by name (the vtable shape), while a
    // fn typedef may name a slice/array/genref typedef in a parameter (the split_mut
    // shape) — dependencies in both directions across the old fixed order, which only
    // the dep graph can serve. Mirrors the same move in the reference's `emit`.
    var cap: String = string_new()
    var d: Dc = Dc{ nb: string_new(), segs: list.make(i32, a), last: 0, pns: 0, pne: 0, pds: 0, pde: 0, pstart: 0 - 1 }
    emit_distinct_defs(cap, p, src, d)               // FIRST: `distinct` over a slice/array/fn type
    emit_fn_type_defs(cap, p, src, c, g, d)          // fn-pointer typedefs (captured units)
    emit_struct_defs(cap, p, src, d)                 // captured-region aggregate defs (struct first)
    emit_enum_defs(cap, p, src, c, g, d)             // enum tag+struct defs (after structs)
    emit_gen_struct_defs(cap, p, src, c, g, d)       // generic-STRUCT instance defs (before gen enums)
    emit_gen_enum_defs(cap, p, src, c, g, d)         // generic-enum instance defs (after plain enums)
    emit_slice_defs(cap, p, src, c, d)               // slice typedefs (after aggregates)
    sd_vector_defs(cap, p, src, c, g, a)             // @simd vector typedefs (Q-S2)
    emit_array_defs(cap, p, src, c, g, d)            // array typedefs (after slices)
    emit_genref_defs(cap, p, src, c, d)              // genref typedefs (after arrays)
    emit_result_defs(cap, p, src, c, g, d)
    dc_flush(sb, d, string_view(cap), a)             // the topological re-emit (`flush_def_capture`)
    string_free(cap)
    string_free(d.nb)
    emit_dyn_typedefs(sb, p, src, a)                 // dyn-trait vtable + fat-pointer typedefs
    emit_extern_protos(sb, p, src)                   // `extern "c"` prototypes (bare names)
    emit_closure_types(sb, p, src, c, g)             // env + {call, env} typedefs + unconditional blank
    emit_fn_protos(sb, p, src, c, g)
    emit_method_protos(sb, p, src, c, g)             // method protos + unconditional trailing blank
    emit_impl_protos(sb, p, src, c, g)                   // trait-impl protos + CONDITIONAL trailing blank
    emit_dyn_vtables(sb, p, src)                     // vtable shims + static instances
    emit_spawn_runtime(sb, p, src, c, g)             // spawn arg-pack structs + trampolines
    emit_consts(sb, p, src, c, g)                    // consts + its unconditional trailing blank
    emit_closure_fns(sb, p, src, c, g)               // lifted `jestyr_lam_<id>` fns before the free fns
    pf_workers(sb, p, src, c, g)                     // fused par-for workers, before the fns that name them
    emit_fn_defs(sb, p, src, c, g)
    emit_method_defs(sb, p, src, c, g)               // method bodies after the free fns
    emit_impl_defs(sb, p, src, c, g)                 // trait-impl bodies last
    if g.tmode {                                     // the `jestyrc test` harness main replaces
        emit_test_main(sb, p, src, tf)               // the user-main wrapper in test mode
    } else {
        emit_main_wrapper(sb, p, src)
    }
}

// ---- in-language modules: the driver's flatten loader ----
// The reference loader already compiles a multi-file program as ONE translation unit (one
// shared arena, one concatenated buffer; escape + cgen never learn there was more than one
// file), so the driver implements modules the same way the R2 harness proved sound: load the
// import closure depth-first (deps before importers — the loader's merge order), then flatten
// token-level into a single source: `import` decls dropped, `binding.x` -> `x`, and any
// top-level name defined in more than one module renamed `name__<module>`. The merged source
// then flows through the ordinary single-file pipeline. v1 limits: diagnostics render against
// the MERGED buffer (per-file `#line`-style attribution is a follow-up), `extern "c"` block
// collisions are not detected (none exist in std), and a module-local variable that shadows an
// import binding AND is field-accessed would mis-rewrite (none exists; the std `fs` locals are
// scalar ints).

// Loader state. Sources concatenate into `allsrc` (module slices recorded in `mods` 6-tuples:
// stem_s, stem_e, path_s, path_e into `nb`; src_s, src_e into `allsrc`); `vis` marks resolved
// paths (memoization + cycle guard); `seen` records first declarations as `|name=stem|`;
// `ren` records collisions as `|stem:name|` (the renamed form is always `name__stem`).
struct Ml { allsrc: String, nb: String, mods: List(i32), vis: String, seen: String, ren: String, rids: String, nmod: i32, map: List(i32), err: bool }

// The directory prefix length of `path` (through the last '/' or '\\'), 0 for a bare name.
fn path_dir_len(read path: str) -> usize {
    var i: usize = path.len
    for i > 0 {
        let ch: i32 = path[i - 1] as i32
        if ch == 47 or ch == 92 { return i }
        i = i - 1
    }
    return 0
}

// The stem of a resolved path: the last segment, minus a trailing `.jtr`.
fn ml_push_stem(mut sb: String, read path: str) {
    let dl: usize = path_dir_len(path)
    var e: usize = path.len
    if ends_with(path, ".jtr") { e = e - 4 }
    string_push(sb, path[dl .. e])
}

// Has `path` been visited (loaded or in progress)?
fn ml_seen(mut m: Ml, read path: str) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, path)
    string_push(probe, "|")
    let hit: bool = contains(string_view(m.vis), string_view(probe))
    string_free(probe)
    return hit
}

// Load `path` and (depth-first) its imports, appending each module's raw source to `allsrc`
// AFTER its dependencies — the reference loader's merge order.
fn ml_load(mut m: Ml, read path: str, mut it: Interner, kwcount: i64, read a: Allocator) {
    if ml_seen(m, path) { return }                    // diamond import (or a cycle: merged once)
    string_push(m.vis, "|")
    string_push(m.vis, path)
    string_push(m.vis, "|")
    // The reference assigns a module's id at FIRST VISIT, before recursing into
    // its imports (`new_module` precedes `add_file_to_module`), while this
    // loader MERGES deps-first. So the pre-order visit index -- not the merge
    // index -- is the reference ModId, and collision renames must use it
    // (`name__m<id>`, mirroring `canon`) for the module-path C to be
    // byte-identical. Recorded as `|stem=<id>|`; stems are unique across a
    // closure (the same assumption `seen`/`ren` already make).
    string_push(m.rids, "|")
    ml_push_stem(m.rids, path)
    string_push(m.rids, "=")
    push_uint(m.rids, m.nmod as i64)
    string_push(m.rids, "|")
    m.nmod = m.nmod + 1
    var srcb: String = fs.read_text(path)
    let src: str = string_view(srcb)
    if src.len == 0 {
        var msg: String = string_new()
        string_push(msg, "error: cannot read module `")
        string_push(msg, path)
        string_push(msg, "`")
        eprint_str(string_view(msg))
        string_free(msg)
        m.err = true
        string_free(srcb)
        return
    }
    let dl: usize = path_dir_len(path)
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    var i: usize = 0
    for i < list.len(tokens.Token, tk) {
        let t: tokens.Token = list.get(tokens.Token, tk, i)
        if str_eq(src[t.start .. t.end], "import") {  // keyword: an ident can never be `import`
            let ps: tokens.Token = list.get(tokens.Token, tk, i + 1)
            var dep: String = string_new()            // resolve relative to the importing file
            string_push(dep, path[0 .. dl])
            string_push(dep, src[ps.start + 1 .. ps.end - 1])
            string_push(dep, ".jtr")
            ml_load(m, string_view(dep), it, kwcount, a)
            string_free(dep)
        }
        i = i + 1
    }
    list.free(tokens.Token, tk)
    let ss: i32 = sb_len(m.allsrc)
    string_push(m.allsrc, src)
    let se: i32 = sb_len(m.allsrc)
    string_push(m.allsrc, "\n")                       // keep regions disjoint, like the loader
    let ns: i32 = sb_len(m.nb)
    ml_push_stem(m.nb, path)
    let ne: i32 = sb_len(m.nb)
    string_push(m.nb, path)
    let pe: i32 = sb_len(m.nb)
    list.push(i32, m.mods, ns)
    list.push(i32, m.mods, ne)
    list.push(i32, m.mods, ne)                        // path_s (the path follows the stem)
    list.push(i32, m.mods, pe)
    list.push(i32, m.mods, ss)
    list.push(i32, m.mods, se)
    string_free(srcb)
}

// Mark `stem:name` as colliding (idempotent).
fn ml_mark_collision(mut m: Ml, read stem: str, read name: str) {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, stem)
    string_push(probe, ":")
    string_push(probe, name)
    string_push(probe, "|")
    if !contains(string_view(m.ren), string_view(probe)) {
        string_push(m.ren, string_view(probe))
    }
    string_free(probe)
}

// Is `stem:name` a recorded collision?
// Push module `stem`'s pre-order id digits (see `rids` in `ml_load`). A stem
// that was never visited pushes nothing -- unreachable for a stem `ren` knows.
fn ml_push_rid(mut sb: String, read rids: str, read stem: str) {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, stem)
    string_push(probe, "=")
    let at: isize = find(rids, string_view(probe))
    let pv: str = string_view(probe)                  // (never chain `string_view(x).len`)
    let plen: usize = pv.len
    string_free(probe)
    if at < 0 { return }
    var k: usize = (at as usize) + plen
    var e: usize = k
    for e < rids.len {
        if (rids[e] as i32) == 124 { break }          // `|`
        e = e + 1
    }
    string_push(sb, rids[k .. e])
}

fn ml_is_collision(read ren: str, read stem: str, read name: str) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, stem)
    string_push(probe, ":")
    string_push(probe, name)
    string_push(probe, "|")
    let hit: bool = contains(ren, string_view(probe))
    string_free(probe)
    return hit
}

// Register one top-level declaration: first sighting records `|name=stem|`; a second sighting
// from a DIFFERENT module marks both as collisions (renamed `name__<stem>` at rewrite).
fn ml_register(mut m: Ml, read name: str, read stem: str) {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, name)
    string_push(probe, "=")
    let pv: str = string_view(probe)
    let plen: usize = pv.len
    let at: isize = find(string_view(m.seen), string_view(probe))
    if at < 0 {
        string_push(m.seen, string_view(probe))
        string_push(m.seen, stem)
        string_push(m.seen, "|")
        string_free(probe)
        return
    }
    string_free(probe)
    var firstb: String = string_new()                 // copy the first-decl stem out of `seen`
    let sv: str = string_view(m.seen)
    var k: usize = (at as usize) + plen
    var e: usize = k
    for e < sv.len {                                  // '|' terminates the stem
        if (sv[e] as i32) == 124 { break }
        e = e + 1
    }
    string_push(firstb, sv[k .. e])
    if !str_eq(string_view(firstb), stem) {
        ml_mark_collision(m, string_view(firstb), name)
        ml_mark_collision(m, stem, name)
    }
    string_free(firstb)
}

// Is the first byte of `s` an identifier head (letter or `_`)? Filters `fn(`-type tokens.
fn ml_ident_head(read s: str) -> bool {
    if s.len == 0 { return false }
    let c: i32 = s[0] as i32
    if c >= 97 and c <= 122 { return true }
    if c >= 65 and c <= 90 { return true }
    return c == 95
}

// Phase 2: scan one module's TOP-LEVEL declaration names (brace depth 0; the token after a
// decl keyword must look like an identifier, so a `fn(i32)` TYPE never registers).
fn ml_scan_decls(mut m: Ml, mi: usize, mut it: Interner, kwcount: i64, read a: Allocator) {
    let b: usize = mi * 6
    var stemb: String = string_new()                  // copies: no `allsrc`/`nb` views live
    var srcb: String = string_new()                   // across the mut `ml_register` calls
    let nb0: str = string_view(m.nb)
    string_push(stemb, nb0[list.get(i32, m.mods, b) as usize .. list.get(i32, m.mods, b + 1) as usize])
    let all0: str = string_view(m.allsrc)
    string_push(srcb, all0[list.get(i32, m.mods, b + 4) as usize .. list.get(i32, m.mods, b + 5) as usize])
    let src: str = string_view(srcb)
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    var depth: i32 = 0
    var i: usize = 0
    for i < list.len(tokens.Token, tk) {
        let t: tokens.Token = list.get(tokens.Token, tk, i)
        let tx: str = src[t.start .. t.end]
        if str_eq(tx, "{") { depth = depth + 1 }
        else if str_eq(tx, "}") { depth = depth - 1 }
        else if depth == 0 {
            if str_eq(tx, "fn") or str_eq(tx, "struct") or str_eq(tx, "record") or str_eq(tx, "union") or str_eq(tx, "enum") or str_eq(tx, "const") or str_eq(tx, "distinct") or str_eq(tx, "trait") {
                // **An `extern` declaration's name is a C SYMBOL and must never be
                // renamed.** `extern "unistd.h" fn close(fd: i32)` names libc's `close`;
                // rewriting it to `close__m7` because `std/file` and `std/sysdir` also
                // declare a `close` produces `undefined reference to close__m7` at link
                // time -- and it does so SILENTLY, because the loader has no idea the name
                // it is renaming belongs to someone else's object file. Measured on a
                // two-module probe binding `puts`: the reference REFUSES the program
                // (*duplicate definition*), the port linked garbage.
                //
                // The shape is `[pub] [@attrs] extern "<abi>" fn <name>`, so the token two
                // before `fn` is `extern` -- the abi string sits between them. Skipping the
                // registration is enough: an unregistered name is never a collision, so it
                // is never rewritten, and any Jestyr function sharing it is unaffected
                // (cgen prefixes those with `jestyr_`, so there is no C-level clash either).
                var is_extern: bool = false
                if str_eq(tx, "fn") and i >= 2 {
                    let xt: tokens.Token = list.get(tokens.Token, tk, i - 2)
                    if str_eq(src[xt.start .. xt.end], "extern") { is_extern = true }
                }
                if i + 1 < list.len(tokens.Token, tk) and is_extern == false {
                    let nm: tokens.Token = list.get(tokens.Token, tk, i + 1)
                    if ml_ident_head(src[nm.start .. nm.end]) {
                        ml_register(m, src[nm.start .. nm.end], string_view(stemb))
                    }
                }
            }
        }
        i = i + 1
    }
    list.free(tokens.Token, tk)
    string_free(stemb)
    string_free(srcb)
}

// Phase 3: rewrite one module into `sb2` — drop `import` decls, erase `binding.x` qualifiers
// (renaming the member when the target declares it collidingly), rename this module's own
// colliding top-level names at bare (non-`.`-preceded) uses.
fn ml_rewrite(mut m: Ml, mi: usize, mut sb2: String, mut it: Interner, kwcount: i64, read a: Allocator) {
    let b: usize = mi * 6
    var stemb: String = string_new()
    var srcb: String = string_new()
    var renb: String = string_new()
    let nb0: str = string_view(m.nb)
    string_push(stemb, nb0[list.get(i32, m.mods, b) as usize .. list.get(i32, m.mods, b + 1) as usize])
    let all0: str = string_view(m.allsrc)
    string_push(srcb, all0[list.get(i32, m.mods, b + 4) as usize .. list.get(i32, m.mods, b + 5) as usize])
    string_push(renb, string_view(m.ren))
    let src: str = string_view(srcb)
    let ren: str = string_view(renb)
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let n: usize = list.len(tokens.Token, tk)
    var binds: String = string_new()                  // this module's `|binding=stem|` entries
    var i: usize = 0
    for i < n {
        let t: tokens.Token = list.get(tokens.Token, tk, i)
        if str_eq(src[t.start .. t.end], "import") {
            let ps: tokens.Token = list.get(tokens.Token, tk, i + 1)
            var stem2: String = string_new()
            var full: String = string_new()
            string_push(full, src[ps.start + 1 .. ps.end - 1])
            string_push(full, ".jtr")
            ml_push_stem(stem2, string_view(full))
            var j: usize = i + 2
            string_push(binds, "|")
            if j < n {
                let asq: tokens.Token = list.get(tokens.Token, tk, j)
                if str_eq(src[asq.start .. asq.end], "as") {
                    let al: tokens.Token = list.get(tokens.Token, tk, j + 1)
                    string_push(binds, src[al.start .. al.end])
                    j = j + 2
                } else {
                    string_push(binds, string_view(stem2))
                }
            } else {
                string_push(binds, string_view(stem2))
            }
            string_push(binds, "=")
            string_push(binds, string_view(stem2))
            string_push(binds, "|")
            string_free(stem2)
            string_free(full)
        }
        i = i + 1
    }
    let stem: str = string_view(stemb)
    let src_s: usize = list.get(i32, m.mods, b + 4) as usize
    var cur: usize = 0                                // source cursor: copy gaps, apply edits
    // (merged_pos, allsrc_pos) checkpoints: between edits the text is copied verbatim, so a
    // merged span maps back EXACTLY to its original file offset — the `#line` analogue.
    list.push(i32, m.map, sb_len(sb2))
    list.push(i32, m.map, src_s as i32)
    i = 0
    for i < n {
        let t: tokens.Token = list.get(tokens.Token, tk, i)
        let tx: str = src[t.start .. t.end]
        if str_eq(tx, "import") {
            var j: usize = i + 1                      // path Str [+ `as` ident] [+ `=` Str]
            var last: usize = j
            j = j + 1
            if j < n {
                let a2: tokens.Token = list.get(tokens.Token, tk, j)
                if str_eq(src[a2.start .. a2.end], "as") { last = j + 1  j = j + 2 }
            }
            if j < n {
                let e2: tokens.Token = list.get(tokens.Token, tk, j)
                if str_eq(src[e2.start .. e2.end], "=") { last = j + 1  j = j + 2 }
            }
            let lt: tokens.Token = list.get(tokens.Token, tk, last)
            string_push(sb2, src[cur .. t.start])
            var skip: usize = lt.end                  // also take the decl's own line break
            if skip < src.len {
                if (src[skip] as i32) == 13 { skip = skip + 1 }
            }
            if skip < src.len {
                if (src[skip] as i32) == 10 { skip = skip + 1 }
            }
            cur = skip
            list.push(i32, m.map, sb_len(sb2))
            list.push(i32, m.map, (src_s + cur) as i32)
            i = last + 1
            continue
        }
        if ml_ident_head(tx) {
            var prev_dot: bool = false
            var prev_const: bool = false
            if i > 0 {
                let pt: tokens.Token = list.get(tokens.Token, tk, i - 1)
                prev_dot = str_eq(src[pt.start .. pt.end], ".")
                prev_const = str_eq(src[pt.start .. pt.end], "const")
            }
            var next_dot: bool = false
            var next_colon: bool = false
            if i + 1 < n {
                let nt: tokens.Token = list.get(tokens.Token, tk, i + 1)
                next_dot = str_eq(src[nt.start .. nt.end], ".")
                next_colon = str_eq(src[nt.start .. nt.end], ":")
            }
            if !prev_dot and next_dot {
                var probe: String = string_new()      // is this ident an import binding?
                string_push(probe, "|")
                string_push(probe, tx)
                string_push(probe, "=")
                let pv: str = string_view(probe)
                let plen: usize = pv.len
                let at: isize = find(string_view(binds), string_view(probe))
                string_free(probe)
                if at >= 0 {
                    var tstem: String = string_new()  // the bound module's stem
                    let bv: str = string_view(binds)
                    var k2: usize = (at as usize) + plen
                    var e3: usize = k2
                    for e3 < bv.len {
                        if (bv[e3] as i32) == 124 { break }
                        e3 = e3 + 1
                    }
                    string_push(tstem, bv[k2 .. e3])
                    let x: tokens.Token = list.get(tokens.Token, tk, i + 2)
                    string_push(sb2, src[cur .. t.start])
                    string_push(sb2, src[x.start .. x.end])
                    if ml_is_collision(ren, string_view(tstem), src[x.start .. x.end]) {
                        string_push(sb2, "__m")
                        ml_push_rid(sb2, string_view(m.rids), string_view(tstem))
                    }
                    cur = x.end
                    list.push(i32, m.map, sb_len(sb2))
                    list.push(i32, m.map, (src_s + cur) as i32)
                    string_free(tstem)
                    i = i + 3
                    continue
                }
            }
            // `ident :` is never a USE of a top-level name -- it is a binder. Struct,
            // record, union and enum-payload FIELD declarations, function parameters,
            // `let`/`var` bindings and struct-LITERAL field names all have that shape, and
            // none of them refers to the module-level declaration whose name they happen
            // to share. Renaming them was the loader's remaining collision bug:
            //
            //   `std/sysdir` declares `pub fn open` AND a `Dir` field `open: bool`.
            //   `std/file` also declares `pub fn open`, so `open` collides and is renamed.
            //   `d.open` is `.`-preceded and was correctly left alone -- but the field
            //   DECLARATION and every `Dir{ …, open: false }` literal were rewritten to
            //   `open__m3`, so the struct became self-consistent under a name none of its
            //   seven accessors used. `jestyrc` built the same program; `jc` reported
            //   seven "type error at this expression" inside a module the user never
            //   edited.
            //
            // The repository recorded this as "the rename rewrites the FIELD ACCESS too".
            // Measured, it is the inverse: the accesses are the only sites that survive.
            // That is why the fix is one more token-level exclusion and not a scheme for
            // telling `mod.item` from a field access -- the `.`-preceded half already
            // worked.
            //
            // **`const NAME: T = v` is the one exception, and leaving it out broke
            // `test_demo` immediately.** A `const` IS a top-level name -- `std/test` and
            // `std/cli` both declare `BACKSLASH`, so it collides and its bare uses are
            // renamed -- and its declaration is the only top-level form spelled
            // `ident :`. Excluding it unrenamed the DECLARATION while every use kept the
            // new name, which is precisely the bug above with the two halves swapped:
            // `j_BACKSLASH__m1 undeclared`, plus a redefinition of the un-renamed one.
            // `distinct Name = Ty` needs no such carve-out because it spells `=`.
            //
            // The A/B over every multi-module corpus program is what caught it: 43 built
            // before, 46 after -- and `test_demo` moved from BUILD_OK to FAIL in the same
            // run, which is why `jc_build_matrix` is a two-directional expectations file
            // rather than a count.
            if !prev_dot and (!next_colon or prev_const) {
                if ml_is_collision(ren, stem, tx) {   // an own colliding name at a bare use
                    string_push(sb2, src[cur .. t.start])
                    string_push(sb2, tx)
                    string_push(sb2, "__m")
                    ml_push_rid(sb2, string_view(m.rids), stem)
                    cur = t.end
                    list.push(i32, m.map, sb_len(sb2))
                    list.push(i32, m.map, (src_s + cur) as i32)
                }
            }
        }
        i = i + 1
    }
    string_push(sb2, src[cur .. src.len])
    string_push(sb2, "\n")
    list.free(tokens.Token, tk)
    string_free(binds)
    string_free(stemb)
    string_free(srcb)
    string_free(renb)
}

// Load + flatten the import closure rooted at `root` into one single-file program. Returns
// the merged source; empty on a load failure (already reported to stderr).
fn ml_flatten(mut m: Ml, read root: str, mut it: Interner, kwcount: i64, read a: Allocator) -> String {
    ml_load(m, root, it, kwcount, a)
    var merged: String = string_new()
    if !m.err {
        let count: usize = list.len(i32, m.mods) / 6
        var mi: usize = 0
        for mi < count {
            ml_scan_decls(m, mi, it, kwcount, a)
            mi = mi + 1
        }
        var mj: usize = 0
        for mj < count {
            ml_rewrite(m, mj, merged, it, kwcount, a)
            mj = mj + 1
        }
    }
    string_free(m.vis)                                // allsrc/nb/mods/map stay alive: the
    string_free(m.seen)                               // driver renders diagnostics through them
    return merged
}

// ---- the product driver (`build` / `run`) — the self-hosted compiler as a daily tool ----
// Unlike the raw `jc <file>` dump (the golden's plumbing mode, mirroring `cgen::emit`
// unconditionally), the product modes GATE on the escape checker's buffered diagnostics,
// render them through **`std/diag`** on stderr, write `<stem>.c`, drive gcc with the locked
// flag set via `run_command`, and (for `run`) execute the produced binary, forwarding its
// exit code. Parse and typeck refusal use the recovery artifacts (Error nodes / Error
// types) with generic v1 messages at exact mapped locations; the reference's expected/found
// message text is a follow-up.
//
// ─── Why the driver imports `std/diag` rather than keeping its own renderer ────
//
// The driver used to print one `path:line:col: error: <msg>` line and stop at the first
// diagnostic, counting line and column itself. Two things were wrong with that, and only
// one of them is cosmetic.
//
// The cosmetic one: no source line, no caret, so a diagnostic said WHERE without showing
// WHAT. `diag.plain()` renders the same `--> file:line:col` / gutter / caret block the
// reference's `src/diag.rs` does, so both toolchains now look alike at a glance.
//
// The one that matters: **the loader already held a source map and nothing knew it.**
// `Ml.nb` is every loaded module's name concatenated, `Ml.allsrc` every module's source,
// and `Ml.mods` six offsets per module — which is a `diag.SourceMap` with different field
// names. Handing those ranges to `diag.add_file` once deletes the hand-rolled line/column
// counter here (a second implementation of `diag.pos_of`, and the kind of duplicate that
// drifts silently because nothing compares them).
//
// The cost is honest and worth naming: `diag` and its `sink` dependency join the
// self-hosting closure, so `SELFHOST_MODULES` is fourteen modules and the bootstrap seed
// carries both. That is what "load-bearing" means here — the module is no longer merely
// available to programs the compiler compiles, it is part of the compiler.

const DIAG_CAP: usize = 8192

// The `SourceMap` the driver renders through: one file per loaded module, added in loader
// order, so **a module index IS its `FileId`** — which is what lets `driver_report` map an
// owning-module index straight to a file without a side table.
fn driver_map(mut m: Ml, read a: Allocator) -> diag.SourceMap {
    var sm: diag.SourceMap = diag.map_new(a)
    let nbv: str = string_view(m.nb)
    let all: str = string_view(m.allsrc)
    var mi: usize = 0
    for mi < list.len(i32, m.mods) / 6 {
        let mb: usize = mi * 6
        let ns: usize = list.get(i32, m.mods, mb + 2) as usize
        let ne: usize = list.get(i32, m.mods, mb + 3) as usize
        let ss: usize = list.get(i32, m.mods, mb + 4) as usize
        let se: usize = list.get(i32, m.mods, mb + 5) as usize
        let fid: diag.FileId = diag.add_file(sm, nbv[ns .. ne], all[ss .. se])
        mi = mi + 1
    }
    return sm
}

// A merged-source offset → the corresponding offset in `allsrc`, or -1 when unmapped. The
// merged span maps back through the rewrite checkpoints: the last checkpoint at or before
// the span, verbatim in between. (This is the `#line` analogue — the rewriter's renames
// shift offsets, and the checkpoints are where it recorded the shift.)
fn driver_orig(mut m: Ml, start: usize) -> i64 {
    var cm: i32 = 0 - 1
    var co: i32 = 0 - 1
    var i: usize = 0
    for i < list.len(i32, m.map) / 2 {
        let mp: i32 = list.get(i32, m.map, i * 2)
        if mp as usize <= start {
            cm = mp
            co = list.get(i32, m.map, i * 2 + 1)
        }
        i = i + 1
    }
    if cm < 0 { return 0 - 1 }
    return (co as i64) + (start as i64) - (cm as i64)
}

// The index of the module whose `allsrc` range contains `orig` (0 if none, which cannot
// happen for a mapped offset but must not be a crash if it does).
fn driver_owner(mut m: Ml, orig: usize) -> i32 {
    var found: i32 = 0 - 1
    var mi: usize = 0
    for mi < list.len(i32, m.mods) / 6 {
        let ss: i32 = list.get(i32, m.mods, mi * 6 + 4)
        let se: i32 = list.get(i32, m.mods, mi * 6 + 5)
        if orig >= ss as usize and orig <= se as usize { found = mi as i32 }
        mi = mi + 1
    }
    if found < 0 { found = 0 }
    return found
}

// One diagnostic on stderr, attributed to its OWNING FILE and rendered through `std/diag`.
//
// `full` picks the rendering, and **the choice is per STAGE rather than global** because
// the argument for abbreviating only holds where diagnostics cascade:
//
//   * parse — one missing operand produces five Error nodes, because recovery resumes
//     mid-expression and every following token is then read in the wrong context;
//   * type — an Error type propagates into every enclosing expression;
//   * escape — it does NOT cascade. Each diagnostic is an independent rule violation at an
//     independent site, which is why the reference renders all of them in full and so does
//     this.
//
// So the cascading stages get `diag_demo.jtr`'s first-full-rest-brief policy (five caret
// blocks for one mistake bury the mistake, and that is the whole reason `render_brief`
// exists), and the non-cascading one does not.
//
// **No error code.** The reference attaches one (`error[E0007]: expected an expression,
// found `)``) because its parser knows which rule failed; these messages are deliberately
// generic v1 text recovered from an Error node, so a code here would either duplicate a
// reference code with a different meaning or invent a parallel numbering. Saying less is
// the honest option until the port carries the reference's expected/found text.
fn driver_report(mut m: Ml, read sm: diag.SourceMap, read a: Allocator, start: usize, end: usize, read msg: str, read label: str, full: bool, nprev: i32, prevfull: bool) {
    // The separator rule: a blank line goes before a diagnostic when EITHER it or the one
    // before it is a caret block. Consecutive one-liners run together, which is what makes
    // a cascade tail read as a list rather than as four paragraphs.
    //
    // Emitted before rather than after, so that the summary's own blank line is the only
    // thing between the last diagnostic and `N error(s)` — otherwise the count of blank
    // lines there would depend on which form the last diagnostic happened to take.
    if nprev > 0 and (full or prevfull) { eprint_str("") }
    let og: i64 = driver_orig(m, start)
    var d: diag.Diagnostic = diag.new_error(a, "", msg)
    if og >= 0 {
        let orig: usize = og as usize
        let own: i32 = driver_owner(m, orig)
        let base: usize = list.get(i32, m.mods, (own as usize) * 6 + 4) as usize
        let lim: usize = list.get(i32, m.mods, (own as usize) * 6 + 5) as usize
        // The span is clamped to the owning file: a merged END can run past the module
        // boundary when recovery swallowed a run, and a span outside its file would place
        // the caret in another module's text rather than fail loudly.
        var hi: usize = orig
        let oge: i64 = driver_orig(m, end)
        if oge > og { hi = oge as usize }
        if hi > lim { hi = lim }
        diag.primary(d, diag.span(own as diag.FileId, orig - base, hi - base), label)
    }
    var raw: *mut u8 = alloc(u8, DIAG_CAP)
    var buf: []u8 = slice(u8, raw, DIAG_CAP)
    var s: Sink = sink.new()
    if full {
        let n: usize = diag.render(s, buf, sm, d, diag.plain())
    } else {
        let n2: usize = diag.render_brief(s, buf, sm, d)
    }
    // The overflow contract, which is the one thing a caller must not skip: `render`
    // returns what it WROTE, so a truncated caret block is indistinguishable from a
    // complete one at every oracle. Fall back to the one-line form, which fits any sane
    // buffer, rather than print a diagnostic cut in half — possibly mid-caret.
    if sink.overflowed(s) {
        sink.reset(s)
        let n3: usize = diag.render_brief(s, buf, sm, d)
    }
    // `render` ends its last row with a newline and `render_brief` does not, while
    // `eprint_str` supplies one either way. Trimming the renderer's own trailing newline is
    // what makes the two forms space identically — and keeps exactly one blank line before
    // the `N error(s)` summary, like the reference, instead of one or two depending on
    // which form the last diagnostic happened to take.
    let v: str = sink.view(s, buf)
    if v.len > 0 and (v[v.len - 1] as i32) == 10 {
        eprint_str(v[0 .. v.len - 1])
    } else {
        eprint_str(v)
    }
    free_ptr(raw)
}

// The trailing `N error(s)` the reference prints, after one blank line. A count is not
// decoration: where the first-full-rest-brief policy applies, it is what tells a reader
// whether the one caret block they are looking at was the whole story.
fn driver_error_count(n: i32) {
    eprint_str("")
    var c: String = string_new()
    push_uint(c, n as i64)
    string_push(c, " error(s)")
    eprint_str(string_view(c))
    string_free(c)
}

// The `build`/`run` modes: 1 on diagnostics or a write failure, gcc's code on a failed
// compile, the program's own exit code for `run`, else 0.
fn driver_build(mut m: Ml, read p: parser.Parser, read c: typeck.Checker, read src: str, read a: Allocator, read path: str, do_run: bool) -> i32 {
    // The loader's own tables, handed to `diag` once. Built here rather than per
    // diagnostic: `add_file` copies each module's source into the map's arena, so building
    // it inside the reporter would copy the whole program once per error.
    var sm: diag.SourceMap = driver_map(m, a)
    var nerr: i32 = 0
    var prevfull: bool = false                    // was the last diagnostic a caret block?

    // Parse refusal: any Error expr (kind 9) or Error item (kind 99) — the ported parser's
    // recovery artifacts. v1 messages are generic (the reference's expected/found text is a
    // follow-up); the LOCATION is exact via the checkpoint mapper.
    //
    // Every artifact is now reported, not just the first. The stages stay separate and each
    // still refuses before the next, because a program that did not parse has garbage types
    // and reporting those on top would be noise, not information.
    var pi2: usize = 0
    for pi2 < list.len(parser.ExprData, p.ex) {
        let pe: parser.ExprData = list.get(parser.ExprData, p.ex, pi2)
        if pe.kind == 9 {
            driver_report(m, sm, a, pe.start, pe.end, "syntax error (unexpected or malformed input)", "the parser could not read this as an expression", nerr == 0, nerr, prevfull)
            prevfull = nerr == 0
            nerr = nerr + 1
        }
        pi2 = pi2 + 1
    }
    var pj: usize = 0
    for pj < list.len(parser.ItemData, p.it) {
        let itd: parser.ItemData = list.get(parser.ItemData, p.it, pj)
        if itd.kind == 99 {
            driver_report(m, sm, a, itd.start, itd.end, "syntax error: expected an item", "only `fn`, `struct`, `enum`, `const`, `trait`, `impl`, `import` and `distinct` may appear here", nerr == 0, nerr, prevfull)
            prevfull = nerr == 0
            nerr = nerr + 1
        }
        pj = pj + 1
    }
    if nerr > 0 {
        driver_error_count(nerr)
        return 1
    }
    // Type refusal: any expression the checker resolved to the Error type (kind 16 — a real
    // mismatch, e.g. an operator with no impl; degenerate Unknowns never refuse).
    var ti2: usize = 0
    for ti2 < list.len(i32, c.et) {
        let tid2: i32 = list.get(i32, c.et, ti2)
        if tid2 >= 0 {
            let td2: typeck.TyData = list.get(typeck.TyData, c.tys, tid2 as usize)
            if td2.kind == 16 {
                let ed2: parser.ExprData = list.get(parser.ExprData, p.ex, ti2)
                driver_report(m, sm, a, ed2.start, ed2.end, "type error at this expression", "this expression has no valid type", nerr == 0, nerr, prevfull)
                prevfull = nerr == 0
                nerr = nerr + 1
            }
        }
        ti2 = ti2 + 1
    }
    if nerr > 0 {
        driver_error_count(nerr)
        return 1
    }
    var e: escape.Esc = escape.check_program(p, c, src, a)
    if list.len(i32, e.dsp) > 0 {                     // refuse to emit on escape diagnostics
        let dm: str = string_view(e.dmsg)
        var di: usize = 0
        var ls: usize = 0
        var k: usize = 0
        for k < dm.len {
            if (dm[k] as i32) == 10 {
                // `dsp` holds span PAIRS; the end was already recorded and was previously
                // thrown away, which is why the old renderer could only ever have drawn a
                // one-column caret. Every escape diagnostic renders in FULL — they do not
                // cascade, so abbreviating the second one would lose a real finding rather
                // than suppress an echo of the first.
                driver_report(m, sm, a, list.get(i32, e.dsp, di * 2) as usize, list.get(i32, e.dsp, di * 2 + 1) as usize, dm[ls .. k], "", true, nerr, prevfull)
                prevfull = true
                nerr = nerr + 1
                di = di + 1
                ls = k + 1
            }
            k = k + 1
        }
        driver_error_count(nerr)
        return 1
    }
    var sb: String = string_new()
    // The driver passes the loader's debug table, so the emitted C carries
    // `#line` directives mapping back to the ORIGINAL per-file sources -- the
    // same table the reference's module path fills into DebugInfo. Every other
    // emit_program caller passes an empty table and emits none.
    emit_program(sb, p, c, src, a, false, "", m.map, m.mods, string_view(m.nb), string_view(m.allsrc))
    // POSIX probe: `/dev/null` opens only there (Windows fopen fails on that path).
    // One call decides output naming, the compiler probe, and how `run` invokes.
    let posix: bool = fs.exists("/dev/null")
    var stem: String = string_new()                   // `<file minus .jtr>`
    if ends_with(path, ".jtr") {
        string_push(stem, path[0 .. path.len - 4])
    } else {
        string_push(stem, path)
    }
    var cpath: String = string_new()
    string_push(cpath, string_view(stem))
    string_push(cpath, ".c")
    var xpath: String = string_new()
    string_push(xpath, string_view(stem))
    if !posix { string_push(xpath, ".exe") }          // POSIX: no suffix, like the reference driver
    if !write_file(string_view(cpath), string_view(sb)) {
        eprint_str("error: cannot write the generated C")
        return 1
    }
    var cmd: String = string_new()                    // the locked flag set (mirrors CC_FLAGS)
    if posix {
        // The reference driver's probe order (cc, gcc, clang), via the shell.
        if run_command("cc --version >/dev/null 2>&1") == 0 {
            string_push(cmd, "cc")
        } else {
            if run_command("gcc --version >/dev/null 2>&1") == 0 {
                string_push(cmd, "gcc")
            } else {
                string_push(cmd, "clang")
            }
        }
    } else {
        string_push(cmd, "gcc")                       // Windows: gcc (MinGW), as documented
    }
    string_push(cmd, " -O2 -std=c11 -ffp-contract=off -fno-fast-math")
    if contains(string_view(sb), "pthread") { string_push(cmd, " -pthread") }
    // **The Windows target baseline**, mirroring `cc_base_flags`: mingw declares `WSAPoll`
    // only at `_WIN32_WINNT >= 0x0600`, and below that it is an implicit declaration
    // returning `int` -- the silent `int`-fallback shape. Set unconditionally on Windows
    // rather than gated on content, so the same source never compiles differently depending
    // on which modules a program happened to import.
    if !posix { string_push(cmd, " -D_WIN32_WINNT=0x0600") }
    string_push(cmd, " -o \"")
    string_push(cmd, string_view(xpath))
    string_push(cmd, "\" \"")
    string_push(cmd, string_view(cpath))
    string_push(cmd, "\"")
    // **Winsock is linked LAST, and the position is load-bearing.** `<winsock2.h>` declares
    // the socket API but the implementation is in `ws2_32.dll`, which mingw does not link by
    // default; GNU ld resolves `-l` libraries against the objects seen SO FAR, so placing it
    // before the source resolves nothing and the link fails exactly as if the flag were
    // absent. Content-triggered like `-pthread`, and host-gated because both `@cfg` branches
    // are always emitted -- the source names `winsock2.h` on Linux too.
    if !posix {
        if contains(string_view(sb), "winsock2.h") { string_push(cmd, " -lws2_32") }
    }
    let rc: i32 = run_command(string_view(cmd))
    if rc != 0 {
        eprint_str("error: the C compiler failed on the generated C")
        return rc
    }
    if do_run {
        var rcmd: String = string_new()
        string_push(rcmd, "\"")
        // A separator-free path is not on the POSIX shell's PATH — anchor it.
        // (Windows too: cmd.exe skips the current directory when
        // NoDefaultCurrentDirectoryInExePath is set, as MSYS/Git Bash does.)
        if posix {
            if !contains(string_view(xpath), "/") { string_push(rcmd, "./") }
        } else {
            if !contains(string_view(xpath), "/") {
                if !contains(string_view(xpath), "\\") { string_push(rcmd, ".\\") }
            }
        }
        string_push(rcmd, string_view(xpath))
        string_push(rcmd, "\"")
        let prc: i32 = run_command(string_view(rcmd))
        return prc
    }
    return 0
}

// ---- attest records (`jc <file> attest`) ----
// The per-item section of the attestation manifest, mirroring `attest::collect_records`
// plus the `doc::{fn_sig, fn_guarantees, const_sig, extern_sig, ty_str}` reconstructors:
// faithful Jestyr-surface signatures re-printed from the AST (not span slices), sorted
// by (kind, name), each fn carrying its machine-checked guarantees.

// The surface label of a parameter convention (`Conv::label`; 0=default renders empty).
fn at_conv_label(conv: i32) -> str {
    if conv == 1 { return "read" }
    if conv == 2 { return "mut" }
    if conv == 3 { return "take" }
    if conv == 4 { return "out" }
    return ""
}

// The exact source text of an expression, trimmed (`doc::expr_src`).
fn at_expr_src(mut sb: String, read p: parser.Parser, read src: str, eid: i32) {
    let d: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    string_push(sb, trim(src[d.start .. d.end]))
}

// Render a type in Jestyr surface syntax (`doc::ty_str`). The IMPLEMENTATION lives in
// `ctfe.jtr`, because compile-time reflection (`@field_type`) needs the same renderer and
// sits below this module. Kept as a thin wrapper so the sixteen call sites here read
// unchanged -- and so there is exactly ONE renderer, which is what stops a reflected type
// name from ever disagreeing with the documented or attested one.
fn at_ty(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    ctfe.at_ty(sb, p, src, tyid)
}

// Render a fn/extern param list in surface syntax (`doc::params_str`): `iar` 7-tuples
// [comptime, conv, name_s, name_e, is_self, type_id, refine], comma-joined.
fn at_params(mut sb: String, read p: parser.Parser, read src: str, pstart: i32, pcount: i32) {
    var i: i32 = 0
    for i < pcount {
        if i > 0 { string_push(sb, ", ") }
        let base: i32 = pstart + i * 7
        let cm: i32 = list.get(i32, p.iar, base as usize)
        let cv: i32 = list.get(i32, p.iar, (base + 1) as usize)
        let ns: i32 = list.get(i32, p.iar, (base + 2) as usize)
        let ne: i32 = list.get(i32, p.iar, (base + 3) as usize)
        let slf: i32 = list.get(i32, p.iar, (base + 4) as usize)
        let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
        let rf: i32 = list.get(i32, p.iar, (base + 6) as usize)
        if slf != 0 {
            if cv != 0 { string_push(sb, at_conv_label(cv)) string_push(sb, " ") }
            string_push(sb, "self")
        } else {
            if cm != 0 { string_push(sb, "comptime ") }
            if cv != 0 { string_push(sb, at_conv_label(cv)) string_push(sb, " ") }
            string_push(sb, src[ns as usize .. ne as usize])
            if pty >= 0 { string_push(sb, ": ") at_ty(sb, p, src, pty) }
            if rf >= 0 { string_push(sb, " in ") at_expr_src(sb, p, src, rf) }
        }
        i = i + 1
    }
}

// Push a fn's `!{…}` error-set names comma-joined, from its `far` extras at `e`.
// A payload carrier renders `Name(T)` through at_ty — ONE renderer, so the
// attested contract and the docs cannot disagree on a payload's spelling
// (mirrors the reference's `doc::err_name_str`).
fn at_errnames(mut sb: String, read p: parser.Parser, read src: str, e: i32) {
    let ec: i32 = list.get(i32, p.far, e as usize)
    var k: i32 = 0
    for k < ec {
        if k > 0 { string_push(sb, ", ") }
        let ns: i32 = list.get(i32, p.far, (e + 1 + k * 3) as usize)
        let ne: i32 = list.get(i32, p.far, (e + 2 + k * 3) as usize)
        string_push(sb, src[ns as usize .. ne as usize])
        let ptid: i32 = list.get(i32, p.far, (e + 3 + k * 3) as usize)
        if ptid >= 0 {
            string_push(sb, "(")
            at_ty(sb, p, src, ptid)
            string_push(sb, ")")
        }
        k = k + 1
    }
}

// `doc::fn_sig`: `[pub ][@no_panic ]fn name(params)[ -> [conv ]R][ !{ A, B }]`.
fn at_fn_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    if item_has_attr(p, src, it, "no_panic") { string_push(sb, "@no_panic ") }
    string_push(sb, "fn ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    string_push(sb, "(")
    at_params(sb, p, src, it.a, it.b)
    string_push(sb, ")")
    if it.z >= 0 {
        string_push(sb, " -> ")
        if it.op != 0 { string_push(sb, at_conv_label(it.op)) string_push(sb, " ") }
        at_ty(sb, p, src, it.z)
    }
    if fn_is_fallible(p, it) {
        string_push(sb, " !{ ")
        at_errnames(sb, p, src, it.e)
        string_push(sb, " }")
    }
}

// `doc::extern_sig`: `[pub ]extern "abi" fn name(params)[ -> [conv ]R]` (absent abi
// string defaults to "c", mirroring the reference parser's default).
fn at_extern_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    string_push(sb, "extern \"")
    if it.w >= 0 { string_push(sb, src[it.w as usize .. it.u as usize]) } else { string_push(sb, "c") }
    string_push(sb, "\" fn ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    // The declared alias is part of the ABI contract attest hashes: `fn sys_read = "read"`
    // and `fn sys_read = "_read"` bind different C symbols and must not render alike.
    if it.cns >= 0 {
        string_push(sb, " = \"")
        string_push(sb, src[it.cns as usize .. it.cne as usize])
        string_push(sb, "\"")
    }
    string_push(sb, "(")
    at_params(sb, p, src, it.a, it.b)
    string_push(sb, ")")
    if it.z >= 0 {
        string_push(sb, " -> ")
        if it.op != 0 { string_push(sb, at_conv_label(it.op)) string_push(sb, " ") }
        at_ty(sb, p, src, it.z)
    }
}

// `doc::const_sig`: `[pub ]const NAME[: T] = <value source text>`.
fn at_const_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    string_push(sb, "const ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    if it.a >= 0 { string_push(sb, ": ") at_ty(sb, p, src, it.a) }
    string_push(sb, " = ")
    at_expr_src(sb, p, src, it.b)
}

// `doc::fn_guarantees` — the machine-checked guarantees of `it`, each appended to `gb` as one
// phrase with its (start, end) span pushed to `gs`, in the reference's fixed order:
// `@no_panic`, `requires`, `ensures`, param refinements, the error set. The doc generator's
// **Guarantees** block and attest's manifest share this ONE extractor, so the attested
// behavioral ABI can never drift from the rendered documentation.
fn at_guarantee_phrases(mut gb: String, mut gs: List(i32), read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if item_has_attr(p, src, it, "no_panic") {
        let q0: i32 = sb_len(gb)
        string_push(gb, "`@no_panic` — proven free of faulting operations")
        list.push(i32, gs, q0)
        list.push(i32, gs, sb_len(gb))
    }
    if it.e >= 0 {
        let ec: i32 = list.get(i32, p.far, it.e as usize)
        var idx: i32 = it.e + 1 + ec * 3
        let rc: i32 = list.get(i32, p.far, idx as usize)
        idx = idx + 1
        var i: i32 = 0
        for i < rc {
            let q1: i32 = sb_len(gb)
            string_push(gb, "`requires ")
            at_expr_src(gb, p, src, list.get(i32, p.far, idx as usize))
            string_push(gb, "`")
            list.push(i32, gs, q1)
            list.push(i32, gs, sb_len(gb))
            idx = idx + 1
            i = i + 1
        }
        let sc: i32 = list.get(i32, p.far, idx as usize)
        idx = idx + 1
        var j: i32 = 0
        for j < sc {
            let q2: i32 = sb_len(gb)
            string_push(gb, "`ensures ")
            at_expr_src(gb, p, src, list.get(i32, p.far, idx as usize))
            string_push(gb, "`")
            list.push(i32, gs, q2)
            list.push(i32, gs, sb_len(gb))
            idx = idx + 1
            j = j + 1
        }
    }
    var k: i32 = 0
    for k < it.b {
        let base: i32 = it.a + k * 7
        let rf: i32 = list.get(i32, p.iar, (base + 6) as usize)
        if rf >= 0 {
            let q3: i32 = sb_len(gb)
            string_push(gb, "parameter `")
            let ns: i32 = list.get(i32, p.iar, (base + 2) as usize)
            let ne: i32 = list.get(i32, p.iar, (base + 3) as usize)
            string_push(gb, src[ns as usize .. ne as usize])
            string_push(gb, "` is constrained to `")
            at_expr_src(gb, p, src, rf)
            string_push(gb, "`")
            list.push(i32, gs, q3)
            list.push(i32, gs, sb_len(gb))
        }
        k = k + 1
    }
    if fn_is_fallible(p, it) {
        let q4: i32 = sb_len(gb)
        string_push(gb, "may fail with `!{ ")
        at_errnames(gb, p, src, it.e)
        string_push(gb, " }`")
        list.push(i32, gs, q4)
        list.push(i32, gs, sb_len(gb))
    }
}

// The manifest's rendering of those phrases: one `  guarantee: <phrase>\n` line each.
fn at_guarantees(mut ob: String, read p: parser.Parser, read src: str, read it: parser.ItemData, read a: Allocator) {
    var gb: String = string_new()
    var gs: List(i32) = list.make(i32, a)
    at_guarantee_phrases(gb, gs, p, src, it)
    let gv: str = string_view(gb)
    var i: usize = 0
    for i < list.len(i32, gs) / 2 {
        string_push(ob, "  guarantee: ")
        string_push(ob, gv[list.get(i32, gs, i * 2) as usize .. list.get(i32, gs, i * 2 + 1) as usize])
        string_push(ob, "\n")
        i = i + 1
    }
    string_free(gb)
}

// One trait method, rendered as `doc::fn_sig` renders a free function, from the `mar`
// 8-tuple [name_s, name_e, param_start, param_count, ret_conv, ret_ty, body, err].
// Mirrors the reference's `attest::trait_method_sig`.
fn at_trait_method_sig(mut sb: String, read p: parser.Parser, read src: str, mb: i32) {
    let mns: i32 = list.get(i32, p.mar, mb as usize)
    let mne: i32 = list.get(i32, p.mar, (mb + 1) as usize)
    let ps: i32 = list.get(i32, p.mar, (mb + 2) as usize)
    let pc: i32 = list.get(i32, p.mar, (mb + 3) as usize)
    let rc: i32 = list.get(i32, p.mar, (mb + 4) as usize)
    let rt: i32 = list.get(i32, p.mar, (mb + 5) as usize)
    let body: i32 = list.get(i32, p.mar, (mb + 6) as usize)
    let merr: i32 = list.get(i32, p.mar, (mb + 7) as usize)
    string_push(sb, "fn ")
    string_push(sb, src[mns as usize .. mne as usize])
    string_push(sb, "(")
    at_params(sb, p, src, ps, pc)
    string_push(sb, ")")
    if rt >= 0 {
        string_push(sb, " -> ")
        if rc != 0 { string_push(sb, at_conv_label(rc)) string_push(sb, " ") }
        at_ty(sb, p, src, rt)
    }
    if merr >= 0 {
        string_push(sb, " !{ ")
        at_errnames(sb, p, src, merr)
        string_push(sb, " }")
    }
    // A default body is part of the contract: removing one turns an optional method into
    // a required one, which breaks every implementor that relied on it.
    if body >= 0 { string_push(sb, " { … }") }
}

// `[pub ]trait Name { fn a(…); fn b(…) }` — the method SET inside the signature.
// Declaration order, NOT sorted: reordering a trait's methods is an ABI change in a
// vtable-dispatched language and this is the only record that can see it.
fn at_trait_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    string_push(sb, "trait ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    string_push(sb, " { ")
    var m: i32 = 0
    for m < it.b {
        if m > 0 { string_push(sb, "; ") }
        at_trait_method_sig(sb, p, src, it.a + m * 8)
        m = m + 1
    }
    string_push(sb, " }")
}

// The `<Trait> for <Type>` name an impl record is keyed by. Coherence allows at most one
// impl per pair, which is what makes this string a key.
fn at_impl_name(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    string_push(sb, src[it.x as usize .. it.y as usize])
    string_push(sb, " for ")
    at_ty(sb, p, src, it.a)
}

// `impl[T] Trait for Ty { fn a(…); fn b(…) }`. The generic parameters matter: a blanket
// `impl[T] Drop for Vec(T)` and a concrete `impl Drop for Vec(i32)` cover different sets
// of instantiations. Methods are fn-ItemIds, so `at_fn_sig` renders them unchanged.
fn at_impl_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    string_push(sb, "impl")
    if it.h > 0 {
        string_push(sb, "[")
        var g: i32 = 0
        for g < it.h {
            if g > 0 { string_push(sb, ", ") }
            // 4 ints per generic: name start/end, then bound start/end. The reference
            // renders only the NAME (`g.name.name`), so the bound span is skipped.
            let gs: i32 = list.get(i32, p.gar, (it.g + g * 4) as usize)
            let ge: i32 = list.get(i32, p.gar, (it.g + g * 4 + 1) as usize)
            string_push(sb, src[gs as usize .. ge as usize])
            g = g + 1
        }
        string_push(sb, "]")
    }
    string_push(sb, " ")
    at_impl_name(sb, p, src, it)
    string_push(sb, " { ")
    var m: i32 = 0
    for m < it.z {
        if m > 0 { string_push(sb, "; ") }
        let mid: i32 = list.get(i32, p.mar, (it.b + m) as usize)
        let mit: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
        at_fn_sig(sb, p, src, mit)
        m = m + 1
    }
    string_push(sb, " }")
}

// The manifest kind tag of a top-level item, or "" if it isn't attested.
//
// **`trait` and `impl` used to return "" here, and that was a FALSE NEGATIVE inside the
// tool whose whole job is finding breakage.** Measured: two programs differing only by a
// removed `pub` trait method produced different C hashes and `no API changes`, exit 0.
// The old comment said the effect was "captured by the C hash" — the hash is in the
// manifest, but `diff` produces no change record from it, so it can never reach the
// breaking verdict. A hash cannot classify; it can only say something moved, which is
// true of every rebuild.
//
// `distinct` and `import` stay out: neither carries a callable surface. A `distinct` is
// attested by the struct/fn records that mention it, and imports are `jestyrc manifest`'s.
fn at_kind_str(read it: parser.ItemData) -> str {
    if it.kind == 3 { return "fn" }
    if it.kind == 2 { return "const" }
    if it.kind == 5 { return "enum" }
    if it.kind == 6 { return "trait" }
    if it.kind == 7 { return "impl" }
    if it.kind == 8 { return "extern" }
    if it.kind == 4 {
        if it.op == 2 { return "union" }
        if it.op == 1 { return "record" }
        return "struct"
    }
    return ""
}

// Order records by (kind, name) — the reference's sort key. Names are unique per
// kind in a well-formed program, so this is a total order (stability irrelevant).
// The name a record is keyed and sorted by. For everything but an `impl` that is the
// item's own name span; an impl has no name of its own, so it is keyed `<Trait> for
// <Type>` — unique because coherence allows at most one impl per pair.
fn at_record_name(read p: parser.Parser, read src: str, read it: parser.ItemData) -> String {
    var sb: String = string_new()
    if it.kind == 7 {
        at_impl_name(sb, p, src, it)
    } else {
        string_push(sb, src[it.x as usize .. it.y as usize])
    }
    return sb
}

fn at_lt(read p: parser.Parser, read src: str, ia: i32, ib: i32) -> bool {
    let da: parser.ItemData = list.get(parser.ItemData, p.it, ia as usize)
    let db: parser.ItemData = list.get(parser.ItemData, p.it, ib as usize)
    let ka: str = at_kind_str(da)
    let kb: str = at_kind_str(db)
    if !str_eq(ka, kb) { return str_lt(ka, kb) }
    var na: String = at_record_name(p, src, da)
    var nb: String = at_record_name(p, src, db)
    let va: str = string_view(na)
    let vb: str = string_view(nb)
    let r: bool = str_lt(va, vb)
    string_free(na)
    string_free(nb)
    return r
}

// The per-item records section (`attest::collect_records` + the emit loop in
// `attest::manifest`): one block per attested top-level item, each opened by a
// blank line — `<kind> <name>` / `  vis:` / `  sig:` / `  guarantee:`*.
fn at_records(mut ob: String, read p: parser.Parser, read src: str, read a: Allocator) {
    var ids: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        let ks: str = at_kind_str(it)
        if ks.len > 0 { list.push(i32, ids, iid) }
        r = r + 1
    }
    // Selection sort by (kind, name), emitting each record as its slot settles.
    var i: i32 = 0
    for i < list.len(i32, ids) {
        var m: i32 = i
        var j: i32 = i + 1
        for j < list.len(i32, ids) {
            if at_lt(p, src, list.get(i32, ids, j as usize), list.get(i32, ids, m as usize)) { m = j }
            j = j + 1
        }
        if m != i {
            let t: i32 = list.get(i32, ids, i as usize)
            list.set(i32, ids, i as usize, list.get(i32, ids, m as usize))
            list.set(i32, ids, m as usize, t)
        }
        let iid: i32 = list.get(i32, ids, i as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        string_push(ob, "\n")
        let ks: str = at_kind_str(it)
        string_push(ob, ks)
        string_push(ob, " ")
        var rn: String = at_record_name(p, src, it)
        string_push(ob, string_view(rn))
        string_free(rn)
        string_push(ob, "\n")
        // An `impl` carries no visibility of its own and is reachable through any public
        // trait, so it records as `pub` — the conservative direction, matching this tool's
        // contract that only PROVABLY compatible changes get the compatible verdict.
        var vpub: bool = it.is_pub != 0
        if it.kind == 7 { vpub = true }
        if vpub { string_push(ob, "  vis: pub\n") } else { string_push(ob, "  vis: priv\n") }
        string_push(ob, "  sig: ")
        if it.kind == 3 { at_fn_sig(ob, p, src, it) }
        if it.kind == 6 { at_trait_sig(ob, p, src, it) }
        if it.kind == 7 { at_impl_sig(ob, p, src, it) }
        if it.kind == 2 { at_const_sig(ob, p, src, it) }
        if it.kind == 8 { at_extern_sig(ob, p, src, it) }
        if it.kind == 4 or it.kind == 5 {
            // struct/record/union/enum sigs are just `<kind> <name>` (no `pub` prefix).
            string_push(ob, ks)
            string_push(ob, " ")
            string_push(ob, src[it.x as usize .. it.y as usize])
        }
        string_push(ob, "\n")
        if it.kind == 3 { at_guarantees(ob, p, src, it, a) }
        i = i + 1
    }
}

// ---- `jc <file> doc` — the documentation generator ----
//
// Mirrors `src/doc.rs`. Three stages: group the raw `///` / `/** */` trivia into BLOCKS
// (consecutive line docs merge; each block comment stands alone), collect the documentable
// TARGETS from the AST — reusing the `at_*` signature and guarantee renderers attest uses, so
// the prose and the proven facts can never drift apart — then attach each block to the item it
// sits above and render Markdown. The design rule the output enforces: a `///` line is PROSE,
// an `ensures` clause is a GUARANTEE the compiler proved; they are rendered side by side and
// labelled, never mixed.

// `doc::struct_sig` — the surface form, one field per line. NOTE the reference prints the word
// `struct` for a `record`/`union` too (it does not re-derive the keyword), and shows only
// fields, never methods.
fn at_struct_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    string_push(sb, "struct ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    var cnt: i32 = 0
    var m: i32 = 0
    for m < it.b {
        if list.get(i32, p.mar, (it.a + m * 10) as usize) == 0 { cnt = cnt + 1 }
        m = m + 1
    }
    if cnt == 0 {
        string_push(sb, " {}")
        return
    }
    string_push(sb, " {\n")
    var done: i32 = 0
    var k: i32 = 0
    for k < it.b {
        let base: i32 = it.a + k * 10
        if list.get(i32, p.mar, base as usize) == 0 {          // tag 0 = a field
            if done > 0 { string_push(sb, ",\n") }
            string_push(sb, "    ")
            string_push(sb, src[list.get(i32, p.mar, (base + 2) as usize) as usize .. list.get(i32, p.mar, (base + 3) as usize) as usize])
            string_push(sb, ": ")
            if field_has_attr(p, src, base, "volatile") { string_push(sb, "@volatile ") }
            at_ty(sb, p, src, list.get(i32, p.mar, (base + 4) as usize))
            done = done + 1
        }
        k = k + 1
    }
    string_push(sb, "\n}")
}

// `doc::enum_sig` — one variant per line, each with its named payload fields.
fn at_enum_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.is_pub != 0 { string_push(sb, "pub ") }
    string_push(sb, "enum ")
    string_push(sb, src[it.x as usize .. it.y as usize])
    if it.z == 0 {
        string_push(sb, " {}")
        return
    }
    string_push(sb, " {\n")
    var k: i32 = 0
    for k < it.z {
        if k > 0 { string_push(sb, ",\n") }
        let vb: i32 = it.b + k * 5
        string_push(sb, "    ")
        string_push(sb, src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize])
        let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
        if fc > 0 {
            let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
            string_push(sb, "(")
            var f: i32 = 0
            for f < fc {
                if f > 0 { string_push(sb, ", ") }
                let fb: i32 = fs + f * 3
                string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                string_push(sb, ": ")
                at_ty(sb, p, src, list.get(i32, p.ear, (fb + 2) as usize))
                f = f + 1
            }
            string_push(sb, ")")
        }
        k = k + 1
    }
    string_push(sb, "\n}")
}

// ASCII whitespace (the reference trims `char::is_whitespace`; doc prose outside the ASCII
// range would differ, which no corpus file exercises).
fn dc_is_ws(c: i32) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    if c == 11 { return true }
    if c == 12 { return true }
    return false
}
// The end offset of `s` with trailing whitespace removed (`trim_end`).
fn dc_tend(read s: str) -> usize {
    var e: usize = s.len
    for e > 0 {
        if !dc_is_ws(s[e - 1] as i32) { break }
        e = e - 1
    }
    return e
}
// The start offset of `s` with leading whitespace removed (`trim_start`).
fn dc_tstart(read s: str) -> usize {
    var b: usize = 0
    for b < s.len {
        if !dc_is_ws(s[b] as i32) { break }
        b = b + 1
    }
    return b
}
fn dc_blank(read s: str) -> bool { return dc_tstart(s) >= dc_tend(s) }

// Cleaned doc text. `buf` holds the content lines back to back and `ln` their (start, end)
// spans; `bl` carries one 4-tuple per block — [line_start, line_count, span_start, span_end],
// the spans being SOURCE offsets, which is what decides the item a block sits above.
struct Db { buf: String, ln: List(i32), bl: List(i32) }

fn db_line(mut d: Db, read s: str) {
    let s0: i32 = sb_len(d.buf)
    string_push(d.buf, s)
    list.push(i32, d.ln, s0)
    list.push(i32, d.ln, sb_len(d.buf))
}

// Append `rd`'s content lines with markers and margins stripped (`clean_lines`), returning how
// many were added. A line doc yields exactly one; a block doc yields one per source line,
// honouring a Javadoc `*` margin — otherwise the line is kept verbatim so indented example
// code survives — with leading and trailing blank lines dropped.
fn db_clean(mut d: Db, read src: str, read rd: tokens.RawDoc, read a: Allocator) -> i32 {
    let text: str = src[rd.ts .. rd.te]
    if !rd.block {
        let e: usize = dc_tend(text)
        var b: usize = 0
        if e > 0 {
            if (text[0] as i32) == 32 { b = 1 }                // strip_one_space
        }
        db_line(d, text[b .. e])
        return 1
    }
    var t: Db = Db{ buf: string_new(), ln: list.make(i32, a), bl: list.make(i32, a) }
    var ls: usize = 0
    for ls <= text.len {
        var le: usize = ls
        for le < text.len {
            if (text[le] as i32) == 10 { break }
            le = le + 1
        }
        let line: str = text[ls .. le]
        let e2: usize = dc_tend(line)
        let b2: usize = dc_tstart(line)
        var margin: bool = false
        if b2 < e2 {
            if (line[b2] as i32) == 42 {                       // a `*` margin
                var rb: usize = b2 + 1
                if rb < e2 {
                    if (line[rb] as i32) == 32 { rb = rb + 1 }
                }
                db_line(t, line[rb .. e2])
                margin = true
            }
        }
        if !margin { db_line(t, line[0 .. e2]) }
        if le >= text.len { break }
        ls = le + 1
    }
    let tv: str = string_view(t.buf)
    var first: usize = 0
    var last: usize = list.len(i32, t.ln) / 2
    for first < last {
        if !dc_blank(tv[list.get(i32, t.ln, first * 2) as usize .. list.get(i32, t.ln, first * 2 + 1) as usize]) { break }
        first = first + 1
    }
    for last > first {
        if !dc_blank(tv[list.get(i32, t.ln, (last - 1) * 2) as usize .. list.get(i32, t.ln, (last - 1) * 2 + 1) as usize]) { break }
        last = last - 1
    }
    var i: usize = first
    for i < last {
        db_line(d, tv[list.get(i32, t.ln, i * 2) as usize .. list.get(i32, t.ln, i * 2 + 1) as usize])
        i = i + 1
    }
    string_free(t.buf)
    return (last - first) as i32
}

// Two line docs belong to one block when only whitespace — and at most one newline —
// separates them, so a blank line starts a fresh block (`contiguous`).
fn dc_contiguous(read src: str, lo: usize, hi: usize) -> bool {
    if hi < lo { return false }
    var nl: i32 = 0
    var i: usize = lo
    for i < hi {
        let c: i32 = src[i] as i32
        if !dc_is_ws(c) { return false }
        if c == 10 { nl = nl + 1 }
        i = i + 1
    }
    return nl <= 1
}

fn db_push_block(mut d: Db, lstart: i32, lcount: i32, ss: i32, se: i32) {
    list.push(i32, d.bl, lstart)
    list.push(i32, d.bl, lcount)
    list.push(i32, d.bl, ss)
    list.push(i32, d.bl, se)
}

// Group the doc comments of one kind (0 = outer, 1 = inner) into blocks, in source order
// (`doc::group`).
fn db_group(mut d: Db, read src: str, read docs: List(tokens.RawDoc), want: i32, read a: Allocator) {
    var open: bool = false
    var lstart: i32 = 0
    var lcount: i32 = 0
    var ss: i32 = 0
    var se: i32 = 0
    var i: usize = 0
    for i < list.len(tokens.RawDoc, docs) {
        let rd: tokens.RawDoc = list.get(tokens.RawDoc, docs, i)
        if rd.kind == want {
            if rd.block {
                if open {
                    db_push_block(d, lstart, lcount, ss, se)
                    open = false
                }
                let s0: i32 = (list.len(i32, d.ln) / 2) as i32
                let k: i32 = db_clean(d, src, rd, a)
                db_push_block(d, s0, k, rd.ss as i32, rd.se as i32)
            } else {
                var merge: bool = false
                if open {
                    if dc_contiguous(src, se as usize, rd.ss) { merge = true }
                }
                if merge {
                    lcount = lcount + db_clean(d, src, rd, a)
                    se = rd.se as i32
                } else {
                    if open { db_push_block(d, lstart, lcount, ss, se) }
                    lstart = (list.len(i32, d.ln) / 2) as i32
                    lcount = db_clean(d, src, rd, a)
                    ss = rd.ss as i32
                    se = rd.se as i32
                    open = true
                }
            }
        }
        i = i + 1
    }
    if open { db_push_block(d, lstart, lcount, ss, se) }
}

// Documentable targets (`doc::collect_targets`). `tg` holds one 11-tuple per target:
// [span_start, kind, name_s, name_e, sig_s, sig_e, parent_s, parent_e, docblk, g_start,
// g_count] — `kind` 0 fn, 1 extern, 2 enum, 3 const, 4 struct, 5 method, 6 distinct, 7 trait;
// `sig_*` index `sigbuf`; `parent_*` is the owning struct's NAME span (-1 for a top-level
// item, matching the reference's by-name method grouping); `docblk` the attached outer block
// (-1 for none); `g_*` slice `gsp`, whose pairs span `gbuf`.
struct Tg { sigbuf: String, gbuf: String, tg: List(i32), gsp: List(i32) }

fn tg_push(mut t: Tg, start: i32, kind: i32, ns: i32, ne: i32, ss: i32, se: i32, ps: i32, pe: i32, g0: i32, gc: i32) {
    list.push(i32, t.tg, start)
    list.push(i32, t.tg, kind)
    list.push(i32, t.tg, ns)
    list.push(i32, t.tg, ne)
    list.push(i32, t.tg, ss)
    list.push(i32, t.tg, se)
    list.push(i32, t.tg, ps)
    list.push(i32, t.tg, pe)
    list.push(i32, t.tg, 0 - 1)                                // docblk, filled by the attach pass
    list.push(i32, t.tg, g0)
    list.push(i32, t.tg, gc)
}

// A fn or struct-method target: the reconstructed signature plus the proven guarantees.
fn tg_add_fn(mut t: Tg, read p: parser.Parser, read src: str, read it: parser.ItemData, kind: i32, ps: i32, pe: i32) {
    let s0: i32 = sb_len(t.sigbuf)
    at_fn_sig(t.sigbuf, p, src, it)
    let s1: i32 = sb_len(t.sigbuf)
    let g0: i32 = (list.len(i32, t.gsp) / 2) as i32
    at_guarantee_phrases(t.gbuf, t.gsp, p, src, it)
    let g1: i32 = (list.len(i32, t.gsp) / 2) as i32
    tg_push(t, it.start as i32, kind, it.x, it.y, s0, s1, ps, pe, g0, g1 - g0)
}

fn dc_targets(mut t: Tg, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r as usize)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            tg_add_fn(t, p, src, it, 0, 0 - 1, 0 - 1)
        } else if it.kind == 8 {
            let s0: i32 = sb_len(t.sigbuf)
            at_extern_sig(t.sigbuf, p, src, it)
            tg_push(t, it.start as i32, 1, it.x, it.y, s0, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
        } else if it.kind == 5 {
            let s1: i32 = sb_len(t.sigbuf)
            at_enum_sig(t.sigbuf, p, src, it)
            tg_push(t, it.start as i32, 2, it.x, it.y, s1, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
        } else if it.kind == 2 {
            let s2: i32 = sb_len(t.sigbuf)
            at_const_sig(t.sigbuf, p, src, it)
            tg_push(t, it.start as i32, 3, it.x, it.y, s2, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
        } else if it.kind == 4 {
            let s3: i32 = sb_len(t.sigbuf)
            at_struct_sig(t.sigbuf, p, src, it)
            tg_push(t, it.start as i32, 4, it.x, it.y, s3, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
            var m: i32 = 0
            for m < it.b {
                let base: i32 = it.a + m * 10
                if list.get(i32, p.mar, base as usize) == 1 {  // tag 1 = a method
                    let mid: i32 = list.get(i32, p.mar, (base + 1) as usize)
                    let mi: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
                    tg_add_fn(t, p, src, mi, 5, it.x, it.y)
                }
                m = m + 1
            }
        } else if it.kind == 1 {
            let s4: i32 = sb_len(t.sigbuf)
            if it.is_pub != 0 { string_push(t.sigbuf, "pub ") }
            string_push(t.sigbuf, "distinct ")
            string_push(t.sigbuf, src[it.x as usize .. it.y as usize])
            string_push(t.sigbuf, " = ")
            at_ty(t.sigbuf, p, src, it.a)
            tg_push(t, it.start as i32, 6, it.x, it.y, s4, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
        } else if it.kind == 6 {
            let s5: i32 = sb_len(t.sigbuf)
            if it.is_pub != 0 { string_push(t.sigbuf, "pub ") }
            string_push(t.sigbuf, "trait ")
            string_push(t.sigbuf, src[it.x as usize .. it.y as usize])
            tg_push(t, it.start as i32, 7, it.x, it.y, s5, sb_len(t.sigbuf), 0 - 1, 0 - 1, 0, 0)
        }
        r = r + 1
    }
}

// A parsed doc comment (`ParsedDoc`): `sum` holds the lead summary's line spans and `sec` one
// 4-tuple per `#`-headed section — [head_s, head_e into `hbuf`, line_start, line_count into
// `sln`]. Fenced examples are extracted by the reference for future doctests but never
// rendered, so they are not modelled here; the fence STATE is, because a `#` inside a fence
// must not open a section.
struct Pd { sum: List(i32), hbuf: String, sec: List(i32), sln: List(i32) }

// An ATX heading (`# Title` … `###### Title`): a `#` run of 1–6, a space, then non-empty text.
// Appends the title to `hbuf` and returns true.
fn dc_heading(mut hbuf: String, read t2: str) -> bool {
    var h: usize = 0
    for h < t2.len {
        if (t2[h] as i32) != 35 { break }
        h = h + 1
    }
    if h < 1 { return false }
    if h > 6 { return false }
    if h >= t2.len { return false }
    if (t2[h] as i32) != 32 { return false }
    let rest: str = t2[h .. t2.len]
    let b: usize = dc_tstart(rest)
    let e: usize = dc_tend(rest)
    if b >= e { return false }
    string_push(hbuf, rest[b .. e])
    return true
}

fn pd_push_line(mut d: Pd, cur: i32, s: i32, e: i32) {
    if cur < 0 {
        list.push(i32, d.sum, s)
        list.push(i32, d.sum, e)
    } else {
        list.push(i32, d.sln, s)
        list.push(i32, d.sln, e)
        list.set(i32, d.sec, (cur * 4 + 3) as usize, list.get(i32, d.sec, (cur * 4 + 3) as usize) + 1)
    }
}

// Drop leading and trailing blank lines from a span-pair list (`trim_blank`).
fn pd_trim(mut v: List(i32), read buf: str, from: usize, upto: usize) -> i32 {
    var first: usize = from
    var last: usize = upto
    for first < last {
        if !dc_blank(buf[list.get(i32, v, first * 2) as usize .. list.get(i32, v, first * 2 + 1) as usize]) { break }
        first = first + 1
    }
    for last > first {
        if !dc_blank(buf[list.get(i32, v, (last - 1) * 2) as usize .. list.get(i32, v, (last - 1) * 2 + 1) as usize]) { break }
        last = last - 1
    }
    // Compact the surviving range down to `from` so the caller's slice stays contiguous.
    var w: usize = from
    var i: usize = first
    for i < last {
        list.set(i32, v, w * 2, list.get(i32, v, i * 2))
        list.set(i32, v, w * 2 + 1, list.get(i32, v, i * 2 + 1))
        w = w + 1
        i = i + 1
    }
    return (w - from) as i32
}

// Parse one block's lines into a summary plus `#`-headed sections (`parse_doc`).
fn dc_parse_doc(mut d: Pd, read dbuf: str, read ln: List(i32), lstart: i32, lcount: i32) {
    var cur: i32 = 0 - 1
    var fence: bool = false
    var i: i32 = 0
    for i < lcount {
        let s: i32 = list.get(i32, ln, ((lstart + i) * 2) as usize)
        let e: i32 = list.get(i32, ln, ((lstart + i) * 2 + 1) as usize)
        let line: str = dbuf[s as usize .. e as usize]
        let b: usize = dc_tstart(line)
        let tl: str = line[b .. line.len]
        if starts_with(tl, "```") {
            if fence { fence = false } else { fence = true }
            pd_push_line(d, cur, s, e)
        } else if fence {
            pd_push_line(d, cur, s, e)
        } else {
            let h0: i32 = sb_len(d.hbuf)
            if dc_heading(d.hbuf, tl) {
                list.push(i32, d.sec, h0)
                list.push(i32, d.sec, sb_len(d.hbuf))
                list.push(i32, d.sec, (list.len(i32, d.sln) / 2) as i32)
                list.push(i32, d.sec, 0)
                cur = ((list.len(i32, d.sec) / 4) - 1) as i32
            } else {
                pd_push_line(d, cur, s, e)
            }
        }
        i = i + 1
    }
    let n: i32 = pd_trim(d.sum, dbuf, 0, list.len(i32, d.sum) / 2)
    list.truncate(i32, d.sum, (n * 2) as usize)
    var k: i32 = 0
    for k < (list.len(i32, d.sec) / 4) as i32 {
        let ls2: i32 = list.get(i32, d.sec, (k * 4 + 2) as usize)
        let lc2: i32 = list.get(i32, d.sec, (k * 4 + 3) as usize)
        // Sections are filled in order, so trimming one only shifts its own tail: rewrite the
        // count and pull the following sections' starts back by the same amount.
        let kept: i32 = pd_trim(d.sln, dbuf, ls2 as usize, (ls2 + lc2) as usize)
        list.set(i32, d.sec, (k * 4 + 3) as usize, kept)
        let drop2: i32 = lc2 - kept
        if drop2 > 0 {
            var j: usize = ((ls2 + kept) * 2) as usize
            let end2: usize = list.len(i32, d.sln)
            for j + (drop2 * 2) as usize < end2 {
                list.set(i32, d.sln, j, list.get(i32, d.sln, j + (drop2 * 2) as usize))
                j = j + 1
            }
            list.truncate(i32, d.sln, end2 - (drop2 * 2) as usize)
            var q: i32 = k + 1
            for q < (list.len(i32, d.sec) / 4) as i32 {
                list.set(i32, d.sec, (q * 4 + 2) as usize, list.get(i32, d.sec, (q * 4 + 2) as usize) - drop2)
                q = q + 1
            }
        }
        k = k + 1
    }
}

// Render a parsed doc's prose (`emit_doc_md`): the summary, then each section's bold heading
// and lines, every group joined by newlines and closed by a blank line.
fn dc_emit_doc(mut sb: String, read d: Pd, read dbuf: str) {
    let sn: usize = list.len(i32, d.sum) / 2
    if sn > 0 {
        var i: usize = 0
        for i < sn {
            if i > 0 { string_push(sb, "\n") }
            string_push(sb, dbuf[list.get(i32, d.sum, i * 2) as usize .. list.get(i32, d.sum, i * 2 + 1) as usize])
            i = i + 1
        }
        string_push(sb, "\n\n")
    }
    let hv: str = string_view(d.hbuf)
    var k: usize = 0
    for k < list.len(i32, d.sec) / 4 {
        string_push(sb, "**")
        string_push(sb, hv[list.get(i32, d.sec, k * 4) as usize .. list.get(i32, d.sec, k * 4 + 1) as usize])
        string_push(sb, "**\n\n")
        let ls2: i32 = list.get(i32, d.sec, k * 4 + 2)
        let lc2: i32 = list.get(i32, d.sec, k * 4 + 3)
        if lc2 > 0 {
            var j: i32 = 0
            for j < lc2 {
                if j > 0 { string_push(sb, "\n") }
                string_push(sb, dbuf[list.get(i32, d.sln, ((ls2 + j) * 2) as usize) as usize .. list.get(i32, d.sln, ((ls2 + j) * 2 + 1) as usize) as usize])
                j = j + 1
            }
            string_push(sb, "\n\n")
        }
        k = k + 1
    }
}

// One target's Markdown (`emit_target_md`): the `#`-level name, its fenced signature, the
// prose, then the Guarantees block — labelled so proven facts are never mistaken for prose.
fn dc_emit_target(mut sb: String, read t: Tg, tb: i32, level: i32, read src: str, read d: Db, read a: Allocator) {
    var h: i32 = 0
    for h < level {
        string_push(sb, "#")
        h = h + 1
    }
    string_push(sb, " `")
    string_push(sb, src[list.get(i32, t.tg, (tb + 2) as usize) as usize .. list.get(i32, t.tg, (tb + 3) as usize) as usize])
    string_push(sb, "`\n\n```jestyr\n")
    let sv: str = string_view(t.sigbuf)
    string_push(sb, sv[list.get(i32, t.tg, (tb + 4) as usize) as usize .. list.get(i32, t.tg, (tb + 5) as usize) as usize])
    string_push(sb, "\n```\n\n")
    let blk: i32 = list.get(i32, t.tg, (tb + 8) as usize)
    if blk >= 0 {
        var pd: Pd = Pd{ sum: list.make(i32, a), hbuf: string_new(), sec: list.make(i32, a), sln: list.make(i32, a) }
        dc_parse_doc(pd, string_view(d.buf), d.ln, list.get(i32, d.bl, (blk * 4) as usize), list.get(i32, d.bl, (blk * 4 + 1) as usize))
        dc_emit_doc(sb, pd, string_view(d.buf))
        string_free(pd.hbuf)
    }
    let gc: i32 = list.get(i32, t.tg, (tb + 10) as usize)
    if gc > 0 {
        string_push(sb, "**Guarantees** *(checked by the compiler)*\n\n")
        let g0: i32 = list.get(i32, t.tg, (tb + 9) as usize)
        let gv: str = string_view(t.gbuf)
        var j: i32 = 0
        for j < gc {
            string_push(sb, "- ")
            string_push(sb, gv[list.get(i32, t.gsp, ((g0 + j) * 2) as usize) as usize .. list.get(i32, t.gsp, ((g0 + j) * 2 + 1) as usize) as usize])
            string_push(sb, "\n")
            j = j + 1
        }
        string_push(sb, "\n")
    }
}

// Generate the Markdown page for `src` (`doc::generate` + `render_markdown`). Dangling outer
// docs — a `///` attached to nothing — are reported on stderr as the lightweight lint the
// reference also emits; the page itself still renders.
fn dc_generate(mut sb: String, read p: parser.Parser, read src: str, read docs: List(tokens.RawDoc), read title: str, read path: str, read a: Allocator) {
    var outer: Db = Db{ buf: string_new(), ln: list.make(i32, a), bl: list.make(i32, a) }
    var inner: Db = Db{ buf: string_new(), ln: list.make(i32, a), bl: list.make(i32, a) }
    db_group(outer, src, docs, 0, a)
    db_group(inner, src, docs, 1, a)

    var t: Tg = Tg{ sigbuf: string_new(), gbuf: string_new(), tg: list.make(i32, a), gsp: list.make(i32, a) }
    dc_targets(t, p, src)
    let tn: usize = list.len(i32, t.tg) / 11
    // Targets in source order (`sort_by_key(span.start)`); collection is already ascending, so
    // this insertion sort is normally a no-op — it keeps the order guaranteed, not assumed.
    var i: usize = 1
    for i < tn {
        var j: usize = i
        for j > 0 {
            if list.get(i32, t.tg, (j * 11) as usize) >= list.get(i32, t.tg, ((j - 1) * 11) as usize) { break }
            var f: usize = 0
            for f < 11 {
                let tmp: i32 = list.get(i32, t.tg, j * 11 + f)
                list.set(i32, t.tg, j * 11 + f, list.get(i32, t.tg, (j - 1) * 11 + f))
                list.set(i32, t.tg, (j - 1) * 11 + f, tmp)
                f = f + 1
            }
            j = j - 1
        }
        i = i + 1
    }

    // Attach each outer block to the first target beginning at or after the block's end. When
    // several land on one target the nearest (largest end) wins — and since blocks come in
    // source order, that is simply the last one to claim it; the displaced ones dangle.
    var dangle: List(i32) = list.make(i32, a)
    var bi: usize = 0
    for bi < list.len(i32, outer.bl) / 4 {
        let bend: i32 = list.get(i32, outer.bl, bi * 4 + 3)
        var hit: i32 = 0 - 1
        var k: usize = 0
        for k < tn {
            if list.get(i32, t.tg, (k * 11) as usize) >= bend {
                hit = k as i32
                break
            }
            k = k + 1
        }
        if hit < 0 {
            list.push(i32, dangle, bi as i32)
        } else {
            let prev: i32 = list.get(i32, t.tg, (hit * 11 + 8) as usize)
            if prev >= 0 { list.push(i32, dangle, prev) }
            list.set(i32, t.tg, (hit * 11 + 8) as usize, bi as i32)
        }
        bi = bi + 1
    }

    string_push(sb, "# ")
    string_push(sb, title)
    string_push(sb, "\n\n*Generated by `jestyrc doc`. Signatures and the **Guarantees** blocks are extracted from the source and machine-checked; prose comes from `///` doc comments.*\n\n")

    // The module doc is every inner block, joined by a blank line.
    if list.len(i32, inner.bl) > 0 {
        var mln: List(i32) = list.make(i32, a)
        var q: usize = 0
        for q < list.len(i32, inner.bl) / 4 {
            if q > 0 {
                let z: i32 = sb_len(inner.buf)                 // a blank separator line
                list.push(i32, mln, z)
                list.push(i32, mln, z)
            }
            let ls3: i32 = list.get(i32, inner.bl, q * 4)
            let lc3: i32 = list.get(i32, inner.bl, q * 4 + 1)
            var w: i32 = 0
            for w < lc3 {
                list.push(i32, mln, list.get(i32, inner.ln, ((ls3 + w) * 2) as usize))
                list.push(i32, mln, list.get(i32, inner.ln, ((ls3 + w) * 2 + 1) as usize))
                w = w + 1
            }
            q = q + 1
        }
        var mpd: Pd = Pd{ sum: list.make(i32, a), hbuf: string_new(), sec: list.make(i32, a), sln: list.make(i32, a) }
        dc_parse_doc(mpd, string_view(inner.buf), mln, 0, (list.len(i32, mln) / 2) as i32)
        dc_emit_doc(sb, mpd, string_view(inner.buf))
        string_free(mpd.hbuf)
        string_push(sb, "\n---\n\n")
    }

    var tops: i32 = 0
    var c0: usize = 0
    for c0 < tn {
        if list.get(i32, t.tg, (c0 * 11 + 6) as usize) < 0 { tops = tops + 1 }
        c0 = c0 + 1
    }
    if tops == 0 {
        string_push(sb, "*(No documentable items.)*\n")
        dc_warn_dangling(outer, dangle, src, path)
        return
    }
    string_push(sb, "## API\n\n")
    var r: usize = 0
    for r < tn {
        let tb: i32 = (r * 11) as i32
        if list.get(i32, t.tg, (tb + 6) as usize) < 0 {
            dc_emit_target(sb, t, tb, 3, src, outer, a)
            if list.get(i32, t.tg, (tb + 1) as usize) == 4 {   // a struct: gather its methods
                let nm: str = src[list.get(i32, t.tg, (tb + 2) as usize) as usize .. list.get(i32, t.tg, (tb + 3) as usize) as usize]
                var any: bool = false
                var m2: usize = 0
                for m2 < tn {
                    let mb: i32 = (m2 * 11) as i32
                    let ps: i32 = list.get(i32, t.tg, (mb + 6) as usize)
                    if ps >= 0 {
                        if str_eq(src[ps as usize .. list.get(i32, t.tg, (mb + 7) as usize) as usize], nm) { any = true }
                    }
                    m2 = m2 + 1
                }
                if any {
                    string_push(sb, "#### Methods of `")
                    string_push(sb, nm)
                    string_push(sb, "`\n\n")
                    var m3: usize = 0
                    for m3 < tn {
                        let mb2: i32 = (m3 * 11) as i32
                        let ps2: i32 = list.get(i32, t.tg, (mb2 + 6) as usize)
                        if ps2 >= 0 {
                            if str_eq(src[ps2 as usize .. list.get(i32, t.tg, (mb2 + 7) as usize) as usize], nm) {
                                dc_emit_target(sb, t, mb2, 5, src, outer, a)
                            }
                        }
                        m3 = m3 + 1
                    }
                }
            }
        }
        r = r + 1
    }
    dc_warn_dangling(outer, dangle, src, path)
}

// The dangling-doc lint: a `///` attached to nothing, reported at its own location. Advisory —
// the page still renders and the command still succeeds. (The reference's full diagnostic
// decoration is not reproduced; the message text and location are.)
fn dc_warn_dangling(read outer: Db, mut dangle: List(i32), read src: str, read path: str) {
    var i: usize = 0
    for i < list.len(i32, dangle) {
        var lo: usize = i                                      // selection sort: block order
        var j: usize = i + 1
        for j < list.len(i32, dangle) {
            if list.get(i32, dangle, j) < list.get(i32, dangle, lo) { lo = j }
            j = j + 1
        }
        if lo != i {
            let tmp: i32 = list.get(i32, dangle, i)
            list.set(i32, dangle, i, list.get(i32, dangle, lo))
            list.set(i32, dangle, lo, tmp)
        }
        let bidx: i32 = list.get(i32, dangle, i)
        let start: usize = list.get(i32, outer.bl, (bidx * 4 + 2) as usize) as usize
        var line: i64 = 1
        var col: i64 = 1
        var k: usize = 0
        for k < start {
            if (src[k] as i32) == 10 {
                line = line + 1
                col = 1
            } else {
                col = col + 1
            }
            k = k + 1
        }
        var b: String = string_new()
        string_push(b, path)
        string_push(b, ":")
        push_uint(b, line)
        string_push(b, ":")
        push_uint(b, col)
        string_push(b, ": warning: doc comment (`///`) is not attached to an item")
        eprint_str(string_view(b))
        string_free(b)
        i = i + 1
    }
}

// The full attestation manifest for a checked program (`attest::manifest`): the header —
// version, source id, the SHA-256 of exactly the C `build` would emit, and the locked
// compile command — then the per-item records.
fn at_manifest(mut ob: String, read p: parser.Parser, read c: typeck.Checker, read src: str, read a: Allocator, read srcid: str) {
    var cbuf: String = string_new()
    emit_program(cbuf, p, c, src, a, false, "", list.make(i32, a), list.make(i32, a), "", "")
    string_push(ob, "jestyr-attest/v1\nsource ")
    string_push(ob, srcid)
    string_push(ob, "\nc-sha256 ")
    sha256.push_sha256_hex(ob, string_view(cbuf))
    string_push(ob, "\ncc-flags -O2 -std=c11 -ffp-contract=off -fno-fast-math\n")
    at_records(ob, p, src, a)
    string_free(cbuf)
}

// ---- attest --diff: the sound breaking-change gate, in-language ----
// A manifest parsed back into structured contracts (`attest::ParsedManifest`). The text stays
// owned by the caller; everything here is spans into it. `items` holds a 7-tuple per item —
// [key_s, key_e, is_pub, sig_s, sig_e, g_start, g_count] — whose key is the raw `<kind> <name>`
// line (the stable identity the diff matches on, not the signature), and `g_*` slices `gs`, the
// guarantee-line span pairs. The reference's `BTreeSet`/`BTreeMap` fields are derived on demand
// from those lines (`absorb_guarantee`'s inverse) rather than stored.
struct Am { ok: bool, src_s: i32, src_e: i32, hash_s: i32, hash_e: i32, items: List(i32), gs: List(i32) }

// Parse a manifest's text (`attest::parse_manifest`): line 0 is the format tag, header lines run
// to the first blank, then a non-indented `<kind> <name>` line opens an item block that indented
// lines fill. Unknown lines are ignored (forward compatibility); a first line that isn't the
// format tag clears `ok`, so a non-manifest file fails fast rather than diffing as empty.
fn am_parse(read t: str, read a: Allocator) -> Am {
    var m: Am = Am{ ok: true, src_s: 0, src_e: 0, hash_s: 0, hash_e: 0, items: list.make(i32, a), gs: list.make(i32, a) }
    var phase: i32 = 0                                 // 0 = version line, 1 = header, 2 = items
    var cur: i32 = 0 - 1                               // the open item's tuple base in `items`
    var ls: usize = 0
    for ls < t.len {
        var le: usize = ls                             // the line's `\n` (or end of text)
        for le < t.len {
            if (t[le] as i32) == 10 { break }
            le = le + 1
        }
        var ce: usize = le                             // content end, a trailing `\r` dropped
        if ce > ls {
            if (t[ce - 1] as i32) == 13 { ce = ce - 1 }
        }
        let line: str = t[ls .. ce]
        if phase == 0 {
            if !starts_with(line, "jestyr-attest/") {
                m.ok = false
                return m
            }
            phase = 1
        } else if phase == 1 {
            if line.len == 0 {
                phase = 2
            } else if starts_with(line, "source ") {
                m.src_s = (ls + 7) as i32
                m.src_e = ce as i32
            } else if starts_with(line, "c-sha256 ") {
                m.hash_s = (ls + 9) as i32
                m.hash_e = ce as i32
            }
        } else if line.len == 0 {
            cur = 0 - 1
        } else if starts_with(line, "  ") {
            if cur >= 0 {
                let body: str = t[ls + 2 .. ce]
                if starts_with(body, "vis: ") {
                    if str_eq(trim(t[ls + 7 .. ce]), "pub") { list.set(i32, m.items, (cur + 2) as usize, 1) }
                } else if starts_with(body, "sig: ") {
                    list.set(i32, m.items, (cur + 3) as usize, (ls + 7) as i32)
                    list.set(i32, m.items, (cur + 4) as usize, ce as i32)
                } else if starts_with(body, "guarantee: ") {
                    list.push(i32, m.gs, (ls + 13) as i32)
                    list.push(i32, m.gs, ce as i32)
                    list.set(i32, m.items, (cur + 6) as usize, list.get(i32, m.items, (cur + 6) as usize) + 1)
                }
            }
        } else {
            cur = list.len(i32, m.items) as i32
            list.push(i32, m.items, ls as i32)
            list.push(i32, m.items, ce as i32)
            list.push(i32, m.items, 0)                 // is_pub
            list.push(i32, m.items, 0)                 // sig span (empty until a `sig:` line)
            list.push(i32, m.items, 0)
            list.push(i32, m.items, (list.len(i32, m.gs) / 2) as i32)
            list.push(i32, m.items, 0)                 // guarantee count
        }
        ls = le + 1
    }
    return m
}

// The tuple base of the item keyed `key`, or -1. Scans to the LAST match: the reference keys a
// `BTreeMap` by `<kind> <name>`, so a repeated key overwrites (a well-formed manifest has none).
fn am_find(read m: Am, read t: str, read key: str) -> i32 {
    var found: i32 = 0 - 1
    var i: usize = 0
    for i < list.len(i32, m.items) / 7 {
        let ib: i32 = (i * 7) as i32
        if str_eq(t[list.get(i32, m.items, ib as usize) as usize .. list.get(i32, m.items, (ib + 1) as usize) as usize], key) { found = ib }
        i = i + 1
    }
    return found
}

fn am_g_count(read m: Am, ib: i32) -> i32 { return list.get(i32, m.items, (ib + 6) as usize) }
fn am_g_s(read m: Am, ib: i32, k: i32) -> usize {
    return list.get(i32, m.gs, ((list.get(i32, m.items, (ib + 5) as usize) + k) * 2) as usize) as usize
}
fn am_g_e(read m: Am, ib: i32, k: i32) -> usize {
    return list.get(i32, m.gs, ((list.get(i32, m.items, (ib + 5) as usize) + k) * 2 + 1) as usize) as usize
}

// Does the item carry the `@no_panic` guarantee?
fn am_np(read t: str, read m: Am, ib: i32) -> bool {
    var k: i32 = 0
    for k < am_g_count(m, ib) {
        if starts_with(t[am_g_s(m, ib, k) .. am_g_e(m, ib, k)], "`@no_panic`") { return true }
        k = k + 1
    }
    return false
}

// Append (start, end) unless an equal element is already present — the `BTreeSet` dedup.
fn am_push_elem(mut dst: List(i32), read t: str, s: usize, e: usize) {
    var i: usize = 0
    for i < list.len(i32, dst) / 2 {
        if str_eq(t[list.get(i32, dst, i * 2) as usize .. list.get(i32, dst, i * 2 + 1) as usize], t[s .. e]) { return }
        i = i + 1
    }
    list.push(i32, dst, s as i32)
    list.push(i32, dst, e as i32)
}

// `` `requires <e>` `` / `` `ensures <e>` `` -> the inner text as an element span
// (`strip_prefix` then `trim_end_matches('`')`).
fn am_take_quoted(mut dst: List(i32), read t: str, gs2: usize, ge: usize, read pfx: str) {
    if !starts_with(t[gs2 .. ge], pfx) { return }
    let s2: usize = gs2 + pfx.len
    var e2: usize = ge
    for e2 > s2 {
        if (t[e2 - 1] as i32) != 96 { break }
        e2 = e2 - 1
    }
    am_push_elem(dst, t, s2, e2)
}

// Collect an item's guarantee-derived set elements as (start, end) span pairs, deduped:
// 0 = `requires`, 1 = `ensures`, 2 = the error set (`may fail with `!{ A, B }``, split on `,`).
// Order is irrelevant — the change list is re-sorted by content at the end, exactly like the
// reference's final `sort_by`.
fn am_elems(mut dst: List(i32), read t: str, read m: Am, ib: i32, cls: i32) {
    var k: i32 = 0
    for k < am_g_count(m, ib) {
        let gs2: usize = am_g_s(m, ib, k)
        let ge: usize = am_g_e(m, ib, k)
        if cls == 0 { am_take_quoted(dst, t, gs2, ge, "`requires ") }
        if cls == 1 { am_take_quoted(dst, t, gs2, ge, "`ensures ") }
        if cls == 2 {
            if starts_with(t[gs2 .. ge], "may fail with `!{ ") {
                let s2: usize = gs2 + 18
                var e2: usize = ge
                for e2 > s2 {
                    if (t[e2 - 1] as i32) != 96 { break }
                    e2 = e2 - 1
                }
                for e2 > s2 {
                    if (t[e2 - 1] as i32) != 125 { break }
                    e2 = e2 - 1
                }
                var b0: usize = s2
                for b0 <= e2 {
                    var b1: usize = b0
                    for b1 < e2 {
                        if (t[b1] as i32) == 44 { break }
                        b1 = b1 + 1
                    }
                    var q0: usize = b0
                    var q1: usize = b1
                    for q0 < q1 {
                        if (t[q0] as i32) != 32 { break }
                        q0 = q0 + 1
                    }
                    for q1 > q0 {
                        if (t[q1 - 1] as i32) != 32 { break }
                        q1 = q1 - 1
                    }
                    if q1 > q0 { am_push_elem(dst, t, q0, q1) }
                    b0 = b1 + 1
                }
            }
        }
        k = k + 1
    }
}

// Is `x` an element of the set `v` (spans into `t`)?
fn am_has(read v: List(i32), read t: str, read x: str) -> bool {
    var i: usize = 0
    for i < list.len(i32, v) / 2 {
        if str_eq(t[list.get(i32, v, i * 2) as usize .. list.get(i32, v, i * 2 + 1) as usize], x) { return true }
        i = i + 1
    }
    return false
}

// An item's refinement map as (name_s, name_e, range_s, range_e) quadruples — the inverse of
// ``parameter `i` is constrained to `0..n``` (`parse_refine_phrase`).
fn am_refines(mut dst: List(i32), read t: str, read m: Am, ib: i32) {
    var k: i32 = 0
    for k < am_g_count(m, ib) {
        let gs2: usize = am_g_s(m, ib, k)
        let ge: usize = am_g_e(m, ib, k)
        if starts_with(t[gs2 .. ge], "parameter `") {
            let ns: usize = gs2 + 11
            var ne: usize = ns
            for ne < ge {
                if (t[ne] as i32) == 96 { break }
                ne = ne + 1
            }
            if ne < ge {
                if starts_with(t[ne .. ge], "` is constrained to `") {
                    let rs: usize = ne + 21
                    if ge > rs {
                        if (t[ge - 1] as i32) == 96 {
                            list.push(i32, dst, ns as i32)
                            list.push(i32, dst, ne as i32)
                            list.push(i32, dst, rs as i32)
                            list.push(i32, dst, (ge - 1) as i32)
                        }
                    }
                }
            }
        }
        k = k + 1
    }
}

// The quad base of the refinement for param `name`, or -1 (LAST match — map overwrite).
fn am_ref_find(read rf: List(i32), read t: str, read name: str) -> i32 {
    var found: i32 = 0 - 1
    var i: usize = 0
    for i < list.len(i32, rf) / 4 {
        let qb: i32 = (i * 4) as i32
        if str_eq(t[list.get(i32, rf, qb as usize) as usize .. list.get(i32, rf, (qb + 1) as usize) as usize], name) { found = qb }
        i = i + 1
    }
    return found
}

// Copy `hay` into `dst` with every occurrence of `needle` dropped (`str::replace(n, "")`).
fn push_without(mut dst: String, read hay: str, read needle: str) {
    if needle.len == 0 {
        string_push(dst, hay)
        return
    }
    var i: usize = 0
    for i < hay.len {
        var hit: bool = false
        if i + needle.len <= hay.len {
            if str_eq(hay[i .. i + needle.len], needle) { hit = true }
        }
        if hit {
            i = i + needle.len
        } else {
            string_push(dst, hay[i .. i + 1])
            i = i + 1
        }
    }
}

// Copy `hay` into `dst` with every occurrence of ANY needle (spans into `nb`) dropped. One
// left-to-right pass stands in for the reference's per-needle `replace` passes: the needles are
// the distinct ` in <range>` clauses of one signature, so the results agree.
fn push_without_any(mut dst: String, read hay: str, read nb: str, read spans: List(i32)) {
    var i: usize = 0
    for i < hay.len {
        var skip: usize = 0
        var q: usize = 0
        for q < list.len(i32, spans) / 2 {
            let ns: usize = list.get(i32, spans, q * 2) as usize
            let ne: usize = list.get(i32, spans, q * 2 + 1) as usize
            if skip == 0 and ne > ns {
                if i + (ne - ns) <= hay.len {
                    if str_eq(hay[i .. i + (ne - ns)], nb[ns .. ne]) { skip = ne - ns }
                }
            }
            q = q + 1
        }
        if skip > 0 {
            i = i + skip
        } else {
            string_push(dst, hay[i .. i + 1])
            i = i + 1
        }
    }
}

// `ParsedItem::sig_core` — the *type* signature only: `@no_panic `, a leading `pub `, the
// ` !{…}` error set, and every ` in <range>` refinement removed, since those are compared
// structurally. What's left is the part a change to which is an unconditional ABI break.
fn am_sig_core(mut dst: String, read t: str, read m: Am, ib: i32, read a: Allocator) {
    let sig: str = t[list.get(i32, m.items, (ib + 3) as usize) as usize .. list.get(i32, m.items, (ib + 4) as usize) as usize]
    var s1: String = string_new()
    push_without(s1, sig, "@no_panic ")
    let v1: str = string_view(s1)
    var b0: usize = 0
    if starts_with(v1, "pub ") { b0 = 4 }
    let base: str = v1[b0 .. v1.len]
    var s2: String = string_new()
    let hit: isize = find(base, " !{")
    var done: bool = false
    if hit >= 0 {
        let tail: str = base[hit as usize .. base.len]
        let rel: isize = find(tail, "}")
        if rel >= 0 {
            string_push(s2, base[0 .. hit as usize])
            string_push(s2, base[(hit as usize) + (rel as usize) + 1 .. base.len])
            done = true
        }
    }
    if !done { string_push(s2, base) }
    var rf: List(i32) = list.make(i32, a)
    am_refines(rf, t, m, ib)
    var nb2: String = string_new()
    var nsp: List(i32) = list.make(i32, a)
    var i: usize = 0
    for i < list.len(i32, rf) / 4 {
        let sofar: i32 = sb_len(nb2)
        string_push(nb2, " in ")
        string_push(nb2, t[list.get(i32, rf, i * 4 + 2) as usize .. list.get(i32, rf, i * 4 + 3) as usize])
        list.push(i32, nsp, sofar)
        list.push(i32, nsp, sb_len(nb2))
        i = i + 1
    }
    var s3: String = string_new()
    push_without_any(s3, string_view(s2), string_view(nb2), nsp)
    string_push(dst, trim(string_view(s3)))
    string_free(s3)
    string_free(nb2)
    string_free(s2)
    string_free(s1)
}

// Record one classified change: the item key, the verdict (0 = breaking, 1 = compatible —
// `Verdict as u8`), and the detail text, all as spans into the change buffer `cb`.
fn am_change(mut cb: String, mut cl: List(i32), read item: str, breaking: bool, read detail: str) {
    let s0: i32 = sb_len(cb)
    string_push(cb, item)
    let s1: i32 = sb_len(cb)
    string_push(cb, detail)
    let s2: i32 = sb_len(cb)
    list.push(i32, cl, s0)
    list.push(i32, cl, s1)
    if breaking { list.push(i32, cl, 0) } else { list.push(i32, cl, 1) }
    list.push(i32, cl, s1)
    list.push(i32, cl, s2)
}

// One change per element of `av` absent from `bv`, rendered `<pre><element><post>`.
fn am_set_diff(mut cb: String, mut cl: List(i32), read key: str, breaking: bool, read pre: str, read post: str, read at2: str, read av: List(i32), read bt: str, read bv: List(i32)) {
    var q: usize = 0
    for q < list.len(i32, av) / 2 {
        let x: str = at2[list.get(i32, av, q * 2) as usize .. list.get(i32, av, q * 2 + 1) as usize]
        if !am_has(bv, bt, x) {
            var d: String = string_new()
            string_push(d, pre)
            string_push(d, x)
            string_push(d, post)
            am_change(cb, cl, key, breaking, string_view(d))
            string_free(d)
        }
        q = q + 1
    }
}

// `lo..hi` / `lo..=hi` over integer literals, or `ok = false` for anything non-literal — so the
// caller stays conservative (`parse_int_range`).
struct Rg { ok: bool, lo: i64, hi: i64, inc: bool }
// One parsed integer (`str::parse::<i64>`): `ok` false for an empty or non-digit string.
struct Iv { ok: bool, v: i64 }

fn am_int(read s: str) -> Iv {
    var i: usize = 0
    var neg: bool = false
    if s.len == 0 { return Iv{ ok: false, v: 0 } }
    if (s[0] as i32) == 45 {
        neg = true
        i = 1
    } else if (s[0] as i32) == 43 {
        i = 1
    }
    if i >= s.len { return Iv{ ok: false, v: 0 } }
    var acc: i64 = 0
    for i < s.len {
        let ch: i32 = s[i] as i32
        if ch < 48 { return Iv{ ok: false, v: 0 } }
        if ch > 57 { return Iv{ ok: false, v: 0 } }
        acc = acc * 10 + ((ch - 48) as i64)
        i = i + 1
    }
    if neg { acc = 0 - acc }
    return Iv{ ok: true, v: acc }
}

fn am_range(read s: str) -> Rg {
    var r: Rg = Rg{ ok: false, lo: 0, hi: 0, inc: false }
    var at: isize = find(s, "..=")
    var w: usize = 3
    if at < 0 {
        at = find(s, "..")
        w = 2
    } else {
        r.inc = true
    }
    if at < 0 { return r }
    let lo: Iv = am_int(trim(s[0 .. at as usize]))
    let hi: Iv = am_int(trim(s[(at as usize) + w .. s.len]))
    if !lo.ok or !hi.ok { return r }
    r.lo = lo.v
    r.hi = hi.v
    r.ok = true
    return r
}

// Is `n` a provable *superset* of `o` — both integer-literal ranges of the same inclusivity?
// Only then is a refinement change a widening (compatible); anything incomparable is false.
fn am_widened(read o: str, read n: str) -> bool {
    let ro: Rg = am_range(o)
    let rn: Rg = am_range(n)
    if !ro.ok or !rn.ok { return false }
    if ro.inc != rn.inc { return false }
    return rn.lo <= ro.lo and rn.hi >= ro.hi
}

// Classify the changes within one item present in both manifests (`attest::diff_item`), under
// behavioral subtyping: strengthening a precondition or weakening a postcondition breaks.
fn am_diff_item(mut cb: String, mut cl: List(i32), read ot: str, read o: Am, ob: i32, read nt: str, read n: Am, nbs: i32, read key: str, read a: Allocator) {
    // Visibility: leaving the public API is breaking; entering it is compatible.
    let opub: bool = list.get(i32, o.items, (ob + 2) as usize) != 0
    let npub: bool = list.get(i32, n.items, (nbs + 2) as usize) != 0
    if opub and !npub { am_change(cb, cl, key, true, "no longer `pub`") }
    if !opub and npub { am_change(cb, cl, key, false, "now `pub`") }

    // The type signature, with the structurally-compared bits removed.
    var oc: String = string_new()
    var nc: String = string_new()
    am_sig_core(oc, ot, o, ob, a)
    am_sig_core(nc, nt, n, nbs, a)
    let ocv: str = string_view(oc)
    let ncv: str = string_view(nc)
    if !str_eq(ocv, ncv) {
        var d: String = string_new()
        string_push(d, "signature changed: `")
        string_push(d, ocv)
        string_push(d, "` → `")
        string_push(d, ncv)
        string_push(d, "`")
        am_change(cb, cl, key, true, string_view(d))
        string_free(d)
    }

    // `@no_panic` is a postcondition: losing it is breaking, gaining it compatible.
    let onp: bool = am_np(ot, o, ob)
    let nnp: bool = am_np(nt, n, nbs)
    if onp and !nnp { am_change(cb, cl, key, true, "lost `@no_panic`") }
    if !onp and nnp { am_change(cb, cl, key, false, "gained `@no_panic`") }

    // Error set: a new error a caller must handle is breaking; a removed one frees them.
    var oe: List(i32) = list.make(i32, a)
    var nev: List(i32) = list.make(i32, a)
    am_elems(oe, ot, o, ob, 2)
    am_elems(nev, nt, n, nbs, 2)
    am_set_diff(cb, cl, key, true, "error added `", "`", nt, nev, ot, oe)
    am_set_diff(cb, cl, key, false, "error removed `", "`", ot, oe, nt, nev)

    // Precondition `requires`: a new demand on the caller is breaking; dropping one frees them.
    var orq: List(i32) = list.make(i32, a)
    var nrq: List(i32) = list.make(i32, a)
    am_elems(orq, ot, o, ob, 0)
    am_elems(nrq, nt, n, nbs, 0)
    am_set_diff(cb, cl, key, true, "`requires ", "` added", nt, nrq, ot, orq)
    am_set_diff(cb, cl, key, false, "`requires ", "` removed", ot, orq, nt, nrq)

    // Postcondition `ensures`: a new promise is compatible; dropping one a caller relied on breaks.
    var oen: List(i32) = list.make(i32, a)
    var nen: List(i32) = list.make(i32, a)
    am_elems(oen, ot, o, ob, 1)
    am_elems(nen, nt, n, nbs, 1)
    am_set_diff(cb, cl, key, false, "`ensures ", "` added", nt, nen, ot, oen)
    am_set_diff(cb, cl, key, true, "`ensures ", "` removed", ot, oen, nt, nen)

    // Refinements: narrowing a param's accepted set strengthens a precondition (breaking);
    // widening it relaxes one (compatible). A change not *provably* a widening is breaking.
    var orf: List(i32) = list.make(i32, a)
    var nrf: List(i32) = list.make(i32, a)
    am_refines(orf, ot, o, ob)
    am_refines(nrf, nt, n, nbs)
    var i: usize = 0
    for i < list.len(i32, orf) / 4 {
        let qb: i32 = (i * 4) as i32
        let pn: str = ot[list.get(i32, orf, qb as usize) as usize .. list.get(i32, orf, (qb + 1) as usize) as usize]
        if am_ref_find(orf, ot, pn) == qb {
            let ro: str = ot[list.get(i32, orf, (qb + 2) as usize) as usize .. list.get(i32, orf, (qb + 3) as usize) as usize]
            let mb: i32 = am_ref_find(nrf, nt, pn)
            var d: String = string_new()
            if mb < 0 {
                string_push(d, "param `")
                string_push(d, pn)
                string_push(d, "` constraint removed")
                am_change(cb, cl, key, false, string_view(d))
            } else {
                let rn: str = nt[list.get(i32, nrf, (mb + 2) as usize) as usize .. list.get(i32, nrf, (mb + 3) as usize) as usize]
                if !str_eq(ro, rn) {
                    let wide: bool = am_widened(ro, rn)
                    string_push(d, "param `")
                    string_push(d, pn)
                    if wide { string_push(d, "` widened `") } else { string_push(d, "` narrowed `") }
                    string_push(d, ro)
                    string_push(d, "` → `")
                    string_push(d, rn)
                    string_push(d, "`")
                    am_change(cb, cl, key, !wide, string_view(d))
                }
            }
            string_free(d)
        }
        i = i + 1
    }
    var j: usize = 0
    for j < list.len(i32, nrf) / 4 {
        let qb: i32 = (j * 4) as i32
        let pn: str = nt[list.get(i32, nrf, qb as usize) as usize .. list.get(i32, nrf, (qb + 1) as usize) as usize]
        if am_ref_find(nrf, nt, pn) == qb {
            if am_ref_find(orf, ot, pn) < 0 {
                let rn: str = nt[list.get(i32, nrf, (qb + 2) as usize) as usize .. list.get(i32, nrf, (qb + 3) as usize) as usize]
                var d: String = string_new()
                string_push(d, "param `")
                string_push(d, pn)
                string_push(d, "` newly constrained to `")
                string_push(d, rn)
                string_push(d, "`")
                am_change(cb, cl, key, true, string_view(d))
                string_free(d)
            }
        }
        j = j + 1
    }
    string_free(nc)
    string_free(oc)
}

// Order two recorded changes by (item, verdict, detail) — the reference's total, content-based
// sort, so no iteration order leaks into the report.
fn am_chg_lt(read cb: str, read cl: List(i32), i: usize, j: usize) -> bool {
    let ia: str = cb[list.get(i32, cl, i * 5) as usize .. list.get(i32, cl, i * 5 + 1) as usize]
    let ja: str = cb[list.get(i32, cl, j * 5) as usize .. list.get(i32, cl, j * 5 + 1) as usize]
    if !str_eq(ia, ja) { return str_lt(ia, ja) }
    let vi: i32 = list.get(i32, cl, i * 5 + 2)
    let vj: i32 = list.get(i32, cl, j * 5 + 2)
    if vi != vj { return vi < vj }
    let di: str = cb[list.get(i32, cl, i * 5 + 3) as usize .. list.get(i32, cl, i * 5 + 4) as usize]
    let dj: str = cb[list.get(i32, cl, j * 5 + 3) as usize .. list.get(i32, cl, j * 5 + 4) as usize]
    return str_lt(di, dj)
}

// The first 12 hex of a digest, ellipsized when truncated (`attest::short`).
fn am_short(mut dst: String, read h: str) {
    if h.len > 12 {
        string_push(dst, h[0 .. 12])
        string_push(dst, "…")
    } else {
        string_push(dst, h)
    }
}

// Classify every per-item change between two manifests and render the report (`attest::diff` +
// `DiffReport::render`). Returns the breaking count — the CI gate's exit code.
fn am_diff(mut rep: String, read ot: str, read o: Am, read nt: str, read n: Am, read a: Allocator) -> i32 {
    var cb: String = string_new()
    var cl: List(i32) = list.make(i32, a)
    // Old items: matched (classified) or removed (only a public item's removal breaks).
    var i: usize = 0
    for i < list.len(i32, o.items) / 7 {
        let ib: i32 = (i * 7) as i32
        let key: str = ot[list.get(i32, o.items, ib as usize) as usize .. list.get(i32, o.items, (ib + 1) as usize) as usize]
        if am_find(o, ot, key) == ib {
            let mb: i32 = am_find(n, nt, key)
            if mb < 0 {
                if list.get(i32, o.items, (ib + 2) as usize) != 0 {
                    am_change(cb, cl, key, true, "removed (was pub)")
                } else {
                    am_change(cb, cl, key, false, "removed (internal)")
                }
            } else {
                am_diff_item(cb, cl, ot, o, ib, nt, n, mb, key, a)
            }
        }
        i = i + 1
    }
    // New items with no old counterpart: an addition never breaks an existing caller.
    var j: usize = 0
    for j < list.len(i32, n.items) / 7 {
        let jb: i32 = (j * 7) as i32
        let key: str = nt[list.get(i32, n.items, jb as usize) as usize .. list.get(i32, n.items, (jb + 1) as usize) as usize]
        if am_find(n, nt, key) == jb {
            if am_find(o, ot, key) < 0 { am_change(cb, cl, key, false, "added") }
        }
        j = j + 1
    }

    let cbv: str = string_view(cb)
    let cnt: usize = list.len(i32, cl) / 5
    var s: usize = 0
    for s < cnt {
        var lo: usize = s
        var u: usize = s + 1
        for u < cnt {
            if am_chg_lt(cbv, cl, u, lo) { lo = u }
            u = u + 1
        }
        if lo != s {
            var f: usize = 0
            for f < 5 {
                let tmp: i32 = list.get(i32, cl, s * 5 + f)
                list.set(i32, cl, s * 5 + f, list.get(i32, cl, lo * 5 + f))
                list.set(i32, cl, lo * 5 + f, tmp)
                f = f + 1
            }
        }
        s = s + 1
    }

    var breaking: i64 = 0
    var compat: i64 = 0
    var c0: usize = 0
    for c0 < cnt {
        if list.get(i32, cl, c0 * 5 + 2) == 0 { breaking = breaking + 1 } else { compat = compat + 1 }
        c0 = c0 + 1
    }

    string_push(rep, "jestyr-attest diff\nold: ")
    string_push(rep, ot[o.src_s as usize .. o.src_e as usize])
    string_push(rep, " (c-sha256 ")
    am_short(rep, ot[o.hash_s as usize .. o.hash_e as usize])
    string_push(rep, ")\nnew: ")
    string_push(rep, nt[n.src_s as usize .. n.src_e as usize])
    string_push(rep, " (c-sha256 ")
    am_short(rep, nt[n.hash_s as usize .. n.hash_e as usize])
    string_push(rep, ")\n")
    if !str_eq(ot[o.hash_s as usize .. o.hash_e as usize], nt[n.hash_s as usize .. n.hash_e as usize]) {
        string_push(rep, "note: emitted C differs (a rebuild); per-item ABI verdicts below\n")
    }
    string_push(rep, "\n")
    if cnt == 0 {
        string_push(rep, "no API changes\n")
    } else {
        var r0: usize = 0
        for r0 < cnt {
            if list.get(i32, cl, r0 * 5 + 2) == 0 { string_push(rep, "BREAKING  ") } else { string_push(rep, "compatible") }
            string_push(rep, "  ")
            string_push(rep, cbv[list.get(i32, cl, r0 * 5) as usize .. list.get(i32, cl, r0 * 5 + 1) as usize])
            string_push(rep, "  ")
            string_push(rep, cbv[list.get(i32, cl, r0 * 5 + 3) as usize .. list.get(i32, cl, r0 * 5 + 4) as usize])
            string_push(rep, "\n")
            r0 = r0 + 1
        }
        string_push(rep, "\n")
        push_uint(rep, breaking)
        string_push(rep, " breaking, ")
        push_uint(rep, compat)
        string_push(rep, " compatible\n")
    }
    string_free(cb)
    return breaking as i32
}

// Diff two manifest texts and print the report; returns the process exit code (breaking
// changes fail the gate, a compatible-only or empty diff passes).
fn am_run_diff(read ot: str, read nt: str, read opath: str, read npath: str, read a: Allocator) -> i32 {
    var om: Am = am_parse(ot, a)
    var nm: Am = am_parse(nt, a)
    if !om.ok {
        var e1: String = string_new()
        string_push(e1, "error: `")
        string_push(e1, opath)
        string_push(e1, "` is not a valid attest manifest")
        eprint_str(string_view(e1))
        eprint_str("note: pass files produced by `jc <file.jtr> attest`")
        string_free(e1)
        return 1
    }
    if !nm.ok {
        var e2: String = string_new()
        string_push(e2, "error: `")
        string_push(e2, npath)
        string_push(e2, "` is not a valid attest manifest")
        eprint_str(string_view(e2))
        eprint_str("note: pass files produced by `jc <file.jtr> attest`")
        string_free(e2)
        return 1
    }
    var rep: String = string_new()
    let br: i32 = am_diff(rep, ot, om, nt, nm, a)
    let rv: str = string_view(rep)
    if rv.len > 0 { print_str(rv[0 .. rv.len - 1]) }
    string_free(rep)
    if br > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(it)
    if env.argc() > 1 {
        // CLI modes: `<file>` -> normal C; `<file> test [substr]` -> the `jestyrc test`
        // harness C (optionally name-filtered); `<file> list [substr]` -> the runnable
        // `@test`/`@bench` list (`jestyrc test --list`); `<file> build` / `<file> run` ->
        // the gated product driver (compile via gcc; `run` also executes).
        var tmode: bool = false
        var lmode: bool = false
        var bmode: bool = false
        var rmode: bool = false
        var amode: bool = false
        var vmode: bool = false
        var dmode: bool = false
        var gmode: bool = false
        if env.argc() > 2 {
            if str_eq(env.argv(2), "test") { tmode = true }
            if str_eq(env.argv(2), "list") { lmode = true }
            if str_eq(env.argv(2), "build") { bmode = true }
            if str_eq(env.argv(2), "run") { rmode = true }
            if str_eq(env.argv(2), "attest") { amode = true }
            if str_eq(env.argv(2), "attest-verify") { vmode = true }
            if str_eq(env.argv(2), "attest-diff") { dmode = true }
            if str_eq(env.argv(2), "doc") { gmode = true }
        }
        if dmode {
            // `jc <old> attest-diff <new>` — both arguments are MANIFESTS (no source is
            // compiled), mirroring the reference's `jestyrc attest --diff <old> <new>`.
            if env.argc() < 4 {
                eprint_str("error: `attest-diff` needs two manifest files: <old> <new>")
                return 1
            }
            var otx: String = fs.read_text(env.argv(1))
            var ntx: String = fs.read_text(env.argv(3))
            let drc2: i32 = am_run_diff(string_view(otx), string_view(ntx), env.argv(1), env.argv(3), a)
            string_free(ntx)
            string_free(otx)
            return drc2
        }
        if bmode or rmode or amode or vmode {
            // The product modes go through the module loader: the import closure flattens
            // into one single-file program (the loader's own one-translation-unit model),
            // then the ordinary pipeline runs on the merged source. An importless file
            // merges to itself. NOTE: diagnostics currently render against the MERGED
            // buffer (per-file attribution is a follow-up).
            var m: Ml = Ml{ allsrc: string_new(), nb: string_new(), mods: list.make(i32, a), vis: string_new(), seen: string_new(), ren: string_new(), rids: string_new(), nmod: 0, map: list.make(i32, a), err: false }
            var merged: String = ml_flatten(m, env.argv(1), it, kwcount, a)
            let mv: str = string_view(merged)
            if mv.len == 0 {
                string_free(merged)
                return 1
            }
            var p2: parser.Parser = parser.parse_source(mv, it, kwcount, a)
            var c2: typeck.Checker = typeck.check_parsed(p2, mv, a)
            if amode or vmode {
                // `jc <file> attest` — the FULL manifest, byte-equal to the reference
                // `attest::manifest`: the header (version, source, the sha256 of exactly
                // the C `build` would emit, and the locked compile flags) plus the
                // per-item records (kind/name, vis, reconstructed signature, guarantees).
                // `jc <file> attest-verify <manifest>` diffs the RECORDED manifest (old)
                // against that freshly-rendered one (new) — the drift gate.
                var ob: String = string_new()
                at_manifest(ob, p2, c2, mv, a, env.argv(1))
                if amode {
                    // The manifest ends in '\n'; print_str re-adds one, so drop the last byte.
                    let ov: str = string_view(ob)
                    if ov.len > 0 { print_str(ov[0 .. ov.len - 1]) }
                    string_free(ob)
                    string_free(merged)
                    return 0
                }
                if env.argc() < 4 {
                    eprint_str("error: `attest-verify` needs the recorded manifest: <file> attest-verify <manifest>")
                    string_free(ob)
                    string_free(merged)
                    return 1
                }
                var otx2: String = fs.read_text(env.argv(3))
                let vrc: i32 = am_run_diff(string_view(otx2), string_view(ob), env.argv(3), env.argv(1), a)
                string_free(otx2)
                string_free(ob)
                string_free(merged)
                return vrc
            }
            let drc: i32 = driver_build(m, p2, c2, mv, a, env.argv(1), rmode)
            string_free(merged)
            return drc
        }
        var src: String = fs.read_text(env.argv(1))
        var p: parser.Parser = parser.parse_source(string_view(src), it, kwcount, a)
        if gmode {
            // `jc <file> doc` — the Markdown API page. Single-file like the reference's
            // `doc::generate` (which re-lexes for the trivia side table), and typeck-free:
            // every signature and guarantee is reconstructed from the AST alone.
            let dv: str = string_view(src)
            var dtoks: List(tokens.Token) = tokens.tokenize(dv, it, kwcount, a)
            var ddocs: List(tokens.RawDoc) = tokens.collect_docs(dv, dtoks, a)
            let ap: str = env.argv(1)
            let dl: usize = path_dir_len(ap)               // the title is the file stem
            var te: usize = ap.len
            if te >= 4 {
                if str_eq(ap[te - 4 .. te], ".jtr") { te = te - 4 }
            }
            var dsb: String = string_new()
            dc_generate(dsb, p, dv, ddocs, ap[dl .. te], ap, a)
            let dvv: str = string_view(dsb)
            // The page ends in '\n'; print_str re-adds one, so drop the last byte.
            if dvv.len > 0 { print_str(dvv[0 .. dvv.len - 1]) }
            string_free(dsb)
            string_free(src)
            return 0
        }
        var c: typeck.Checker = typeck.check_parsed(p, string_view(src), a)
        var sb: String = string_new()
        if lmode {
            if env.argc() > 3 {
                emit_test_list(sb, p, string_view(src), env.argv(3))
            } else {
                emit_test_list(sb, p, string_view(src), "")
            }
        } else if tmode and env.argc() > 3 {
            emit_program(sb, p, c, string_view(src), a, true, env.argv(3), list.make(i32, a), list.make(i32, a), "", "")
        } else {
            emit_program(sb, p, c, string_view(src), a, tmode, "", list.make(i32, a), list.make(i32, a), "", "")
        }
        let v: str = string_view(sb)
        // The emitted C ends in a trailing '\n'; print_str appends one, so drop the last byte to
        // keep stdout byte-identical to `cgen::emit`'s String (the golden compares line-for-line).
        if v.len > 0 {
            print_str(v[0 .. v.len - 1])
        }
        string_free(src)
    }
    return 0
}
