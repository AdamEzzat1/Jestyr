// examples/std/cgen.jtr — the P5 C backend, written *in Jestyr*. It imports the P2 parser (AST)
// and the P3 typeck (per-expr types + resolution records), then lowers the program to C —
// aiming to be **byte-identical** to the Rust reference `src/cgen.rs` (`cgen::emit`). This is the
// last and largest pass of the self-hosting port (ROADMAP workstream P); it is grown
// construct-by-construct, starting from `examples/hello.jtr`, mirroring `emit_program`'s exact
// section order (the emission ORDER is load-bearing for byte-identity).
//
// **Verification.** `jestyr_cgen_matches_reference` (`--features c-oracle`) builds this program,
// runs it on each corpus `.jtr` file, and diffs its stdout (the emitted C) line-for-line against
// `cgen::emit(&ast, &info)` — where `info` comes from the single-file `typeck::check`, so the
// reference's `#line` debug directives are empty (the unit-test path), and the target is the
// pure C text. A `CGEN_GOLDEN_DENYLIST` holds the files not yet covered; it shrinks per construct.
//
// Increment 1 (this file's current reach): `hello.jtr` — the prelude, one `fn main -> i32`, a
// `print_str("…")` intrinsic call, a string literal, and `return 0`. Everything else is denylisted.
import "mem"
import "intern"
import "fs"
import "env"
import "list"
import "tokens"
import "parser"
import "typeck"

// ---- the fixed C prelude (mirrors Cgen::prelude) ----
// A FIXED header block: includes + the `jestyr_rt_*` runtime + the JestyrStr/String/Cow/Builder
// value types + the print/file-IO/argv intrinsics. Transcribed byte-for-byte from `cgen.rs`
// (Jestyr and Rust share the same string-escape conventions, so `"\\n"` here is a literal
// backslash-n in the emitted C, and `"\n"` is a real C-source line break — the double-transpile
// composes). The pthread/time/try_read/arena conditional blocks are only emitted when used;
// `hello` uses none, so they are elided (added back per construct as later files need them).
// Does the program use the bump-arena runtime — a `region` block, a region-scoped loop, or a
// value-level arena intrinsic? Gates the arena prelude block (mirrors `uses_arena`).
// Does the program call `try_read_file`? Gates its runtime helper + `JestyrResult_String`
// typedef so unrelated programs stay byte-identical (mirrors `uses_try_read`).
fn uses_try_read(read p: parser.Parser, read src: str) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "try_read_file") { return true }
            }
        }
        i = i + 1
    }
    return false
}

fn uses_arena(read p: parser.Parser, read src: str) -> bool {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 43 { return true }               // a `region r { … }` block
        if e.kind == 31 {                             // a region-scoped scratch loop
            if list.get(i32, p.lar, (e.a + 2) as usize) >= 0 { return true }
        }
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                let nm: str = src[callee.start .. callee.end]
                if str_eq(nm, "arena_open") or str_eq(nm, "arena_alloc") or str_eq(nm, "arena_close") {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

fn emit_prelude(mut sb: String, read p: parser.Parser, read src: str) {
    string_push(sb, "#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <assert.h>\n")
    string_push(sb, "\n")
    string_push(sb, "/* Jestyr string view — a length-carrying `{ptr, len}` (a borrowed UTF-8 view,\n")
    string_push(sb, "   like Zig `[]const u8` / Rust `&str`). `.len` is O(1); no `strlen`. A bare\n")
    string_push(sb, "   `cstr` (null-terminated `const char*`) is the distinct C-interop type. */\n")
    string_push(sb, "typedef struct { const char* ptr; size_t len; } JestyrStr;\n")
    string_push(sb, "#define JSTR(s) ((JestyrStr){ (s), sizeof(s) - 1 })\n")
    string_push(sb, "/* O(n) codepoint count (vs O(1) `.len`): a UTF-8 leading byte is one whose top two bits aren't 10. */\n")
    string_push(sb, "static size_t jestyr_rt_count_cp(JestyrStr s) { size_t n = 0; for (size_t k = 0; k < s.len; k++) if (((uint8_t)s.ptr[k] & 0xC0u) != 0x80u) n++; return n; }\n")
    string_push(sb, "/* Simplified grapheme segmentation: a cluster is a base codepoint plus following combining marks (é = e + U+0301). ZWJ emoji sequences are not merged — full UAX#29 needs Unicode tables. */\n")
    string_push(sb, "static bool jestyr_rt_is_combining(uint32_t cp) { return (cp >= 0x0300u && cp <= 0x036Fu) || (cp >= 0x1AB0u && cp <= 0x1AFFu) || (cp >= 0x1DC0u && cp <= 0x1DFFu) || (cp >= 0x20D0u && cp <= 0x20FFu) || (cp >= 0xFE20u && cp <= 0xFE2Fu); }\n")
    string_push(sb, "/* Decode the UTF-8 codepoint at *k, advancing *k past it (replacement char on a bad lead byte). */\n")
    string_push(sb, "static uint32_t jestyr_rt_decode_cp(const char* p, size_t len, size_t* k) { size_t i = *k; uint8_t b = (uint8_t)p[i]; uint32_t cp; size_t n; if (b < 0x80u) { cp = b; n = 1; } else if ((b & 0xE0u) == 0xC0u) { cp = b & 0x1Fu; n = 2; } else if ((b & 0xF0u) == 0xE0u) { cp = b & 0x0Fu; n = 3; } else if ((b & 0xF8u) == 0xF0u) { cp = b & 0x07u; n = 4; } else { *k = i + 1; return 0xFFFDu; } for (size_t j = 1; j < n && i + j < len; j++) cp = (cp << 6) | ((uint8_t)p[i + j] & 0x3Fu); *k = i + n; return cp; }\n")
    string_push(sb, "/* O(n) grapheme-cluster count: base codepoints (combining marks attach to the preceding base). */\n")
    string_push(sb, "static size_t jestyr_rt_count_graphemes(JestyrStr s) { size_t k = 0, n = 0; while (k < s.len) { uint32_t cp = jestyr_rt_decode_cp(s.ptr, s.len, &k); if (!jestyr_rt_is_combining(cp)) n++; } return n; }\n")
    string_push(sb, "/* Validate a byte range as UTF-8 (used at the bytes->str boundary). */\n")
    string_push(sb, "static bool jestyr_rt_valid_utf8(const char* p, size_t len) { size_t k = 0; while (k < len) { uint8_t b = (uint8_t)p[k]; size_t n; if (b < 0x80u) n = 1; else if ((b & 0xE0u) == 0xC0u) n = 2; else if ((b & 0xF0u) == 0xE0u) n = 3; else if ((b & 0xF8u) == 0xF0u) n = 4; else return false; if (k + n > len) return false; for (size_t j = 1; j < n; j++) if (((uint8_t)p[k + j] & 0xC0u) != 0x80u) return false; k += n; } return true; }\n")
    string_push(sb, "/* A boundary-checked sub-view (Rust discipline): start<=end<=len, and both on UTF-8 char boundaries. Zero-copy. */\n")
    string_push(sb, "static bool jestyr_rt_is_boundary(JestyrStr s, size_t i) { return i == s.len || ((uint8_t)s.ptr[i] & 0xC0u) != 0x80u; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_substr(JestyrStr s, size_t start, size_t end) { assert(start <= end && end <= s.len); assert(jestyr_rt_is_boundary(s, start) && jestyr_rt_is_boundary(s, end)); return (JestyrStr){ s.ptr + start, end - start }; }\n")
    string_push(sb, "/* Byte-level string operations: equality, prefix/suffix, search, trim. All view-based (find/trim are zero-copy). */\n")
    string_push(sb, "static bool jestyr_rt_str_eq(JestyrStr a, JestyrStr b) { return a.len == b.len && memcmp(a.ptr, b.ptr, a.len) == 0; }\n")
    string_push(sb, "static bool jestyr_rt_starts_with(JestyrStr s, JestyrStr p) { return s.len >= p.len && memcmp(s.ptr, p.ptr, p.len) == 0; }\n")
    string_push(sb, "static bool jestyr_rt_ends_with(JestyrStr s, JestyrStr p) { return s.len >= p.len && memcmp(s.ptr + (s.len - p.len), p.ptr, p.len) == 0; }\n")
    string_push(sb, "static int64_t jestyr_rt_find(JestyrStr s, JestyrStr n) { if (n.len == 0) return 0; if (n.len > s.len) return -1; for (size_t i = 0; i + n.len <= s.len; i++) if (memcmp(s.ptr + i, n.ptr, n.len) == 0) return (int64_t)i; return -1; }\n")
    string_push(sb, "static bool jestyr_rt_contains(JestyrStr s, JestyrStr n) { return jestyr_rt_find(s, n) >= 0; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_trim(JestyrStr s) { size_t a = 0, b = s.len; while (a < b) { char c = s.ptr[a]; if (c==' '||c=='\\t'||c=='\\n'||c=='\\r') a++; else break; } while (b > a) { char c = s.ptr[b-1]; if (c==' '||c=='\\t'||c=='\\n'||c=='\\r') b--; else break; } return (JestyrStr){ s.ptr + a, b - a }; }\n")
    string_push(sb, "/* ASCII case-insensitive equality — the opt-in normalization-aware compare. Full Unicode case-folding / NFC normalization needs the Unicode tables (deferred). */\n")
    string_push(sb, "static char jestyr_rt_ascii_lower(char c) { return (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c; }\n")
    string_push(sb, "static bool jestyr_rt_eq_fold(JestyrStr a, JestyrStr b) { if (a.len != b.len) return false; for (size_t i = 0; i < a.len; i++) if (jestyr_rt_ascii_lower(a.ptr[i]) != jestyr_rt_ascii_lower(b.ptr[i])) return false; return true; }\n\n")
    string_push(sb, "/* Jestyr owned String — a heap-owned, growable buffer (the owned half of the\n")
    string_push(sb, "   owned/view split). `string_view` borrows it as a `str` view; no copy. */\n")
    string_push(sb, "typedef struct { char* ptr; size_t len; size_t cap; } JestyrString;\n")
    string_push(sb, "static JestyrString jestyr_rt_str_new(void) { JestyrString s; s.ptr = NULL; s.len = 0; s.cap = 0; return s; }\n")
    string_push(sb, "static JestyrString jestyr_rt_str_from(JestyrStr v) { JestyrString s; s.cap = v.len ? v.len : 1; s.ptr = (char*)malloc(s.cap); memcpy(s.ptr, v.ptr, v.len); s.len = v.len; return s; }\n")
    string_push(sb, "static void jestyr_rt_str_push(JestyrString* s, JestyrStr v) { if (s->len + v.len > s->cap) { size_t nc = s->cap ? s->cap * 2 : 8; while (nc < s->len + v.len) nc *= 2; s->ptr = (char*)realloc(s->ptr, nc); s->cap = nc; } memcpy(s->ptr + s->len, v.ptr, v.len); s->len += v.len; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_str_view(JestyrString* s) { return (JestyrStr){ s->ptr, s->len }; }\n")
    string_push(sb, "static void jestyr_rt_str_free(JestyrString* s) { free(s->ptr); s->ptr = NULL; s->len = 0; s->cap = 0; }\n")
    string_push(sb, "/* Append an integer's decimal digits (for f-string interpolation; copies). */\n")
    string_push(sb, "static void jestyr_rt_str_push_i64(JestyrString* s, int64_t v) { char b[24]; int n = snprintf(b, sizeof(b), \"%lld\", (long long)v); if (n < 0) n = 0; jestyr_rt_str_push(s, (JestyrStr){ b, (size_t)n }); }\n")
    string_push(sb, "/* Lossily decode unvalidated platform text (os_str) into a proven UTF-8 String, replacing each ill-formed byte with U+FFFD. */\n")
    string_push(sb, "/* Cow<str>: borrowed-or-owned, visible. cap==0 means borrowed (no allocation, free is a no-op); cap>0 means owned. cow_to_mut is the copy-on-write point. */\n")
    string_push(sb, "typedef struct { char* ptr; size_t len; size_t cap; } JestyrCow;\n")
    string_push(sb, "static JestyrCow jestyr_rt_cow_borrow(JestyrStr v) { JestyrCow c; c.ptr = (char*)v.ptr; c.len = v.len; c.cap = 0; return c; }\n")
    string_push(sb, "static bool jestyr_rt_cow_is_owned(JestyrCow c) { return c.cap > 0; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_cow_view(JestyrCow c) { return (JestyrStr){ c.ptr, c.len }; }\n")
    string_push(sb, "static JestyrCow jestyr_rt_cow_to_mut(JestyrCow c) { if (c.cap > 0) return c; JestyrCow o; o.cap = c.len ? c.len : 1; o.ptr = (char*)malloc(o.cap); memcpy(o.ptr, c.ptr, c.len); o.len = c.len; return o; }\n")
    string_push(sb, "static void jestyr_rt_cow_free(JestyrCow* c) { if (c->cap > 0) free(c->ptr); c->ptr = NULL; c->len = 0; c->cap = 0; }\n")
    string_push(sb, "static JestyrString jestyr_rt_to_str_lossy(JestyrStr os) { JestyrString out = jestyr_rt_str_new(); size_t k = 0; while (k < os.len) { uint8_t b = (uint8_t)os.ptr[k]; size_t n; bool ok = true; if (b < 0x80u) n = 1; else if ((b & 0xE0u) == 0xC0u) n = 2; else if ((b & 0xF0u) == 0xE0u) n = 3; else if ((b & 0xF8u) == 0xF0u) n = 4; else { ok = false; n = 1; } if (ok && k + n <= os.len) { for (size_t j = 1; j < n; j++) if (((uint8_t)os.ptr[k + j] & 0xC0u) != 0x80u) { ok = false; break; } } else if (n > 1) ok = false; if (ok) { jestyr_rt_str_push(&out, (JestyrStr){ os.ptr + k, n }); k += n; } else { jestyr_rt_str_push(&out, (JestyrStr){ \"\\xEF\\xBF\\xBD\", 3 }); k += 1; } } return out; }\n\n")
    string_push(sb, "/* Jestyr Builder — an iolist: a list of `str` *fragments* collected with no\n")
    string_push(sb, "   copying; `builder_build` sums the lengths, allocates once, and flattens in a\n")
    string_push(sb, "   single pass (Erlang iodata). Fragments must outlive the build. */\n")
    string_push(sb, "typedef struct { JestyrStr* frags; size_t n; size_t cap; } JestyrBuilder;\n")
    string_push(sb, "static JestyrBuilder jestyr_rt_b_new(void) { JestyrBuilder b; b.frags = NULL; b.n = 0; b.cap = 0; return b; }\n")
    string_push(sb, "static void jestyr_rt_b_push(JestyrBuilder* b, JestyrStr v) { if (b->n == b->cap) { size_t nc = b->cap ? b->cap * 2 : 8; b->frags = (JestyrStr*)realloc(b->frags, nc * sizeof(JestyrStr)); b->cap = nc; } b->frags[b->n++] = v; }\n")
    string_push(sb, "static JestyrString jestyr_rt_b_build(JestyrBuilder* b) { size_t total = 0; for (size_t i = 0; i < b->n; i++) total += b->frags[i].len; JestyrString s; s.cap = total ? total : 1; s.ptr = (char*)malloc(s.cap); s.len = total; size_t off = 0; for (size_t i = 0; i < b->n; i++) { memcpy(s.ptr + off, b->frags[i].ptr, b->frags[i].len); off += b->frags[i].len; } return s; }\n")
    string_push(sb, "static void jestyr_rt_b_free(JestyrBuilder* b) { free(b->frags); b->frags = NULL; b->n = 0; b->cap = 0; }\n\n")
    string_push(sb, "/* Jestyr runtime prelude — temporary print intrinsics (stand-in for a stdlib). */\n")
    string_push(sb, "static void jestyr_rt_print_int(int64_t x) { printf(\"%lld\\n\", (long long) x); }\n")
    string_push(sb, "static void jestyr_rt_print_float(double x) { printf(\"%g\\n\", x); }\n")
    string_push(sb, "static void jestyr_rt_print_str(JestyrStr s) { printf(\"%.*s\\n\", (int) s.len, s.ptr); }\n")
    string_push(sb, "static void jestyr_rt_print_bool(bool b) { printf(\"%s\\n\", b ? \"true\" : \"false\"); }\n\n")
    string_push(sb, "/* Jestyr file I/O (self-hosting plumbing): whole-file read/write. A `str` path\n")
    string_push(sb, "   is a {ptr,len} view (not NUL-terminated), so each call copies it into a\n")
    string_push(sb, "   NUL-terminated temporary for libc. Binary mode + whole-file-at-once = no\n")
    string_push(sb, "   buffering or newline-translation surprises (deterministic across platforms). */\n")
    string_push(sb, "static char* jestyr_rt_cpath(JestyrStr p) { char* c = (char*)malloc(p.len + 1); memcpy(c, p.ptr, p.len); c[p.len] = '\\0'; return c; }\n")
    string_push(sb, "static JestyrString jestyr_rt_read_file(JestyrStr path) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); JestyrString s = jestyr_rt_str_new(); if (!f) return s; if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return s; } long sz = ftell(f); if (sz < 0) { fclose(f); return s; } rewind(f); size_t cap = (size_t)sz ? (size_t)sz : 1; s.ptr = (char*)malloc(cap); s.cap = cap; s.len = fread(s.ptr, 1, (size_t)sz, f); fclose(f); return s; }\n")
    string_push(sb, "static bool jestyr_rt_write_file(JestyrStr path, JestyrStr data) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"wb\"); free(cp); if (!f) return false; size_t put = data.len ? fwrite(data.ptr, 1, data.len, f) : 0; int rc = fclose(f); return rc == 0 && put == data.len; }\n")
    string_push(sb, "static bool jestyr_rt_file_exists(JestyrStr path) { char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); if (f) { fclose(f); return true; } return false; }\n")
    string_push(sb, "static bool jestyr_rt_remove_file(JestyrStr path) { char* cp = jestyr_rt_cpath(path); int rc = remove(cp); free(cp); return rc == 0; }\n")
    // Recoverable read (B3): emitted ONLY when `try_read_file` is used, so a program that
    // doesn't use it stays byte-identical.
    if uses_try_read(p, src) {
        string_push(sb, "/* Recoverable whole-file read: false on open/seek failure (the `String !IoError` err branch). */\n")
        string_push(sb, "static bool jestyr_rt_try_read_file(JestyrStr path, JestyrString* out) { *out = jestyr_rt_str_new(); char* cp = jestyr_rt_cpath(path); FILE* f = fopen(cp, \"rb\"); free(cp); if (!f) return false; if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return false; } long sz = ftell(f); if (sz < 0) { fclose(f); return false; } rewind(f); size_t cap = (size_t)sz ? (size_t)sz : 1; out->ptr = (char*)malloc(cap); out->cap = cap; out->len = fread(out->ptr, 1, (size_t)sz, f); fclose(f); return true; }\n")
    }
    string_push(sb, "\n")
    string_push(sb, "/* Command-line arguments (self-hosting plumbing): argv is captured in main()\n")
    string_push(sb, "   into file-scope globals, exposed to Jestyr as arg_count() -> i32 and\n")
    string_push(sb, "   arg(i) -> str (a zero-copy view into argv[i]; out-of-range yields empty).\n")
    string_push(sb, "   arg(0) is the program path. argv strings are NUL-terminated, OS-owned. */\n")
    string_push(sb, "static int jestyr_rt_argc = 0;\n")
    string_push(sb, "static char** jestyr_rt_argv = NULL;\n")
    string_push(sb, "static int64_t jestyr_rt_arg_count(void) { return (int64_t)jestyr_rt_argc; }\n")
    string_push(sb, "static JestyrStr jestyr_rt_arg(int64_t i) { if (i < 0 || i >= (int64_t)jestyr_rt_argc) return (JestyrStr){ \"\", 0 }; const char* a = jestyr_rt_argv[i]; size_t n = 0; while (a[n]) n++; return (JestyrStr){ a, n }; }\n\n")
    if uses_arena(p, src) {
        string_push(sb, "/* Jestyr bump arena — backs region refs (`&[r]T`) and the std arena allocator. */\n")
        string_push(sb, "typedef struct { char* buf; size_t off; size_t cap; } JestyrArena;\n")
        string_push(sb, "static JestyrArena jestyr_arena_new(size_t cap) { JestyrArena a; a.buf = (char*)malloc(cap); a.off = 0; a.cap = cap; return a; }\n")
        string_push(sb, "static void* jestyr_arena_alloc(JestyrArena* a, size_t n) { size_t al = (n + 7u) & ~(size_t)7u; void* p = a->buf + a->off; a->off += al; return p; }\n")
        string_push(sb, "static void jestyr_arena_free(JestyrArena* a) { free(a->buf); }\n\n")
    }
}

// ---- primitive type -> C type (mirrors the prim arm of Cgen::c_type) ----
// Increment 1 covers the integer/float/bool/unit prims. Structural types (str, slices, pointers,
// named aggregates) are added as later files need them.
fn c_prim(read name: str) -> str {
    if str_eq(name, "i8") { return "int8_t" }
    if str_eq(name, "i16") { return "int16_t" }
    if str_eq(name, "i32") { return "int32_t" }
    if str_eq(name, "i64") { return "int64_t" }
    if str_eq(name, "u8") { return "uint8_t" }
    if str_eq(name, "u16") { return "uint16_t" }
    if str_eq(name, "u32") { return "uint32_t" }
    if str_eq(name, "u64") { return "uint64_t" }
    if str_eq(name, "usize") { return "size_t" }
    if str_eq(name, "isize") { return "intptr_t" }
    if str_eq(name, "f32") { return "float" }
    if str_eq(name, "f64") { return "double" }
    if str_eq(name, "bool") { return "bool" }
    if str_eq(name, "char") { return "uint32_t" }
    if str_eq(name, "str") { return "JestyrStr" }
    if str_eq(name, "os_str") { return "JestyrStr" }
    if str_eq(name, "cstr") { return "const char*" }
    if str_eq(name, "String") { return "JestyrString" }
    if str_eq(name, "Builder") { return "JestyrBuilder" }
    if str_eq(name, "Cow") { return "JestyrCow" }
    return ""                                          // not a primitive
}

// A type node (`TypeId`) rendered as its C type, pushed onto `sb` (a user type needs the runtime
// `Jestyr_<name>` concatenation, so this writes rather than returns). Increment 4 covers primitive
// Name types and user Name types (distinct/struct/enum -> `Jestyr_<name>`). Structural forms
// (str, slices, pointers, App/Path) are added as later files need them. `tyid` < 0 is unit (void).
fn emit_c_ty(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    if tyid < 0 { string_push(sb, "void")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 {                                   // Name
        let nm: str = src[t.start .. t.end]
        let pc: str = c_prim(nm)
        if !str_eq(pc, "") { string_push(sb, pc)  return }
        string_push(sb, "Jestyr_")                     // a user type: its Jestyr_<name> C symbol
        string_push(sb, nm)
        return
    }
    if t.kind == 2 {                                   // Ptr: `<inner>*`
        emit_c_ty(sb, p, src, t.a)
        string_push(sb, "*")
        return
    }
    if t.kind == 3 {                                   // Slice: `JestyrSlice_<mangle>`
        string_push(sb, "JestyrSlice_")
        push_ast_mangle(sb, p, src, t.a)
        return
    }
    if t.kind == 4 {                                   // Array `[N]T`: `JestyrArr_<mangle>_<N>`
        string_push(sb, "JestyrArr_")
        push_ast_mangle(sb, p, src, t.a)               // a = elem
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)                // b = len ExprId
        return
    }
    if t.kind == 5 {                                   // GenRef `&T`: `JestyrRef_<elem mangle>`
        string_push(sb, "JestyrRef_")
        push_ast_mangle(sb, p, src, t.a)
        return
    }
    if t.kind == 6 {                                   // RegionRef `&[r]T`: zero-cost plain pointer
        emit_c_ty(sb, p, src, t.a)
        string_push(sb, "*")
        return
    }
    if t.kind == 9 {                                   // Fn: its `JestyrFn_<sig>` typedef name
        string_push(sb, "JestyrFn_")
        push_ast_mangle(sb, p, src, tyid)
        return
    }
    if t.kind == 7 {                                   // App `Ctor(args)`: `Jestyr_<ctor>__<args>`
        string_push(sb, "Jestyr_")
        string_push(sb, src[t.x as usize .. t.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < t.a {                                  // (op,a) = arg slice of TypeIds in tar
            if i > 0 { string_push(sb, "_") }
            push_ast_mangle(sb, p, src, list.get(i32, p.tar, (t.op + i) as usize))
            i = i + 1
        }
        return
    }
    string_push(sb, "void")                            // TODO: Path / Fn / dyn
}

// An array length expression rendered as its literal digits (`[5]T` -> `5`). Array lengths are
// constant expressions; an integer literal is the case the backend supports.
fn push_array_len(mut sb: String, read p: parser.Parser, read src: str, len_eid: i32) {
    if len_eid < 0 { string_push(sb, "0")  return }
    let l: parser.ExprData = list.get(parser.ExprData, p.ex, len_eid as usize)
    emit_int_literal(sb, src[l.start .. l.end])
}

// The mangle suffix of an AST type node (mirrors `ty_mangle` for the forms handled so far:
// a Name is its source text — prim or declared; a Ptr is `ptr_<inner>`).
fn push_ast_mangle(mut sb: String, read p: parser.Parser, read src: str, tyid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 { string_push(sb, src[t.start .. t.end])  return }
    if t.kind == 2 { string_push(sb, "ptr_")  push_ast_mangle(sb, p, src, t.a)  return }
    if t.kind == 3 { string_push(sb, "slice_")  push_ast_mangle(sb, p, src, t.a)  return }
    if t.kind == 5 { string_push(sb, "ref_")  push_ast_mangle(sb, p, src, t.a)  return }   // GenRef
    if t.kind == 9 {                                   // Fn: `fn_<tag><ty>…_ret_<ty>` (conv-tagged params)
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < t.a {                                  // (op,a) = (conv,TypeId) pair slice in tar
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, p.tar, (t.op + i * 2) as usize))
            push_ast_mangle(sb, p, src, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, "_ret_")
        if t.x >= 0 { push_ast_mangle(sb, p, src, t.x) } else { string_push(sb, "unit") }
        return
    }
    if t.kind == 4 {                                   // Array: `arr_<elem>_<len>`
        string_push(sb, "arr_")
        push_ast_mangle(sb, p, src, t.a)
        string_push(sb, "_")
        push_array_len(sb, p, src, t.b)
        return
    }
    string_push(sb, "?")
}

// A fn-type param convention's one-letter mangle tag (a `mut`/`out` param lowers to `T*`, a
// different C type — the tag keeps such signatures distinct). Mirrors the `ty_mangle` Fn arm.
fn push_conv_tag(mut sb: String, conv: i32) {
    if conv == 1 { string_push(sb, "r")  return }
    if conv == 2 { string_push(sb, "m")  return }
    if conv == 3 { string_push(sb, "t")  return }
    if conv == 4 { string_push(sb, "o")  return }
    string_push(sb, "d")
}

// A primitive type CODE (typeck's `prim_name` numbering) rendered as its C type. Used by
// `emit_ty_c` when the Checker gives an inferred primitive type.
fn prim_code_c(mut sb: String, code: i32) {
    if code == 0 { string_push(sb, "int8_t")  return }
    if code == 1 { string_push(sb, "int16_t")  return }
    if code == 2 { string_push(sb, "int32_t")  return }
    if code == 3 { string_push(sb, "int64_t")  return }
    if code == 4 { string_push(sb, "intptr_t")  return }
    if code == 5 { string_push(sb, "uint8_t")  return }
    if code == 6 { string_push(sb, "uint16_t")  return }
    if code == 7 { string_push(sb, "uint32_t")  return }
    if code == 8 { string_push(sb, "uint64_t")  return }
    if code == 9 { string_push(sb, "size_t")  return }
    if code == 10 { string_push(sb, "float")  return }
    if code == 11 { string_push(sb, "double")  return }
    if code == 12 { string_push(sb, "bool")  return }
    if code == 13 { string_push(sb, "uint32_t")  return }   // char
    if code == 14 { string_push(sb, "JestyrStr")  return }  // str
    if code == 15 { string_push(sb, "const char*")  return } // cstr
    string_push(sb, "void")
}

// A Checker per-expr type (a `TyId` into `c.tys`) rendered as its C type, mirroring `cgen::c_type`.
// Used for inferred-`let` locals (`let x = …` with no annotation). Covers Unit, primitives, and
// Named aggregates (`Jestyr_<name>`, name span in the `tdecl` row `d.x`: cols 0/1). Other TyData
// kinds (Ptr/Slice/GenStruct/Fn/…) are added when a corpus file's inference needs them.
fn emit_ty_c(mut sb: String, read src: str, read c: typeck.Checker, tyid: i32) {
    if tyid < 0 { string_push(sb, "void")  return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    if d.kind == 1 { string_push(sb, "void")  return }         // Unit
    if d.kind == 2 { prim_code_c(sb, d.x)  return }            // Prim
    if d.kind == 15 {                                          // Named: Jestyr_<name>
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, "Jestyr_")
        string_push(sb, src[ns as usize .. ne as usize])
        return
    }
    if d.kind == 3 {                                           // Ptr: `<inner>*`
        emit_ty_c(sb, src, c, d.a)
        string_push(sb, "*")
        return
    }
    if d.kind == 8 {                                           // Slice: `JestyrSlice_<mangle>`
        string_push(sb, "JestyrSlice_")
        push_ty_mangle(sb, src, c, d.a)
        return
    }
    if d.kind == 9 {                                           // Array: `JestyrArr_<mangle>_<N>`
        string_push(sb, "JestyrArr_")
        push_ty_mangle(sb, src, c, d.a)                        // a = elem
        string_push(sb, "_")
        push_uint(sb, d.b as i64)                              // b = length
        return
    }
    if d.kind == 5 {                                           // Result `T!`: `JestyrResult_<mangle(ok)>`
        string_push(sb, "JestyrResult_")
        push_ty_mangle(sb, src, c, d.a)                        // a = ok type
        return
    }
    if d.kind == 10 {                                          // GenRef `&T`: `JestyrRef_<elem mangle>`
        string_push(sb, "JestyrRef_")
        push_ty_mangle(sb, src, c, d.a)
        return
    }
    if d.kind == 11 {                                          // RegionRef `&[r]T`: plain pointer
        emit_ty_c(sb, src, c, d.a)
        string_push(sb, "*")
        return
    }
    if d.kind == 12 {                                          // Fn: its `JestyrFn_<sig>` typedef name
        string_push(sb, "JestyrFn_")
        push_ty_mangle(sb, src, c, tyid)
        return
    }
    if d.kind == 6 {                                           // GenStruct/GenEnum instance: `Jestyr_<ctor>__<args>`
        string_push(sb, "Jestyr_")
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < d.b {
            if i > 0 { string_push(sb, "_") }
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i) as usize))
            i = i + 1
        }
        return
    }
    string_push(sb, "void")                                    // TODO: other TyData kinds
}

// The mangle suffix of a Checker type (mirrors `ty_mangle`): a prim is its Jestyr name, a Named
// type its declared name, `ptr_`/`slice_` prefixes for the structural forms handled so far.
fn push_ty_mangle(mut sb: String, read src: str, read c: typeck.Checker, tyid: i32) {
    if tyid < 0 { string_push(sb, "unit")  return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    if d.kind == 2 { string_push(sb, prim_jname(d.x))  return }
    if d.kind == 15 {
        let ns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, src[ns as usize .. ne as usize])
        return
    }
    if d.kind == 3 { string_push(sb, "ptr_")  push_ty_mangle(sb, src, c, d.a)  return }
    if d.kind == 8 { string_push(sb, "slice_")  push_ty_mangle(sb, src, c, d.a)  return }
    if d.kind == 10 { string_push(sb, "ref_")  push_ty_mangle(sb, src, c, d.a)  return }   // GenRef
    if d.kind == 12 {                                          // Fn: conv-tagged param mangles
        string_push(sb, "fn_")
        var i: i32 = 0
        for i < d.b {                                          // (a,b) = (conv,TyId) pairs in tya
            if i > 0 { string_push(sb, "_") }
            push_conv_tag(sb, list.get(i32, c.tya, (d.a + i * 2) as usize))
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i * 2 + 1) as usize))
            i = i + 1
        }
        string_push(sb, "_ret_")
        push_ty_mangle(sb, src, c, d.x)
        return
    }
    if d.kind == 9 {                                           // Array: `arr_<elem>_<len>`
        string_push(sb, "arr_")
        push_ty_mangle(sb, src, c, d.a)
        string_push(sb, "_")
        push_uint(sb, d.b as i64)
        return
    }
    if d.kind == 5 { string_push(sb, "result_")  push_ty_mangle(sb, src, c, d.a)  return }   // Result ok
    if d.kind == 6 {                                           // GenStruct/GenEnum: `<ctor>__<args>`
        string_push(sb, src[d.x as usize .. d.y as usize])
        string_push(sb, "__")
        var i: i32 = 0
        for i < d.b {
            if i > 0 { string_push(sb, "_") }
            push_ty_mangle(sb, src, c, list.get(i32, c.tya, (d.a + i) as usize))
            i = i + 1
        }
        return
    }
    string_push(sb, "?")
}

// A primitive type CODE rendered as its Jestyr source name (the mangle alphabet).
fn prim_jname(code: i32) -> str {
    if code == 0 { return "i8" }
    if code == 1 { return "i16" }
    if code == 2 { return "i32" }
    if code == 3 { return "i64" }
    if code == 4 { return "isize" }
    if code == 5 { return "u8" }
    if code == 6 { return "u16" }
    if code == 7 { return "u32" }
    if code == 8 { return "u64" }
    if code == 9 { return "usize" }
    if code == 10 { return "f32" }
    if code == 11 { return "f64" }
    if code == 12 { return "bool" }
    if code == 13 { return "char" }
    if code == 14 { return "str" }
    return "?"
}

// A binary-operator code (`ExprData.op` for a Binary node) rendered as its C operator. Mirrors
// `binop_c`; codes come from the parser's `bin_op` (1=add … 18=shr).
fn binop_c(code: i32) -> str {
    if code == 1 { return "+" }
    if code == 2 { return "-" }
    if code == 3 { return "*" }
    if code == 4 { return "/" }
    if code == 5 { return "%" }
    if code == 6 { return "==" }
    if code == 7 { return "!=" }
    if code == 8 { return "<" }
    if code == 9 { return "<=" }
    if code == 10 { return ">" }
    if code == 11 { return ">=" }
    if code == 12 { return "&&" }
    if code == 13 { return "||" }
    if code == 14 { return "&" }
    if code == 15 { return "|" }
    if code == 16 { return "^" }
    if code == 17 { return "<<" }
    if code == 18 { return ">>" }
    return "?"
}

// Is the Checker's type of expr `eid` the primitive `str`? (TyData kind 2 Prim, code 14.)
fn expr_is_str(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == 14
}

// Is the Checker's type of expr `eid` the primitive with code `pc`? (TyData kind 2; codes per
// typeck's `prim_name`: 14 str, 15 cstr, 16 os_str, 17 String, 18 Builder, 19 Cow.)
fn expr_is_prim(read c: typeck.Checker, eid: i32, pc: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 2 and d.x == pc
}

// Is the Checker's type of expr `eid` a slice `[]T`? (TyData kind 8.)
fn expr_is_slice(read c: typeck.Checker, eid: i32) -> bool {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    return d.kind == 8
}

// The tdecl row of expr `eid`'s type if it is a Named ENUM (tdecl kind 1), else -1. The `Jestyr_<E>`
// tag prefix and payload C types come from this row's name.
fn expr_enum_row(read c: typeck.Checker, eid: i32) -> i32 {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 15 { return 0 - 1 }                          // Named
    if list.get(i32, c.tdecl, (d.x * 10 + 2) as usize) != 1 { return 0 - 1 }   // kind 1 = enum
    return d.x
}

fn expr_is_enum(read c: typeck.Checker, eid: i32) -> bool {
    return expr_enum_row(c, eid) >= 0
}

// The tdecl row of expr `eid`'s type if it is a Named STRUCT (tdecl kind 0), else -1.
fn expr_struct_row(read c: typeck.Checker, eid: i32) -> i32 {
    let tid: i32 = list.get(i32, c.et, eid as usize)
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 15 { return 0 - 1 }                          // Named
    if list.get(i32, c.tdecl, (d.x * 10 + 2) as usize) != 0 { return 0 - 1 }   // kind 0 = struct
    return d.x
}

// The Fn ITEM id of struct `sit`'s method named `src[ns..ne]`, or -1. A method member in `mar` is
// the 10-tuple [1, fn_item_id, -1 …]; the fn item (kind 3, not in roots) carries the signature.
fn find_struct_method(read p: parser.Parser, read src: str, sit: i32, ns: usize, ne: usize) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
    var m: i32 = 0
    for m < it.b {
        let base: i32 = it.a + m * 10
        if list.get(i32, p.mar, base as usize) == 1 {         // tag 1 = method
            let fid: i32 = list.get(i32, p.mar, (base + 1) as usize)
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
            if str_eq(src[ns .. ne], src[fd.x .. fd.y]) { return fid }
        }
        m = m + 1
    }
    return 0 - 1
}

// The struct item + method fn item of a method-sugar call `recv.m(…)`, or -1: the callee must be
// a Field whose base types as a Named struct that declares a method of that name. Packs the pair
// as `sit * 1000000 + fid` (item ids are far smaller); -1 = not a struct-method call.
fn resolve_method_call(read p: parser.Parser, read src: str, read c: typeck.Checker, read callee: parser.ExprData) -> i32 {
    let row: i32 = expr_struct_row(c, callee.a)
    if row < 0 { return 0 - 1 }
    let sns: i32 = list.get(i32, c.tdecl, (row * 10 + 0) as usize)
    let sne: i32 = list.get(i32, c.tdecl, (row * 10 + 1) as usize)
    let sit: i32 = find_struct_item(p, src, sns as usize, sne as usize)
    if sit < 0 { return 0 - 1 }
    let fid: i32 = find_struct_method(p, src, sit, callee.x as usize, callee.y as usize)
    if fid < 0 { return 0 - 1 }
    return sit * 1000000 + fid
}

// The `conv` code of a method's `self` parameter (0 read-ish default; 2/4 = by pointer), or 0.
fn method_self_conv(read p: parser.Parser, fid: i32) -> i32 {
    let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
    var i: i32 = 0
    for i < fd.b {
        let pbase: i32 = fd.a + i * 7
        if list.get(i32, p.iar, (pbase + 4) as usize) == 1 {  // is_self
            return list.get(i32, p.iar, (pbase + 1) as usize)
        }
        i = i + 1
    }
    return 0
}

// Collect every (struct item, method fn item) a method-sugar call instantiates, first-seen order,
// as pairs in `g.mi` — the reference's `method_instances` (non-generic receivers: empty type args).
// The expr arena is scanned in creation order, which tracks body order for a single file.
fn collect_method_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var i: usize = 0
    for i < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 5 {
                let packed: i32 = resolve_method_call(p, src, c, callee)
                if packed >= 0 {
                    var seen: bool = false
                    var k: usize = 0
                    for k < list.len(i32, g.mi) {
                        if list.get(i32, g.mi, k) == packed / 1000000 {
                            if list.get(i32, g.mi, k + 1) == packed % 1000000 { seen = true }
                        }
                        k = k + 2
                    }
                    if !seen {
                        list.push(i32, g.mi, packed / 1000000)
                        list.push(i32, g.mi, packed % 1000000)
                    }
                }
            }
        }
        i = i + 1
    }
}

// Is Checker type `tid` a generic-ENUM instance (TyData kind 6 whose ctor names an enum item)
// with all-concrete args? Returns the enum ITEM id, or -1. (Kind 6 also covers comptime-fn
// generic-struct ctors, which don't name an enum item — excluded here.)
fn genum_item_of(read p: parser.Parser, read src: str, read c: typeck.Checker, tid: i32) -> i32 {
    if tid < 0 { return 0 - 1 }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind != 6 { return 0 - 1 }
    let eit: i32 = find_enum_item(p, src, d.x as usize, d.y as usize)
    if eit < 0 { return 0 - 1 }
    var i: i32 = 0
    for i < d.b {                                     // every arg must be concrete (prim or Named)
        let ad: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, c.tya, (d.a + i) as usize) as usize)
        if ad.kind != 2 and ad.kind != 15 { return 0 - 1 }
        i = i + 1
    }
    return eit
}

// Collect the distinct generic-enum instances in `g.gei` (TyId per instance, deduped by the
// rendered C name, in expression order) — mirrors `collect_enum_instances`' expr_types scan.
// (The reference also scans fn signatures after; add that pass when a corpus file has an
// instance that appears in a signature but in no expression.)
fn collect_genum_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var seen: String = string_new()
    var i: usize = 0
    for i < list.len(i32, c.et) {
        let tid: i32 = list.get(i32, c.et, i)
        if genum_item_of(p, src, c, tid) >= 0 {
            var nm: String = string_new()
            emit_ty_c(nm, src, c, tid)
            var probe: String = string_new()
            string_push(probe, "|")  string_push(probe, string_view(nm))  string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                list.push(i32, g.gei, tid)
            }
            string_free(nm)  string_free(probe)
        }
        i = i + 1
    }
    string_free(seen)
}

// Emit field type `fty` under the generic-enum instance `tid`'s substitution: a bare Name that
// matches enum tparam k renders instance arg k; anything else renders as-is. Mirrors
// `ast_type_to_ty(fty, subst)` for the instance's tparam->arg map.
fn emit_field_ty_subst(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, fty: i32, eit: i32, tid: i32) {
    if tid >= 0 and fty >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
        if t.kind == 0 {
            let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
            var k: i32 = 0
            for k < it.a {                            // tparam name-span pairs in ear at it.op
                let tps: i32 = list.get(i32, p.ear, (it.op + k * 2) as usize)
                let tpe: i32 = list.get(i32, p.ear, (it.op + k * 2 + 1) as usize)
                if str_eq(src[t.start .. t.end], src[tps as usize .. tpe as usize]) {
                    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
                    emit_ty_c(sb, src, c, list.get(i32, c.tya, (d.a + k) as usize))
                    return
                }
                k = k + 1
            }
        }
    }
    emit_c_ty(sb, p, src, fty)
}

// Does an enclosing exclusive `for i in 0..s.len` prove `base[index]` in range? Mirrors
// `index_in_range`: base + index are bare Names, the index name has an active refinement whose
// Range hi is `<base>.len` (a Field named `len` whose base Name matches `base`'s text).
fn index_in_range(read g: Cg, read p: parser.Parser, read src: str, base: i32, index: i32) -> bool {
    let bx: parser.ExprData = list.get(parser.ExprData, p.ex, base as usize)
    let ix: parser.ExprData = list.get(parser.ExprData, p.ex, index as usize)
    if bx.kind != 2 { return false }
    if ix.kind != 2 { return false }
    // innermost-first scan of the refinement stack for the index name
    var i: i32 = (list.len(i32, g.rf) / 3) as i32
    for i > 0 {
        i = i - 1
        let rns: i32 = list.get(i32, g.rf, (i * 3) as usize)
        let rne: i32 = list.get(i32, g.rf, (i * 3 + 1) as usize)
        if str_eq(src[ix.start .. ix.end], src[rns as usize .. rne as usize]) {
            let rid: i32 = list.get(i32, g.rf, (i * 3 + 2) as usize)
            let rx: parser.ExprData = list.get(parser.ExprData, p.ex, rid as usize)
            if rx.kind != 13 { return false }          // must be a Range
            if rx.op == 1 { return false }             // exclusive only
            if rx.b < 0 { return false }               // needs a hi bound
            let hx: parser.ExprData = list.get(parser.ExprData, p.ex, rx.b as usize)
            if hx.kind != 5 { return false }           // hi must be a Field
            if !str_eq(src[hx.x as usize .. hx.y as usize], "len") { return false }
            let fb: parser.ExprData = list.get(parser.ExprData, p.ex, hx.a as usize)
            if fb.kind != 2 { return false }           // field base must be a Name
            return str_eq(src[fb.start .. fb.end], src[bx.start .. bx.end])
        }
    }
    return false
}

// ---- expressions (mirrors the relevant arms of Cgen::emit_expr) ----
// Threads `read c: typeck.Checker` — Field/Index are type-directed (`.len` on a `str` is a real C
// field; `s[lo..hi]` on a `str` is a `jestyr_rt_substr` sub-view).
fn emit_expr(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 29 {                                 // Str: emit the literal verbatim inside JSTR
        string_push(sb, "JSTR(")
        string_push(sb, src[e.start .. e.end])
        string_push(sb, ")")
        return
    }
    if e.kind == 0 or e.kind == 1 {                   // Int / Float: underscores stripped
        emit_int_literal(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 26 {                                 // Char: the literal verbatim
        string_push(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 27 {                                 // Bool: op 1 = true, 0 = false
        if e.op == 1 { string_push(sb, "true") } else { string_push(sb, "false") }
        return
    }
    if e.kind == 30 {                                 // Null
        string_push(sb, "NULL")
        return
    }
    if e.kind == 3 {                                  // Unary: (OPrhs). op 1=neg 2=not 3=bitnot 4=ref
        if e.op == 4 {
            let rhs: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if rhs.kind == 2 {                        // `&some_fn` -> the MANGLED fn's address
                if find_fn_item(p, src, src[rhs.start .. rhs.end]) >= 0 {
                    string_push(sb, "(&jestyr_")
                    string_push(sb, src[rhs.start .. rhs.end])
                    string_push(sb, ")")
                    return
                }
            }
        }
        string_push(sb, "(")
        if e.op == 1 { string_push(sb, "-") }
        else if e.op == 2 { string_push(sb, "!") }
        else if e.op == 3 { string_push(sb, "~") }
        else if e.op == 4 { string_push(sb, "&") }
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 19 {                                 // SelfValue: j_self ((*j_self) for mut/out self)
        if g.self_ptr { string_push(sb, "(*j_self)") } else { string_push(sb, "j_self") }
        return
    }
    if e.kind == 2 {                                  // Name (value position)
        // Inside a lifted closure body, a captured name lives in the environment.
        var cpi: usize = 0
        for cpi < list.len(i32, g.caps) {
            let cns: i32 = list.get(i32, g.caps, cpi)
            let cne: i32 = list.get(i32, g.caps, cpi + 1)
            if str_eq(src[e.start .. e.end], src[cns as usize .. cne as usize]) {
                string_push(sb, "(j__env->j_")
                string_push(sb, src[e.start .. e.end])
                string_push(sb, ")")
                return
            }
            cpi = cpi + 2
        }
        // A bare *nullary* enum variant (e.g. `none`, `red`) constructs its enum value. A
        // payload-bearing variant referenced bare is not a construction (it would be called).
        let venum: i32 = find_variant_enum(p, src, e.start, e.end)
        if venum >= 0 {
            let vb: i32 = variant_tuple(p, src, venum, e.start, e.end)
            if list.get(i32, p.ear, (vb + 3) as usize) == 0 {   // field_count == 0: nullary
                let own: i32 = list.get(i32, c.et, eid as usize)
                if genum_item_of(p, src, c, own) >= 0 {          // a generic-enum instance value
                    emit_gvariant_head(sb, src, c, own, src[e.start .. e.end])
                } else {
                    emit_variant_head(sb, p, src, venum, src[e.start .. e.end])
                }
                string_push(sb, " }")
                return
            }
        }
        if is_ptr_name(g, src, e.start, e.end) {      // a by-pointer name dereferences on use
            string_push(sb, "(*j_")
            string_push(sb, src[e.start .. e.end])
            string_push(sb, ")")
            return
        }
        string_push(sb, "j_")
        string_push(sb, src[e.start .. e.end])
        return
    }
    if e.kind == 4 {                                  // Binary: operator-trait dispatch, else (lhs OP rhs)
        var ob: i32 = 0 - 1
        var oi: usize = 0
        for oi < list.len(i32, c.icalls) {            // an icalls record on a BINARY id = an op impl
            if list.get(i32, c.icalls, oi) == eid { ob = oi as i32 }
            oi = oi + 5
        }
        if ob >= 0 {
            emit_operator_call(sb, p, src, c, g, e, ob)
            return
        }
        string_push(sb, "(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, " ")
        string_push(sb, binop_c(e.op))
        string_push(sb, " ")
        emit_expr(sb, p, src, c, g, e.b)
        string_push(sb, ")")
        return
    }
    if e.kind == 5 {                                  // Field access. (x,y) = name span
        let fname: str = src[e.x as usize .. e.y as usize]
        // A fixed-size array's `.len` is its CONSTANT length, not a struct field — the base is a
        // place expression, so not emitting it loses no side effect (mirrors the reference).
        let bt: i32 = list.get(i32, c.et, e.a as usize)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 and str_eq(fname, "len") {
                string_push(sb, "((size_t)")
                push_uint(sb, bd.b as i64)
                string_push(sb, ")")
                return
            }
        }
        emit_expr(sb, p, src, c, g, e.a)
        // A string view's `len`/`ptr`/`cstr` are real C fields (not `j_`-prefixed).
        if expr_is_str(c, e.a) {
            if str_eq(fname, "len") { string_push(sb, ".len")  return }
            if str_eq(fname, "ptr") or str_eq(fname, "cstr") { string_push(sb, ".ptr")  return }
        }
        // A slice's `ptr`/`len` are real C fields too.
        if expr_is_slice(c, e.a) {
            if str_eq(fname, "len") or str_eq(fname, "ptr") {
                string_push(sb, ".")
                string_push(sb, fname)
                return
            }
        }
        // An owned `String`'s byte length is its real C field (O(1)).
        if expr_is_prim(c, e.a, 17) {                 // prim code 17 = String
            if str_eq(fname, "len") { string_push(sb, ".len")  return }
        }
        string_push(sb, ".j_")
        string_push(sb, fname)
        return
    }
    if e.kind == 6 {                                  // Index. `s[lo..hi]` on a str -> substr sub-view
        if expr_is_str(c, e.a) {
            let ix: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
            if ix.kind == 13 {                        // Range: op=inclusive, a=lo (-1 none), b=hi (-1 none)
                string_push(sb, "jestyr_rt_substr(")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, ", ")
                if ix.a >= 0 { emit_expr(sb, p, src, c, g, ix.a) } else { string_push(sb, "0") }
                string_push(sb, ", ")
                if ix.b >= 0 {
                    if ix.op == 1 {                   // inclusive `..=hi` -> ((hi) + 1)
                        string_push(sb, "((")
                        emit_expr(sb, p, src, c, g, ix.b)
                        string_push(sb, ") + 1)")
                    } else {
                        emit_expr(sb, p, src, c, g, ix.b)
                    }
                } else {                              // open end -> ({base}).len
                    string_push(sb, "(")
                    emit_expr(sb, p, src, c, g, e.a)
                    string_push(sb, ").len")
                }
                string_push(sb, ")")
                return
            }
            // A scalar index reads the byte at that offset: `((uint8_t)(<s>).ptr[(<i>)])`.
            string_push(sb, "((uint8_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ").ptr[(")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, ")])")
            return
        }
        if expr_is_slice(c, e.a) {                    // slice indexing
            if index_in_range(g, p, src, e.a, e.b) {  // refinement proved i < s.len: raw access
                string_push(sb, "((")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, ").ptr[(")
                emit_expr(sb, p, src, c, g, e.b)
                string_push(sb, ")])")
                return
            }
            // Bounds-checked: spill the slice once, assert, then index.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            emit_ty_c(sb, src, c, list.get(i32, c.et, e.a as usize))
            string_push(sb, " _s")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "); size_t _ix")
            push_uint(sb, n as i64)
            string_push(sb, " = (size_t)(")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, "); assert(_ix")
            push_uint(sb, n as i64)
            string_push(sb, " < _s")
            push_uint(sb, n as i64)
            string_push(sb, ".len); _s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_ix")
            push_uint(sb, n as i64)
            string_push(sb, "]; })")
            return
        }
        let bt: i32 = list.get(i32, c.et, e.a as usize)
        if bt >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, bt as usize)
            if bd.kind == 9 {                         // array indexing: spill the address, assert, index
                let n: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ const ")
                emit_ty_c(sb, src, c, bt)
                string_push(sb, "* _a")
                push_uint(sb, n as i64)
                string_push(sb, " = &(")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, "); size_t _ix")
                push_uint(sb, n as i64)
                string_push(sb, " = (size_t)(")
                emit_expr(sb, p, src, c, g, e.b)
                string_push(sb, "); assert(_ix")
                push_uint(sb, n as i64)
                string_push(sb, " < ")
                push_uint(sb, bd.b as i64)
                string_push(sb, "); _a")
                push_uint(sb, n as i64)
                string_push(sb, "->a[_ix")
                push_uint(sb, n as i64)
                string_push(sb, "]; })")
                return
            }
        }
        // A non-slice, non-array base falls back to raw C indexing.
        string_push(sb, "(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")[")
        emit_expr(sb, p, src, c, g, e.b)
        string_push(sb, "]")
        return
    }
    if e.kind == 14 {                                 // ArrayLit: ({ A _al{n}; _al{n}.a[i] = (v); … _al{n}; })
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        string_push(sb, "({ ")
        emit_ty_c(sb, src, c, list.get(i32, c.et, eid as usize))
        string_push(sb, " _al")
        push_uint(sb, n as i64)
        string_push(sb, ";")
        var i: i32 = 0
        for i < e.y {                                 // (x,y) = elem slice into ar
            string_push(sb, " _al")
            push_uint(sb, n as i64)
            string_push(sb, ".a[")
            push_uint(sb, i as i64)
            string_push(sb, "] = (")
            emit_expr(sb, p, src, c, g, list.get(i32, p.ar, (e.x + i) as usize))
            string_push(sb, ");")
            i = i + 1
        }
        string_push(sb, " _al")
        push_uint(sb, n as i64)
        string_push(sb, "; })")
        return
    }
    if e.kind == 16 {                                 // StructLit: (Jestyr_X){ .j_f = v, … }
        let path: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)   // a = path Name expr
        // `Point { x: 9, ..p }` — functional update: copy the spread base, assign listed fields.
        if e.b >= 0 {
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ Jestyr_")
            string_push(sb, src[path.start .. path.end])
            string_push(sb, " jss_")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, e.b)
            string_push(sb, "; ")
            var si: i32 = 0
            for si < e.y {
                let sfid: i32 = list.get(i32, p.ar, (e.x + si) as usize)
                let sfi: parser.ExprData = list.get(parser.ExprData, p.ex, sfid as usize)
                string_push(sb, "jss_")
                push_uint(sb, n as i64)
                string_push(sb, ".j_")
                string_push(sb, src[sfi.x as usize .. sfi.y as usize])
                string_push(sb, " = ")
                emit_expr(sb, p, src, c, g, sfi.a)
                string_push(sb, "; ")
                si = si + 1
            }
            string_push(sb, "jss_")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        string_push(sb, "(Jestyr_")
        string_push(sb, src[path.start .. path.end])
        string_push(sb, "){ ")
        var first: bool = true
        var i: i32 = 0
        for i < e.y {                                 // (x,y) = FieldInit slice into ar
            if !first { string_push(sb, ", ") }
            first = false
            let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
            let fi: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)   // FieldInit (kind 18)
            string_push(sb, ".j_")
            string_push(sb, src[fi.x as usize .. fi.y as usize])   // field name span
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, fi.a)               // a = value
            i = i + 1
        }
        // Fill any omitted field that declares a `= <default>` (declaration order).
        let sit: i32 = find_struct_item(p, src, path.start, path.end)
        if sit >= 0 {
            let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
            var m: i32 = 0
            for m < sd.b {
                let mb: i32 = sd.a + m * 10
                let dflt: i32 = list.get(i32, p.mar, (mb + 5) as usize)
                if list.get(i32, p.mar, mb as usize) == 0 and dflt >= 0 {   // a field with a default
                    let fns2: i32 = list.get(i32, p.mar, (mb + 2) as usize)
                    let fne2: i32 = list.get(i32, p.mar, (mb + 3) as usize)
                    if !structlit_has_field(p, src, e, fns2 as usize, fne2 as usize) {
                        if !first { string_push(sb, ", ") }
                        first = false
                        string_push(sb, ".j_")
                        string_push(sb, src[fns2 as usize .. fne2 as usize])
                        string_push(sb, " = ")
                        emit_expr(sb, p, src, c, g, dflt)
                    }
                }
                m = m + 1
            }
        }
        string_push(sb, " }")
        return
    }
    if e.kind == 11 {                                 // Cast: (TargetType)(inner). x = target TypeId
        string_push(sb, "(")
        emit_c_ty(sb, p, src, e.x)
        if expr_is_enum(c, e.a) {                     // enum -> int reads its discriminant: (T)((e).tag)
            string_push(sb, ")((")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ").tag)")
            return
        }
        string_push(sb, ")(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 12 {                                 // Assign: `<target> <aop> <value>` (stmt adds `;`)
        let tgt: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
        if tgt.kind == 6 {
            let btid: i32 = list.get(i32, c.et, tgt.a as usize)
            if btid >= 0 {
                let bd: typeck.TyData = list.get(typeck.TyData, c.tys, btid as usize)
                if bd.kind == 9 {                     // array-index WRITE: fold into the stmt-expr
                    var bbuf: String = string_new()   // base/index/VALUE emit before the temp
                    emit_expr(bbuf, p, src, c, g, tgt.a)
                    var ibuf: String = string_new()
                    emit_expr(ibuf, p, src, c, g, tgt.b)
                    var vbuf2: String = string_new()
                    emit_expr(vbuf2, p, src, c, g, e.b)
                    let n: i32 = g.tmp                // (non-const pointer; ONE temp)
                    g.tmp = g.tmp + 1
                    string_push(sb, "({ ")
                    emit_ty_c(sb, src, c, btid)
                    string_push(sb, "* _a")
                    push_uint(sb, n as i64)
                    string_push(sb, " = &(")
                    string_push(sb, string_view(bbuf))
                    string_push(sb, "); size_t _ix")
                    push_uint(sb, n as i64)
                    string_push(sb, " = (size_t)(")
                    string_push(sb, string_view(ibuf))
                    string_push(sb, "); assert(_ix")
                    push_uint(sb, n as i64)
                    string_push(sb, " < ")
                    push_uint(sb, bd.b as i64)
                    string_push(sb, "); _a")
                    push_uint(sb, n as i64)
                    string_push(sb, "->a[_ix")
                    push_uint(sb, n as i64)
                    string_push(sb, "] ")
                    string_push(sb, assign_c(e.op))
                    string_push(sb, " ")
                    string_push(sb, string_view(vbuf2))
                    string_push(sb, "; })")
                    string_free(bbuf)
                    string_free(ibuf)
                    string_free(vbuf2)
                    return
                }
            }
        }
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, " ")
        string_push(sb, assign_c(e.op))
        string_push(sb, " ")
        emit_expr(sb, p, src, c, g, e.b)
        return
    }
    if e.kind == 15 {                                 // ArrayRepeat `[v; N]`: fill via a temp. ONE temp.
        let atid: i32 = list.get(i32, c.et, eid as usize)
        let ad: typeck.TyData = list.get(typeck.TyData, c.tys, atid as usize)   // Array: a=elem, b=len
        var vbuf: String = string_new()               // the value emits FIRST (reference order)
        emit_expr(vbuf, p, src, c, g, e.a)
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        string_push(sb, "({ ")
        emit_ty_c(sb, src, c, atid)
        string_push(sb, " _ar")
        push_uint(sb, n as i64)
        string_push(sb, "; ")
        emit_ty_c(sb, src, c, ad.a)
        string_push(sb, " _v")
        push_uint(sb, n as i64)
        string_push(sb, " = (")
        string_push(sb, string_view(vbuf))
        string_push(sb, "); for (size_t _k")
        push_uint(sb, n as i64)
        string_push(sb, " = 0; _k")
        push_uint(sb, n as i64)
        string_push(sb, " < ")
        push_uint(sb, ad.b as i64)
        string_push(sb, "; _k")
        push_uint(sb, n as i64)
        string_push(sb, "++) _ar")
        push_uint(sb, n as i64)
        string_push(sb, ".a[_k")
        push_uint(sb, n as i64)
        string_push(sb, "] = _v")
        push_uint(sb, n as i64)
        string_push(sb, "; _ar")
        push_uint(sb, n as i64)
        string_push(sb, "; })")
        string_free(vbuf)
        return
    }
    if e.kind == 34 {                                 // Invariant: assert(<cond>) (stmt adds `;`)
        string_push(sb, "assert(")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 25 or e.kind == 23 {                 // VALUE-position unsafe { E } / { E } (B4):
        var beid: i32 = eid                           // yields the single tail expression's value
        if e.kind == 25 { beid = e.a }
        let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
        if blk.y == 1 {
            let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, blk.x as usize) as usize)
            if s.kind == 2 { emit_expr(sb, p, src, c, g, s.a) }
        }
        return
    }
    if e.kind == 35 {                                 // Variant: strictly-decreasing termination measure
        var t: i32 = 0 - 1
        var vi: usize = g.vtf as usize
        for vi < list.len(i32, g.vt) {                // only the CURRENT loop's hoisted trackers
            if list.get(i32, g.vt, vi) == eid { t = list.get(i32, g.vt, vi + 1) }
            vi = vi + 2
        }
        if t >= 0 {
            string_push(sb, "({ int64_t _vv")
            push_uint(sb, t as i64)
            string_push(sb, " = (int64_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "); assert(_vv")
            push_uint(sb, t as i64)
            string_push(sb, " >= 0); assert(_vv")
            push_uint(sb, t as i64)
            string_push(sb, " < _vt")
            push_uint(sb, t as i64)
            string_push(sb, "); _vt")
            push_uint(sb, t as i64)
            string_push(sb, " = _vv")
            push_uint(sb, t as i64)
            string_push(sb, "; })")
        } else {
            string_push(sb, "assert((int64_t)(")
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, ") >= 0)")
        }
        return
    }
    if e.kind == 32 {                                 // Break: labeled -> goto; plain reroutes past an `else`
        if e.x >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[e.x as usize .. e.y as usize])
            string_push(sb, "__break")
            return
        }
        if g.bl_fe >= 0 {
            string_push(sb, "goto _fe")
            push_uint(sb, g.bl_fe as i64)
            string_push(sb, "__break")
            return
        }
        if g.bl_ns >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[g.bl_ns as usize .. g.bl_ne as usize])
            string_push(sb, "__break")
            return
        }
        string_push(sb, "break")
        return
    }
    if e.kind == 33 {                                 // Continue: labeled -> goto its target
        if e.x >= 0 {
            string_push(sb, "goto ")
            string_push(sb, src[e.x as usize .. e.y as usize])
            string_push(sb, "__continue")
            return
        }
        string_push(sb, "continue")
        return
    }
    if e.kind == 7 {                                  // Deref
        let btid: i32 = list.get(i32, c.et, e.a as usize)
        if btid >= 0 {
            let bd: typeck.TyData = list.get(typeck.TyData, c.tys, btid as usize)
            if bd.kind == 10 {                        // genref deref: generation check, ONE temp
                let n: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ ")
                emit_ty_c(sb, src, c, btid)
                string_push(sb, " _r")
                push_uint(sb, n as i64)
                string_push(sb, " = (")
                emit_expr(sb, p, src, c, g, e.a)
                string_push(sb, "); assert(((uint64_t*)_r")
                push_uint(sb, n as i64)
                string_push(sb, ".ptr)[-1] == _r")
                push_uint(sb, n as i64)
                string_push(sb, ".gen); *_r")
                push_uint(sb, n as i64)
                string_push(sb, ".ptr; })")
                return
            }
        }
        string_push(sb, "(*")                         // plain pointer deref
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, ")")
        return
    }
    if e.kind == 8 {                                  // Try `e?`: early-return-on-error statement-expr
        let n: i32 = g.tmp
        g.tmp = g.tmp + 1
        string_push(sb, "({ ")
        emit_ty_c(sb, src, c, list.get(i32, c.et, e.a as usize))   // the base's own Result type
        string_push(sb, " _q")
        push_uint(sb, n as i64)
        string_push(sb, " = ")
        emit_expr(sb, p, src, c, g, e.a)
        string_push(sb, "; if (_q")
        push_uint(sb, n as i64)
        string_push(sb, ".is_err) return (")
        emit_result_name(sb, p, src, g.res_ok)                     // re-wrap in the CURRENT fn's result
        string_push(sb, "){ .is_err = true, .err = _q")
        push_uint(sb, n as i64)
        string_push(sb, ".err }; _q")
        push_uint(sb, n as i64)
        string_push(sb, ".ok; })")
        return
    }
    if e.kind == 37 {                                 // Closure: the lifted value at its creation site
        let k: i32 = closure_index_of(g, eid)
        if k < 0 { string_push(sb, "0")  return }     // uncollected (e.g. in a generic body): the diag case
        let rn: i32 = ref_expr_id(p, eid)
        if closure_is_thin(c, eid) {                  // coerced: the value IS the function's address
            string_push(sb, "(&jestyr_lam_")
            push_uint(sb, rn as i64)
            string_push(sb, ")")
            return
        }
        let cb: i32 = list.get(i32, g.ccx, (k * 2) as usize)
        let cc: i32 = list.get(i32, g.ccx, (k * 2 + 1) as usize)
        string_push(sb, "(JestyrClosure_")
        push_uint(sb, rn as i64)
        string_push(sb, "){ .call = jestyr_lam_")
        push_uint(sb, rn as i64)
        string_push(sb, ", .env = ")
        if cc == 0 { string_push(sb, "{0}") }
        else {
            string_push(sb, "{ ")
            var ci: i32 = 0
            for ci < cc {
                if ci > 0 { string_push(sb, ", ") }
                let b: i32 = (cb + ci) * 3
                let ns: i32 = list.get(i32, g.cca, b as usize)
                let ne: i32 = list.get(i32, g.cca, (b + 1) as usize)
                string_push(sb, ".j_")
                string_push(sb, src[ns as usize .. ne as usize])
                string_push(sb, " = ")
                // the captured value in the ENCLOSING scope (a by-pointer param derefs)
                if is_ptr_name(g, src, ns as usize, ne as usize) {
                    string_push(sb, "(*j_")
                    string_push(sb, src[ns as usize .. ne as usize])
                    string_push(sb, ")")
                } else {
                    string_push(sb, "j_")
                    string_push(sb, src[ns as usize .. ne as usize])
                }
                ci = ci + 1
            }
            string_push(sb, " }")
        }
        string_push(sb, " }")
        return
    }
    if e.kind == 22 {                                 // FString: the _fs{n} push chain
        emit_fstring(sb, p, src, c, g, e)
        return
    }
    if e.kind == 10 {                                 // Call
        emit_call(sb, p, src, c, g, e, eid)
        return
    }
}

// An AssignOp code (parser `assign_op`, 1..9) rendered as its C operator (mirrors `assign_c`).
fn assign_c(code: i32) -> str {
    if code == 1 { return "=" }
    if code == 2 { return "+=" }
    if code == 3 { return "-=" }
    if code == 4 { return "*=" }
    if code == 5 { return "/=" }
    if code == 6 { return "%=" }
    if code == 7 { return "&=" }
    if code == 8 { return "|=" }
    if code == 9 { return "^=" }
    return "="
}

// An integer literal with `_` digit separators removed (mirrors `c_int_literal`; the `0b` binary
// -> decimal rewrite is added when a corpus file needs it — decimal/`0x` are already valid C).
fn emit_int_literal(mut sb: String, read lex: str) {
    // A `0b`/`0B` binary literal is not valid C: convert to decimal (mirrors `c_int_literal`).
    // Decimal and `0x…` pass through with `_` separators stripped.
    if lex.len > 2 {
        if str_eq(lex[0 .. 2], "0b") or str_eq(lex[0 .. 2], "0B") {
            var v: i64 = 0
            var k: usize = 2
            for k < lex.len {
                let ch: str = lex[k .. k + 1]
                if str_eq(ch, "1") { v = v * 2 + 1 }
                else if str_eq(ch, "0") { v = v * 2 }
                k = k + 1                             // `_` separators just skip
            }
            push_uint(sb, v)
            return
        }
    }
    var i: usize = 0
    for i < lex.len {
        let c: str = lex[i .. i + 1]
        if !str_eq(c, "_") { string_push(sb, c) }
        i = i + 1
    }
}

// The C runtime helper an intrinsic call lowers to (`""` = not a runtime intrinsic). The print
// intrinsics and the byte-level string ops all lower to `<helper>(<args>)`, which is exactly what
// `emit_arg_list` produces (and what the reference's `emit_str_binop`/print arms emit for the
// argument counts these are called with). Grown as corpus files introduce more intrinsics.
fn intrinsic_helper(read nm: str) -> str {
    if str_eq(nm, "print_str") { return "jestyr_rt_print_str" }
    if str_eq(nm, "print_int") { return "jestyr_rt_print_int" }
    if str_eq(nm, "print_bool") { return "jestyr_rt_print_bool" }
    if str_eq(nm, "print_float") { return "jestyr_rt_print_float" }
    if str_eq(nm, "str_eq") { return "jestyr_rt_str_eq" }
    if str_eq(nm, "eq_fold") { return "jestyr_rt_eq_fold" }
    if str_eq(nm, "starts_with") { return "jestyr_rt_starts_with" }
    if str_eq(nm, "ends_with") { return "jestyr_rt_ends_with" }
    if str_eq(nm, "contains") { return "jestyr_rt_contains" }
    if str_eq(nm, "find") { return "jestyr_rt_find" }
    if str_eq(nm, "trim") { return "jestyr_rt_trim" }
    if str_eq(nm, "read_file") { return "jestyr_rt_read_file" }
    if str_eq(nm, "write_file") { return "jestyr_rt_write_file" }
    if str_eq(nm, "file_exists") { return "jestyr_rt_file_exists" }
    if str_eq(nm, "remove_file") { return "jestyr_rt_remove_file" }
    if str_eq(nm, "substr") { return "jestyr_rt_substr" }
    if str_eq(nm, "count_cp") { return "jestyr_rt_count_cp" }
    if str_eq(nm, "count_graphemes") { return "jestyr_rt_count_graphemes" }
    if str_eq(nm, "to_str_lossy") { return "jestyr_rt_to_str_lossy" }
    if str_eq(nm, "string_from") { return "jestyr_rt_str_from" }
    if str_eq(nm, "cow_borrow") { return "jestyr_rt_cow_borrow" }
    if str_eq(nm, "cow_to_mut") { return "jestyr_rt_cow_to_mut" }
    if str_eq(nm, "cow_view") { return "jestyr_rt_cow_view" }
    if str_eq(nm, "cow_is_owned") { return "jestyr_rt_cow_is_owned" }
    return ""
}

// Intrinsics that take their FIRST argument by address (`<helper>(&<a0>[, rest])`) — the mutating
// owned-buffer operations. "" = not one of them.
fn intrinsic_helper_byref(read nm: str) -> str {
    if str_eq(nm, "string_push") { return "jestyr_rt_str_push" }
    if str_eq(nm, "string_view") { return "jestyr_rt_str_view" }
    if str_eq(nm, "string_free") { return "jestyr_rt_str_free" }
    if str_eq(nm, "cow_free") { return "jestyr_rt_cow_free" }
    if str_eq(nm, "builder_push") { return "jestyr_rt_b_push" }
    if str_eq(nm, "builder_build") { return "jestyr_rt_b_build" }
    if str_eq(nm, "builder_free") { return "jestyr_rt_b_free" }
    return ""
}


// An f-string (a single lexer token; the node is span-only) lowers to the reference's
// statement-expression push chain: `({ JestyrString _fs{n} = jestyr_rt_str_new(); …; _fs{n}; })`.
// The token text is re-scanned from src (like the parser dump does): literal runs push
// `JSTR("…")` verbatim; a `{name}` interp pushes by the name's TYPE — str directly, String via
// str_view, bool via a ternary, anything else as decimal via str_push_i64. Interp names resolve
// against the CURRENT fn's params and (annotated or inferred) lets — corpus interps are bare
// names; general sub-expressions would need parser support (kind-22 is span-only).
fn emit_fstring(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    string_push(sb, "({ JestyrString _fs")
    push_uint(sb, n as i64)
    string_push(sb, " = jestyr_rt_str_new(); ")
    var i: usize = e.start + 2                        // skip `f"`
    var part_start: usize = i
    for i < e.end - 1 {
        if str_eq(src[i .. i + 1], "{") {
            if i > part_start {                       // flush the literal run before the interp
                string_push(sb, "jestyr_rt_str_push(&_fs")
                push_uint(sb, n as i64)
                string_push(sb, ", JSTR(\"")
                string_push(sb, src[part_start .. i])
                string_push(sb, "\")); ")
            }
            var j: usize = i + 1
            for j < e.end - 1 {
                if str_eq(src[j .. j + 1], "}") { break }
                j = j + 1
            }
            emit_fstring_interp(sb, p, src, c, g, n, i + 1, j)
            i = j + 1
            part_start = i
        } else {
            i = i + 1
        }
    }
    if i > part_start {                               // the trailing literal run
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", JSTR(\"")
        string_push(sb, src[part_start .. i])
        string_push(sb, "\")); ")
    }
    string_push(sb, "_fs")
    push_uint(sb, n as i64)
    string_push(sb, "; })")
}

// One `{name}` interpolation: emit the push matching the name's type category.
fn emit_fstring_interp(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, n: i32, ns: usize, ne: usize) {
    let cat: i32 = fstring_cat(p, src, c, g, ns, ne)
    if cat == 0 {                                     // str: push the view directly
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", ")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, "); ")
        return
    }
    if cat == 1 {                                     // String: borrow as a view first
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", jestyr_rt_str_view(&")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, ")); ")
        return
    }
    if cat == 2 {                                     // bool: a true/false ternary
        string_push(sb, "jestyr_rt_str_push(&_fs")
        push_uint(sb, n as i64)
        string_push(sb, ", (")
        emit_fstring_name(sb, src, g, ns, ne)
        string_push(sb, ") ? JSTR(\"true\") : JSTR(\"false\")); ")
        return
    }
    string_push(sb, "jestyr_rt_str_push_i64(&_fs")    // integers (and the fallback): decimal
    push_uint(sb, n as i64)
    string_push(sb, ", (int64_t)(")
    emit_fstring_name(sb, src, g, ns, ne)
    string_push(sb, ")); ")
}

// An interp name as a C value (`j_<name>`, `(*j_<name>)` for a by-pointer param).
fn emit_fstring_name(mut sb: String, read src: str, read g: Cg, ns: usize, ne: usize) {
    if is_ptr_name(g, src, ns, ne) {
        string_push(sb, "(*j_")
        string_push(sb, src[ns .. ne])
        string_push(sb, ")")
        return
    }
    string_push(sb, "j_")
    string_push(sb, src[ns .. ne])
}

// The type CATEGORY of interp name `src[ns..ne]` in the current fn: 0 str, 1 String, 2 bool,
// 3 other (decimal). Params first, then `let`/`var` statements whose span lies inside the fn
// (annotation text, else the init's Checker prim: 14 str, 17 String, 12 bool).
fn fstring_cat(read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, ns: usize, ne: usize) -> i32 {
    if g.curfn < 0 { return 3 }
    let fd: parser.ItemData = list.get(parser.ItemData, p.it, g.curfn as usize)
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
        let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
        if str_eq(src[ns .. ne], src[pns as usize .. pne as usize]) {
            return ast_ty_cat(p, src, list.get(i32, p.iar, (base + 5) as usize))
        }
        i = i + 1
    }
    var si: usize = 0
    for si < list.len(parser.StmtData, p.st) {
        let sd: parser.StmtData = list.get(parser.StmtData, p.st, si)
        if sd.kind == 0 and sd.start >= fd.start and sd.end <= fd.end {
            if str_eq(src[ns .. ne], src[sd.x as usize .. sd.y as usize]) {
                if sd.ty >= 0 { return ast_ty_cat(p, src, sd.ty) }
                if sd.a >= 0 {
                    let tid: i32 = list.get(i32, c.et, sd.a as usize)
                    if tid >= 0 {
                        let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
                        if d.kind == 2 {
                            if d.x == 14 { return 0 }
                            if d.x == 17 { return 1 }
                            if d.x == 12 { return 2 }
                        }
                    }
                }
                return 3
            }
        }
        si = si + 1
    }
    return 3
}

// The interp category of an AST type annotation (a bare Name node's text).
fn ast_ty_cat(read p: parser.Parser, read src: str, tyid: i32) -> i32 {
    if tyid < 0 { return 3 }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 0 { return 3 }
    if str_eq(src[t.start .. t.end], "str") { return 0 }
    if str_eq(src[t.start .. t.end], "String") { return 1 }
    if str_eq(src[t.start .. t.end], "bool") { return 2 }
    return 3
}

// The TYPE KEY of a Checker type: a Named type's name, a prim's Jestyr name (both already C
// identifiers — the reference sanitises only exotic keys these can't produce).
fn push_key_of_tyid(mut sb: String, read src: str, read c: typeck.Checker, tid: i32) {
    if tid < 0 { return }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
    if d.kind == 15 {
        let kns: i32 = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
        let kne: i32 = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
        string_push(sb, src[kns as usize .. kne as usize])
        return
    }
    if d.kind == 2 { string_push(sb, prim_jname(d.x)) }
}

// The fn item of `impl <src[tns..tne]> for <key>`'s method named `src[mns..mne]`, or -1
// (used for the self/arg conventions of impl and operator dispatch).
fn find_impl_method_item(read p: parser.Parser, read src: str, tns: i32, tne: i32, read key: str, mns: i32, mne: i32) -> i32 {
    var mid: i32 = 0 - 1
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            if str_eq(src[it.x .. it.y], src[tns as usize .. tne as usize]) {
                let tt: parser.TypeData = list.get(parser.TypeData, p.ty, it.a as usize)
                if tt.kind == 0 {
                    if str_eq(src[tt.start .. tt.end], key) {
                        var k: i32 = 0
                        for k < it.z {
                            let cand: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                            let fd0: parser.ItemData = list.get(parser.ItemData, p.it, cand as usize)
                            if str_eq(src[fd0.x .. fd0.y], src[mns as usize .. mne as usize]) { mid = cand }
                            k = k + 1
                        }
                    }
                }
            }
        }
        r = r + 1
    }
    return mid
}

// An operator-trait binary op (`a + b` on a user type, icalls-recorded on the Binary id):
// `jestyr_impl_<Trait>__<key>__<m>(a, b)`. The four base ops call directly; the DERIVED
// comparisons reuse a base with a swap and/or negate: `!=` -> !eq(a,b), `>` -> lt(b,a),
// `<=` -> !lt(b,a), `>=` -> !lt(a,b). Mirrors `emit_operator_call`.
fn emit_operator_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, ob: i32) {
    let tns: i32 = list.get(i32, c.icalls, (ob + 1) as usize)
    let tne: i32 = list.get(i32, c.icalls, (ob + 2) as usize)
    let mns: i32 = list.get(i32, c.icalls, (ob + 3) as usize)
    let mne: i32 = list.get(i32, c.icalls, (ob + 4) as usize)
    let swap: bool = e.op == 10 or e.op == 9          // `>` and `<=` compare via b < a
    let negate: bool = e.op == 7 or e.op == 9 or e.op == 11   // !=, <=, >= negate their base
    var key: String = string_new()
    push_key_of_tyid(key, src, c, list.get(i32, c.et, e.a as usize))
    let mid: i32 = find_impl_method_item(p, src, tns, tne, string_view(key), mns, mne)
    var sconv: i32 = 0
    var rconv: i32 = 0
    if mid >= 0 {
        sconv = method_self_conv(p, mid)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
        var pi: i32 = 0
        for pi < fd.b {                               // the first non-self, non-comptime param
            let pb: i32 = fd.a + pi * 7
            if rconv == 0 and list.get(i32, p.iar, pb as usize) == 0 and list.get(i32, p.iar, (pb + 4) as usize) == 0 {
                rconv = list.get(i32, p.iar, (pb + 1) as usize)
            }
            pi = pi + 1
        }
    }
    var recv_id: i32 = e.a
    var arg_id: i32 = e.b
    if swap { recv_id = e.b  arg_id = e.a }
    if negate { string_push(sb, "(!") }
    string_push(sb, "jestyr_impl_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "__")
    string_push(sb, string_view(key))
    string_push(sb, "__")
    string_push(sb, src[mns as usize .. mne as usize])
    string_push(sb, "(")
    string_free(key)
    if sconv == 2 or sconv == 4 {
        string_push(sb, "&(")
        emit_expr(sb, p, src, c, g, recv_id)
        string_push(sb, ")")
    } else {
        emit_expr(sb, p, src, c, g, recv_id)
    }
    string_push(sb, ", ")
    if rconv == 2 or rconv == 4 {
        string_push(sb, "&(")
        emit_expr(sb, p, src, c, g, arg_id)
        string_push(sb, ")")
    } else {
        emit_expr(sb, p, src, c, g, arg_id)
    }
    string_push(sb, ")")
    if negate { string_push(sb, ")") }
}

// The impl-dispatch lowering shared by icalls (concrete receiver) and bcalls (bound receiver,
// key resolved through the ACTIVE substitution): a direct call of
// `jestyr_impl_<Trait>__<key>__<method>`, the receiver first (by `&` for a `mut`/`out self`),
// args honouring the resolved impl method's conventions (param 0 = self). The method name is
// the callee Field's span. Mirrors `emit_impl_call`.
fn emit_impl_dispatch(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read callee: parser.ExprData, tns: i32, tne: i32, read key: str) {
    let mns: i32 = callee.x
    let mne: i32 = callee.y
    let mid: i32 = find_impl_method_item(p, src, tns, tne, key, mns, mne)
    string_push(sb, "jestyr_impl_")
    string_push(sb, src[tns as usize .. tne as usize])
    string_push(sb, "__")
    string_push(sb, key)
    string_push(sb, "__")
    string_push(sb, src[mns as usize .. mne as usize])
    string_push(sb, "(")
    var sconv: i32 = 0
    if mid >= 0 { sconv = method_self_conv(p, mid) }
    if sconv == 2 or sconv == 4 {
        string_push(sb, "&(")
        emit_expr(sb, p, src, c, g, callee.a)
        string_push(sb, ")")
    } else {
        emit_expr(sb, p, src, c, g, callee.a)
    }
    var ai: i32 = 0
    for ai < e.y {
        string_push(sb, ", ")
        var byref: bool = false
        if mid >= 0 {
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
            if ai + 1 < fd.b {
                let pconv: i32 = list.get(i32, p.iar, (fd.a + (ai + 1) * 7 + 1) as usize)
                if pconv == 2 or pconv == 4 { byref = true }
            }
        }
        if byref { string_push(sb, "&(") }
        emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
        if byref { string_push(sb, ")") }
        ai = ai + 1
    }
    string_push(sb, ")")
}

// A call. Intrinsics (see `intrinsic_helper`) lower to `<helper>(<args>)`; `size_of(T)` lowers to
// C `sizeof(<cty>)`; a plain named call to a user function lowers to `jestyr_<name>(<args>)`.
// Method sugar and mangled/collision names later.
fn emit_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, eid: i32) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind == 5 {                             // method sugar `recv.m(args)`
        let packed: i32 = resolve_method_call(p, src, c, callee)
        if packed >= 0 {
            let sit: i32 = packed / 1000000
            let fid: i32 = packed % 1000000
            let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
            string_push(sb, "jestyr_")
            string_push(sb, src[sd.x .. sd.y])
            string_push(sb, "_")
            string_push(sb, src[callee.x as usize .. callee.y as usize])
            string_push(sb, "(")
            // The receiver is the first C argument: by address for a `mut`/`out self`.
            let sconv: i32 = method_self_conv(p, fid)
            if sconv == 2 or sconv == 4 {
                string_push(sb, "&(")
                emit_expr(sb, p, src, c, g, callee.a)
                string_push(sb, ")")
            } else {
                emit_expr(sb, p, src, c, g, callee.a)
            }
            // Then the call args, honouring the method's own param conventions (param 0 = self).
            let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
            var ai: i32 = 0
            for ai < e.y {
                string_push(sb, ", ")
                var byref: bool = false
                if ai + 1 < fd.b {
                    let pconv: i32 = list.get(i32, p.iar, (fd.a + (ai + 1) * 7 + 1) as usize)
                    if pconv == 2 or pconv == 4 { byref = true }
                }
                if byref { string_push(sb, "&(") }
                emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
                if byref { string_push(sb, ")") }
                ai = ai + 1
            }
            string_push(sb, ")")
            return
        }
        // An impl-dispatched call (recorded in the Checker's `icalls` 5-tuples): a DIRECT,
        // statically-dispatched call of `jestyr_impl_<Trait>__<TypeKey>__<method>`, the key
        // from the receiver's concrete Checker type. Mirrors the `impl_calls` arm.
        var ib: i32 = 0 - 1
        var ii: usize = 0
        for ii < list.len(i32, c.icalls) {
            if list.get(i32, c.icalls, ii) == eid { ib = ii as i32 }
            ii = ii + 5
        }
        if ib >= 0 {
            var key: String = string_new()
            push_key_of_tyid(key, src, c, list.get(i32, c.et, callee.a as usize))
            emit_impl_dispatch(sb, p, src, c, g, e, callee, list.get(i32, c.icalls, (ib + 1) as usize), list.get(i32, c.icalls, (ib + 2) as usize), string_view(key))
            string_free(key)
            return
        }
        // A bound-dispatched call inside a bracket-generic body (the Checker's `bcalls`): the
        // concrete receiver is the type param's binding in the CURRENT monomorphization — the
        // active substitution — dispatching to `impl <bound> for <that type>` (mirrors the
        // `bound_method_calls` arm).
        var bb: i32 = 0 - 1
        var bi: usize = 0
        for bi < list.len(i32, c.bcalls) {
            if list.get(i32, c.bcalls, bi) == eid { bb = bi as i32 }
            bi = bi + 5
        }
        if bb >= 0 {
            let pns: i32 = list.get(i32, c.bcalls, (bb + 3) as usize)
            let pne: i32 = list.get(i32, c.bcalls, (bb + 4) as usize)
            var key: String = string_new()
            var si: usize = 0
            for si < list.len(i32, g.su) {             // the tparam's binding in g.su
                let sns: i32 = list.get(i32, g.su, si)
                let sne: i32 = list.get(i32, g.su, si + 1)
                if str_eq(src[pns as usize .. pne as usize], src[sns as usize .. sne as usize]) {
                    let akind: i32 = list.get(i32, g.su, si + 2)
                    let aa: i32 = list.get(i32, g.su, si + 3)
                    let ab2: i32 = list.get(i32, g.su, si + 4)
                    if akind == 0 { string_push(key, src[aa as usize .. ab2 as usize]) }
                    else if akind == 1 { push_key_of_tyid(key, src, c, aa) }
                }
                si = si + 5
            }
            emit_impl_dispatch(sb, p, src, c, g, e, callee, list.get(i32, c.bcalls, (bb + 1) as usize), list.get(i32, c.bcalls, (bb + 2) as usize), string_view(key))
            string_free(key)
            return
        }
    }
    // Invoking a *thin fn-pointer* VALUE — a local/param/field whose CHECKER type is `fn(…)`
    // (the "disambiguate by field type" rule: `a.alloc_fn(x)` is a pointer call because the
    // field's type says so). Indirect: no `jestyr_` mangling; `mut`/`out` params of the fn
    // TYPE take their args by address. Mirrors `emit_fn_ptr_invoke`.
    let ctid: i32 = list.get(i32, c.et, e.a as usize)
    if ctid >= 0 {
        let ctd: typeck.TyData = list.get(typeck.TyData, c.tys, ctid as usize)
        // Invoking a CLOSURE value (Opaque("closure"), kind 18/x=0): `f.call(&f.env, args)` for
        // a named value; an inline immediately-invoked closure spills once so its env is built
        // exactly once (ONE temp). Args buffer FIRST — the reference emits them before the
        // callee, so any temps they consume number first. Mirrors `emit_closure_invoke`.
        if ctd.kind == 18 and ctd.x == 0 {
            var argv: String = string_new()
            var ai: i32 = 0
            for ai < e.y {
                string_push(argv, ", ")
                emit_expr(argv, p, src, c, g, arg_at(p, e, ai))
                ai = ai + 1
            }
            if callee.kind == 2 {
                var cs: String = string_new()
                emit_expr(cs, p, src, c, g, e.a)
                string_push(sb, string_view(cs))
                string_push(sb, ".call(&")
                string_push(sb, string_view(cs))
                string_push(sb, ".env")
                string_push(sb, string_view(argv))
                string_push(sb, ")")
                string_free(cs)
            } else {
                var lit: String = string_new()
                emit_expr(lit, p, src, c, g, e.a)
                let t: i32 = g.tmp
                g.tmp = g.tmp + 1
                string_push(sb, "({ JestyrClosure_")
                push_uint(sb, ref_expr_id(p, e.a) as i64)
                string_push(sb, " _f")
                push_uint(sb, t as i64)
                string_push(sb, " = ")
                string_push(sb, string_view(lit))
                string_push(sb, "; _f")
                push_uint(sb, t as i64)
                string_push(sb, ".call(&_f")
                push_uint(sb, t as i64)
                string_push(sb, ".env")
                string_push(sb, string_view(argv))
                string_push(sb, "); })")
                string_free(lit)
            }
            string_free(argv)
            return
        }
        if ctd.kind == 12 {
            emit_expr(sb, p, src, c, g, e.a)
            string_push(sb, "(")
            var ai: i32 = 0
            for ai < e.y {
                if ai > 0 { string_push(sb, ", ") }
                var byref: bool = false
                if ai < ctd.b {
                    let pconv: i32 = list.get(i32, c.tya, (ctd.a + ai * 2) as usize)
                    if pconv == 2 or pconv == 4 { byref = true }
                }
                if byref { string_push(sb, "&(") }
                emit_expr(sb, p, src, c, g, arg_at(p, e, ai))
                if byref { string_push(sb, ")") }
                ai = ai + 1
            }
            string_push(sb, ")")
            return
        }
    }
    if callee.kind == 21 {                            // `@address(0x…)` — a fixed-address pointer (MMIO)
        if str_eq(src[callee.x as usize .. callee.y as usize], "address") {
            string_push(sb, "((void*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "))")
            return
        }
    }
    if callee.kind == 2 {
        let nm: str = src[callee.start .. callee.end]
        // A payload-bearing variant construction `circle(2.0)` -> the tagged-union struct literal.
        let venum: i32 = find_variant_enum(p, src, callee.start, callee.end)
        if venum >= 0 {
            let own: i32 = list.get(i32, c.et, eid as usize)
            if genum_item_of(p, src, c, own) >= 0 {   // a generic-enum instance value
                emit_gvariant_head(sb, src, c, own, nm)
            } else {
                emit_variant_head(sb, p, src, venum, nm)
            }
            string_push(sb, ", .u.")
            string_push(sb, nm)
            string_push(sb, " = { ")
            var vi: i32 = 0
            for vi < e.y {
                if vi > 0 { string_push(sb, ", ") }
                emit_expr(sb, p, src, c, g, arg_at(p, e, vi))
                vi = vi + 1
            }
            string_push(sb, " } }")
            return
        }
        if str_eq(nm, "size_of") {                    // size_of(T) -> sizeof(<cty>)
            string_push(sb, "sizeof(")
            let a0: i32 = list.get(i32, p.ar, e.x as usize)
            let arg: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
            if arg.kind == 2 {                        // the type argument is a bare Name
                let tn: str = src[arg.start .. arg.end]
                let pc: str = c_prim(tn)
                if !str_eq(pc, "") { string_push(sb, pc) }
                else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
            }
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "align_of") {                   // align_of(T) -> _Alignof(<cty>)
            string_push(sb, "_Alignof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "offset_of") {                  // offset_of(T, f) -> offsetof(<cty>, j_<f>)
            string_push(sb, "offsetof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, ", j_")
            let fa: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 1) as usize)
            string_push(sb, src[fa.start .. fa.end])
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "alloc") {                      // alloc(T, n) -> ((T*) malloc((size_t)(n) * sizeof(T)))
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, "*) malloc((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, ")))")
            return
        }
        if str_eq(nm, "realloc") {                    // realloc(T, p, n)
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, "*) realloc(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, ")))")
            return
        }
        // The bytes<->str boundary: `is_utf8` checks, `from_utf8` asserts then views. Both spill
        // the byte slice into `_u` (a FIXED name — neither consumes the temp counter).
        if str_eq(nm, "is_utf8") or str_eq(nm, "from_utf8") {
            string_push(sb, "({ ")
            emit_ty_c(sb, src, c, list.get(i32, c.et, arg_at(p, e, 0) as usize))
            string_push(sb, " _u = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            if str_eq(nm, "is_utf8") {
                string_push(sb, "; jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len); })")
            } else {
                string_push(sb, "; assert(jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len)); (JestyrStr){ (const char*)_u.ptr, _u.len }; })")
            }
            return
        }
        if str_eq(nm, "bytes") {                      // str -> []u8 view (consumes a temp)
            let nb: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrStr _bv")
            push_uint(sb, nb as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrSlice_u8){ (uint8_t*)_bv")
            push_uint(sb, nb as i64)
            string_push(sb, ".ptr, _bv")
            push_uint(sb, nb as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "count_codepoints") {           // O(n) codepoint count
            string_push(sb, "jestyr_rt_count_cp(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "string_new") { string_push(sb, "jestyr_rt_str_new()")  return }
        if str_eq(nm, "builder_new") { string_push(sb, "jestyr_rt_b_new()")  return }
        if str_eq(nm, "os_from_bytes") {              // reinterpret a byte slice as an os_str view
            string_push(sb, "({ __typeof__(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") _ob = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrStr){ (const char*)_ob.ptr, _ob.len }; })")
            return
        }
        let bref: str = intrinsic_helper_byref(nm)    // `<helper>(&<a0>[, rest])`
        if !str_eq(bref, "") {
            string_push(sb, bref)
            string_push(sb, "(&")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            var bi: i32 = 1
            for bi < e.y {
                string_push(sb, ", ")
                emit_expr(sb, p, src, c, g, arg_at(p, e, bi))
                bi = bi + 1
            }
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "alloc_i32") {                  // ((int32_t*) malloc((size_t)(<n>) * sizeof(int32_t)))
            string_push(sb, "((int32_t*) malloc((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") * sizeof(int32_t)))")
            return
        }
        if str_eq(nm, "free_ptr") {                   // free(<p>)
            string_push(sb, "free(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")")
            return
        }
        if str_eq(nm, "realloc_i32") {                // ((int32_t*) realloc(<p>, (size_t)(<n>) * sizeof(int32_t)))
            string_push(sb, "((int32_t*) realloc(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ") * sizeof(int32_t)))")
            return
        }
        if str_eq(nm, "bytes") {                      // str -> []u8 view: ({ JestyrStr _bv{n} = s; (JestyrSlice_u8){ … }; })
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrStr _bv")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "; (JestyrSlice_u8){ (uint8_t*)_bv")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _bv")
            push_uint(sb, n as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "try_from_utf8") {              // validate-at-boundary: []u8 -> str !Utf8Error
            let a0: i32 = arg_at(p, e, 0)
            string_push(sb, "({ ")
            emit_ty_c(sb, src, c, list.get(i32, c.et, a0 as usize))
            string_push(sb, " _u = ")
            emit_expr(sb, p, src, c, g, a0)
            string_push(sb, "; jestyr_rt_valid_utf8((const char*)_u.ptr, _u.len) ? (JestyrResult_str){ .is_err = false, .ok = (JestyrStr){ (const char*)_u.ptr, _u.len } } : (JestyrResult_str){ .is_err = true, .err = 1 }; })")
            return
        }
        if str_eq(nm, "try_read_file") {              // B3 recoverable read: FIXED temps _s/_ok (no counter)
            string_push(sb, "({ JestyrString _s; bool _ok = jestyr_rt_try_read_file(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ", &_s); _ok ? (JestyrResult_String){ .is_err = false, .ok = _s } : (JestyrResult_String){ .is_err = true, .err = 1 }; })")
            return
        }
        if str_eq(nm, "arg_count") {                  // arg_count() -> the argv-count runtime global
            string_push(sb, "jestyr_rt_arg_count()")
            return
        }
        if str_eq(nm, "arg") {                        // arg(i) -> jestyr_rt_arg((int64_t)(<i>))
            string_push(sb, "jestyr_rt_arg((int64_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "))")
            return
        }
        if str_eq(nm, "region_alloc") {               // region_alloc(r, T, v): bump-alloc + init, plain ptr. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ ")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 1))
            string_push(sb, "* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 1))
            string_push(sb, "*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", sizeof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 1))
            string_push(sb, ")); *_p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, "); _p")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        if str_eq(nm, "region_str") {                 // region_str(r, s): copy a str into the arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ JestyrStr _sv")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "; char* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (char*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len); (JestyrStr){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", _sv")
            push_uint(sb, n as i64)
            string_push(sb, ".len }; })")
            return
        }
        if str_eq(nm, "region_concat") {              // region_concat(r, a, b): join two strs in the arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let r0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ JestyrStr _a")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "; JestyrStr _b")
            push_uint(sb, n as i64)
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, "; size_t _t")
            push_uint(sb, n as i64)
            string_push(sb, " = _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len + _b")
            push_uint(sb, n as i64)
            string_push(sb, ".len; char* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (char*)jestyr_arena_alloc(&j_")
            string_push(sb, src[r0.start .. r0.end])
            string_push(sb, ", _t")
            push_uint(sb, n as i64)
            string_push(sb, "); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, ", _a")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len); memcpy(_p")
            push_uint(sb, n as i64)
            string_push(sb, " + _a")
            push_uint(sb, n as i64)
            string_push(sb, ".len, _b")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr, _b")
            push_uint(sb, n as i64)
            string_push(sb, ".len); (JestyrStr){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", _t")
            push_uint(sb, n as i64)
            string_push(sb, " }; })")
            return
        }
        if str_eq(nm, "arena_open") {                 // arena_open(cap): heap arena, opaque handle. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrArena* _a")
            push_uint(sb, n as i64)
            string_push(sb, " = (JestyrArena*)malloc(sizeof(JestyrArena)); *_a")
            push_uint(sb, n as i64)
            string_push(sb, " = jestyr_arena_new((size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ")); (uint8_t*)_a")
            push_uint(sb, n as i64)
            string_push(sb, "; })")
            return
        }
        if str_eq(nm, "arena_alloc") {                // arena_alloc(h, T, n): bump n T's. NO temp.
            string_push(sb, "((")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 1))
            string_push(sb, "*) jestyr_arena_alloc((JestyrArena*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "), (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") * sizeof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 1))
            string_push(sb, ")))")
            return
        }
        if str_eq(nm, "arena_close") {                // arena_close(h): free the whole arena. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ JestyrArena* _a")
            push_uint(sb, n as i64)
            string_push(sb, " = (JestyrArena*)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "); jestyr_arena_free(_a")
            push_uint(sb, n as i64)
            string_push(sb, "); free(_a")
            push_uint(sb, n as i64)
            string_push(sb, "); })")
            return
        }
        if str_eq(nm, "gen_new") {                    // gen_new(T, v): allocate [gen | T], init, {ptr, gen}. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            let ty0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "({ void* _b")
            push_uint(sb, n as i64)
            string_push(sb, " = malloc(8 + sizeof(")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, ")); *(uint64_t*)_b")
            push_uint(sb, n as i64)
            string_push(sb, " = 1; ")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, "* _p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_type_arg_cty(sb, p, src, arg_at(p, e, 0))
            string_push(sb, "*)((char*)_b")
            push_uint(sb, n as i64)
            string_push(sb, " + 8); *_p")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, "); (JestyrRef_")
            string_push(sb, src[ty0.start .. ty0.end])   // elem type name = its own mangle
            string_push(sb, "){ _p")
            push_uint(sb, n as i64)
            string_push(sb, ", 1 }; })")
            return
        }
        if str_eq(nm, "gen_free") {                   // gen_free(r): bump the generation. ONE temp.
            let n: i32 = g.tmp
            g.tmp = g.tmp + 1
            string_push(sb, "({ ")
            emit_ty_c(sb, src, c, list.get(i32, c.et, arg_at(p, e, 0) as usize))
            string_push(sb, " _r")
            push_uint(sb, n as i64)
            string_push(sb, " = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, "); ((uint64_t*)_r")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr)[-1]++; })")
            return
        }
        if str_eq(nm, "slice") {                      // slice(T, ptr, n) -> (JestyrSlice_<T>){ ptr, (size_t)(n) }
            let ty0: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            string_push(sb, "(JestyrSlice_")
            string_push(sb, src[ty0.start .. ty0.end])   // elem type name = its own mangle (prim/named)
            string_push(sb, "){ ")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 1))
            string_push(sb, ", (size_t)(")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 2))
            string_push(sb, ") }")
            return
        }
        if str_eq(nm, "ok") {                         // ok(v) -> (<cur_result>){ .is_err = false, .ok = (v) }
            string_push(sb, "(")
            emit_result_name(sb, p, src, g.res_ok)
            string_push(sb, "){ .is_err = false, .ok = (")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ") }")
            return
        }
        if str_eq(nm, "err") {                        // err(E) -> (<cur_result>){ .is_err = true, .err = <tag> }
            string_push(sb, "(")
            emit_result_name(sb, p, src, g.res_ok)
            string_push(sb, "){ .is_err = true, .err = ")
            let en: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
            push_uint(sb, error_tag_of(g, src, en.start, en.end) as i64)
            string_push(sb, " }")
            return
        }
        if str_eq(nm, "unwrap") {                     // unwrap(e) -> ((e).ok)
            string_push(sb, "((")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ").ok)")
            return
        }
        if str_eq(nm, "is_err") {                     // is_err(e) -> ((e).is_err)
            string_push(sb, "((")
            emit_expr(sb, p, src, c, g, arg_at(p, e, 0))
            string_push(sb, ").is_err)")
            return
        }
        let helper: str = intrinsic_helper(nm)
        if !str_eq(helper, "") {
            string_push(sb, helper)
            emit_arg_list(sb, p, src, c, g, e)
            return
        }
        // An `extern "c"` callee is invoked by its BARE name (resolved by the linker);
        // `mut`/`out` params still take the argument by address.
        let xit: i32 = find_extern_item(p, src, nm)
        if xit >= 0 {
            string_push(sb, nm)
            emit_args_for_item(sb, p, src, c, g, e, xit)
            return
        }
        // Plain user function: mangle to `jestyr_<name>`. A `mut`/`out` parameter takes the
        // argument by address (`&(arg)`), so look up the callee's param conventions.
        // A call to a generic template monomorphizes: `jestyr_<name>__<mangles>` with the
        // comptime type args erased (mirrors `emit_generic_call`).
        let ufit: i32 = find_fn_item(p, src, nm)
        if ufit >= 0 {
            let uf: parser.ItemData = list.get(parser.ItemData, p.it, ufit as usize)
            if fn_is_gen(p, uf) {
                emit_generic_call(sb, p, src, c, g, e, ufit)
                return
            }
        }
        string_push(sb, "jestyr_")
        string_push(sb, nm)
        emit_user_args(sb, p, src, c, g, e, nm)
        return
    }
}

// One C prototype per `extern "c"` declaration (bare name, linker-resolved), + a blank iff any.
// Params render `<cty>[*] j_<name>` with NO `restrict` (a foreign fn makes no aliasing promise).
fn emit_extern_protos(mut sb: String, read p: parser.Parser, read src: str) {
    var any: bool = false
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 8 {
            any = true
            emit_c_ty(sb, p, src, it.z)               // ret type (-1 = void)
            string_push(sb, " ")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, "(")
            var emitted: i32 = 0
            var i: i32 = 0
            for i < it.b {
                let base: i32 = it.a + i * 7
                if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
                    if emitted > 0 { string_push(sb, ", ") }
                    let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
                    emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                    if conv == 2 or conv == 4 { string_push(sb, "*") }
                    string_push(sb, " j_")
                    string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
                    emitted = emitted + 1
                }
                i = i + 1
            }
            if emitted == 0 { string_push(sb, "void") }
            string_push(sb, ");\n")
        }
        r = r + 1
    }
    if any { string_push(sb, "\n") }
}

// The item id of an `extern "c"` fn named `src[ns..ne]`… by name, or -1.
fn find_extern_item(read p: parser.Parser, read src: str, read nm: str) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 8 {
            if str_eq(src[it.x .. it.y], nm) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// The `(args)` list for a call whose callee item id is known (mut/out params by `&()`).
fn emit_args_for_item(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, fit: i32) {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {
        if i > 0 { string_push(sb, ", ") }
        var byref: bool = false
        if i < it.b {
            let conv: i32 = list.get(i32, p.iar, (it.a + i * 7 + 1) as usize)
            if conv == 2 or conv == 4 { byref = true }
        }
        if byref { string_push(sb, "&(") }
        emit_expr(sb, p, src, c, g, arg_at(p, e, i))
        if byref { string_push(sb, ")") }
        i = i + 1
    }
    string_push(sb, ")")
}

// The `ExprId` of a Call node's `i`th argument (`(x,y)` = arg slice into `ar`).
fn arg_at(read p: parser.Parser, read e: parser.ExprData, i: i32) -> i32 {
    return list.get(i32, p.ar, (e.x + i) as usize)
}

// A bare-Name *type argument* (`size_of(T)`-style) rendered as its C type.
fn emit_type_arg_cty(mut sb: String, read p: parser.Parser, read src: str, aid: i32) {
    let arg: parser.ExprData = list.get(parser.ExprData, p.ex, aid as usize)
    if arg.kind == 2 {
        let tn: str = src[arg.start .. arg.end]
        let pc: str = c_prim(tn)
        if !str_eq(pc, "") { string_push(sb, pc) }
        else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
    }
}

// Emit a user call's `(arg0, arg1, …)` list, taking each `mut`/`out` parameter by address. The
// callee's param conventions come from its Fn item (found by name); an unknown callee (or a
// variadic mismatch) falls back to by-value, which is correct for all-default signatures.
fn emit_user_args(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read nm: str) {
    let fit: i32 = find_fn_item(p, src, nm)
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {
        if i > 0 { string_push(sb, ", ") }
        var byref: bool = false
        if fit >= 0 {
            let it: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
            if i < it.b {
                let conv: i32 = list.get(i32, p.iar, (it.a + i * 7 + 1) as usize)
                if conv == 2 or conv == 4 { byref = true }
            }
        }
        if byref { string_push(sb, "&(") }
        emit_expr(sb, p, src, c, g, arg_at(p, e, i))
        if byref { string_push(sb, ")") }
        i = i + 1
    }
    string_push(sb, ")")
}

// The item index of a top-level Fn named `nm`, or -1 if none.
fn find_fn_item(read p: parser.Parser, read src: str, read nm: str) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], nm) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// The `(a0, a1, …)` argument list of a Call node (`(x,y)` = arg slice into `ar`).
fn emit_arg_list(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData) {
    string_push(sb, "(")
    var i: i32 = 0
    for i < e.y {                                     // y = arg_count
        if i > 0 { string_push(sb, ", ") }
        let aid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
        emit_expr(sb, p, src, c, g, aid)
        i = i + 1
    }
    string_push(sb, ")")
}

// ---- statements / body (mirrors Cgen::emit_body / emit_stmt / emit_return / emit_if) ----
fn indent(mut sb: String, depth: i32) {
    var i: i32 = 0
    for i < depth { string_push(sb, "    ")  i = i + 1 }
}

// A whole `<indent>text\n` line at `depth`.
fn line_at(mut sb: String, depth: i32, read text: str) {
    indent(sb, depth)
    string_push(sb, text)
    string_push(sb, "\n")
}

// Mutable per-program emitter state (mirrors the reference's `Cgen` fields as they're needed).
// `tmp` is the shared unique-temporary counter (`_hi{n}` loop bounds, `_s{n}` slice spills, …) —
// global across the program, never reset per fn, exactly like the reference. `pp` holds the
// current fn's by-pointer (`mut`/`out`) parameter name spans as (ns, ne) pairs — uses render
// `(*j_<name>)`; a `for mut x in xs` binding joins temporarily. `rf` is the refinement stack:
// (ns, ne, range `ExprId`) triples for each enclosing exclusive `for i in 0..s.len` loop, so a
// provably-in-range `s[i]` elides its bounds check (mirrors `cur_refines`/`index_in_range`).
// `mv` holds the current fn's *moved-out* local-name spans (ns,ne pairs — the reference's
// `cur_moved`; only `emit_fn` populates it, method/impl bodies run with it empty). `ds` is the
// flattened drop-scope stack: 4-int entries (local ns, ne, type-name ns, ne) of live droppable
// locals; `dsb` holds each open scope's start offset into `ds`. `autoret` marks a method/impl body
// (the reference's empty `cur_ret_cty`) so a spilled return uses `__auto_type`.
// `bl_*` is the innermost loop-with-`else` break label a plain `break` must `goto` (the
// reference's `break_label`): a user label span (`bl_ns`,`bl_ne`) or a synthesized `_fe<bl_fe>`;
// all -1 when the nearest loop has no `else` (plain C `break` is right). `cl_*` is an armed
// labeled-loop continue-target span (the reference's `cont_label`), consumed — `.take()` — by
// the FIRST loop body that closes after arming.
// `sr_*` is a region-scoped loop's armed scratch-arena name span (the reference's
// `scratch_reset`), consumed — `.take()` — at the top of the next loop body. `vt` holds the
// current loop's hoisted `variant`-tracker (ExprId, temp) pairs with `vtf` the active loop's
// floor (the reference REPLACES `variant_trackers` per loop; the floor models that on a flat
// list, and inner loops save/restore both).
// `gfi` holds the collected generic-fn instance records ([fn item, argc, (kind,a,b) targ
// triples…], variable length — walk with a cursor); `su` is the ACTIVE instance's
// type-parameter substitution (5-tuples: tparam span + arg triple), read by `emit_su_ty`.
struct Cg { tmp: i32, pp: List(i32), rf: List(i32), res_ok: i32, etags: List(i32), req: List(i32), ens: List(i32), retty: i32, mi: List(i32), self_ptr: bool, gei: List(i32), curfn: i32, mv: List(i32), ds: List(i32), dsb: List(i32), autoret: bool, bl_ns: i32, bl_ne: i32, bl_fe: i32, cl_ns: i32, cl_ne: i32, sr_ns: i32, sr_ne: i32, vt: List(i32), vtf: i32, gfi: List(i32), su: List(i32), cls: List(i32), ccx: List(i32), cca: List(i32), caps: List(i32) }

// The integer tag of an error name `src[ns..ne]` in the whole-program tag map (`etags` holds
// (start,end) src-span pairs, first-seen order across every fn's error set; tag = index + 1).
// Mirrors the reference's `error_tags` (built in `emit_program`). 0 = unknown.
fn error_tag_of(read g: Cg, read src: str, ns: usize, ne: usize) -> i32 {
    var i: usize = 0
    for i < list.len(i32, g.etags) {
        let es: i32 = list.get(i32, g.etags, i)
        let ee: i32 = list.get(i32, g.etags, i + 1)
        if str_eq(src[ns .. ne], src[es as usize .. ee as usize]) { return (i / 2 + 1) as i32 }
        i = i + 2
    }
    return 0
}

// Is Fn item `it` a monomorphization template — a bracket-form `[T: Bound]` generic (`it.h` > 0)
// or a `comptime T: type` parameter (comp==1, type = TypeKw)? Templates are never emitted
// directly (mirrors `is_generic_ast`). A comptime VALUE param also suppresses emission
// (`fn_supported_ast`'s other half) — both are "skip this fn" here.
fn fn_is_template(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.h > 0 { return true }                       // bracket generics
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 { // a comptime param (type OR value)
            return true
        }
        i = i + 1
    }
    return false
}

// Is the top-level Fn item `it` fallible (has a non-empty `!{…}` error set)? The `far` extras
// block at `it.e` starts with the error count.
fn fn_is_fallible(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.e < 0 { return false }
    return list.get(i32, p.far, it.e as usize) > 0
}

// Emit a fallible fn's C result type name `JestyrResult_<mangle(ok)>` (ok = `it.z`, -1 = unit).
fn emit_result_name(mut sb: String, read p: parser.Parser, read src: str, ok_ty: i32) {
    string_push(sb, "JestyrResult_")
    if ok_ty < 0 { string_push(sb, "unit") } else { push_ast_mangle(sb, p, src, ok_ty) }
}

// Assign every error name (across all fns' `!{…}` sets, in item then declaration order) a distinct
// 1-based tag, recorded as (start,end) span pairs in `g.etags` (first-seen wins). Mirrors the
// reference's `error_tags` pass in `emit_program`.
fn build_error_tags(mut g: Cg, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and it.e >= 0 {
            let ecount: i32 = list.get(i32, p.far, it.e as usize)
            var k: i32 = 0
            for k < ecount {
                let ns: i32 = list.get(i32, p.far, (it.e + 1 + k * 2) as usize)
                let ne: i32 = list.get(i32, p.far, (it.e + 2 + k * 2) as usize)
                if error_tag_of(g, src, ns as usize, ne as usize) == 0 {
                    list.push(i32, g.etags, ns)
                    list.push(i32, g.etags, ne)
                }
                k = k + 1
            }
        }
        r = r + 1
    }
}

// Is `src[ns..ne]` currently a by-pointer name (a `mut`/`out` param or a `for mut x` binding)?
fn is_ptr_name(read g: Cg, read src: str, ns: usize, ne: usize) -> bool {
    var i: usize = 0
    for i < list.len(i32, g.pp) {
        let pns: i32 = list.get(i32, g.pp, i)
        let pne: i32 = list.get(i32, g.pp, i + 1)
        if str_eq(src[ns .. ne], src[pns as usize .. pne as usize]) { return true }
        i = i + 2
    }
    return false
}

// ---- generic-FUNCTION monomorphization (mirrors collect_all_instances / mangle / make_subst /
// emit_generic_call — slice 1: free-fn instances found in NON-template bodies; walking instance
// bodies for nested generic calls, structural unification, and generic-struct methods are later
// increments) ----

// Is Fn item `it` a monomorphizable generic template — bracket `[T]` generics or a `comptime
// T: type` parameter? (A comptime VALUE param also suppresses direct emission — fn_is_template —
// but such a fn is never instantiated; mirrors the reference's `generics` set.)
fn fn_is_gen(read p: parser.Parser, read it: parser.ItemData) -> bool {
    if it.h > 0 { return true }
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 { return true }        // `comptime T: type`
            }
        }
        i = i + 1
    }
    return false
}

// One instance type argument as a (kind, a, b) triple: kind 0 = an explicit bare-Name comptime
// type arg (a,b = its source span), kind 1 = an inferred Checker TyId (a), kind 2 = unresolved
// (mangles `x`, like the reference's Ty::Unknown).
fn push_targ_mangle(mut sb: String, read src: str, read c: typeck.Checker, kind: i32, a: i32, b: i32) {
    if kind == 0 { string_push(sb, src[a as usize .. b as usize])  return }
    if kind == 1 { push_ty_mangle(sb, src, c, a)  return }
    string_push(sb, "x")
}
fn emit_targ_cty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, kind: i32, a: i32, b: i32) {
    if kind == 0 {
        let tn: str = src[a as usize .. b as usize]
        let pc: str = c_prim(tn)
        if !str_eq(pc, "") { string_push(sb, pc) } else { string_push(sb, "Jestyr_")  string_push(sb, tn) }
        return
    }
    if kind == 1 { emit_ty_c(sb, src, c, a)  return }
    string_push(sb, "int")
}

// Like `emit_c_ty`, but a bare Name matching the active type-parameter substitution (`g.su`
// 5-tuples: tparam span, then the arg triple) renders the instance's concrete C type. Used for
// instance SIGNATURES; template-body lets under subst are a later increment.
fn emit_su_ty(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read g: Cg, tyid: i32) {
    if tyid >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
        if t.kind == 0 {
            var i: usize = 0
            for i < list.len(i32, g.su) {
                let ns: i32 = list.get(i32, g.su, i)
                let ne: i32 = list.get(i32, g.su, i + 1)
                if str_eq(src[t.start .. t.end], src[ns as usize .. ne as usize]) {
                    emit_targ_cty(sb, p, src, c, list.get(i32, g.su, i + 2), list.get(i32, g.su, i + 3), list.get(i32, g.su, i + 4))
                    return
                }
                i = i + 5
            }
        }
    }
    emit_c_ty(sb, p, src, tyid)
}

// A generic CALL's type arguments in instance order — explicit comptime type args (bare-Name
// exprs at the comptime-type param positions) first, then each bracket param inferred by
// unifying the params' bare-Name annotations against the args' Checker types (first bind wins;
// structural unification through slices/pointers is a later increment). Appends (kind, a, b)
// triples to `dst`; returns the count. Mirrors `emit_generic_call`'s targ assembly +
// `infer_bracket_args`.
fn gcall_targs(mut dst: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, fit: i32, read e: parser.ExprData) -> i32 {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    var count: i32 = 0
    var i: i32 = 0
    for i < f.b {
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 and i < e.y {
                    let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, i) as usize)
                    if ax.kind == 2 {
                        list.push(i32, dst, 0)
                        list.push(i32, dst, ax.start as i32)
                        list.push(i32, dst, ax.end as i32)
                    } else {
                        list.push(i32, dst, 2)
                        list.push(i32, dst, 0 - 1)
                        list.push(i32, dst, 0 - 1)
                    }
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // bracket params, declaration order
        let gb: i32 = f.g + gk * 4
        let gns: i32 = list.get(i32, p.gar, gb as usize)
        let gne: i32 = list.get(i32, p.gar, (gb + 1) as usize)
        var bkind: i32 = 2
        var ba: i32 = 0 - 1
        var pi: i32 = 0
        for pi < f.b {
            let pb: i32 = f.a + pi * 7
            let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
            if bkind == 2 and pty >= 0 and pi < e.y and list.get(i32, p.iar, pb as usize) == 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 0 {
                    if str_eq(src[t.start .. t.end], src[gns as usize .. gne as usize]) {
                        let atid: i32 = list.get(i32, c.et, arg_at(p, e, pi) as usize)
                        if atid >= 0 { bkind = 1  ba = atid }
                    }
                }
            }
            pi = pi + 1
        }
        list.push(i32, dst, bkind)
        list.push(i32, dst, ba)
        list.push(i32, dst, 0 - 1)
        count = count + 1
        gk = gk + 1
    }
    return count
}

// The mangled C name `jestyr_<name>__<m0>_<m1>…` of the instance record at `lst[rb..]`
// ([fn item, argc, (kind,a,b)…] — the shared shape of the worklist and `g.gfi`).
fn push_gfn_name(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, read lst: List(i32), rb: i32) {
    let fit: i32 = list.get(i32, lst, rb as usize)
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "jestyr_")
    string_push(sb, src[f.x .. f.y])
    string_push(sb, "__")
    let argc: i32 = list.get(i32, lst, (rb + 1) as usize)
    var i: i32 = 0
    for i < argc {
        if i > 0 { string_push(sb, "_") }
        let ab: i32 = rb + 2 + i * 3
        push_targ_mangle(sb, src, c, list.get(i32, lst, ab as usize), list.get(i32, lst, (ab + 1) as usize), list.get(i32, lst, (ab + 2) as usize))
        i = i + 1
    }
}

// If Call `e` targets a generic template, append its instance record to the worklist.
fn gfind_call_check(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, read e: parser.ExprData) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 2 { return }
    let fit: i32 = find_fn_item(p, src, src[callee.start .. callee.end])
    if fit < 0 { return }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    if !fn_is_gen(p, f) { return }
    let rb: i32 = list.len(i32, wk) as i32
    list.push(i32, wk, fit)
    list.push(i32, wk, 0)
    let argc: i32 = gcall_targs(wk, p, src, c, fit, e)
    list.set(i32, wk, (rb + 1) as usize, argc)
    list.push(i32, wks, rb)
}

fn gfind_expr(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 10 {                                 // Call: recurse callee + args FIRST, then check
        gfind_expr(wk, wks, p, src, c, e.a)
        var i: i32 = 0
        for i < e.y {
            gfind_expr(wk, wks, p, src, c, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        gfind_call_check(wk, wks, p, src, c, e)
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {   // Binary / Index / Assign
        gfind_expr(wk, wks, p, src, c, e.a)
        gfind_expr(wk, wks, p, src, c, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 11 or e.kind == 34 or e.kind == 35 {
        gfind_expr(wk, wks, p, src, c, e.a)
        return
    }
    if e.kind == 13 {
        if e.a >= 0 { gfind_expr(wk, wks, p, src, c, e.a) }
        if e.b >= 0 { gfind_expr(wk, wks, p, src, c, e.b) }
        return
    }
    if e.kind == 16 {                                 // StructLit fields + spread
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            gfind_expr(wk, wks, p, src, c, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { gfind_expr(wk, wks, p, src, c, e.b) }
        return
    }
    if e.kind == 17 {                                 // GenStructLit fields
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            gfind_expr(wk, wks, p, src, c, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {                                 // If
        gfind_expr(wk, wks, p, src, c, e.a)
        gfind_block(wk, wks, p, src, c, e.b)
        if e.op >= 0 { gfind_expr(wk, wks, p, src, c, e.op) }
        return
    }
    if e.kind == 23 { gfind_block(wk, wks, p, src, c, eid)  return }
    if e.kind == 25 or e.kind == 43 { gfind_block(wk, wks, p, src, c, e.a)  return }   // Unsafe / Region
    if e.kind == 28 {                                 // Match
        gfind_expr(wk, wks, p, src, c, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { gfind_expr(wk, wks, p, src, c, guard) }
            gfind_expr(wk, wks, p, src, c, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For
        if e.op == 1 { gfind_expr(wk, wks, p, src, c, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                gfind_expr(wk, wks, p, src, c, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        gfind_block(wk, wks, p, src, c, e.b)
        if e.x >= 0 { gfind_block(wk, wks, p, src, c, e.x) }
        return
    }
}

fn gfind_block(mut wk: List(i32), mut wks: List(i32), read p: parser.Parser, read src: str, read c: typeck.Checker, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { gfind_expr(wk, wks, p, src, c, s.a) }
        i = i + 1
    }
}

// Collect every generic-function instance: scan each non-template fn body + concrete
// impl-method body for template calls (expression order), then drain the worklist LIFO — the
// reference pops a STACK, so instances land in REVERSE discovery order — deduping on the
// mangled name into `g.gfi`.
fn collect_gfn_instances(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read a: Allocator) {
    var wk: List(i32) = list.make(i32, a)
    var wks: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) { gfind_block(wk, wks, p, src, c, it.w) }
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + k) as usize) as usize)
                gfind_block(wk, wks, p, src, c, fd.w)
                k = k + 1
            }
        }
        r = r + 1
    }
    var seen: String = string_new()
    for list.len(i32, wks) > 0 {
        let rb: i32 = list.get(i32, wks, list.len(i32, wks) - 1)
        list.truncate(i32, wks, list.len(i32, wks) - 1)
        var probe: String = string_new()
        string_push(probe, "|")
        push_gfn_name(probe, p, src, c, wk, rb)
        string_push(probe, "|")
        if !contains(string_view(seen), string_view(probe)) {
            string_push(seen, string_view(probe))
            let argc: i32 = list.get(i32, wk, (rb + 1) as usize)
            var t: i32 = 0
            for t < 2 + argc * 3 {
                list.push(i32, g.gfi, list.get(i32, wk, (rb + t) as usize))
                t = t + 1
            }
        }
        string_free(probe)
    }
    string_free(seen)
}

// The instance's signature `<ret> jestyr_<name>__<mangles>(<params>)` under its substitution:
// arms `g.su` (tparam spans in instance order — comptime-type names, then brackets — zipped
// with the record's arg triples) and leaves it set for the body; the caller clears it.
fn emit_gfn_sig(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, rb: i32) {
    let fit: i32 = list.get(i32, g.gfi, rb as usize)
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    list.truncate(i32, g.su, 0)
    var ai: i32 = 0
    var i: i32 = 0
    for i < f.b {                                     // comptime-type param names first
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 {
                    let ab: i32 = rb + 2 + ai * 3
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 2) as usize))
                    list.push(i32, g.su, list.get(i32, p.iar, (base + 3) as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, ab as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, (ab + 1) as usize))
                    list.push(i32, g.su, list.get(i32, g.gfi, (ab + 2) as usize))
                    ai = ai + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // then the bracket params
        let gb: i32 = f.g + gk * 4
        let ab: i32 = rb + 2 + ai * 3
        list.push(i32, g.su, list.get(i32, p.gar, gb as usize))
        list.push(i32, g.su, list.get(i32, p.gar, (gb + 1) as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, ab as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, (ab + 1) as usize))
        list.push(i32, g.su, list.get(i32, g.gfi, (ab + 2) as usize))
        ai = ai + 1
        gk = gk + 1
    }
    emit_su_ty(sb, p, src, c, g, f.z)
    string_push(sb, " ")
    push_gfn_name(sb, p, src, c, g.gfi, rb)
    string_push(sb, "(")
    var emitted: i32 = 0
    var pi: i32 = 0
    for pi < f.b {
        let base: i32 = f.a + pi * 7
        if list.get(i32, p.iar, base as usize) == 0 and list.get(i32, p.iar, (base + 4) as usize) == 0 {
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            emit_su_ty(sb, p, src, c, g, list.get(i32, p.iar, (base + 5) as usize))
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
            string_push(sb, " j_")
            string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            emitted = emitted + 1
        }
        pi = pi + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// A generic call site: `jestyr_<name>__<mangles>(<args sans comptime-type args>)`, `mut`/`out`
// args by address. The mangle recomputation must agree with `gcall_targs` exactly.
fn emit_generic_call(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, fit: i32) {
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
    string_push(sb, "jestyr_")
    string_push(sb, src[f.x .. f.y])
    string_push(sb, "__")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < f.b {                                     // explicit comptime type args
        let base: i32 = f.a + i * 7
        if list.get(i32, p.iar, base as usize) == 1 {
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            if pty >= 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 1 and i < e.y {
                    if emitted > 0 { string_push(sb, "_") }
                    let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, i) as usize)
                    if ax.kind == 2 { string_push(sb, src[ax.start .. ax.end]) } else { string_push(sb, "x") }
                    emitted = emitted + 1
                }
            }
        }
        i = i + 1
    }
    var gk: i32 = 0
    for gk < f.h {                                    // inferred bracket args
        let gb: i32 = f.g + gk * 4
        let gns: i32 = list.get(i32, p.gar, gb as usize)
        let gne: i32 = list.get(i32, p.gar, (gb + 1) as usize)
        var bound: i32 = 0 - 1
        var pi: i32 = 0
        for pi < f.b {
            let pb: i32 = f.a + pi * 7
            let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
            if bound < 0 and pty >= 0 and pi < e.y and list.get(i32, p.iar, pb as usize) == 0 {
                let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                if t.kind == 0 {
                    if str_eq(src[t.start .. t.end], src[gns as usize .. gne as usize]) {
                        let atid: i32 = list.get(i32, c.et, arg_at(p, e, pi) as usize)
                        if atid >= 0 { bound = atid }
                    }
                }
            }
            pi = pi + 1
        }
        if emitted > 0 { string_push(sb, "_") }
        if bound >= 0 { push_ty_mangle(sb, src, c, bound) } else { string_push(sb, "x") }
        emitted = emitted + 1
        gk = gk + 1
    }
    string_push(sb, "(")
    var wrote: i32 = 0
    var aidx: i32 = 0
    for aidx < e.y {
        var is_targ: bool = false
        if aidx < f.b {
            let pb: i32 = f.a + aidx * 7
            if list.get(i32, p.iar, pb as usize) == 1 {
                let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
                if pty >= 0 {
                    let t: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                    if t.kind == 1 { is_targ = true }  // a type argument — erased
                }
            }
        }
        if !is_targ {
            if wrote > 0 { string_push(sb, ", ") }
            var conv: i32 = 0
            if aidx < f.b { conv = list.get(i32, p.iar, (f.a + aidx * 7 + 1) as usize) }
            if conv == 2 or conv == 4 {
                string_push(sb, "&(")
                emit_expr(sb, p, src, c, g, arg_at(p, e, aidx))
                string_push(sb, ")")
            } else {
                emit_expr(sb, p, src, c, g, arg_at(p, e, aidx))
            }
            wrote = wrote + 1
        }
        aidx = aidx + 1
    }
    string_push(sb, ")")
}

// ---- RAII drop glue (mirrors needs_drop / emit_drop_place / emit_all_drops / collect_moved) ----

// The item id of the top-level struct/enum/distinct declaring the type named `src[ns..ne]`, or -1.
fn find_named_item(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 or it.kind == 5 or it.kind == 1 {
            if str_eq(src[it.x .. it.y], src[ns as usize .. ne as usize]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Is there a concrete `impl Drop for <name>` (kind 7, non-generic, trait "Drop", a Name target)?
// Mirrors `drop_key_of` for named receivers; blanket generic Drop impls are a later increment.
fn has_drop_impl(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> bool {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            if str_eq(src[it.x .. it.y], "Drop") {
                let tt: parser.TypeData = list.get(parser.TypeData, p.ty, it.a as usize)
                if tt.kind == 0 {
                    if str_eq(src[tt.start .. tt.end], src[ns as usize .. ne as usize]) { return true }
                }
            }
        }
        r = r + 1
    }
    return false
}

// Does variant `k` of enum item `it` carry a payload field that needs drop?
fn variant_droppable(read p: parser.Parser, read src: str, read it: parser.ItemData, k: i32) -> bool {
    let vb: i32 = it.b + k * 5
    let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
    let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
    var fi: i32 = 0
    for fi < fc {
        if needs_drop_ast_ty(p, src, list.get(i32, p.ear, (fs + fi * 3 + 2) as usize)) { return true }
        fi = fi + 1
    }
    return false
}

// Does a value of the named type `src[ns..ne]` need drop glue — its own `Drop` impl, or an owned
// struct field / enum payload that transitively does? Indirection (pointers/references) is never
// followed, which also bounds the recursion (a by-value aggregate can't contain itself). An
// untagged `union` has no single live field, so it never auto-drops. (The reference short-circuits
// on `is_copy` first; that check is inert here — a `@copy` aggregate can't own droppables, so it
// can only reach `false` through these same paths.)
fn needs_drop_name(read p: parser.Parser, read src: str, ns: i32, ne: i32) -> bool {
    if has_drop_impl(p, src, ns, ne) { return true }
    let iid: i32 = find_named_item(p, src, ns, ne)
    if iid < 0 { return false }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
    if it.kind == 4 and it.op != 2 {                  // struct/record (not union): any owned field?
        var i: i32 = 0
        for i < it.b {
            let mb: i32 = it.a + i * 10
            if list.get(i32, p.mar, mb as usize) == 0 {           // a field (tag 0)
                if needs_drop_ast_ty(p, src, list.get(i32, p.mar, (mb + 4) as usize)) { return true }
            }
            i = i + 1
        }
    }
    if it.kind == 5 and it.a == 0 {                   // non-generic enum: any droppable payload?
        var k: i32 = 0
        for k < it.z {
            if variant_droppable(p, src, it, k) { return true }
            k = k + 1
        }
    }
    return false
}

// `needs_drop` for an AST type annotation: only a bare Name type can be droppable (pointers,
// slices, arrays, refs are indirection or non-owning — the reference reaches the same `false`).
fn needs_drop_ast_ty(read p: parser.Parser, read src: str, tyid: i32) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind == 0 { return needs_drop_name(p, src, t.start as i32, t.end as i32) }
    return false
}

// Emit drop glue for the value at C lvalue `place` of the named type `src[tns..tne]`: its own
// `Drop::drop` first (receiver by `&place`), then — additively — each owned struct field / live
// enum payload in reverse declaration order. Every line lands flat at `depth` (the reference's
// `self.line`, whose depth never changes inside the walker — even the switch/case lines).
fn emit_drop_place(mut sb: String, read p: parser.Parser, read src: str, read place: str, tns: i32, tne: i32, depth: i32) {
    if has_drop_impl(p, src, tns, tne) {
        indent(sb, depth)
        string_push(sb, "jestyr_impl_Drop__")
        string_push(sb, src[tns as usize .. tne as usize])   // a Name key is already a C identifier
        string_push(sb, "__drop(&")
        string_push(sb, place)
        string_push(sb, ");\n")
    }
    let iid: i32 = find_named_item(p, src, tns, tne)
    if iid < 0 { return }
    let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
    if it.kind == 4 {
        if it.op == 2 { return }                      // untagged union: never auto-drop fields
        var i: i32 = it.b - 1
        for i >= 0 {                                  // owned fields, reverse declaration order
            let mb: i32 = it.a + i * 10
            if list.get(i32, p.mar, mb as usize) == 0 {
                let fty: i32 = list.get(i32, p.mar, (mb + 4) as usize)
                if needs_drop_ast_ty(p, src, fty) {
                    let ftd: parser.TypeData = list.get(parser.TypeData, p.ty, fty as usize)
                    var cp: String = string_new()
                    string_push(cp, place)
                    string_push(cp, ".j_")
                    string_push(cp, src[list.get(i32, p.mar, (mb + 2) as usize) as usize .. list.get(i32, p.mar, (mb + 3) as usize) as usize])
                    emit_drop_place(sb, p, src, string_view(cp), ftd.start as i32, ftd.end as i32, depth)
                    string_free(cp)
                }
            }
            i = i - 1
        }
        return
    }
    if it.kind == 5 and it.a == 0 {                   // live enum payload: switch on the tag
        var any: bool = false
        var k0: i32 = 0
        for k0 < it.z {
            if variant_droppable(p, src, it, k0) { any = true }
            k0 = k0 + 1
        }
        if !any { return }
        let en: str = src[it.x .. it.y]
        indent(sb, depth)
        string_push(sb, "switch (")
        string_push(sb, place)
        string_push(sb, ".tag) {\n")
        var k: i32 = 0
        for k < it.z {                                // droppable variants contribute a `case` each
            if variant_droppable(p, src, it, k) {
                let vb: i32 = it.b + k * 5
                let vname: str = src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize]
                indent(sb, depth)
                string_push(sb, "case Jestyr_")
                string_push(sb, en)
                string_push(sb, "_")
                string_push(sb, vname)
                string_push(sb, ": {\n")
                let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
                let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                var fi: i32 = fc - 1
                for fi >= 0 {                         // payload fields, reverse declaration order
                    let fb: i32 = fs + fi * 3
                    let pfty: i32 = list.get(i32, p.ear, (fb + 2) as usize)
                    if needs_drop_ast_ty(p, src, pfty) {
                        let ftd: parser.TypeData = list.get(parser.TypeData, p.ty, pfty as usize)
                        var cp: String = string_new()
                        string_push(cp, place)
                        string_push(cp, ".u.")
                        string_push(cp, vname)
                        string_push(cp, ".j_")
                        string_push(cp, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                        emit_drop_place(sb, p, src, string_view(cp), ftd.start as i32, ftd.end as i32, depth)
                        string_free(cp)
                    }
                    fi = fi - 1
                }
                line_at(sb, depth, "break;")
                line_at(sb, depth, "}")
            }
            k = k + 1
        }
        line_at(sb, depth, "default: break;")
        line_at(sb, depth, "}")
    }
}

// Open a drop scope for a `{ }` block (records the current entry-list length).
fn drop_scope_enter(mut g: Cg) {
    list.push(i32, g.dsb, list.len(i32, g.ds) as i32)
}

// Emit one registered local's drop glue: `j_<name>` of its recorded type.
fn emit_local_drop(mut sb: String, read p: parser.Parser, read src: str, read g: Cg, base: i32, depth: i32) {
    var place: String = string_new()
    string_push(place, "j_")
    string_push(place, src[list.get(i32, g.ds, base as usize) as usize .. list.get(i32, g.ds, (base + 1) as usize) as usize])
    emit_drop_place(sb, p, src, string_view(place), list.get(i32, g.ds, (base + 2) as usize), list.get(i32, g.ds, (base + 3) as usize), depth)
    string_free(place)
}

// Close the innermost drop scope, dropping its locals in reverse declaration order (the normal
// fall-through path).
fn drop_scope_exit_emit(mut sb: String, read p: parser.Parser, read src: str, mut g: Cg, depth: i32) {
    let floor: i32 = list.get(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.dsb, list.len(i32, g.dsb) - 1)
    var i: i32 = list.len(i32, g.ds) as i32 - 4
    for i >= floor {
        emit_local_drop(sb, p, src, g, i, depth)
        i = i - 4
    }
    list.truncate(i32, g.ds, floor as usize)
}

// Close the innermost drop scope without emitting (the block already diverged via a `return`,
// which dropped everything).
fn drop_scope_exit_discard(mut g: Cg) {
    let floor: i32 = list.get(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.dsb, list.len(i32, g.dsb) - 1)
    list.truncate(i32, g.ds, floor as usize)
}

// Drop every live local across all open scopes, innermost first — the cleanup run *before* a
// `return`. Does not pop: the C locals stay in scope until the `return` that follows.
fn emit_all_drops(mut sb: String, read p: parser.Parser, read src: str, read g: Cg, depth: i32) {
    var i: i32 = list.len(i32, g.ds) as i32 - 4
    for i >= 0 {
        emit_local_drop(sb, p, src, g, i, depth)
        i = i - 4
    }
}

// True if any open scope holds a live droppable — a `return` here must spill, drop, then return.
fn has_live_drops(read g: Cg) -> bool {
    return list.len(i32, g.ds) > 0
}

// Was `src[ns..ne]` marked moved-out by the current fn's move analysis?
fn is_moved_name(read g: Cg, read src: str, ns: i32, ne: i32) -> bool {
    var i: usize = 0
    for i < list.len(i32, g.mv) {
        let ms: i32 = list.get(i32, g.mv, i)
        let me: i32 = list.get(i32, g.mv, i + 1)
        if str_eq(src[ns as usize .. ne as usize], src[ms as usize .. me as usize]) { return true }
        i = i + 2
    }
    return false
}

// Register a freshly-declared `let` for scope-exit drop glue, if its type needs drop and its
// value does not escape (`mv`). The type comes from the annotation when present, else the
// Checker's inferred type of the initializer — only a Named type can be droppable.
fn register_drop_local(mut g: Cg, read p: parser.Parser, read src: str, read c: typeck.Checker, read s: parser.StmtData) {
    if list.len(i32, g.dsb) == 0 { return }
    var tns: i32 = 0 - 1
    var tne: i32 = 0 - 1
    if s.ty >= 0 {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, s.ty as usize)
        if t.kind == 0 { tns = t.start as i32  tne = t.end as i32 }
    } else if s.a >= 0 {
        let tid: i32 = list.get(i32, c.et, s.a as usize)
        if tid >= 0 {
            let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
            if d.kind == 15 {                         // Named: the tdecl row carries the name span
                tns = list.get(i32, c.tdecl, (d.x * 10 + 0) as usize)
                tne = list.get(i32, c.tdecl, (d.x * 10 + 1) as usize)
            }
        }
    }
    if tns < 0 { return }
    if is_moved_name(g, src, s.x, s.y) { return }
    if !needs_drop_name(p, src, tns, tne) { return }
    list.push(i32, g.ds, s.x)
    list.push(i32, g.ds, s.y)
    list.push(i32, g.ds, tns)
    list.push(i32, g.ds, tne)
}

// ---- move analysis (mirrors collect_moved / collect_moved_expr — over-approximated, leak-safe:
// a name is "moved" if returned, bound to a `take` param, captured into a literal, or rebound;
// borrows never move. Only `emit_fn_defs` runs this; method/impl bodies keep `mv` empty, exactly
// like the reference's `cur_moved` lifecycle.) ----

// Mark `eid`'s span moved if it is exactly a bare Name.
fn mv_mark(mut g: Cg, read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 2 {
        list.push(i32, g.mv, e.start as i32)
        list.push(i32, g.mv, e.end as i32)
    }
}

// Mark each bare-name argument landing at a `take` param of a *free* call as moved. A callee we
// can't resolve to a user fn (an intrinsic) never takes ownership. A comptime TYPE param's slot
// carries a type argument, so the pair is skipped (mirrors `mark_free_arg_takes`). Method-sugar
// receivers (`take self`) are deferred until a droppable-with-methods file needs them.
fn mark_take_args(mut g: Cg, read p: parser.Parser, read src: str, read e: parser.ExprData) {
    let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
    if callee.kind != 2 { return }
    var fid: i32 = 0 - 1
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], src[callee.start .. callee.end]) { fid = iid }
        }
        r = r + 1
    }
    if fid < 0 { return }
    let f: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
    var i: i32 = 0
    for i < f.b {
        if i < e.y {                                  // args align 1:1 with the params
            let pb: i32 = f.a + i * 7
            var skip: bool = false
            if list.get(i32, p.iar, pb as usize) == 1 {           // a comptime param …
                let pty: i32 = list.get(i32, p.iar, (pb + 5) as usize)
                if pty >= 0 {
                    let pt: parser.TypeData = list.get(parser.TypeData, p.ty, pty as usize)
                    if pt.kind == 1 { skip = true }   // … of type `type`: the arg is a type, skip
                }
            }
            if !skip and list.get(i32, p.iar, (pb + 1) as usize) == 3 {   // `take`
                mv_mark(g, p, list.get(i32, p.ar, (e.x + i) as usize))
            }
        }
        i = i + 1
    }
}

fn collect_moved_expr(mut g: Cg, read p: parser.Parser, read src: str, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 10 {                                 // Call: take-args, then recurse
        mark_take_args(g, p, src, e)
        collect_moved_expr(g, p, src, e.a)
        var i: i32 = 0
        for i < e.y {
            collect_moved_expr(g, p, src, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 12 {                                 // Assign: the value rebinds
        mv_mark(g, p, e.b)
        collect_moved_expr(g, p, src, e.a)
        collect_moved_expr(g, p, src, e.b)
        return
    }
    if e.kind == 16 {                                 // StructLit: field values are captured
        var i: i32 = 0
        for i < e.y {
            let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
            mv_mark(g, p, fi_.a)
            collect_moved_expr(g, p, src, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { collect_moved_expr(g, p, src, e.b) }        // spread
        return
    }
    if e.kind == 17 {                                 // GenStructLit: same, fields at (b, y)
        var i: i32 = 0
        for i < e.y {
            let fid: i32 = list.get(i32, p.ar, (e.b + i) as usize)
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
            mv_mark(g, p, fi_.a)
            collect_moved_expr(g, p, src, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 {                   // Binary / Index
        collect_moved_expr(g, p, src, e.a)
        collect_moved_expr(g, p, src, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 11 or e.kind == 34 or e.kind == 35 {
        collect_moved_expr(g, p, src, e.a)            // Unary/Field/Deref/Try/Cast/Invariant/Variant
        return
    }
    if e.kind == 43 { collect_moved_block(g, p, src, e.a)  return }   // Region block
    if e.kind == 13 {                                 // Range
        if e.a >= 0 { collect_moved_expr(g, p, src, e.a) }
        if e.b >= 0 { collect_moved_expr(g, p, src, e.b) }
        return
    }
    if e.kind == 24 {                                 // If: cond, then-block, else
        collect_moved_expr(g, p, src, e.a)
        collect_moved_block(g, p, src, e.b)
        if e.op >= 0 { collect_moved_expr(g, p, src, e.op) }
        return
    }
    if e.kind == 23 { collect_moved_block(g, p, src, eid)  return }   // Block
    if e.kind == 25 { collect_moved_block(g, p, src, e.a)  return }   // Unsafe block
    if e.kind == 28 {                                 // Match: scrutinee, guards, arm bodies
        collect_moved_expr(g, p, src, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { collect_moved_expr(g, p, src, guard) }
            collect_moved_expr(g, p, src, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For: head sources/cond + body + else
        if e.op == 1 { collect_moved_expr(g, p, src, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                collect_moved_expr(g, p, src, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        collect_moved_block(g, p, src, e.b)
        if e.x >= 0 { collect_moved_block(g, p, src, e.x) }    // the else block
        return
    }
}

// The statement walk: a `let`'s bare-name init, a `return`'s bare-name value, and the block's
// bare-name tail expression all move; every subexpression is walked for take-args and captures.
fn collect_moved_block(mut g: Cg, read p: parser.Parser, read src: str, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    let n: i32 = blk.y
    var i: i32 = 0
    for i < n {
        let sid: i32 = list.get(i32, p.sar, (blk.x + i) as usize)
        let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
        if s.kind == 0 and s.a >= 0 {
            mv_mark(g, p, s.a)
            collect_moved_expr(g, p, src, s.a)
        }
        if s.kind == 1 and s.a >= 0 {
            mv_mark(g, p, s.a)
            collect_moved_expr(g, p, src, s.a)
        }
        if s.kind == 2 {
            if i + 1 == n { mv_mark(g, p, s.a) }
            collect_moved_expr(g, p, src, s.a)
        }
        i = i + 1
    }
}

// The statement group threads `read c: typeck.Checker` (inferred-`let` types, type-directed
// lowering) and `mut g: Cg` (the temp counter). (`emit_expr` needs neither mutability nor `g` yet.)
fn emit_return(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, val: i32, depth: i32) {
    if val < 0 {
        emit_all_drops(sb, p, src, g, depth)          // drop every live local before returning
        line_at(sb, depth, "return;")
        return
    }
    // A control-flow value return dispatches to its block form (`return if …` becomes a C `if`).
    let v: parser.ExprData = list.get(parser.ExprData, p.ex, val as usize)
    if v.kind == 24 { emit_if(sb, p, src, c, g, val, true, depth)  return }      // If
    if v.kind == 28 { emit_match(sb, p, src, c, g, val, true, depth)  return }   // match
    if v.kind == 25 { emit_body(sb, p, src, c, g, v.a, true, depth)  return }    // return unsafe { … }
    if v.kind == 23 { emit_body(sb, p, src, c, g, val, true, depth)  return }    // return { … }
    // `ensures` postconditions or live drops: spill the value to `j_result` *before* running
    // asserts/drops (so the value can't read a local we're about to drop), then return the spill.
    // Mirrors `emit_value_return`; a method body (`autoret`) has no tracked ret cty -> `__auto_type`.
    if list.len(i32, g.ens) > 0 or has_live_drops(g) {
        indent(sb, depth)
        if g.res_ok >= 0 - 1 { emit_result_name(sb, p, src, g.res_ok) }
        else if g.autoret { string_push(sb, "__auto_type") }
        else { emit_c_ty(sb, p, src, g.retty) }
        string_push(sb, " j_result = ")
        emit_expr(sb, p, src, c, g, val)
        string_push(sb, ";\n")
        var ei: usize = 0
        for ei < list.len(i32, g.ens) {
            indent(sb, depth)
            string_push(sb, "assert(")
            emit_expr(sb, p, src, c, g, list.get(i32, g.ens, ei))
            string_push(sb, ");\n")
            ei = ei + 1
        }
        emit_all_drops(sb, p, src, g, depth)
        line_at(sb, depth, "return j_result;")
        return
    }
    indent(sb, depth)
    string_push(sb, "return ")
    emit_expr(sb, p, src, c, g, val)
    string_push(sb, ";\n")
}

fn emit_stmt(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, sid: i32, depth: i32) {
    let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
    if s.kind == 1 {                                  // Return
        emit_return(sb, p, src, c, g, s.a, depth)
        return
    }
    if s.kind == 2 {                                  // Expr statement
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
        if e.kind == 24 { emit_if(sb, p, src, c, g, s.a, false, depth)  return }   // If as a statement
        if e.kind == 28 { emit_match(sb, p, src, c, g, s.a, false, depth)  return } // match as a statement
        if e.kind == 31 { emit_for(sb, p, src, c, g, s.a, depth)  return }         // For as a statement
        if e.kind == 25 { emit_body(sb, p, src, c, g, e.a, false, depth)  return } // unsafe { … } block
        if e.kind == 23 { emit_body(sb, p, src, c, g, s.a, false, depth)  return } // bare { … } block
        if e.kind == 43 { emit_region(sb, p, src, c, g, s.a, depth)  return }      // region r { … }
        indent(sb, depth)
        emit_expr(sb, p, src, c, g, s.a)
        string_push(sb, ";\n")
        return
    }
    if s.kind == 0 {                                  // Let / var: `<cty> j_<name> [= <init>];`
        indent(sb, depth)
        // Annotated type (`ty` >= 0) renders from the annotation; an inferred `let x = <init>` reads
        // the Checker's per-expr type `c.et[init]`. `(x,y)` = name span; `ty` = annotation; `a` = init.
        if s.ty >= 0 {
            emit_c_ty(sb, p, src, s.ty)
        } else if s.a >= 0 {
            // a closure-bound local takes the closure's concrete `{call, env}` struct type
            let ie: parser.ExprData = list.get(parser.ExprData, p.ex, s.a as usize)
            if ie.kind == 37 and closure_index_of(g, s.a) >= 0 {
                string_push(sb, "JestyrClosure_")
                push_uint(sb, ref_expr_id(p, s.a) as i64)
            } else {
                emit_ty_c(sb, src, c, list.get(i32, c.et, s.a as usize))
            }
        } else {
            string_push(sb, "int")                    // no annotation, no init (mirrors the reference)
        }
        string_push(sb, " j_")
        string_push(sb, src[s.x as usize .. s.y as usize])
        if s.a >= 0 {
            string_push(sb, " = ")
            emit_expr(sb, p, src, c, g, s.a)
        }
        string_push(sb, ";\n")
        // Register the local for scope-exit drop glue *after* its declaration, so an earlier
        // `return` never references it. Mirrors `register_drop_local`.
        register_drop_local(g, p, src, c, s)
        return
    }
}

// A `{ … }` block: brace at `depth`, statements at `depth+1`, closing brace at `depth`. When `ret`,
// the tail statement is emitted as a `return` (an Expr tail becomes `return <expr>`, a Return tail
// stays `return <value>`). Mirrors `Cgen::emit_body`, drop scopes included: a diverging block
// (tail-as-return, or a trailing explicit `return`) already dropped, so its scope is discarded;
// a fall-through block drops its locals in reverse declaration order before the closing brace.
fn emit_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, block_eid: i32, ret: bool, depth: i32) {
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    // Pending `requires` preconditions (armed per fn by emit_fn_defs) fire as asserts at the top
    // of the FN body only — consumed here so nested blocks don't re-emit them.
    if list.len(i32, g.req) > 0 {
        var qi: usize = 0
        for qi < list.len(i32, g.req) {
            indent(sb, depth + 1)
            string_push(sb, "assert(")
            emit_expr(sb, p, src, c, g, list.get(i32, g.req, qi))
            string_push(sb, ");\n")
            qi = qi + 1
        }
        list.truncate(i32, g.req, 0)
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, block_eid as usize)   // Block (kind 23)
    let n: i32 = blk.y                                // y = stmt_count
    var i: i32 = 0
    for i < n {
        let sid: i32 = list.get(i32, p.sar, (blk.x + i) as usize)   // x = stmt_start into sar
        let last: bool = i + 1 == n
        if last and ret {
            let s: parser.StmtData = list.get(parser.StmtData, p.st, sid as usize)
            if s.kind == 1 { emit_return(sb, p, src, c, g, s.a, depth + 1) }
            else if s.kind == 2 { emit_return(sb, p, src, c, g, s.a, depth + 1) }
            else { emit_stmt(sb, p, src, c, g, sid, depth + 1) }
        } else {
            emit_stmt(sb, p, src, c, g, sid, depth + 1)
        }
        i = i + 1
    }
    // `block_diverges`: `ret` (the tail was emitted as a return) or a trailing explicit `return`.
    var dv: bool = ret
    if n > 0 {
        let lsid: i32 = list.get(i32, p.sar, (blk.x + n - 1) as usize)
        let ls: parser.StmtData = list.get(parser.StmtData, p.st, lsid as usize)
        if ls.kind == 1 { dv = true }
    }
    if dv { drop_scope_exit_discard(g) } else { drop_scope_exit_emit(sb, p, src, g, depth + 1) }
    line_at(sb, depth, "}")
}

// An `if (cond) { … } [else …]`. The If node (kind 24): `a`=cond, `b`=then Block, `op`=else
// (-1 none, else an `if` chain or a Block). The condition gets its own paren pair on top of any the
// expression itself adds (so `if n < 2` renders `if ((j_n < 2))`, matching the reference).
fn emit_if(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, ret: bool, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    indent(sb, depth)
    string_push(sb, "if (")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ")\n")
    emit_body(sb, p, src, c, g, e.b, ret, depth)
    if e.op >= 0 {
        line_at(sb, depth, "else")
        let els: parser.ExprData = list.get(parser.ExprData, p.ex, e.op as usize)
        if els.kind == 24 { emit_if(sb, p, src, c, g, e.op, ret, depth) }     // else if
        else { emit_body(sb, p, src, c, g, e.op, ret, depth) }               // else block
    }
}

// The body of a `match` arm: a `return <e>;` in return position, else the expression as a
// statement (with block/if forms recursing). Mirrors `emit_arm_body`.
fn emit_arm_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, ret: bool, depth: i32) {
    let bd: parser.ExprData = list.get(parser.ExprData, p.ex, body as usize)
    if ret {
        if bd.kind == 24 { emit_if(sb, p, src, c, g, body, true, depth)  return }
        if bd.kind == 28 { emit_match(sb, p, src, c, g, body, true, depth)  return }
        if bd.kind == 23 { emit_body(sb, p, src, c, g, body, true, depth)  return }
        emit_return(sb, p, src, c, g, body, depth)
        return
    }
    if bd.kind == 24 { emit_if(sb, p, src, c, g, body, false, depth)  return }
    if bd.kind == 28 { emit_match(sb, p, src, c, g, body, false, depth)  return }
    if bd.kind == 23 { emit_body(sb, p, src, c, g, body, false, depth)  return }
    indent(sb, depth)
    emit_expr(sb, p, src, c, g, body)
    string_push(sb, ";\n")
}

// A `match` on a tagged enum -> `<cty> jm_{n} = <scrut>; switch (jm_{n}.tag) { case … }`. Each arm
// binds any payload fields (`<fcty> j_<b> = jm_{n}.u.<v>.j_<field>;`) then runs its body; a non-
// return arm ends with `break;`. An exhaustive return-position match closes with
// `__builtin_unreachable();`. Mirrors `emit_match` (flat, unguarded path). Guards/nesting/niche and
// scalar (int/char/bool) scrutinees are deferred (added when a corpus file needs them).
fn emit_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, ret: bool, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let scrut: i32 = e.a
    // Resolve the scrutinee's enum: a plain Named enum or a generic-enum instance. `pfx` is the
    // shared C name — both the scrutinee's C type and the tag/case prefix.
    let stid: i32 = list.get(i32, c.et, scrut as usize)
    if stid >= 0 {
        let sd0: typeck.TyData = list.get(typeck.TyData, c.tys, stid as usize)
        if sd0.kind == 2 and (sd0.x <= 9 or sd0.x == 12 or sd0.x == 13) {   // int/bool/char scrutinee
            emit_scalar_match(sb, p, src, c, g, e, stid, ret, depth)
            return
        }
    }
    var inst: i32 = 0 - 1
    var enum_iid: i32 = 0 - 1
    let row: i32 = expr_enum_row(c, scrut)
    var pfx: String = string_new()
    if row >= 0 {
        let ens: i32 = list.get(i32, c.tdecl, (row * 10 + 0) as usize)
        let ene: i32 = list.get(i32, c.tdecl, (row * 10 + 1) as usize)
        enum_iid = find_enum_item(p, src, ens as usize, ene as usize)
        string_push(pfx, "Jestyr_")
        string_push(pfx, src[ens as usize .. ene as usize])
    } else {
        enum_iid = genum_item_of(p, src, c, stid)
        inst = stid
        emit_ty_c(pfx, src, c, stid)
    }
    // Any guarded arm forces the ordered-if-chain lowering (a C switch cannot stack two cases on
    // one tag nor fall through on a false guard).
    var guarded: bool = false
    var ks: i32 = 0
    for ks < e.y {
        if list.get(i32, p.par, (e.x + ks * 3 + 1) as usize) >= 0 { guarded = true }
        ks = ks + 1
    }
    if guarded {
        emit_guarded_match(sb, p, src, c, g, e, enum_iid, inst, string_view(pfx), ret, depth)
        string_free(pfx)
        return
    }
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, string_view(pfx))
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, scrut)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "switch (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag)\n")
    line_at(sb, depth, "{")
    let cd: i32 = depth + 1                            // case labels sit one level in from the switch
    var has_default: bool = false
    var k: i32 = 0
    for k < e.y {                                     // e.x = arm_start, e.y = arm_count (triples in par)
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        if pd.kind == 2 {                             // Variant `v(subpats)`
            let vname: str = src[pd.x as usize .. pd.y as usize]
            indent(sb, cd)
            string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ":\n")
            line_at(sb, cd, "{")
            emit_variant_bindings(sb, p, src, c, enum_iid, inst, n, vname, pd, cd + 1)
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 1 and find_variant_enum(p, src, pd.start, pd.end) >= 0 {   // nullary variant
            let vname: str = src[pd.start .. pd.end]
            indent(sb, cd)
            string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ":\n")
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 1 {                      // binding catch-all (binds whole scrutinee)
            has_default = true
            line_at(sb, cd, "default:")
            line_at(sb, cd, "{")
            indent(sb, cd + 1)
            string_push(sb, string_view(pfx))  string_push(sb, " j_")  string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")  push_uint(sb, n as i64)  string_push(sb, ";\n")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 0 {                      // wildcard `_`
            has_default = true
            line_at(sb, cd, "default:")
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        } else if pd.kind == 6 {                      // or-pattern of nullary variants: stacked cases
            var oi: i32 = 0
            for oi < pd.a {                           // (op,a) = alternative PatIds in par
                let alt: i32 = list.get(i32, p.par, (pd.op + oi) as usize)
                let ad: parser.PatData = list.get(parser.PatData, p.pt, alt as usize)
                indent(sb, cd)
                string_push(sb, "case ")  string_push(sb, string_view(pfx))  string_push(sb, "_")
                string_push(sb, src[ad.start .. ad.end])
                string_push(sb, ":\n")
                oi = oi + 1
            }
            line_at(sb, cd, "{")
            emit_arm_body(sb, p, src, c, g, body, ret, cd + 1)
            if !ret { line_at(sb, cd + 1, "break;") }
            line_at(sb, cd, "}")
        }
        k = k + 1
    }
    line_at(sb, depth, "}")
    if ret and !has_default { line_at(sb, depth, "__builtin_unreachable();") }
    string_free(pfx)
}

// A `match` on a scalar (int/char/bool) scrutinee -> an ordered if-chain on the VALUE (there is
// no tag to switch on); mirrors `emit_scalar_match`. Each arm: `if (<cond>) { [bind;] body }`
// with the guard machinery shared with the enum chain; consumes TWO temps (value + end label).
fn emit_scalar_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, stid: i32, ret: bool, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let nend: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_ty_c(sb, src, c, stid)
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ";\n")
    var has_uncond_default: bool = false
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        var cond: String = string_new()
        let has_cond: bool = scalar_pat_cond(cond, p, src, c, g, pat, n)
        if !has_cond and guard < 0 { has_uncond_default = true }
        if has_cond {
            indent(sb, depth)
            string_push(sb, "if (")
            string_push(sb, string_view(cond))
            string_push(sb, ")\n")
        }
        line_at(sb, depth, "{")
        if pd.kind == 1 {                             // a bare name binds the scrutinee value
            indent(sb, depth + 1)
            emit_ty_c(sb, src, c, stid)
            string_push(sb, " j_")
            string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
        emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
        line_at(sb, depth, "}")
        string_free(cond)
        k = k + 1
    }
    if !ret {
        indent(sb, depth)
        string_push(sb, "jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ": ;\n")
    } else if !has_uncond_default {
        line_at(sb, depth, "__builtin_unreachable();")
    }
}

// The C value test of a scalar pattern against `jm_{n}`, written into `cond`; false = the
// pattern matches everything (wildcard/binding). Mirrors `scalar_pat_cond`: a literal tests
// equality, a range tests bounds, an or-pattern ORs its alternatives (each parenthesized;
// an alternative that matches everything makes the whole pattern unconditional).
fn scalar_pat_cond(mut cond: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, pat: i32, n: i32) -> bool {
    let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
    if pd.kind == 4 {                                 // Lit: a = the literal ExprId
        string_push(cond, "jm_")
        push_uint(cond, n as i64)
        string_push(cond, " == (")
        emit_expr(cond, p, src, c, g, pd.a)
        string_push(cond, ")")
        return true
    }
    if pd.kind == 5 {                                 // Range: a=lo, b=hi, op=inclusive
        string_push(cond, "jm_")
        push_uint(cond, n as i64)
        string_push(cond, " >= (")
        emit_expr(cond, p, src, c, g, pd.a)
        string_push(cond, ") && jm_")
        push_uint(cond, n as i64)
        if pd.op == 1 { string_push(cond, " <= (") } else { string_push(cond, " < (") }
        emit_expr(cond, p, src, c, g, pd.b)
        string_push(cond, ")")
        return true
    }
    if pd.kind == 6 {                                 // Or: (op,a) = alternative PatIds in par
        var i: i32 = 0
        for i < pd.a {
            var alt: String = string_new()
            if !scalar_pat_cond(alt, p, src, c, g, list.get(i32, p.par, (pd.op + i) as usize), n) {
                string_free(alt)
                return false                          // an alternative matches everything
            }
            if i > 0 { string_push(cond, " || ") }
            string_push(cond, "(")
            string_push(cond, string_view(alt))
            string_push(cond, ")")
            string_free(alt)
            i = i + 1
        }
        return true
    }
    return false                                      // wildcard / binding catch-all
}

// A `match` with at least one guarded arm -> an ordered if-chain (mirrors `emit_guarded_match`):
// per arm `if (jm_{n}.tag == <pfx>_<v>) { bind; [if (guard)] { body } }`. A false guard falls
// through to the NEXT arm's tag re-test. Statement position gotos a shared `jm_end_{n+1}` label;
// return position relies on the bodies' returns and closes with `__builtin_unreachable()` unless
// an unguarded catch-all exists. Consumes TWO temps (scrutinee + end label), like the reference.
fn emit_guarded_match(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, enum_iid: i32, inst: i32, read pfx: str, ret: bool, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let nend: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, pfx)
    string_push(sb, " jm_")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, e.a)
    string_push(sb, ";\n")
    var has_uncond_default: bool = false
    var k: i32 = 0
    for k < e.y {
        let ab: i32 = e.x + k * 3
        let pat: i32 = list.get(i32, p.par, ab as usize)
        let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
        let body: i32 = list.get(i32, p.par, (ab + 2) as usize)
        let pd: parser.PatData = list.get(parser.PatData, p.pt, pat as usize)
        if pd.kind == 2 {                             // Variant `v(subpats)`
            let vname: str = src[pd.x as usize .. pd.y as usize]
            indent(sb, depth)
            string_push(sb, "if (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag == ")
            string_push(sb, pfx)  string_push(sb, "_")  string_push(sb, vname)  string_push(sb, ")\n")
            line_at(sb, depth, "{")
            emit_variant_bindings(sb, p, src, c, enum_iid, inst, n, vname, pd, depth + 1)
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 1 and find_variant_enum(p, src, pd.start, pd.end) >= 0 {   // nullary variant
            indent(sb, depth)
            string_push(sb, "if (jm_")  push_uint(sb, n as i64)  string_push(sb, ".tag == ")
            string_push(sb, pfx)  string_push(sb, "_")  string_push(sb, src[pd.start .. pd.end])  string_push(sb, ")\n")
            line_at(sb, depth, "{")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 1 {                      // binding catch-all
            if guard < 0 { has_uncond_default = true }
            line_at(sb, depth, "{")
            indent(sb, depth + 1)
            string_push(sb, pfx)  string_push(sb, " j_")  string_push(sb, src[pd.start .. pd.end])
            string_push(sb, " = jm_")  push_uint(sb, n as i64)  string_push(sb, ";\n")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        } else if pd.kind == 0 {                      // wildcard `_`
            if guard < 0 { has_uncond_default = true }
            line_at(sb, depth, "{")
            emit_guarded_arm(sb, p, src, c, g, body, guard, ret, nend, depth + 1)
            line_at(sb, depth, "}")
        }
        k = k + 1
    }
    if !ret {
        indent(sb, depth)
        string_push(sb, "jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ": ;\n")
    } else if !has_uncond_default {
        line_at(sb, depth, "__builtin_unreachable();")
    }
}

// One arm of a guarded chain: gate the body on the guard if present; in statement position a
// fired arm leaves the chain via `goto jm_end_{nend};` (mirrors `emit_guarded_arm`).
fn emit_guarded_arm(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, guard: i32, ret: bool, nend: i32, depth: i32) {
    if guard >= 0 {
        indent(sb, depth)
        string_push(sb, "if (")
        emit_expr(sb, p, src, c, g, guard)
        string_push(sb, ")\n")
        line_at(sb, depth, "{")
        emit_arm_body(sb, p, src, c, g, body, ret, depth + 1)
        if !ret {
            indent(sb, depth + 1)
            string_push(sb, "goto jm_end_")
            push_uint(sb, nend as i64)
            string_push(sb, ";\n")
        }
        line_at(sb, depth, "}")
        return
    }
    emit_arm_body(sb, p, src, c, g, body, ret, depth)
    if !ret {
        indent(sb, depth)
        string_push(sb, "goto jm_end_")
        push_uint(sb, nend as i64)
        string_push(sb, ";\n")
    }
}

// Emit a Variant pattern's payload bindings: for each Ident subpat, project the matching field
// `<fcty> j_<bind> = jm_{n}.u.<vname>.j_<fieldname>;` — the field C type runs through the
// instance substitution when the scrutinee is a generic-enum instance (`inst` = its TyId, -1 for
// a plain enum). Wildcard/rest subpats project nothing.
fn emit_variant_bindings(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, enum_iid: i32, inst: i32, n: i32, read vname: str, read pd: parser.PatData, depth: i32) {
    let vb: i32 = variant_tuple(p, src, enum_iid, pd.x as usize, pd.y as usize)
    if vb < 0 { return }
    let fstart: i32 = list.get(i32, p.ear, (vb + 2) as usize)   // field 3-tuple base
    var i: i32 = 0
    for i < pd.a {                                    // (op,a) = subpat slice in par
        let sp: i32 = list.get(i32, p.par, (pd.op + i) as usize)
        let spd: parser.PatData = list.get(parser.PatData, p.pt, sp as usize)
        if spd.kind == 1 {                            // an Ident binding projects field i
            let fb: i32 = fstart + i * 3
            indent(sb, depth)
            emit_field_ty_subst(sb, p, src, c, list.get(i32, p.ear, (fb + 2) as usize), enum_iid, inst)
            string_push(sb, " j_")
            string_push(sb, src[spd.start .. spd.end])   // binding name
            string_push(sb, " = jm_")
            push_uint(sb, n as i64)
            string_push(sb, ".u.")
            string_push(sb, vname)
            string_push(sb, ".j_")
            string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])   // field name
            string_push(sb, ";\n")
        }
        i = i + 1
    }
}

// Does the struct member at 10-tuple `base` carry a field attr named `want`? Member slots 6/7 are
// its attr 4-tuple slice in `aar`.
fn field_has_attr(read p: parser.Parser, read src: str, base: i32, read want: str) -> bool {
    let astart: i32 = list.get(i32, p.mar, (base + 6) as usize)
    let acount: i32 = list.get(i32, p.mar, (base + 7) as usize)
    if astart < 0 { return false }
    var a: i32 = 0
    for a < acount {
        let ab: i32 = astart + a * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        if str_eq(src[ns as usize .. ne as usize], want) { return true }
        a = a + 1
    }
    return false
}

// Layout attrs on a struct item: `@packed` -> `packed`, `@align(n)` -> `aligned(n)`, joined into
// one ` __attribute__((…))` clause (mirrors `struct_attr`; unknown attrs are ignored). Attrs are
// 4-tuples in `aar` at `(u,v)`: [name_start, name_end, arg_start, arg_count]; args are ExprIds.
fn emit_struct_attr(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    if it.u < 0 { return }
    var wrote: bool = false
    var a: i32 = 0
    for a < it.v {
        let ab: i32 = it.u + a * 4
        let ns: i32 = list.get(i32, p.aar, ab as usize)
        let ne: i32 = list.get(i32, p.aar, (ab + 1) as usize)
        let nm: str = src[ns as usize .. ne as usize]
        if str_eq(nm, "packed") {
            if !wrote { string_push(sb, " __attribute__((") } else { string_push(sb, ", ") }
            wrote = true
            string_push(sb, "packed")
        } else if str_eq(nm, "align") {
            if list.get(i32, p.aar, (ab + 3) as usize) >= 1 {
                let arg: i32 = list.get(i32, p.aar, (ab + 2) as usize)
                let ax: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.aar, arg as usize) as usize)
                if ax.kind == 0 {
                    if !wrote { string_push(sb, " __attribute__((") } else { string_push(sb, ", ") }
                    wrote = true
                    string_push(sb, "aligned(")
                    emit_int_literal(sb, src[ax.start .. ax.end])
                    string_push(sb, ")")
                }
            }
        }
        a = a + 1
    }
    if wrote { string_push(sb, "))") }
}

// The item id of a struct/record/union named `src[ns..ne]`, or -1.
fn find_struct_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 {
            if str_eq(src[ns .. ne], src[it.x .. it.y]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Does StructLit `e` list a field named `src[ns..ne]`?
fn structlit_has_field(read p: parser.Parser, read src: str, read e: parser.ExprData, ns: usize, ne: usize) -> bool {
    var i: i32 = 0
    for i < e.y {
        let fid: i32 = list.get(i32, p.ar, (e.x + i) as usize)
        let fi: parser.ExprData = list.get(parser.ExprData, p.ex, fid as usize)
        if str_eq(src[ns .. ne], src[fi.x as usize .. fi.y as usize]) { return true }
        i = i + 1
    }
    return false
}

// The item id of a non-generic enum named `src[ns..ne]`, or -1.
fn find_enum_item(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 {
            if str_eq(src[ns .. ne], src[it.x .. it.y]) { return iid }
        }
        r = r + 1
    }
    return 0 - 1
}

// Decimal digits of a non-negative integer (for `_hi{n}` temp names).
fn push_uint(mut sb: String, v: i64) {
    if v >= 10 { push_uint(sb, v / 10) }
    let d: i64 = v % 10
    if d == 0 { string_push(sb, "0") } else if d == 1 { string_push(sb, "1") }
    else if d == 2 { string_push(sb, "2") } else if d == 3 { string_push(sb, "3") }
    else if d == 4 { string_push(sb, "4") } else if d == 5 { string_push(sb, "5") }
    else if d == 6 { string_push(sb, "6") } else if d == 7 { string_push(sb, "7") }
    else if d == 8 { string_push(sb, "8") } else { string_push(sb, "9") }
}

// A loop body (mirrors `emit_loop_body`): like `emit_body(ret=false)` — drop scope included —
// plus the armed labeled-continue target `<label>__continue: ;` at the bottom (after the drops,
// before the closing brace), consumed here exactly like the reference's `cont_label.take()`.
fn emit_loop_body(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, block_eid: i32, depth: i32) {
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    emit_scratch_reset(sb, src, g, depth + 1)
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, block_eid as usize)
    let n: i32 = blk.y
    var i: i32 = 0
    for i < n {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    var dv: bool = false
    if n > 0 {
        let lsid: i32 = list.get(i32, p.sar, (blk.x + n - 1) as usize)
        let ls: parser.StmtData = list.get(parser.StmtData, p.st, lsid as usize)
        if ls.kind == 1 { dv = true }
    }
    if dv { drop_scope_exit_discard(g) } else { drop_scope_exit_emit(sb, p, src, g, depth + 1) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// Emit + consume the armed labeled-continue target, if any (shared by every loop-body shape).
fn emit_cont_target(mut sb: String, read src: str, mut g: Cg, depth: i32) {
    if g.cl_ns >= 0 {
        indent(sb, depth)
        string_push(sb, src[g.cl_ns as usize .. g.cl_ne as usize])
        string_push(sb, "__continue: ;\n")
        g.cl_ns = 0 - 1
        g.cl_ne = 0 - 1
    }
}

// Emit + consume a region-scoped loop's armed per-iteration scratch reset `j_<r>.off = 0;`
// (the reference's `scratch_reset.take()`, at the top of the next loop body).
fn emit_scratch_reset(mut sb: String, read src: str, mut g: Cg, depth: i32) {
    if g.sr_ns >= 0 {
        indent(sb, depth)
        string_push(sb, "j_")
        string_push(sb, src[g.sr_ns as usize .. g.sr_ne as usize])
        string_push(sb, ".off = 0;\n")
        g.sr_ns = 0 - 1
        g.sr_ne = 0 - 1
    }
}

// A `region r { … }` block (kind 43; mirrors `emit_region`): open a bump arena, run the body
// (its `region_alloc(r, …)` calls hand out zero-cost `&[r]T` pointers into it), free the whole
// arena at the brace. The region's drop scope is DISCARDED, not emitted — the arena reclaims
// everything at once (region-integrated bulk drop; the allocator determines the drop strategy).
fn emit_region(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let rname: str = src[e.x as usize .. e.y as usize]
    line_at(sb, depth, "{")
    drop_scope_enter(g)
    indent(sb, depth + 1)
    string_push(sb, "JestyrArena j_")
    string_push(sb, rname)
    string_push(sb, " = jestyr_arena_new(1u << 20);\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)   // a = body Block
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    drop_scope_exit_discard(g)
    indent(sb, depth + 1)
    string_push(sb, "jestyr_arena_free(&j_")
    string_push(sb, rname)
    string_push(sb, ");\n")
    line_at(sb, depth, "}")
}

// A `for` loop statement (kind 31; mirrors `emit_for`). The `lar` header at `e.a`:
// [0,1]=label span (-1 none), [2,3]=region span, [4]=slot A (while: cond; iterate: bind count),
// [5]=slot B (iterate: source count), [6]=slot C (iterate: step ExprId or -1); iterate binds are
// (conv, ns, ne) triples at +7, sources follow; `x`=else Block ExprId (-1 none). A labeled loop
// arms the continue target; a loop with an `else` synthesizes `_fe{n}` (ONE temp, before the
// head) and reroutes plain `break`s past the `else`; the `<label>__break: ;` target lands after
// the `else` (or right after the body for a label-only loop). `region` / zip / `step` are TODO.
fn emit_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, eid: i32, depth: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    let lls: i32 = list.get(i32, p.lar, e.a as usize)          // label span
    let lle: i32 = list.get(i32, p.lar, (e.a + 1) as usize)
    let rns: i32 = list.get(i32, p.lar, (e.a + 2) as usize)    // region span
    let rne: i32 = list.get(i32, p.lar, (e.a + 3) as usize)
    let els: i32 = e.x                                         // else Block ExprId
    // A region-scoped loop wraps everything (loop, else, break target) in an arena scope and
    // arms the per-iteration scratch reset (consumed at the top of the loop body).
    var d: i32 = depth
    if rns >= 0 {
        line_at(sb, depth, "{")
        d = depth + 1
        indent(sb, d)
        string_push(sb, "JestyrArena j_")
        string_push(sb, src[rns as usize .. rne as usize])
        string_push(sb, " = jestyr_arena_new(1u << 20);\n")
        g.sr_ns = rns
        g.sr_ne = rne
    }
    // Hoist a `int64_t _vt{n} = INT64_MAX;` tracker before the loop for each top-level `variant`
    // statement in the body (ONE temp each; mirrors `hoist_variant_trackers` + the per-loop
    // REPLACE of `variant_trackers` — the floor hides any outer loop's entries).
    let vt_len: i32 = list.len(i32, g.vt) as i32
    let vt_floor: i32 = g.vtf
    g.vtf = vt_len
    let hb: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var hv: i32 = 0
    for hv < hb.y {
        let hsid: i32 = list.get(i32, p.sar, (hb.x + hv) as usize)
        let hs: parser.StmtData = list.get(parser.StmtData, p.st, hsid as usize)
        if hs.kind == 2 {
            let hse: parser.ExprData = list.get(parser.ExprData, p.ex, hs.a as usize)
            if hse.kind == 35 {                                // a `variant <expr>` statement
                let tn: i32 = g.tmp
                g.tmp = g.tmp + 1
                list.push(i32, g.vt, hs.a)
                list.push(i32, g.vt, tn)
                indent(sb, d)
                string_push(sb, "int64_t _vt")
                push_uint(sb, tn as i64)
                string_push(sb, " = INT64_MAX;\n")
            }
        }
        hv = hv + 1
    }
    if lls >= 0 { g.cl_ns = lls  g.cl_ne = lle }               // arm the continue target
    var fe: i32 = 0 - 1                                        // synthesized else-break label id
    if lls < 0 and els >= 0 { fe = g.tmp  g.tmp = g.tmp + 1 }
    // Arm plain-`break` rerouting only for a loop that HAS an `else`; save/restore models
    // "the nearest loop" across nesting (mirrors `break_label`).
    let sbl_ns: i32 = g.bl_ns
    let sbl_ne: i32 = g.bl_ne
    let sbl_fe: i32 = g.bl_fe
    g.bl_ns = 0 - 1
    g.bl_ne = 0 - 1
    g.bl_fe = 0 - 1
    if els >= 0 {
        if lls >= 0 { g.bl_ns = lls  g.bl_ne = lle } else { g.bl_fe = fe }
    }
    emit_for_inner(sb, p, src, c, g, e, d)
    g.bl_ns = sbl_ns
    g.bl_ne = sbl_ne
    g.bl_fe = sbl_fe
    // The `else` runs on normal completion: between the loop and the break target, so falling
    // out runs it while a (rerouted) `break` jumps past it. No new drop scope (reference parity).
    if els >= 0 {
        line_at(sb, d, "{")
        let eb: parser.ExprData = list.get(parser.ExprData, p.ex, els as usize)
        var i: i32 = 0
        for i < eb.y {
            emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (eb.x + i) as usize), d + 1)
            i = i + 1
        }
        line_at(sb, d, "}")
    }
    if lls >= 0 {                                              // labeled- and/or else-break target
        indent(sb, d)
        string_push(sb, src[lls as usize .. lle as usize])
        string_push(sb, "__break: ;\n")
    } else if fe >= 0 {
        indent(sb, d)
        string_push(sb, "_fe")
        push_uint(sb, fe as i64)
        string_push(sb, "__break: ;\n")
    }
    list.truncate(i32, g.vt, vt_len as usize)                  // restore the outer loop's trackers
    g.vtf = vt_floor
    if rns >= 0 {                                              // close the region scope
        indent(sb, d)
        string_push(sb, "jestyr_arena_free(&j_")
        string_push(sb, src[rns as usize .. rne as usize])
        string_push(sb, ");\n")
        line_at(sb, depth, "}")
    }
}

// The head-shape dispatch (mirrors `emit_for_inner`).
fn emit_for_inner(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, depth: i32) {
    if e.op == 0 {                                    // infinite
        line_at(sb, depth, "for (;;)")
        emit_loop_body(sb, p, src, c, g, e.b, depth)
        return
    }
    if e.op == 1 {                                    // conditional -> C while
        indent(sb, depth)
        string_push(sb, "while (")
        emit_expr(sb, p, src, c, g, list.get(i32, p.lar, (e.a + 4) as usize))
        string_push(sb, ")\n")
        emit_loop_body(sb, p, src, c, g, e.b, depth)
        return
    }
    // iterate
    let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
    let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
    let step: i32 = list.get(i32, p.lar, (e.a + 6) as usize)
    if sc >= 2 {                                      // lockstep zip (length-checked)
        emit_zip_for(sb, p, src, c, g, e, bc, sc, depth)
        return
    }
    if sc == 1 {
        let src0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3) as usize)
        let sx: parser.ExprData = list.get(parser.ExprData, p.ex, src0 as usize)
        if sx.kind == 13 {                            // Range source: the counted C for (+ step)
            emit_range_for(sb, p, src, c, g, e, sx, src0, step, depth)
            return
        }
        if sx.kind == 10 and sx.y == 1 {              // `codepoints(s)` marker: the decode loop
            let cal: parser.ExprData = list.get(parser.ExprData, p.ex, sx.a as usize)
            if cal.kind == 2 {
                if str_eq(src[cal.start .. cal.end], "codepoints") {
                    emit_codepoints_for(sb, p, src, c, g, e, arg_at(p, sx, 0), bc, depth)
                    return
                }
            }
        }
        if sx.kind == 10 and sx.y == 2 {              // `split(s, sep)` marker: separator scan loop
            let cal: parser.ExprData = list.get(parser.ExprData, p.ex, sx.a as usize)
            if cal.kind == 2 {
                if str_eq(src[cal.start .. cal.end], "split") {
                    emit_split_for(sb, p, src, c, g, e, arg_at(p, sx, 0), arg_at(p, sx, 1), depth)
                    return
                }
            }
        }
        if step < 0 {
            if expr_is_slice(c, src0) {               // slice source: snapshot + counted for
                emit_slice_for(sb, p, src, c, g, e, src0, bc, depth)
                return
            }
            if expr_is_str(c, src0) {                 // str source: iterate the bytes
                emit_str_for(sb, p, src, c, g, e, src0, bc, depth)
                return
            }
            let sty: i32 = list.get(i32, c.et, src0 as usize)
            if sty >= 0 {
                let sd2: typeck.TyData = list.get(typeck.TyData, c.tys, sty as usize)
                if sd2.kind == 9 {                    // array source: iterate in place by address
                    emit_array_for(sb, p, src, c, g, e, src0, bc, sty, depth)
                    return
                }
            }
        }
    }
    // TODO: codepoints/graphemes/split iteration.
}

// `for cp in codepoints(s)` — decode UTF-8 one codepoint at a time (mirrors
// `emit_codepoints_for`): `_str{n}` snapshot, a manual `_k{n}` cursor the decode advances by
// the codepoint's byte width, each `cp` a `u32`. An optional second binding is the codepoint's
// byte offset — `_k` BEFORE the decode (Go's range-over-string). ONE temp.
fn emit_codepoints_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, s_arg: i32, bc: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _str")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, s_arg)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0;\n")
    indent(sb, depth)
    string_push(sb, "while (_k")
    push_uint(sb, n as i64)
    string_push(sb, " < _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional byte-offset binding
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    indent(sb, depth + 1)
    if !str_eq(bname, "_") {
        string_push(sb, "uint32_t j_")
        string_push(sb, bname)
        string_push(sb, " = jestyr_rt_decode_cp(_str")
    } else {
        string_push(sb, "(void) jestyr_rt_decode_cp(_str")
    }
    push_uint(sb, n as i64)
    string_push(sb, ".ptr, _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len, &_k")
    push_uint(sb, n as i64)
    string_push(sb, ");\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for part in split(s, sep)` — yield each `str` view between separators (zero-copy; the last
// part is the remainder; an empty `sep` yields the whole string once). ONE temp; the source and
// separator exprs are emitted FIRST (their own temps consume before `n`), mirroring
// `emit_split_for`'s ordering exactly.
fn emit_split_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, s_arg: i32, sep_arg: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    var sbuf: String = string_new()
    emit_expr(sbuf, p, src, c, g, s_arg)
    var pbuf: String = string_new()
    emit_expr(pbuf, p, src, c, g, sep_arg)
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _ss")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(sbuf))
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "JestyrStr _sep")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    string_push(sb, string_view(pbuf))
    string_push(sb, ";\n")
    string_free(sbuf)
    string_free(pbuf)
    indent(sb, depth)
    string_push(sb, "size_t _start")
    push_uint(sb, n as i64)
    string_push(sb, " = 0;\n")
    indent(sb, depth)
    string_push(sb, "int _go")
    push_uint(sb, n as i64)
    string_push(sb, " = 1;\n")
    indent(sb, depth)
    string_push(sb, "while (_go")
    push_uint(sb, n as i64)
    string_push(sb, ")\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    indent(sb, depth + 1)
    string_push(sb, "JestyrStr _rest")
    push_uint(sb, n as i64)
    string_push(sb, " = (JestyrStr){ _ss")
    push_uint(sb, n as i64)
    string_push(sb, ".ptr + _start")
    push_uint(sb, n as i64)
    string_push(sb, ", _ss")
    push_uint(sb, n as i64)
    string_push(sb, ".len - _start")
    push_uint(sb, n as i64)
    string_push(sb, " };\n")
    indent(sb, depth + 1)
    string_push(sb, "int64_t _hit")
    push_uint(sb, n as i64)
    string_push(sb, " = _sep")
    push_uint(sb, n as i64)
    string_push(sb, ".len ? jestyr_rt_find(_rest")
    push_uint(sb, n as i64)
    string_push(sb, ", _sep")
    push_uint(sb, n as i64)
    string_push(sb, ") : -1;\n")
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        string_push(sb, "JestyrStr j_")
        string_push(sb, bname)
        string_push(sb, " = (_hit")
        push_uint(sb, n as i64)
        string_push(sb, " < 0) ? _rest")
        push_uint(sb, n as i64)
        string_push(sb, " : (JestyrStr){ _rest")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr, (size_t)_hit")
        push_uint(sb, n as i64)
        string_push(sb, " };\n")
    }
    indent(sb, depth + 1)
    string_push(sb, "if (_hit")
    push_uint(sb, n as i64)
    string_push(sb, " < 0) _go")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; else _start")
    push_uint(sb, n as i64)
    string_push(sb, " += (size_t)_hit")
    push_uint(sb, n as i64)
    string_push(sb, " + _sep")
    push_uint(sb, n as i64)
    string_push(sb, ".len;\n")
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for a, b in xs, ys` — lockstep zip over slices (mirrors `emit_zip_for`): snapshot each
// source (`_z{n}_{i}`, ONE shared temp), assert equal lengths, one counted loop; each bind
// takes its own source's element (by pointer for `mut`, joining the by-pointer set).
fn emit_zip_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, bc: i32, sc: i32, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    var k: i32 = sc
    if bc < k { k = bc }
    var i: i32 = 0
    for i < k {                                       // snapshot each source slice
        let s0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3 + i) as usize)
        indent(sb, depth)
        emit_ty_c(sb, src, c, list.get(i32, c.et, s0 as usize))
        string_push(sb, " _z")
        push_uint(sb, n as i64)
        string_push(sb, "_")
        push_uint(sb, i as i64)
        string_push(sb, " = ")
        emit_expr(sb, p, src, c, g, s0)
        string_push(sb, ";\n")
        i = i + 1
    }
    if k > 1 {                                        // all lengths must match
        indent(sb, depth)
        string_push(sb, "assert(")
        var j: i32 = 1
        for j < k {
            if j > 1 { string_push(sb, " && ") }
            string_push(sb, "_z")
            push_uint(sb, n as i64)
            string_push(sb, "_0.len == _z")
            push_uint(sb, n as i64)
            string_push(sb, "_")
            push_uint(sb, j as i64)
            string_push(sb, ".len")
            j = j + 1
        }
        string_push(sb, ");\n")
    }
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _z")
    push_uint(sb, n as i64)
    string_push(sb, "_0.len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    var added: i32 = 0
    var b: i32 = 0
    for b < k {                                       // each bind takes its source's element
        let conv: i32 = list.get(i32, p.lar, (e.a + 7 + b * 3) as usize)
        let bns: i32 = list.get(i32, p.lar, (e.a + 8 + b * 3) as usize)
        let bne: i32 = list.get(i32, p.lar, (e.a + 9 + b * 3) as usize)
        let bname: str = src[bns as usize .. bne as usize]
        if !str_eq(bname, "_") {
            let s0: i32 = list.get(i32, p.lar, (e.a + 7 + bc * 3 + b) as usize)
            let sd: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, c.et, s0 as usize) as usize)
            indent(sb, depth + 1)
            emit_ty_c(sb, src, c, sd.a)               // Slice: a = elem
            if conv == 2 {                            // mut: bind a pointer into the slice
                string_push(sb, "* j_")
                string_push(sb, bname)
                string_push(sb, " = &_z")
            } else {
                string_push(sb, " j_")
                string_push(sb, bname)
                string_push(sb, " = _z")
            }
            push_uint(sb, n as i64)
            string_push(sb, "_")
            push_uint(sb, b as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
            if conv == 2 {
                list.push(i32, g.pp, bns)
                list.push(i32, g.pp, bne)
                added = added + 1
            }
        }
        b = b + 1
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var si: i32 = 0
    for si < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + si) as usize), depth + 1)
        si = si + 1
    }
    if added > 0 { list.truncate(i32, g.pp, list.len(i32, g.pp) - (added * 2) as usize) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for x in xs` / `for mut x in xs` / `for x, i in xs` over a slice (mirrors `emit_slice_for`):
// snapshot `_s{n}`, count `_k{n}`, bind the element by value (`read`) or by pointer (`mut`, which
// joins the by-pointer name set for the body), optional index binding.
fn emit_slice_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, depth: i32) {
    let conv: i32 = list.get(i32, p.lar, (e.a + 7) as usize)
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let stid: i32 = list.get(i32, c.et, src0 as usize)
    let sd: typeck.TyData = list.get(typeck.TyData, c.tys, stid as usize)   // Slice: a = elem
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_ty_c(sb, src, c, stid)
    string_push(sb, " _s")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _s")
    push_uint(sb, n as i64)
    string_push(sb, ".len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding (second triple)
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    var added_ptr: bool = false
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        emit_ty_c(sb, src, c, sd.a)
        if conv == 2 {                                // mut: bind a pointer into the slice
            string_push(sb, "* j_")
            string_push(sb, bname)
            string_push(sb, " = &_s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
            list.push(i32, g.pp, bns)
            list.push(i32, g.pp, bne)
            added_ptr = true
        } else {                                      // read: bind the element by value
            string_push(sb, " j_")
            string_push(sb, bname)
            string_push(sb, " = _s")
            push_uint(sb, n as i64)
            string_push(sb, ".ptr[_k")
            push_uint(sb, n as i64)
            string_push(sb, "];\n")
        }
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    if added_ptr { list.truncate(i32, g.pp, list.len(i32, g.pp) - 2) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for b in s` over a str: snapshot `_str{n}`, count `_k{n}`, bind each BYTE as
// `uint8_t j_b = (uint8_t)_str{n}.ptr[_k{n}];` (mirrors `emit_str_for`). Optional index binding.
fn emit_str_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, depth: i32) {
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    string_push(sb, "JestyrStr _str")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < _str")
    push_uint(sb, n as i64)
    string_push(sb, ".len; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding (second triple)
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        string_push(sb, "uint8_t j_")
        string_push(sb, bname)
        string_push(sb, " = (uint8_t)_str")
        push_uint(sb, n as i64)
        string_push(sb, ".ptr[_k")
        push_uint(sb, n as i64)
        string_push(sb, "];\n")
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for x in arr` over a fixed-size array (mirrors `emit_array_for`): take the array's ADDRESS
// (`_a{n}`, so no whole-array copy), count to its constant length, bind the element by value
// (`read`) or by pointer (`mut`, which joins the by-pointer name set for the body).
fn emit_array_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, src0: i32, bc: i32, sty: i32, depth: i32) {
    let conv: i32 = list.get(i32, p.lar, (e.a + 7) as usize)
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    let ad: typeck.TyData = list.get(typeck.TyData, c.tys, sty as usize)   // Array: a = elem, b = len
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    indent(sb, depth)
    emit_ty_c(sb, src, c, sty)
    string_push(sb, "* _a")
    push_uint(sb, n as i64)
    string_push(sb, " = &(")
    emit_expr(sb, p, src, c, g, src0)
    string_push(sb, ");\n")
    indent(sb, depth)
    string_push(sb, "for (size_t _k")
    push_uint(sb, n as i64)
    string_push(sb, " = 0; _k")
    push_uint(sb, n as i64)
    string_push(sb, " < ")
    push_uint(sb, ad.b as i64)
    string_push(sb, "; _k")
    push_uint(sb, n as i64)
    string_push(sb, "++)\n")
    line_at(sb, depth, "{")
    emit_scratch_reset(sb, src, g, depth + 1)
    if bc >= 2 {                                      // optional index binding
        let ins: i32 = list.get(i32, p.lar, (e.a + 11) as usize)
        let ine: i32 = list.get(i32, p.lar, (e.a + 12) as usize)
        if !str_eq(src[ins as usize .. ine as usize], "_") {
            indent(sb, depth + 1)
            string_push(sb, "size_t j_")
            string_push(sb, src[ins as usize .. ine as usize])
            string_push(sb, " = _k")
            push_uint(sb, n as i64)
            string_push(sb, ";\n")
        }
    }
    var added_ptr: bool = false
    if !str_eq(bname, "_") {
        indent(sb, depth + 1)
        emit_ty_c(sb, src, c, ad.a)
        if conv == 2 {                                // mut: bind a pointer into the array
            string_push(sb, "* j_")
            string_push(sb, bname)
            string_push(sb, " = &_a")
        } else {
            string_push(sb, " j_")
            string_push(sb, bname)
            string_push(sb, " = _a")
        }
        push_uint(sb, n as i64)
        string_push(sb, "->a[_k")
        push_uint(sb, n as i64)
        string_push(sb, "];\n")
        if conv == 2 {
            list.push(i32, g.pp, bns)
            list.push(i32, g.pp, bne)
            added_ptr = true
        }
    }
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, e.b as usize)
    var i: i32 = 0
    for i < blk.y {
        emit_stmt(sb, p, src, c, g, list.get(i32, p.sar, (blk.x + i) as usize), depth + 1)
        i = i + 1
    }
    if added_ptr { list.truncate(i32, g.pp, list.len(i32, g.pp) - 2) }
    emit_cont_target(sb, src, g, depth + 1)
    line_at(sb, depth, "}")
}

// `for i in lo..hi { B }` -> `<cty> _hi{n} = <hi>; for (<cty> j_i = <lo>; j_i </<= _hi{n}; j_i++)`.
// `cty` is `hi`'s numeric type (via the Checker) or `size_t`; `_` binds an internal `_i{n}`.
fn emit_range_for(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, read e: parser.ExprData, read sx: parser.ExprData, src0: i32, step: i32, depth: i32) {
    let n: i32 = g.tmp
    g.tmp = g.tmp + 1
    let bns: i32 = list.get(i32, p.lar, (e.a + 8) as usize)   // bind triple: (conv, ns, ne)
    let bne: i32 = list.get(i32, p.lar, (e.a + 9) as usize)
    let bname: str = src[bns as usize .. bne as usize]
    // A negative *literal* step descends: compare with `>`/`>=` and use a signed index (so
    // `size_t` underflow can't run the loop forever). Mirrors `descending` in the reference.
    var descending: bool = false
    if step >= 0 {
        let sp: parser.ExprData = list.get(parser.ExprData, p.ex, step as usize)
        if sp.kind == 3 and sp.op == 1 { descending = true }  // Unary neg
    }
    // The loop-index C type: int64_t when descending, else hi's numeric prim, else size_t.
    var numeric: i32 = 0 - 1
    if sx.b >= 0 {
        let tid: i32 = list.get(i32, c.et, sx.b as usize)
        if tid >= 0 {
            let d: typeck.TyData = list.get(typeck.TyData, c.tys, tid as usize)
            if d.kind == 2 and d.x <= 11 { numeric = d.x }
        }
    }
    indent(sb, depth)
    if descending { string_push(sb, "int64_t") }
    else if numeric >= 0 { prim_code_c(sb, numeric) }
    else { string_push(sb, "size_t") }
    string_push(sb, " _hi")
    push_uint(sb, n as i64)
    string_push(sb, " = ")
    if sx.b >= 0 { emit_expr(sb, p, src, c, g, sx.b) } else { string_push(sb, "0") }
    string_push(sb, ";\n")
    indent(sb, depth)
    string_push(sb, "for (")
    if descending { string_push(sb, "int64_t") }
    else if numeric >= 0 { prim_code_c(sb, numeric) }
    else { string_push(sb, "size_t") }
    string_push(sb, " ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    string_push(sb, " = ")
    if sx.a >= 0 { emit_expr(sb, p, src, c, g, sx.a) } else { string_push(sb, "0") }
    string_push(sb, "; ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    if descending {
        if sx.op == 1 { string_push(sb, " >= _hi") } else { string_push(sb, " > _hi") }
    } else {
        if sx.op == 1 { string_push(sb, " <= _hi") } else { string_push(sb, " < _hi") }
    }
    push_uint(sb, n as i64)
    string_push(sb, "; ")
    if str_eq(bname, "_") { string_push(sb, "_i")  push_uint(sb, n as i64) }
    else { string_push(sb, "j_")  string_push(sb, bname) }
    if step >= 0 {                                    // stepped: `<i> += (<step>)`
        string_push(sb, " += (")
        emit_expr(sb, p, src, c, g, step)
        string_push(sb, "))\n")
    } else {
        string_push(sb, "++)\n")
    }
    // An exposed, exclusive, unstepped `for i in lo..hi` registers a refinement for the body, so
    // a `s[i]` whose range hi is `s.len` elides its bounds check (mirrors `cur_refines`).
    var refined: bool = false
    if !str_eq(bname, "_") and sx.op == 0 and step < 0 {
        list.push(i32, g.rf, bns)
        list.push(i32, g.rf, bne)
        list.push(i32, g.rf, src0)
        refined = true
    }
    emit_loop_body(sb, p, src, c, g, e.b, depth)
    if refined { list.truncate(i32, g.rf, list.len(i32, g.rf) - 3) }
}

// The `<ret> jestyr_<name>(<params>)` signature (no trailing newline). Mirrors `fn_signature`.
fn emit_fn_sig(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    // A fallible fn returns its result struct; otherwise its ok type (`it.z`, -1 = void).
    if fn_is_fallible(p, it) { emit_result_name(sb, p, src, it.z) }
    else { emit_c_ty(sb, p, src, it.z) }
    string_push(sb, " jestyr_")
    string_push(sb, src[it.x .. it.y])
    emit_params(sb, p, src, it)
}

// The `(<params>)` list of a function (mirrors `params_str`). `self` and `comptime` params are
// erased; `mut`/`out` params arrive by pointer. Empty -> `(void)`. Params are 7-tuples in `iar`
// at `it.a`, count `it.b`: [comptime, conv, name_start, name_end, is_self, type_id, refine].
fn emit_params(mut sb: String, read p: parser.Parser, read src: str, read it: parser.ItemData) {
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < it.b {
        let base: i32 = it.a + i * 7
        let comp: i32 = list.get(i32, p.iar, base as usize)
        let is_self: i32 = list.get(i32, p.iar, (base + 4) as usize)
        if comp == 0 and is_self == 0 {
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
            emit_c_ty(sb, p, src, pty)
            if conv == 2 or conv == 4 { string_push(sb, "* restrict") }   // mut / out -> by pointer
            string_push(sb, " j_")
            let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
            let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
            string_push(sb, src[pns as usize .. pne as usize])
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// A method's signature `<ret> jestyr_<S>_<m>(<params>)` — like `emit_fn_sig` but `self` renders
// as a real first parameter `Jestyr_<S>[* restrict] j_self` (pointer for `mut`/`out self`).
// Mirrors `emit_method_decl`'s sig + `method_params_str`.
fn emit_method_sig(mut sb: String, read p: parser.Parser, read src: str, read sd: parser.ItemData, read fd: parser.ItemData) {
    emit_c_ty(sb, p, src, fd.z)
    string_push(sb, " jestyr_")
    string_push(sb, src[sd.x .. sd.y])
    string_push(sb, "_")
    string_push(sb, src[fd.x .. fd.y])
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        if list.get(i32, p.iar, base as usize) == 0 {          // not comptime
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if list.get(i32, p.iar, (base + 4) as usize) == 1 {   // self
                string_push(sb, "Jestyr_")
                string_push(sb, src[sd.x .. sd.y])
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_self")
            } else {
                emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_")
                string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            }
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// Method prototypes (mirrors `method_protos`): one `<sig>;` per collected (struct, method)
// instance, then the section's unconditional trailing blank.
fn emit_method_protos(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.mi) {
        let sd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.mi, k) as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, g.mi, k + 1) as usize)
        emit_method_sig(sb, p, src, sd, fd)
        string_push(sb, ";\n")
        k = k + 2
    }
    string_push(sb, "\n")
}

// Method definitions (mirrors `method_defs` -> `emit_method_decl(body=true)`): sig + body + blank.
// The body runs with `self_ptr` set for a `mut`/`out self` (SelfValue then renders `(*j_self)`),
// the method's `mut`/`out` value params in the by-pointer set, and the method's own return type.
fn emit_method_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.mi) {
        let sit: i32 = list.get(i32, g.mi, k)
        let fid: i32 = list.get(i32, g.mi, k + 1)
        let sd: parser.ItemData = list.get(parser.ItemData, p.it, sit as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, fid as usize)
        emit_method_sig(sb, p, src, sd, fd)
        string_push(sb, "\n")
        list.truncate(i32, g.pp, 0)
        var pi: i32 = 0
        for pi < fd.b {
            let pbase: i32 = fd.a + pi * 7
            let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
            if list.get(i32, p.iar, (pbase + 4) as usize) == 0 and (pconv == 2 or pconv == 4) {
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
            }
            pi = pi + 1
        }
        let sconv: i32 = method_self_conv(p, fid)
        g.self_ptr = sconv == 2 or sconv == 4
        g.retty = fd.z
        g.curfn = fid
        g.autoret = true                              // the reference leaves `cur_ret_cty` unset here
        emit_body(sb, p, src, c, g, fd.w, fd.z >= 0, 0)
        g.self_ptr = false
        g.retty = 0 - 1
        g.autoret = false
        list.truncate(i32, g.pp, 0)
        string_push(sb, "\n")
        k = k + 2
    }
}

// A concrete trait-impl method's signature `<ret> jestyr_impl_<Trait>__<TypeKey>__<method>(<params>)`.
// The type key is the Name target's own text (already a C identifier — the reference sanitises
// non-alnum chars only for exotic keys a Name can't contain). `self` renders as a real first
// parameter of the impl target's C type, by `* restrict` pointer for a `mut`/`out self`.
// Mirrors `emit_impl_method_decl`'s sig + `method_params_str` + `impl_method_c_name`.
fn emit_impl_sig(mut sb: String, read p: parser.Parser, read src: str, read im: parser.ItemData, read fd: parser.ItemData) {
    emit_c_ty(sb, p, src, fd.z)
    string_push(sb, " jestyr_impl_")
    string_push(sb, src[im.x .. im.y])                // trait name
    string_push(sb, "__")
    let tt: parser.TypeData = list.get(parser.TypeData, p.ty, im.a as usize)
    string_push(sb, src[tt.start .. tt.end])          // the target's type key
    string_push(sb, "__")
    string_push(sb, src[fd.x .. fd.y])                // method name
    string_push(sb, "(")
    var emitted: i32 = 0
    var i: i32 = 0
    for i < fd.b {
        let base: i32 = fd.a + i * 7
        if list.get(i32, p.iar, base as usize) == 0 {          // not comptime
            if emitted > 0 { string_push(sb, ", ") }
            let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
            if list.get(i32, p.iar, (base + 4) as usize) == 1 {   // self: the impl target's C type
                emit_c_ty(sb, p, src, im.a)
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_self")
            } else {
                emit_c_ty(sb, p, src, list.get(i32, p.iar, (base + 5) as usize))
                if conv == 2 or conv == 4 { string_push(sb, "* restrict") }
                string_push(sb, " j_")
                string_push(sb, src[list.get(i32, p.iar, (base + 2) as usize) as usize .. list.get(i32, p.iar, (base + 3) as usize) as usize])
            }
            emitted = emitted + 1
        }
        i = i + 1
    }
    if emitted == 0 { string_push(sb, "void") }
    string_push(sb, ")")
}

// Trait-impl method prototypes (mirrors `impl_protos`): one `<sig>;` per concrete impl method,
// then a CONDITIONAL trailing blank (only if any emitted — unlike method_protos'). Blanket
// generic impls are monomorphized per instance separately (a later increment); a fallible impl
// method is unsupported by the reference backend, which emits nothing for it.
fn emit_impl_protos(mut sb: String, read p: parser.Parser, read src: str) {
    var any: bool = false
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {                            // (b,z) = method fn-ItemId slice in mar
                let mid: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
                if !fn_is_fallible(p, fd) {
                    emit_impl_sig(sb, p, src, it, fd)
                    string_push(sb, ";\n")
                    any = true
                }
                k = k + 1
            }
        }
        r = r + 1
    }
    if any { string_push(sb, "\n") }
}

// Trait-impl method definitions (mirrors `impl_defs` -> `emit_impl_method_decl(body=true)`):
// sig + body + blank each, after the struct-method defs. The body runs like a struct method's —
// `self_ptr` for a `mut`/`out self`, the method's `mut`/`out` params by pointer, `autoret` (the
// reference leaves `cur_ret_cty` unset), and an EMPTY move set (only `emit_fn` collects moved).
fn emit_impl_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 7 and it.h <= 0 {
            var k: i32 = 0
            for k < it.z {
                let mid: i32 = list.get(i32, p.mar, (it.b + k) as usize)
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, mid as usize)
                if !fn_is_fallible(p, fd) {
                    emit_impl_sig(sb, p, src, it, fd)
                    string_push(sb, "\n")
                    list.truncate(i32, g.pp, 0)
                    var pi: i32 = 0
                    for pi < fd.b {
                        let pbase: i32 = fd.a + pi * 7
                        let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
                        if list.get(i32, p.iar, (pbase + 4) as usize) == 0 and (pconv == 2 or pconv == 4) {
                            list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                            list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
                        }
                        pi = pi + 1
                    }
                    let sconv: i32 = method_self_conv(p, mid)
                    g.self_ptr = sconv == 2 or sconv == 4
                    g.retty = fd.z
                    g.curfn = mid
                    g.autoret = true
                    emit_body(sb, p, src, c, g, fd.w, fd.z >= 0, 0)
                    g.self_ptr = false
                    g.retty = 0 - 1
                    g.autoret = false
                    list.truncate(i32, g.pp, 0)
                    string_push(sb, "\n")
                }
                k = k + 1
            }
        }
        r = r + 1
    }
}

// ---- top-level sections (mirrors emit_program's order) ----

// Forward typedefs for struct/distinct/enum aggregates. None in `hello`, so just the trailing
// blank line the reference always emits.
fn emit_forward_types(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 1 {                             // distinct: `typedef <base> Jestyr_<name>;`
            string_push(sb, "typedef ")
            emit_c_ty(sb, p, src, it.a)               // a = base TypeId
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, ";\n")
        }
        if it.kind == 4 {                             // struct/record/union: forward typedef
            string_push(sb, "typedef ")
            if it.op == 2 { string_push(sb, "union ") } else { string_push(sb, "struct ") }   // op 2 = union
            string_push(sb, "Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, ";\n")
        }
        if it.kind == 5 and it.a == 0 {               // non-generic enum: `typedef struct Jestyr_<E> Jestyr_<E>;`
            string_push(sb, "typedef struct Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, ";\n")
        }
        r = r + 1
    }
    string_push(sb, "\n")
}

// ---- enum / variant lookup (the reference's `variants` map, computed by AST scan) ----

// The item id of the enum that declares a variant named `src[ns..ne]`, or -1. Variants are
// 5-tuples in `ear` at `it.b`, count `it.z`: [name_start, name_end, field_start, field_count, disc].
fn find_variant_enum(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> i32 {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 {
            var k: i32 = 0
            for k < it.z {
                let vb: i32 = it.b + k * 5
                let vns: i32 = list.get(i32, p.ear, vb as usize)
                let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                if str_eq(src[ns .. ne], src[vns as usize .. vne as usize]) { return iid }
                k = k + 1
            }
        }
        r = r + 1
    }
    return 0 - 1
}

// The variant 5-tuple base (into `ear`) of variant `src[ns..ne]` within enum item `enum_iid`, or -1.
fn variant_tuple(read p: parser.Parser, read src: str, enum_iid: i32, ns: usize, ne: usize) -> i32 {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, enum_iid as usize)
    var k: i32 = 0
    for k < it.z {
        let vb: i32 = it.b + k * 5
        let vns: i32 = list.get(i32, p.ear, vb as usize)
        let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
        if str_eq(src[ns .. ne], src[vns as usize .. vne as usize]) { return vb }
        k = k + 1
    }
    return 0 - 1
}

// Emit the leading `(Jestyr_<E>){ .tag = Jestyr_<E>_<v>` of a variant construction (caller adds
// the optional `.u.<v> = { … }` payload and the closing ` }`).
fn emit_variant_head(mut sb: String, read p: parser.Parser, read src: str, enum_iid: i32, read vname: str) {
    let it: parser.ItemData = list.get(parser.ItemData, p.it, enum_iid as usize)
    let en: str = src[it.x .. it.y]
    string_push(sb, "(Jestyr_")
    string_push(sb, en)
    string_push(sb, "){ .tag = Jestyr_")
    string_push(sb, en)
    string_push(sb, "_")
    string_push(sb, vname)
}

// Like `emit_variant_head`, but for a generic-enum INSTANCE (the construct expr's Checker type
// `tid`, kind 6): `(<N>){ .tag = <N>_<v>` where N = `Jestyr_<ctor>__<args>`.
fn emit_gvariant_head(mut sb: String, read src: str, read c: typeck.Checker, tid: i32, read vname: str) {
    string_push(sb, "(")
    emit_ty_c(sb, src, c, tid)
    string_push(sb, "){ .tag = ")
    emit_ty_c(sb, src, c, tid)
    string_push(sb, "_")
    string_push(sb, vname)
}

// Struct/record/union definitions (mirrors Cgen::struct_defs). Members are 10-tuples in `mar`
// at `it.a`, count `it.b`: [tag(0=field,1=method), pub, name_start, name_end, type_id, default,
// attr_start, attr_count, bits_start, bits_end]. Only fields are emitted (methods live in fn_defs);
// each struct ends with `};\n\n` (the trailing blank). `@packed`/`@align` attrs are still TODO.
fn emit_struct_defs(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 4 {
            if it.op == 2 { string_push(sb, "union") } else { string_push(sb, "struct") }
            emit_struct_attr(sb, p, src, it)          // `@packed`/`@align(n)` -> __attribute__((…))
            string_push(sb, " Jestyr_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " {\n")
            var m: i32 = 0
            for m < it.b {
                let base: i32 = it.a + m * 10
                let tag: i32 = list.get(i32, p.mar, base as usize)
                if tag == 0 {                         // a field (not a method)
                    string_push(sb, "    ")
                    if field_has_attr(p, src, base, "volatile") { string_push(sb, "volatile ") }
                    let fty: i32 = list.get(i32, p.mar, (base + 4) as usize)
                    emit_c_ty(sb, p, src, fty)
                    string_push(sb, " j_")
                    let fns: i32 = list.get(i32, p.mar, (base + 2) as usize)
                    let fne: i32 = list.get(i32, p.mar, (base + 3) as usize)
                    string_push(sb, src[fns as usize .. fne as usize])
                    let bs: i32 = list.get(i32, p.mar, (base + 8) as usize)   // `: bits` width span
                    if bs >= 0 {
                        string_push(sb, " : ")
                        string_push(sb, src[bs as usize .. list.get(i32, p.mar, (base + 9) as usize) as usize])
                    }
                    string_push(sb, ";\n")
                }
                m = m + 1
            }
            string_push(sb, "};\n\n")
        }
        r = r + 1
    }
}

// Enum definitions (mirrors Cgen::enum_defs): a tag enum `enum Jestyr_<E>_tag { … };` (variant
// discriminants set explicit values) then `struct Jestyr_<E> { enum … tag; [union { … } u;] };`.
// The payload union appears only if some variant has fields. Non-generic enums only (a generic
// enum is a template; niche-opt is deferred). Each ends `};\n\n`.
fn emit_enum_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 5 and it.a == 0 {               // non-generic enum (a == tparam count)
            let en: str = src[it.x .. it.y]
            string_push(sb, "enum Jestyr_")
            string_push(sb, en)
            string_push(sb, "_tag {\n")
            var any_payload: bool = false
            var k: i32 = 0
            for k < it.z {
                let vb: i32 = it.b + k * 5
                let vns: i32 = list.get(i32, p.ear, vb as usize)
                let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                let disc: i32 = list.get(i32, p.ear, (vb + 4) as usize)
                if list.get(i32, p.ear, (vb + 3) as usize) > 0 { any_payload = true }
                string_push(sb, "    Jestyr_")
                string_push(sb, en)
                string_push(sb, "_")
                string_push(sb, src[vns as usize .. vne as usize])
                if disc >= 0 {
                    string_push(sb, " = ")
                    emit_expr(sb, p, src, c, g, disc)
                }
                string_push(sb, ",\n")
                k = k + 1
            }
            string_push(sb, "};\n")
            string_push(sb, "struct Jestyr_")
            string_push(sb, en)
            string_push(sb, " {\n    enum Jestyr_")
            string_push(sb, en)
            string_push(sb, "_tag tag;\n")
            if any_payload {
                string_push(sb, "    union {\n")
                var k2: i32 = 0
                for k2 < it.z {
                    let vb: i32 = it.b + k2 * 5
                    let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                    if fc > 0 {
                        let vns: i32 = list.get(i32, p.ear, vb as usize)
                        let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
                        let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)   // field 3-tuple base
                        string_push(sb, "        struct { ")
                        var fi: i32 = 0
                        for fi < fc {
                            let fb: i32 = fs + fi * 3
                            emit_c_ty(sb, p, src, list.get(i32, p.ear, (fb + 2) as usize))   // field type
                            string_push(sb, " j_")
                            string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                            string_push(sb, "; ")
                            fi = fi + 1
                        }
                        string_push(sb, "} ")
                        string_push(sb, src[vns as usize .. vne as usize])
                        string_push(sb, ";\n")
                    }
                    k2 = k2 + 1
                }
                string_push(sb, "    } u;\n")
            }
            string_push(sb, "};\n\n")
        }
        r = r + 1
    }
}

// Forward typedefs for monomorphized generic-enum instances (mirrors `gen_forward_types`):
// `typedef struct <N> <N>;` each, + a trailing blank only if any (a CONDITIONAL blank, unlike
// forward_types'). Generic-STRUCT instances join when comptime-ctor structs are ported.
fn emit_gen_forward_types(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var any: bool = false
    var k: usize = 0
    for k < list.len(i32, g.gei) {
        let tid: i32 = list.get(i32, g.gei, k)
        string_push(sb, "typedef struct ")
        emit_ty_c(sb, src, c, tid)
        string_push(sb, " ")
        emit_ty_c(sb, src, c, tid)
        string_push(sb, ";\n")
        any = true
        k = k + 1
    }
    if any { string_push(sb, "\n") }
}

// Generic-enum instance definitions (mirrors `gen_enum_defs`/`emit_enum_instance`): per collected
// instance, the tag enum + tagged-union struct under the instance name, with each payload field
// type run through the tparam->arg substitution.
fn emit_gen_enum_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.gei) {
        let tid: i32 = list.get(i32, g.gei, k)
        let eit: i32 = genum_item_of(p, src, c, tid)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, eit as usize)
        string_push(sb, "enum ")
        emit_ty_c(sb, src, c, tid)
        string_push(sb, "_tag {\n")
        var any_payload: bool = false
        var v: i32 = 0
        for v < it.z {
            let vb: i32 = it.b + v * 5
            if list.get(i32, p.ear, (vb + 3) as usize) > 0 { any_payload = true }
            string_push(sb, "    ")
            emit_ty_c(sb, src, c, tid)
            string_push(sb, "_")
            string_push(sb, src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize])
            let disc: i32 = list.get(i32, p.ear, (vb + 4) as usize)
            if disc >= 0 {
                string_push(sb, " = ")
                emit_expr(sb, p, src, c, g, disc)
            }
            string_push(sb, ",\n")
            v = v + 1
        }
        string_push(sb, "};\n")
        string_push(sb, "struct ")
        emit_ty_c(sb, src, c, tid)
        string_push(sb, " {\n    enum ")
        emit_ty_c(sb, src, c, tid)
        string_push(sb, "_tag tag;\n")
        if any_payload {
            string_push(sb, "    union {\n")
            var v2: i32 = 0
            for v2 < it.z {
                let vb: i32 = it.b + v2 * 5
                let fc: i32 = list.get(i32, p.ear, (vb + 3) as usize)
                if fc > 0 {
                    let fs: i32 = list.get(i32, p.ear, (vb + 2) as usize)
                    string_push(sb, "        struct { ")
                    var fi: i32 = 0
                    for fi < fc {
                        let fb: i32 = fs + fi * 3
                        emit_field_ty_subst(sb, p, src, c, list.get(i32, p.ear, (fb + 2) as usize), eit, tid)
                        string_push(sb, " j_")
                        string_push(sb, src[list.get(i32, p.ear, fb as usize) as usize .. list.get(i32, p.ear, (fb + 1) as usize) as usize])
                        string_push(sb, "; ")
                        fi = fi + 1
                    }
                    string_push(sb, "} ")
                    string_push(sb, src[list.get(i32, p.ear, vb as usize) as usize .. list.get(i32, p.ear, (vb + 1) as usize) as usize])
                    string_push(sb, ";\n")
                }
                v2 = v2 + 1
            }
            string_push(sb, "    } u;\n")
        }
        string_push(sb, "};\n\n")
        k = k + 1
    }
}

// Slice typedefs: one `typedef struct { <ecty>* ptr; size_t len; } JestyrSlice_<m>;` per distinct
// concrete element type, discovered like `collect_slices` — the type arena's `[]T` annotations
// first, then `slice(T, …)` construction calls — deduped by mangle, + a trailing blank if any.
// (Monomorphized-generic contributions arrive with generics.)
fn emit_slice_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var seen: String = string_new()
    var any: bool = false
    var i: usize = 0
    for i < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, i)
        if t.kind == 3 { any = emit_one_slice_def(sb, p, src, c, t.a, seen) or any }
        i = i + 1
    }
    var e2: usize = 0
    for e2 < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, e2)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "slice") {
                    if e.y >= 1 {
                        let a0: i32 = list.get(i32, p.ar, e.x as usize)
                        let ax: parser.ExprData = list.get(parser.ExprData, p.ex, a0 as usize)
                        if ax.kind == 2 { any = emit_one_slice_name(sb, src, c, src[ax.start .. ax.end], seen) or any }
                    }
                }
            }
        }
        e2 = e2 + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// One slice typedef from an AST element-type node (a concrete Name only, for now). Returns
// whether a typedef was emitted; `seen` accumulates `|mangle|` markers for dedup.
fn emit_one_slice_def(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, elem_ty: i32, mut seen: String) -> bool {
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, elem_ty as usize)
    if t.kind != 0 { return false }                   // structural elems arrive later
    return emit_one_slice_name(sb, src, c, src[t.start .. t.end], seen)
}

// One slice typedef for element-name `nm` (a prim or a declared type; anything else — e.g. a
// generic `T` — is an opaque template, skipped like the reference's `is_concrete`).
fn emit_one_slice_name(mut sb: String, read src: str, read c: typeck.Checker, read nm: str, mut seen: String) -> bool {
    let pc: str = c_prim(nm)
    if str_eq(pc, "") {
        if !is_declared_type(c, src, nm) { return false }
    }
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, nm)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    string_push(sb, "typedef struct { ")
    if str_eq(pc, "") { string_push(sb, "Jestyr_")  string_push(sb, nm) } else { string_push(sb, pc) }
    string_push(sb, "* ptr; size_t len; } JestyrSlice_")
    string_push(sb, nm)
    string_push(sb, ";\n")
    return true
}

// Is `nm` a declared (Named) type in the Checker's table?
fn is_declared_type(read c: typeck.Checker, read src: str, read nm: str) -> bool {
    var r: i32 = 0
    for r < (list.len(i32, c.tdecl) / 10) as i32 {
        let ns: i32 = list.get(i32, c.tdecl, (r * 10 + 0) as usize)
        let ne: i32 = list.get(i32, c.tdecl, (r * 10 + 1) as usize)
        if str_eq(nm, src[ns as usize .. ne as usize]) { return true }
        r = r + 1
    }
    return false
}

// Top-level `const`s: `static const <cty> j_<name> = <value>;` each, then the unconditional
// trailing blank. An array-literal value takes a BRACE initializer (`{ { … } }`) rather than the
// statement-expression `emit_expr` would give — a `static const` can't be initialized by a GNU
// statement-expression. (`@no_mangle` consts + `@section` are still TODO.)
fn emit_consts(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 2 {                             // Const: (x,y)=name span, a=type, b=value
            string_push(sb, "static const ")
            if it.a >= 0 { emit_c_ty(sb, p, src, it.a) }
            else { emit_ty_c(sb, src, c, list.get(i32, c.et, it.b as usize)) }
            string_push(sb, " j_")
            string_push(sb, src[it.x .. it.y])
            string_push(sb, " = ")
            let v: parser.ExprData = list.get(parser.ExprData, p.ex, it.b as usize)
            if v.kind == 14 {                         // array literal -> brace initializer
                string_push(sb, "{ { ")
                var i: i32 = 0
                for i < v.y {
                    if i > 0 { string_push(sb, ", ") }
                    emit_expr(sb, p, src, c, g, list.get(i32, p.ar, (v.x + i) as usize))
                    i = i + 1
                }
                string_push(sb, " } }")
            } else {
                emit_expr(sb, p, src, c, g, it.b)
            }
            string_push(sb, ";\n")
        }
        r = r + 1
    }
    string_push(sb, "\n")
}

// Array typedefs: one `typedef struct { <ecty> a[N]; } JestyrArr_<m>_<N>;` per distinct concrete
// array instance. Mirrors `collect_arrays`' scan ORDER — the Checker's per-expr types FIRST (in
// expr-arena order), then function signature annotations. The expr scan is load-bearing: a
// `const T: [5]i64 = [2,3,…]` literal infers its OWN `[5]i32` (the const's value is inferred with
// no expected type), so BOTH `JestyrArr_i32_5` and `JestyrArr_i64_5` are emitted, in that order.
fn emit_array_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var seen: String = string_new()
    var any: bool = false
    var i: usize = 0
    for i < list.len(i32, c.et) {                     // per-expr types, in expr-arena order
        any = emit_one_array_def(sb, src, c, list.get(i32, c.et, i), seen) or any
    	i = i + 1
    }
    var r: i32 = 0                                    // then fn signature annotations
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            var pi: i32 = 0
            for pi < it.b {
                any = emit_one_array_def_ast(sb, p, src, c, list.get(i32, p.iar, (it.a + pi * 7 + 5) as usize), seen) or any
                pi = pi + 1
            }
            any = emit_one_array_def_ast(sb, p, src, c, it.z, seen) or any
        }
        r = r + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// One array typedef from a Checker TyId (only an Array, kind 9, contributes).
fn emit_one_array_def(mut sb: String, read src: str, read c: typeck.Checker, tyid: i32, mut seen: String) -> bool {
    if tyid < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, tyid as usize)
    if d.kind != 9 { return false }
    var m: String = string_new()                      // the instance key = its full mangle
    push_ty_mangle(m, src, c, d.a)
    string_push(m, "_")
    push_uint(m, d.b as i64)
    let ok: bool = push_array_typedef(sb, string_view(m), seen, src, c, d.a, 0 - 1, d.b)
    string_free(m)
    return ok
}

// One array typedef from an AST TypeId (a `[N]T` annotation).
fn emit_one_array_def_ast(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, tyid: i32, mut seen: String) -> bool {
    if tyid < 0 { return false }
    let t: parser.TypeData = list.get(parser.TypeData, p.ty, tyid as usize)
    if t.kind != 4 { return false }
    var m: String = string_new()
    push_ast_mangle(m, p, src, t.a)
    string_push(m, "_")
    push_array_len(m, p, src, t.b)
    var ec: String = string_new()
    emit_c_ty(ec, p, src, t.a)
    var ln: String = string_new()
    push_array_len(ln, p, src, t.b)
    let ok: bool = push_array_typedef_raw(sb, string_view(m), seen, string_view(ec), string_view(ln))
    string_free(m)  string_free(ec)  string_free(ln)
    return ok
}

// Emit `typedef struct { <ecty> a[<len>]; } JestyrArr_<key>;` unless `key` was already emitted.
fn push_array_typedef(mut sb: String, read key: str, mut seen: String, read src: str, read c: typeck.Checker, elem: i32, unused: i32, len: i32) -> bool {
    var ec: String = string_new()
    emit_ty_c(ec, src, c, elem)
    var ln: String = string_new()
    push_uint(ln, len as i64)
    let ok: bool = push_array_typedef_raw(sb, key, seen, string_view(ec), string_view(ln))
    string_free(ec)  string_free(ln)
    return ok
}

// The dedup + emit core: `key` is the instance's mangle (`<elem>_<len>`).
fn push_array_typedef_raw(mut sb: String, read key: str, mut seen: String, read ecty: str, read len: str) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, key)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    string_push(sb, "typedef struct { ")
    string_push(sb, ecty)
    string_push(sb, " a[")
    string_push(sb, len)
    string_push(sb, "]; } JestyrArr_")
    string_push(sb, key)
    string_push(sb, ";\n")
    return true
}

// One `typedef struct { <E>* ptr; uint64_t gen; } JestyrRef_<m>;`, deduped by elem mangle.
fn push_genref_typedef(mut sb: String, mut seen: String, read m: str, read ecty: str) -> bool {
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, m)
    string_push(probe, "|")
    if contains(string_view(seen), string_view(probe)) { string_free(probe)  return false }
    string_push(seen, string_view(probe))
    string_free(probe)
    string_push(sb, "typedef struct { ")
    string_push(sb, ecty)
    string_push(sb, "* ptr; uint64_t gen; } JestyrRef_")
    string_push(sb, m)
    string_push(sb, ";\n")
    return true
}

// Fn-pointer typedefs (mirrors `collect_fn_types` + `fn_type_typedefs`): one
// `typedef <ret> (*JestyrFn_<sig>)(<params>);` per distinct signature written in the type
// arena (arena order — a nested fn type has a smaller id, so inner typedefs emit first),
// deduped by mangle; + a CONDITIONAL trailing blank. The typedef puts the name on the OUTSIDE,
// so every later use is a plain `JestyrFn_<sig> j_x`. A `mut`/`out` param lowers to `T*` (no
// `restrict` — matching a real Jestyr fn's ABI so a pointer can hold `&some_fn`). Generic
// placeholders and monomorphized-signature contributions are a later increment.
fn emit_fn_type_defs(mut sb: String, read p: parser.Parser, read src: str) {
    var any: bool = false
    var seen: String = string_new()
    var ti: usize = 0
    for ti < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, ti)
        if t.kind == 9 {
            var m: String = string_new()
            push_ast_mangle(m, p, src, ti as i32)
            var probe: String = string_new()
            string_push(probe, "|")
            string_push(probe, string_view(m))
            string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                string_push(sb, "typedef ")
                emit_c_ty(sb, p, src, t.x)             // ret (-1 -> void)
                string_push(sb, " (*JestyrFn_")
                string_push(sb, string_view(m))
                string_push(sb, ")(")
                if t.a == 0 { string_push(sb, "void") }
                var i: i32 = 0
                for i < t.a {
                    if i > 0 { string_push(sb, ", ") }
                    let conv: i32 = list.get(i32, p.tar, (t.op + i * 2) as usize)
                    emit_c_ty(sb, p, src, list.get(i32, p.tar, (t.op + i * 2 + 1) as usize))
                    if conv == 2 or conv == 4 { string_push(sb, "*") }
                    i = i + 1
                }
                string_push(sb, ");\n")
                any = true
            }
            string_free(m)
            string_free(probe)
        }
        ti = ti + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// Generational-reference typedefs (mirrors `collect_genrefs` + `genref_struct_defs`): every
// distinct `&T` element — the type arena's GenRef annotations first (arena order), then
// `gen_new(T, …)` constructions (expr order) — one `JestyrRef_<T>` each, + a CONDITIONAL
// trailing blank. `{ E* ptr; gen }` embeds E only through a pointer, so no by-value dep.
fn emit_genref_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker) {
    var any: bool = false
    var seen: String = string_new()
    var ti: usize = 0
    for ti < list.len(parser.TypeData, p.ty) {
        let t: parser.TypeData = list.get(parser.TypeData, p.ty, ti)
        if t.kind == 5 {                              // a `&T` annotation
            var m: String = string_new()
            push_ast_mangle(m, p, src, t.a)
            var ec: String = string_new()
            emit_c_ty(ec, p, src, t.a)
            any = push_genref_typedef(sb, seen, string_view(m), string_view(ec)) or any
            string_free(m)
            string_free(ec)
        }
        ti = ti + 1
    }
    var e2: usize = 0
    for e2 < list.len(parser.ExprData, p.ex) {
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, e2)
        if e.kind == 10 {
            let callee: parser.ExprData = list.get(parser.ExprData, p.ex, e.a as usize)
            if callee.kind == 2 {
                if str_eq(src[callee.start .. callee.end], "gen_new") {
                    if e.y >= 1 {
                        let ax: parser.ExprData = list.get(parser.ExprData, p.ex, arg_at(p, e, 0) as usize)
                        if ax.kind == 2 {             // the bare-Name type arg is its own mangle
                            var ec: String = string_new()
                            emit_type_arg_cty(ec, p, src, arg_at(p, e, 0))
                            any = push_genref_typedef(sb, seen, src[ax.start .. ax.end], string_view(ec)) or any
                            string_free(ec)
                        }
                    }
                }
            }
        }
        e2 = e2 + 1
    }
    if any { string_push(sb, "\n") }
    string_free(seen)
}

// Result-struct typedefs. `JestyrResult_str` (the `try_from_utf8` intrinsic's result) is emitted
// unconditionally up front; fallible user functions add their own (none in `hello`).
fn emit_result_defs(mut sb: String, read p: parser.Parser, read src: str) {
    string_push(sb, "typedef struct { bool is_err; JestyrStr ok; int err; } JestyrResult_str;\n")
    var seen: String = string_new()
    string_push(seen, "|str|")                        // `try_from_utf8`'s result is pre-seeded
    // `try_read_file`'s result type isn't discovered from a fn signature — emit it (only when
    // used) and seed `seen` so a user `String !E` fn doesn't duplicate the typedef (B3).
    if uses_try_read(p, src) {
        string_push(sb, "typedef struct { bool is_err; JestyrString ok; int err; } JestyrResult_String;\n")
        string_push(seen, "|String|")
    }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and fn_is_fallible(p, it) {
            var m: String = string_new()              // ok-type mangle = the dedup key
            if it.z < 0 { string_push(m, "unit") } else { push_ast_mangle(m, p, src, it.z) }
            var probe: String = string_new()
            string_push(probe, "|")  string_push(probe, string_view(m))  string_push(probe, "|")
            if !contains(string_view(seen), string_view(probe)) {
                string_push(seen, string_view(probe))
                string_push(sb, "typedef struct { bool is_err; ")
                if it.z >= 0 {                        // a unit ok type omits the `ok` field
                    emit_c_ty(sb, p, src, it.z)
                    string_push(sb, " ok; ")
                }
                string_push(sb, "int err; } JestyrResult_")
                string_push(sb, string_view(m))
                string_push(sb, ";\n")
            }
            string_free(m)  string_free(probe)
        }
        r = r + 1
    }
    string_free(seen)
    string_push(sb, "\n")
}

// Function prototypes: one `<sig>;` per non-generic, backend-supported function, then one per
// monomorphized generic instance (subst-aware sig), then the unconditional blank.
// ---- closures: lambda lifting (mirrors `collect_closures`/`make_closure_info`/`closure_types`/
// `closure_fns`/`emit_closure_literal`/`emit_closure_invoke`). Every lifted name embeds the
// closure's ExprId — legal only because the Jestyr parser's expr-arena numbering is pinned to
// the reference's (the P2 golden). A closure the Checker stamped with a `Fn` type (kind 12) is
// a THIN coerced closure -> a bare `static` function + `(&jestyr_lam_<id>)`; one left
// Opaque("closure") (kind 18, x=0) is FAT -> `JestyrEnv_<id>`/`JestyrClosure_<id>` + env. ----

// Find closure expressions in the reference's discovery order: preorder (a closure pushes
// itself, THEN its body walks — a nested closure lands after its owner). NOTE the reference's
// `find_closures_expr` walks a NARROWER arm set than `gfind_expr` (no Cast, no Range, no
// Region) — mirrored exactly, since discovery order = emission order.
fn cfind_expr(mut found: List(i32), read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 37 {                                 // Closure: record, then walk the body
        list.push(i32, found, eid)
        cfind_expr(found, p, e.a)
        return
    }
    if e.kind == 10 {                                 // Call: callee first, then args
        cfind_expr(found, p, e.a)
        var i: i32 = 0
        for i < e.y {
            cfind_expr(found, p, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {   // Binary / Index / Assign
        cfind_expr(found, p, e.a)
        cfind_expr(found, p, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 34 or e.kind == 35 {
        cfind_expr(found, p, e.a)                     // Unary / Field / Deref / Try / Invariant / Variant
        return
    }
    if e.kind == 16 {                                 // StructLit fields + spread
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            cfind_expr(found, p, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { cfind_expr(found, p, e.b) }
        return
    }
    if e.kind == 17 {                                 // GenStructLit fields
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            cfind_expr(found, p, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {                                 // If: cond, then-block, else
        cfind_expr(found, p, e.a)
        cfind_block(found, p, e.b)
        if e.op >= 0 { cfind_expr(found, p, e.op) }
        return
    }
    if e.kind == 23 { cfind_block(found, p, eid)  return }
    if e.kind == 25 { cfind_block(found, p, e.a)  return }
    if e.kind == 28 {                                 // Match: scrutinee, then per-arm guard + body
        cfind_expr(found, p, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { cfind_expr(found, p, guard) }
            cfind_expr(found, p, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {                                 // For: head sources, body, else
        if e.op == 1 { cfind_expr(found, p, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                cfind_expr(found, p, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        cfind_block(found, p, e.b)
        if e.x >= 0 { cfind_block(found, p, e.x) }
        return
    }
}

fn cfind_block(mut found: List(i32), read p: parser.Parser, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { cfind_expr(found, p, s.a) }
        i = i + 1
    }
}

// Gather every value-name reference in a subtree as (start, end, ExprId) triples, in the
// reference's `collect_refs` traversal order (the ExprId keys the Checker's inferred type for
// the capture's env-field C type). Recurses into NESTED closure bodies, and shares the parent
// walk's deliberate holes (no Cast/Range arms).
fn crefs_expr(mut dst: List(i32), read p: parser.Parser, eid: i32) {
    if eid < 0 { return }
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, eid as usize)
    if e.kind == 2 {                                  // Name: record it
        list.push(i32, dst, e.start as i32)
        list.push(i32, dst, e.end as i32)
        list.push(i32, dst, eid)
        return
    }
    if e.kind == 37 { crefs_expr(dst, p, e.a)  return }   // nested closure: walk its body
    if e.kind == 10 {
        crefs_expr(dst, p, e.a)
        var i: i32 = 0
        for i < e.y {
            crefs_expr(dst, p, list.get(i32, p.ar, (e.x + i) as usize))
            i = i + 1
        }
        return
    }
    if e.kind == 4 or e.kind == 6 or e.kind == 12 {
        crefs_expr(dst, p, e.a)
        crefs_expr(dst, p, e.b)
        return
    }
    if e.kind == 3 or e.kind == 5 or e.kind == 7 or e.kind == 8 or e.kind == 34 or e.kind == 35 {
        crefs_expr(dst, p, e.a)
        return
    }
    if e.kind == 16 {
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.x + i) as usize) as usize)
            crefs_expr(dst, p, fi_.a)
            i = i + 1
        }
        if e.b >= 0 { crefs_expr(dst, p, e.b) }
        return
    }
    if e.kind == 17 {
        var i: i32 = 0
        for i < e.y {
            let fi_: parser.ExprData = list.get(parser.ExprData, p.ex, list.get(i32, p.ar, (e.b + i) as usize) as usize)
            crefs_expr(dst, p, fi_.a)
            i = i + 1
        }
        return
    }
    if e.kind == 24 {
        crefs_expr(dst, p, e.a)
        crefs_block(dst, p, e.b)
        if e.op >= 0 { crefs_expr(dst, p, e.op) }
        return
    }
    if e.kind == 23 { crefs_block(dst, p, eid)  return }
    if e.kind == 25 { crefs_block(dst, p, e.a)  return }
    if e.kind == 28 {
        crefs_expr(dst, p, e.a)
        var k: i32 = 0
        for k < e.y {
            let ab: i32 = e.x + k * 3
            let guard: i32 = list.get(i32, p.par, (ab + 1) as usize)
            if guard >= 0 { crefs_expr(dst, p, guard) }
            crefs_expr(dst, p, list.get(i32, p.par, (ab + 2) as usize))
            k = k + 1
        }
        return
    }
    if e.kind == 31 {
        if e.op == 1 { crefs_expr(dst, p, list.get(i32, p.lar, (e.a + 4) as usize)) }
        if e.op >= 2 {
            let bc: i32 = list.get(i32, p.lar, (e.a + 4) as usize)
            let sc: i32 = list.get(i32, p.lar, (e.a + 5) as usize)
            var si: i32 = 0
            for si < sc {
                crefs_expr(dst, p, list.get(i32, p.lar, (e.a + 7 + bc * 3 + si) as usize))
                si = si + 1
            }
        }
        crefs_block(dst, p, e.b)
        if e.x >= 0 { crefs_block(dst, p, e.x) }
        return
    }
}

fn crefs_block(mut dst: List(i32), read p: parser.Parser, beid: i32) {
    let blk: parser.ExprData = list.get(parser.ExprData, p.ex, beid as usize)
    var i: i32 = 0
    for i < blk.y {
        let s: parser.StmtData = list.get(parser.StmtData, p.st, list.get(i32, p.sar, (blk.x + i) as usize) as usize)
        if s.a >= 0 { crefs_expr(dst, p, s.a) }
        i = i + 1
    }
}

// Is `src[ns..ne]` a top-level/global name (so a reference to it inside a closure body is NOT a
// capture)? Fns, types, enum variants, consts, and intrinsics. Mirrors `is_global_name`.
fn is_global_cname(read p: parser.Parser, read src: str, ns: usize, ne: usize) -> bool {
    let nm: str = src[ns .. ne]
    if find_fn_item(p, src, nm) >= 0 { return true }
    if find_named_item(p, src, ns as i32, ne as i32) >= 0 { return true }
    if find_variant_enum(p, src, ns, ne) >= 0 { return true }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 2 {
            if str_eq(src[it.x .. it.y], nm) { return true }
        }
        r = r + 1
    }
    // The full intrinsic name set (mirrors `is_intrinsic` — wider than the helper tables).
    var probe: String = string_new()
    string_push(probe, "|")
    string_push(probe, nm)
    string_push(probe, "|")
    let hit: bool = contains("|print_int|print_float|print_str|print_bool|alloc|alloc_i32|realloc|realloc_i32|free_ptr|size_of|slice|align_of|offset_of|count_codepoints|codepoints|from_utf8|is_utf8|substr|str_eq|starts_with|ends_with|contains|find|trim|count_graphemes|graphemes|split|try_from_utf8|eq_fold|os_from_bytes|to_str_lossy|cow_borrow|cow_to_mut|cow_view|cow_is_owned|cow_free|string_new|string_from|string_push|string_view|string_free|builder_new|builder_push|builder_build|builder_free|region_str|region_concat|bytes|gen_new|gen_free|region_alloc|ok|err|is_err|unwrap|arena_open|arena_alloc|arena_close|read_file|try_read_file|write_file|file_exists|remove_file|arg_count|arg|", string_view(probe))
    string_free(probe)
    return hit
}

// Does closure `e`'s own param list bind `src[ns..ne]`? (clar 3-tuples at e.x, count e.y.)
fn closure_has_param(read p: parser.Parser, read src: str, read e: parser.ExprData, ns: usize, ne: usize) -> bool {
    var i: i32 = 0
    for i < e.y {
        let b: i32 = e.x + i * 3
        let pns: i32 = list.get(i32, p.clar, b as usize)
        let pne: i32 = list.get(i32, p.clar, (b + 1) as usize)
        if str_eq(src[pns as usize .. pne as usize], src[ns .. ne]) { return true }
        i = i + 1
    }
    return false
}

// Append closure `cid`'s captures to `dst` as (start, end, ref ExprId) triples: free names of
// the body in first-reference order — not params, not globals, deduped by text. Mirrors
// `make_closure_info`.
fn closure_captures(mut dst: List(i32), read p: parser.Parser, read src: str, read a: Allocator, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    var refs: List(i32) = list.make(i32, a)
    crefs_expr(refs, p, e.a)
    let base: usize = list.len(i32, dst)
    var i: usize = 0
    for i < list.len(i32, refs) {
        let ns: i32 = list.get(i32, refs, i)
        let ne: i32 = list.get(i32, refs, i + 1)
        var skip: bool = closure_has_param(p, src, e, ns as usize, ne as usize)
        if !skip {
            if is_global_cname(p, src, ns as usize, ne as usize) { skip = true }
        }
        if !skip {
            var j: usize = base
            for j < list.len(i32, dst) {
                let dns: i32 = list.get(i32, dst, j)
                let dne: i32 = list.get(i32, dst, j + 1)
                if str_eq(src[ns as usize .. ne as usize], src[dns as usize .. dne as usize]) { skip = true }
                j = j + 3
            }
        }
        if !skip {
            list.push(i32, dst, ns)
            list.push(i32, dst, ne)
            list.push(i32, dst, list.get(i32, refs, i + 2))
        }
        i = i + 3
    }
    list.free(i32, refs)
}

// Collect every closure in a NON-generic fn body, const value, or non-generic struct-method
// body (item order; closures inside generic bodies are deferred to monomorphization, exactly
// like the reference), then precompute each one's capture list into `g.cca` (`g.ccx` holds the
// per-closure (base, count) pairs, triple units).
fn collect_closures(mut g: Cg, read p: parser.Parser, read src: str, read a: Allocator) {
    var found: List(i32) = list.make(i32, a)
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_gen(p, it) { cfind_block(found, p, it.w) }
        if it.kind == 2 { cfind_expr(found, p, it.b) }
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mb: i32 = it.a + m * 10
                if list.get(i32, p.mar, mb as usize) == 1 {   // tag 1 = method
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mb + 1) as usize) as usize)
                    if !fn_is_gen(p, fd) { cfind_block(found, p, fd.w) }
                }
                m = m + 1
            }
        }
        r = r + 1
    }
    var i: usize = 0
    for i < list.len(i32, found) {
        let cid: i32 = list.get(i32, found, i)
        list.push(i32, g.cls, cid)
        let cb: i32 = (list.len(i32, g.cca) / 3) as i32
        closure_captures(g.cca, p, src, a, cid)
        list.push(i32, g.ccx, cb)
        list.push(i32, g.ccx, (list.len(i32, g.cca) / 3) as i32 - cb)
        i = i + 1
    }
    list.free(i32, found)
}

// Map a Jestyr expr id to the REFERENCE parser's ExprId for the same node. The Rust AST stores
// fn/method/impl bodies, if-THEN blocks, for body/else blocks, and unsafe/concurrent/region
// inner blocks as `Block` STRUCTS (no ExprId), and struct-literal field inits as plain structs —
// the Jestyr parser allocates a real expr node for each, shifting every later Jestyr id up by
// one. The reference embeds ITS ids in the lifted-closure names (`jestyr_lam_<id>`,
// `JestyrEnv_<id>`, `JestyrClosure_<id>`), so subtract the Jestyr-only nodes below `eid`.
// (If-ELSE blocks, bare block statements, match-arm bodies, and closure bodies are
// expr-position in Rust — shared ids, no offset. F-string interpolations are the one RUST-only
// allocation — the reference parses each interp as a real sub-expression, the span-only Jestyr
// node doesn't — unhandled until an allowlist file mixes f-strings with closures; select-arm
// blocks likewise wait for concurrency.)
fn ref_expr_id(read p: parser.Parser, eid: i32) -> i32 {
    var off: i32 = 0
    var i: usize = 0
    for i < (eid as usize) {                          // FieldInit nodes are always Jestyr-only
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, i)
        if e.kind == 18 { off = off + 1 }
        i = i + 1
    }
    var r: i32 = 0
    for r < list.len(i32, p.roots) {                  // fn / struct-method / impl-method bodies
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if it.w >= 0 and it.w < eid { off = off + 1 }
        }
        if it.kind == 4 {
            var m: i32 = 0
            for m < it.b {
                let mb: i32 = it.a + m * 10
                if list.get(i32, p.mar, mb as usize) == 1 {
                    let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (mb + 1) as usize) as usize)
                    if fd.w >= 0 and fd.w < eid { off = off + 1 }
                }
                m = m + 1
            }
        }
        if it.kind == 7 {
            var k: i32 = 0
            for k < it.z {
                let fd: parser.ItemData = list.get(parser.ItemData, p.it, list.get(i32, p.mar, (it.b + k) as usize) as usize)
                if fd.w >= 0 and fd.w < eid { off = off + 1 }
                k = k + 1
            }
        }
        r = r + 1
    }
    var j: usize = 0
    for j < list.len(parser.ExprData, p.ex) {         // expr-embedded struct-slot blocks
        let e: parser.ExprData = list.get(parser.ExprData, p.ex, j)
        if e.kind == 24 {                             // if-THEN
            if e.b >= 0 and e.b < eid { off = off + 1 }
        } else if e.kind == 31 {                      // for body + else
            if e.b >= 0 and e.b < eid { off = off + 1 }
            if e.x >= 0 and e.x < eid { off = off + 1 }
        } else if e.kind == 25 or e.kind == 38 or e.kind == 43 {   // unsafe / concurrent / region
            if e.a >= 0 and e.a < eid { off = off + 1 }
        } else if e.kind == 16 or e.kind == 17 {      // struct-lit path / gen-lit ctor: Idents in Rust,
            if e.a >= 0 and e.a < eid { off = off + 1 }   // Name expr nodes here
        }
        j = j + 1
    }
    return eid - off
}

// The index of `cid` in the collected-closure list, or -1 (mirrors `closure_index`).
fn closure_index_of(read g: Cg, cid: i32) -> i32 {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        if list.get(i32, g.cls, k) == cid { return k as i32 }
        k = k + 1
    }
    return 0 - 1
}

// Was this closure coerced to a thin fn-pointer? (The Checker stamps such a closure with the
// expected `Fn` type — TyData kind 12 — instead of Opaque("closure").)
fn closure_is_thin(read c: typeck.Checker, cid: i32) -> bool {
    let t: i32 = list.get(i32, c.et, cid as usize)
    if t < 0 { return false }
    let d: typeck.TyData = list.get(typeck.TyData, c.tys, t as usize)
    return d.kind == 12
}

// The `closure_types` section: per FAT closure, the env struct + `{call, env}` struct typedefs
// (a thin coerced closure is a bare function — no structs), then the reference's UNCONDITIONAL
// trailing blank.
fn emit_closure_types(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        let cid: i32 = list.get(i32, g.cls, k)
        if !closure_is_thin(c, cid) {
            let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
            let rn: i32 = ref_expr_id(p, cid)         // the REFERENCE's id names the structs
            let cb: i32 = list.get(i32, g.ccx, k * 2)
            let cc: i32 = list.get(i32, g.ccx, k * 2 + 1)
            string_push(sb, "typedef struct { ")
            if cc == 0 { string_push(sb, "char _unused; ") }
            var ci: i32 = 0
            for ci < cc {
                let b: i32 = (cb + ci) * 3
                let ns: i32 = list.get(i32, g.cca, b as usize)
                let ne: i32 = list.get(i32, g.cca, (b + 1) as usize)
                let rid: i32 = list.get(i32, g.cca, (b + 2) as usize)
                emit_ty_c(sb, src, c, list.get(i32, c.et, rid as usize))
                string_push(sb, " j_")
                string_push(sb, src[ns as usize .. ne as usize])
                string_push(sb, "; ")
                ci = ci + 1
            }
            string_push(sb, "} JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, ";\n")
            string_push(sb, "typedef struct { ")
            emit_ty_c(sb, src, c, list.get(i32, c.et, e.a as usize))   // ret = the body's type
            string_push(sb, " (*call)(JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, "*")
            var pi: i32 = 0
            for pi < e.y {
                string_push(sb, ", ")
                let pty: i32 = list.get(i32, p.clar, (e.x + pi * 3 + 2) as usize)
                if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
                pi = pi + 1
            }
            string_push(sb, "); JestyrEnv_")
            push_uint(sb, rn as i64)
            string_push(sb, " env; } JestyrClosure_")
            push_uint(sb, rn as i64)
            string_push(sb, ";\n")
        }
        k = k + 1
    }
    string_push(sb, "\n")
}

// The single non-block-body shape shared by both lifted-fn forms: a Block/Unsafe body reuses
// `emit_body` at depth 0; any other body wraps in a brace pair with the expr as the tail
// return (or a bare statement when the return type is void). Mirrors `emit_closure_body`.
fn emit_closure_body_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, body: i32, retval: bool) {
    let b: parser.ExprData = list.get(parser.ExprData, p.ex, body as usize)
    if b.kind == 23 { emit_body(sb, p, src, c, g, body, retval, 0)  return }
    if b.kind == 25 { emit_body(sb, p, src, c, g, b.a, retval, 0)  return }
    string_push(sb, "{\n")
    if retval {
        emit_return(sb, p, src, c, g, body, 1)
    } else {
        if b.kind == 24 { emit_if(sb, p, src, c, g, body, false, 1) }
        else if b.kind == 28 { emit_match(sb, p, src, c, g, body, false, 1) }
        else {
            indent(sb, 1)
            emit_expr(sb, p, src, c, g, body)
            string_push(sb, ";\n")
        }
    }
    string_push(sb, "}\n")
}

// A coerced non-capturing closure as a BARE top-level function whose C signature is taken from
// the expected fn-pointer TYPE (so it matches the `JestyrFn_…` typedef byte-for-byte); a
// `mut`/`out` param arrives by pointer, exactly as a real Jestyr function's would. Mirrors
// `emit_thin_closure_fn`.
fn emit_thin_closure_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    let ctd: typeck.TyData = list.get(typeck.TyData, c.tys, list.get(i32, c.et, cid as usize) as usize)
    list.truncate(i32, g.su, 0)
    list.truncate(i32, g.pp, 0)
    list.truncate(i32, g.req, 0)
    list.truncate(i32, g.ens, 0)
    list.truncate(i32, g.caps, 0)
    g.res_ok = 0 - 2
    var rets: String = string_new()
    emit_ty_c(rets, src, c, ctd.x)
    string_push(sb, "static ")
    string_push(sb, string_view(rets))
    string_push(sb, " jestyr_lam_")
    push_uint(sb, ref_expr_id(p, cid) as i64)
    string_push(sb, "(")
    if ctd.b == 0 { string_push(sb, "void") }
    var pi: i32 = 0
    for pi < ctd.b {
        if pi > 0 { string_push(sb, ", ") }
        let conv: i32 = list.get(i32, c.tya, (ctd.a + pi * 2) as usize)
        emit_ty_c(sb, src, c, list.get(i32, c.tya, (ctd.a + pi * 2 + 1) as usize))
        if conv == 2 or conv == 4 { string_push(sb, "*") }
        string_push(sb, " j_")
        if pi < e.y {
            let pb: i32 = e.x + pi * 3
            let pns: i32 = list.get(i32, p.clar, pb as usize)
            let pne: i32 = list.get(i32, p.clar, (pb + 1) as usize)
            string_push(sb, src[pns as usize .. pne as usize])
            if conv == 2 or conv == 4 {
                list.push(i32, g.pp, pns)
                list.push(i32, g.pp, pne)
            }
        } else {
            string_push(sb, "_p")
            push_uint(sb, pi as i64)
        }
        pi = pi + 1
    }
    string_push(sb, ")\n")
    emit_closure_body_c(sb, p, src, c, g, e.a, !str_eq(string_view(rets), "void"))
    string_push(sb, "\n")
    list.truncate(i32, g.pp, 0)
    string_free(rets)
}

// One lifted FAT closure fn: captures arrive through `j__env`, params as ordinary arguments.
// The active capture set (`g.caps`) makes the body's Name arm render a captured name as
// `(j__env->j_<name>)`. Mirrors the fat arm of `closure_fns`.
fn emit_fat_closure_c(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg, k: usize, cid: i32) {
    let e: parser.ExprData = list.get(parser.ExprData, p.ex, cid as usize)
    list.truncate(i32, g.su, 0)
    list.truncate(i32, g.pp, 0)
    list.truncate(i32, g.req, 0)
    list.truncate(i32, g.ens, 0)
    g.res_ok = 0 - 2
    list.truncate(i32, g.caps, 0)
    let cb: i32 = list.get(i32, g.ccx, k * 2)
    let cc: i32 = list.get(i32, g.ccx, k * 2 + 1)
    var ci: i32 = 0
    for ci < cc {
        let b: i32 = (cb + ci) * 3
        list.push(i32, g.caps, list.get(i32, g.cca, b as usize))
        list.push(i32, g.caps, list.get(i32, g.cca, (b + 1) as usize))
        ci = ci + 1
    }
    var rets: String = string_new()
    emit_ty_c(rets, src, c, list.get(i32, c.et, e.a as usize))
    let rn: i32 = ref_expr_id(p, cid)
    string_push(sb, "static ")
    string_push(sb, string_view(rets))
    string_push(sb, " jestyr_lam_")
    push_uint(sb, rn as i64)
    string_push(sb, "(JestyrEnv_")
    push_uint(sb, rn as i64)
    string_push(sb, "* j__env")
    var pi: i32 = 0
    for pi < e.y {
        string_push(sb, ", ")
        let pb: i32 = e.x + pi * 3
        let pty: i32 = list.get(i32, p.clar, (pb + 2) as usize)
        if pty >= 0 { emit_c_ty(sb, p, src, pty) } else { string_push(sb, "int") }
        string_push(sb, " j_")
        let pns: i32 = list.get(i32, p.clar, pb as usize)
        let pne: i32 = list.get(i32, p.clar, (pb + 1) as usize)
        string_push(sb, src[pns as usize .. pne as usize])
        pi = pi + 1
    }
    string_push(sb, ")\n")
    emit_closure_body_c(sb, p, src, c, g, e.a, !str_eq(string_view(rets), "void"))
    string_push(sb, "\n")
    list.truncate(i32, g.caps, 0)
    string_free(rets)
}

// The `closure_fns` section: one top-level `static` function per collected closure (a thin
// coerced closure only when capture-free — a capturing one is the reference's diag case and
// emits nothing).
fn emit_closure_fns(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var k: usize = 0
    for k < list.len(i32, g.cls) {
        let cid: i32 = list.get(i32, g.cls, k)
        if closure_is_thin(c, cid) {
            if list.get(i32, g.ccx, k * 2 + 1) == 0 { emit_thin_closure_c(sb, p, src, c, g, cid) }
        } else {
            emit_fat_closure_c(sb, p, src, c, g, k, cid)
        }
        k = k + 1
    }
}

fn emit_fn_protos(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) {  // Fn (templates are never emitted directly)
            emit_fn_sig(sb, p, src, it)
            string_push(sb, ";\n")
        }
        r = r + 1
    }
    var gi: i32 = 0
    for (gi as usize) < list.len(i32, g.gfi) {
        emit_gfn_sig(sb, p, src, c, g, gi)
        string_push(sb, ";\n")
        list.truncate(i32, g.su, 0)
        gi = gi + 2 + list.get(i32, g.gfi, (gi + 1) as usize) * 3
    }
    string_push(sb, "\n")
}

// Function definitions: `<sig>\n<body>\n` each. (Mirrors Cgen::fn_defs -> emit_fn.)
fn emit_fn_defs(mut sb: String, read p: parser.Parser, read src: str, read c: typeck.Checker, mut g: Cg) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 and !fn_is_template(p, it) {  // Fn (templates are never emitted directly)
            emit_fn_sig(sb, p, src, it)
            string_push(sb, "\n")
            // Register the fn's by-pointer (`mut`/`out`) params so body uses render `(*j_x)`.
            list.truncate(i32, g.pp, 0)
            var pi: i32 = 0
            for pi < it.b {
                let pbase: i32 = it.a + pi * 7
                let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
                if pconv == 2 or pconv == 4 {
                    list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                    list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
                }
                pi = pi + 1
            }
            // A refined param (`i: usize in 0..s.len`) seeds the refinement stack for the whole
            // body, so `s[i]` elides its bounds check (mirrors `cur_refines` seeding in emit_fn).
            let rfloor: usize = list.len(i32, g.rf)
            var ri: i32 = 0
            for ri < it.b {
                let rbase: i32 = it.a + ri * 7
                let refine: i32 = list.get(i32, p.iar, (rbase + 6) as usize)
                if refine >= 0 {
                    list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 2) as usize))
                    list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 3) as usize))
                    list.push(i32, g.rf, refine)
                }
                ri = ri + 1
            }
            // `requires`/`ensures` contract exprs from the `far` extras block:
            // [err_count, err span pairs…, req_count, req ExprIds…, ens_count, ens ExprIds…].
            list.truncate(i32, g.req, 0)
            list.truncate(i32, g.ens, 0)
            if it.e >= 0 {
                let ecount: i32 = list.get(i32, p.far, it.e as usize)
                let rq: i32 = it.e + 1 + ecount * 2               // req_count slot
                let rqc: i32 = list.get(i32, p.far, rq as usize)
                var qi: i32 = 0
                for qi < rqc { list.push(i32, g.req, list.get(i32, p.far, (rq + 1 + qi) as usize))  qi = qi + 1 }
                let enp: i32 = rq + 1 + rqc                        // ens_count slot
                let enc: i32 = list.get(i32, p.far, enp as usize)
                var ei: i32 = 0
                for ei < enc { list.push(i32, g.ens, list.get(i32, p.far, (enp + 1 + ei) as usize))  ei = ei + 1 }
            }
            g.retty = it.z
            // A fallible fn's result-ok TypeId is live for its body (ok/err/? read it); -2 = not
            // fallible. It always "returns a value" (the result struct), even for a unit ok type.
            let fallible: bool = fn_is_fallible(p, it)
            if fallible { g.res_ok = it.z } else { g.res_ok = 0 - 2 }
            g.curfn = iid
            // The fn's move analysis: locals whose value escapes are never drop-registered.
            // Only free fns collect (mirrors `emit_fn` — method/impl bodies keep `mv` empty).
            list.truncate(i32, g.mv, 0)
            collect_moved_block(g, p, src, it.w)
            let returns_value: bool = it.z >= 0 or fallible
            emit_body(sb, p, src, c, g, it.w, returns_value, 0)   // w = body Block ExprId; fn body at depth 0
            g.res_ok = 0 - 2
            list.truncate(i32, g.pp, 0)
            list.truncate(i32, g.rf, rfloor)
            list.truncate(i32, g.ens, 0)
            list.truncate(i32, g.mv, 0)
            string_push(sb, "\n")
        }
        r = r + 1
    }
    // Monomorphized generic-fn instance definitions, after the regular fns (mirrors the
    // instance loop at the end of `fn_defs`): sig under the instance substitution + body.
    var gi: i32 = 0
    for (gi as usize) < list.len(i32, g.gfi) {
        let fit: i32 = list.get(i32, g.gfi, gi as usize)
        let fd: parser.ItemData = list.get(parser.ItemData, p.it, fit as usize)
        emit_gfn_sig(sb, p, src, c, g, gi)            // arms g.su for the body too
        string_push(sb, "\n")
        list.truncate(i32, g.pp, 0)
        var pi: i32 = 0
        for pi < fd.b {
            let pbase: i32 = fd.a + pi * 7
            let pconv: i32 = list.get(i32, p.iar, (pbase + 1) as usize)
            if list.get(i32, p.iar, pbase as usize) == 0 and (pconv == 2 or pconv == 4) {
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 2) as usize))
                list.push(i32, g.pp, list.get(i32, p.iar, (pbase + 3) as usize))
            }
            pi = pi + 1
        }
        let rfloor: usize = list.len(i32, g.rf)
        var ri: i32 = 0
        for ri < fd.b {
            let rbase: i32 = fd.a + ri * 7
            let refine: i32 = list.get(i32, p.iar, (rbase + 6) as usize)
            if refine >= 0 {
                list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 2) as usize))
                list.push(i32, g.rf, list.get(i32, p.iar, (rbase + 3) as usize))
                list.push(i32, g.rf, refine)
            }
            ri = ri + 1
        }
        list.truncate(i32, g.req, 0)
        list.truncate(i32, g.ens, 0)
        if fd.e >= 0 {
            let ecount: i32 = list.get(i32, p.far, fd.e as usize)
            let rq: i32 = fd.e + 1 + ecount * 2
            let rqc: i32 = list.get(i32, p.far, rq as usize)
            var qi: i32 = 0
            for qi < rqc { list.push(i32, g.req, list.get(i32, p.far, (rq + 1 + qi) as usize))  qi = qi + 1 }
            let enp: i32 = rq + 1 + rqc
            let enc: i32 = list.get(i32, p.far, enp as usize)
            var ei: i32 = 0
            for ei < enc { list.push(i32, g.ens, list.get(i32, p.far, (enp + 1 + ei) as usize))  ei = ei + 1 }
        }
        g.retty = fd.z
        let gfallible: bool = fn_is_fallible(p, fd)
        if gfallible { g.res_ok = fd.z } else { g.res_ok = 0 - 2 }
        g.curfn = fit
        list.truncate(i32, g.mv, 0)
        collect_moved_block(g, p, src, fd.w)          // instances collect moved (mirrors emit_fn)
        emit_body(sb, p, src, c, g, fd.w, fd.z >= 0 or gfallible, 0)
        g.res_ok = 0 - 2
        list.truncate(i32, g.pp, 0)
        list.truncate(i32, g.rf, rfloor)
        list.truncate(i32, g.ens, 0)
        list.truncate(i32, g.mv, 0)
        list.truncate(i32, g.su, 0)
        string_push(sb, "\n")
        gi = gi + 2 + list.get(i32, g.gfi, (gi + 1) as usize) * 3
    }
}

// The C `main` wrapper: captures argc/argv into the argv globals, then calls `jestyr_main`.
fn emit_main_wrapper(mut sb: String, read p: parser.Parser, read src: str) {
    var r: i32 = 0
    for r < list.len(i32, p.roots) {
        let iid: i32 = list.get(i32, p.roots, r)
        let it: parser.ItemData = list.get(parser.ItemData, p.it, iid as usize)
        if it.kind == 3 {
            if str_eq(src[it.x .. it.y], "main") {
                if it.z >= 0 {
                    string_push(sb, "int main(int argc, char** argv) { jestyr_rt_argc = argc; jestyr_rt_argv = argv; return (int) jestyr_main(); }\n")
                } else {
                    string_push(sb, "int main(int argc, char** argv) { jestyr_rt_argc = argc; jestyr_rt_argv = argv; jestyr_main(); return 0; }\n")
                }
                return
            }
        }
        r = r + 1
    }
}

// Lower the whole program to C. The section ORDER mirrors `emit_program` exactly — the five bare
// `"\n"` pushes stand in for the reference's unconditionally-blank sections that are empty for a
// program with no aggregates (closure_types, method_protos, consts) plus the guarded no-ops.
fn emit_program(mut sb: String, read p: parser.Parser, read c: typeck.Checker, read src: str, read a: Allocator) {
    var g: Cg = Cg{ tmp: 0, pp: list.make(i32, a), rf: list.make(i32, a), res_ok: 0 - 2, etags: list.make(i32, a), req: list.make(i32, a), ens: list.make(i32, a), retty: 0 - 1, mi: list.make(i32, a), self_ptr: false, gei: list.make(i32, a), curfn: 0 - 1, mv: list.make(i32, a), ds: list.make(i32, a), dsb: list.make(i32, a), autoret: false, bl_ns: 0 - 1, bl_ne: 0 - 1, bl_fe: 0 - 1, cl_ns: 0 - 1, cl_ne: 0 - 1, sr_ns: 0 - 1, sr_ne: 0 - 1, vt: list.make(i32, a), vtf: 0, gfi: list.make(i32, a), su: list.make(i32, a), cls: list.make(i32, a), ccx: list.make(i32, a), cca: list.make(i32, a), caps: list.make(i32, a) }
    build_error_tags(g, p, src)                      // whole-program error-name -> tag map
    collect_method_instances(g, p, src, c)           // (struct item, method fn item) pairs, first-seen
    collect_genum_instances(g, p, src, c)            // generic-enum instance TyIds, expr order
    collect_gfn_instances(g, p, src, c, a)           // generic-fn instances, LIFO worklist order
    collect_closures(g, p, src, a)                   // closures + captures, discovery order (LAST, like the reference)
    emit_prelude(sb, p, src)
    emit_forward_types(sb, p, src)
    emit_gen_forward_types(sb, p, src, c, g)         // monomorphized generic-enum instance fwd typedefs
    emit_fn_type_defs(sb, p, src)                    // fn-pointer typedefs (before aggregate defs)
    emit_struct_defs(sb, p, src)                     // captured-region aggregate defs (struct first)
    emit_enum_defs(sb, p, src, c, g)                 // enum tag+struct defs (after structs)
    emit_gen_enum_defs(sb, p, src, c, g)             // generic-enum instance defs (after plain enums)
    emit_slice_defs(sb, p, src, c)                   // slice typedefs (after aggregates)
    emit_array_defs(sb, p, src, c)                   // array typedefs (after slices)
    emit_genref_defs(sb, p, src, c)                  // genref typedefs (after arrays)
    // gen-struct defs: empty until comptime-ctor structs are ported.
    emit_result_defs(sb, p, src)
    // flush_def_capture / dyn_typedefs: no-ops here (no by-value dep reorder needed).
    emit_extern_protos(sb, p, src)                   // `extern "c"` prototypes (bare names)
    emit_closure_types(sb, p, src, c, g)             // env + {call, env} typedefs + unconditional blank
    emit_fn_protos(sb, p, src, c, g)
    emit_method_protos(sb, p, src, c, g)             // method protos + unconditional trailing blank
    emit_impl_protos(sb, p, src)                     // trait-impl protos + CONDITIONAL trailing blank
    // dyn_vtables / spawn_runtime: empty until dyn/concurrency land.
    emit_consts(sb, p, src, c, g)                    // consts + its unconditional trailing blank
    emit_closure_fns(sb, p, src, c, g)               // lifted `jestyr_lam_<id>` fns before the free fns
    emit_fn_defs(sb, p, src, c, g)
    emit_method_defs(sb, p, src, c, g)               // method bodies after the free fns
    emit_impl_defs(sb, p, src, c, g)                 // trait-impl bodies last
    emit_main_wrapper(sb, p, src)
}

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(it)
    if env.argc() > 1 {
        var src: String = fs.read_text(env.argv(1))
        var p: parser.Parser = parser.parse_source(string_view(src), it, kwcount, a)
        var c: typeck.Checker = typeck.check_parsed(p, string_view(src), a)
        var sb: String = string_new()
        emit_program(sb, p, c, string_view(src), a)
        let v: str = string_view(sb)
        // The emitted C ends in a trailing '\n'; print_str appends one, so drop the last byte to
        // keep stdout byte-identical to `cgen::emit`'s String (the golden compares line-for-line).
        if v.len > 0 {
            print_str(v[0 .. v.len - 1])
        }
        string_free(src)
    }
    return 0
}
