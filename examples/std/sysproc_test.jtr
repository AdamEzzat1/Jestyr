// std/sysproc_test.jtr — the unit suite for `std/sysproc`, written with `std/test`.
//
// A sibling file rather than colocated, per the convention in docs/stdlib-roadmap.md:
// a `@test` function is emitted into every program that imports its module.
//
// These tests start real processes, because a module whose entire claim is about what
// the OS does while the parent is still running cannot be tested against a fake. What
// they do NOT do is depend on real elapsed time for anything except the one measurement
// that is inherently about time — `time.manual()` drives the timeout LOOP, so the
// polling logic is asserted without any test taking seconds.
//
// The commands are `exit N` and a platform sleep. `exit N` means the same thing in
// `cmd.exe` and in `sh`; a sleep does not, so it is `@cfg`-split, which is also why this
// file is in `CGEN_GOLDEN_ALLOWLIST`.
//
// Run:  jestyrc test examples/std/sysproc_test.jtr

import "sysproc"
import "time"
import "test"
import "test_report"
import "fs"
import "str"

const SPT_REPORT_CAP: usize = 1024

// ~2 seconds of child, long enough that "did the parent block on it" is not a judgement
// call about scheduler noise.
@cfg(posix) fn slow_cmd() -> str { return "sleep 2" }
@cfg(windows) fn slow_cmd() -> str { return "ping -n 3 127.0.0.1 > nul" }

// **THE test.** Everything else in this module is a convenience on top of this one fact:
// `start` returns while the child is still running. Under `std/process` — that is, under
// `system()` — the elapsed time below IS the child's runtime, so this is the assertion
// that would have failed before the module existed.
//
// The bound is 500ms against a ~2000ms child: loose enough that a slow CI box cannot make
// it flake, tight enough that a blocking implementation cannot slip under it.
@test fn start_returns_while_the_child_is_still_running() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.host()
    var sp: sysproc.Spawner = sysproc.host()

    let t0: i64 = time.read_nanos(clk)
    var ch: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    let spent_ms: i64 = (time.read_nanos(clk) - t0) / 1000000

    test.is_true(c, rep, "the child started", sysproc.is_live(ch))
    test.is_true(c, rep, "it has a pid", sysproc.pid_of(ch) != 0)
    test.is_true(c, rep, "start() did not block on it", spent_ms < 500)
    // And it really was still running — otherwise "start returned quickly" could just
    // mean the command failed instantly and the timing proved nothing.
    let s: sysproc.Status = sysproc.try_wait(ch)
    test.is_true(c, rep, "and the child was genuinely still alive", sysproc.is_running(s))

    sysproc.terminate(ch)
    sysproc.wait(ch)
    sysproc.release(ch)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A bounded wait gives up, and reports giving up as a STATE rather than as an error.
@test fn wait_timeout_gives_up_on_a_slow_child() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.host()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    let s: sysproc.Status = sysproc.wait_timeout(ch, clk, 150000000)
    test.is_true(c, rep, "the budget ran out first", sysproc.is_running(s))
    test.eq_str(c, rep, "and says so", sysproc.state_name(sysproc.state_of(s)), "running")

    sysproc.wait_or_kill(ch, clk, 0)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// **Anti-vacuity for the test above.** A `wait_timeout` that returned `running`
// unconditionally would pass it. This is the same call with a child that finishes, and it
// must report the exit — including the exit CODE, which is the other thing a bounded wait
// could silently lose.
@test fn wait_timeout_reports_a_child_that_finishes_in_budget() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.host()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, "exit 7") catch sysproc.no_child()
    let s: sysproc.Status = sysproc.wait_timeout(ch, clk, 10000000000)
    test.is_true(c, rep, "it finished inside the budget", sysproc.is_exited(s))
    test.eq_i64(c, rep, "with its own exit code", sysproc.code_of(s) as i64, 7)
    sysproc.release(ch)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// The blocking wait, and the exit code round-tripping through it. `exit 0` and `exit 7`
// so that "always returns 0" and "always returns the same number" both fail.
@test fn wait_reports_the_exit_code() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var zero: sysproc.Child = sysproc.start(sp, "exit 0") catch sysproc.no_child()
    let z: sysproc.Status = sysproc.wait(zero)
    test.is_true(c, rep, "exit 0 exited", sysproc.is_exited(z))
    test.eq_i64(c, rep, "exit 0 code", sysproc.code_of(z) as i64, 0)
    sysproc.release(zero)

    var seven: sysproc.Child = sysproc.start(sp, "exit 7") catch sysproc.no_child()
    let s: sysproc.Status = sysproc.wait(seven)
    test.eq_i64(c, rep, "exit 7 code", sysproc.code_of(s) as i64, 7)
    sysproc.release(seven)

    test.eq_i64(c, rep, "the spawner counted both", sysproc.started(sp), 2)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A killed child is reported as killed, and NOT as an ordinary exit. On Windows there are
// no signals, so this is the convention `terminate` and `poll_once` agree on; if they ever
// stop agreeing, this test is where it shows.
@test fn a_terminated_child_is_reported_as_signalled() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.host()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    test.is_true(c, rep, "the kill was accepted", sysproc.terminate(ch))
    let s: sysproc.Status = sysproc.wait(ch)
    test.is_true(c, rep, "and it did not exit normally", sysproc.is_signalled(s))
    test.eq_str(c, rep, "state name", sysproc.state_name(sysproc.state_of(s)), "signalled")
    sysproc.release(ch)

    // `wait_or_kill` is the same thing composed, and must reach the same verdict.
    var two: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    let t: sysproc.Status = sysproc.wait_or_kill(two, clk, 100000000)
    test.is_true(c, rep, "wait_or_kill also reports signalled", sysproc.is_signalled(t))
    test.is_false(c, rep, "and released the handle", sysproc.is_live(two))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// **The timeout LOOP, with no real time spent.** `time.manual()` makes `time.wait`
// advance a counter instead of sleeping, so this exercises the polling policy — budget
// arithmetic, the loop's exit condition, the elapsed-time accumulation — in microseconds.
//
// It is also the test that would catch the loop adding the REQUESTED slice instead of the
// one the clock reports: under a manual clock those are equal, so the assertion here is
// about termination, and `waits_are_free` records why this is fast.
@test fn the_bounded_wait_loop_runs_on_a_manual_clock() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.manual(0)
    var sp: sysproc.Spawner = sysproc.host()

    test.is_true(c, rep, "the clock is deterministic", time.is_deterministic(clk))
    test.is_true(c, rep, "and its waits cost nothing", time.waits_are_free(clk))

    var ch: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    let s: sysproc.Status = sysproc.wait_timeout(ch, clk, 50000000)
    test.is_true(c, rep, "the loop terminated on its budget", sysproc.is_running(s))
    // The clock moved by the budget rather than by one slice, which is what proves the
    // loop iterated instead of giving up after a single poll.
    test.is_true(c, rep, "the clock advanced to the budget", time.read_nanos(clk) >= 50000000)

    sysproc.terminate(ch)
    sysproc.wait(ch)
    sysproc.release(ch)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A zero budget is one liveness check and no sleeping — the spelling of `try_wait` that a
// caller composing timeouts does not have to special-case.
@test fn a_zero_budget_is_a_single_check() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var clk: time.Clock = time.manual(0)
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, slow_cmd()) catch sysproc.no_child()
    let s: sysproc.Status = sysproc.wait_timeout(ch, clk, 0)
    test.is_true(c, rep, "still running", sysproc.is_running(s))
    test.eq_i64(c, rep, "and the clock never moved", time.read_nanos(clk), 0)

    sysproc.terminate(ch)
    sysproc.wait(ch)
    sysproc.release(ch)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// The status is cached after the first observation, so asking twice is safe. This is not
// tidiness: a POSIX child is REAPED by `waitpid`, and a second reap of the same pid fails
// with ECHILD — without the cache, the second question would get a different answer to
// the first.
@test fn the_status_is_cached_so_asking_twice_agrees() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, "exit 7") catch sysproc.no_child()
    let first: sysproc.Status = sysproc.wait(ch)
    let second: sysproc.Status = sysproc.wait(ch)
    let third: sysproc.Status = sysproc.try_wait(ch)
    test.eq_i64(c, rep, "first", sysproc.code_of(first) as i64, 7)
    test.eq_i64(c, rep, "second agrees", sysproc.code_of(second) as i64, 7)
    test.eq_i64(c, rep, "try_wait agrees", sysproc.code_of(third) as i64, 7)
    test.is_true(c, rep, "and all three say exited", sysproc.is_exited(third))

    // `last_status` answers from the cache without touching the OS, and keeps answering
    // after release — the only query that is safe there.
    sysproc.release(ch)
    test.is_false(c, rep, "released", sysproc.is_live(ch))
    test.eq_i64(c, rep, "last_status still knows", sysproc.code_of(sysproc.last_status(ch)) as i64, 7)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// `release` is idempotent, so it composes with a caller that is not sure whether an
// earlier path already ran.
@test fn release_is_idempotent() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, "exit 0") catch sysproc.no_child()
    sysproc.wait(ch)
    sysproc.release(ch)
    sysproc.release(ch)
    sysproc.release(ch)
    test.is_false(c, rep, "still released", sysproc.is_live(ch))
    // A released child cannot be terminated — there is no handle to terminate through,
    // and returning `true` would be a lie a caller might act on.
    test.is_false(c, rep, "terminate refuses", sysproc.terminate(ch))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// **The capability must produce no EFFECT, not merely report failure.** The same shape as
// `process_test`'s witness test, and for the same reason: without the `host` control, a
// typo'd command would make the negative half pass for the wrong reason.
@test fn denied_starts_nothing_where_host_does() -> bool {
    let probe: str = "jestyr_sysproc_effect_test.tmp"
    var craw: *mut u8 = alloc(u8, 256)
    var cbuf: []u8 = slice(u8, craw, 256)
    let n: usize = write_cmd(probe, cbuf)
    let cmd: str = from_utf8(slice(u8, craw, n))

    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()

    // Control: the command genuinely works, so the negative result below means something.
    fs.remove(probe)
    var h: sysproc.Spawner = sysproc.host()
    var made: sysproc.Child = sysproc.start(h, cmd) catch sysproc.no_child()
    sysproc.wait(made)
    sysproc.release(made)
    test.is_true(c, rep, "host leaves the file", fs.exists(probe))
    fs.remove(probe)

    // The experiment: identical command, denied handle, no file.
    var d: sysproc.Spawner = sysproc.denied()
    var none: sysproc.Child = sysproc.start(d, cmd) catch sysproc.no_child()
    test.is_false(c, rep, "denied leaves nothing", fs.exists(probe))
    test.is_false(c, rep, "and hands back no live child", sysproc.is_live(none))
    test.eq_i64(c, rep, "denied started", sysproc.started(d), 0)
    test.eq_i64(c, rep, "denied counted the attempt", sysproc.refused(d), 1)
    test.is_false(c, rep, "can_start(denied)", sysproc.can_start(d))

    fs.remove(probe)
    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    free_ptr(craw)
    return ok
}

// ---- pipes ---------------------------------------------------------------------------

// Capturing a child's stdout. `echo hello` is spelled the same in `cmd.exe` and `sh`; the
// LINE ENDING is not, so the check is on the trimmed text.
@test fn a_childs_output_can_be_captured() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start_piped(sp, "echo hello") catch sysproc.no_child()
    test.is_true(c, rep, "the child has both pipes", sysproc.has_output(ch))
    var got: String = sysproc.capture(ch)
    let st: sysproc.Status = sysproc.wait(ch)
    sysproc.release(ch)

    test.eq_str(c, rep, "captured", str.trim_end(string_view(got)), "hello")
    test.is_true(c, rep, "and it exited", sysproc.is_exited(st))
    test.eq_i64(c, rep, "cleanly", sysproc.code_of(st) as i64, 0)
    string_free(got)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// **THE two-way test.** Write to the child's stdin, close it, read what the child made of
// it. `sort` is the ideal subject: it is a FILTER, so it produces nothing at all until it
// sees EOF — which means this fails if `close_input` does not really close, and it proves
// the round trip rather than just the read.
@test fn a_child_can_be_written_to_and_read_back() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start_piped(sp, "sort") catch sysproc.no_child()
    let payload: str = "pear\nfig\napple\n"
    var pbuf: *mut u8 = alloc(u8, payload.len)
    var i: usize = 0
    for i < payload.len {
        unsafe { (pbuf + i).* = payload[i] }
        i = i + 1
    }
    let data: []u8 = slice(u8, pbuf, payload.len)
    let put: i64 = sysproc.write_all(ch, data)
    test.eq_i64(c, rep, "wrote the whole payload", put, payload.len as i64)

    // `capture` closes the input for us — the step a filter is waiting for.
    var sorted: String = sysproc.capture(ch)
    sysproc.wait(ch)
    sysproc.release(ch)
    free_ptr(pbuf)

    // Compared line-by-line so CRLF against LF is not the thing under test.
    let v: str = string_view(sorted)
    test.is_true(c, rep, "apple came first", starts_with(v, "apple"))
    test.is_true(c, rep, "fig is in there", contains(v, "fig"))
    test.is_true(c, rep, "pear is in there", contains(v, "pear"))
    // The ORDER is the proof the child did the work: the input was pear/fig/apple.
    test.is_true(c, rep, "and the child sorted it", str.index_of(v, "apple") < str.index_of(v, "pear"))
    string_free(sorted)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// **A payload bigger than a pipe buffer, in both directions.** ~200KB does not fit in any
// pipe buffer (4KB Linux, ~64KB Windows), so this is the test that catches a `capture`
// which reads ONCE and calls it EOF, or a `write_all` that stops at the first short write.
// On a small payload both bugs are invisible — everything fits, and a truncating reader
// still returns the whole answer.
//
// **What it does NOT prove** is that concurrent reading and writing is safe: `sort` is a
// filter, so it consumes all input before producing any output, and the two directions
// never overlap. A child that interleaves — writing replies while still being fed — can
// still deadlock a single-threaded parent, which is exactly what the module header says
// and why it says a protocol like that needs a poll this module does not provide.
//
// If this test ever HANGS rather than fails, that is a deadlock — not a flake.
@test fn a_large_output_does_not_deadlock() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    // The child echoes back far more than a pipe can hold. `sort` on a big input is the
    // portable way to make a lot of output from a little command: it must read everything
    // before writing anything, so the parent has to be draining concurrently.
    var ch: sysproc.Child = sysproc.start_piped(sp, "sort") catch sysproc.no_child()
    let line: str = "0123456789012345678901234567890123456789012345678901234567890123\n"
    let rounds: usize = 3200                       // ~200KB
    var lbuf: *mut u8 = alloc(u8, line.len)
    var i: usize = 0
    for i < line.len {
        unsafe { (lbuf + i).* = line[i] }
        i = i + 1
    }
    let one: []u8 = slice(u8, lbuf, line.len)
    var sent: i64 = 0
    var k: usize = 0
    for k < rounds {
        sent = sent + sysproc.write_all(ch, one)
        k = k + 1
    }
    test.eq_i64(c, rep, "sent the whole payload", sent, (line.len * rounds) as i64)

    var back: String = sysproc.capture(ch)
    sysproc.wait(ch)
    sysproc.release(ch)
    free_ptr(lbuf)

    // Every line comes back; the exact byte count differs by line ending, so the check is
    // that nothing was LOST.
    test.is_true(c, rep, "got it all back", string_view(back).len >= sent)
    string_free(back)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A child started WITHOUT pipes has none, and the I/O calls say so rather than pretending.
@test fn an_unpiped_child_reports_no_pipes() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start(sp, "exit 0") catch sysproc.no_child()
    test.is_false(c, rep, "no input pipe", sysproc.has_input(ch))
    test.is_false(c, rep, "no output pipe", sysproc.has_output(ch))

    var buf: *mut u8 = alloc(u8, 16)
    var b: []u8 = slice(u8, buf, 16)
    test.eq_i64(c, rep, "read_output refuses", sysproc.read_output(ch, b), 0 - 1)
    test.eq_i64(c, rep, "write_input refuses", sysproc.write_input(ch, b), 0 - 1)
    free_ptr(buf)

    // And `capture` on a pipe-less child is an empty String, not a failure — a caller
    // composing over both kinds should not have to branch.
    var empty: String = sysproc.capture(ch)
    test.eq_usize(c, rep, "capture is empty", string_view(empty).len, 0)
    string_free(empty)

    sysproc.wait(ch)
    sysproc.release(ch)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// `close_input` and `release` are both idempotent, and `release` gives the descriptors
// back even when `capture` already closed them.
@test fn pipe_teardown_is_idempotent() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var sp: sysproc.Spawner = sysproc.host()

    var ch: sysproc.Child = sysproc.start_piped(sp, "echo x") catch sysproc.no_child()
    sysproc.close_input(ch)
    sysproc.close_input(ch)
    test.is_false(c, rep, "input closed", sysproc.has_input(ch))

    var got: String = sysproc.capture(ch)
    test.is_false(c, rep, "capture closed the output too", sysproc.has_output(ch))
    string_free(got)

    sysproc.wait(ch)
    sysproc.release(ch)
    sysproc.release(ch)
    test.is_false(c, rep, "released", sysproc.is_live(ch))

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// A denied `Spawner` refuses the piped path exactly as it refuses the plain one — the
// capability is not something a second entry point can walk around.
@test fn denied_refuses_the_piped_path_too() -> bool {
    var raw: *mut u8 = alloc(u8, SPT_REPORT_CAP)
    var rep: []u8 = slice(u8, raw, SPT_REPORT_CAP)
    var c: test.Check = test.new()
    var d: sysproc.Spawner = sysproc.denied()

    var ch: sysproc.Child = sysproc.start_piped(d, "echo x") catch sysproc.no_child()
    test.is_false(c, rep, "no live child", sysproc.is_live(ch))
    test.is_false(c, rep, "and no pipes", sysproc.has_output(ch))
    test.eq_i64(c, rep, "started", sysproc.started(d), 0)
    test.eq_i64(c, rep, "counted the attempt", sysproc.refused(d), 1)

    let ok: bool = test_report.finish(c, rep)
    free_ptr(raw)
    return ok
}

// `echo x > <name>`, built into `buf`. Spelled identically in cmd.exe and sh, and only
// the file's existence is ever checked, so shell quoting cannot matter.
fn write_cmd(read name: str, mut buf: []u8) -> usize {
    let head: str = "echo x > "
    var n: usize = 0
    for i in 0..head.len {
        buf[n] = head[i] as u8
        n = n + 1
    }
    for j in 0..name.len {
        buf[n] = name[j] as u8
        n = n + 1
    }
    return n
}
