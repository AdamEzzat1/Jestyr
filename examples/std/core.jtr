// std/core.jtr — the `core` tier: allocation-free, OS-free helpers (design §3/§14).
// Nothing here allocates; `core` is what a freestanding/bare-metal target links.

pub fn imax(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

pub fn imin(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

pub fn abs_i32(x: i32) -> i32 {
    if x < 0 { return 0 - x }
    return x
}

// ── Option / Result + their combinators ──────────────────────────────────────
//
// The two fallible-value types of `core`, monomorphized per instantiation (so
// `Option(*mut T)` even niche-optimizes to a bare pointer). The combinators are
// allocation-free generic *functions* — Jestyr has no method syntax on a generic
// enum, so the receiver is the first value argument and the element/result types
// are passed as `comptime` arguments: `core.opt_map(i32, i32, o, &f)`.
//
// They obey the functor *and* monad laws by construction — `map(id) == id`,
// `map(f) then map(g) == map(g∘f)`, `some(x).and_then(f) == f(x)`,
// `m.and_then(some) == m` — which is exactly how `core_props` tests them (laws as
// oracles). A higher-order combinator takes a thin `fn(T) -> U` pointer (a
// non-capturing closure coerces to one), so `&inc` or `|x| x + 1` both work; a
// monadic `f` returns an `Option(U)`/`Result(U,E)` (a by-value aggregate return,
// which the forward-declared instance typedefs make legal).

pub enum Option(T) { none, some(v: T) }
pub enum Result(T, E) { ok(v: T), err(e: E) }

// --- Option ---

pub fn opt_is_some(comptime T: type, read o: Option(T)) -> bool {
    match o { some(v) => true, none => false }
}

pub fn opt_is_none(comptime T: type, read o: Option(T)) -> bool {
    match o { some(v) => false, none => true }
}

// `unwrap_or(some(x), d) == x`; `unwrap_or(none, d) == d`.
pub fn opt_unwrap_or(comptime T: type, take o: Option(T), take d: T) -> T {
    match o { some(v) => v, none => d }
}

// Like `unwrap_or` but the default is produced lazily — only on `none`.
pub fn opt_unwrap_or_else(comptime T: type, take o: Option(T), f: fn() -> T) -> T {
    match o { some(v) => v, none => f() }
}

// The functor map: `opt_map(some(x), f) == some(f(x))`, `opt_map(none, f) == none`.
pub fn opt_map(comptime T: type, comptime U: type, take o: Option(T), f: fn(T) -> U) -> Option(U) {
    match o { some(v) => some(f(v)), none => none }
}

// `map` then `unwrap_or` in one step (no intermediate `Option(U)`).
pub fn opt_map_or(comptime T: type, comptime U: type, take o: Option(T), take d: U, f: fn(T) -> U) -> U {
    match o { some(v) => f(v), none => d }
}

// Bridge to `Result`: `some(x) -> ok(x)`, `none -> err(e)`.
pub fn opt_ok_or(comptime T: type, comptime E: type, take o: Option(T), take e: E) -> Result(T, E) {
    match o { some(v) => ok(v), none => err(e) }
}

// The monadic bind: `opt_and_then(some(x), f) == f(x)`, `opt_and_then(none, f) == none`.
// `f` itself returns an `Option(U)`, so chained fallible steps short-circuit on `none`.
pub fn opt_and_then(comptime T: type, comptime U: type, take o: Option(T), f: fn(T) -> Option(U)) -> Option(U) {
    match o { some(v) => f(v), none => none }
}

// Keep the value only if it passes `pred` (which *borrows* it, so the value
// survives): `opt_filter(some(x), p) == if p(x) { some(x) } else { none }`.
pub fn opt_filter(comptime T: type, take o: Option(T), pred: fn(read T) -> bool) -> Option(T) {
    match o { some(v) => if pred(v) { some(v) } else { none }, none => none }
}

// Fall back to an alternative `Option`, produced lazily, only on `none`.
pub fn opt_or_else(comptime T: type, take o: Option(T), f: fn() -> Option(T)) -> Option(T) {
    match o { some(v) => some(v), none => f() }
}

// --- Result ---

pub fn res_is_ok(comptime T: type, comptime E: type, read r: Result(T, E)) -> bool {
    match r { ok(v) => true, err(e) => false }
}

pub fn res_is_err(comptime T: type, comptime E: type, read r: Result(T, E)) -> bool {
    match r { ok(v) => false, err(e) => true }
}

pub fn res_unwrap_or(comptime T: type, comptime E: type, take r: Result(T, E), take d: T) -> T {
    match r { ok(v) => v, err(e) => d }
}

// The functor map over the ok value; the error passes through unchanged.
pub fn res_map(comptime T: type, comptime U: type, comptime E: type, take r: Result(T, E), f: fn(T) -> U) -> Result(U, E) {
    match r { ok(v) => ok(f(v)), err(e) => err(e) }
}

// Map the error value; the ok passes through unchanged.
pub fn res_map_err(comptime T: type, comptime E: type, comptime F: type, take r: Result(T, E), f: fn(E) -> F) -> Result(T, F) {
    match r { ok(v) => ok(v), err(e) => err(f(e)) }
}

// Bridge back to `Option`, discarding the error: `ok(x) -> some(x)`, `err(_) -> none`.
pub fn res_ok(comptime T: type, comptime E: type, take r: Result(T, E)) -> Option(T) {
    match r { ok(v) => some(v), err(e) => none }
}

// The monadic bind for `Result`: `res_and_then(ok(x), f) == f(x)`, error short-circuits.
pub fn res_and_then(comptime T: type, comptime U: type, comptime E: type, take r: Result(T, E), f: fn(T) -> Result(U, E)) -> Result(U, E) {
    match r { ok(v) => f(v), err(e) => err(e) }
}

// ── Slice / iterator algorithms over `[]T` ───────────────────────────────────
//
// `core` has no allocation, so these are the *consuming* (reduce/search) and
// *in-place* (sort) algorithms — the ones that don't have to produce a new owned
// sequence. (Producers like `map`/`filter` that build a new collection belong to
// the allocating `std`, Phase 2; a no-alloc `map_into(src, dst, f)` over a
// caller-provided buffer can follow.) A predicate/order is a thin `fn(read T) ->
// …` pointer; indices are returned as `Option(usize)` so nothing copies a
// (possibly non-`Copy`) element out.
//
// Tested by the iterator laws in `core_props` (a reference fold/search agrees with
// these) and the sort invariants (sorted permutation, deterministic).

// Left fold: `fold(init, f)` threads the accumulator left-to-right over the slice.
// `sum`/`count`/`product`/... are all this with the right `f`.
pub fn sl_fold(comptime T: type, comptime A: type, read s: []T, take init: A, f: fn(A, T) -> A) -> A {
    var acc: A = init
    for x in s { acc = f(acc, x) }
    return acc
}

// How many elements satisfy `pred`.
pub fn sl_count_where(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> usize {
    var n: usize = 0
    for x in s { if pred(x) { n = n + 1 } }
    return n
}

// Does *any* element satisfy `pred`? (Short-circuits.) Empty slice → false.
pub fn sl_any(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> bool {
    for x in s { if pred(x) { return true } }
    return false
}

// Do *all* elements satisfy `pred`? (Short-circuits.) Empty slice → true.
pub fn sl_all(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> bool {
    for x in s { if pred(x) { } else { return false } }
    return true
}

// The index of the first element satisfying `pred`, or `none`. Returns the *index*
// (a `usize`, always `Copy`) rather than the element, so nothing is copied out.
pub fn sl_find(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> Option(usize) {
    for x, i in s { if pred(x) { return some(i) } }
    return none
}

// Binary search a slice **sorted by `less`** (a strict total order). Returns the
// index of a matching element, or `none`. (Which equal element is unspecified.)
pub fn sl_binary_search(comptime T: type, read s: []T, read target: T, less: fn(read T, read T) -> bool) -> Option(usize) {
    var lo: usize = 0
    var hi: usize = s.len
    for lo < hi {
        let mid: usize = lo + (hi - lo) / 2
        if less(s[mid], target) {
            lo = mid + 1
        } else {
            if less(target, s[mid]) { hi = mid } else { return some(mid) }
        }
    }
    return none
}

// Swap two elements in place. Raw-pointer level (in `unsafe`) so it works for a
// generic `T` without the borrow checker rejecting the temporary.
pub fn sl_swap(comptime T: type, mut s: []T, i: usize, j: usize) {
    unsafe {
        var pi: *mut T = s.ptr + i
        var pj: *mut T = s.ptr + j
        let tmp: T = pi.*
        pi.* = pj.*
        pj.* = tmp
    }
}

// In-place **stable, deterministic** insertion sort by `less` (a strict total
// order). Stable: equal elements keep their input order (the `< prev` test never
// swaps equals). Deterministic: the same input + `less` always yields the same
// output — no randomized pivot. O(n²); a deterministic merge sort can replace it
// once the allocating `std` provides scratch space.
pub fn sl_sort(comptime T: type, mut s: []T, less: fn(read T, read T) -> bool) {
    var i: usize = 1
    for i < s.len {
        var j: usize = i
        for j > 0 {
            if less(s[j], s[j - 1]) {
                sl_swap(T, s, j, j - 1)
                j = j - 1
            } else {
                j = 0
            }
        }
        i = i + 1
    }
}

// ── Number parsing & formatting — locale-free, deterministic, bytewise ────────
//
// The std side of the numerics determinism contract: parse/format are defined by
// construction (decimal, ASCII `0`–`9`, no locale, no float rounding modes), so
// they are **bit-identical across platforms** — `parse(format(x)) == x` round-trips
// and the digit bytes are the same everywhere. `core` stays no-alloc: `format_*`
// writes into a **caller-provided `[]u8`** and returns the byte count (a 20-byte
// buffer holds any `i64`/`u64` — up to 19–20 digits plus a sign).
//
// Integers only for now; correctly-rounded float parse/format (Eisel–Lemire + Ryū)
// is the next numerics increment — see CORE-STD-PHASE3.md.
//
// Overflow is a *defined* error (`ParseIntError::overflow`), never silent wrap or
// UB: the signed parser accumulates negatively (`acc*10 - d`) so `i64::MIN` is
// representable, and checks the bound *before* each step.

pub enum ParseIntError { empty, invalid_digit, overflow }

// Parse a base-10 `i64` with an optional leading `+`/`-`. Locale-free; only ASCII
// digits. Returns `err(overflow)` rather than wrapping past the `i64` range.
pub fn parse_i64(s: str) -> Result(i64, ParseIntError) {
    if s.len == 0 { return err(empty) }
    var i: usize = 0
    var neg: bool = false
    if s[0] == 45 {
        neg = true
        i = 1
    } else {
        if s[0] == 43 { i = 1 }
    }
    if i == s.len { return err(empty) }     // a lone sign is not a number
    let hi: i64 = 9223372036854775807       // i64::MAX
    let lo: i64 = (0 - hi) - 1              // i64::MIN, without an out-of-range literal
    var acc: i64 = 0                        // accumulate **negatively** so MIN fits
    for i < s.len {
        let b: u8 = s[i]
        if b < 48 or b > 57 { return err(invalid_digit) }
        let d: i64 = (b - 48) as i64
        if neg {
            if acc < (lo + d) / 10 { return err(overflow) }
            acc = acc * 10 - d
        } else {
            if acc > (hi - d) / 10 { return err(overflow) }
            acc = acc * 10 + d
        }
        i = i + 1
    }
    return ok(acc)
}

// Parse a base-10 `u64` with an optional leading `+`. A `-` sign is rejected.
pub fn parse_u64(s: str) -> Result(u64, ParseIntError) {
    if s.len == 0 { return err(empty) }
    var i: usize = 0
    if s[0] == 43 { i = 1 }
    if i == s.len { return err(empty) }
    let umax: u64 = 0 - 1                    // u64::MAX (wraps), no huge literal
    var acc: u64 = 0
    for i < s.len {
        let b: u8 = s[i]
        if b < 48 or b > 57 { return err(invalid_digit) }
        let d: u64 = (b - 48) as u64
        if acc > (umax - d) / 10 { return err(overflow) }
        acc = acc * 10 + d
        i = i + 1
    }
    return ok(acc)
}

// The number of base-10 digits in a `u64` (`0` has one digit).
pub fn count_digits_u64(n: u64) -> usize {
    if n == 0 { return 1 }
    var c: usize = 0
    var t: u64 = n
    for t > 0 {
        c = c + 1
        t = t / 10
    }
    return c
}

// Write the decimal digits of a `u64` into `buf` (digits filled back-to-front so a
// single pass needs no temporary). Returns the count. `buf` must hold ≥ 20 bytes.
pub fn format_u64(n: u64, mut buf: []u8) -> usize {
    if n == 0 {
        buf[0] = 48
        return 1
    }
    let count: usize = count_digits_u64(n)
    var x: u64 = n
    var pos: usize = count
    for x > 0 {
        pos = pos - 1
        buf[pos] = (48 + (x % 10)) as u8
        x = x / 10
    }
    return count
}

// Write the decimal digits of an `i64` (with a leading `-` when negative) into
// `buf`; returns the byte count. `buf` must hold ≥ 20 bytes. `i64::MIN` is handled
// via an unsigned magnitude (`0 - (n as u64)`), so it formats without overflow.
pub fn format_i64(n: i64, mut buf: []u8) -> usize {
    if n < 0 {
        buf[0] = 45                         // '-'
        let mag: u64 = 0 - (n as u64)       // magnitude; correct even for i64::MIN
        let c: usize = count_digits_u64(mag)
        var x: u64 = mag
        var pos: usize = 1 + c
        for x > 0 {
            pos = pos - 1
            buf[pos] = (48 + (x % 10)) as u8
            x = x / 10
        }
        return 1 + c
    }
    return format_u64(n as u64, buf)
}

// ── Float support primitives (toward correctly-rounded parse/format) ──────────
//
// `core` has no `u128`, so the 64×64→128 products that correctly-rounded float
// parse/format (Eisel–Lemire, Ryū) need are synthesized from 32-bit halves; and a
// float's bits are read via an untagged `union` (byte reinterpretation). These are
// the deterministic, locale-free building blocks the float algorithms sit on — see
// CORE-STD-PHASE3.md. The IEEE-754 binary64 layout is sign(1) · exponent(11) ·
// mantissa(52).

// A 128-bit unsigned value as a high/low `u64` pair.
pub struct U128 { hi: u64, lo: u64 }

// The full 128-bit product `a * b`, computed from 32-bit halves (no `u128`):
// (aH·2³² + aL)(bH·2³² + bL), carrying the cross terms into `hi`.
pub fn mul64(a: u64, b: u64) -> U128 {
    let mask: u64 = 0xFFFFFFFF
    let al: u64 = a & mask
    let ah: u64 = a >> 32
    let bl: u64 = b & mask
    let bh: u64 = b >> 32
    let ll: u64 = al * bl
    let lh: u64 = al * bh
    let hl: u64 = ah * bl
    let hh: u64 = ah * bh
    let mid: u64 = (ll >> 32) + (lh & mask) + (hl & mask)
    let lo: u64 = (ll & mask) | (mid << 32)
    let hi: u64 = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return U128{ hi: hi, lo: lo }
}

// Count leading zero bits of a `u64` (`clz64(0) == 64`) — the normalization step
// Eisel–Lemire needs. A simple shift-until-top-bit loop; a stdlib `@intrinsic`
// `leading_zeros` can replace it later.
pub fn clz64(x: u64) -> u32 {
    if x == 0 { return 64 }
    let one: u64 = 1
    let topbit: u64 = one << 63
    var v: u64 = x
    var n: u32 = 0
    for (v & topbit) == 0 {
        v = v << 1
        n = n + 1
    }
    return n
}

// A float reinterpreted as its raw bits, and vice-versa — an untagged `union`
// overlays the two, so reading the other field reinterprets the same bytes.
union FU { f: f64, u: u64 }

// The raw IEEE-754 bit pattern of an `f64`.
pub fn f64_bits(x: f64) -> u64 {
    var fu: FU = FU{ f: x }
    return fu.u
}

// The `f64` with the given raw IEEE-754 bit pattern.
pub fn f64_from_bits(u: u64) -> f64 {
    var fu: FU = FU{ u: u }
    return fu.f
}

// IEEE-754 binary64 field extractors (raw — the exponent is biased by 1023, the
// mantissa excludes the implicit leading 1 for normals).
pub fn f64_sign(x: f64) -> u64 { return f64_bits(x) >> 63 }
pub fn f64_raw_exp(x: f64) -> u64 { return (f64_bits(x) >> 52) & 0x7FF }
pub fn f64_mantissa(x: f64) -> u64 { return f64_bits(x) & 0xFFFFFFFFFFFFF }

pub fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── Deterministic reductions (CJC-inspired numerics, serial tier) ─────────────
//
// The serial tiers of CJC's tiered reductions (§3.2 of the numerics research):
// `f64_sum` is the naive baseline; `f64_kahan_sum` is **Neumaier compensated**
// summation (tracks the low-order bits the running sum drops, robust whether the
// next term is larger or smaller than the sum); `f64_pairwise_sum` reduces with a
// fixed `len/2` split (a balanced tree → O(log n) error growth vs naive's O(n)).
//
// All three are *run-deterministic* (same input → bit-identical output, every run
// and platform — the locked FP flags guarantee no FMA/reassociation) and exact in
// codegen shape. They are **not yet chunk-count-independent**: that headline
// property is the binned superaccumulator, which needs fixed-size arrays for its
// 2048 stack-allocated bins — see CORE-STD-PHASE3.md / the numerics research §3.6.

// Naive left-to-right sum — the O(n)-error baseline the others improve on.
pub fn f64_sum(read s: []f64) -> f64 {
    var acc: f64 = 0.0
    for x in s { acc = acc + x }
    return acc
}

// Neumaier compensated sum: `c` accumulates the bits lost at each step, added back
// at the end. Recovers precision naive summation throws away (e.g. a tiny term
// added to a huge running sum), at ~4 flops/element and zero allocation.
pub fn f64_kahan_sum(read s: []f64) -> f64 {
    var sum: f64 = 0.0
    var c: f64 = 0.0
    for x in s {
        let t: f64 = sum + x
        if abs_f64(sum) >= abs_f64(x) {
            c = c + ((sum - t) + x)     // sum is larger → low bits of x are lost
        } else {
            c = c + ((x - t) + sum)     // x is larger → low bits of sum are lost
        }
        sum = t
    }
    return sum + c
}

// Sum `s[lo..hi]` by a fixed balanced split — the recursive core of pairwise sum.
// The split rule (`mid = lo + n/2`, leaves of ≤ 8) is fixed, so the reduction tree
// (and thus the result) is determined by the slice alone.
pub fn f64_pairwise_range(read s: []f64, lo: usize, hi: usize) -> f64 {
    let n: usize = hi - lo
    if n == 0 { return 0.0 }
    if n <= 8 {
        var acc: f64 = 0.0
        var i: usize = lo
        for i < hi {
            acc = acc + s[i]
            i = i + 1
        }
        return acc
    }
    let mid: usize = lo + n / 2
    return f64_pairwise_range(s, lo, mid) + f64_pairwise_range(s, mid, hi)
}

// Pairwise (cascade) sum: a balanced reduction tree, O(log n) error growth.
pub fn f64_pairwise_sum(read s: []f64) -> f64 {
    return f64_pairwise_range(s, 0, s.len)
}

// ── Binned superaccumulator — the chunk-count-independent reduction ───────────
//
// CJC's defining determinism primitive (numerics research §3.2/§3.6), ported onto
// the new fixed-size arrays. The accumulator is **2048 integer bins, one per
// IEEE-754 biased exponent**. Adding a value deposits its *integer significand*
// into its exponent's bin — and **integer addition is exactly associative and
// commutative**, so the bins are independent of the order (or chunking) of the
// inputs. Two accumulators **merge** by adding bins elementwise; `binned_sum`
// reconstructs the bins' **exact** value and rounds it **once** to nearest-even.
// The result is therefore **bit-identical regardless of how the sum was split
// across threads/chunks** AND **correctly rounded** — neither of which
// `f64_sum`/`kahan`/`pairwise` can give.
//
// `binned_add` **cascades a carry** up the exponents so no `i64` bin can overflow
// (lifting the old ~2^10-same-exponent-adds bound); the carry is value-preserving,
// so it changes only the bin layout, never the rounded result.

// 2^k as an `f64` (k in the normal-exponent range), via the IEEE-754 bit layout.
pub fn f64_pow2(k: i64) -> f64 {
    let biased: i64 = k + 1023
    return f64_from_bits((biased as u64) << 52)
}

// A fresh, zeroed accumulator (2048 exponent bins).
pub fn binned_new() -> [2048]i64 {
    return [0; 2048]
}

// Above this magnitude a bin is carried up. Well below i64::MAX and below 2^53, so
// even after the worst-case single add (significand ≤ 2^53) and an elementwise
// merge of two accumulators, no bin can wrap an i64.
const BIN_CARRY_THRESH: i64 = 9007199254740992   // 2^53

// Deposit `v`'s integer significand into its exponent bin, then **cascade a carry**
// up the exponents so no bin can overflow its i64 (the old ~2^10-same-exponent-adds
// bound). A bin-e unit is worth two bin-(e-1) units, so carrying `c` out of bin e
// means depositing `c/2`-equivalent... precisely: moving `c` units from bin e to
// bin e+1 (where each unit is 2× as large) leaves `c·2` of bin e's value behind —
// so we keep the remainder `v - 2c` (magnitude ≤ 1) and pass `c = v/2` up. Bins 0
// and 1 share a ULP, so that first carry is 1:1 (move the whole bin). The carry is
// **exact** — it preserves the accumulator's value — so it does not change the
// (correctly-rounded) result, only the bin layout.
pub fn binned_add(mut bins: [2048]i64, v: f64) {
    let bits: u64 = f64_bits(v)
    let sign: u64 = bits >> 63
    let be: usize = ((bits >> 52) & 0x7FF) as usize
    let mant: u64 = bits & 0xFFFFFFFFFFFFF
    let one: u64 = 1
    var sigu: u64 = mant                       // subnormal: significand = mantissa
    if be != 0 { sigu = (one << 52) | mant }   // normal: restore the implicit leading 1
    var sig: i64 = sigu as i64
    if sign == 1 { sig = 0 - sig }

    var e: usize = be
    bins[e] = bins[e] + sig
    for e < 2047 {                             // top bin (inf/nan exponent) never carries
        let v2: i64 = bins[e]
        var mag: i64 = v2
        if v2 < 0 { mag = 0 - v2 }
        if mag < BIN_CARRY_THRESH { break }
        var c: i64 = v2                        // bin 0 → bin 1 is 1:1 (shared ULP)
        if e != 0 {
            c = v2 / 2                          // bin e → bin e+1 is 2:1
            bins[e] = v2 - c * 2               // remainder stays (magnitude ≤ 1)
        } else {
            bins[e] = 0
        }
        bins[e + 1] = bins[e + 1] + c
        e = e + 1
    }
}

// Merge accumulator `b` into `a` (bins added elementwise). Associative and
// commutative — the basis of a deterministic parallel reduction.
pub fn binned_merge(mut a: [2048]i64, read b: [2048]i64) {
    var i: usize = 0
    for i < 2048 {
        a[i] = a[i] + b[i]
        i = i + 1
    }
}

// ── Correctly-rounded finalize ────────────────────────────────────────────────
//
// The bins are an **exact** big fixed-point number. Scaling by 2^1074 turns it into
// the integer `Y = bins[0] + Σ_{e≥1} bins[e]·2^(e-1)`, so the true sum is `Y·2^-1074`.
// We reconstruct |Y| as a fixed-width unsigned bignum and round it **once** to
// nearest-even. Because this reads the *exact value* (not the bin layout), the
// result is bit-identical for any chunking/merge **and** independent of any
// value-preserving carry between bins — the two properties the old `(b as f64)·2^k`
// fold could not give (that cast is already lossy once a bin exceeds 2^53).
//
// The bignum is 36 little-endian `u64` limbs (2304 bits) — clears the worst-case
// top bit (≈ bitpos 2046 + a 63-bit bin ≈ 2109). To avoid two's-complement sign
// handling we keep two non-negative halves (`pos`/`neg`) and subtract at the end.
const BIG_NL: usize = 36

// Add `val` into limb `idx`, propagating the carry upward. Carry-out of an unsigned
// add is detected by the wrapped sum being smaller than the addend.
fn big_add_at(mut acc: [36]u64, idx: usize, val: u64) {
    var carry: u64 = val
    var i: usize = idx
    for carry != 0 {
        if i >= BIG_NL { return }
        let prev: u64 = acc[i]
        let s: u64 = prev + carry
        acc[i] = s
        if s < prev { carry = 1 } else { carry = 0 }
        i = i + 1
    }
}

// Add `u << shift` into the bignum (the value of one bin: significand `u` at the
// bin's binary weight). The shift can straddle a limb boundary → up to two limbs.
fn big_add_shifted(mut acc: [36]u64, u: u64, shift: usize) {
    let li: usize = shift / 64
    let off: usize = shift % 64
    let lo: u64 = u << off
    var hi: u64 = 0
    if off != 0 { hi = u >> (64 - off) }
    big_add_at(acc, li, lo)
    big_add_at(acc, li + 1, hi)
}

// Compare two magnitudes (top limb first): -1 if a<b, 0 if equal, 1 if a>b.
fn big_cmp(read a: [36]u64, read b: [36]u64) -> i32 {
    var i: usize = BIG_NL
    for i > 0 {
        i = i - 1
        if a[i] != b[i] {
            if a[i] < b[i] { return 0 - 1 }
            return 1
        }
    }
    return 0
}

// `out = big - small`, caller guarantees big ≥ small; borrow-propagated.
fn big_sub(read big: [36]u64, read small: [36]u64, mut dst: [36]u64) {
    var borrow: u64 = 0
    var i: usize = 0
    for i < BIG_NL {
        let bi: u64 = big[i]
        let si: u64 = small[i]
        let d1: u64 = bi - si
        var b1: u64 = 0
        if bi < si { b1 = 1 }
        let d2: u64 = d1 - borrow
        var b2: u64 = 0
        if d1 < borrow { b2 = 1 }
        dst[i] = d2
        borrow = b1 | b2
        i = i + 1
    }
}

// Bit `i` of the bignum.
fn big_bit(read mag: [36]u64, i: usize) -> u64 {
    return (mag[i / 64] >> (i % 64)) & 1
}

// Extract `n` (≤ 53) bits of `mag` starting at bit `start` (may span two limbs).
fn big_extract(read mag: [36]u64, start: usize, n: usize) -> u64 {
    let li: usize = start / 64
    let off: usize = start % 64
    var v: u64 = mag[li] >> off
    if off != 0 {
        if li + 1 < BIG_NL { v = v | (mag[li + 1] << (64 - off)) }
    }
    let one: u64 = 1
    return v & ((one << n) - 1)
}

// Is any bit of `mag` strictly below index `pos` set? (the sticky bit)
fn big_any_below(read mag: [36]u64, pos: usize) -> bool {
    let lp: usize = pos / 64
    let op: usize = pos % 64
    var i: usize = 0
    for i < lp {
        if mag[i] != 0 { return true }
        i = i + 1
    }
    if op > 0 {
        let one: u64 = 1
        if (mag[lp] & ((one << op) - 1)) != 0 { return true }
    }
    return false
}

// Round the non-negative integer `mag` times 2^-1074 to the nearest f64
// (ties-to-even), with sign `neg`. Overflow → ±inf; small values are exact.
fn big_round(read mag: [36]u64, neg: bool) -> f64 {
    var top: usize = BIG_NL
    for top > 0 {
        if mag[top - 1] != 0 { break }
        top = top - 1
    }
    if top == 0 { return 0.0 }
    let hl: usize = top - 1
    let one: u64 = 1
    var sgn: u64 = 0
    if neg { sgn = one << 63 }
    let msb: usize = hl * 64 + (63 - (clz64(mag[hl]) as usize))
    // msb ≤ 52: value < 2^-1021, exactly representable (subnormals / smallest
    // normals); compose by exact scaling of the (≤ 53-bit) integer.
    if msb <= 52 {
        var val: f64 = (mag[0] as f64) * f64_from_bits(1)   // 2^-1074
        if neg { val = 0.0 - val }
        return val
    }
    let e: i64 = (msb as i64) - 1074
    let shift: usize = msb - 52                              // keep bits [shift, msb]
    let sig: u64 = big_extract(mag, shift, 53)
    let round_bit: u64 = big_bit(mag, shift - 1)
    let sticky: bool = big_any_below(mag, shift - 1)
    var m: u64 = sig
    var do_round: bool = false
    if round_bit == 1 {
        if sticky { do_round = true }
        if (m & 1) == 1 { do_round = true }
    }
    if do_round { m = m + 1 }
    var biased: i64 = e + 1023
    let two53: u64 = one << 53
    if m == two53 {                                         // mantissa carried out
        m = m >> 1
        biased = biased + 1
    }
    if biased >= 2047 { return f64_from_bits(sgn | ((2047 as u64) << 52)) }   // ±inf
    let two52: u64 = one << 52
    return f64_from_bits(sgn | ((biased as u64) << 52) | (m - two52))
}

// Finalize: reconstruct the bins' exact value and round it once to nearest-even.
// Deterministic, chunk-independent, and now **correctly rounded**.
pub fn binned_sum(read bins: [2048]i64) -> f64 {
    var pos: [36]u64 = [0; 36]
    var neg: [36]u64 = [0; 36]
    var e: usize = 0
    for e < 2048 {
        let b: i64 = bins[e]
        if b != 0 {
            var shift: usize = 0
            if e != 0 { shift = e - 1 }       // bin 0 shares bin 1's ULP (weight 2^0)
            var u: u64 = b as u64
            if b < 0 { u = 0 - (b as u64) }   // |b| as u64 (works for i64::MIN too)
            if b > 0 {
                big_add_shifted(pos, u, shift)
            } else {
                big_add_shifted(neg, u, shift)
            }
        }
        e = e + 1
    }
    let c: i32 = big_cmp(pos, neg)
    if c == 0 { return 0.0 }
    var dst: [36]u64 = [0; 36]
    if c == 1 {
        big_sub(pos, neg, dst)
        return big_round(dst, false)
    }
    big_sub(neg, pos, dst)
    return big_round(dst, true)
}

// Convenience: a reproducible sum of a slice through the binned accumulator —
// bit-identical no matter how the slice is later split and merged across threads.
pub fn f64_binned_sum(read s: []f64) -> f64 {
    var acc: [2048]i64 = [0; 2048]
    for x in s { binned_add(acc, x) }
    return binned_sum(acc)
}

// ── Deterministic parallel reduction ──────────────────────────────────────────
//
// The headline of the determinism story: a *parallel* sum whose result is
// **bit-identical to the serial sum, regardless of how many threads ran it**. Each
// worker bins its chunk into its **own** accumulator (disjoint memory → no data
// race, no atomics on the hot path), then the chunks are merged by integer
// addition (exactly associative/commutative) and finalized once (correctly
// rounded). Because the bins encode the *exact* value, neither the chunk split nor
// the thread schedule can change the answer — the property a naive/Kahan/pairwise
// parallel sum cannot give. `PAR_WORKERS` partitions the input; the result does not
// depend on it (proven over arbitrary N by `core_props::binned_sum_is_chunk_*`).
//
// The worker bins into a *local* `[2048]i64` with the ordinary `binned_add` (so the
// carry / correctly-rounded machinery is never re-implemented for the parallel
// path) and copies it out to its region; the merge and finalize reuse the serial
// primitives. Disjointness is by construction (region `w` is `[w·2048, w·2048+2048)`).
const PAR_WORKERS: usize = 4

// One worker: bin `chunk` into a local accumulator, then copy it to region `acc`
// (2048 contiguous i64). Writing a region no other worker touches → race-free.
fn par_worker(read chunk: []f64, acc: *mut i64) {
    var local: [2048]i64 = [0; 2048]
    for x in chunk { binned_add(local, x) }
    var i: usize = 0
    for i < 2048 {
        unsafe { (acc + i).* = local[i] }
        i = i + 1
    }
}

// Reproducible parallel sum: split `s` across `PAR_WORKERS` threads, each filling
// its own accumulator region, then merge + finalize. Bit-identical to
// `f64_binned_sum(s)` for any input and any thread count.
pub fn par_binned_sum(read s: []f64) -> f64 {
    let n: usize = s.len
    var raw: *mut i64 = alloc(i64, 8192)            // PAR_WORKERS · 2048
    let q: usize = n / 4
    let c0: []f64 = slice(f64, s.ptr + 0, q)
    let c1: []f64 = slice(f64, s.ptr + q, q)
    let c2: []f64 = slice(f64, s.ptr + (q + q), q)
    let c3: []f64 = slice(f64, s.ptr + (q + q + q), n - (q + q + q))
    concurrent {
        spawn par_worker(c0, raw + 0)
        spawn par_worker(c1, raw + 2048)
        spawn par_worker(c2, raw + 4096)
        spawn par_worker(c3, raw + 6144)
    }
    // Merge the four regions by elementwise integer add (order-independent), then
    // finalize once through the correctly-rounded serial finalize.
    var total: [2048]i64 = [0; 2048]
    var w: usize = 0
    for w < 4 {
        let base: usize = w * 2048
        var i: usize = 0
        for i < 2048 {
            unsafe { total[i] = total[i] + (raw + (base + i)).* }
            i = i + 1
        }
        w = w + 1
    }
    let result: f64 = binned_sum(total)
    free_ptr(raw)
    return result
}

// ── Generalized deterministic parallel reduction — `par_reduce` ───────────────
//
// THE HEADLINE, library tier. `par_binned_sum` proved one bit-reproducible parallel
// reduction; this generalizes the *shape* to any reduction declared as a value: a
// `Reduction` carries an `identity`, an `accumulate` (fold one element into a
// worker-local accumulator), and an order-independent `combine` (merge two
// accumulators). `par_reduce` partitions the slice across `PAR_WORKERS`, each worker
// folds its chunk into a DISJOINT accumulator slot, then the slots are merged with
// `combine` and the result returned — **bit-identical to the serial fold for any
// chunk split or thread schedule**, because `combine` is associative *and*
// commutative at the machine-integer level (integer +, min, max, xor are exact).
//
// The accumulator is `i64` (so the worker is monomorphic — `spawn` targets cannot
// be generic). That covers the deterministic integer reductions below. The *float*
// case is exactly where determinism is hard: the binned superaccumulator
// (`par_binned_sum`) is the bit-exact answer, and a NAIVE `f64 +` reduction is
// deliberately NOT offered here because it reassociates under parallelism — the
// compile-time rejection of such non-deterministic reductions is the `par for …
// reduce(r)` surface (workstream N, tier 2). Determinism here is provable today
// (`core_props::par_reduce_is_split_independent`).

pub struct Reduction {
    identity:   i64,
    accumulate: fn(i64, i64) -> i64,   // fold an element into the accumulator
    combine:    fn(i64, i64) -> i64,   // merge two accumulators (order-independent)
}

// Element/merge ops for the built-in reductions. For T == accumulator == i64,
// `accumulate` and `combine` are the same associative+commutative operation.
fn red_add(a: i64, b: i64) -> i64 { return a + b }
fn red_min(a: i64, b: i64) -> i64 { if a < b { return a } return b }
fn red_max(a: i64, b: i64) -> i64 { if a > b { return a } return b }
fn red_xor(a: i64, b: i64) -> i64 { return a ^ b }

// The four deterministic built-ins. `identity` is the op's unit: 0 for sum/xor,
// the largest i64 for min, the smallest for max (so `op(identity, x) == x`).
pub fn sum_reduction() -> Reduction {
    return Reduction{ identity: 0, accumulate: &red_add, combine: &red_add }
}
pub fn min_reduction() -> Reduction {
    return Reduction{ identity: 9223372036854775807, accumulate: &red_min, combine: &red_min }
}
pub fn max_reduction() -> Reduction {
    return Reduction{ identity: (0 - 9223372036854775807) - 1, accumulate: &red_max, combine: &red_max }
}
pub fn xor_reduction() -> Reduction {
    return Reduction{ identity: 0, accumulate: &red_xor, combine: &red_xor }
}

// One worker: fold `chunk` into a local accumulator starting from `ident`, then
// write it to slot `slot` (a region no other worker touches → race-free).
fn par_reduce_worker(read chunk: []i64, slot: *mut i64, ident: i64, accfn: fn(i64, i64) -> i64) {
    var acc: i64 = ident
    for x in chunk { acc = accfn(acc, x) }
    unsafe { (slot + 0).* = acc }
}

// The serial reference fold (left-to-right). For a deterministic `Reduction` the
// parallel result equals this bit-for-bit; it doubles as the in-program oracle.
pub fn serial_reduce(read s: []i64, r: Reduction) -> i64 {
    var acc: i64 = r.identity
    for x in s { acc = r.accumulate(acc, x) }
    return acc
}

// Reproducible parallel reduction: split `s` across `PAR_WORKERS` threads, each
// folding its chunk into its own slot, then merge with `combine` and return.
// Bit-identical to `serial_reduce(s, r)` for any input and any thread count when
// `r` is a deterministic reduction (the integer built-ins above).
pub fn par_reduce(read s: []i64, r: Reduction) -> i64 {
    let n: usize = s.len
    var raw: *mut i64 = alloc(i64, 4)
    let q: usize = n / 4
    let c0: []i64 = slice(i64, s.ptr + 0, q)
    let c1: []i64 = slice(i64, s.ptr + q, q)
    let c2: []i64 = slice(i64, s.ptr + (q + q), q)
    let c3: []i64 = slice(i64, s.ptr + (q + q + q), n - (q + q + q))
    concurrent {
        spawn par_reduce_worker(c0, raw + 0, r.identity, r.accumulate)
        spawn par_reduce_worker(c1, raw + 1, r.identity, r.accumulate)
        spawn par_reduce_worker(c2, raw + 2, r.identity, r.accumulate)
        spawn par_reduce_worker(c3, raw + 3, r.identity, r.accumulate)
    }
    // Merge the four slots with the order-independent combine (fixed order, but the
    // result does not depend on it), starting from the identity.
    var acc: i64 = r.identity
    var w: usize = 0
    for w < 4 {
        unsafe { acc = r.combine(acc, (raw + w).*) }
        w = w + 1
    }
    free_ptr(raw)
    return acc
}

// ── Correctly-rounded float parse — Eisel–Lemire (fast path) ──────────────────
//
// Decimal → nearest `f64`, locale-free. Parse the digits into a ≤19-digit u64
// significand `w` and a power-of-ten `q`, then compute `w·10^q` to 128 bits via a
// single `mul64` against the precomputed `POW10_128` table (the 128-bit significand
// of 10^q; see the table's comment), and read off the rounded 53-bit mantissa +
// binary exponent. This is the algorithm behind Rust/Go/etc. fast float parsing
// (Lemire, *Number Parsing at a Gigabyte per Second*) — and the distinctly-Jestyr
// determinism deliverable: a *bit-reproducible*, correctly-rounded parser.
//
// Scope: the **fast path**. Inputs with > 19 significant digits return
// `err(too_many_digits)` (the rare slow path is future work); everything else is
// correctly rounded. Validated end-to-end against Rust's correctly-rounded parser
// (`proptests::lemire`), whose generator emits the table below.

// Variant names are globally unique constructors, so prefix to avoid colliding
// with `ParseIntError`'s `empty`/`invalid_digit`/`overflow`.
pub enum ParseFloatError { pf_empty, pf_invalid, pf_too_many_digits }

// `power(q) = ⌊q·log₂10⌋ + 63`, via Lemire's integer magic (217706/65536 ≈ log₂10).
fn lemire_power(q: i64) -> i64 {
    return ((217706 * q) >> 16) + 63
}

// Top 128 bits of `w × 10^q` (a `U128`), with a second multiply when the first is
// too close to a rounding boundary to be sure (the `precision_mask` check).
fn lemire_product(q: i64, w: u64) -> U128 {
    let idx: usize = ((q + 342) * 2) as usize
    let thi: u64 = POW10_128[idx]
    let tlo: u64 = POW10_128[idx + 1]
    var p: U128 = mul64(w, thi)
    let mask: u64 = 511                            // (u64::MAX >> 55): low 9 bits = 52+3 precision
    if (p.hi & mask) == mask {
        let s: U128 = mul64(w, tlo)
        let nlo: u64 = p.lo + s.hi
        if nlo < p.lo { p.hi = p.hi + 1 }          // carry out of the low limb
        p.lo = nlo
    }
    return p
}

// The Eisel–Lemire fast path as a reusable helper: round `mant · 10^q` (mant a
// ≤19-digit u64) to the nearest f64, returning its raw bits. Used both for the
// fast path and as the slow path's starting candidate.
fn lemire_f64(neg: bool, mant: u64, q: i64) -> u64 {
    let one: u64 = 1
    var sign: u64 = 0
    if neg { sign = one << 63 }
    if mant == 0 or q < (0 - 342) { return sign }                       // ±0
    if q > 308 { return sign | ((2047 as u64) << 52) }                  // ±inf
    let lz: i64 = clz64(mant) as i64
    let w: u64 = mant << (lz as u64)
    let p: U128 = lemire_product(q, w)
    let upperbit: i64 = (p.hi >> 63) as i64
    let sh: u64 = (upperbit + 9) as u64
    var m: u64 = p.hi >> sh
    var power2: i64 = lemire_power(q) + upperbit - lz + 1023
    if power2 <= 0 {
        let rsh: i64 = (0 - power2) + 1
        if rsh >= 64 { return sign }                                    // underflow → ±0
        m = m >> (rsh as u64)
        m = m + (m & 1)
        m = m >> 1
        var bexp: i64 = 0
        if m >= (one << 52) { bexp = 1 }
        return sign | m | ((bexp as u64) << 52)
    }
    if p.lo <= 1 and q >= (0 - 4) and q <= 23 {
        if (m & 3) == 1 {
            if (m << sh) == p.hi { m = m - (m & 1) }
        }
    }
    m = m + (m & 1)
    m = m >> 1
    if m >= (one << 53) {
        m = one << 52
        power2 = power2 + 1
    }
    m = m & ((one << 52) - 1)
    if power2 >= 2047 { return sign | ((2047 as u64) << 52) }           // overflow → ±inf
    return sign | m | ((power2 as u64) << 52)
}

// ── Slow path (> 19 digits): arbitrary-precision, correctly rounded ───────────
//
// The fast path can't form the 64-bit mantissa beyond 19 digits. Take its result
// on the first 19 digits as a candidate `g` (within ~0.01 ULP of the true value),
// then decide between `g` and its bit-pattern neighbours `g±1` by comparing the
// exact value `D·10^E` to the relevant rounding midpoint — a cross-multiplied
// big-integer comparison (multiply by 5ⁿ, shift, compare; never divide). The
// comparison keeps up to 768 significant digits exactly (a boundary's exact decimal
// has < 768), with a sticky bit for the rest. A 56-limb (3584-bit) bignum holds it.

fn sp_from_u64(x: u64) -> [56]u64 {
    var a: [56]u64 = [0; 56]
    a[0] = x
    return a
}
fn sp_mul_small(mut a: [56]u64, m: u64) {
    var carry: u64 = 0
    var i: usize = 0
    for i < 56 {
        let prod: U128 = mul64(a[i], m)
        let lo: u64 = prod.lo + carry
        var c2: u64 = 0
        if lo < carry { c2 = 1 }
        a[i] = lo
        carry = prod.hi + c2
        i = i + 1
    }
}
fn sp_add_small(mut a: [56]u64, x: u64) {
    var carry: u64 = x
    var i: usize = 0
    for carry != 0 {
        if i >= 56 { return }
        let s: u64 = a[i] + carry
        var c: u64 = 0
        if s < a[i] { c = 1 }
        a[i] = s
        carry = c
        i = i + 1
    }
}
fn sp_shl(mut a: [56]u64, n: usize) {
    let words: usize = n / 64
    let bits: usize = n % 64
    if bits != 0 {
        var carry: u64 = 0
        var i: usize = 0
        for i < 56 {
            let v: u64 = a[i]
            a[i] = (v << bits) | carry
            carry = v >> (64 - bits)
            i = i + 1
        }
    }
    if words != 0 {
        var j: usize = 56
        for j > 0 {
            j = j - 1
            if j >= words { a[j] = a[j - words] } else { a[j] = 0 }
        }
    }
}
fn sp_cmp(read a: [56]u64, read b: [56]u64) -> i32 {
    var i: usize = 56
    for i > 0 {
        i = i - 1
        if a[i] != b[i] {
            if a[i] < b[i] { return 0 - 1 }
            return 1
        }
    }
    return 0
}
fn sp_mul_pow5(mut a: [56]u64, e: usize) {
    var i: usize = 0
    for i < e {
        sp_mul_small(a, 5)
        i = i + 1
    }
}
fn sp_from_digits(read d: [768]u8, t: usize) -> [56]u64 {
    var b: [56]u64 = [0; 56]
    var i: usize = 0
    for i < t {
        sp_mul_small(b, 10)
        sp_add_small(b, (d[i] - 48) as u64)
        i = i + 1
    }
    return b
}

// Compare `dt · 10^et` against the boundary `c · 2^p`; `sticky` means the true
// value is strictly larger than `dt·10^et`. Returns -1 / 0 / 1. Division-free.
fn sp_cmp_boundary(read dt: [56]u64, et: i64, c: u64, p: i64, sticky: bool) -> i32 {
    var l: [56]u64 = dt
    var r: [56]u64 = sp_from_u64(c)
    if et >= 0 {
        sp_mul_pow5(l, et as usize)
    } else {
        sp_mul_pow5(r, (0 - et) as usize)
    }
    var mn: i64 = et
    if p < mn { mn = p }
    sp_shl(l, (et - mn) as usize)
    sp_shl(r, (p - mn) as usize)
    let o: i32 = sp_cmp(l, r)
    if o == 0 {
        if sticky { return 1 }
    }
    return o
}

// `t` = digits stored in `d` (= min(nd, 768)); `nd` = total significant digits;
// value = (full significand) · 10^e; `sticky` = any dropped digit nonzero.
fn slow_parse(neg: bool, read d: [768]u8, t: usize, nd: usize, e: i64, sticky: bool) -> u64 {
    let one: u64 = 1
    var sign: u64 = 0
    if neg { sign = one << 63 }
    // candidate from the first 19 significant digits
    var w: u64 = 0
    var ci: usize = 0
    for ci < 19 {
        w = w * 10 + ((d[ci] - 48) as u64)
        ci = ci + 1
    }
    let q19: i64 = e + ((nd as i64) - 19)
    var gbits: u64 = lemire_f64(neg, w, q19) & ((one << 63) - 1)        // magnitude
    let be: u64 = (gbits >> 52) & 0x7FF
    if be == 2047 { return sign | gbits }                              // ±inf
    let dt: [56]u64 = sp_from_digits(d, t)
    let et: i64 = e + ((nd as i64) - (t as i64))
    let mant: u64 = gbits & 0xFFFFFFFFFFFFF
    var m: u64 = mant
    var k: i64 = 0 - 1074
    if be != 0 {
        m = (one << 52) | mant
        k = (be as i64) - 1075
    }
    var resbits: u64 = gbits
    if m == 0 {
        // candidate ±0: boundary to the smallest subnormal is 2^-1075
        if sp_cmp_boundary(dt, et, 1, 0 - 1075, sticky) > 0 { resbits = gbits + 1 }
    } else {
        let c0: i32 = sp_cmp_boundary(dt, et, 2 * m, k - 1, sticky)    // vs g itself
        if c0 > 0 {
            // V above g → g or succ; upper midpoint (2m+1)·2^(k-1)
            let ch: i32 = sp_cmp_boundary(dt, et, 2 * m + 1, k - 1, sticky)
            if ch > 0 {
                resbits = gbits + 1
            } else {
                if ch == 0 {
                    if (m & 1) == 1 { resbits = gbits + 1 }            // tie → even
                }
            }
        } else {
            if c0 < 0 {
                // V below g → g or pred; lower midpoint (asymmetric at powers of two)
                var cc: u64 = 2 * m - 1
                var pp: i64 = k - 1
                if mant == 0 {
                    if be > 1 {
                        cc = 4 * m - 1
                        pp = k - 2
                    }
                }
                let cl: i32 = sp_cmp_boundary(dt, et, cc, pp, sticky)
                if cl < 0 {
                    resbits = gbits - 1
                } else {
                    if cl == 0 {
                        if (m & 1) == 1 { resbits = gbits - 1 }        // tie → even
                    }
                }
            }
        }
    }
    return sign | resbits
}

pub fn parse_float(s: str) -> Result(f64, ParseFloatError) {
    let one: u64 = 1
    if s.len == 0 { return err(pf_empty) }
    var i: usize = 0
    var neg: bool = false
    if s[0] == 45 {
        neg = true
        i = 1
    } else {
        if s[0] == 43 { i = 1 }
    }
    var digbuf: [768]u8 = [0; 768]
    var nd: usize = 0                                // total significant digits (uncapped)
    var stored: usize = 0                            // significant digits kept in digbuf (≤768)
    var sticky: bool = false                         // a dropped significant digit was nonzero
    var frac: i64 = 0                                // digit count after the decimal point
    var dot: bool = false
    var seen: bool = false
    var seen_nz: bool = false                        // first nonzero digit seen (skip leading 0s)
    for i < s.len {
        let b: u8 = s[i]
        if b >= 48 and b <= 57 {
            seen = true
            if dot { frac = frac + 1 }
            if b == 48 and seen_nz == false {
                // leading zero — not significant (its place is tracked by `frac`/exp)
            } else {
                seen_nz = true
                if stored < 768 {
                    digbuf[stored] = b
                    stored = stored + 1
                } else {
                    if b != 48 { sticky = true }
                }
                nd = nd + 1
            }
            i = i + 1
        } else {
            if b == 46 and dot == false {
                dot = true
                i = i + 1
            } else {
                break
            }
        }
    }
    if seen == false { return err(pf_invalid) }
    var expo: i64 = 0
    if i < s.len {
        let e0: u8 = s[i]
        if e0 == 101 or e0 == 69 {                    // 'e' / 'E'
            i = i + 1
            var esign: i64 = 1
            if i < s.len {
                let es: u8 = s[i]
                if es == 45 {
                    esign = 0 - 1
                    i = i + 1
                } else {
                    if es == 43 { i = i + 1 }
                }
            }
            var ev: i64 = 0
            var any: bool = false
            for i < s.len {
                let d2: u8 = s[i]
                if d2 < 48 or d2 > 57 { break }
                any = true
                ev = ev * 10 + ((d2 - 48) as i64)
                i = i + 1
            }
            if any == false { return err(pf_invalid) }
            expo = esign * ev
        }
    }
    if i != s.len { return err(pf_invalid) }         // trailing junk
    var sign: u64 = 0
    if neg { sign = one << 63 }
    if seen_nz == false { return ok(f64_from_bits(sign)) }   // all zeros → ±0
    let e: i64 = expo - frac                          // value = (significand) · 10^e
    if nd <= 19 {
        var w: u64 = 0
        var j: usize = 0
        for j < stored {
            w = w * 10 + ((digbuf[j] - 48) as u64)
            j = j + 1
        }
        return ok(f64_from_bits(lemire_f64(neg, w, e)))
    }
    return ok(f64_from_bits(slow_parse(neg, digbuf, stored, nd, e, sticky)))
}

// ── Shortest correctly-rounded float format — Dragon4 ─────────────────────────
//
// `f64` → the *shortest* decimal string that parses back to it, correctly rounded.
// Dragon4 (Steele-White / Burger-Dubois): represent the value and its rounding
// margins as exact big-integer ratios (R/S with high/low margins mp/mm) and emit
// digits until the remaining interval pins a unique shortest result. Table-free
// (unlike Ryū, which trades these big-integer ops for two lookup tables — a future
// perf swap with identical output) and **deterministic** — ties round to even.
// Locale-free, into a caller `[]u8` (no alloc), like `format_i64`. Validated digit-
// for-digit against Rust's shortest formatter in `proptests::dragon`.
//
// A fixed 40-limb (2560-bit) unsigned bignum covers the worst case (≈1100 bits).
// Only shift / mul-by-small / add / subtract / compare are needed — no division.

fn d4_from_u64(x: u64) -> [40]u64 {
    var a: [40]u64 = [0; 40]
    a[0] = x
    return a
}

// a *= m (small multiplier)
fn d4_mul_small(mut a: [40]u64, m: u64) {
    var carry: u64 = 0
    var i: usize = 0
    for i < 40 {
        let prod: U128 = mul64(a[i], m)
        let lo: u64 = prod.lo + carry
        var c2: u64 = 0
        if lo < carry { c2 = 1 }
        a[i] = lo
        carry = prod.hi + c2
        i = i + 1
    }
}

// a <<= n bits (within the 2560-bit width)
fn d4_shl(mut a: [40]u64, n: usize) {
    let words: usize = n / 64
    let bits: usize = n % 64
    if bits != 0 {
        var carry: u64 = 0
        var i: usize = 0
        for i < 40 {
            let v: u64 = a[i]
            a[i] = (v << bits) | carry
            carry = v >> (64 - bits)
            i = i + 1
        }
    }
    if words != 0 {
        var j: usize = 40
        for j > 0 {
            j = j - 1
            if j >= words {
                a[j] = a[j - words]
            } else {
                a[j] = 0
            }
        }
    }
}

// -1 if a<b, 0 if equal, 1 if a>b (top limb first)
fn d4_cmp(read a: [40]u64, read b: [40]u64) -> i32 {
    var i: usize = 40
    for i > 0 {
        i = i - 1
        if a[i] != b[i] {
            if a[i] < b[i] { return 0 - 1 }
            return 1
        }
    }
    return 0
}

// res = a + b
fn d4_add(read a: [40]u64, read b: [40]u64) -> [40]u64 {
    var res: [40]u64 = [0; 40]
    var carry: u64 = 0
    var i: usize = 0
    for i < 40 {
        let s: u64 = a[i] + b[i]
        var c1: u64 = 0
        if s < a[i] { c1 = 1 }
        let s2: u64 = s + carry
        var c2: u64 = 0
        if s2 < s { c2 = 1 }
        res[i] = s2
        carry = c1 | c2
        i = i + 1
    }
    return res
}

// a -= b (assumes a >= b)
fn d4_sub(mut a: [40]u64, read b: [40]u64) {
    var borrow: u64 = 0
    var i: usize = 0
    for i < 40 {
        let ai: u64 = a[i]
        let d1: u64 = ai - b[i]
        var bo1: u64 = 0
        if ai < b[i] { bo1 = 1 }
        let d2: u64 = d1 - borrow
        var bo2: u64 = 0
        if d1 < borrow { bo2 = 1 }
        a[i] = d2
        borrow = bo1 | bo2
        i = i + 1
    }
}

// Write the shortest decimal for `x` into `buf` as `[-]d[.ddd]e±E` (canonical
// scientific, always round-trippable). Returns the byte count. `buf` must hold ≥ 32
// bytes. Subnormals, zero, inf, and nan are handled.
pub fn format_float(x: f64, mut buf: []u8) -> usize {
    let one: u64 = 1
    let bits: u64 = f64_bits(x)
    let sign: u64 = bits >> 63
    let ieee_exp: i64 = ((bits >> 52) & 0x7FF) as i64
    let ieee_mant: u64 = bits & 0xFFFFFFFFFFFFF
    var pos: usize = 0
    if sign == 1 {
        buf[pos] = 45                               // '-'
        pos = pos + 1
    }
    if ieee_exp == 2047 {                           // inf / nan
        var c0: u8 = 105                            // 'i'
        var c1: u8 = 110                            // 'n'
        var c2: u8 = 102                            // 'f'
        if ieee_mant != 0 {
            c0 = 110                                // 'n'
            c1 = 97                                 // 'a'
            c2 = 110                                // 'n'
        }
        buf[pos] = c0
        pos = pos + 1
        buf[pos] = c1
        pos = pos + 1
        buf[pos] = c2
        pos = pos + 1
        return pos
    }
    if ieee_exp == 0 and ieee_mant == 0 {           // zero
        buf[pos] = 48                               // '0'
        pos = pos + 1
        buf[pos] = 101                              // 'e'
        pos = pos + 1
        buf[pos] = 48                               // '0'
        pos = pos + 1
        return pos
    }
    var f: u64 = ieee_mant
    var e: i64 = 0 - 1074
    if ieee_exp != 0 {
        f = (one << 52) | ieee_mant
        e = ieee_exp - 1075
    }
    let even: bool = (f & 1) == 0
    let pow52: u64 = one << 52

    var bigR: [40]u64 = [0; 40]
    var bigS: [40]u64 = [0; 40]
    var mp: [40]u64 = [0; 40]
    var mm: [40]u64 = [0; 40]
    if e >= 0 {
        if f != pow52 {
            bigR = d4_from_u64(f)
            d4_mul_small(bigR, 2)
            d4_shl(bigR, e as usize)
            bigS = d4_from_u64(2)
            mp = d4_from_u64(1)
            d4_shl(mp, e as usize)
            mm = d4_from_u64(1)
            d4_shl(mm, e as usize)
        } else {
            bigR = d4_from_u64(f)
            d4_mul_small(bigR, 4)
            d4_shl(bigR, e as usize)
            bigS = d4_from_u64(4)
            mp = d4_from_u64(1)
            d4_shl(mp, (e + 1) as usize)
            mm = d4_from_u64(1)
            d4_shl(mm, e as usize)
        }
    } else {
        let at_min: bool = e == (0 - 1074)
        if at_min or f != pow52 {
            bigR = d4_from_u64(f)
            d4_mul_small(bigR, 2)
            bigS = d4_from_u64(1)
            d4_shl(bigS, (1 - e) as usize)
            mp = d4_from_u64(1)
            mm = d4_from_u64(1)
        } else {
            bigR = d4_from_u64(f)
            d4_mul_small(bigR, 4)
            bigS = d4_from_u64(1)
            d4_shl(bigS, (2 - e) as usize)
            mp = d4_from_u64(2)
            mm = d4_from_u64(1)
        }
    }

    // Scale into [0.1, 1): table-free fixup, no log estimate.
    var k: i64 = 0
    for true {
        let rp: [40]u64 = d4_add(bigR, mp)
        let c: i32 = d4_cmp(rp, bigS)
        var hi: bool = false
        if even {
            if c >= 0 { hi = true }
        } else {
            if c > 0 { hi = true }
        }
        if hi {
            d4_mul_small(bigS, 10)
            k = k + 1
        } else {
            break
        }
    }
    for true {
        var rp: [40]u64 = d4_add(bigR, mp)
        d4_mul_small(rp, 10)
        let c: i32 = d4_cmp(rp, bigS)
        var low: bool = false
        if even {
            if c <= 0 { low = true }
        } else {
            if c < 0 { low = true }
        }
        if low {
            d4_mul_small(bigR, 10)
            d4_mul_small(mp, 10)
            d4_mul_small(mm, 10)
            k = k - 1
        } else {
            break
        }
    }

    // Generate digits.
    var digits: [24]u8 = [0; 24]
    var nd: usize = 0
    for true {
        d4_mul_small(bigR, 10)
        d4_mul_small(mp, 10)
        d4_mul_small(mm, 10)
        var d: u8 = 0
        for d4_cmp(bigR, bigS) >= 0 {
            d4_sub(bigR, bigS)
            d = d + 1
        }
        let cl: i32 = d4_cmp(bigR, mm)
        var low: bool = false
        if even {
            if cl <= 0 { low = true }
        } else {
            if cl < 0 { low = true }
        }
        let rp: [40]u64 = d4_add(bigR, mp)
        let ch: i32 = d4_cmp(rp, bigS)
        var high: bool = false
        if even {
            if ch >= 0 { high = true }
        } else {
            if ch > 0 { high = true }
        }
        if low == false and high == false {
            digits[nd] = 48 + d
            nd = nd + 1
        } else {
            var up: bool = false
            if low and high {
                var r2: [40]u64 = bigR
                d4_mul_small(r2, 2)
                let c2: i32 = d4_cmp(r2, bigS)
                if c2 > 0 { up = true }
                if c2 == 0 {
                    if (d & 1) == 1 { up = true }   // tie → round to even
                }
            } else {
                if high { up = true }
            }
            var dd: u8 = d
            if up { dd = d + 1 }
            digits[nd] = 48 + dd
            nd = nd + 1
            break
        }
    }

    // Assemble `d[.ddd]e±E`.
    buf[pos] = digits[0]
    pos = pos + 1
    if nd > 1 {
        buf[pos] = 46                               // '.'
        pos = pos + 1
        var i: usize = 1
        for i < nd {
            buf[pos] = digits[i]
            pos = pos + 1
            i = i + 1
        }
    }
    buf[pos] = 101                                  // 'e'
    pos = pos + 1
    var ex: i64 = k - 1                             // value = d.ddd × 10^(k-1)
    if ex < 0 {
        buf[pos] = 45                               // '-'
        pos = pos + 1
        ex = 0 - ex
    }
    if ex >= 100 {
        buf[pos] = (48 + ((ex / 100) % 10)) as u8
        pos = pos + 1
    }
    if ex >= 10 {
        buf[pos] = (48 + ((ex / 10) % 10)) as u8
        pos = pos + 1
    }
    buf[pos] = (48 + (ex % 10)) as u8
    pos = pos + 1
    return pos
}

// Power-of-ten table for Eisel–Lemire parse_float: the 128-bit
// significand of 10^q (bit 127 set; +powers truncated, -powers rounded up)
// for q in [-342, 308], interleaved hi, lo. Index: i = (q + 342) * 2.
// GENERATED by `cargo test dump_pow10_table -- --ignored` — do not hand-edit.
const POW10_128: [1302]u64 = [
    0xEEF453D6923BD65A, 0x113FAA2906A13B40,   // q = -342
    0x9558B4661B6565F8, 0x4AC7CA59A424C508,   // q = -341
    0xBAAEE17FA23EBF76, 0x5D79BCF00D2DF64A,   // q = -340
