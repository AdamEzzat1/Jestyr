// std/core.jtr — the `core` tier: allocation-free, OS-free helpers (design §3/§14).
// Nothing here allocates; `core` is what a freestanding/bare-metal target links.

pub fn imax(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

pub fn imin(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

pub fn abs_i32(x: i32) -> i32 {
    if x < 0 { return 0 - x }
    return x
}

// ── Option / Result + their combinators ──────────────────────────────────────
//
// The two fallible-value types of `core`, monomorphized per instantiation (so
// `Option(*mut T)` even niche-optimizes to a bare pointer). The combinators are
// allocation-free generic *functions* — Jestyr has no method syntax on a generic
// enum, so the receiver is the first value argument and the element/result types
// are passed as `comptime` arguments: `core.opt_map(i32, i32, o, &f)`.
//
// They obey the functor *and* monad laws by construction — `map(id) == id`,
// `map(f) then map(g) == map(g∘f)`, `some(x).and_then(f) == f(x)`,
// `m.and_then(some) == m` — which is exactly how `core_props` tests them (laws as
// oracles). A higher-order combinator takes a thin `fn(T) -> U` pointer (a
// non-capturing closure coerces to one), so `&inc` or `|x| x + 1` both work; a
// monadic `f` returns an `Option(U)`/`Result(U,E)` (a by-value aggregate return,
// which the forward-declared instance typedefs make legal).

pub enum Option(T) { none, some(v: T) }
pub enum Result(T, E) { ok(v: T), err(e: E) }

// --- Option ---

pub fn opt_is_some(comptime T: type, read o: Option(T)) -> bool {
    match o { some(v) => true, none => false }
}

pub fn opt_is_none(comptime T: type, read o: Option(T)) -> bool {
    match o { some(v) => false, none => true }
}

// `unwrap_or(some(x), d) == x`; `unwrap_or(none, d) == d`.
pub fn opt_unwrap_or(comptime T: type, take o: Option(T), take d: T) -> T {
    match o { some(v) => v, none => d }
}

// Like `unwrap_or` but the default is produced lazily — only on `none`.
pub fn opt_unwrap_or_else(comptime T: type, take o: Option(T), f: fn() -> T) -> T {
    match o { some(v) => v, none => f() }
}

// The functor map: `opt_map(some(x), f) == some(f(x))`, `opt_map(none, f) == none`.
pub fn opt_map(comptime T: type, comptime U: type, take o: Option(T), f: fn(T) -> U) -> Option(U) {
    match o { some(v) => some(f(v)), none => none }
}

// `map` then `unwrap_or` in one step (no intermediate `Option(U)`).
pub fn opt_map_or(comptime T: type, comptime U: type, take o: Option(T), take d: U, f: fn(T) -> U) -> U {
    match o { some(v) => f(v), none => d }
}

// Bridge to `Result`: `some(x) -> ok(x)`, `none -> err(e)`.
pub fn opt_ok_or(comptime T: type, comptime E: type, take o: Option(T), take e: E) -> Result(T, E) {
    match o { some(v) => ok(v), none => err(e) }
}

// The monadic bind: `opt_and_then(some(x), f) == f(x)`, `opt_and_then(none, f) == none`.
// `f` itself returns an `Option(U)`, so chained fallible steps short-circuit on `none`.
pub fn opt_and_then(comptime T: type, comptime U: type, take o: Option(T), f: fn(T) -> Option(U)) -> Option(U) {
    match o { some(v) => f(v), none => none }
}

// Keep the value only if it passes `pred` (which *borrows* it, so the value
// survives): `opt_filter(some(x), p) == if p(x) { some(x) } else { none }`.
pub fn opt_filter(comptime T: type, take o: Option(T), pred: fn(read T) -> bool) -> Option(T) {
    match o { some(v) => if pred(v) { some(v) } else { none }, none => none }
}

// Fall back to an alternative `Option`, produced lazily, only on `none`.
pub fn opt_or_else(comptime T: type, take o: Option(T), f: fn() -> Option(T)) -> Option(T) {
    match o { some(v) => some(v), none => f() }
}

// --- Result ---

pub fn res_is_ok(comptime T: type, comptime E: type, read r: Result(T, E)) -> bool {
    match r { ok(v) => true, err(e) => false }
}

pub fn res_is_err(comptime T: type, comptime E: type, read r: Result(T, E)) -> bool {
    match r { ok(v) => false, err(e) => true }
}

pub fn res_unwrap_or(comptime T: type, comptime E: type, take r: Result(T, E), take d: T) -> T {
    match r { ok(v) => v, err(e) => d }
}

// The functor map over the ok value; the error passes through unchanged.
pub fn res_map(comptime T: type, comptime U: type, comptime E: type, take r: Result(T, E), f: fn(T) -> U) -> Result(U, E) {
    match r { ok(v) => ok(f(v)), err(e) => err(e) }
}

// Map the error value; the ok passes through unchanged.
pub fn res_map_err(comptime T: type, comptime E: type, comptime F: type, take r: Result(T, E), f: fn(E) -> F) -> Result(T, F) {
    match r { ok(v) => ok(v), err(e) => err(f(e)) }
}

// Bridge back to `Option`, discarding the error: `ok(x) -> some(x)`, `err(_) -> none`.
pub fn res_ok(comptime T: type, comptime E: type, take r: Result(T, E)) -> Option(T) {
    match r { ok(v) => some(v), err(e) => none }
}

// The monadic bind for `Result`: `res_and_then(ok(x), f) == f(x)`, error short-circuits.
pub fn res_and_then(comptime T: type, comptime U: type, comptime E: type, take r: Result(T, E), f: fn(T) -> Result(U, E)) -> Result(U, E) {
    match r { ok(v) => f(v), err(e) => err(e) }
}

// ── Slice / iterator algorithms over `[]T` ───────────────────────────────────
//
// `core` has no allocation, so these are the *consuming* (reduce/search) and
// *in-place* (sort) algorithms — the ones that don't have to produce a new owned
// sequence. (Producers like `map`/`filter` that build a new collection belong to
// the allocating `std`, Phase 2; a no-alloc `map_into(src, dst, f)` over a
// caller-provided buffer can follow.) A predicate/order is a thin `fn(read T) ->
// …` pointer; indices are returned as `Option(usize)` so nothing copies a
// (possibly non-`Copy`) element out.
//
// Tested by the iterator laws in `core_props` (a reference fold/search agrees with
// these) and the sort invariants (sorted permutation, deterministic).

// Left fold: `fold(init, f)` threads the accumulator left-to-right over the slice.
// `sum`/`count`/`product`/... are all this with the right `f`.
pub fn sl_fold(comptime T: type, comptime A: type, read s: []T, take init: A, f: fn(A, T) -> A) -> A {
    var acc: A = init
    for x in s { acc = f(acc, x) }
    return acc
}

// How many elements satisfy `pred`.
pub fn sl_count_where(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> usize {
    var n: usize = 0
    for x in s { if pred(x) { n = n + 1 } }
    return n
}

// Does *any* element satisfy `pred`? (Short-circuits.) Empty slice → false.
pub fn sl_any(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> bool {
    for x in s { if pred(x) { return true } }
    return false
}

// Do *all* elements satisfy `pred`? (Short-circuits.) Empty slice → true.
pub fn sl_all(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> bool {
    for x in s { if pred(x) { } else { return false } }
    return true
}

// The index of the first element satisfying `pred`, or `none`. Returns the *index*
// (a `usize`, always `Copy`) rather than the element, so nothing is copied out.
pub fn sl_find(comptime T: type, read s: []T, pred: fn(read T) -> bool) -> Option(usize) {
    for x, i in s { if pred(x) { return some(i) } }
    return none
}

// Binary search a slice **sorted by `less`** (a strict total order). Returns the
// index of a matching element, or `none`. (Which equal element is unspecified.)
pub fn sl_binary_search(comptime T: type, read s: []T, read target: T, less: fn(read T, read T) -> bool) -> Option(usize) {
    var lo: usize = 0
    var hi: usize = s.len
    for lo < hi {
        let mid: usize = lo + (hi - lo) / 2
        if less(s[mid], target) {
            lo = mid + 1
        } else {
            if less(target, s[mid]) { hi = mid } else { return some(mid) }
        }
    }
    return none
}

// Swap two elements in place. Raw-pointer level (in `unsafe`) so it works for a
// generic `T` without the borrow checker rejecting the temporary.
pub fn sl_swap(comptime T: type, mut s: []T, i: usize, j: usize) {
    unsafe {
        var pi: *mut T = s.ptr + i
        var pj: *mut T = s.ptr + j
        let tmp: T = pi.*
        pi.* = pj.*
        pj.* = tmp
    }
}

// In-place **stable, deterministic** insertion sort by `less` (a strict total
// order). Stable: equal elements keep their input order (the `< prev` test never
// swaps equals). Deterministic: the same input + `less` always yields the same
// output — no randomized pivot. O(n²); a deterministic merge sort can replace it
// once the allocating `std` provides scratch space.
pub fn sl_sort(comptime T: type, mut s: []T, less: fn(read T, read T) -> bool) {
    var i: usize = 1
    for i < s.len {
        var j: usize = i
        for j > 0 {
            if less(s[j], s[j - 1]) {
                sl_swap(T, s, j, j - 1)
                j = j - 1
            } else {
                j = 0
            }
        }
        i = i + 1
    }
}

// ── Number parsing & formatting — locale-free, deterministic, bytewise ────────
//
// The std side of the numerics determinism contract: parse/format are defined by
// construction (decimal, ASCII `0`–`9`, no locale, no float rounding modes), so
// they are **bit-identical across platforms** — `parse(format(x)) == x` round-trips
// and the digit bytes are the same everywhere. `core` stays no-alloc: `format_*`
// writes into a **caller-provided `[]u8`** and returns the byte count (a 20-byte
// buffer holds any `i64`/`u64` — up to 19–20 digits plus a sign).
//
// Integers only for now; correctly-rounded float parse/format (Eisel–Lemire + Ryū)
// is the next numerics increment — see CORE-STD-PHASE3.md.
//
// Overflow is a *defined* error (`ParseIntError::overflow`), never silent wrap or
// UB: the signed parser accumulates negatively (`acc*10 - d`) so `i64::MIN` is
// representable, and checks the bound *before* each step.

pub enum ParseIntError { empty, invalid_digit, overflow }

// Parse a base-10 `i64` with an optional leading `+`/`-`. Locale-free; only ASCII
// digits. Returns `err(overflow)` rather than wrapping past the `i64` range.
pub fn parse_i64(s: str) -> Result(i64, ParseIntError) {
    if s.len == 0 { return err(empty) }
    var i: usize = 0
    var neg: bool = false
    if s[0] == 45 {
        neg = true
        i = 1
    } else {
        if s[0] == 43 { i = 1 }
    }
    if i == s.len { return err(empty) }     // a lone sign is not a number
    let hi: i64 = 9223372036854775807       // i64::MAX
    let lo: i64 = (0 - hi) - 1              // i64::MIN, without an out-of-range literal
    var acc: i64 = 0                        // accumulate **negatively** so MIN fits
    for i < s.len {
        let b: u8 = s[i]
        if b < 48 or b > 57 { return err(invalid_digit) }
        let d: i64 = (b - 48) as i64
        if neg {
            if acc < (lo + d) / 10 { return err(overflow) }
            acc = acc * 10 - d
        } else {
            if acc > (hi - d) / 10 { return err(overflow) }
            acc = acc * 10 + d
        }
        i = i + 1
    }
    return ok(acc)
}

// Parse a base-10 `u64` with an optional leading `+`. A `-` sign is rejected.
pub fn parse_u64(s: str) -> Result(u64, ParseIntError) {
    if s.len == 0 { return err(empty) }
    var i: usize = 0
    if s[0] == 43 { i = 1 }
    if i == s.len { return err(empty) }
    let umax: u64 = 0 - 1                    // u64::MAX (wraps), no huge literal
    var acc: u64 = 0
    for i < s.len {
        let b: u8 = s[i]
        if b < 48 or b > 57 { return err(invalid_digit) }
        let d: u64 = (b - 48) as u64
        if acc > (umax - d) / 10 { return err(overflow) }
        acc = acc * 10 + d
        i = i + 1
    }
    return ok(acc)
}

// The number of base-10 digits in a `u64` (`0` has one digit).
pub fn count_digits_u64(n: u64) -> usize {
    if n == 0 { return 1 }
    var c: usize = 0
    var t: u64 = n
    for t > 0 {
        c = c + 1
        t = t / 10
    }
    return c
}

// Write the decimal digits of a `u64` into `buf` (digits filled back-to-front so a
// single pass needs no temporary). Returns the count. `buf` must hold ≥ 20 bytes.
pub fn format_u64(n: u64, mut buf: []u8) -> usize {
    if n == 0 {
        buf[0] = 48
        return 1
    }
    let count: usize = count_digits_u64(n)
    var x: u64 = n
    var pos: usize = count
    for x > 0 {
        pos = pos - 1
        buf[pos] = (48 + (x % 10)) as u8
        x = x / 10
    }
    return count
}

// Write the decimal digits of an `i64` (with a leading `-` when negative) into
// `buf`; returns the byte count. `buf` must hold ≥ 20 bytes. `i64::MIN` is handled
// via an unsigned magnitude (`0 - (n as u64)`), so it formats without overflow.
pub fn format_i64(n: i64, mut buf: []u8) -> usize {
    if n < 0 {
        buf[0] = 45                         // '-'
        let mag: u64 = 0 - (n as u64)       // magnitude; correct even for i64::MIN
        let c: usize = count_digits_u64(mag)
        var x: u64 = mag
        var pos: usize = 1 + c
        for x > 0 {
            pos = pos - 1
            buf[pos] = (48 + (x % 10)) as u8
            x = x / 10
        }
        return 1 + c
    }
    return format_u64(n as u64, buf)
}

// ── Float support primitives (toward correctly-rounded parse/format) ──────────
//
// `core` has no `u128`, so the 64×64→128 products that correctly-rounded float
// parse/format (Eisel–Lemire, Ryū) need are synthesized from 32-bit halves; and a
// float's bits are read via an untagged `union` (byte reinterpretation). These are
// the deterministic, locale-free building blocks the float algorithms sit on — see
// CORE-STD-PHASE3.md. The IEEE-754 binary64 layout is sign(1) · exponent(11) ·
// mantissa(52).

// A 128-bit unsigned value as a high/low `u64` pair.
pub struct U128 { hi: u64, lo: u64 }

// The full 128-bit product `a * b`, computed from 32-bit halves (no `u128`):
// (aH·2³² + aL)(bH·2³² + bL), carrying the cross terms into `hi`.
pub fn mul64(a: u64, b: u64) -> U128 {
    let mask: u64 = 0xFFFFFFFF
    let al: u64 = a & mask
    let ah: u64 = a >> 32
    let bl: u64 = b & mask
    let bh: u64 = b >> 32
    let ll: u64 = al * bl
    let lh: u64 = al * bh
    let hl: u64 = ah * bl
    let hh: u64 = ah * bh
    let mid: u64 = (ll >> 32) + (lh & mask) + (hl & mask)
    let lo: u64 = (ll & mask) | (mid << 32)
    let hi: u64 = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return U128{ hi: hi, lo: lo }
}

// Count leading zero bits of a `u64` (`clz64(0) == 64`) — the normalization step
// Eisel–Lemire needs. A simple shift-until-top-bit loop; a stdlib `@intrinsic`
// `leading_zeros` can replace it later.
pub fn clz64(x: u64) -> u32 {
    if x == 0 { return 64 }
    let one: u64 = 1
    let topbit: u64 = one << 63
    var v: u64 = x
    var n: u32 = 0
    for (v & topbit) == 0 {
        v = v << 1
        n = n + 1
    }
    return n
}

// A float reinterpreted as its raw bits, and vice-versa — an untagged `union`
// overlays the two, so reading the other field reinterprets the same bytes.
union FU { f: f64, u: u64 }

// The raw IEEE-754 bit pattern of an `f64`.
pub fn f64_bits(x: f64) -> u64 {
    var fu: FU = FU{ f: x }
    return fu.u
}

// The `f64` with the given raw IEEE-754 bit pattern.
pub fn f64_from_bits(u: u64) -> f64 {
    var fu: FU = FU{ u: u }
    return fu.f
}

// IEEE-754 binary64 field extractors (raw — the exponent is biased by 1023, the
// mantissa excludes the implicit leading 1 for normals).
pub fn f64_sign(x: f64) -> u64 { return f64_bits(x) >> 63 }
pub fn f64_raw_exp(x: f64) -> u64 { return (f64_bits(x) >> 52) & 0x7FF }
pub fn f64_mantissa(x: f64) -> u64 { return f64_bits(x) & 0xFFFFFFFFFFFFF }

pub fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ── Deterministic reductions (CJC-inspired numerics, serial tier) ─────────────
//
// The serial tiers of CJC's tiered reductions (§3.2 of the numerics research):
// `f64_sum` is the naive baseline; `f64_kahan_sum` is **Neumaier compensated**
// summation (tracks the low-order bits the running sum drops, robust whether the
// next term is larger or smaller than the sum); `f64_pairwise_sum` reduces with a
// fixed `len/2` split (a balanced tree → O(log n) error growth vs naive's O(n)).
//
// All three are *run-deterministic* (same input → bit-identical output, every run
// and platform — the locked FP flags guarantee no FMA/reassociation) and exact in
// codegen shape. They are **not yet chunk-count-independent**: that headline
// property is the binned superaccumulator, which needs fixed-size arrays for its
// 2048 stack-allocated bins — see CORE-STD-PHASE3.md / the numerics research §3.6.

// Naive left-to-right sum — the O(n)-error baseline the others improve on.
pub fn f64_sum(read s: []f64) -> f64 {
    var acc: f64 = 0.0
    for x in s { acc = acc + x }
    return acc
}

// Neumaier compensated sum: `c` accumulates the bits lost at each step, added back
// at the end. Recovers precision naive summation throws away (e.g. a tiny term
// added to a huge running sum), at ~4 flops/element and zero allocation.
pub fn f64_kahan_sum(read s: []f64) -> f64 {
    var sum: f64 = 0.0
    var c: f64 = 0.0
    for x in s {
        let t: f64 = sum + x
        if abs_f64(sum) >= abs_f64(x) {
            c = c + ((sum - t) + x)     // sum is larger → low bits of x are lost
        } else {
            c = c + ((x - t) + sum)     // x is larger → low bits of sum are lost
        }
        sum = t
    }
    return sum + c
}

// Sum `s[lo..hi]` by a fixed balanced split — the recursive core of pairwise sum.
// The split rule (`mid = lo + n/2`, leaves of ≤ 8) is fixed, so the reduction tree
// (and thus the result) is determined by the slice alone.
pub fn f64_pairwise_range(read s: []f64, lo: usize, hi: usize) -> f64 {
    let n: usize = hi - lo
    if n == 0 { return 0.0 }
    if n <= 8 {
        var acc: f64 = 0.0
        var i: usize = lo
        for i < hi {
            acc = acc + s[i]
            i = i + 1
        }
        return acc
    }
    let mid: usize = lo + n / 2
    return f64_pairwise_range(s, lo, mid) + f64_pairwise_range(s, mid, hi)
}

// Pairwise (cascade) sum: a balanced reduction tree, O(log n) error growth.
pub fn f64_pairwise_sum(read s: []f64) -> f64 {
    return f64_pairwise_range(s, 0, s.len)
}
