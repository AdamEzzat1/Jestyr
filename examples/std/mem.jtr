// std/mem.jtr — the explicit allocator interface (design §14, Phase 3).
//
// Every allocating API takes an `Allocator` *value*. The value is Zig's
// `std.mem.Allocator` shape: an opaque context pointer plus a vtable of thin
// function pointers (`alloc`/`free`/`destroy`). `allocate` dispatches through that
// vtable — a real first-class allocator, retiring the earlier enum stand-in. The
// strategy travels with the value; nothing is hidden behind a global.
//
//   • system  — malloc/free, frees per-allocation
//   • arena   — bump allocation from one buffer, reclaimed in bulk by `destroy`

// `Drop` lives here so std collections can free their buffers by RAII through the
// allocator they were built from. (A built-in/prelude `Drop` is future work.)
trait Drop { fn drop(mut self) }

// The size + alignment of an allocation request (Rust's `Layout`).
// `pub` fields: an allocator WRAPPER (`std/memprof`) is exactly the caller that has to
// read the requested size, and a `Layout` whose size is unreadable outside this module is
// not a layout, it is an opaque token. Making them public costs a reseed and nothing else
// -- no emission changes, because field visibility is a front-end rule.
pub struct Layout { pub size: usize, pub align: usize }

// `@copy`: an allocator is a cheap handle (a context pointer + thin fn-pointers),
// freely copied by value — so a collection may *store* one without it escaping.
@copy pub struct Allocator {
    ctx: *mut u8,
    alloc_fn: fn(*mut u8, Layout) -> *mut u8,
    free_fn: fn(*mut u8, *mut u8),
    destroy_fn: fn(*mut u8),
}

// --- the raw byte API (one path over any allocator) ---
pub fn alloc_bytes(read a: Allocator, n: usize) -> *mut u8 {
    return a.alloc_fn(a.ctx, Layout{ size: n, align: 8 })
}
pub fn free_bytes(read a: Allocator, p: *mut u8) { a.free_fn(a.ctx, p) }

// --- the typed API (what collections + user code call) ---

// Allocate `n` contiguous `T` from `a`. The strategy is whatever `a` carries.
pub fn allocate(comptime T: type, read a: Allocator, n: usize) -> *mut T {
    return alloc_bytes(a, n * size_of(T)) as *mut T
}

// Release one allocation (a no-op for the arena, which frees in bulk at `destroy`).
pub fn release(comptime T: type, read a: Allocator, p: *mut T) {
    free_bytes(a, p as *mut u8)
}

// Tear down an allocator, releasing any bulk-owned memory (the arena buffer).
pub fn destroy(read a: Allocator) { a.destroy_fn(a.ctx) }

// --- strategy 1: the system (malloc) allocator ---
fn sys_alloc(ctx: *mut u8, ly: Layout) -> *mut u8 { return alloc(u8, ly.size) }
fn sys_free(ctx: *mut u8, p: *mut u8) { free_ptr(p) }
fn sys_destroy(ctx: *mut u8) {}

pub fn system_allocator() -> Allocator {
    return Allocator{
        ctx: null,
        alloc_fn: &sys_alloc,
        free_fn: &sys_free,
        destroy_fn: &sys_destroy,
    }
}

// --- strategy 2: a bump arena (ctx = the arena handle) ---
fn ar_alloc(ctx: *mut u8, ly: Layout) -> *mut u8 { return arena_alloc(ctx, u8, ly.size) }
fn ar_free(ctx: *mut u8, p: *mut u8) {}
fn ar_destroy(ctx: *mut u8) { arena_close(ctx) }

pub fn arena_allocator(cap: usize) -> Allocator {
    return Allocator{
        ctx: arena_open(cap),
        alloc_fn: &ar_alloc,
        free_fn: &ar_free,
        destroy_fn: &ar_destroy,
    }
}
