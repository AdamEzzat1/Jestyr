// examples/std/parser.jtr — the P2 expression parser, written *in Jestyr*. It consumes
// the shared tokenizer (`tokens.tokenize`) in-process and builds an expression AST as an
// **arena** — a `List(ExprData)` addressed by integer ids — mirroring the Rust reference
// (`src/parser.rs`, `src/ast.rs`), which stores its AST as arena vectors indexed by
// `ExprId(u32)`. A node references its children by id, not by owned pointer, which dodges
// recursive-ownership questions and matches the reference 1:1 (what makes the AST-dump
// cross-check align).
//
// **Current coverage** (the Pratt precedence-climbing core, grown construct by construct):
// integer/float/name leaves; prefix unary (`-`/`!`/`not`/`~`/`&`); the full binary
// precedence table; `( … )` grouping; postfix `.field` / `[index]` / `.*` (deref) / `?`
// (try) / `(args)` (call); `as` casts (named + pointer types); assignment + compound
// assigns; ranges (`..` / `..=`); array literals (`[e…]` and `[v; n]`); struct literals
// (`Path{ … }`) and generic struct literals (`Ctor(T…){ … }`); `self` / `Self` (and
// `Self{ … }`); `@attr` callables; f-strings (`f"… {x} …"`); char/bool leaves; statements
// (`let`/`var`/`return`/expr) with `{ … }` blocks; the block-led `if`/`else`, `unsafe`, and
// `match` (with a full pattern parser — bindings, wildcards, variants, struct-variants,
// or-patterns, ranges, guards, rest). The type parser is still a minimal span-consumer, and
// the item layer is a later slice; the golden corpus is curated to the handled constructs.
//
// The parser state is a single `Parser` value threaded `mut` through the recursive
// descent — mirroring the reference, where `Ast` owns the arenas and `Parser` holds them.
// It bundles the token vector, the expression arena, a **call-arg arena** (`ar` — a
// `List(i32)` of `ExprId`s that a Call node slices, since a node can't hold a variable
// number of children), the cursor, and the nesting-depth guard.
//
// Verification: `dump` emits a canonical **flattened S-expression** — one atom per line
// (node kind + operator/aux + exact span + children in order) — a pure function of the
// arena. The Rust reference emits the identical stream via `Parser::parse_single_expr` +
// `ref_dump_expr`; `jestyr_parser_expr_dump_matches_reference` diffs them over the corpus.
// A `MAX_EXPR_DEPTH` guard bounds AST *height* so adversarial nesting errors (a bounded
// `Error` node) instead of overflowing the parser — or the recursive `dump` — stack
// (`jestyr_parser_bounds_deep_nesting`).
import "mem"
import "intern"
import "fs"
import "env"
import "list"
import "tokens"

// One arena node. `kind`: 0=Int 1=Float 2=Name 3=Unary 4=Binary 5=Field 6=Index 7=Deref
// 8=Try 9=Error 10=Call 11=Cast 12=Assign 13=Range 14=ArrayLit 15=ArrayRepeat 16=StructLit
// 17=GenStructLit 18=FieldInit 19=SelfValue 20=SelfType 21=Attr 22=FString 23=Block 24=If
// 25=Unsafe 26=Char 27=Bool 28=Match 29=Str 30=Null. `a`/`b` are child `ExprId`s: unary/postfix use `a` for the
// operand/base, binary uses `a`=lhs `b`=rhs, index uses `a`=base `b`=index, call/cast use
// `a`=callee/expr. `x`/`y` are auxiliary integers: Field stores its name's source span
// `(x, y)`; Call stores `(arg_start, arg_count)` into the arg arena; Cast stores its target
// type's `TypeId` in `x`; the variable-arity literals (Call/ArrayLit/StructLit/GenStructLit)
// store `(start, count)` slices into the arg arena. Unused aux fields are -1.
struct ExprData { kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32, x: i32, y: i32 }

// A binary-operator lookup: whether `k` is an infix operator, its left/right binding
// powers (precedence climbing), and its `BinOp` code. Mirrors `bin_op` in the reference.
struct BinInfo { ok: bool, lbp: i32, rbp: i32, code: i32 }

// One type arena node (`TypeId` = index into `ty`). `kind`: 0=Name 1=TypeKw 2=Ptr 3=Slice
// 4=Array 5=GenRef 6=RegionRef 7=App 8=Path 9=Fn 10=Dyn 11=Error.
//   Name/TypeKw/Error: span only. Dyn: `(x,y)`=trait-name span.
//   Ptr: `op`=mutbl (0=default,1=mut,2=const), `a`=inner. Slice/GenRef: `a`=inner.
//   Array: `a`=elem, `b`=len `ExprId`. RegionRef: `(x,y)`=region span, `a`=inner.
//   App `Ctor(args)`: `(x,y)`=ctor span, `(op,a)`=(arg_start, arg_count) of `TypeId`s in `tar`.
//   Path `mod.Type(args)`: `(x,y)`=module span, `(z,w)`=type-name span, `(op,a)`=arg slice.
//   Fn `fn(conv T,…) -> conv R`: `(op,a)`=(param_start, param_count) of (conv, `TypeId`) pairs
//     in `tar`; `b`=ret_conv; `x`=ret `TypeId` (-1 if none).
struct TypeData { kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32, x: i32, y: i32, z: i32, w: i32 }

// The whole parser state, threaded `mut` through the recursive descent:
//   toks  — the token vector (read-only input)
//   ex    — the expression arena (`ExprId` = index)
//   ar    — the call-arg arena: `ExprId`s a Call node slices via (arg_start, arg_count)
//   pos/n — the token cursor and count
//   depth — current AST height on the path from the root (bumped on every deepening
//           step, restored on unwind); `over` latches once the cap is exceeded.
// `no_struct` suppresses `Name { … }` struct-literal parsing (set inside a control-flow
// header so its `{` opens the body block, not a literal). Nothing sets it yet — control
// flow (`if`/`match`/`for`) is a later slice — so it stays false and struct literals always
// parse; it is threaded now so those headers only need to flip it.
// One statement arena node (`StmtId` = index into `st`). `kind`: 0=Let 1=Return 2=Expr.
//   Let:    `op`=mutbl (0=`let`, 1=`var`); `a`=init `ExprId` (-1 if none); `(x, y)`=the
//           variable name's source span; `ty`=the annotation's `TypeId` (-1 if no `: T`).
//           `start`/`end` = the whole statement span.
//   Return: `a`=value `ExprId` (-1 if bare). `start`/`end` = the statement span.
//   Expr:   `a`=the expression `ExprId`. (No own span — the dump uses the expr's.)
struct StmtData { kind: i32, start: usize, end: usize, op: i32, a: i32, x: i32, y: i32, ty: i32 }

// One pattern arena node (`PatId` = index into `pt`). `kind`: 0=Wildcard 1=Ident 2=Variant
// 3=StructVariant 4=Lit 5=Range 6=Or 7=Rest 8=Error.
//   Ident/Wildcard/Rest/Error: span only.
//   Variant `name(subpats)`: `(x, y)`=name span; `(op, a)`=(subpat_start, subpat_count) into
//     `par` (each entry a `PatId`).
//   StructVariant `name{ fields, .. }`: `(x, y)`=name span; `(op, a)`=(field_start,
//     field_count) into `par` (each field = 3 ints: fname_start, fname_end, subpat `PatId`);
//     `b`=has_rest (0/1).
//   Lit: `a`=the literal `ExprId`. Range: `a`=lo `ExprId`, `b`=hi `ExprId`, `op`=inclusive.
//   Or: `(op, a)`=(alt_start, alt_count) into `par` (each a `PatId`).
struct PatData { kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32, x: i32, y: i32 }

// One item arena node (`ItemId` = index into `it`). `kind`: 0=Import 1=Distinct 2=Const
// (fn/struct/enum/trait/impl/extern land in later slices). `is_pub` is the `pub` prefix.
//   Import: `(x,y)`=path inner span (quotes stripped), `(z,w)`=alias name span (z=-1 none),
//           `(a,b)`=pinned-hash inner span (a=-1 none).
//   Distinct: `(x,y)`=name span, `a`=base `TypeId`.
//   Const: `(x,y)`=name span, `a`=type `TypeId` (-1 none), `b`=value `ExprId`.
//   Fn: `(x,y)`=name span, `(a,b)`=(param_start, param_count) of 7-tuples in `iar`,
//       `op`=ret_conv, `z`=ret `TypeId` (-1 none), `w`=body Block `ExprId`.
// `(u,v)` = an optional leading-attribute slice `(attr_start, attr_count)` of 4-tuples in
// `aar` (Fn/Const/Struct only; -1 elsewhere). `(g,h)` = an optional generic-parameter slice
// `(gen_start, gen_count)` of 4-tuples in `gar` (Fn/Impl only; -1 elsewhere).
struct ItemData { kind: i32, start: usize, end: usize, is_pub: i32, op: i32, a: i32, b: i32, x: i32, y: i32, z: i32, w: i32, u: i32, v: i32, g: i32, h: i32, e: i32 }

// `st` is the statement arena; `sar` the statement-id child arena a Block slices. `pt` is
// the pattern arena; `par` a shared i32 child arena for pattern children (variant subpats,
// or-alternatives, struct-variant field triples) *and* match-arm triples (pat, guard, body).
// `ty` is the type arena; `tar` a type-child arena for App/Path type args and Fn (conv, ty)
// param pairs. `it` is the item arena; `iar` its i32 child arena (fn param 7-tuples); `mar`
// holds struct-member 6-tuples; `ear` holds enum sub-lists (type-param pairs, variant field
// 3-tuples, variant 5-tuples); `aar` holds attribute args + attribute 4-tuples; `gar` holds
// generic-param 4-tuples. All child arenas are buffered-then-appended so nested parses don't
// scatter an enclosing slice.
struct Parser { toks: List(tokens.Token), ex: List(ExprData), ar: List(i32), st: List(StmtData), sar: List(i32), pt: List(PatData), par: List(i32), ty: List(TypeData), tar: List(i32), it: List(ItemData), iar: List(i32), mar: List(i32), ear: List(i32), aar: List(i32), gar: List(i32), far: List(i32), alloc: Allocator, pos: usize, n: usize, depth: i32, over: bool, no_struct: bool }

// The result of parsing a `{ field, …, ..spread }` initializer body: the field-init nodes'
// slice into the arg arena, the optional spread expr (-1 if none), and the `}` end offset.
struct FieldsResult { field_start: i32, field_count: i32, spread: i32, endp: usize }

// ---- cursor helpers ----

// The kind of the current token, or 110 (Eof) past the end.
fn cur_kind(read p: Parser) -> i32 {
    if p.pos >= p.n { return 110 }
    let t: tokens.Token = list.get(tokens.Token, p.toks, p.pos)
    return t.kind
}
fn cur_tok(read p: Parser) -> tokens.Token {
    return list.get(tokens.Token, p.toks, p.pos)
}
fn bump(mut p: Parser) { p.pos = p.pos + 1 }

// The end offset of the previously consumed token (the reference's `prev_span().end`), used
// for a statement span that runs to its last token.
fn prev_end(read p: Parser) -> usize {
    if p.pos == 0 { let t: tokens.Token = list.get(tokens.Token, p.toks, 0)  return t.end }
    let t: tokens.Token = list.get(tokens.Token, p.toks, p.pos - 1)
    return t.end
}

// The deepest expression nesting the parser will build before bailing to an `Error` node,
// matching the reference's `MAX_EXPR_DEPTH`. Bounds AST *height* — so a left-deep fold
// (`1+1+…`) or postfix chain (`a.b.c.…`), which parse iteratively, still can't build a
// tree taller than this for a later recursive walk (or `dump`) to overflow on.
fn max_depth() -> i32 { return 256 }

// Record one more level of nesting; returns true while there is room, false once past the
// cap (latching `over`). Callers restore `depth` on the way out, so it measures the
// current root-to-node path and its peak is the tallest subtree parsed.
fn descend(mut p: Parser) -> bool {
    if p.over { return false }         // already past the cap: stay bailed so parsing
                                       // stops cleanly instead of churning the surplus
                                       // tokens (a postfix `(`/`[`/`.` run) into nodes.
    p.depth = p.depth + 1
    if p.depth > max_depth() { p.over = true  return false }
    return true
}

// ---- arena helpers ----

// Append a node and return its `ExprId` (its index in the arena). `x`/`y` default to -1;
// use `mk_field`/`mk_call`/`mk_cast` for nodes that carry aux data.
fn mk(mut p: Parser, kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: kind, start: start, end: end, op: op, a: a, b: b, x: 0 - 1, y: 0 - 1 })
    return id
}
// A Field node `base.name`: `a` is the base, `(x, y)` the name's source span.
fn mk_field(mut p: Parser, start: usize, end: usize, base: i32, name_start: usize, name_end: usize) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 5, start: start, end: end, op: 0, a: base, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// A Call node `callee(args)`: `a` is the callee, `(x, y)` = (arg_start, arg_count) into `ar`.
fn mk_call(mut p: Parser, start: usize, end: usize, callee: i32, arg_start: i32, arg_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 10, start: start, end: end, op: 0, a: callee, b: 0 - 1, x: arg_start, y: arg_count })
    return id
}
// A Cast node `expr as T`: `a` is the expr, `x` the target type's `TypeId`.
fn mk_cast(mut p: Parser, start: usize, end: usize, expr: i32, tyid: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 11, start: start, end: end, op: 0, a: expr, b: 0 - 1, x: tyid, y: 0 - 1 })
    return id
}
// An Assign node `target op= value`: `op` is the AssignOp code, `a`=target, `b`=value.
fn mk_assign(mut p: Parser, start: usize, end: usize, op: i32, target: i32, value: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 12, start: start, end: end, op: op, a: target, b: value, x: 0 - 1, y: 0 - 1 })
    return id
}
// A Range node `lo .. hi` / `lo ..= hi`: `op` is 1 when inclusive, `a`=lo, `b`=hi (either
// -1 for an absent bound).
fn mk_range(mut p: Parser, start: usize, end: usize, inclusive: i32, lo: i32, hi: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 13, start: start, end: end, op: inclusive, a: lo, b: hi, x: 0 - 1, y: 0 - 1 })
    return id
}
// An ArrayLit node `[e0, e1, …]`: `(x, y)` = (elem_start, elem_count) into the arg arena.
fn mk_arraylit(mut p: Parser, start: usize, end: usize, elem_start: i32, elem_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 14, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: elem_start, y: elem_count })
    return id
}
// An ArrayRepeat node `[value; count]`: `a`=value, `b`=count.
fn mk_arrayrepeat(mut p: Parser, start: usize, end: usize, value: i32, count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 15, start: start, end: end, op: 0, a: value, b: count, x: 0 - 1, y: 0 - 1 })
    return id
}
// A StructLit node `Path { fields, ..spread }`: `a`=path (a Name node), `b`=spread (-1 if
// none), `(x, y)` = (field_start, field_count) of FieldInit nodes in the arg arena.
fn mk_structlit(mut p: Parser, start: usize, end: usize, path: i32, spread: i32, field_start: i32, field_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 16, start: start, end: end, op: 0, a: path, b: spread, x: field_start, y: field_count })
    return id
}
// A GenStructLit node `Ctor(type_args){ fields }`: `a`=ctor (a Name node), `op`/`x` =
// (targ_start, targ_count) of the type-arg exprs in the arg arena, `b`/`y` = (field_start,
// field_count) of the FieldInit nodes. Unlike StructLit there is no spread.
fn mk_genstructlit(mut p: Parser, start: usize, end: usize, ctor: i32, targ_start: i32, targ_count: i32, field_start: i32, field_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 17, start: start, end: end, op: targ_start, a: ctor, b: field_start, x: targ_count, y: field_count })
    return id
}
// A FieldInit node `name: value`: `(x, y)` the name's source span, `a`=value. Stored as an
// ordinary arena node so a StructLit's field list is just a run of ExprIds in the arg arena.
fn mk_fieldinit(mut p: Parser, name_start: usize, name_end: usize, value: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 18, start: name_start, end: name_end, op: 0, a: value, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// An Attr node `@name`: `(x, y)` the name's source span (which attribute); node span runs
// from the `@` to the name's end. It is a primary — a call postfix `(…)` on top makes it a
// callable attribute like `@address(0x10)`.
fn mk_attr(mut p: Parser, start: usize, end: usize, name_start: usize, name_end: usize) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 21, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// A Block expression `{ stmts }` (kind 23): `(x, y)` = (stmt_start, stmt_count) into `sar`.
fn mk_block(mut p: Parser, start: usize, end: usize, stmt_start: i32, stmt_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 23, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: stmt_start, y: stmt_count })
    return id
}
// An `if` expression (kind 24): `a`=cond, `b`=then (a Block node), `op`=els (an `else`
// Block or a chained `if`, -1 if none). Span runs to the else's end (or the then's).
fn mk_if(mut p: Parser, start: usize, end: usize, cond: i32, then: i32, els: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 24, start: start, end: end, op: els, a: cond, b: then, x: 0 - 1, y: 0 - 1 })
    return id
}
// An `unsafe { … }` expression (kind 25): `a`=the Block node.
fn mk_unsafe(mut p: Parser, start: usize, end: usize, body: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 25, start: start, end: end, op: 0, a: body, b: 0 - 1, x: 0 - 1, y: 0 - 1 })
    return id
}
// A `match` expression (kind 28): `a`=scrutinee `ExprId`; `(x, y)`=(arm_start, arm_count)
// into `par`, each arm a triple (pat `PatId`, guard `ExprId` or -1, body `ExprId`).
fn mk_match(mut p: Parser, start: usize, end: usize, scrut: i32, arm_start: i32, arm_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 28, start: start, end: end, op: 0, a: scrut, b: 0 - 1, x: arm_start, y: arm_count })
    return id
}
// ---- pattern arena constructors ----
// A simple span-only pattern (Wildcard=0, Ident=1, Rest=7, Error=8).
fn mk_pat(mut p: Parser, kind: i32, start: usize, end: usize) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: kind, start: start, end: end, op: 0 - 1, a: 0 - 1, b: 0 - 1, x: 0 - 1, y: 0 - 1 })
    return id
}
// A Variant pattern `name(subpats)`: `(x,y)`=name span, `(op,a)`=(subpat_start, subpat_count).
fn mk_pat_variant(mut p: Parser, start: usize, end: usize, ns: usize, ne: usize, sub_start: i32, sub_count: i32) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: 2, start: start, end: end, op: sub_start, a: sub_count, b: 0 - 1, x: ns as i32, y: ne as i32 })
    return id
}
// A StructVariant pattern: `(x,y)`=name span, `(op,a)`=(field_start, field_count), `b`=has_rest.
fn mk_pat_struct(mut p: Parser, start: usize, end: usize, ns: usize, ne: usize, field_start: i32, field_count: i32, has_rest: i32) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: 3, start: start, end: end, op: field_start, a: field_count, b: has_rest, x: ns as i32, y: ne as i32 })
    return id
}
// A literal pattern: `a`=the literal ExprId.
fn mk_pat_lit(mut p: Parser, start: usize, end: usize, e: i32) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: 4, start: start, end: end, op: 0 - 1, a: e, b: 0 - 1, x: 0 - 1, y: 0 - 1 })
    return id
}
// A range pattern `lo..hi` / `lo..=hi`: `a`=lo ExprId, `b`=hi ExprId, `op`=inclusive.
fn mk_pat_range(mut p: Parser, start: usize, end: usize, inclusive: i32, lo: i32, hi: i32) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: 5, start: start, end: end, op: inclusive, a: lo, b: hi, x: 0 - 1, y: 0 - 1 })
    return id
}
// An or-pattern `a | b | …`: `(op,a)`=(alt_start, alt_count).
fn mk_pat_or(mut p: Parser, start: usize, end: usize, alt_start: i32, alt_count: i32) -> i32 {
    let id: i32 = list.len(PatData, p.pt) as i32
    list.push(PatData, p.pt, PatData{ kind: 6, start: start, end: end, op: alt_start, a: alt_count, b: 0 - 1, x: 0 - 1, y: 0 - 1 })
    return id
}
fn node_pat_start(read p: Parser, id: i32) -> usize {
    let d: PatData = list.get(PatData, p.pt, id as usize)
    return d.start
}
fn node_pat_end(read p: Parser, id: i32) -> usize {
    let d: PatData = list.get(PatData, p.pt, id as usize)
    return d.end
}

// ---- type arena constructors ----
// A span-only type node (Name=0, TypeKw=1, Error=11).
fn mk_ty(mut p: Parser, kind: i32, start: usize, end: usize) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: kind, start: start, end: end, op: 0 - 1, a: 0 - 1, b: 0 - 1, x: 0 - 1, y: 0 - 1, z: 0 - 1, w: 0 - 1 })
    return id
}
// A pointer type `*T` / `*mut T` / `*const T`: `op`=mutbl, `a`=inner.
fn mk_ty_ptr(mut p: Parser, start: usize, end: usize, mutbl: i32, inner: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 2, start: start, end: end, op: mutbl, a: inner, b: 0 - 1, x: 0 - 1, y: 0 - 1, z: 0 - 1, w: 0 - 1 })
    return id
}
// A single-inner type (Slice=3, GenRef=5): `a`=inner.
fn mk_ty_wrap(mut p: Parser, kind: i32, start: usize, end: usize, inner: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: kind, start: start, end: end, op: 0 - 1, a: inner, b: 0 - 1, x: 0 - 1, y: 0 - 1, z: 0 - 1, w: 0 - 1 })
    return id
}
// An array type `[N]T`: `a`=elem, `b`=len ExprId.
fn mk_ty_array(mut p: Parser, start: usize, end: usize, elem: i32, len: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 4, start: start, end: end, op: 0 - 1, a: elem, b: len, x: 0 - 1, y: 0 - 1, z: 0 - 1, w: 0 - 1 })
    return id
}
// A region reference `&[r]T`: `(x,y)`=region span, `a`=inner.
fn mk_ty_regionref(mut p: Parser, start: usize, end: usize, rs: usize, re: usize, inner: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 6, start: start, end: end, op: 0 - 1, a: inner, b: 0 - 1, x: rs as i32, y: re as i32, z: 0 - 1, w: 0 - 1 })
    return id
}
// A generic application `Ctor(args)`: `(x,y)`=ctor span, `(op,a)`=(arg_start, arg_count).
fn mk_ty_app(mut p: Parser, start: usize, end: usize, cs: usize, ce: usize, arg_start: i32, arg_count: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 7, start: start, end: end, op: arg_start, a: arg_count, b: 0 - 1, x: cs as i32, y: ce as i32, z: 0 - 1, w: 0 - 1 })
    return id
}
// A module-qualified path `mod.Type(args)`: `(x,y)`=module span, `(z,w)`=name span,
// `(op,a)`=(arg_start, arg_count).
fn mk_ty_path(mut p: Parser, start: usize, end: usize, ms: usize, me: usize, ns: usize, ne: usize, arg_start: i32, arg_count: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 8, start: start, end: end, op: arg_start, a: arg_count, b: 0 - 1, x: ms as i32, y: me as i32, z: ns as i32, w: ne as i32 })
    return id
}
// A function-pointer type `fn(conv T,…) -> conv R`: `(op,a)`=(param_start, param_count) of
// (conv, TypeId) pairs, `b`=ret_conv, `x`=ret TypeId (-1 if none).
fn mk_ty_fn(mut p: Parser, start: usize, end: usize, param_start: i32, param_count: i32, ret_conv: i32, ret: i32) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 9, start: start, end: end, op: param_start, a: param_count, b: ret_conv, x: ret, y: 0 - 1, z: 0 - 1, w: 0 - 1 })
    return id
}
// A `dyn Trait` type: `(x,y)`=trait-name span.
fn mk_ty_dyn(mut p: Parser, start: usize, end: usize, ns: usize, ne: usize) -> i32 {
    let id: i32 = list.len(TypeData, p.ty) as i32
    list.push(TypeData, p.ty, TypeData{ kind: 10, start: start, end: end, op: 0 - 1, a: 0 - 1, b: 0 - 1, x: ns as i32, y: ne as i32, z: 0 - 1, w: 0 - 1 })
    return id
}
fn node_ty_start(read p: Parser, id: i32) -> usize {
    let d: TypeData = list.get(TypeData, p.ty, id as usize)
    return d.start
}
fn node_ty_end(read p: Parser, id: i32) -> usize {
    let d: TypeData = list.get(TypeData, p.ty, id as usize)
    return d.end
}
// The passing convention on the current token (0=default 1=read 2=mut 3=take 4=out),
// consumed if present. Mirrors `parse_conv`.
fn parse_conv(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 54 { bump(p)  return 1 }               // read
    if k == 55 { bump(p)  return 2 }               // mut
    if k == 56 { bump(p)  return 3 }               // take
    if k == 57 { bump(p)  return 4 }               // out
    return 0
}

// ---- item arena constructors ----
// An `import` item: `(x,y)`=path span, `(z,w)`=alias span (z=-1 none), `(a,b)`=hash span.
fn mk_item_import(mut p: Parser, start: usize, end: usize, ps: usize, pe: usize, als: i32, ale: i32, hs: i32, he: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 0, start: start, end: end, is_pub: 0, op: 0 - 1, a: hs, b: he, x: ps as i32, y: pe as i32, z: als, w: ale, u: 0 - 1, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// A `distinct Name = Base` item: `(x,y)`=name span, `a`=base TypeId.
fn mk_item_distinct(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, base: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 1, start: start, end: end, is_pub: is_pub, op: 0 - 1, a: base, b: 0 - 1, x: ns as i32, y: ne as i32, z: 0 - 1, w: 0 - 1, u: 0 - 1, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// A `const Name [: T] = value` item: `(x,y)`=name span, `a`=type TypeId (-1 none), `b`=value.
fn mk_item_const(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, tyid: i32, value: i32, attr_start: i32, attr_count: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 2, start: start, end: end, is_pub: is_pub, op: 0 - 1, a: tyid, b: value, x: ns as i32, y: ne as i32, z: 0 - 1, w: 0 - 1, u: attr_start, v: attr_count, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// A `fn Name(params) [-> conv R] { … }` item: `(x,y)`=name span, `(a,b)`=(param_start,
// param_count) of 7-tuples in `iar`, `op`=ret_conv, `z`=ret TypeId (-1 none), `w`=body.
fn mk_item_fn(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, param_start: i32, param_count: i32, ret_conv: i32, ret_ty: i32, body: i32, attr_start: i32, attr_count: i32, gen_start: i32, gen_count: i32, e_start: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 3, start: start, end: end, is_pub: is_pub, op: ret_conv, a: param_start, b: param_count, x: ns as i32, y: ne as i32, z: ret_ty, w: body, u: attr_start, v: attr_count, g: gen_start, h: gen_count, e: e_start })
    return id
}
// A `struct`/`record`/`union Name { members }` item (kind 4): `op`=kind code (0=struct,
// 1=record, 2=union), `(x,y)`=name span, `(a,b)`=(member_start, member_count) of 6-tuples
// in `mar`.
fn mk_item_struct(mut p: Parser, start: usize, end: usize, is_pub: i32, kindcode: i32, ns: usize, ne: usize, mem_start: i32, mem_count: i32, attr_start: i32, attr_count: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 4, start: start, end: end, is_pub: is_pub, op: kindcode, a: mem_start, b: mem_count, x: ns as i32, y: ne as i32, z: 0 - 1, w: 0 - 1, u: attr_start, v: attr_count, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// An `enum Name(tparams) { variants }` item (kind 5): `(x,y)`=name span, `(op,a)`=(tparam_start,
// tparam_count) of name-span pairs in `ear`, `(b,z)`=(variant_start, variant_count) of variant
// 5-tuples in `ear`.
fn mk_item_enum(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, tparam_start: i32, tparam_count: i32, variant_start: i32, variant_count: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 5, start: start, end: end, is_pub: is_pub, op: tparam_start, a: tparam_count, b: variant_start, x: ns as i32, y: ne as i32, z: variant_count, w: 0 - 1, u: 0 - 1, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// A `trait Name { methods }` item (kind 6): `(x,y)`=name span, `(a,b)`=(method_start,
// method_count) of trait-method 7-tuples in `mar`.
fn mk_item_trait(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, method_start: i32, method_count: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 6, start: start, end: end, is_pub: is_pub, op: 0 - 1, a: method_start, b: method_count, x: ns as i32, y: ne as i32, z: 0 - 1, w: 0 - 1, u: 0 - 1, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// An `impl Trait for Type { methods }` item (kind 7): `(x,y)`=trait-name span, `a`=target
// `TypeId`, `(b,z)`=(method_start, method_count) of method fn-`ItemId`s in `mar`.
fn mk_item_impl(mut p: Parser, start: usize, end: usize, tns: usize, tne: usize, target: i32, method_start: i32, method_count: i32, gen_start: i32, gen_count: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 7, start: start, end: end, is_pub: 0, op: 0 - 1, a: target, b: method_start, x: tns as i32, y: tne as i32, z: method_count, w: 0 - 1, u: 0 - 1, v: 0 - 1, g: gen_start, h: gen_count, e: 0 - 1 })
    return id
}
// An `extern ["abi"] fn Name(params) [-> conv R]` item (kind 8): `(x,y)`=name span,
// `(a,b)`=(param_start, param_count) in `iar`, `op`=ret_conv, `z`=ret TypeId (-1 none). The
// abi string is consumed but not dumped (deferred, like fn generics) — extern-core.
fn mk_item_extern(mut p: Parser, start: usize, end: usize, is_pub: i32, ns: usize, ne: usize, param_start: i32, param_count: i32, ret_conv: i32, ret_ty: i32, abis: i32, abie: i32) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 8, start: start, end: end, is_pub: is_pub, op: ret_conv, a: param_start, b: param_count, x: ns as i32, y: ne as i32, z: ret_ty, w: abis, u: abie, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}
// An unrecognized item -> Error (kind 99), spanning the offending token.
fn mk_item_err(mut p: Parser, start: usize, end: usize) -> i32 {
    let id: i32 = list.len(ItemData, p.it) as i32
    list.push(ItemData, p.it, ItemData{ kind: 99, start: start, end: end, is_pub: 0, op: 0 - 1, a: 0 - 1, b: 0 - 1, x: 0 - 1, y: 0 - 1, z: 0 - 1, w: 0 - 1, u: 0 - 1, v: 0 - 1, g: 0 - 1, h: 0 - 1, e: 0 - 1 })
    return id
}

// A `let`/`var` statement: `op`=mutbl, `(x,y)`=name span, `ty`=type TypeId (-1 none),
// `a`=init ExprId (-1 none).
fn mk_let(mut p: Parser, start: usize, end: usize, mutbl: i32, ns: usize, ne: usize, tyid: i32, init: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 0, start: start, end: end, op: mutbl, a: init, x: ns as i32, y: ne as i32, ty: tyid })
    return id
}
// A `return [expr]` statement: `a`=value ExprId (-1 if bare).
fn mk_return(mut p: Parser, start: usize, end: usize, value: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 1, start: start, end: end, op: 0, a: value, x: 0 - 1, y: 0 - 1, ty: 0 - 1 })
    return id
}
// An expression statement: `a`=the expression (its own span drives the dump).
fn mk_exprstmt(mut p: Parser, e: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 2, start: 0, end: 0, op: 0, a: e, x: 0 - 1, y: 0 - 1, ty: 0 - 1 })
    return id
}
fn node_start(read p: Parser, id: i32) -> usize {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    return d.start
}
fn node_end(read p: Parser, id: i32) -> usize {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    return d.end
}
// An `Error` node spanning the current token (or empty at end of input) — the bounded
// result when the nesting guard fires.
fn err_here(mut p: Parser) -> i32 {
    if p.pos < p.n {
        let t: tokens.Token = cur_tok(p)
        return mk(p, 9, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    return mk(p, 9, 0, 0, 0, 0 - 1, 0 - 1)
}

// ---- operator table ----

// Classify an infix operator by token kind, returning its binding powers and `BinOp` code.
// The powers are exactly the reference's `bin_op` table: `or` < `and` < comparison < `|` <
// `^` < `&` < shifts < additive < multiplicative, each left-associative (`lbp` even,
// `rbp = lbp + 1`). BinOp codes: 1=add 2=sub 3=mul 4=div 5=rem 6=eq 7=ne 8=lt 9=le 10=gt
// 11=ge 12=and 13=or 14=bitand 15=bitor 16=bitxor 17=shl 18=shr.
fn bin_op(k: i32) -> BinInfo {
    if k == 50 { return BinInfo{ ok: true, lbp: 7, rbp: 8, code: 13 } }    // or
    if k == 49 { return BinInfo{ ok: true, lbp: 9, rbp: 10, code: 12 } }   // and
    if k == 85 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 6 } }   // ==
    if k == 86 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 7 } }   // !=
    if k == 87 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 8 } }   // <
    if k == 88 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 9 } }   // <=
    if k == 89 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 10 } }  // >
    if k == 90 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 11 } }  // >=
    if k == 93 { return BinInfo{ ok: true, lbp: 13, rbp: 14, code: 15 } }  // |  bitor
    if k == 95 { return BinInfo{ ok: true, lbp: 15, rbp: 16, code: 16 } }  // ^  bitxor
    if k == 91 { return BinInfo{ ok: true, lbp: 17, rbp: 18, code: 14 } }  // &  bitand
    if k == 97 { return BinInfo{ ok: true, lbp: 19, rbp: 20, code: 17 } }  // << shl
    if k == 98 { return BinInfo{ ok: true, lbp: 19, rbp: 20, code: 18 } }  // >> shr
    if k == 79 { return BinInfo{ ok: true, lbp: 21, rbp: 22, code: 1 } }   // +  add
    if k == 80 { return BinInfo{ ok: true, lbp: 21, rbp: 22, code: 2 } }   // -  sub
    if k == 81 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 3 } }   // *  mul
    if k == 82 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 4 } }   // /  div
    if k == 83 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 5 } }   // %  rem
    return BinInfo{ ok: false, lbp: 0, rbp: 0, code: 0 }
}

// The AssignOp code for a token, or 0 if it is not an assignment operator. Codes:
// 1=set(`=`) 2=add(`+=`) 3=sub(`-=`) 4=mul(`*=`) 5=div(`/=`) 6=rem(`%=`) 7=bitand(`&=`)
// 8=bitor(`|=`) 9=bitxor(`^=`). Mirrors `assign_op` in the reference.
fn assign_op(k: i32) -> i32 {
    if k == 84 { return 1 }    // =
    if k == 102 { return 2 }   // +=
    if k == 103 { return 3 }   // -=
    if k == 104 { return 4 }   // *=
    if k == 105 { return 5 }   // /=
    if k == 106 { return 6 }   // %=
    if k == 107 { return 7 }   // &=
    if k == 108 { return 8 }   // |=
    if k == 109 { return 9 }   // ^=
    return 0
}

// Can the current token begin an expression? Used to decide whether a range `lo..` has an
// upper bound. Mirrors `starts_expr` in the reference (the exact token set).
fn starts_expr(read p: Parser) -> bool {
    let k: i32 = cur_kind(p)
    if k == 1 { return true }    // Int
    if k == 2 { return true }    // Float
    if k == 3 { return true }    // Str
    if k == 5 { return true }    // Char
    if k == 58 { return true }   // true
    if k == 59 { return true }   // false
    if k == 60 { return true }   // null
    if k == 0 { return true }    // Ident
    if k == 6 { return true }    // _
    if k == 61 { return true }   // self
    if k == 62 { return true }   // Self
    if k == 63 { return true }   // (
    if k == 101 { return true }  // @
    if k == 22 { return true }   // if
    if k == 21 { return true }   // match
    if k == 38 { return true }   // unsafe
    if k == 65 { return true }   // {
    if k == 11 { return true }   // struct
    if k == 80 { return true }   // -
    if k == 51 { return true }   // not
    if k == 99 { return true }   // !
    if k == 96 { return true }   // ~
    if k == 91 { return true }   // &
    if k == 93 { return true }   // |
    if k == 94 { return true }   // ||
    return false
}

// ---- the Pratt parser (mirrors parse_primary / parse_cast / parse_postfix / parse_unary
//      / parse_binary in the reference) ----

// Parse a `{ name: value, …, ..spread }` initializer body (cur is `{`). Field-init nodes
// are buffered in a temp list, then appended contiguously to the arg arena (so a nested
// struct/call in a field value doesn't scatter the slice). A leading `..expr` is a
// functional-update spread and ends the list — but only when `allow_spread` (a plain
// `Path{ … }` literal); a generic-struct literal `Ctor(…){ … }` has no spread. Mirrors the
// body shared by `parse_struct_lit` / `parse_gen_struct_lit` in the reference.
fn parse_fields(mut p: Parser, allow_spread: bool) -> FieldsResult {
    bump(p)                                        // consume `{`
    var tmp: List(i32) = list.make(i32, p.alloc)
    var spread: i32 = 0 - 1
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if k == 74 and allow_spread {         // `..` -> spread (last element)
            bump(p)
            spread = parse_expr(p)
            more = false
        } else {
            let nt: tokens.Token = cur_tok(p)      // field name
            if cur_kind(p) == 0 { bump(p) }        // consume the name ident
            if cur_kind(p) == 71 { bump(p) }       // `:`
            let value: i32 = parse_expr(p)
            let fi: i32 = mk_fieldinit(p, nt.start, nt.end, value)
            list.push(i32, tmp, fi)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    var endp: usize = 0
    if cur_kind(p) == 66 {                          // `}`
        let rb: tokens.Token = cur_tok(p)
        endp = rb.end
        bump(p)
    }
    let field_start: i32 = list.len(i32, p.ar) as i32
    let field_count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.ar, list.get(i32, tmp, j))
        j = j + 1
    }
    return FieldsResult{ field_start: field_start, field_count: field_count, spread: spread, endp: endp }
}

// `Path { … }` — a struct literal. `path` is the already-built Name node, `start` its span
// start; the span runs to the closing `}`.
fn parse_struct_lit(mut p: Parser, path: i32, start: usize) -> i32 {
    let fr: FieldsResult = parse_fields(p, true)
    return mk_structlit(p, start, fr.endp, path, fr.spread, fr.field_start, fr.field_count)
}

// `Ctor(type_args) { fields }` — a generic struct literal (cur is `{`). `ctor` is the
// already-built Name node, `start` its span start; `(targ_start, targ_count)` is the slice
// of type-arg exprs already appended to the arg arena (they were parsed as the call's
// arguments, then reinterpreted here). No spread. Mirrors `parse_gen_struct_lit`.
fn parse_gen_struct_lit(mut p: Parser, ctor: i32, start: usize, targ_start: i32, targ_count: i32) -> i32 {
    let fr: FieldsResult = parse_fields(p, false)
    return mk_genstructlit(p, start, fr.endp, ctor, targ_start, targ_count, fr.field_start, fr.field_count)
}

// After a `(args)` postfix has been parsed onto callee `e` (its arg slice already in the
// arg arena as `(arg_start, argc)`, span `start..endp`), decide what it is: if a `{`
// follows, the callee is a bare `Name`, and struct literals aren't suppressed, the args are
// type arguments and this is a generic struct literal; otherwise it is a plain call.
fn finish_call_or_gsl(mut p: Parser, e: i32, start: usize, endp: usize, arg_start: i32, argc: i32) -> i32 {
    if cur_kind(p) == 65 {                          // `{`
        let ed: ExprData = list.get(ExprData, p.ex, e as usize)
        if ed.kind == 2 {                           // callee is a Name
            if !p.no_struct { return parse_gen_struct_lit(p, e, start, arg_start, argc) }
        }
    }
    return mk_call(p, start, endp, e, arg_start, argc)
}

// An f-string `f"… {x} …"` is a single lexer token; the FString node records just its
// source span `[start, end)` (kind 22). The literal parts and `{ident}` interpolations are
// re-derived from `src` at dump time (`dump_fstring`) rather than stored: the borrow checker
// forbids stashing `src` in the `Parser` struct, and the dump needs the *text* anyway (the
// reference's interpolation `Name` nodes all carry the whole f-string span, so a span-only
// dump couldn't distinguish `{x}` from `{y}`). A later slice (when interpolations must become
// real sub-expressions for typeck) will thread `src` through the parse chain and split here.
fn parse_fstring(mut p: Parser, start: usize, end: usize) -> i32 {
    return mk(p, 22, start, end, 0, 0 - 1, 0 - 1)
}

// A brace-delimited block `{ stmt … }` (cur is `{`) as a Block expression. Statements are
// buffered in a temp list then appended contiguously to `sar` (so a nested block's
// statements don't scatter this block's slice). `;` between statements is optional. Mirrors
// `parse_block` in the reference (which re-enables struct literals inside the body). The
// block's value, if any, is just its last statement being an expression — no separate tail.
fn parse_block(mut p: Parser) -> i32 {
    let lb: tokens.Token = cur_tok(p)
    let start: usize = lb.start
    bump(p)                                        // consume `{`
    let saved_ns: bool = p.no_struct
    p.no_struct = false                            // struct literals are fine inside a block
    var tmp: List(i32) = list.make(i32, p.alloc)
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else {
            let before: usize = p.pos
            let sid: i32 = parse_stmt(p)
            list.push(i32, tmp, sid)
            if cur_kind(p) == 70 { bump(p) }       // optional `;` separator
            if p.pos == before { bump(p) }         // guarantee progress on stuck input
        }
    }
    var endp: usize = start
    if cur_kind(p) == 66 {                          // `}`
        let rb: tokens.Token = cur_tok(p)
        endp = rb.end
        bump(p)
    }
    let stmt_start: i32 = list.len(i32, p.sar) as i32
    let stmt_count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.sar, list.get(i32, tmp, j))
        j = j + 1
    }
    p.no_struct = saved_ns
    return mk_block(p, start, endp, stmt_start, stmt_count)
}

// One statement: `let`/`var` binding, `return`, a block-led expression (block-only, so a
// trailing operator can't extend it — statement position), or a plain expression statement.
// Mirrors `parse_stmt` in the reference. Returns a `StmtId`.
fn parse_stmt(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 28 {                                   // return
        let rt: tokens.Token = cur_tok(p)
        let start: usize = rt.start
        bump(p)
        var value: i32 = 0 - 1
        let nk: i32 = cur_kind(p)
        if nk == 66 { value = 0 - 1 }              // `}` -> bare return
        else if nk == 70 { value = 0 - 1 }         // `;`
        else if nk == 110 { value = 0 - 1 }        // Eof
        else { value = parse_expr(p) }
        var endp: usize = rt.end
        if value >= 0 { endp = node_end(p, value) }
        return mk_return(p, start, endp, value)
    }
    if k == 8 or k == 9 {                          // let / var
        var mutbl: i32 = 0
        if k == 9 { mutbl = 1 }                    // `var` is mutable
        let lt: tokens.Token = cur_tok(p)
        let start: usize = lt.start
        bump(p)
        var ns: usize = start                      // the variable name's span
        var ne: usize = start
        if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
        var tyid: i32 = 0 - 1                       // optional `: T` type annotation
        if cur_kind(p) == 71 {                      // `:`
            bump(p)
            tyid = parse_type(p)
        }
        var init: i32 = 0 - 1                       // optional `= expr` initializer
        if cur_kind(p) == 84 { bump(p)  init = parse_expr(p) }   // `=`
        return mk_let(p, start, prev_end(p), mutbl, ns, ne, tyid, init)
    }
    // Block-led expressions in statement position parse *block-only* (no trailing operator).
    if k == 65 or k == 22 or k == 21 or k == 38 {  // `{` / `if` / `match` / `unsafe`
        let e: i32 = parse_block_like(p)
        return mk_exprstmt(p, e)
    }
    let e: i32 = parse_expr(p)
    return mk_exprstmt(p, e)
}

// Dispatch a block-led expression in statement position (block form only). For now just the
// bare block; `if`/`match`/`unsafe` are added with their parsers. Mirrors `parse_block_like`.
fn parse_block_like(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 22 { return parse_if(p) }                // `if`
    if k == 21 { return parse_match(p) }             // `match`
    if k == 38 { return parse_unsafe(p) }            // `unsafe`
    if k == 65 { return parse_block(p) }             // `{`
    return parse_expr(p)
}

// `if <cond> { … } [else { … } | else if …]`. The condition parses with `no_struct` set so
// a trailing `{` opens the then-block rather than a struct literal; `else if` chains by
// recursion and a plain `else` wraps its block as the `els` expression. Span runs to the
// else's end, or the then-block's when there is no else. Mirrors `parse_if`.
fn parse_if(mut p: Parser) -> i32 {
    let it: tokens.Token = cur_tok(p)
    let start: usize = it.start
    bump(p)                                          // consume `if`
    let saved_ns: bool = p.no_struct
    p.no_struct = true
    let cond: i32 = parse_expr(p)
    p.no_struct = saved_ns
    let then: i32 = parse_block(p)
    var els: i32 = 0 - 1
    if cur_kind(p) == 23 {                            // `else`
        bump(p)
        if cur_kind(p) == 22 { els = parse_if(p) }   // `else if …`
        else { els = parse_block(p) }                // `else { … }`
    }
    var endp: usize = node_end(p, then)
    if els >= 0 { endp = node_end(p, els) }
    return mk_if(p, start, endp, cond, then, els)
}

// `unsafe { … }` — an unsafe block. Span runs from `unsafe` to the block's `}`. Mirrors
// `parse_unsafe`.
fn parse_unsafe(mut p: Parser) -> i32 {
    let ut: tokens.Token = cur_tok(p)
    let start: usize = ut.start
    bump(p)                                          // consume `unsafe`
    let b: i32 = parse_block(p)
    return mk_unsafe(p, start, node_end(p, b), b)
}

// ---- the pattern parser (mirrors parse_pattern / parse_pattern_atom / parse_pat_lit) ----

// A scalar literal used inside a pattern (`0`, `-3`, `'a'`, `true`), returned as an ExprId
// (or -1 if the cursor isn't on a literal). Floats are intentionally excluded. `-x` becomes
// a Unary Neg over the inner literal. Mirrors `parse_pat_lit`.
fn parse_pat_lit(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 80 {                                   // Minus -> negative literal
        let mt: tokens.Token = cur_tok(p)
        bump(p)
        let rhs: i32 = parse_pat_lit(p)
        if rhs < 0 { return 0 - 1 }
        return mk(p, 3, mt.start, node_end(p, rhs), 1, rhs, 0 - 1)   // Unary, op=1 (neg)
    }
    if k == 1 {                                    // Int
        let t: tokens.Token = cur_tok(p)  bump(p)
        return mk(p, 0, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 5 {                                    // Char
        let t: tokens.Token = cur_tok(p)  bump(p)
        return mk(p, 26, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 58 {                                   // true
        let t: tokens.Token = cur_tok(p)  bump(p)
        return mk(p, 27, t.start, t.end, 1, 0 - 1, 0 - 1)
    }
    if k == 59 {                                   // false
        let t: tokens.Token = cur_tok(p)  bump(p)
        return mk(p, 27, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    return 0 - 1
}

// A variant pattern's positional subpattern list `name(subpats)` (cur is `(`). Subpatterns
// are buffered then appended to `par`.
fn parse_pat_variant(mut p: Parser, ns: usize, ne: usize) -> i32 {
    bump(p)                                        // consume `(`
    var tmp: List(i32) = list.make(i32, p.alloc)
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 64 { more = false }                // `)`
        else if k == 110 { more = false }          // Eof
        else {
            let sp: i32 = parse_pattern(p)
            list.push(i32, tmp, sp)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    var endp: usize = ne
    if cur_kind(p) == 64 { let rp: tokens.Token = cur_tok(p)  endp = rp.end  bump(p) }
    let sub_start: i32 = list.len(i32, p.par) as i32
    let count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.par, list.get(i32, tmp, j))
        j = j + 1
    }
    return mk_pat_variant(p, ns, endp, ns, ne, sub_start, count)
}

// A struct-variant pattern's field list `name{ f: p, g, .., }` (cur is `{`). Each field is a
// (fname_start, fname_end, subpat) triple; `{ r }` shorthand binds field `r` to an Ident
// pattern. A leading `..` sets has_rest and ends the list. Buffered then appended to `par`.
fn parse_pat_struct(mut p: Parser, ns: usize, ne: usize) -> i32 {
    bump(p)                                        // consume `{`
    var tmp: List(i32) = list.make(i32, p.alloc)   // triples
    var has_rest: i32 = 0
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if k == 74 { bump(p)  has_rest = 1  more = false }   // `..` rest
        else {
            let ft: tokens.Token = cur_tok(p)
            if cur_kind(p) == 0 { bump(p) }        // field name ident
            var subpat: i32 = 0 - 1
            if cur_kind(p) == 71 { bump(p)  subpat = parse_pattern(p) }   // `: pat`
            else { subpat = mk_pat(p, 1, ft.start, ft.end) }             // shorthand `{ r }`
            list.push(i32, tmp, ft.start as i32)
            list.push(i32, tmp, ft.end as i32)
            list.push(i32, tmp, subpat)
            if cur_kind(p) == 69 { bump(p) } else { more = false }        // `,`
        }
    }
    var endp: usize = ne
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let field_start: i32 = list.len(i32, p.par) as i32
    let field_count: i32 = (list.len(i32, tmp) / 3) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.par, list.get(i32, tmp, j))
        j = j + 1
    }
    return mk_pat_struct(p, ns, endp, ns, ne, field_start, field_count, has_rest)
}

// A single (non-`|`) pattern atom: `_`, an identifier binding / variant / struct-variant, a
// scalar literal or range, or the `..` rest. Mirrors `parse_pattern_atom`.
fn parse_pattern_atom(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    let tok: tokens.Token = cur_tok(p)
    if k == 6 { bump(p)  return mk_pat(p, 0, tok.start, tok.end) }   // `_` wildcard
    if k == 0 {                                    // Ident: binding / variant / struct-variant
        bump(p)
        if cur_kind(p) == 65 { return parse_pat_struct(p, tok.start, tok.end) }    // `{`
        if cur_kind(p) == 63 { return parse_pat_variant(p, tok.start, tok.end) }   // `(`
        return mk_pat(p, 1, tok.start, tok.end)    // a plain binding (or nullary variant)
    }
    if k == 1 or k == 5 or k == 58 or k == 59 or k == 80 {   // Int/Char/true/false/`-` literal
        let lo: i32 = parse_pat_lit(p)
        let lo_s: usize = node_start(p, lo)
        let lo_e: usize = node_end(p, lo)
        let rk: i32 = cur_kind(p)
        if rk == 74 or rk == 75 {                  // `..` / `..=` -> range pattern
            var inclusive: i32 = 0
            if rk == 75 { inclusive = 1 }
            bump(p)
            let hi: i32 = parse_pat_lit(p)
            if hi < 0 { return mk_pat(p, 8, lo_s, lo_e) }   // Error: no upper bound
            return mk_pat_range(p, lo_s, node_end(p, hi), inclusive, lo, hi)
        }
        return mk_pat_lit(p, lo_s, lo_e, lo)
    }
    if k == 74 { bump(p)  return mk_pat(p, 7, tok.start, tok.end) }   // `..` rest
    bump(p)
    return mk_pat(p, 8, tok.start, tok.end)        // Error over the offending token
}

// A full pattern, folding `|`-separated alternatives into an Or. Mirrors `parse_pattern`.
fn parse_pattern(mut p: Parser) -> i32 {
    let first: i32 = parse_pattern_atom(p)
    if cur_kind(p) != 93 { return first }          // no `|`
    let start: usize = node_pat_start(p, first)
    var tmp: List(i32) = list.make(i32, p.alloc)
    list.push(i32, tmp, first)
    for cur_kind(p) == 93 {                         // `|`
        bump(p)
        let alt: i32 = parse_pattern_atom(p)
        list.push(i32, tmp, alt)
    }
    let last: i32 = list.get(i32, tmp, list.len(i32, tmp) - 1)
    let endp: usize = node_pat_end(p, last)
    let alt_start: i32 = list.len(i32, p.par) as i32
    let count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.par, list.get(i32, tmp, j))
        j = j + 1
    }
    return mk_pat_or(p, start, endp, alt_start, count)
}

// `match <scrut> { <pat> [if <guard>] => <body>, … }`. The scrutinee parses with `no_struct`
// so its trailing `{` opens the match body, not a struct literal. Each arm's (pat, guard,
// body) triple is buffered then appended to `par`. Mirrors `parse_match`.
fn parse_match(mut p: Parser) -> i32 {
    let mt: tokens.Token = cur_tok(p)
    let start: usize = mt.start
    bump(p)                                        // consume `match`
    let saved_ns: bool = p.no_struct
    p.no_struct = true
    let scrut: i32 = parse_expr(p)
    p.no_struct = saved_ns
    if cur_kind(p) == 65 { bump(p) }               // `{`
    var tmp: List(i32) = list.make(i32, p.alloc)   // (pat, guard, body) triples
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else {
            let before: usize = p.pos
            let pat: i32 = parse_pattern(p)
            var guard: i32 = 0 - 1
            if cur_kind(p) == 22 { bump(p)  guard = parse_expr(p) }   // `if <guard>`
            if cur_kind(p) == 78 { bump(p) }       // `=>`
            let body: i32 = parse_expr(p)
            list.push(i32, tmp, pat)
            list.push(i32, tmp, guard)
            list.push(i32, tmp, body)
            if p.pos == before { bump(p) }          // guarantee progress
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,` between arms
        }
    }
    var endp: usize = start
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let arm_start: i32 = list.len(i32, p.par) as i32
    let arm_count: i32 = (list.len(i32, tmp) / 3) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.par, list.get(i32, tmp, j))
        j = j + 1
    }
    return mk_match(p, start, endp, scrut, arm_start, arm_count)
}

// ---- the item parser (mirrors parse_item / parse_import / parse_distinct / parse_const) ----

// `import "path" [as alias] [= "hash"]`. The path/hash inner spans (quotes stripped) are
// dumped as text; the alias is a name span. Mirrors `parse_import`.
fn parse_import(mut p: Parser) -> i32 {
    let imt: tokens.Token = cur_tok(p)
    let start: usize = imt.start
    bump(p)                                        // consume `import`
    var ps: usize = start  var pe: usize = start   // path inner span
    if cur_kind(p) == 3 { let st: tokens.Token = cur_tok(p)  ps = st.start + 1  pe = st.end - 1  bump(p) }
    var als: i32 = 0 - 1  var ale: i32 = 0 - 1     // alias name span
    if cur_kind(p) == 48 {                          // `as`
        bump(p)
        if cur_kind(p) == 0 { let at: tokens.Token = cur_tok(p)  als = at.start as i32  ale = at.end as i32  bump(p) }
    }
    var hs: i32 = 0 - 1  var he: i32 = 0 - 1       // pinned-hash inner span
    if cur_kind(p) == 84 {                          // `=`
        bump(p)
        if cur_kind(p) == 3 { let ht: tokens.Token = cur_tok(p)  hs = (ht.start + 1) as i32  he = (ht.end - 1) as i32  bump(p) }
    }
    return mk_item_import(p, start, prev_end(p), ps, pe, als, ale, hs, he)
}

// `distinct Name = BaseType` — a nominal wrapper. Mirrors `parse_distinct`.
fn parse_distinct(mut p: Parser, is_pub: i32) -> i32 {
    let dt: tokens.Token = cur_tok(p)
    let start: usize = dt.start
    bump(p)                                        // consume `distinct`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    if cur_kind(p) == 84 { bump(p) }               // `=`
    let base: i32 = parse_type(p)
    return mk_item_distinct(p, start, node_ty_end(p, base), is_pub, ns, ne, base)
}

// Parse a run of leading `@name` / `@name(args)` attributes into `aar` and return their
// `attr_start` (a slice of 4-tuples: name_start, name_end, arg_start, arg_count); the caller
// reads `attr_count = (len(aar) - attr_start) / 4`. Each attribute's arg `ExprId`s are appended
// to `aar` first, then the 4-tuples last. Mirrors `parse_attrs`.
fn parse_attrs(mut p: Parser) -> i32 {
    var at: List(i32) = list.make(i32, p.alloc)    // attr 4-tuples
    for cur_kind(p) == 101 {                        // `@`
        bump(p)                                    // `@`
        var ns: usize = 0  var ne: usize = 0
        if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
        var arg_start: i32 = list.len(i32, p.aar) as i32
        var arg_count: i32 = 0
        if cur_kind(p) == 63 {                      // `(args)`
            bump(p)
            var margs: List(i32) = list.make(i32, p.alloc)
            var more: bool = true
            for more {
                let k: i32 = cur_kind(p)
                if k == 64 { more = false }        // `)`
                else if k == 110 { more = false }  // Eof
                else {
                    let arg: i32 = parse_expr(p)
                    list.push(i32, margs, arg)
                    if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
                }
            }
            if cur_kind(p) == 64 { bump(p) }
            arg_start = list.len(i32, p.aar) as i32
            arg_count = list.len(i32, margs) as i32
            var m: usize = 0
            for m < list.len(i32, margs) { list.push(i32, p.aar, list.get(i32, margs, m))  m = m + 1 }
        }
        list.push(i32, at, ns as i32)
        list.push(i32, at, ne as i32)
        list.push(i32, at, arg_start)
        list.push(i32, at, arg_count)
    }
    let attr_start: i32 = list.len(i32, p.aar) as i32
    var j: usize = 0
    for j < list.len(i32, at) { list.push(i32, p.aar, list.get(i32, at, j))  j = j + 1 }
    return attr_start
}

// `const Name [: T] = value`. `attr_start`/`attr_count` are its leading attributes. Mirrors
// `parse_const`.
fn parse_const(mut p: Parser, is_pub: i32, attr_start: i32, attr_count: i32) -> i32 {
    let ct: tokens.Token = cur_tok(p)
    let start: usize = ct.start
    bump(p)                                        // consume `const`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    var tyid: i32 = 0 - 1
    if cur_kind(p) == 71 { bump(p)  tyid = parse_type(p) }   // `: T`
    if cur_kind(p) == 84 { bump(p) }               // `=`
    let value: i32 = parse_expr(p)
    return mk_item_const(p, start, node_end(p, value), is_pub, ns, ne, tyid, value, attr_start, attr_count)
}

// Parse a parameter list `p0, p1, …` (cur is the first param or `)`) directly into `iar` as
// 7-tuples (comptime, conv, name_start, name_end, is_self, ty|-1, refine|-1) and return their
// `param_start`; the caller reads `param_count = (len(iar) - start) / 7`. Direct-append is
// safe: a param's type/refine parse touches `ty`/`ex`, never `iar`, so the slice stays
// contiguous. Shared by `parse_fn`, trait methods, `impl` methods, and `extern`.
fn parse_params_into_iar(mut p: Parser) -> i32 {
    let param_start: i32 = list.len(i32, p.iar) as i32
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 64 { more = false }                // `)`
        else if k == 110 { more = false }          // Eof
        else {
            var comp: i32 = 0
            if cur_kind(p) == 31 { bump(p)  comp = 1 }       // `comptime`
            let conv: i32 = parse_conv(p)
            var is_self: i32 = 0
            var pns: usize = 0  var pne: usize = 0
            var pty: i32 = 0 - 1  var refine: i32 = 0 - 1
            if cur_kind(p) == 61 {                 // `self` receiver
                let st: tokens.Token = cur_tok(p)  pns = st.start  pne = st.end  is_self = 1  bump(p)
            } else {
                if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  pns = nt.start  pne = nt.end  bump(p) }
                if cur_kind(p) == 71 {             // `: T`
                    bump(p)
                    pty = parse_type(p)
                    if cur_kind(p) == 25 { bump(p)  refine = parse_expr(p) }   // `in <refine>`
                }
            }
            list.push(i32, p.iar, comp)
            list.push(i32, p.iar, conv)
            list.push(i32, p.iar, pns as i32)
            list.push(i32, p.iar, pne as i32)
            list.push(i32, p.iar, is_self)
            list.push(i32, p.iar, pty)
            list.push(i32, p.iar, refine)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    return param_start
}

// `fn Name(params) [-> conv R] { body }`. `attr_start`/`attr_count` are its leading attributes
// Optional bracket-form generics `[T: Add, U]` — each a name + optional `: Bound`. Appended
// to `gar` as 4-tuples (name span, bound span; bound_start=-1 if none); returns `gen_start`
// (caller reads `gen_count = (len(gar) - gen_start) / 4`). Mirrors `parse_generics`.
fn parse_generics(mut p: Parser) -> i32 {
    let gen_start: i32 = list.len(i32, p.gar) as i32
    if cur_kind(p) != 67 { return gen_start }      // no `[`
    bump(p)                                        // `[`
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 68 { more = false }                // `]`
        else if k == 110 { more = false }          // Eof
        else {
            var ns: usize = 0  var ne: usize = 0
            if cur_kind(p) == 0 { let t: tokens.Token = cur_tok(p)  ns = t.start  ne = t.end  bump(p) }
            var bs: i32 = 0 - 1  var be: i32 = 0 - 1
            if cur_kind(p) == 71 {                 // `: Bound`
                bump(p)
                if cur_kind(p) == 0 { let bt: tokens.Token = cur_tok(p)  bs = bt.start as i32  be = bt.end as i32  bump(p) }
            }
            list.push(i32, p.gar, ns as i32)
            list.push(i32, p.gar, ne as i32)
            list.push(i32, p.gar, bs)
            list.push(i32, p.gar, be)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    if cur_kind(p) == 68 { bump(p) }               // `]`
    return gen_start
}

// `fn Name[generics](params) [-> conv R] { body }`. `attr_start`/`attr_count` are its leading
// attributes. (Error sets `!{ … }` and `requires`/`ensures` contracts are later slices.)
// Mirrors `parse_fn`.
fn parse_fn(mut p: Parser, is_pub: i32, attr_start: i32, attr_count: i32) -> i32 {
    let ft: tokens.Token = cur_tok(p)
    let start: usize = ft.start
    bump(p)                                        // consume `fn`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    let gen_start: i32 = parse_generics(p)         // `[T: Add]`
    let gen_count: i32 = ((list.len(i32, p.gar) as i32) - gen_start) / 4
    if cur_kind(p) == 63 { bump(p) }               // `(`
    let param_start: i32 = parse_params_into_iar(p)
    let param_count: i32 = ((list.len(i32, p.iar) as i32) - param_start) / 7
    if cur_kind(p) == 64 { bump(p) }               // `)`
    var ret_conv: i32 = 0
    var ret_ty: i32 = 0 - 1
    if cur_kind(p) == 77 {                          // `-> conv R`
        bump(p)
        ret_conv = parse_conv(p)
        ret_ty = parse_type(p)
    }
    var errs: List(i32) = list.make(i32, p.alloc)   // error-set name spans (pairs)
    if cur_kind(p) == 99 {                           // `!{ Names }` error set
        bump(p)
        if cur_kind(p) == 65 { bump(p) }            // `{`
        var em: bool = true
        for em {
            let k: i32 = cur_kind(p)
            if k == 66 { em = false }               // `}`
            else if k == 110 { em = false }         // Eof
            else {
                if cur_kind(p) == 0 { let t: tokens.Token = cur_tok(p)  list.push(i32, errs, t.start as i32)  list.push(i32, errs, t.end as i32)  bump(p) }
                if cur_kind(p) == 69 { bump(p) } else { em = false }   // `,`
            }
        }
        if cur_kind(p) == 66 { bump(p) }            // `}`
    }
    var reqs: List(i32) = list.make(i32, p.alloc)   // `requires` exprids
    var enss: List(i32) = list.make(i32, p.alloc)   // `ensures` exprids
    var cm: bool = true
    for cm {
        let k: i32 = cur_kind(p)
        if k == 43 or k == 44 {                     // `requires` / `ensures`
            bump(p)
            let saved: bool = p.no_struct
            p.no_struct = true
            let c: i32 = parse_expr(p)
            p.no_struct = saved
            if k == 43 { list.push(i32, reqs, c) } else { list.push(i32, enss, c) }
        } else { cm = false }
    }
    let body: i32 = parse_block(p)
    // Write the extras block to `far`: err_count, err spans, req_count, req exprs, ens_count, ens exprs.
    let e_start: i32 = list.len(i32, p.far) as i32
    list.push(i32, p.far, (list.len(i32, errs) / 2) as i32)
    var ei: usize = 0
    for ei < list.len(i32, errs) { list.push(i32, p.far, list.get(i32, errs, ei))  ei = ei + 1 }
    list.push(i32, p.far, list.len(i32, reqs) as i32)
    var ri: usize = 0
    for ri < list.len(i32, reqs) { list.push(i32, p.far, list.get(i32, reqs, ri))  ri = ri + 1 }
    list.push(i32, p.far, list.len(i32, enss) as i32)
    var si: usize = 0
    for si < list.len(i32, enss) { list.push(i32, p.far, list.get(i32, enss, si))  si = si + 1 }
    return mk_item_fn(p, start, node_end(p, body), is_pub, ns, ne, param_start, param_count, ret_conv, ret_ty, body, attr_start, attr_count, gen_start, gen_count, e_start)
}

// `struct`/`record`/`union Name { members }`. `kindcode` is 0/1/2. A member is a method
// (`fn …`, reusing parse_fn) or a field `[pub] name : T [= default]`, buffered as a 6-tuple
// (tag, …) then appended to `mar`. (Field `@volatile` attrs and `: bits` widths are later
// slices — struct-core.) Mirrors `parse_named_struct` / `parse_struct_body`.
fn parse_struct(mut p: Parser, is_pub: i32, kindcode: i32, attr_start: i32, attr_count: i32) -> i32 {
    let kt: tokens.Token = cur_tok(p)
    let start: usize = kt.start
    bump(p)                                        // consume `struct`/`record`/`union`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    if cur_kind(p) == 65 { bump(p) }               // `{`
    var tmp: List(i32) = list.make(i32, p.alloc)   // member 6-tuples
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if cur_kind(p) == 7 or cur_kind(p) == 101 {   // `@`-led or bare `fn` -> a method
            let mattr_start: i32 = parse_attrs(p)  // `@inline fn …` method attributes
            let mattr_count: i32 = ((list.len(i32, p.aar) as i32) - mattr_start) / 4
            let fid: i32 = parse_fn(p, 0, mattr_start, mattr_count)
            list.push(i32, tmp, 1)                  // tag 1 = method
            list.push(i32, tmp, fid)
            var mp: i32 = 0
            for mp < 8 { list.push(i32, tmp, 0 - 1)  mp = mp + 1 }   // pad to a 10-tuple
        } else {                                    // `[pub] name : [@volatile] T [: bits] [= default]`
            var fpub: i32 = 0
            if cur_kind(p) == 42 { bump(p)  fpub = 1 }   // `pub`
            var fns: usize = start  var fne: usize = start
            if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  fns = nt.start  fne = nt.end  bump(p) }
            if cur_kind(p) == 71 { bump(p) }        // `:`
            let fattr_start: i32 = parse_attrs(p)   // field attributes (`@volatile`)
            let fattr_count: i32 = ((list.len(i32, p.aar) as i32) - fattr_start) / 4
            let fty: i32 = parse_type(p)
            var bs: i32 = 0 - 1  var be: i32 = 0 - 1
            if cur_kind(p) == 71 {                  // `: bits` bit-field width
                bump(p)
                if cur_kind(p) == 1 { let bt: tokens.Token = cur_tok(p)  bs = bt.start as i32  be = bt.end as i32  bump(p) }
            }
            var default: i32 = 0 - 1
            if cur_kind(p) == 84 { bump(p)  default = parse_expr(p) }   // `= default`
            list.push(i32, tmp, 0)                  // tag 0 = field
            list.push(i32, tmp, fpub)
            list.push(i32, tmp, fns as i32)
            list.push(i32, tmp, fne as i32)
            list.push(i32, tmp, fty)
            list.push(i32, tmp, default)
            list.push(i32, tmp, fattr_start)
            list.push(i32, tmp, fattr_count)
            list.push(i32, tmp, bs)
            list.push(i32, tmp, be)
            if cur_kind(p) == 69 { bump(p) }        // optional `,`
        }
    }
    var endp: usize = ne
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let mem_start: i32 = list.len(i32, p.mar) as i32
    let mem_count: i32 = (list.len(i32, tmp) / 10) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.mar, list.get(i32, tmp, j))
        j = j + 1
    }
    return mk_item_struct(p, start, endp, is_pub, kindcode, ns, ne, mem_start, mem_count, attr_start, attr_count)
}

// `enum Name(tparams) { V, W(f: T), X = 1, … }`. Optional generic `(T, E)` type params; each
// variant is a name, an optional named-field payload `(f: T, …)`, and an optional `= disc`
// discriminant. Type-params append to `ear` first; each variant's fields append as parsed;
// variant 5-tuples buffer then append last. Mirrors `parse_enum`.
fn parse_enum(mut p: Parser, is_pub: i32) -> i32 {
    let et: tokens.Token = cur_tok(p)
    let start: usize = et.start
    bump(p)                                        // consume `enum`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    var tpt: List(i32) = list.make(i32, p.alloc)   // type-param name-span pairs
    if cur_kind(p) == 63 {                          // `(` generic params
        bump(p)
        var m0: bool = true
        for m0 {
            let k: i32 = cur_kind(p)
            if k == 64 { m0 = false }              // `)`
            else if k == 110 { m0 = false }        // Eof
            else {
                if cur_kind(p) == 0 { let t: tokens.Token = cur_tok(p)  list.push(i32, tpt, t.start as i32)  list.push(i32, tpt, t.end as i32)  bump(p) }
                if cur_kind(p) == 69 { bump(p) } else { m0 = false }   // `,`
            }
        }
        if cur_kind(p) == 64 { bump(p) }
    }
    if cur_kind(p) == 65 { bump(p) }               // `{`
    let tparam_start: i32 = list.len(i32, p.ear) as i32
    let tparam_count: i32 = (list.len(i32, tpt) / 2) as i32
    var a0: usize = 0
    for a0 < list.len(i32, tpt) { list.push(i32, p.ear, list.get(i32, tpt, a0))  a0 = a0 + 1 }
    var vt: List(i32) = list.make(i32, p.alloc)    // variant 5-tuples
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else {
            var vns: usize = start  var vne: usize = start
            if cur_kind(p) == 0 { let vt2: tokens.Token = cur_tok(p)  vns = vt2.start  vne = vt2.end  bump(p) }
            var ft: List(i32) = list.make(i32, p.alloc)   // field 3-tuples (fname span, fty)
            if cur_kind(p) == 63 {                 // `(` named-field payload
                bump(p)
                var m2: bool = true
                for m2 {
                    let k2: i32 = cur_kind(p)
                    if k2 == 64 { m2 = false }     // `)`
                    else if k2 == 110 { m2 = false }
                    else {
                        var fns: usize = start  var fne: usize = start
                        if cur_kind(p) == 0 { let ftk: tokens.Token = cur_tok(p)  fns = ftk.start  fne = ftk.end  bump(p) }
                        if cur_kind(p) == 71 { bump(p) }   // `:`
                        let fty: i32 = parse_type(p)
                        list.push(i32, ft, fns as i32)
                        list.push(i32, ft, fne as i32)
                        list.push(i32, ft, fty)
                        if cur_kind(p) == 69 { bump(p) } else { m2 = false }
                    }
                }
                if cur_kind(p) == 64 { bump(p) }
            }
            var disc: i32 = 0 - 1
            if cur_kind(p) == 84 {                  // `= discriminant`
                bump(p)
                let saved: bool = p.no_struct
                p.no_struct = true
                disc = parse_expr(p)
                p.no_struct = saved
            }
            let field_start: i32 = list.len(i32, p.ear) as i32
            let field_count: i32 = (list.len(i32, ft) / 3) as i32
            var a1: usize = 0
            for a1 < list.len(i32, ft) { list.push(i32, p.ear, list.get(i32, ft, a1))  a1 = a1 + 1 }
            list.push(i32, vt, vns as i32)
            list.push(i32, vt, vne as i32)
            list.push(i32, vt, field_start)
            list.push(i32, vt, field_count)
            list.push(i32, vt, disc)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    var endp: usize = ne
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let variant_start: i32 = list.len(i32, p.ear) as i32
    let variant_count: i32 = (list.len(i32, vt) / 5) as i32
    var a2: usize = 0
    for a2 < list.len(i32, vt) { list.push(i32, p.ear, list.get(i32, vt, a2))  a2 = a2 + 1 }
    return mk_item_enum(p, start, endp, is_pub, ns, ne, tparam_start, tparam_count, variant_start, variant_count)
}

// `trait Name { fn m(self) -> T  fn n(self) { <default> } }`. Each method is a signature
// (name, params, ret) with an optional `{ … }` default body (else an optional `;`). Methods
// are buffered as 7-tuples (name span, param_start, param_count, ret_conv, ret_ty, body|-1)
// then appended to `mar`. Mirrors `parse_trait` / `parse_trait_method`.
fn parse_trait(mut p: Parser, is_pub: i32) -> i32 {
    let tt: tokens.Token = cur_tok(p)
    let start: usize = tt.start
    bump(p)                                        // consume `trait`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    if cur_kind(p) == 65 { bump(p) }               // `{`
    var mt: List(i32) = list.make(i32, p.alloc)    // trait-method 7-tuples
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if k == 7 {                            // `fn` -> a method signature
            bump(p)                                // `fn`
            var mns: usize = start  var mne: usize = start
            if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  mns = nt.start  mne = nt.end  bump(p) }
            if cur_kind(p) == 63 { bump(p) }       // `(`
            let param_start: i32 = parse_params_into_iar(p)
            let param_count: i32 = ((list.len(i32, p.iar) as i32) - param_start) / 7
            if cur_kind(p) == 64 { bump(p) }       // `)`
            var ret_conv: i32 = 0
            var ret_ty: i32 = 0 - 1
            if cur_kind(p) == 77 { bump(p)  ret_conv = parse_conv(p)  ret_ty = parse_type(p) }   // `-> conv R`
            var body: i32 = 0 - 1
            if cur_kind(p) == 65 { body = parse_block(p) }   // `{ default }`
            else if cur_kind(p) == 70 { bump(p) }            // optional `;`
            list.push(i32, mt, mns as i32)
            list.push(i32, mt, mne as i32)
            list.push(i32, mt, param_start)
            list.push(i32, mt, param_count)
            list.push(i32, mt, ret_conv)
            list.push(i32, mt, ret_ty)
            list.push(i32, mt, body)
        } else { bump(p) }                          // error recovery
    }
    var endp: usize = ne
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let method_start: i32 = list.len(i32, p.mar) as i32
    let method_count: i32 = (list.len(i32, mt) / 7) as i32
    var j: usize = 0
    for j < list.len(i32, mt) {
        list.push(i32, p.mar, list.get(i32, mt, j))
        j = j + 1
    }
    return mk_item_trait(p, start, endp, is_pub, ns, ne, method_start, method_count)
}

// `impl[generics] Trait for Type { fn m(self) { … } }`. Methods are full functions (reusing
// parse_fn); blanket generics `impl[T] …` come before the trait name. Method fn-ids buffer
// then append to `mar`. Mirrors `parse_impl`.
fn parse_impl(mut p: Parser) -> i32 {
    let it2: tokens.Token = cur_tok(p)
    let start: usize = it2.start
    bump(p)                                        // consume `impl`
    let gen_start: i32 = parse_generics(p)         // `[T]` blanket generics
    let gen_count: i32 = ((list.len(i32, p.gar) as i32) - gen_start) / 4
    var tns: usize = start  var tne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  tns = nt.start  tne = nt.end  bump(p) }
    if cur_kind(p) == 24 { bump(p) }               // `for`
    let target: i32 = parse_type(p)
    if cur_kind(p) == 65 { bump(p) }               // `{`
    var mt: List(i32) = list.make(i32, p.alloc)    // method fn-ids
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if k == 7 or k == 101 {                // `@`-led or bare `fn` method
            let mattr_start: i32 = parse_attrs(p)
            let mattr_count: i32 = ((list.len(i32, p.aar) as i32) - mattr_start) / 4
            let fid: i32 = parse_fn(p, 0, mattr_start, mattr_count)
            list.push(i32, mt, fid)
        }
        else { bump(p) }                            // error recovery
    }
    var endp: usize = tne
    if cur_kind(p) == 66 { let rb: tokens.Token = cur_tok(p)  endp = rb.end  bump(p) }
    let method_start: i32 = list.len(i32, p.mar) as i32
    let method_count: i32 = list.len(i32, mt) as i32
    var j: usize = 0
    for j < list.len(i32, mt) {
        list.push(i32, p.mar, list.get(i32, mt, j))
        j = j + 1
    }
    return mk_item_impl(p, start, endp, tns, tne, target, method_start, method_count, gen_start, gen_count)
}

// `extern ["abi"] fn Name(params) [-> conv R]` — a bodyless foreign declaration. The abi
// string's inner span is captured (defaults to text "c" when absent). Mirrors `parse_extern`.
fn parse_extern(mut p: Parser, is_pub: i32) -> i32 {
    let et: tokens.Token = cur_tok(p)
    let start: usize = et.start
    bump(p)                                        // consume `extern`
    var abis: i32 = 0 - 1  var abie: i32 = 0 - 1   // abi inner span (-1 => default "c")
    if cur_kind(p) == 3 { let at: tokens.Token = cur_tok(p)  abis = (at.start + 1) as i32  abie = (at.end - 1) as i32  bump(p) }
    if cur_kind(p) == 7 { bump(p) }                // `fn`
    var ns: usize = start  var ne: usize = start
    if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
    if cur_kind(p) == 63 { bump(p) }               // `(`
    let param_start: i32 = parse_params_into_iar(p)
    let param_count: i32 = ((list.len(i32, p.iar) as i32) - param_start) / 7
    if cur_kind(p) == 64 { bump(p) }               // `)`
    var ret_conv: i32 = 0
    var ret_ty: i32 = 0 - 1
    if cur_kind(p) == 77 { bump(p)  ret_conv = parse_conv(p)  ret_ty = parse_type(p) }   // `-> conv R`
    return mk_item_extern(p, start, prev_end(p), is_pub, ns, ne, param_start, param_count, ret_conv, ret_ty, abis, abie)
}

// Parse one top-level item: leading `@…` attributes, then an optional `pub`, then dispatch on
// the item keyword. Attributes are attached to `fn`/`const`/`struct` (the kinds that store
// them); other kinds parse+discard them (the reference validates/rejects — not modeled here).
// Mirrors `parse_item`.
fn parse_item(mut p: Parser) -> i32 {
    let attr_start: i32 = parse_attrs(p)
    let attr_count: i32 = ((list.len(i32, p.aar) as i32) - attr_start) / 4
    var is_pub: i32 = 0
    if cur_kind(p) == 42 { bump(p)  is_pub = 1 }   // `pub`
    let k: i32 = cur_kind(p)
    if k == 41 { return parse_import(p) }          // `import` (ignores pub)
    if k == 18 { return parse_distinct(p, is_pub) } // `distinct`
    if k == 10 { return parse_const(p, is_pub, attr_start, attr_count) }      // `const`
    if k == 7 { return parse_fn(p, is_pub, attr_start, attr_count) }          // `fn`
    if k == 11 { return parse_struct(p, is_pub, 0, attr_start, attr_count) }  // `struct`
    if k == 12 { return parse_struct(p, is_pub, 1, attr_start, attr_count) }  // `record`
    if k == 14 { return parse_struct(p, is_pub, 2, attr_start, attr_count) }  // `union`
    if k == 13 { return parse_enum(p, is_pub) }    // `enum`
    if k == 15 { return parse_trait(p, is_pub) }   // `trait`
    if k == 16 { return parse_impl(p) }            // `impl` (no pub)
    if k == 40 { return parse_extern(p, is_pub) }  // `extern`
    let t: tokens.Token = cur_tok(p)
    bump(p)                                        // unrecognized: error over one token
    return mk_item_err(p, t.start, t.end)
}

// A leaf or a parenthesized group. `( e )` returns the inner expression unchanged
// (grouping only, its own span). An unhandled token yields an `Error` node so the walk
// still terminates.
fn parse_primary(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 1 {                                    // Int
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 0, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 2 {                                    // Float
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 1, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 5 {                                    // Char literal
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 26, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 58 {                                   // `true`
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 27, t.start, t.end, 1, 0 - 1, 0 - 1)
    }
    if k == 59 {                                   // `false`
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 27, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 3 {                                    // string literal
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 29, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 60 {                                   // `null`
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 30, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 0 {                                    // Ident -> Name, or a struct literal
        let t: tokens.Token = cur_tok(p)
        bump(p)
        let nm: i32 = mk(p, 2, t.start, t.end, 0, 0 - 1, 0 - 1)
        if cur_kind(p) == 65 {                     // `{` -> `Path { … }` (unless suppressed)
            if !p.no_struct { return parse_struct_lit(p, nm, t.start) }
        }
        return nm
    }
    if k == 4 {                                    // f"…" -> FString
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return parse_fstring(p, t.start, t.end)
    }
    if k == 65 {                                   // `{` -> Block expression
        return parse_block(p)
    }
    if k == 22 {                                   // `if` -> If expression
        return parse_if(p)
    }
    if k == 21 {                                   // `match` -> Match expression
        return parse_match(p)
    }
    if k == 38 {                                   // `unsafe` -> Unsafe block
        return parse_unsafe(p)
    }
    if k == 61 {                                   // self -> SelfValue
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 19, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 62 {                                   // Self -> SelfType, or `Self { … }`
        let t: tokens.Token = cur_tok(p)
        bump(p)
        if cur_kind(p) == 65 {                     // `{` -> `Self { … }` (unless suppressed)
            if !p.no_struct {
                // The path is a Name node carrying the `Self` span (the reference uses a
                // synthetic `Self` Ident); parse_struct_lit dumps it identically.
                let nm: i32 = mk(p, 2, t.start, t.end, 0, 0 - 1, 0 - 1)
                return parse_struct_lit(p, nm, t.start)
            }
        }
        return mk(p, 20, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 101 {                                  // @name -> Attr (callable via postfix `(…)`)
        let at: tokens.Token = cur_tok(p)
        bump(p)
        if cur_kind(p) == 0 {                      // the attribute name
            let nt: tokens.Token = cur_tok(p)
            bump(p)
            return mk_attr(p, at.start, nt.end, nt.start, nt.end)
        }
        return mk_attr(p, at.start, at.end, at.end, at.end)   // missing name: empty at `@`.end
    }
    if k == 63 {                                   // '(' grouping
        bump(p)
        let inner: i32 = parse_expr(p)
        if cur_kind(p) == 64 { bump(p) }           // ')'
        return inner
    }
    if k == 67 {                                   // '[' array literal
        let lb: tokens.Token = cur_tok(p)
        bump(p)
        let first: i32 = parse_expr(p)
        if cur_kind(p) == 70 {                     // ';' -> `[value; count]` repeat
            bump(p)
            let count: i32 = parse_expr(p)
            var endr: usize = node_end(p, count)
            if cur_kind(p) == 68 {                 // ']'
                let rb: tokens.Token = cur_tok(p)
                endr = rb.end
                bump(p)
            }
            return mk_arrayrepeat(p, lb.start, endr, first, count)
        }
        // `[e0, e1, …]` list — buffer elements in a temp list (like a call) so nested
        // array/call pushes into `p.ar` don't scatter this literal's slice.
        var tmp: List(i32) = list.make(i32, p.alloc)
        list.push(i32, tmp, first)
        var more: bool = true
        for more {
            if cur_kind(p) == 69 {                 // ','
                bump(p)
                if cur_kind(p) == 68 { more = false }   // trailing comma
                else {
                    let el: i32 = parse_expr(p)
                    list.push(i32, tmp, el)
                }
            } else {
                more = false
            }
        }
        var endl: usize = node_end(p, first)
        if cur_kind(p) == 68 {                     // ']'
            let rb2: tokens.Token = cur_tok(p)
            endl = rb2.end
            bump(p)
        }
        let elem_start: i32 = list.len(i32, p.ar) as i32
        let elem_count: i32 = list.len(i32, tmp) as i32
        var j: usize = 0
        for j < list.len(i32, tmp) {
            list.push(i32, p.ar, list.get(i32, tmp, j))
            j = j + 1
        }
        return mk_arraylit(p, lb.start, endl, elem_start, elem_count)
    }
    if p.pos < p.n {
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 9, t.start, t.end, 0, 0 - 1, 0 - 1)   // Error over the offending token
    }
    return mk(p, 9, 0, 0, 0, 0 - 1, 0 - 1)
}

// Parse a type, building a structural `TypeData` node and returning its `TypeId`. Mirrors
// `parse_type`: pointers `*[mut|const]T`, `indirect T` (sugar for `*T`), the `type` keyword,
// slices `[]T`, arrays `[N]T`, references `&T` / `&[r]T`, module paths `mod.Type(args)`,
// applications `Ctor(args)`, `dyn Trait`, function pointers `fn(conv T,…) -> conv R`, and
// bare names (incl. `Self`). Type-arg / fn-param child lists are buffered then appended to
// `tar` so a nested type's own children don't scatter the slice.
fn parse_type(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    let tok: tokens.Token = cur_tok(p)
    let start: usize = tok.start
    if k == 81 {                                   // `*` -> pointer
        bump(p)
        var mutbl: i32 = 0
        if cur_kind(p) == 55 { bump(p)  mutbl = 1 }        // `mut`
        else if cur_kind(p) == 10 { bump(p)  mutbl = 2 }   // `const`
        let inner: i32 = parse_type(p)
        return mk_ty_ptr(p, start, node_ty_end(p, inner), mutbl, inner)
    }
    if k == 17 {                                   // the `type` keyword
        bump(p)
        return mk_ty(p, 1, tok.start, tok.end)
    }
    if k == 19 {                                   // `indirect T` -> sugar for `*T`
        bump(p)
        let inner: i32 = parse_type(p)
        return mk_ty_ptr(p, start, node_ty_end(p, inner), 0, inner)
    }
    if k == 67 {                                   // `[` -> slice `[]T` or array `[N]T`
        bump(p)
        if cur_kind(p) == 68 {                     // `]` -> slice
            bump(p)
            let inner: i32 = parse_type(p)
            return mk_ty_wrap(p, 3, start, node_ty_end(p, inner), inner)
        }
        let len: i32 = parse_expr(p)               // `[N]T`
        if cur_kind(p) == 68 { bump(p) }           // `]`
        let elem: i32 = parse_type(p)
        return mk_ty_array(p, start, node_ty_end(p, elem), elem, len)
    }
    if k == 91 {                                   // `&` -> reference `&T` / `&[r]T`
        bump(p)
        if cur_kind(p) == 67 {                     // `[r]` region tag
            bump(p)
            var rs: usize = start  var re: usize = start
            if cur_kind(p) == 0 { let rt: tokens.Token = cur_tok(p)  rs = rt.start  re = rt.end  bump(p) }
            if cur_kind(p) == 68 { bump(p) }       // `]`
            let inner: i32 = parse_type(p)
            return mk_ty_regionref(p, start, node_ty_end(p, inner), rs, re, inner)
        }
        let inner: i32 = parse_type(p)             // `&T`
        return mk_ty_wrap(p, 5, start, node_ty_end(p, inner), inner)
    }
    if k == 0 {                                    // Ident -> Name / App / Path
        bump(p)
        if cur_kind(p) == 73 {                     // `.` -> module path `mod.Type(args)`
            bump(p)
            var ns: usize = tok.end  var ne: usize = tok.end
            if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
            var arg_start: i32 = list.len(i32, p.tar) as i32
            var arg_count: i32 = 0
            if cur_kind(p) == 63 {                 // `(args)`
                arg_start = parse_type_args(p)
                arg_count = (list.len(i32, p.tar) as i32) - arg_start
            }
            return mk_ty_path(p, tok.start, prev_end(p), tok.start, tok.end, ns, ne, arg_start, arg_count)
        }
        if cur_kind(p) == 63 {                     // `(args)` -> application `Ctor(args)`
            let arg_start: i32 = parse_type_args(p)
            let arg_count: i32 = (list.len(i32, p.tar) as i32) - arg_start
            return mk_ty_app(p, tok.start, prev_end(p), tok.start, tok.end, arg_start, arg_count)
        }
        return mk_ty(p, 0, tok.start, tok.end)     // a bare Name
    }
    if k == 62 {                                   // `Self` -> a Name type
        bump(p)
        return mk_ty(p, 0, tok.start, tok.end)
    }
    if k == 52 {                                   // `dyn Trait`
        bump(p)
        var ns: usize = tok.end  var ne: usize = tok.end
        if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
        return mk_ty_dyn(p, start, prev_end(p), ns, ne)
    }
    if k == 7 {                                    // `fn(…) -> R` function-pointer type
        bump(p)
        if cur_kind(p) == 63 { bump(p) }           // `(`
        var tmp: List(i32) = list.make(i32, p.alloc)   // (conv, ty) pairs
        var more: bool = true
        for more {
            let pk: i32 = cur_kind(p)
            if pk == 64 { more = false }           // `)`
            else if pk == 110 { more = false }     // Eof
            else {
                let before: usize = p.pos
                let conv: i32 = parse_conv(p)
                let pty: i32 = parse_type(p)
                list.push(i32, tmp, conv)
                list.push(i32, tmp, pty)
                if p.pos == before { bump(p) }
                if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
            }
        }
        if cur_kind(p) == 64 { bump(p) }           // `)`
        var ret_conv: i32 = 0
        var ret: i32 = 0 - 1
        if cur_kind(p) == 77 {                      // `->`
            bump(p)
            ret_conv = parse_conv(p)
            ret = parse_type(p)
        }
        let param_start: i32 = list.len(i32, p.tar) as i32
        let param_count: i32 = (list.len(i32, tmp) / 2) as i32
        var j: usize = 0
        for j < list.len(i32, tmp) {
            list.push(i32, p.tar, list.get(i32, tmp, j))
            j = j + 1
        }
        return mk_ty_fn(p, start, prev_end(p), param_start, param_count, ret_conv, ret)
    }
    bump(p)                                        // unrecognized -> Error over one token
    return mk_ty(p, 11, tok.start, tok.end)
}

// Parse `(t0, t1, …)` type arguments (cur is `(`), append them contiguously to `tar`, and
// return their `arg_start`. The caller reads `arg_count = len(tar) - arg_start`. Args are
// buffered first so a nested App/Path/Fn's own args don't scatter this slice.
fn parse_type_args(mut p: Parser) -> i32 {
    bump(p)                                        // consume `(`
    var tmp: List(i32) = list.make(i32, p.alloc)
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 64 { more = false }                // `)`
        else if k == 110 { more = false }          // Eof
        else {
            let a: i32 = parse_type(p)
            list.push(i32, tmp, a)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    if cur_kind(p) == 64 { bump(p) }               // `)`
    let arg_start: i32 = list.len(i32, p.tar) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.tar, list.get(i32, tmp, j))
        j = j + 1
    }
    return arg_start
}

// Postfix chain: a primary followed by any run of `.field`, `[index]`, `.*` (deref), `?`
// (try), and `(args)` (call) — each wraps the previous expression as its base/callee,
// building a left-deep tree (so `a.b.c` is `field(field(a,b),c)`). The chain is bounded by
// `descend`. Spans mirror the reference: field = `base.start..name.end`, index/call =
// `base.start..].end`/`base.start..).end`, deref/try = `base.start..op.end`.
fn parse_postfix(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    var e: i32 = parse_primary(p)
    var go: bool = true
    for go {
        let k: i32 = cur_kind(p)
        if k == 73 {                               // '.'  -> Field
            if !descend(p) { go = false }
            else {
                bump(p)
                let nt: tokens.Token = cur_tok(p)       // the field-name ident
                if cur_kind(p) == 0 { bump(p) }         // consume the name if present
                let s: usize = node_start(p, e)
                e = mk_field(p, s, nt.end, e, nt.start, nt.end)
            }
        } else if k == 76 {                        // '.*' -> Deref
            if !descend(p) { go = false }
            else {
                let dt: tokens.Token = cur_tok(p)
                bump(p)
                let s: usize = node_start(p, e)
                e = mk(p, 7, s, dt.end, 0, e, 0 - 1)
            }
        } else if k == 100 {                       // '?'  -> Try
            if !descend(p) { go = false }
            else {
                let qt: tokens.Token = cur_tok(p)
                bump(p)
                let s: usize = node_start(p, e)
                e = mk(p, 8, s, qt.end, 0, e, 0 - 1)
            }
        } else if k == 67 {                        // '['  -> Index
            if !descend(p) { go = false }
            else {
                bump(p)
                let idx: i32 = parse_expr(p)
                var endp: usize = node_end(p, idx)
                if cur_kind(p) == 68 {                  // ']'
                    let rb: tokens.Token = cur_tok(p)
                    endp = rb.end
                    bump(p)
                }
                let s: usize = node_start(p, e)
                e = mk(p, 6, s, endp, 0, e, idx)
            }
        } else if k == 63 {                        // '('  -> Call
            if !descend(p) { go = false }
            else {
                bump(p)
                // Collect this call's argument ids in a per-call temp list, so a nested
                // call's pushes into `p.ar` (which happen *while* we parse an argument)
                // don't interleave with — and scatter — this call's arg block. After the
                // loop we append the temp contiguously, giving each call a clean slice.
                var tmp: List(i32) = list.make(i32, p.alloc)
                var more: bool = true
                for more {
                    let ak: i32 = cur_kind(p)
                    if ak == 64 { more = false }        // ')'
                    else if ak == 110 { more = false }  // Eof
                    else {
                        let arg: i32 = parse_expr(p)
                        list.push(i32, tmp, arg)
                        if cur_kind(p) == 69 { bump(p) }   // ',' -> another arg
                        else { more = false }
                    }
                }
                var endp: usize = node_end(p, e)
                if cur_kind(p) == 64 {                  // ')'
                    let rp: tokens.Token = cur_tok(p)
                    endp = rp.end
                    bump(p)
                }
                let arg_start: i32 = list.len(i32, p.ar) as i32
                let argc: i32 = list.len(i32, tmp) as i32
                var j: usize = 0
                for j < list.len(i32, tmp) {
                    list.push(i32, p.ar, list.get(i32, tmp, j))
                    j = j + 1
                }
                let s: usize = node_start(p, e)
                // A `{` after the `)` on a bare-Name callee re-reads the args as type args
                // (`Ctor(T…){ … }`); otherwise this is a plain call.
                e = finish_call_or_gsl(p, e, s, endp, arg_start, argc)
            }
        } else {
            go = false
        }
    }
    p.depth = saved
    return e
}

// `expr as T` — binds tighter than binary operators (`a + b as T` is `a + (b as T)`) and
// chains left (`x as A as B`). Span = expr.start .. type.end.
fn parse_cast(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    var e: i32 = parse_postfix(p)
    var go: bool = true
    for go {
        if cur_kind(p) == 48 {                     // 'as'
            if !descend(p) { go = false }
            else {
                bump(p)
                let tid: i32 = parse_type(p)
                let s: usize = node_start(p, e)
                e = mk_cast(p, s, node_ty_end(p, tid), e, tid)
            }
        } else {
            go = false
        }
    }
    p.depth = saved
    return e
}

// Prefix unary: `-` (neg), `!`/`not` (not), `~` (bitnot), `&` (ref). Right-recursive, so
// `- - x` nests (bounded by `descend`). UnOp codes: 1=neg 2=not 3=bitnot 4=ref. Span =
// op.start .. rhs.end. A non-prefix token falls through to the cast/postfix/primary layer.
fn parse_unary(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    var opc: i32 = 0
    if k == 80 { opc = 1 }                         // Minus -> neg
    else if k == 51 { opc = 2 }                    // not   -> not
    else if k == 99 { opc = 2 }                    // Bang  -> not
    else if k == 96 { opc = 3 }                    // Tilde -> bitnot
    else if k == 91 { opc = 4 }                    // Amp   -> ref (prefix position)
    if opc != 0 {
        let saved: i32 = p.depth
        if !descend(p) { p.depth = saved  return err_here(p) }
        let ct: tokens.Token = cur_tok(p)
        let st: usize = ct.start
        bump(p)
        let rhs: i32 = parse_unary(p)
        let e: usize = node_end(p, rhs)
        p.depth = saved
        return mk(p, 3, st, e, opc, rhs, 0 - 1)
    }
    return parse_cast(p)
}

// Precedence climbing. `min_bp` is the minimum left binding power that may extend the
// current left operand; an operator with `lbp < min_bp` stops this level. The left spine
// folds iteratively (so `1+1+…` is a loop, not deep recursion) while the right operand
// re-enters at `rbp` (left-associative). Span = lhs.start .. rhs.end. Bounded by `descend`
// at the entry (recursion) and per fold (left-spine height).
// Build a Range node once a `..`/`..=` has been seen (the op is still current). `lo` is
// the left operand; the upper bound is parsed at rbp=6 only if an expression follows (so
// `arr[i..]` leaves `hi` open). Span = lo.start .. (hi.end | lo.end). Mirrors the range
// arm of the reference `parse_binary`.
fn parse_range_tail(mut p: Parser, lo: i32, inclusive: i32) -> i32 {
    bump(p)                                         // consume `..` / `..=`
    var hi: i32 = 0 - 1
    var e: usize = node_end(p, lo)
    if starts_expr(p) {
        hi = parse_binary(p, 6)
        e = node_end(p, hi)
    }
    let s: usize = node_start(p, lo)
    return mk_range(p, s, e, inclusive, lo, hi)
}

fn parse_binary(mut p: Parser, min_bp: i32) -> i32 {
    let saved: i32 = p.depth
    if !descend(p) { p.depth = saved  return err_here(p) }
    var lhs: i32 = parse_unary(p)
    var go: bool = true
    for go {
        let k: i32 = cur_kind(p)
        if k == 74 {                               // '..'  -> exclusive Range (lbp 5, rbp 6)
            if 5 < min_bp { go = false }
            else if !descend(p) { go = false }
            else { lhs = parse_range_tail(p, lhs, 0) }
        } else if k == 75 {                        // '..=' -> inclusive Range
            if 5 < min_bp { go = false }
            else if !descend(p) { go = false }
            else { lhs = parse_range_tail(p, lhs, 1) }
        } else {
            let bi: BinInfo = bin_op(k)
            if !bi.ok {
                go = false
            } else if bi.lbp < min_bp {
                go = false
            } else if !descend(p) {
                go = false
            } else {
                bump(p)
                let rhs: i32 = parse_binary(p, bi.rbp)
                let s: usize = node_start(p, lhs)
                let e: usize = node_end(p, rhs)
                lhs = mk(p, 4, s, e, bi.code, lhs, rhs)
            }
        }
    }
    p.depth = saved
    return lhs
}

// The full expression entry: assignment is the outermost, lowest-precedence layer, and is
// right-associative (`a = b = c` is `a = (b = c)`). Everything else is a binary/unary/
// postfix/primary chain. Mirrors `parse_expr`/`parse_assignment` in the reference.
fn parse_expr(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    if !descend(p) { p.depth = saved  return err_here(p) }
    let lhs: i32 = parse_binary(p, 0)
    let ac: i32 = assign_op(cur_kind(p))
    if ac != 0 {
        bump(p)
        let value: i32 = parse_expr(p)             // right-associative
        let s: usize = node_start(p, lhs)
        let e: usize = node_end(p, value)
        p.depth = saved
        return mk_assign(p, s, e, ac, lhs, value)
    }
    p.depth = saved
    return lhs
}

// ---- the canonical AST dump (a pure function of the arena) ----

fn print_uint(x: usize) { print_int(x as i64) }

fn binop_label(code: i32) {
    if code == 1 { print_str("add") return }
    if code == 2 { print_str("sub") return }
    if code == 3 { print_str("mul") return }
    if code == 4 { print_str("div") return }
    if code == 5 { print_str("rem") return }
    if code == 6 { print_str("eq") return }
    if code == 7 { print_str("ne") return }
    if code == 8 { print_str("lt") return }
    if code == 9 { print_str("le") return }
    if code == 10 { print_str("gt") return }
    if code == 11 { print_str("ge") return }
    if code == 12 { print_str("and") return }
    if code == 13 { print_str("or") return }
    if code == 14 { print_str("bitand") return }
    if code == 15 { print_str("bitor") return }
    if code == 16 { print_str("bitxor") return }
    if code == 17 { print_str("shl") return }
    print_str("shr")   // 18
}
fn unop_label(code: i32) {
    if code == 1 { print_str("neg") return }
    if code == 2 { print_str("not") return }
    if code == 3 { print_str("bitnot") return }
    print_str("ref")   // 4
}
fn assign_label(code: i32) {
    if code == 1 { print_str("set") return }
    if code == 2 { print_str("add") return }
    if code == 3 { print_str("sub") return }
    if code == 4 { print_str("mul") return }
    if code == 5 { print_str("div") return }
    if code == 6 { print_str("rem") return }
    if code == 7 { print_str("bitand") return }
    if code == 8 { print_str("bitor") return }
    print_str("bitxor")   // 9
}

// Dump an optional child: the node if present, else a `(none)` marker (so a Range with an
// absent bound still has a fixed two-child shape).
fn dump_opt(read src: str, read p: Parser, id: i32) {
    if id < 0 { print_str("(") print_str("none") print_str(")") }
    else { dump(src, p, id) }
}

// Emit an f-string node's body atoms (the enclosing `dump` prints the surrounding parens):
// `fstring`, part count, expr count, the span, then every literal part's *text*, then every
// interpolation's *trimmed name text* — mirroring the reference, which stores `parts` as
// strings and interpolation `Name`s all sharing the whole f-string span (so text, not span,
// is the only form that distinguishes `{x}` from `{y}`). Body = `src[start+2 .. end-1]`
// (dropping `f"` and the closing `"`). Two passes over the body: parts, then names.
fn dump_fstring(read src: str, start: usize, end: usize) {
    var bstart: usize = start + 2
    var bend: usize = end - 1
    if start + 2 > end { bstart = end  bend = end }    // guard a malformed tiny token
    var ec: i32 = 0                                     // interpolation count = number of `{`
    var c: usize = bstart
    for c < bend {
        if (src[c] as i32) == 123 { ec = ec + 1 }
        c = c + 1
    }
    print_str("fstring") print_int((ec + 1) as i64) print_int(ec as i64) print_uint(start) print_uint(end)
    // parts pass: each maximal literal run, split at `{`, plus the trailing run.
    var pstart: usize = bstart
    var i: usize = bstart
    for i < bend {
        if (src[i] as i32) == 123 {
            print_str(src[pstart..i])
            var j: usize = i + 1
            for j < bend { if (src[j] as i32) == 125 { break }  j = j + 1 }
            if j < bend { i = j + 1 } else { i = bend }
            pstart = i
        } else { i = i + 1 }
    }
    print_str(src[pstart..bend])
    // names pass: the trimmed identifier inside each `{ … }`.
    var k: usize = bstart
    for k < bend {
        if (src[k] as i32) == 123 {
            var j2: usize = k + 1
            for j2 < bend { if (src[j2] as i32) == 125 { break }  j2 = j2 + 1 }
            var ns: usize = k + 1
            var ne: usize = j2
            for ns < ne {
                let a: i32 = src[ns] as i32
                if a == 32 { ns = ns + 1 } else if a == 9 { ns = ns + 1 } else if a == 10 { ns = ns + 1 } else if a == 13 { ns = ns + 1 } else { break }
            }
            for ne > ns {
                let b: i32 = src[ne - 1] as i32
                if b == 32 { ne = ne - 1 } else if b == 9 { ne = ne - 1 } else if b == 10 { ne = ne - 1 } else if b == 13 { ne = ne - 1 } else { break }
            }
            print_str(src[ns..ne])
            if j2 < bend { k = j2 + 1 } else { k = bend }
        } else { k = k + 1 }
    }
}

// Dump one type structurally. Names/`type`/errors carry a span; pointers/slices/refs recurse
// into their inner type; App/Path emit their name spans + arg count + each arg type; Fn emits
// each `(tyfnparam <conv> <ty>)` and an optional return type. Mirrors `ref_dump_type`.
fn dump_type(read src: str, read p: Parser, tid: i32) {
    let d: TypeData = list.get(TypeData, p.ty, tid as usize)
    print_str("(")
    if d.kind == 0 {
        print_str("tyname") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 1 {
        print_str("tykw") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 2 {
        print_str("typtr") print_int(d.op as i64) print_uint(d.start) print_uint(d.end)
        dump_type(src, p, d.a)
    } else if d.kind == 3 {
        print_str("tyslice") print_uint(d.start) print_uint(d.end)
        dump_type(src, p, d.a)
    } else if d.kind == 4 {
        print_str("tyarray") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.b)                          // the length expression
        dump_type(src, p, d.a)                     // the element type
    } else if d.kind == 5 {
        print_str("tygenref") print_uint(d.start) print_uint(d.end)
        dump_type(src, p, d.a)
    } else if d.kind == 6 {
        print_str("tyregionref") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump_type(src, p, d.a)
    } else if d.kind == 7 {
        print_str("tyapp") print_int(d.x as i64) print_int(d.y as i64) print_int(d.a as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let arg: i32 = list.get(i32, p.tar, (d.op + i) as usize)
            dump_type(src, p, arg)
            i = i + 1
        }
    } else if d.kind == 8 {
        print_str("typath") print_int(d.x as i64) print_int(d.y as i64) print_int(d.z as i64) print_int(d.w as i64) print_int(d.a as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let arg: i32 = list.get(i32, p.tar, (d.op + i) as usize)
            dump_type(src, p, arg)
            i = i + 1
        }
    } else if d.kind == 9 {
        print_str("tyfn") print_int(d.a as i64) print_int(d.b as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let base: i32 = d.op + i * 2
            let conv: i32 = list.get(i32, p.tar, base as usize)
            let pty: i32 = list.get(i32, p.tar, (base + 1) as usize)
            print_str("(") print_str("tyfnparam") print_int(conv as i64)
            dump_type(src, p, pty)
            print_str(")")
            i = i + 1
        }
        if d.x < 0 { print_str("(") print_str("none") print_str(")") }
        else { dump_type(src, p, d.x) }
    } else if d.kind == 10 {
        print_str("tydyn") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
    } else {
        print_str("tyerr") print_uint(d.start) print_uint(d.end)
    }
    print_str(")")
}

// Dump a parameter slice (the `param_count` 7-tuples at `iar[param_start…]`) as a run of
// `(param <comptime> <conv> <is_self> <name span> <ty-opt> <refine-opt>)`. Shared by the fn
// item and trait-method dumps.
fn dump_params(read src: str, read p: Parser, param_start: i32, param_count: i32) {
    var i: i32 = 0
    for i < param_count {
        let base: i32 = param_start + i * 7
        let comp: i32 = list.get(i32, p.iar, base as usize)
        let conv: i32 = list.get(i32, p.iar, (base + 1) as usize)
        let pns: i32 = list.get(i32, p.iar, (base + 2) as usize)
        let pne: i32 = list.get(i32, p.iar, (base + 3) as usize)
        let is_self: i32 = list.get(i32, p.iar, (base + 4) as usize)
        let pty: i32 = list.get(i32, p.iar, (base + 5) as usize)
        let refine: i32 = list.get(i32, p.iar, (base + 6) as usize)
        print_str("(") print_str("param") print_int(comp as i64) print_int(conv as i64) print_int(is_self as i64) print_int(pns as i64) print_int(pne as i64)
        if pty < 0 { print_str("(") print_str("none") print_str(")") } else { dump_type(src, p, pty) }
        if refine < 0 { print_str("(") print_str("none") print_str(")") } else { dump(src, p, refine) }
        print_str(")")
        i = i + 1
    }
}

// Is `src[s..e]` the literal `volatile`? (A field's `@volatile` attribute lowers to a bool in
// the reference; we recompute it from the field's attr slice at dump time.)
fn name_is_volatile(read src: str, s: usize, e: usize) -> bool {
    if e - s != 8 { return false }
    if (src[s] as i32) != 118 { return false }         // v
    if (src[s + 1] as i32) != 111 { return false }     // o
    if (src[s + 2] as i32) != 108 { return false }     // l
    if (src[s + 3] as i32) != 97 { return false }      // a
    if (src[s + 4] as i32) != 116 { return false }     // t
    if (src[s + 5] as i32) != 105 { return false }     // i
    if (src[s + 6] as i32) != 108 { return false }     // l
    if (src[s + 7] as i32) != 101 { return false }     // e
    return true
}
// Does the attribute slice `aar[attr_start…]` contain a `@volatile`? Mirrors the reference's
// `fattrs.iter().any(|a| a.name == "volatile")` field-level check.
fn attrs_has_volatile(read src: str, read p: Parser, attr_start: i32, attr_count: i32) -> i32 {
    var i: i32 = 0
    for i < attr_count {
        let base: i32 = attr_start + i * 4
        let ns: usize = list.get(i32, p.aar, base as usize) as usize
        let ne: usize = list.get(i32, p.aar, (base + 1) as usize) as usize
        if name_is_volatile(src, ns, ne) { return 1 }
        i = i + 1
    }
    return 0
}

// Dump a fn's "extras" block at `far[e…]`: the error-set names `<count> <(errname s e)>s`,
// then the `requires` exprs `<count> <expr>s`, then the `ensures` exprs `<count> <expr>s`.
fn dump_fn_extras(read src: str, read p: Parser, e: i32) {
    var idx: i32 = e
    let err_count: i32 = list.get(i32, p.far, idx as usize)
    idx = idx + 1
    print_int(err_count as i64)
    var i: i32 = 0
    for i < err_count {
        let s: i32 = list.get(i32, p.far, idx as usize)
        let en: i32 = list.get(i32, p.far, (idx + 1) as usize)
        print_str("(") print_str("errname") print_int(s as i64) print_int(en as i64) print_str(")")
        idx = idx + 2
        i = i + 1
    }
    let req_count: i32 = list.get(i32, p.far, idx as usize)
    idx = idx + 1
    print_int(req_count as i64)
    var j: i32 = 0
    for j < req_count { dump(src, p, list.get(i32, p.far, idx as usize))  idx = idx + 1  j = j + 1 }
    let ens_count: i32 = list.get(i32, p.far, idx as usize)
    idx = idx + 1
    print_int(ens_count as i64)
    var k: i32 = 0
    for k < ens_count { dump(src, p, list.get(i32, p.far, idx as usize))  idx = idx + 1  k = k + 1 }
}

// Dump a generic-parameter slice: the count, then each `(generic <name span> <bound-opt>)`.
fn dump_generics(read src: str, read p: Parser, gen_start: i32, gen_count: i32) {
    print_int(gen_count as i64)
    var i: i32 = 0
    for i < gen_count {
        let base: i32 = gen_start + i * 4
        let ns: i32 = list.get(i32, p.gar, base as usize)
        let ne: i32 = list.get(i32, p.gar, (base + 1) as usize)
        let bs: i32 = list.get(i32, p.gar, (base + 2) as usize)
        let be: i32 = list.get(i32, p.gar, (base + 3) as usize)
        print_str("(") print_str("generic") print_int(ns as i64) print_int(ne as i64)
        if bs < 0 { print_str("(") print_str("none") print_str(")") } else { print_str("(") print_str("bound") print_int(bs as i64) print_int(be as i64) print_str(")") }
        print_str(")")
        i = i + 1
    }
}

// Dump an attribute slice: the count, then each `(attr <name text> <argcount> <args…>)`. The
// name is sliced from src as text (the reference stores it as a `String`, not a span).
fn dump_attrs(read src: str, read p: Parser, attr_start: i32, attr_count: i32) {
    print_int(attr_count as i64)
    var i: i32 = 0
    for i < attr_count {
        let base: i32 = attr_start + i * 4
        let ns: usize = list.get(i32, p.aar, base as usize) as usize
        let ne: usize = list.get(i32, p.aar, (base + 1) as usize) as usize
        let arg_start: i32 = list.get(i32, p.aar, (base + 2) as usize)
        let arg_count: i32 = list.get(i32, p.aar, (base + 3) as usize)
        print_str("(") print_str("attr") print_str(src[ns..ne]) print_int(arg_count as i64)
        var j: i32 = 0
        for j < arg_count {
            let arg: i32 = list.get(i32, p.aar, (arg_start + j) as usize)
            dump(src, p, arg)
            j = j + 1
        }
        print_str(")")
        i = i + 1
    }
}

// Dump one top-level item. `import`: the path text, an alias name span or `(none)`, and a
// pinned-hash text or `(none)`. `distinct`: is_pub, name span, base type. `const`: is_pub,
// name span, an optional type, the value. Mirrors `ref_dump_item`.
fn dump_item(read src: str, read p: Parser, iid: i32) {
    let d: ItemData = list.get(ItemData, p.it, iid as usize)
    print_str("(")
    if d.kind == 0 {
        print_str("import")
        print_str("(") print_str("path") print_str(src[d.x as usize .. d.y as usize]) print_str(")")
        if d.z < 0 { print_str("(") print_str("none") print_str(")") }
        else { print_str("(") print_str("alias") print_int(d.z as i64) print_int(d.w as i64) print_str(")") }
        if d.a < 0 { print_str("(") print_str("none") print_str(")") }
        else { print_str("(") print_str("hash") print_str(src[d.a as usize .. d.b as usize]) print_str(")") }
    } else if d.kind == 1 {
        print_str("distinct") print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64)
        dump_type(src, p, d.a)
    } else if d.kind == 2 {
        print_str("const") dump_attrs(src, p, d.u, d.v) print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64)
        if d.a < 0 { print_str("(") print_str("none") print_str(")") }
        else { dump_type(src, p, d.a) }
        dump(src, p, d.b)
    } else if d.kind == 3 {
        // fn: is_pub, name span, param count, each `(param <comptime> <conv> <is_self>
        // <name span> <ty-opt> <refine-opt>)`, then ret_conv, ret-opt, and the body block.
        print_str("fn") dump_attrs(src, p, d.u, d.v) dump_generics(src, p, d.g, d.h) print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64) print_int(d.b as i64)
        dump_params(src, p, d.a, d.b)
        print_int(d.op as i64)                     // ret_conv
        if d.z < 0 { print_str("(") print_str("none") print_str(")") } else { dump_type(src, p, d.z) }
        dump_fn_extras(src, p, d.e)                 // error set + requires + ensures
        dump(src, p, d.w)                          // the body block
    } else if d.kind == 4 {
        // struct/record/union: kind code, is_pub, name span, member count, then each member —
        // a field `(sfield <is_pub> <name span> <type> <default-opt>)` or a method fn dump.
        print_str("struct") dump_attrs(src, p, d.u, d.v) print_int(d.op as i64) print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64) print_int(d.b as i64)
        var i: i32 = 0
        for i < d.b {
            let base: i32 = d.a + i * 10
            let tag: i32 = list.get(i32, p.mar, base as usize)
            if tag == 1 {
                let fid: i32 = list.get(i32, p.mar, (base + 1) as usize)
                dump_item(src, p, fid)
            } else {
                let fpub: i32 = list.get(i32, p.mar, (base + 1) as usize)
                let fns: i32 = list.get(i32, p.mar, (base + 2) as usize)
                let fne: i32 = list.get(i32, p.mar, (base + 3) as usize)
                let fty: i32 = list.get(i32, p.mar, (base + 4) as usize)
                let default: i32 = list.get(i32, p.mar, (base + 5) as usize)
                let fattr_start: i32 = list.get(i32, p.mar, (base + 6) as usize)
                let fattr_count: i32 = list.get(i32, p.mar, (base + 7) as usize)
                let bs: i32 = list.get(i32, p.mar, (base + 8) as usize)
                let be: i32 = list.get(i32, p.mar, (base + 9) as usize)
                print_str("(") print_str("sfield") print_int(fpub as i64) print_int(attrs_has_volatile(src, p, fattr_start, fattr_count) as i64) print_int(fns as i64) print_int(fne as i64)
                dump_type(src, p, fty)
                if bs < 0 { print_str("(") print_str("none") print_str(")") } else { print_str("(") print_str("bits") print_str(src[bs as usize .. be as usize]) print_str(")") }
                if default < 0 { print_str("(") print_str("none") print_str(")") } else { dump(src, p, default) }
                print_str(")")
            }
            i = i + 1
        }
    } else if d.kind == 5 {
        // enum: is_pub, name span, tparam count, `(tparam <span>)`s, variant count, then each
        // `(variant <name span> <fieldcount> <(vfield <fname span> <type>)>s <disc-opt>)`.
        print_str("enum") print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64) print_int(d.a as i64)
        var t: i32 = 0
        for t < d.a {
            let tb: i32 = d.op + t * 2
            print_str("(") print_str("tparam") print_int(list.get(i32, p.ear, tb as usize) as i64) print_int(list.get(i32, p.ear, (tb + 1) as usize) as i64) print_str(")")
            t = t + 1
        }
        print_int(d.z as i64)
        var v: i32 = 0
        for v < d.z {
            let vb: i32 = d.b + v * 5
            let vns: i32 = list.get(i32, p.ear, vb as usize)
            let vne: i32 = list.get(i32, p.ear, (vb + 1) as usize)
            let field_start: i32 = list.get(i32, p.ear, (vb + 2) as usize)
            let field_count: i32 = list.get(i32, p.ear, (vb + 3) as usize)
            let disc: i32 = list.get(i32, p.ear, (vb + 4) as usize)
            print_str("(") print_str("variant") print_int(vns as i64) print_int(vne as i64) print_int(field_count as i64)
            var f: i32 = 0
            for f < field_count {
                let fb: i32 = field_start + f * 3
                let fns: i32 = list.get(i32, p.ear, fb as usize)
                let fne: i32 = list.get(i32, p.ear, (fb + 1) as usize)
                let fty: i32 = list.get(i32, p.ear, (fb + 2) as usize)
                print_str("(") print_str("vfield") print_int(fns as i64) print_int(fne as i64)
                dump_type(src, p, fty)
                print_str(")")
                f = f + 1
            }
            if disc < 0 { print_str("(") print_str("none") print_str(")") } else { dump(src, p, disc) }
            print_str(")")
            v = v + 1
        }
    } else if d.kind == 6 {
        // trait: is_pub, name span, method count, then each `(tmethod <name span>
        // <paramcount> <(param …)>s <ret_conv> <ret-opt> <default-body-opt>)`.
        print_str("trait") print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64) print_int(d.b as i64)
        var m: i32 = 0
        for m < d.b {
            let mb: i32 = d.a + m * 7
            let mns: i32 = list.get(i32, p.mar, mb as usize)
            let mne: i32 = list.get(i32, p.mar, (mb + 1) as usize)
            let param_start: i32 = list.get(i32, p.mar, (mb + 2) as usize)
            let param_count: i32 = list.get(i32, p.mar, (mb + 3) as usize)
            let ret_conv: i32 = list.get(i32, p.mar, (mb + 4) as usize)
            let ret_ty: i32 = list.get(i32, p.mar, (mb + 5) as usize)
            let body: i32 = list.get(i32, p.mar, (mb + 6) as usize)
            print_str("(") print_str("tmethod") print_int(mns as i64) print_int(mne as i64) print_int(param_count as i64)
            dump_params(src, p, param_start, param_count)
            print_int(ret_conv as i64)
            if ret_ty < 0 { print_str("(") print_str("none") print_str(")") } else { dump_type(src, p, ret_ty) }
            if body < 0 { print_str("(") print_str("none") print_str(")") } else { dump(src, p, body) }
            print_str(")")
            m = m + 1
        }
    } else if d.kind == 7 {
        // impl: generics, trait-name span, target type, method count, then each method fn dump.
        print_str("impl") dump_generics(src, p, d.g, d.h) print_int(d.x as i64) print_int(d.y as i64)
        dump_type(src, p, d.a)
        print_int(d.z as i64)
        var m: i32 = 0
        for m < d.z {
            let fid: i32 = list.get(i32, p.mar, (d.b + m) as usize)
            dump_item(src, p, fid)
            m = m + 1
        }
    } else if d.kind == 8 {
        // extern: abi text (default "c"), is_pub, name span, param count, each `(param …)`,
        // ret_conv, ret-opt.
        print_str("extern")
        if d.w < 0 { print_str("c") } else { print_str(src[d.w as usize .. d.u as usize]) }
        print_int(d.is_pub as i64) print_int(d.x as i64) print_int(d.y as i64) print_int(d.b as i64)
        dump_params(src, p, d.a, d.b)
        print_int(d.op as i64)
        if d.z < 0 { print_str("(") print_str("none") print_str(")") } else { dump_type(src, p, d.z) }
    } else {
        print_str("itemerr") print_uint(d.start) print_uint(d.end)
    }
    print_str(")")
}

// Dump one statement. `let`: mutbl flag, name span, statement span, an optional structural
// type (or `(none)`), then the optional initializer. `return`: statement span then the
// optional value. `exprstmt`: just the wrapped expression. Mirrors `ref_dump_stmt`.
fn dump_stmt(read src: str, read p: Parser, sid: i32) {
    let s: StmtData = list.get(StmtData, p.st, sid as usize)
    print_str("(")
    if s.kind == 0 {
        print_str("let") print_int(s.op as i64) print_int(s.x as i64) print_int(s.y as i64) print_uint(s.start) print_uint(s.end)
        if s.ty < 0 { print_str("(") print_str("none") print_str(")") }
        else { dump_type(src, p, s.ty) }
        dump_opt(src, p, s.a)
    } else if s.kind == 1 {
        print_str("return") print_uint(s.start) print_uint(s.end)
        dump_opt(src, p, s.a)
    } else {
        print_str("exprstmt")
        dump(src, p, s.a)
    }
    print_str(")")
}

// Dump one pattern. Wildcard/Ident/Rest/Error carry just a span. Variant emits its name
// span, subpat count, node span, then each subpattern; StructVariant adds has_rest and emits
// each field as `(patfield <fname span> <subpat>)`. Lit/Range dump their literal `ExprId`s
// (via the expr `dump`); Or emits its alternative count then each alternative. Mirrors
// `ref_dump_pat` in the reference.
fn dump_pat(read src: str, read p: Parser, pid: i32) {
    let d: PatData = list.get(PatData, p.pt, pid as usize)
    print_str("(")
    if d.kind == 0 {
        print_str("patwild") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 1 {
        print_str("patident") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 2 {
        print_str("patvariant") print_int(d.x as i64) print_int(d.y as i64) print_int(d.a as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let sp: i32 = list.get(i32, p.par, (d.op + i) as usize)
            dump_pat(src, p, sp)
            i = i + 1
        }
    } else if d.kind == 3 {
        print_str("patstruct") print_int(d.x as i64) print_int(d.y as i64) print_int(d.b as i64) print_int(d.a as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let base: i32 = d.op + i * 3
            let fs: i32 = list.get(i32, p.par, base as usize)
            let fe: i32 = list.get(i32, p.par, (base + 1) as usize)
            let sub: i32 = list.get(i32, p.par, (base + 2) as usize)
            print_str("(") print_str("patfield") print_int(fs as i64) print_int(fe as i64)
            dump_pat(src, p, sub)
            print_str(")")
            i = i + 1
        }
    } else if d.kind == 4 {
        print_str("patlit")
        dump(src, p, d.a)
    } else if d.kind == 5 {
        print_str("patrange") print_int(d.op as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 6 {
        print_str("pator") print_int(d.a as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.a {
            let ap: i32 = list.get(i32, p.par, (d.op + i) as usize)
            dump_pat(src, p, ap)
            i = i + 1
        }
    } else if d.kind == 7 {
        print_str("patrest") print_uint(d.start) print_uint(d.end)
    } else {
        print_str("paterr") print_uint(d.start) print_uint(d.end)
    }
    print_str(")")
}

// Emit a flattened S-expression: `(`, the head atoms (kind label, operator/aux, start,
// end), then each child's dump in order, then `)` — one atom per line.
fn dump(read src: str, read p: Parser, id: i32) {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    print_str("(")
    if d.kind == 0 {
        print_str("int")   print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 1 {
        print_str("float") print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 2 {
        print_str("name")  print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 26 {
        print_str("char")  print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 27 {
        // Bool: `op` is 1 for `true`, 0 for `false`.
        print_str("bool")  print_int(d.op as i64) print_uint(d.start) print_uint(d.end)
    } else if d.kind == 29 {
        print_str("str")   print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 30 {
        print_str("null")  print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 3 {
        print_str("unary") unop_label(d.op)  print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 4 {
        print_str("binary") binop_label(d.op) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 5 {
        // Field: the name's source span (x, y) identifies which field, then the base.
        print_str("field") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 6 {
        print_str("index") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 7 {
        print_str("deref") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 8 {
        print_str("try") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 10 {
        // Call: arg count, then the callee, then each argument (from the arg arena).
        print_str("call") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        var i: i32 = 0
        for i < d.y {
            let argid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, argid)
            i = i + 1
        }
    } else if d.kind == 11 {
        // Cast: the operand, then the target type (structural, `x`=TypeId).
        print_str("cast") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump_type(src, p, d.x)
    } else if d.kind == 12 {
        print_str("assign") assign_label(d.op) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 13 {
        // Range: `op` is the inclusive flag (0/1); lo/hi are optional bounds.
        print_str("range") print_int(d.op as i64) print_uint(d.start) print_uint(d.end)
        dump_opt(src, p,d.a)
        dump_opt(src, p,d.b)
    } else if d.kind == 14 {
        // ArrayLit: element count, then each element (from the arg arena).
        print_str("array") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.y {
            let elid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, elid)
            i = i + 1
        }
    } else if d.kind == 15 {
        print_str("arrayrepeat") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 16 {
        // StructLit: field count, path (a Name node), optional spread, then each FieldInit.
        print_str("structlit") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump_opt(src, p,d.b)
        var i: i32 = 0
        for i < d.y {
            let fid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, fid)
            i = i + 1
        }
    } else if d.kind == 17 {
        // GenStructLit: type-arg count, field count, the ctor (a Name node), then each
        // type-arg expr (from the arg arena), then each FieldInit.
        print_str("genstructlit") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        var i: i32 = 0
        for i < d.x {
            let taid: i32 = list.get(i32, p.ar, (d.op + i) as usize)
            dump(src, p, taid)
            i = i + 1
        }
        var j: i32 = 0
        for j < d.y {
            let fid: i32 = list.get(i32, p.ar, (d.b + j) as usize)
            dump(src, p, fid)
            j = j + 1
        }
    } else if d.kind == 18 {
        // FieldInit: the name's source span (x, y), then the value.
        print_str("fieldinit") print_int(d.x as i64) print_int(d.y as i64)
        dump(src, p, d.a)
    } else if d.kind == 19 {
        print_str("selfval") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 20 {
        print_str("selftype") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 21 {
        // Attr: the name's source span (x, y) identifies which attribute, then the node span.
        print_str("attr") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
    } else if d.kind == 22 {
        // FString: re-scan the token span from src for its parts + interpolation names.
        dump_fstring(src, d.start, d.end)
    } else if d.kind == 23 {
        // Block: statement count, span, then each statement (from the statement-id arena).
        print_str("block") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.y {
            let sid: i32 = list.get(i32, p.sar, (d.x + i) as usize)
            dump_stmt(src, p, sid)
            i = i + 1
        }
    } else if d.kind == 24 {
        // If: the condition, the then-block, then the optional else (a Block or chained If).
        print_str("if") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
        dump_opt(src, p, d.op)
    } else if d.kind == 25 {
        // Unsafe: just its block.
        print_str("unsafe") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 28 {
        // Match: arm count, span, the scrutinee, then each arm as `(arm <pat> <guard-opt>
        // <body>)` (the arm triples live at the end of the pattern child arena).
        print_str("match") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        var i: i32 = 0
        for i < d.y {
            let base: i32 = d.x + i * 3
            let pat: i32 = list.get(i32, p.par, base as usize)
            let guard: i32 = list.get(i32, p.par, (base + 1) as usize)
            let body: i32 = list.get(i32, p.par, (base + 2) as usize)
            print_str("(") print_str("arm")
            dump_pat(src, p, pat)
            dump_opt(src, p, guard)
            dump(src, p, body)
            print_str(")")
            i = i + 1
        }
    } else {
        print_str("error") print_uint(d.start) print_uint(d.end)
    }
    print_str(")")
}

// Tokenize `src`, parse one expression, dump it.
fn parse_and_dump(read src: str, mut it: Interner, kwcount: i64, read a: Allocator) {
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let n: usize = list.len(tokens.Token, tk)
    var p: Parser = Parser{ toks: tk, ex: list.make(ExprData, a), ar: list.make(i32, a), st: list.make(StmtData, a), sar: list.make(i32, a), pt: list.make(PatData, a), par: list.make(i32, a), ty: list.make(TypeData, a), tar: list.make(i32, a), it: list.make(ItemData, a), iar: list.make(i32, a), mar: list.make(i32, a), ear: list.make(i32, a), aar: list.make(i32, a), gar: list.make(i32, a), far: list.make(i32, a), alloc: a, pos: 0, n: n, depth: 0, over: false, no_struct: false }
    let root: i32 = parse_expr(p)
    dump(src, p, root)
}

// Tokenize `src`, parse one top-level item, dump it (the item-mode golden entry).
fn parse_item_and_dump(read src: str, mut it: Interner, kwcount: i64, read a: Allocator) {
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let n: usize = list.len(tokens.Token, tk)
    var p: Parser = Parser{ toks: tk, ex: list.make(ExprData, a), ar: list.make(i32, a), st: list.make(StmtData, a), sar: list.make(i32, a), pt: list.make(PatData, a), par: list.make(i32, a), ty: list.make(TypeData, a), tar: list.make(i32, a), it: list.make(ItemData, a), iar: list.make(i32, a), mar: list.make(i32, a), ear: list.make(i32, a), aar: list.make(i32, a), gar: list.make(i32, a), far: list.make(i32, a), alloc: a, pos: 0, n: n, depth: 0, over: false, no_struct: false }
    let iid: i32 = parse_item(p)
    dump_item(src, p, iid)
}

// Tokenize `src`, parse every top-level item until Eof, dump the count then each item (the
// whole-corpus module golden entry). Mirrors the reference `parse_module`.
fn parse_module_and_dump(read src: str, mut it: Interner, kwcount: i64, read a: Allocator) {
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let n: usize = list.len(tokens.Token, tk)
    var p: Parser = Parser{ toks: tk, ex: list.make(ExprData, a), ar: list.make(i32, a), st: list.make(StmtData, a), sar: list.make(i32, a), pt: list.make(PatData, a), par: list.make(i32, a), ty: list.make(TypeData, a), tar: list.make(i32, a), it: list.make(ItemData, a), iar: list.make(i32, a), mar: list.make(i32, a), ear: list.make(i32, a), aar: list.make(i32, a), gar: list.make(i32, a), far: list.make(i32, a), alloc: a, pos: 0, n: n, depth: 0, over: false, no_struct: false }
    var ids: List(i32) = list.make(i32, a)
    for cur_kind(p) != 110 {                        // until Eof
        let before: usize = p.pos
        let iid: i32 = parse_item(p)
        list.push(i32, ids, iid)
        if p.pos == before { bump(p) }             // guarantee progress
    }
    print_int(list.len(i32, ids) as i64)
    var i: usize = 0
    for i < list.len(i32, ids) {
        dump_item(src, p, list.get(i32, ids, i))
        i = i + 1
    }
}

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(it)

    if env.argc() > 1 {
        var src: String = fs.read_text(env.argv(1))
        if env.argc() > 3 { parse_module_and_dump(string_view(src), it, kwcount, a) }  // module mode
        else if env.argc() > 2 { parse_item_and_dump(string_view(src), it, kwcount, a) }   // item mode
        else { parse_and_dump(string_view(src), it, kwcount, a) }
        string_free(src)
    } else {
        let sample: str = "Point{ x: 1, y: a + b, ..base }"
        parse_and_dump(sample, it, kwcount, a)
    }
    return 0
}
