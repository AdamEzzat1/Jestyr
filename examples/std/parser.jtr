// examples/std/parser.jtr — the P2 expression parser, written *in Jestyr*. It consumes
// the shared tokenizer (`tokens.tokenize`) in-process and builds an expression AST as an
// **arena** — a `List(ExprData)` addressed by integer ids — mirroring the Rust reference
// (`src/parser.rs`, `src/ast.rs`), which stores its AST as arena vectors indexed by
// `ExprId(u32)`. A node references its children by id, not by owned pointer, which dodges
// recursive-ownership questions and matches the reference 1:1 (what makes the AST-dump
// cross-check align).
//
// **Current coverage** (the Pratt precedence-climbing core, grown construct by construct):
// integer/float/name leaves; prefix unary (`-`/`!`/`not`/`~`/`&`); the full binary
// precedence table; `( … )` grouping; postfix `.field` / `[index]` / `.*` (deref) / `?`
// (try) / `(args)` (call); `as` casts (named + pointer types); assignment + compound
// assigns; ranges (`..` / `..=`); array literals (`[e…]` and `[v; n]`); struct literals
// (`Path{ … }`) and generic struct literals (`Ctor(T…){ … }`); `self` / `Self` (and
// `Self{ … }`); `@attr` callables; and f-strings (`f"… {x} …"`). Block-led forms
// (`if`/`match`/blocks) and the type/pattern/statement/item layers are later slices; the
// golden corpus is curated to the handled constructs and grows with the parser.
//
// The parser state is a single `Parser` value threaded `mut` through the recursive
// descent — mirroring the reference, where `Ast` owns the arenas and `Parser` holds them.
// It bundles the token vector, the expression arena, a **call-arg arena** (`ar` — a
// `List(i32)` of `ExprId`s that a Call node slices, since a node can't hold a variable
// number of children), the cursor, and the nesting-depth guard.
//
// Verification: `dump` emits a canonical **flattened S-expression** — one atom per line
// (node kind + operator/aux + exact span + children in order) — a pure function of the
// arena. The Rust reference emits the identical stream via `Parser::parse_single_expr` +
// `ref_dump_expr`; `jestyr_parser_expr_dump_matches_reference` diffs them over the corpus.
// A `MAX_EXPR_DEPTH` guard bounds AST *height* so adversarial nesting errors (a bounded
// `Error` node) instead of overflowing the parser — or the recursive `dump` — stack
// (`jestyr_parser_bounds_deep_nesting`).
import "mem"
import "intern"
import "fs"
import "env"
import "list"
import "tokens"

// One arena node. `kind`: 0=Int 1=Float 2=Name 3=Unary 4=Binary 5=Field 6=Index 7=Deref
// 8=Try 9=Error 10=Call 11=Cast 12=Assign 13=Range 14=ArrayLit 15=ArrayRepeat 16=StructLit
// 17=GenStructLit 18=FieldInit 19=SelfValue 20=SelfType 21=Attr 22=FString 23=Block 24=If
// 25=Unsafe. `a`/`b` are child `ExprId`s: unary/postfix use `a` for the
// operand/base, binary uses `a`=lhs `b`=rhs, index uses `a`=base `b`=index, call/cast use
// `a`=callee/expr. `x`/`y` are auxiliary integers: Field stores its name's source span
// `(x, y)`; Call stores `(arg_start, arg_count)` into the arg arena; Cast stores its
// type's source span `(x, y)`; the variable-arity literals (Call/ArrayLit/StructLit/
// GenStructLit) store `(start, count)` slices into the arg arena. Unused aux fields are -1.
struct ExprData { kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32, x: i32, y: i32 }

// A binary-operator lookup: whether `k` is an infix operator, its left/right binding
// powers (precedence climbing), and its `BinOp` code. Mirrors `bin_op` in the reference.
struct BinInfo { ok: bool, lbp: i32, rbp: i32, code: i32 }

// A parsed type's source span (this slice only needs the span, not a structural type
// node — the cast dump verifies the type by its `[start, end)` bytes).
struct TySpan { start: usize, end: usize }

// The whole parser state, threaded `mut` through the recursive descent:
//   toks  — the token vector (read-only input)
//   ex    — the expression arena (`ExprId` = index)
//   ar    — the call-arg arena: `ExprId`s a Call node slices via (arg_start, arg_count)
//   pos/n — the token cursor and count
//   depth — current AST height on the path from the root (bumped on every deepening
//           step, restored on unwind); `over` latches once the cap is exceeded.
// `no_struct` suppresses `Name { … }` struct-literal parsing (set inside a control-flow
// header so its `{` opens the body block, not a literal). Nothing sets it yet — control
// flow (`if`/`match`/`for`) is a later slice — so it stays false and struct literals always
// parse; it is threaded now so those headers only need to flip it.
// One statement arena node (`StmtId` = index into `st`). `kind`: 0=Let 1=Return 2=Expr.
//   Let:    `op`=mutbl (0=`let`, 1=`var`); `a`=init `ExprId` (-1 if none); `(x, y)`=the
//           variable name's source span; `(ts, te)`=the type annotation's source span
//           (`ts`=-1 when there is no `: T`). `start`/`end` = the whole statement span.
//   Return: `a`=value `ExprId` (-1 if bare). `start`/`end` = the statement span.
//   Expr:   `a`=the expression `ExprId`. (No own span — the dump uses the expr's.)
struct StmtData { kind: i32, start: usize, end: usize, op: i32, a: i32, x: i32, y: i32, ts: i32, te: i32 }

// `st` is the statement arena; `sar` is the statement-id child arena a Block node slices
// via `(stmt_start, stmt_count)` (buffered-then-appended like `ar`, so a nested block's
// statements don't scatter the enclosing block's slice).
struct Parser { toks: List(tokens.Token), ex: List(ExprData), ar: List(i32), st: List(StmtData), sar: List(i32), alloc: Allocator, pos: usize, n: usize, depth: i32, over: bool, no_struct: bool }

// The result of parsing a `{ field, …, ..spread }` initializer body: the field-init nodes'
// slice into the arg arena, the optional spread expr (-1 if none), and the `}` end offset.
struct FieldsResult { field_start: i32, field_count: i32, spread: i32, endp: usize }

// ---- cursor helpers ----

// The kind of the current token, or 110 (Eof) past the end.
fn cur_kind(read p: Parser) -> i32 {
    if p.pos >= p.n { return 110 }
    let t: tokens.Token = list.get(tokens.Token, p.toks, p.pos)
    return t.kind
}
fn cur_tok(read p: Parser) -> tokens.Token {
    return list.get(tokens.Token, p.toks, p.pos)
}
fn bump(mut p: Parser) { p.pos = p.pos + 1 }

// The end offset of the previously consumed token (the reference's `prev_span().end`), used
// for a statement span that runs to its last token.
fn prev_end(read p: Parser) -> usize {
    if p.pos == 0 { let t: tokens.Token = list.get(tokens.Token, p.toks, 0)  return t.end }
    let t: tokens.Token = list.get(tokens.Token, p.toks, p.pos - 1)
    return t.end
}

// The deepest expression nesting the parser will build before bailing to an `Error` node,
// matching the reference's `MAX_EXPR_DEPTH`. Bounds AST *height* — so a left-deep fold
// (`1+1+…`) or postfix chain (`a.b.c.…`), which parse iteratively, still can't build a
// tree taller than this for a later recursive walk (or `dump`) to overflow on.
fn max_depth() -> i32 { return 256 }

// Record one more level of nesting; returns true while there is room, false once past the
// cap (latching `over`). Callers restore `depth` on the way out, so it measures the
// current root-to-node path and its peak is the tallest subtree parsed.
fn descend(mut p: Parser) -> bool {
    if p.over { return false }         // already past the cap: stay bailed so parsing
                                       // stops cleanly instead of churning the surplus
                                       // tokens (a postfix `(`/`[`/`.` run) into nodes.
    p.depth = p.depth + 1
    if p.depth > max_depth() { p.over = true  return false }
    return true
}

// ---- arena helpers ----

// Append a node and return its `ExprId` (its index in the arena). `x`/`y` default to -1;
// use `mk_field`/`mk_call`/`mk_cast` for nodes that carry aux data.
fn mk(mut p: Parser, kind: i32, start: usize, end: usize, op: i32, a: i32, b: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: kind, start: start, end: end, op: op, a: a, b: b, x: 0 - 1, y: 0 - 1 })
    return id
}
// A Field node `base.name`: `a` is the base, `(x, y)` the name's source span.
fn mk_field(mut p: Parser, start: usize, end: usize, base: i32, name_start: usize, name_end: usize) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 5, start: start, end: end, op: 0, a: base, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// A Call node `callee(args)`: `a` is the callee, `(x, y)` = (arg_start, arg_count) into `ar`.
fn mk_call(mut p: Parser, start: usize, end: usize, callee: i32, arg_start: i32, arg_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 10, start: start, end: end, op: 0, a: callee, b: 0 - 1, x: arg_start, y: arg_count })
    return id
}
// A Cast node `expr as T`: `a` is the expr, `(x, y)` the type's source span.
fn mk_cast(mut p: Parser, start: usize, end: usize, expr: i32, ty_start: usize, ty_end: usize) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 11, start: start, end: end, op: 0, a: expr, b: 0 - 1, x: ty_start as i32, y: ty_end as i32 })
    return id
}
// An Assign node `target op= value`: `op` is the AssignOp code, `a`=target, `b`=value.
fn mk_assign(mut p: Parser, start: usize, end: usize, op: i32, target: i32, value: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 12, start: start, end: end, op: op, a: target, b: value, x: 0 - 1, y: 0 - 1 })
    return id
}
// A Range node `lo .. hi` / `lo ..= hi`: `op` is 1 when inclusive, `a`=lo, `b`=hi (either
// -1 for an absent bound).
fn mk_range(mut p: Parser, start: usize, end: usize, inclusive: i32, lo: i32, hi: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 13, start: start, end: end, op: inclusive, a: lo, b: hi, x: 0 - 1, y: 0 - 1 })
    return id
}
// An ArrayLit node `[e0, e1, …]`: `(x, y)` = (elem_start, elem_count) into the arg arena.
fn mk_arraylit(mut p: Parser, start: usize, end: usize, elem_start: i32, elem_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 14, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: elem_start, y: elem_count })
    return id
}
// An ArrayRepeat node `[value; count]`: `a`=value, `b`=count.
fn mk_arrayrepeat(mut p: Parser, start: usize, end: usize, value: i32, count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 15, start: start, end: end, op: 0, a: value, b: count, x: 0 - 1, y: 0 - 1 })
    return id
}
// A StructLit node `Path { fields, ..spread }`: `a`=path (a Name node), `b`=spread (-1 if
// none), `(x, y)` = (field_start, field_count) of FieldInit nodes in the arg arena.
fn mk_structlit(mut p: Parser, start: usize, end: usize, path: i32, spread: i32, field_start: i32, field_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 16, start: start, end: end, op: 0, a: path, b: spread, x: field_start, y: field_count })
    return id
}
// A GenStructLit node `Ctor(type_args){ fields }`: `a`=ctor (a Name node), `op`/`x` =
// (targ_start, targ_count) of the type-arg exprs in the arg arena, `b`/`y` = (field_start,
// field_count) of the FieldInit nodes. Unlike StructLit there is no spread.
fn mk_genstructlit(mut p: Parser, start: usize, end: usize, ctor: i32, targ_start: i32, targ_count: i32, field_start: i32, field_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 17, start: start, end: end, op: targ_start, a: ctor, b: field_start, x: targ_count, y: field_count })
    return id
}
// A FieldInit node `name: value`: `(x, y)` the name's source span, `a`=value. Stored as an
// ordinary arena node so a StructLit's field list is just a run of ExprIds in the arg arena.
fn mk_fieldinit(mut p: Parser, name_start: usize, name_end: usize, value: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 18, start: name_start, end: name_end, op: 0, a: value, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// An Attr node `@name`: `(x, y)` the name's source span (which attribute); node span runs
// from the `@` to the name's end. It is a primary — a call postfix `(…)` on top makes it a
// callable attribute like `@address(0x10)`.
fn mk_attr(mut p: Parser, start: usize, end: usize, name_start: usize, name_end: usize) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 21, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: name_start as i32, y: name_end as i32 })
    return id
}
// A Block expression `{ stmts }` (kind 23): `(x, y)` = (stmt_start, stmt_count) into `sar`.
fn mk_block(mut p: Parser, start: usize, end: usize, stmt_start: i32, stmt_count: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 23, start: start, end: end, op: 0, a: 0 - 1, b: 0 - 1, x: stmt_start, y: stmt_count })
    return id
}
// An `if` expression (kind 24): `a`=cond, `b`=then (a Block node), `op`=els (an `else`
// Block or a chained `if`, -1 if none). Span runs to the else's end (or the then's).
fn mk_if(mut p: Parser, start: usize, end: usize, cond: i32, then: i32, els: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 24, start: start, end: end, op: els, a: cond, b: then, x: 0 - 1, y: 0 - 1 })
    return id
}
// An `unsafe { … }` expression (kind 25): `a`=the Block node.
fn mk_unsafe(mut p: Parser, start: usize, end: usize, body: i32) -> i32 {
    let id: i32 = list.len(ExprData, p.ex) as i32
    list.push(ExprData, p.ex, ExprData{ kind: 25, start: start, end: end, op: 0, a: body, b: 0 - 1, x: 0 - 1, y: 0 - 1 })
    return id
}
// A `let`/`var` statement: `op`=mutbl, `(x,y)`=name span, `(ts,te)`=type span (ts=-1 none),
// `a`=init ExprId (-1 none).
fn mk_let(mut p: Parser, start: usize, end: usize, mutbl: i32, ns: usize, ne: usize, ts: i32, te: i32, init: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 0, start: start, end: end, op: mutbl, a: init, x: ns as i32, y: ne as i32, ts: ts, te: te })
    return id
}
// A `return [expr]` statement: `a`=value ExprId (-1 if bare).
fn mk_return(mut p: Parser, start: usize, end: usize, value: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 1, start: start, end: end, op: 0, a: value, x: 0 - 1, y: 0 - 1, ts: 0 - 1, te: 0 - 1 })
    return id
}
// An expression statement: `a`=the expression (its own span drives the dump).
fn mk_exprstmt(mut p: Parser, e: i32) -> i32 {
    let id: i32 = list.len(StmtData, p.st) as i32
    list.push(StmtData, p.st, StmtData{ kind: 2, start: 0, end: 0, op: 0, a: e, x: 0 - 1, y: 0 - 1, ts: 0 - 1, te: 0 - 1 })
    return id
}
fn node_start(read p: Parser, id: i32) -> usize {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    return d.start
}
fn node_end(read p: Parser, id: i32) -> usize {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    return d.end
}
// An `Error` node spanning the current token (or empty at end of input) — the bounded
// result when the nesting guard fires.
fn err_here(mut p: Parser) -> i32 {
    if p.pos < p.n {
        let t: tokens.Token = cur_tok(p)
        return mk(p, 9, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    return mk(p, 9, 0, 0, 0, 0 - 1, 0 - 1)
}

// ---- operator table ----

// Classify an infix operator by token kind, returning its binding powers and `BinOp` code.
// The powers are exactly the reference's `bin_op` table: `or` < `and` < comparison < `|` <
// `^` < `&` < shifts < additive < multiplicative, each left-associative (`lbp` even,
// `rbp = lbp + 1`). BinOp codes: 1=add 2=sub 3=mul 4=div 5=rem 6=eq 7=ne 8=lt 9=le 10=gt
// 11=ge 12=and 13=or 14=bitand 15=bitor 16=bitxor 17=shl 18=shr.
fn bin_op(k: i32) -> BinInfo {
    if k == 50 { return BinInfo{ ok: true, lbp: 7, rbp: 8, code: 13 } }    // or
    if k == 49 { return BinInfo{ ok: true, lbp: 9, rbp: 10, code: 12 } }   // and
    if k == 85 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 6 } }   // ==
    if k == 86 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 7 } }   // !=
    if k == 87 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 8 } }   // <
    if k == 88 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 9 } }   // <=
    if k == 89 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 10 } }  // >
    if k == 90 { return BinInfo{ ok: true, lbp: 11, rbp: 12, code: 11 } }  // >=
    if k == 93 { return BinInfo{ ok: true, lbp: 13, rbp: 14, code: 15 } }  // |  bitor
    if k == 95 { return BinInfo{ ok: true, lbp: 15, rbp: 16, code: 16 } }  // ^  bitxor
    if k == 91 { return BinInfo{ ok: true, lbp: 17, rbp: 18, code: 14 } }  // &  bitand
    if k == 97 { return BinInfo{ ok: true, lbp: 19, rbp: 20, code: 17 } }  // << shl
    if k == 98 { return BinInfo{ ok: true, lbp: 19, rbp: 20, code: 18 } }  // >> shr
    if k == 79 { return BinInfo{ ok: true, lbp: 21, rbp: 22, code: 1 } }   // +  add
    if k == 80 { return BinInfo{ ok: true, lbp: 21, rbp: 22, code: 2 } }   // -  sub
    if k == 81 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 3 } }   // *  mul
    if k == 82 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 4 } }   // /  div
    if k == 83 { return BinInfo{ ok: true, lbp: 23, rbp: 24, code: 5 } }   // %  rem
    return BinInfo{ ok: false, lbp: 0, rbp: 0, code: 0 }
}

// The AssignOp code for a token, or 0 if it is not an assignment operator. Codes:
// 1=set(`=`) 2=add(`+=`) 3=sub(`-=`) 4=mul(`*=`) 5=div(`/=`) 6=rem(`%=`) 7=bitand(`&=`)
// 8=bitor(`|=`) 9=bitxor(`^=`). Mirrors `assign_op` in the reference.
fn assign_op(k: i32) -> i32 {
    if k == 84 { return 1 }    // =
    if k == 102 { return 2 }   // +=
    if k == 103 { return 3 }   // -=
    if k == 104 { return 4 }   // *=
    if k == 105 { return 5 }   // /=
    if k == 106 { return 6 }   // %=
    if k == 107 { return 7 }   // &=
    if k == 108 { return 8 }   // |=
    if k == 109 { return 9 }   // ^=
    return 0
}

// Can the current token begin an expression? Used to decide whether a range `lo..` has an
// upper bound. Mirrors `starts_expr` in the reference (the exact token set).
fn starts_expr(read p: Parser) -> bool {
    let k: i32 = cur_kind(p)
    if k == 1 { return true }    // Int
    if k == 2 { return true }    // Float
    if k == 3 { return true }    // Str
    if k == 5 { return true }    // Char
    if k == 58 { return true }   // true
    if k == 59 { return true }   // false
    if k == 60 { return true }   // null
    if k == 0 { return true }    // Ident
    if k == 6 { return true }    // _
    if k == 61 { return true }   // self
    if k == 62 { return true }   // Self
    if k == 63 { return true }   // (
    if k == 101 { return true }  // @
    if k == 22 { return true }   // if
    if k == 21 { return true }   // match
    if k == 38 { return true }   // unsafe
    if k == 65 { return true }   // {
    if k == 11 { return true }   // struct
    if k == 80 { return true }   // -
    if k == 51 { return true }   // not
    if k == 99 { return true }   // !
    if k == 96 { return true }   // ~
    if k == 91 { return true }   // &
    if k == 93 { return true }   // |
    if k == 94 { return true }   // ||
    return false
}

// ---- the Pratt parser (mirrors parse_primary / parse_cast / parse_postfix / parse_unary
//      / parse_binary in the reference) ----

// Parse a `{ name: value, …, ..spread }` initializer body (cur is `{`). Field-init nodes
// are buffered in a temp list, then appended contiguously to the arg arena (so a nested
// struct/call in a field value doesn't scatter the slice). A leading `..expr` is a
// functional-update spread and ends the list — but only when `allow_spread` (a plain
// `Path{ … }` literal); a generic-struct literal `Ctor(…){ … }` has no spread. Mirrors the
// body shared by `parse_struct_lit` / `parse_gen_struct_lit` in the reference.
fn parse_fields(mut p: Parser, allow_spread: bool) -> FieldsResult {
    bump(p)                                        // consume `{`
    var tmp: List(i32) = list.make(i32, p.alloc)
    var spread: i32 = 0 - 1
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else if k == 74 and allow_spread {         // `..` -> spread (last element)
            bump(p)
            spread = parse_expr(p)
            more = false
        } else {
            let nt: tokens.Token = cur_tok(p)      // field name
            if cur_kind(p) == 0 { bump(p) }        // consume the name ident
            if cur_kind(p) == 71 { bump(p) }       // `:`
            let value: i32 = parse_expr(p)
            let fi: i32 = mk_fieldinit(p, nt.start, nt.end, value)
            list.push(i32, tmp, fi)
            if cur_kind(p) == 69 { bump(p) } else { more = false }   // `,`
        }
    }
    var endp: usize = 0
    if cur_kind(p) == 66 {                          // `}`
        let rb: tokens.Token = cur_tok(p)
        endp = rb.end
        bump(p)
    }
    let field_start: i32 = list.len(i32, p.ar) as i32
    let field_count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.ar, list.get(i32, tmp, j))
        j = j + 1
    }
    return FieldsResult{ field_start: field_start, field_count: field_count, spread: spread, endp: endp }
}

// `Path { … }` — a struct literal. `path` is the already-built Name node, `start` its span
// start; the span runs to the closing `}`.
fn parse_struct_lit(mut p: Parser, path: i32, start: usize) -> i32 {
    let fr: FieldsResult = parse_fields(p, true)
    return mk_structlit(p, start, fr.endp, path, fr.spread, fr.field_start, fr.field_count)
}

// `Ctor(type_args) { fields }` — a generic struct literal (cur is `{`). `ctor` is the
// already-built Name node, `start` its span start; `(targ_start, targ_count)` is the slice
// of type-arg exprs already appended to the arg arena (they were parsed as the call's
// arguments, then reinterpreted here). No spread. Mirrors `parse_gen_struct_lit`.
fn parse_gen_struct_lit(mut p: Parser, ctor: i32, start: usize, targ_start: i32, targ_count: i32) -> i32 {
    let fr: FieldsResult = parse_fields(p, false)
    return mk_genstructlit(p, start, fr.endp, ctor, targ_start, targ_count, fr.field_start, fr.field_count)
}

// After a `(args)` postfix has been parsed onto callee `e` (its arg slice already in the
// arg arena as `(arg_start, argc)`, span `start..endp`), decide what it is: if a `{`
// follows, the callee is a bare `Name`, and struct literals aren't suppressed, the args are
// type arguments and this is a generic struct literal; otherwise it is a plain call.
fn finish_call_or_gsl(mut p: Parser, e: i32, start: usize, endp: usize, arg_start: i32, argc: i32) -> i32 {
    if cur_kind(p) == 65 {                          // `{`
        let ed: ExprData = list.get(ExprData, p.ex, e as usize)
        if ed.kind == 2 {                           // callee is a Name
            if !p.no_struct { return parse_gen_struct_lit(p, e, start, arg_start, argc) }
        }
    }
    return mk_call(p, start, endp, e, arg_start, argc)
}

// An f-string `f"… {x} …"` is a single lexer token; the FString node records just its
// source span `[start, end)` (kind 22). The literal parts and `{ident}` interpolations are
// re-derived from `src` at dump time (`dump_fstring`) rather than stored: the borrow checker
// forbids stashing `src` in the `Parser` struct, and the dump needs the *text* anyway (the
// reference's interpolation `Name` nodes all carry the whole f-string span, so a span-only
// dump couldn't distinguish `{x}` from `{y}`). A later slice (when interpolations must become
// real sub-expressions for typeck) will thread `src` through the parse chain and split here.
fn parse_fstring(mut p: Parser, start: usize, end: usize) -> i32 {
    return mk(p, 22, start, end, 0, 0 - 1, 0 - 1)
}

// A brace-delimited block `{ stmt … }` (cur is `{`) as a Block expression. Statements are
// buffered in a temp list then appended contiguously to `sar` (so a nested block's
// statements don't scatter this block's slice). `;` between statements is optional. Mirrors
// `parse_block` in the reference (which re-enables struct literals inside the body). The
// block's value, if any, is just its last statement being an expression — no separate tail.
fn parse_block(mut p: Parser) -> i32 {
    let lb: tokens.Token = cur_tok(p)
    let start: usize = lb.start
    bump(p)                                        // consume `{`
    let saved_ns: bool = p.no_struct
    p.no_struct = false                            // struct literals are fine inside a block
    var tmp: List(i32) = list.make(i32, p.alloc)
    var more: bool = true
    for more {
        let k: i32 = cur_kind(p)
        if k == 66 { more = false }                // `}`
        else if k == 110 { more = false }          // Eof
        else {
            let before: usize = p.pos
            let sid: i32 = parse_stmt(p)
            list.push(i32, tmp, sid)
            if cur_kind(p) == 70 { bump(p) }       // optional `;` separator
            if p.pos == before { bump(p) }         // guarantee progress on stuck input
        }
    }
    var endp: usize = start
    if cur_kind(p) == 66 {                          // `}`
        let rb: tokens.Token = cur_tok(p)
        endp = rb.end
        bump(p)
    }
    let stmt_start: i32 = list.len(i32, p.sar) as i32
    let stmt_count: i32 = list.len(i32, tmp) as i32
    var j: usize = 0
    for j < list.len(i32, tmp) {
        list.push(i32, p.sar, list.get(i32, tmp, j))
        j = j + 1
    }
    p.no_struct = saved_ns
    return mk_block(p, start, endp, stmt_start, stmt_count)
}

// One statement: `let`/`var` binding, `return`, a block-led expression (block-only, so a
// trailing operator can't extend it — statement position), or a plain expression statement.
// Mirrors `parse_stmt` in the reference. Returns a `StmtId`.
fn parse_stmt(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 28 {                                   // return
        let rt: tokens.Token = cur_tok(p)
        let start: usize = rt.start
        bump(p)
        var value: i32 = 0 - 1
        let nk: i32 = cur_kind(p)
        if nk == 66 { value = 0 - 1 }              // `}` -> bare return
        else if nk == 70 { value = 0 - 1 }         // `;`
        else if nk == 110 { value = 0 - 1 }        // Eof
        else { value = parse_expr(p) }
        var endp: usize = rt.end
        if value >= 0 { endp = node_end(p, value) }
        return mk_return(p, start, endp, value)
    }
    if k == 8 or k == 9 {                          // let / var
        var mutbl: i32 = 0
        if k == 9 { mutbl = 1 }                    // `var` is mutable
        let lt: tokens.Token = cur_tok(p)
        let start: usize = lt.start
        bump(p)
        var ns: usize = start                      // the variable name's span
        var ne: usize = start
        if cur_kind(p) == 0 { let nt: tokens.Token = cur_tok(p)  ns = nt.start  ne = nt.end  bump(p) }
        var ts: i32 = 0 - 1                        // optional `: T` type annotation
        var te: i32 = 0 - 1
        if cur_kind(p) == 71 {                      // `:`
            bump(p)
            let ty: TySpan = parse_type(p)
            ts = ty.start as i32
            te = ty.end as i32
        }
        var init: i32 = 0 - 1                       // optional `= expr` initializer
        if cur_kind(p) == 84 { bump(p)  init = parse_expr(p) }   // `=`
        return mk_let(p, start, prev_end(p), mutbl, ns, ne, ts, te, init)
    }
    // Block-led expressions in statement position parse *block-only* (no trailing operator).
    // `match` joins once the pattern parser lands.
    if k == 65 or k == 22 or k == 38 {             // `{` / `if` / `unsafe`
        let e: i32 = parse_block_like(p)
        return mk_exprstmt(p, e)
    }
    let e: i32 = parse_expr(p)
    return mk_exprstmt(p, e)
}

// Dispatch a block-led expression in statement position (block form only). For now just the
// bare block; `if`/`match`/`unsafe` are added with their parsers. Mirrors `parse_block_like`.
fn parse_block_like(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 22 { return parse_if(p) }                // `if`
    if k == 38 { return parse_unsafe(p) }            // `unsafe`
    if k == 65 { return parse_block(p) }             // `{`
    return parse_expr(p)
}

// `if <cond> { … } [else { … } | else if …]`. The condition parses with `no_struct` set so
// a trailing `{` opens the then-block rather than a struct literal; `else if` chains by
// recursion and a plain `else` wraps its block as the `els` expression. Span runs to the
// else's end, or the then-block's when there is no else. Mirrors `parse_if`.
fn parse_if(mut p: Parser) -> i32 {
    let it: tokens.Token = cur_tok(p)
    let start: usize = it.start
    bump(p)                                          // consume `if`
    let saved_ns: bool = p.no_struct
    p.no_struct = true
    let cond: i32 = parse_expr(p)
    p.no_struct = saved_ns
    let then: i32 = parse_block(p)
    var els: i32 = 0 - 1
    if cur_kind(p) == 23 {                            // `else`
        bump(p)
        if cur_kind(p) == 22 { els = parse_if(p) }   // `else if …`
        else { els = parse_block(p) }                // `else { … }`
    }
    var endp: usize = node_end(p, then)
    if els >= 0 { endp = node_end(p, els) }
    return mk_if(p, start, endp, cond, then, els)
}

// `unsafe { … }` — an unsafe block. Span runs from `unsafe` to the block's `}`. Mirrors
// `parse_unsafe`.
fn parse_unsafe(mut p: Parser) -> i32 {
    let ut: tokens.Token = cur_tok(p)
    let start: usize = ut.start
    bump(p)                                          // consume `unsafe`
    let b: i32 = parse_block(p)
    return mk_unsafe(p, start, node_end(p, b), b)
}

// A leaf or a parenthesized group. `( e )` returns the inner expression unchanged
// (grouping only, its own span). An unhandled token yields an `Error` node so the walk
// still terminates.
fn parse_primary(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    if k == 1 {                                    // Int
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 0, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 2 {                                    // Float
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 1, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 0 {                                    // Ident -> Name, or a struct literal
        let t: tokens.Token = cur_tok(p)
        bump(p)
        let nm: i32 = mk(p, 2, t.start, t.end, 0, 0 - 1, 0 - 1)
        if cur_kind(p) == 65 {                     // `{` -> `Path { … }` (unless suppressed)
            if !p.no_struct { return parse_struct_lit(p, nm, t.start) }
        }
        return nm
    }
    if k == 4 {                                    // f"…" -> FString
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return parse_fstring(p, t.start, t.end)
    }
    if k == 65 {                                   // `{` -> Block expression
        return parse_block(p)
    }
    if k == 22 {                                   // `if` -> If expression
        return parse_if(p)
    }
    if k == 38 {                                   // `unsafe` -> Unsafe block
        return parse_unsafe(p)
    }
    if k == 61 {                                   // self -> SelfValue
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 19, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 62 {                                   // Self -> SelfType, or `Self { … }`
        let t: tokens.Token = cur_tok(p)
        bump(p)
        if cur_kind(p) == 65 {                     // `{` -> `Self { … }` (unless suppressed)
            if !p.no_struct {
                // The path is a Name node carrying the `Self` span (the reference uses a
                // synthetic `Self` Ident); parse_struct_lit dumps it identically.
                let nm: i32 = mk(p, 2, t.start, t.end, 0, 0 - 1, 0 - 1)
                return parse_struct_lit(p, nm, t.start)
            }
        }
        return mk(p, 20, t.start, t.end, 0, 0 - 1, 0 - 1)
    }
    if k == 101 {                                  // @name -> Attr (callable via postfix `(…)`)
        let at: tokens.Token = cur_tok(p)
        bump(p)
        if cur_kind(p) == 0 {                      // the attribute name
            let nt: tokens.Token = cur_tok(p)
            bump(p)
            return mk_attr(p, at.start, nt.end, nt.start, nt.end)
        }
        return mk_attr(p, at.start, at.end, at.end, at.end)   // missing name: empty at `@`.end
    }
    if k == 63 {                                   // '(' grouping
        bump(p)
        let inner: i32 = parse_expr(p)
        if cur_kind(p) == 64 { bump(p) }           // ')'
        return inner
    }
    if k == 67 {                                   // '[' array literal
        let lb: tokens.Token = cur_tok(p)
        bump(p)
        let first: i32 = parse_expr(p)
        if cur_kind(p) == 70 {                     // ';' -> `[value; count]` repeat
            bump(p)
            let count: i32 = parse_expr(p)
            var endr: usize = node_end(p, count)
            if cur_kind(p) == 68 {                 // ']'
                let rb: tokens.Token = cur_tok(p)
                endr = rb.end
                bump(p)
            }
            return mk_arrayrepeat(p, lb.start, endr, first, count)
        }
        // `[e0, e1, …]` list — buffer elements in a temp list (like a call) so nested
        // array/call pushes into `p.ar` don't scatter this literal's slice.
        var tmp: List(i32) = list.make(i32, p.alloc)
        list.push(i32, tmp, first)
        var more: bool = true
        for more {
            if cur_kind(p) == 69 {                 // ','
                bump(p)
                if cur_kind(p) == 68 { more = false }   // trailing comma
                else {
                    let el: i32 = parse_expr(p)
                    list.push(i32, tmp, el)
                }
            } else {
                more = false
            }
        }
        var endl: usize = node_end(p, first)
        if cur_kind(p) == 68 {                     // ']'
            let rb2: tokens.Token = cur_tok(p)
            endl = rb2.end
            bump(p)
        }
        let elem_start: i32 = list.len(i32, p.ar) as i32
        let elem_count: i32 = list.len(i32, tmp) as i32
        var j: usize = 0
        for j < list.len(i32, tmp) {
            list.push(i32, p.ar, list.get(i32, tmp, j))
            j = j + 1
        }
        return mk_arraylit(p, lb.start, endl, elem_start, elem_count)
    }
    if p.pos < p.n {
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return mk(p, 9, t.start, t.end, 0, 0 - 1, 0 - 1)   // Error over the offending token
    }
    return mk(p, 9, 0, 0, 0, 0 - 1, 0 - 1)
}

// Consume a type and return its source span. Handles the forms that appear after `as` in
// the corpus: a pointer prefix `*` (optionally `mut`/`const`) wrapping a type, or a bare
// type name. (The full structural type parser is a later slice; the cast dump only needs
// the span, and this consumes exactly the tokens the reference `parse_type` does for these
// forms, so the spans agree.)
fn parse_type(mut p: Parser) -> TySpan {
    let k: i32 = cur_kind(p)
    if k == 81 {                                   // '*' -> pointer
        let st: tokens.Token = cur_tok(p)
        bump(p)
        let k2: i32 = cur_kind(p)
        if k2 == 55 { bump(p) }                    // 'mut'
        else if k2 == 10 { bump(p) }               // 'const'
        let inner: TySpan = parse_type(p)
        return TySpan{ start: st.start, end: inner.end }
    }
    if p.pos < p.n {                               // a type name (or, best-effort, one token)
        let t: tokens.Token = cur_tok(p)
        bump(p)
        return TySpan{ start: t.start, end: t.end }
    }
    return TySpan{ start: 0, end: 0 }
}

// Postfix chain: a primary followed by any run of `.field`, `[index]`, `.*` (deref), `?`
// (try), and `(args)` (call) — each wraps the previous expression as its base/callee,
// building a left-deep tree (so `a.b.c` is `field(field(a,b),c)`). The chain is bounded by
// `descend`. Spans mirror the reference: field = `base.start..name.end`, index/call =
// `base.start..].end`/`base.start..).end`, deref/try = `base.start..op.end`.
fn parse_postfix(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    var e: i32 = parse_primary(p)
    var go: bool = true
    for go {
        let k: i32 = cur_kind(p)
        if k == 73 {                               // '.'  -> Field
            if !descend(p) { go = false }
            else {
                bump(p)
                let nt: tokens.Token = cur_tok(p)       // the field-name ident
                if cur_kind(p) == 0 { bump(p) }         // consume the name if present
                let s: usize = node_start(p, e)
                e = mk_field(p, s, nt.end, e, nt.start, nt.end)
            }
        } else if k == 76 {                        // '.*' -> Deref
            if !descend(p) { go = false }
            else {
                let dt: tokens.Token = cur_tok(p)
                bump(p)
                let s: usize = node_start(p, e)
                e = mk(p, 7, s, dt.end, 0, e, 0 - 1)
            }
        } else if k == 100 {                       // '?'  -> Try
            if !descend(p) { go = false }
            else {
                let qt: tokens.Token = cur_tok(p)
                bump(p)
                let s: usize = node_start(p, e)
                e = mk(p, 8, s, qt.end, 0, e, 0 - 1)
            }
        } else if k == 67 {                        // '['  -> Index
            if !descend(p) { go = false }
            else {
                bump(p)
                let idx: i32 = parse_expr(p)
                var endp: usize = node_end(p, idx)
                if cur_kind(p) == 68 {                  // ']'
                    let rb: tokens.Token = cur_tok(p)
                    endp = rb.end
                    bump(p)
                }
                let s: usize = node_start(p, e)
                e = mk(p, 6, s, endp, 0, e, idx)
            }
        } else if k == 63 {                        // '('  -> Call
            if !descend(p) { go = false }
            else {
                bump(p)
                // Collect this call's argument ids in a per-call temp list, so a nested
                // call's pushes into `p.ar` (which happen *while* we parse an argument)
                // don't interleave with — and scatter — this call's arg block. After the
                // loop we append the temp contiguously, giving each call a clean slice.
                var tmp: List(i32) = list.make(i32, p.alloc)
                var more: bool = true
                for more {
                    let ak: i32 = cur_kind(p)
                    if ak == 64 { more = false }        // ')'
                    else if ak == 110 { more = false }  // Eof
                    else {
                        let arg: i32 = parse_expr(p)
                        list.push(i32, tmp, arg)
                        if cur_kind(p) == 69 { bump(p) }   // ',' -> another arg
                        else { more = false }
                    }
                }
                var endp: usize = node_end(p, e)
                if cur_kind(p) == 64 {                  // ')'
                    let rp: tokens.Token = cur_tok(p)
                    endp = rp.end
                    bump(p)
                }
                let arg_start: i32 = list.len(i32, p.ar) as i32
                let argc: i32 = list.len(i32, tmp) as i32
                var j: usize = 0
                for j < list.len(i32, tmp) {
                    list.push(i32, p.ar, list.get(i32, tmp, j))
                    j = j + 1
                }
                let s: usize = node_start(p, e)
                // A `{` after the `)` on a bare-Name callee re-reads the args as type args
                // (`Ctor(T…){ … }`); otherwise this is a plain call.
                e = finish_call_or_gsl(p, e, s, endp, arg_start, argc)
            }
        } else {
            go = false
        }
    }
    p.depth = saved
    return e
}

// `expr as T` — binds tighter than binary operators (`a + b as T` is `a + (b as T)`) and
// chains left (`x as A as B`). Span = expr.start .. type.end.
fn parse_cast(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    var e: i32 = parse_postfix(p)
    var go: bool = true
    for go {
        if cur_kind(p) == 48 {                     // 'as'
            if !descend(p) { go = false }
            else {
                bump(p)
                let ts: TySpan = parse_type(p)
                let s: usize = node_start(p, e)
                e = mk_cast(p, s, ts.end, e, ts.start, ts.end)
            }
        } else {
            go = false
        }
    }
    p.depth = saved
    return e
}

// Prefix unary: `-` (neg), `!`/`not` (not), `~` (bitnot), `&` (ref). Right-recursive, so
// `- - x` nests (bounded by `descend`). UnOp codes: 1=neg 2=not 3=bitnot 4=ref. Span =
// op.start .. rhs.end. A non-prefix token falls through to the cast/postfix/primary layer.
fn parse_unary(mut p: Parser) -> i32 {
    let k: i32 = cur_kind(p)
    var opc: i32 = 0
    if k == 80 { opc = 1 }                         // Minus -> neg
    else if k == 51 { opc = 2 }                    // not   -> not
    else if k == 99 { opc = 2 }                    // Bang  -> not
    else if k == 96 { opc = 3 }                    // Tilde -> bitnot
    else if k == 91 { opc = 4 }                    // Amp   -> ref (prefix position)
    if opc != 0 {
        let saved: i32 = p.depth
        if !descend(p) { p.depth = saved  return err_here(p) }
        let ct: tokens.Token = cur_tok(p)
        let st: usize = ct.start
        bump(p)
        let rhs: i32 = parse_unary(p)
        let e: usize = node_end(p, rhs)
        p.depth = saved
        return mk(p, 3, st, e, opc, rhs, 0 - 1)
    }
    return parse_cast(p)
}

// Precedence climbing. `min_bp` is the minimum left binding power that may extend the
// current left operand; an operator with `lbp < min_bp` stops this level. The left spine
// folds iteratively (so `1+1+…` is a loop, not deep recursion) while the right operand
// re-enters at `rbp` (left-associative). Span = lhs.start .. rhs.end. Bounded by `descend`
// at the entry (recursion) and per fold (left-spine height).
// Build a Range node once a `..`/`..=` has been seen (the op is still current). `lo` is
// the left operand; the upper bound is parsed at rbp=6 only if an expression follows (so
// `arr[i..]` leaves `hi` open). Span = lo.start .. (hi.end | lo.end). Mirrors the range
// arm of the reference `parse_binary`.
fn parse_range_tail(mut p: Parser, lo: i32, inclusive: i32) -> i32 {
    bump(p)                                         // consume `..` / `..=`
    var hi: i32 = 0 - 1
    var e: usize = node_end(p, lo)
    if starts_expr(p) {
        hi = parse_binary(p, 6)
        e = node_end(p, hi)
    }
    let s: usize = node_start(p, lo)
    return mk_range(p, s, e, inclusive, lo, hi)
}

fn parse_binary(mut p: Parser, min_bp: i32) -> i32 {
    let saved: i32 = p.depth
    if !descend(p) { p.depth = saved  return err_here(p) }
    var lhs: i32 = parse_unary(p)
    var go: bool = true
    for go {
        let k: i32 = cur_kind(p)
        if k == 74 {                               // '..'  -> exclusive Range (lbp 5, rbp 6)
            if 5 < min_bp { go = false }
            else if !descend(p) { go = false }
            else { lhs = parse_range_tail(p, lhs, 0) }
        } else if k == 75 {                        // '..=' -> inclusive Range
            if 5 < min_bp { go = false }
            else if !descend(p) { go = false }
            else { lhs = parse_range_tail(p, lhs, 1) }
        } else {
            let bi: BinInfo = bin_op(k)
            if !bi.ok {
                go = false
            } else if bi.lbp < min_bp {
                go = false
            } else if !descend(p) {
                go = false
            } else {
                bump(p)
                let rhs: i32 = parse_binary(p, bi.rbp)
                let s: usize = node_start(p, lhs)
                let e: usize = node_end(p, rhs)
                lhs = mk(p, 4, s, e, bi.code, lhs, rhs)
            }
        }
    }
    p.depth = saved
    return lhs
}

// The full expression entry: assignment is the outermost, lowest-precedence layer, and is
// right-associative (`a = b = c` is `a = (b = c)`). Everything else is a binary/unary/
// postfix/primary chain. Mirrors `parse_expr`/`parse_assignment` in the reference.
fn parse_expr(mut p: Parser) -> i32 {
    let saved: i32 = p.depth
    if !descend(p) { p.depth = saved  return err_here(p) }
    let lhs: i32 = parse_binary(p, 0)
    let ac: i32 = assign_op(cur_kind(p))
    if ac != 0 {
        bump(p)
        let value: i32 = parse_expr(p)             // right-associative
        let s: usize = node_start(p, lhs)
        let e: usize = node_end(p, value)
        p.depth = saved
        return mk_assign(p, s, e, ac, lhs, value)
    }
    p.depth = saved
    return lhs
}

// ---- the canonical AST dump (a pure function of the arena) ----

fn print_uint(x: usize) { print_int(x as i64) }

fn binop_label(code: i32) {
    if code == 1 { print_str("add") return }
    if code == 2 { print_str("sub") return }
    if code == 3 { print_str("mul") return }
    if code == 4 { print_str("div") return }
    if code == 5 { print_str("rem") return }
    if code == 6 { print_str("eq") return }
    if code == 7 { print_str("ne") return }
    if code == 8 { print_str("lt") return }
    if code == 9 { print_str("le") return }
    if code == 10 { print_str("gt") return }
    if code == 11 { print_str("ge") return }
    if code == 12 { print_str("and") return }
    if code == 13 { print_str("or") return }
    if code == 14 { print_str("bitand") return }
    if code == 15 { print_str("bitor") return }
    if code == 16 { print_str("bitxor") return }
    if code == 17 { print_str("shl") return }
    print_str("shr")   // 18
}
fn unop_label(code: i32) {
    if code == 1 { print_str("neg") return }
    if code == 2 { print_str("not") return }
    if code == 3 { print_str("bitnot") return }
    print_str("ref")   // 4
}
fn assign_label(code: i32) {
    if code == 1 { print_str("set") return }
    if code == 2 { print_str("add") return }
    if code == 3 { print_str("sub") return }
    if code == 4 { print_str("mul") return }
    if code == 5 { print_str("div") return }
    if code == 6 { print_str("rem") return }
    if code == 7 { print_str("bitand") return }
    if code == 8 { print_str("bitor") return }
    print_str("bitxor")   // 9
}

// Dump an optional child: the node if present, else a `(none)` marker (so a Range with an
// absent bound still has a fixed two-child shape).
fn dump_opt(read src: str, read p: Parser, id: i32) {
    if id < 0 { print_str("(") print_str("none") print_str(")") }
    else { dump(src, p, id) }
}

// Emit an f-string node's body atoms (the enclosing `dump` prints the surrounding parens):
// `fstring`, part count, expr count, the span, then every literal part's *text*, then every
// interpolation's *trimmed name text* — mirroring the reference, which stores `parts` as
// strings and interpolation `Name`s all sharing the whole f-string span (so text, not span,
// is the only form that distinguishes `{x}` from `{y}`). Body = `src[start+2 .. end-1]`
// (dropping `f"` and the closing `"`). Two passes over the body: parts, then names.
fn dump_fstring(read src: str, start: usize, end: usize) {
    var bstart: usize = start + 2
    var bend: usize = end - 1
    if start + 2 > end { bstart = end  bend = end }    // guard a malformed tiny token
    var ec: i32 = 0                                     // interpolation count = number of `{`
    var c: usize = bstart
    for c < bend {
        if (src[c] as i32) == 123 { ec = ec + 1 }
        c = c + 1
    }
    print_str("fstring") print_int((ec + 1) as i64) print_int(ec as i64) print_uint(start) print_uint(end)
    // parts pass: each maximal literal run, split at `{`, plus the trailing run.
    var pstart: usize = bstart
    var i: usize = bstart
    for i < bend {
        if (src[i] as i32) == 123 {
            print_str(src[pstart..i])
            var j: usize = i + 1
            for j < bend { if (src[j] as i32) == 125 { break }  j = j + 1 }
            if j < bend { i = j + 1 } else { i = bend }
            pstart = i
        } else { i = i + 1 }
    }
    print_str(src[pstart..bend])
    // names pass: the trimmed identifier inside each `{ … }`.
    var k: usize = bstart
    for k < bend {
        if (src[k] as i32) == 123 {
            var j2: usize = k + 1
            for j2 < bend { if (src[j2] as i32) == 125 { break }  j2 = j2 + 1 }
            var ns: usize = k + 1
            var ne: usize = j2
            for ns < ne {
                let a: i32 = src[ns] as i32
                if a == 32 { ns = ns + 1 } else if a == 9 { ns = ns + 1 } else if a == 10 { ns = ns + 1 } else if a == 13 { ns = ns + 1 } else { break }
            }
            for ne > ns {
                let b: i32 = src[ne - 1] as i32
                if b == 32 { ne = ne - 1 } else if b == 9 { ne = ne - 1 } else if b == 10 { ne = ne - 1 } else if b == 13 { ne = ne - 1 } else { break }
            }
            print_str(src[ns..ne])
            if j2 < bend { k = j2 + 1 } else { k = bend }
        } else { k = k + 1 }
    }
}

// Dump one statement. `let`: mutbl flag, name span, statement span, an optional `(type s e)`
// (or `(none)`), then the optional initializer. `return`: statement span then the optional
// value. `exprstmt`: just the wrapped expression. Mirrors `ref_dump_stmt` in the reference.
fn dump_stmt(read src: str, read p: Parser, sid: i32) {
    let s: StmtData = list.get(StmtData, p.st, sid as usize)
    print_str("(")
    if s.kind == 0 {
        print_str("let") print_int(s.op as i64) print_int(s.x as i64) print_int(s.y as i64) print_uint(s.start) print_uint(s.end)
        if s.ts < 0 { print_str("(") print_str("none") print_str(")") }
        else { print_str("(") print_str("type") print_int(s.ts as i64) print_int(s.te as i64) print_str(")") }
        dump_opt(src, p, s.a)
    } else if s.kind == 1 {
        print_str("return") print_uint(s.start) print_uint(s.end)
        dump_opt(src, p, s.a)
    } else {
        print_str("exprstmt")
        dump(src, p, s.a)
    }
    print_str(")")
}

// Emit a flattened S-expression: `(`, the head atoms (kind label, operator/aux, start,
// end), then each child's dump in order, then `)` — one atom per line.
fn dump(read src: str, read p: Parser, id: i32) {
    let d: ExprData = list.get(ExprData, p.ex, id as usize)
    print_str("(")
    if d.kind == 0 {
        print_str("int")   print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 1 {
        print_str("float") print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 2 {
        print_str("name")  print_uint(d.start)   print_uint(d.end)
    } else if d.kind == 3 {
        print_str("unary") unop_label(d.op)  print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 4 {
        print_str("binary") binop_label(d.op) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 5 {
        // Field: the name's source span (x, y) identifies which field, then the base.
        print_str("field") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 6 {
        print_str("index") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 7 {
        print_str("deref") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 8 {
        print_str("try") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 10 {
        // Call: arg count, then the callee, then each argument (from the arg arena).
        print_str("call") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        var i: i32 = 0
        for i < d.y {
            let argid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, argid)
            i = i + 1
        }
    } else if d.kind == 11 {
        // Cast: the target type's source span (x, y), then the operand.
        print_str("cast") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else if d.kind == 12 {
        print_str("assign") assign_label(d.op) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 13 {
        // Range: `op` is the inclusive flag (0/1); lo/hi are optional bounds.
        print_str("range") print_int(d.op as i64) print_uint(d.start) print_uint(d.end)
        dump_opt(src, p,d.a)
        dump_opt(src, p,d.b)
    } else if d.kind == 14 {
        // ArrayLit: element count, then each element (from the arg arena).
        print_str("array") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.y {
            let elid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, elid)
            i = i + 1
        }
    } else if d.kind == 15 {
        print_str("arrayrepeat") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
    } else if d.kind == 16 {
        // StructLit: field count, path (a Name node), optional spread, then each FieldInit.
        print_str("structlit") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump_opt(src, p,d.b)
        var i: i32 = 0
        for i < d.y {
            let fid: i32 = list.get(i32, p.ar, (d.x + i) as usize)
            dump(src, p, fid)
            i = i + 1
        }
    } else if d.kind == 17 {
        // GenStructLit: type-arg count, field count, the ctor (a Name node), then each
        // type-arg expr (from the arg arena), then each FieldInit.
        print_str("genstructlit") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        var i: i32 = 0
        for i < d.x {
            let taid: i32 = list.get(i32, p.ar, (d.op + i) as usize)
            dump(src, p, taid)
            i = i + 1
        }
        var j: i32 = 0
        for j < d.y {
            let fid: i32 = list.get(i32, p.ar, (d.b + j) as usize)
            dump(src, p, fid)
            j = j + 1
        }
    } else if d.kind == 18 {
        // FieldInit: the name's source span (x, y), then the value.
        print_str("fieldinit") print_int(d.x as i64) print_int(d.y as i64)
        dump(src, p, d.a)
    } else if d.kind == 19 {
        print_str("selfval") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 20 {
        print_str("selftype") print_uint(d.start) print_uint(d.end)
    } else if d.kind == 21 {
        // Attr: the name's source span (x, y) identifies which attribute, then the node span.
        print_str("attr") print_int(d.x as i64) print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
    } else if d.kind == 22 {
        // FString: re-scan the token span from src for its parts + interpolation names.
        dump_fstring(src, d.start, d.end)
    } else if d.kind == 23 {
        // Block: statement count, span, then each statement (from the statement-id arena).
        print_str("block") print_int(d.y as i64) print_uint(d.start) print_uint(d.end)
        var i: i32 = 0
        for i < d.y {
            let sid: i32 = list.get(i32, p.sar, (d.x + i) as usize)
            dump_stmt(src, p, sid)
            i = i + 1
        }
    } else if d.kind == 24 {
        // If: the condition, the then-block, then the optional else (a Block or chained If).
        print_str("if") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
        dump(src, p, d.b)
        dump_opt(src, p, d.op)
    } else if d.kind == 25 {
        // Unsafe: just its block.
        print_str("unsafe") print_uint(d.start) print_uint(d.end)
        dump(src, p, d.a)
    } else {
        print_str("error") print_uint(d.start) print_uint(d.end)
    }
    print_str(")")
}

// Tokenize `src`, parse one expression, dump it.
fn parse_and_dump(read src: str, mut it: Interner, kwcount: i64, read a: Allocator) {
    var tk: List(tokens.Token) = tokens.tokenize(src, it, kwcount, a)
    let n: usize = list.len(tokens.Token, tk)
    var p: Parser = Parser{ toks: tk, ex: list.make(ExprData, a), ar: list.make(i32, a), st: list.make(StmtData, a), sar: list.make(i32, a), alloc: a, pos: 0, n: n, depth: 0, over: false, no_struct: false }
    let root: i32 = parse_expr(p)
    dump(src, p, root)
}

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)
    let kwcount: i64 = tokens.intern_keywords(it)

    if env.argc() > 1 {
        var src: String = fs.read_text(env.argv(1))
        parse_and_dump(string_view(src), it, kwcount, a)
        string_free(src)
    } else {
        let sample: str = "Point{ x: 1, y: a + b, ..base }"
        parse_and_dump(sample, it, kwcount, a)
    }
    return 0
}
