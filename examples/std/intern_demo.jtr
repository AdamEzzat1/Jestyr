// examples/std/intern_demo.jtr — the string interner: distinct strings → dense ids
// (and back), the structure that lets a self-hosted compiler carry `u32` ids instead
// of strings. Shows dedup (repeated strings collapse to one id), id→string lookup,
// and a 200-key stress run forcing several grow/rehash cycles.
//
//   jestyrc run examples/std/intern_demo.jtr
//   →  0 1 2  1 1  3   fn return   1 203 1 203
import "core"
import "mem"
import "intern"

fn b2i(read b: bool) -> i32 { if b { return 1 } return 0 }

fn main() -> i32 {
    var a: Allocator = mem.system_allocator()
    var it: Interner = intern.make(a)

    // First-seen order assigns ids 0,1,2; repeats return the same id.
    let id_fn: i64 = intern.intern(it, "fn")
    let id_let: i64 = intern.intern(it, "let")
    let id_fn2: i64 = intern.intern(it, "fn")        // dup of "fn"
    let id_ret: i64 = intern.intern(it, "return")
    let id_let2: i64 = intern.intern(it, "let")      // dup of "let"

    print_int(id_fn as i32)                          // 0
    print_int(id_let as i32)                         // 1
    print_int(id_ret as i32)                         // 2
    print_int(b2i(id_fn == id_fn2))                  // 1 (dedup)
    print_int(b2i(id_let == id_let2))                // 1 (dedup)
    print_int(intern.count(it) as i32)               // 3 (only 3 distinct)

    // id → string round-trips, zero-copy.
    print_str(intern.lookup(it, id_fn))              // fn
    print_str(intern.lookup(it, id_ret))             // return

    // Stress: intern 200 distinct decimal strings; each round-trips through lookup.
    var buf: *mut u8 = alloc(u8, 24)
    var bs: []u8 = slice(u8, buf, 24)
    var ok: i32 = 1
    var v: i32 = 0
    for v < 200 {
        let klen: usize = core.format_i64(v as i64, bs)
        let ks: []u8 = slice(u8, buf, klen)
        let key: str = from_utf8(ks)
        let id: i64 = intern.intern(it, key)
        let back: str = intern.lookup(it, id)
        if not str_eq(back, key) { ok = 0 }
        v = v + 1
    }
    print_int(ok)                                    // 1 (all 200 round-trip)
    print_int(intern.count(it) as i32)               // 203 (3 keywords + 200 numbers)

    // Re-interning an existing key returns the same id and does not grow the count.
    let k100l: usize = core.format_i64(100, bs)
    let k100s: []u8 = slice(u8, buf, k100l)
    let k100: str = from_utf8(k100s)
    let first: i64 = intern.intern(it, k100)
    let again: i64 = intern.intern(it, k100)
    print_int(b2i(first == again))                   // 1 (stable id)
    print_int(intern.count(it) as i32)               // 203 (unchanged)

    free_ptr(buf)
    return 0   // it drops here: all owned keys + table + id array freed by RAII
}
