// examples/methods.jtr — method-call sugar (backlog item A).
//
// `xs.push(10)` desugars to a free call `push(i32, xs, 10)`: the method name is
// resolved against a free function whose first non-comptime parameter matches
// the receiver's type, and the comptime type argument (`i32`) is *recovered*
// from the receiver `xs : List(i32)`. No new runtime — it is a pure frontend
// rewrite over the existing generic-call machinery.
//
// Run:  jestyrc run examples/methods.jtr   →  10, 30, 3, then 2.5

fn List(comptime T: type) -> type {
    return struct {
        ptr: *mut T,
        len: i32,
        cap: i32,
    }
}

fn new(comptime T: type) -> List(T) {
    return List(T){ ptr: alloc(T, 4), len: 0, cap: 4 }
}

// `mut l` is the receiver: a method call passes `&xs` here.
fn push(comptime T: type, mut l: List(T), x: T) {
    if l.len == l.cap {
        l.cap = l.cap * 2
        l.ptr = realloc(T, l.ptr, l.cap)
    }
    unsafe { (l.ptr + l.len).* = x }
    l.len = l.len + 1
}

// `l` is a by-value receiver: a method call passes `xs` directly.
fn get(comptime T: type, l: List(T), i: i32) -> T {
    unsafe { (l.ptr + i).* }
}

fn main() -> i32 {
    var xs = new(i32)
    xs.push(10)
    xs.push(20)
    xs.push(30)
    print_int(xs.get(0))    // 10
    print_int(xs.get(2))    // 30
    print_int(xs.len)       // 3  (plain field access — already worked)
    free_ptr(xs.ptr)

    var ys = new(f64)       // a second instantiation: List(f64)
    ys.push(2.5)
    print_float(ys.get(0))  // 2.5
    free_ptr(ys.ptr)
    return 0
}
