// examples/defaults.jtr — field defaults (§2.8): a struct field may declare a
// `= <expr>` default, used to fill the field when a literal omits it. Pairs with
// struct spread for ergonomic configuration values.
//
// Run:  jestyrc run examples/defaults.jtr   →  prints 3, 0, 1, 5, 0, 9

struct Config {
    retries: i32 = 3,
    timeout: i32 = 0,
    verbose: i32 = 1,
}

fn main() -> i32 {
    // All fields defaulted.
    let a = Config { }
    print_int(a.retries)    // 3
    print_int(a.timeout)    // 0
    print_int(a.verbose)    // 1

    // Override some; the rest fall back to their defaults.
    let b = Config { retries: 5, verbose: 9 }
    print_int(b.retries)    // 5
    print_int(b.timeout)    // 0  (default)
    print_int(b.verbose)    // 9
    return 0
}
